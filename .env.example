# ShopInventory Production Environment Variables
# Copy this file to .env and fill in your values
# NEVER commit .env to source control!

# ===========================================
# DATABASE CONFIGURATION
# ===========================================
POSTGRES_USER=shopinventory
POSTGRES_PASSWORD=YourSecurePassword123!
POSTGRES_DB=shopinventory
POSTGRES_DB_WEB=shopinventoryweb

# ===========================================
# API SECURITY
# ===========================================
# JWT Secret - Generate with: openssl rand -base64 64
JWT_SECRET_KEY=YourSuperSecretKeyThatIsAtLeast64CharactersLongForProduction!@#$%^&*()

# API Key for service-to-service communication
API_KEY_MAIN=sk_live_ShopInventory_PRODUCTION_CHANGE_THIS_KEY!

# ===========================================
# SAP BUSINESS ONE CONFIGURATION
# ===========================================
SAP_SERVICE_URL=https://your-sap-server:50000/b1s/v1/
SAP_COMPANY_DB=YOUR_COMPANY_DB
SAP_USERNAME=sap_user
SAP_PASSWORD=sap_password
# Optional when SAP uses a private or self-signed TLS certificate in production.
# Use the certificate thumbprint with spaces removed.
SAP_CERT_THUMBPRINT=

# Required if SAP webhook calls are enabled.
SAP_WEBHOOK_SECRET=change-this-webhook-secret

# ===========================================
# APPLICATION URLs
# ===========================================
WEB_APP_URL=https://your-domain.com
API_BASE_URL=http://shopinventory-api:5106/

# Customer portal JWT signing key (required, minimum 32 characters)
CUSTOMER_PORTAL_JWT_SECRET=YourCustomerPortalJwtSecretAtLeast32CharactersLong!

# ===========================================
# EMAIL CONFIGURATION (SMTP)
# ===========================================
SMTP_HOST=smtp.your-provider.com
SMTP_USERNAME=your-email@domain.com
SMTP_PASSWORD=your-smtp-password
SMTP_FROM_EMAIL=noreply@your-domain.com

# ===========================================
# AI CONFIGURATION (Optional)
# ===========================================
OPENAI_API_KEY=sk-your-openai-api-key

# ===========================================
# PAYMENT GATEWAYS (Optional)
# ===========================================
# PayNow
PAYNOW_INTEGRATION_ID=
PAYNOW_INTEGRATION_KEY=

# InnBucks
INNBUCKS_API_KEY=
INNBUCKS_API_SECRET=
INNBUCKS_MERCHANT_ID=

# EcoCash
ECOCASH_API_KEY=
ECOCASH_API_SECRET=
ECOCASH_MERCHANT_CODE=
ECOCASH_MERCHANT_PIN=

# ===========================================
# FISCALISATION
# ===========================================
# Which system files new invoices and credit notes: Platform or Revmax.
#
# Platform is the in-house console at https://fiscal.kefaloscheese.com/, live on three Online ZIMRA
# devices since September 2026. Revmax is the vendor device (http://172.16.16.201:8001) that filed
# everything before that. It is the rollback.
Fiscalisation__Provider=Platform
# The REVMax device. No authentication; it is reachable on the LAN only. Under Platform it files nothing
# new, but while Enabled is true it is asked about what it filed and credits its own receipts.
Revmax__BaseUrl=http://172.16.16.201:8001
Revmax__Enabled=true
# The last day REVMax filed anything (yyyy-MM-dd). SAP documents dated after it skip the REVMax check.
# Blank checks every document.
Revmax__LastFilingDate=

# --- Everything below configures the in-house platform and is inert while Provider is Revmax. ---
# API key issued from the console's API Keys page with the
# receipt.submit, sap.fiscalise and device.read scopes.
Fiscalisation__ApiKey=
# Leave blank. Blank means "use any device the console has", and a submission then
# falls over to the next device when one is unhealthy. Set it only to pin one device
# on purpose, and accept that fiscalisation stops when that device does.
Fiscalisation__DefaultDeviceId=
