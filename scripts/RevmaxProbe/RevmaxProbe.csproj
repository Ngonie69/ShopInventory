<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>RevmaxProbe</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <None Include="sample-invoice-769617.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\ShopInventory\ShopInventory.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Fido2 brings System.Formats.Cbor 9.0.0, which has CVE-2026-118747. The API and Web use the copy in the ASP.NET Core shared framework instead; this project does not, so it pins the fix. -->
    <PackageReference Include="System.Formats.Cbor" Version="10.0.15" />
  </ItemGroup>

</Project>
