<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>
  <ItemGroup>
    <!--
      SQLite in-memory rather than the InMemory provider: it is a real relational provider, so a
      query that cannot be translated to SQL fails the test instead of being silently evaluated
      in memory. Closer to how these queries behave against Postgres.
    -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.13" />
    <!--
      SQLitePCLRaw.lib.e_sqlite3 arrives transitively at 2.1.11, which carries a high-severity
      advisory (GHSA-2m69-gcr7-jv3q) and fails the Dependency Audit workflow. 2.1.12 is the
      patched build. Test-only, and removable once EF references it directly.
    -->
    <PackageReference Include="SQLitePCLRaw.lib.e_sqlite3" Version="3.53.3" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.10.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.1">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>
  <ItemGroup>
    <!--
      System.Security.Cryptography.Xml is deliberately not referenced here. ShopInventory and
      ShopInventory.Web use the Web SDK and take that assembly from the ASP.NET Core shared framework,
      so it is not a NuGet asset there. This project uses the plain SDK, so the copy it inherits
      through the project references resolves as a real package and is audited.

      It used to be pinned, when Microsoft.AspNetCore.DataProtection resolved an unpatched 10.0.8.
      DataProtection now asks for the System.Security.Cryptography.Xml of its own version, so moving
      Microsoft.AspNetCore.DataProtection.EntityFrameworkCore in ShopInventory and ShopInventory.Web
      moves it: 10.0.13 is the build patched for GHSA-r955-8q5j-3h83, GHSA-7hqp-7c5m-4vq6 and
      GHSA-c399-9853-6jmj. A pin here can only fall behind that, and one that does fails the restore
      with NU1605 (package downgrade) instead of helping.
    -->
    <!--
      SkiaSharp ships native Skia for Windows and macOS only. Production is IIS on Windows; the unit tests
      run on Linux in CI, where AttachmentImageCompressionTests needs libSkiaSharp too. NoDependencies
      links fontconfig statically, so the runner needs no system packages.
    -->
    <PackageReference Include="SkiaSharp.NativeAssets.Linux.NoDependencies" Version="4.153.1" />
  </ItemGroup>
  <ItemGroup>
    <!--
      MonitoredWarehouseConfigTests reads the deployed appsettings.json to check it against the code
      default, so the file has to be in the test output. It was there on a development machine by
      accident — a side effect of having built the app into the same tree — and absent in a clean
      CI checkout, where all nine of those tests failed on the missing file while passing locally.
      Copying it explicitly is what makes the fixture the test's own rather than the environment's.
    -->
    <Content Include="..\ShopInventory\appsettings.json" Link="appsettings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <None Include="Fixtures\Images\**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ShopInventory\ShopInventory.csproj" />
    <!--
      The Blazor app, so its non-UI logic can be tested too. Both projects hand-mirror the same
      DTOs, but the Web ones all sit under ShopInventory.Web.*, so nothing here becomes ambiguous.
    -->
    <ProjectReference Include="..\ShopInventory.Web\ShopInventory.Web.csproj" />
  </ItemGroup>
</Project>
