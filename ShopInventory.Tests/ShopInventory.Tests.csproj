<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>
  <ItemGroup>
    <!--
      SQLite in-memory rather than the InMemory provider: it is a real relational provider, so a
      query that cannot be translated to SQL fails the test instead of being silently evaluated
      in memory. Closer to how these queries behave against Postgres.
    -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.11" />
    <!--
      SQLitePCLRaw.lib.e_sqlite3 arrives transitively at 2.1.11, which carries a high-severity
      advisory (GHSA-2m69-gcr7-jv3q) and fails the Dependency Audit workflow. 2.1.12 is the
      patched build. Test-only, and removable once EF references it directly.
    -->
    <PackageReference Include="SQLitePCLRaw.lib.e_sqlite3" Version="3.53.3" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.9.0" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.0">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>
  <ItemGroup>
    <!--
      Pins a transitive dependency of Microsoft.AspNetCore.DataProtection, which resolves
      System.Security.Cryptography.Xml 10.0.8 — flagged by five high-severity advisories
      (GHSA-cvvh-rhrc-wg4q, GHSA-g8r8-53c2-pm3f, GHSA-23rf-6693-g89p, GHSA-8q5v-6pqq-x66h,
      GHSA-mmjf-rqrv-855v).

      Same reasoning as the pin in scripts/AccountSalesPaymentWorkbookRestyler: ShopInventory and
      ShopInventory.Web use the Web SDK and take this assembly from the ASP.NET Core shared
      framework, so it is not a NuGet asset there. This test project uses the plain SDK, so the
      dependency it inherits through the ShopInventory project reference resolves as a real
      package and is audited.

      Remove once Microsoft.AspNetCore.DataProtection references a patched version directly.
    -->
    <PackageReference Include="System.Security.Cryptography.Xml" Version="10.0.11" />
  </ItemGroup>
  <ItemGroup>
    <!--
      MonitoredWarehouseConfigTests reads the deployed appsettings.json to check it against the code
      default, so the file has to be in the test output. It was there on a development machine by
      accident — a side effect of having built the app into the same tree — and absent in a clean
      CI checkout, where all nine of those tests failed on the missing file while passing locally.
      Copying it explicitly is what makes the fixture the test's own rather than the environment's.
    -->
    <Content Include="..\ShopInventory\appsettings.json" Link="appsettings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ShopInventory\ShopInventory.csproj" />
    <!--
      The Blazor app, so its non-UI logic can be tested too. Both projects hand-mirror the same
      DTOs, but the Web ones all sit under ShopInventory.Web.*, so nothing here becomes ambiguous.
    -->
    <ProjectReference Include="..\ShopInventory.Web\ShopInventory.Web.csproj" />
  </ItemGroup>
</Project>
