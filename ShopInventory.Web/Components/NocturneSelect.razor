@typeparam TValue

@* A dropdown for the Nocturne pages.

   It exists for the same reason NocturneDateField does: the native element
   draws part of itself outside the page, where no stylesheet reaches. A
   `<select>`'s popup takes its background from the field, and a Nocturne field
   is a 5%-white wash — which the browser composites onto white and then, having
   done so, refuses to treat as dark. The options inherit the field's pale ink,
   so in dark theme the list renders near-white on near-white: present,
   focusable and invisible. Nothing on the page can reach it, `color-scheme`
   included, and it never reproduces in light theme.

   Styling the `option`s to an opaque fill fixes the readability, but it cannot
   fix the shape: a native popup is a platform window, so it arrives in the OS's
   metrics next to twenty controls drawn in the design's. This component draws
   the list itself, which is also what lets a row carry a swatch, a hint and a
   tick — the things that make a status list readable at a glance.

   Styles live in wwwroot/css/nocturne-select.css under the `nsel-` prefix, on
   the same palette as the page sheets, so it reads as part of whichever page
   hosts it. Per-page fit is through the `--nsel-*` fallbacks; see that file.

   Outside clicks are caught by a fixed veil behind the menu rather than a
   document listener, which keeps the component free of JS interop — the same
   trade NocturneDateField makes.

   A long list — every warehouse in SAP — opts into `Searchable`: a box at the
   top of the menu that narrows the rows by label and detail as you type, with
   Enter taking the first match. Rows may carry a `Group`, and the menu heads
   each run of one group, so "on this page" and "everything else" read as two
   lists in one menu. *@

<div class="nsel @Class @(_open ? "nsel-open" : "") @(Fixed ? "nsel-fixed" : "") @(Searchable ? "nsel-searchable" : "")" @onkeydown="OnKeyDown" @attributes="Extra">
    <button type="button" id="@Id"
            class="nsel-btn @(HasValue ? "nsel-set" : "") @FamilyClass(_current?.Family)"
            disabled="@Disabled" @onclick="Toggle"
            aria-haspopup="listbox" aria-expanded="@_open" aria-label="@AriaLabel">
        @if (!string.IsNullOrEmpty(Icon))
        {
            <i class="@Icon nsel-icon" aria-hidden="true"></i>
        }
        else if (_current?.Family is not null)
        {
            <span class="nsel-dot" aria-hidden="true"></span>
        }
        <span class="nsel-value">@(_current?.Label ?? Placeholder)</span>
        <svg class="nsel-caret" width="10" height="7" viewBox="0 0 10 7" fill="none" stroke="currentColor"
             stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M1 1.5l4 4 4-4"></path>
        </svg>
    </button>

    @if (_open)
    {
        @* A fixed menu is placed once, so on an engine without anchor
           positioning a scroll would slide it off its own trigger and onto
           another row's. The veil covers the viewport, so it is where the wheel
           lands — close there rather than let the list drift. A menu long
           enough to scroll on its own is not affected: that wheel goes to the
           menu, which is not a child of the veil. *@
        @if (Fixed)
        {
            <div class="nsel-veil" @onclick="Close" @onwheel="Close" @ontouchmove="Close"></div>
        }
        else
        {
            <div class="nsel-veil" @onclick="Close"></div>
        }
        <div class="nsel-menu">
            @if (!string.IsNullOrEmpty(Caption))
            {
                <div class="nsel-caption">@Caption</div>
            }
            @if (Searchable)
            {
                <div class="nsel-search">
                    <svg class="nsel-search-icon" width="13" height="13" viewBox="0 0 24 24" fill="none"
                         stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
                        <circle cx="11" cy="11" r="6.5"></circle>
                        <path d="M16 16l4.5 4.5"></path>
                    </svg>
                    <input @ref="_searchRef" type="search" class="nsel-search-input" value="@_query"
                           placeholder="@SearchPlaceholder" aria-label="@($"Search {Caption ?? AriaLabel ?? "options"}")"
                           autocomplete="off" spellcheck="false"
                           @oninput="OnQueryInput" @onkeydown="OnSearchKeyDown" />
                </div>
            }
            @* The list is display: contents, so its rows lay out as the menu's own children while
               the listbox role covers the rows alone — not the caption, search box or footnote. *@
            <div class="nsel-list" role="listbox" aria-label="@(Caption ?? AriaLabel)">
                @if (!_items.Any())
                {
                    <div class="nsel-empty">@EmptyText</div>
                }
                else
                {
                    string? group = null;
                    var ruled = true;
                    @for (var i = 0; i < _shown.Count; i++)
                    {
                        @* Copied out of the loop: without it every lambda closes over
                           the same variable and each row selects the last option. *@
                        var index = i;
                        var option = _shown[index];
                        var chosen = Matches(option.Value);
                        @if (option.Group is not null && !string.Equals(option.Group, group, StringComparison.Ordinal))
                        {
                            @if (!ruled)
                            {
                                <div class="nsel-rule"></div>
                            }
                            <div class="nsel-group" role="presentation">@option.Group</div>
                        }
                        group = option.Group;
                        <button type="button" @key="index" @ref="_itemRefs[index]"
                                class="nsel-item @FamilyClass(option.Family) @(chosen ? "nsel-on" : "") @(option.Detail is null ? "" : "nsel-has-detail")"
                                role="option" aria-selected="@chosen" disabled="@option.Disabled"
                                @onclick="@(() => Pick(option))">
                            @if (option.Family is not null)
                            {
                                <span class="nsel-dot" aria-hidden="true"></span>
                            }
                            <span class="nsel-label">@option.Label</span>
                            @if (option.Detail is not null)
                            {
                                <span class="nsel-detail">@option.Detail</span>
                            }
                            @if (!string.IsNullOrEmpty(option.Hint))
                            {
                                <span class="nsel-hint">@option.Hint</span>
                            }
                            <svg class="nsel-tick" width="12" height="12" viewBox="0 0 24 24" fill="none"
                                 stroke="currentColor" stroke-width="2.4" stroke-linecap="round"
                                 stroke-linejoin="round" aria-hidden="true">
                                <path d="M4.5 12.5l5 5 10-11"></path>
                            </svg>
                        </button>
                        ruled = option.RuleAfter && index < _shown.Count - 1;
                        @if (ruled)
                        {
                            <div class="nsel-rule"></div>
                        }
                    }
                    @if (Searchable && !string.IsNullOrWhiteSpace(_query) && _shown.All(o => o.IsUnset))
                    {
                        <div class="nsel-empty">Nothing matches “@_query.Trim()”.</div>
                    }
                }
            </div>
            @if (!string.IsNullOrEmpty(Footnote))
            {
                <div class="nsel-foot">@Footnote</div>
            }
        </div>
    }
</div>

@code {
    // The interface rather than the class so a page's
    // NocturneSelectOption<string> list binds to a string? field without
    // CS8620 — see INocturneSelectOption.
    [Parameter, EditorRequired] public IEnumerable<INocturneSelectOption<TValue>> Options { get; set; } = [];

    [Parameter] public TValue? Value { get; set; }
    [Parameter] public EventCallback<TValue?> ValueChanged { get; set; }

    /// <summary>Runs after the value has been committed — the hook for reloads and paging resets.</summary>
    [Parameter] public EventCallback OnChanged { get; set; }

    /// <summary>A leading glyph, e.g. <c>bi bi-funnel</c>. Replaces the chosen row's swatch on the trigger.</summary>
    [Parameter] public string? Icon { get; set; }

    /// <summary>The menu's heading — "Filter by status". It orients, and gives the menu a top edge.</summary>
    [Parameter] public string? Caption { get; set; }

    /// <summary>What the trigger reads when the bound value matches no option.</summary>
    [Parameter] public string Placeholder { get; set; } = "Select…";

    /// <summary>What the menu reads when there is nothing to choose from.</summary>
    [Parameter] public string EmptyText { get; set; } = "Nothing to choose";

    [Parameter] public bool Disabled { get; set; }
    [Parameter] public string? Id { get; set; }
    [Parameter] public string? AriaLabel { get; set; }

    /// <summary>
    /// Draws the menu outside the flow so an ancestor's <c>overflow</c> cannot
    /// clip it — what a control inside a scrolling table needs, and only that.
    /// See the <c>nsel-fixed</c> block in nocturne-select.css for what the
    /// menu gives up in exchange, and what it gets back.
    /// </summary>
    [Parameter] public bool Fixed { get; set; }

    /// <summary>
    /// Extra classes on the wrapper. The ones the sheet defines are
    /// <c>nsel-sm</c> and <c>nsel-lg</c> for height, <c>nsel-end</c> to
    /// right-anchor the menu, <c>nsel-up</c> to hang it above the trigger —
    /// which anything in a card's footer needs, or the card's
    /// <c>overflow: hidden</c> clips the menu away — <c>nsel-auto</c> to drop
    /// the minimum width, and <c>nsel-bs</c> to fit a Bootstrap
    /// <c>.form-select</c> row.
    /// </summary>
    [Parameter] public string? Class { get; set; }

    /// <summary>
    /// Anything else written on the tag — a <c>style</c> width, a <c>title</c> —
    /// lands on the wrapper. The wrapper rather than the trigger because what a
    /// page sets here is nearly always the control's footprint in a filter row.
    /// </summary>
    [Parameter(CaptureUnmatchedValues = true)]
    public IReadOnlyDictionary<string, object>? Extra { get; set; }

    /// <summary>
    /// Puts a search box at the top of the menu that narrows the rows by label and detail. Rows
    /// that mean "no filter" stay, so clearing is always one click away. For lists long enough to
    /// scroll — every warehouse — not for a status list that fits.
    /// </summary>
    [Parameter] public bool Searchable { get; set; }

    /// <summary>What the search box reads while empty.</summary>
    [Parameter] public string SearchPlaceholder { get; set; } = "Search…";

    /// <summary>A line under the list that says what choosing a row does — that it asks SAP, say.</summary>
    [Parameter] public string? Footnote { get; set; }

    private List<INocturneSelectOption<TValue>> _items = [];
    private List<INocturneSelectOption<TValue>> _shown = [];
    private ElementReference[] _itemRefs = [];
    private ElementReference _searchRef;
    private string _query = string.Empty;
    private bool _open;
    private int _active = -1;
    private bool _focusPending;
    private bool _focusSearch;

    private INocturneSelectOption<TValue>? _current;

    private bool HasValue => _current is not null && !_current.IsUnset && !IsEmpty(_current.Value);

    protected override void OnParametersSet()
    {
        _items = Options as List<INocturneSelectOption<TValue>> ?? Options.ToList();
        ApplyQuery();

        _current = _items.FirstOrDefault(o => Matches(o.Value));
    }

    /// <summary>
    /// The rows the menu shows: all of them, or those whose label or detail holds the search text.
    /// The keyboard walks these, so the element refs are sized to them.
    /// </summary>
    private void ApplyQuery()
    {
        var query = _query.Trim();
        _shown = !Searchable || query.Length == 0
            ? _items
            : _items.Where(o => o.IsUnset ||
                                o.Label.Contains(query, StringComparison.OrdinalIgnoreCase) ||
                                (o.Detail?.Contains(query, StringComparison.OrdinalIgnoreCase) ?? false))
                .ToList();

        if (_itemRefs.Length != _shown.Count)
        {
            _itemRefs = new ElementReference[_shown.Count];
        }
    }

    private void OnQueryInput(ChangeEventArgs e)
    {
        _query = e.Value?.ToString() ?? string.Empty;
        _active = -1;
        ApplyQuery();
    }

    /// <summary>
    /// Enter takes the row the text names: the one whose label it is, else the first whose label
    /// starts with it, else the first row left. A detail can match too — "wareh" finds every
    /// "… Warehouse" — so taking the first row alone would choose a name over the code typed.
    /// </summary>
    private async Task OnSearchKeyDown(KeyboardEventArgs e)
    {
        if (e.Key != "Enter" || string.IsNullOrWhiteSpace(_query))
        {
            return;
        }

        var query = _query.Trim();
        var candidates = _shown.Where(o => !o.IsUnset && !o.Disabled).ToList();
        var best = candidates.FirstOrDefault(o => string.Equals(o.Label, query, StringComparison.OrdinalIgnoreCase))
                   ?? candidates.FirstOrDefault(o => o.Label.StartsWith(query, StringComparison.OrdinalIgnoreCase))
                   ?? candidates.FirstOrDefault();
        if (best is not null)
        {
            await Pick(best);
        }
    }

    // The unset filter and the empty filter are the same filter. Pages disagree
    // about which one "no filter" is — a `<select>`'s "All" row bound an empty
    // string, while Clear set the field back to null — and without this the
    // trigger would fall back to the placeholder after a Clear.
    private bool Matches(TValue? value)
    {
        if (value is string a && Value is null)
        {
            return a.Length == 0;
        }

        if (Value is string b && value is null)
        {
            return b.Length == 0;
        }

        return EqualityComparer<TValue?>.Default.Equals(value, Value);
    }

    private static bool IsEmpty(TValue? value) => value is null || (value is string s && s.Length == 0);

    private static string FamilyClass(string? family) =>
        string.IsNullOrEmpty(family) ? string.Empty : $"nsel-fam-{family}";

    private void Toggle()
    {
        _open = !_open;
        if (_open)
        {
            // Every opening starts from the whole list, not from the last search.
            _query = string.Empty;
            ApplyQuery();

            // Open on the current choice so the arrow keys start where the eye does. A searchable
            // menu opens with the caret in the box instead, so typing narrows at once and the
            // first ArrowDown lands on the first row rather than the one after the choice.
            _active = Searchable ? -1 : _shown.FindIndex(o => Matches(o.Value));
            _focusSearch = Searchable;
        }
    }

    private void Close() => _open = false;

    private void OnKeyDown(KeyboardEventArgs e)
    {
        switch (e.Key)
        {
            case "Escape":
                _open = false;
                break;

            case "ArrowDown":
            case "ArrowUp":
                if (!_open)
                {
                    Toggle();
                    _focusPending = !Searchable && _active >= 0;
                    break;
                }

                Step(e.Key == "ArrowDown" ? 1 : -1);
                break;

            // Left to the search box's caret in a searchable menu.
            case "Home" when _open && !Searchable:
                _active = NextSelectable(-1, 1);
                _focusPending = _active >= 0;
                break;

            case "End" when _open && !Searchable:
                _active = NextSelectable(_shown.Count, -1);
                _focusPending = _active >= 0;
                break;
        }
    }

    private void Step(int direction)
    {
        var from = _active < 0 ? (direction > 0 ? -1 : _shown.Count) : _active;
        var next = NextSelectable(from, direction);
        if (next < 0)
        {
            // Up past the first row goes back to the search box it came down from.
            if (direction < 0 && Searchable)
            {
                _active = -1;
                _focusSearch = true;
            }

            return;
        }

        _active = next;
        _focusPending = true;
    }

    private int NextSelectable(int from, int direction)
    {
        for (var i = from + direction; i >= 0 && i < _shown.Count; i += direction)
        {
            if (!_shown[i].Disabled)
            {
                return i;
            }
        }

        return -1;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_focusSearch)
        {
            _focusSearch = false;
            if (_open && Searchable)
            {
                await _searchRef.FocusAsync();
            }

            return;
        }

        if (!_focusPending)
        {
            return;
        }

        _focusPending = false;
        if (_open && _active >= 0 && _active < _itemRefs.Length)
        {
            await _itemRefs[_active].FocusAsync();
        }
    }

    private async Task Pick(INocturneSelectOption<TValue> option)
    {
        _open = false;
        if (Matches(option.Value))
        {
            return;
        }

        Value = option.Value;
        _current = option;
        await ValueChanged.InvokeAsync(option.Value);
        await OnChanged.InvokeAsync();
    }
}
