@using ShopInventory.Web.Models

@* Recent invoices or recent payments — the two halves of the dashboard's
   activity row.

   A real <table>, not a CSS grid: five columns of genuinely tabular data,
   read rather than clicked. Below the table's own minimum the panel scrolls
   horizontally rather than collapsing into cards — five columns is a short
   enough row to swipe, and the two panels have already stacked by then.

   The status badge lives here rather than in a component of its own: it has
   exactly two states on this page, and both belong to the table that draws
   them. *@

<section class="dsh-panel" aria-labelledby="@HeadingId">
    <header class="dsh-panel-head">
        <span class="dsh-panel-icon">
            <DashIcon Name="@TableIcon" Size="15" />
        </span>
        <h2 id="@HeadingId">@Title</h2>
        <a class="dsh-panel-link" href="@ViewAllHref">
            View all
            <DashIcon Name="chevron" Size="13" />
        </a>
    </header>

    @if (IsLoading)
    {
        <div class="dsh-state" role="status">
            <span class="dsh-spin" aria-hidden="true"></span>
            <span>Loading @Title.ToLowerInvariant()&#8230;</span>
        </div>
    }
    else if (Kind == ActivityKind.Invoices && Invoices?.Count > 0)
    {
        <div class="dsh-scroll">
            <table class="dsh-table">
                <thead>
                    <tr>
                        <th scope="col">Doc #</th>
                        <th scope="col">Customer</th>
                        <th scope="col">Date</th>
                        <th scope="col" class="dsh-th-money">Total</th>
                        <th scope="col">Status</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var invoice in Invoices.Take(5))
                    {
                        <tr>
                            <td class="dsh-doc">INV-@invoice.DocNum</td>
                            @* Long trading names are ellipsised, so keep the full value reachable. *@
                            <td class="dsh-name" title="@invoice.CardName">@invoice.CardName</td>
                            <td class="dsh-when">@FormatDate(invoice.DocDate)</td>
                            <td class="dsh-money">@invoice.DocCurrency @invoice.DocTotal.ToString("N2")</td>
                            <td>
                                <span class="dsh-tag @(IsPaid(invoice) ? "dsh-tag-ok" : null)">@InvoiceStatus(invoice)</span>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else if (Kind == ActivityKind.Payments && Payments?.Count > 0)
    {
        <div class="dsh-scroll">
            <table class="dsh-table">
                <thead>
                    <tr>
                        <th scope="col">Doc #</th>
                        <th scope="col">Customer</th>
                        <th scope="col">Date</th>
                        <th scope="col" class="dsh-th-money">Amount</th>
                        <th scope="col">Method</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var payment in Payments.Take(5))
                    {
                        <tr>
                            <td class="dsh-doc">PAY-@payment.DocNum</td>
                            <td class="dsh-name" title="@payment.CardName">@payment.CardName</td>
                            <td class="dsh-when">@FormatDate(payment.DocDate)</td>
                            <td class="dsh-money">@payment.DocCurrency @payment.DocTotal.ToString("N2")</td>
                            <td><span class="dsh-tag">@PaymentMethod(payment)</span></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <div class="dsh-state">No recent @Title.ToLowerInvariant()</div>
    }
</section>

@code {
    public enum ActivityKind { Invoices, Payments }

    [Parameter, EditorRequired] public string Title { get; set; } = string.Empty;
    [Parameter, EditorRequired] public string ViewAllHref { get; set; } = string.Empty;
    [Parameter] public ActivityKind Kind { get; set; }
    [Parameter] public IReadOnlyList<InvoiceDto>? Invoices { get; set; }
    [Parameter] public IReadOnlyList<IncomingPaymentDto>? Payments { get; set; }
    [Parameter] public bool IsLoading { get; set; }

    private string HeadingId => $"activity-{Kind.ToString().ToLowerInvariant()}";

    private string TableIcon => Kind == ActivityKind.Invoices ? "receipt" : "card";

    private static string FormatDate(string? value) =>
        DateTime.TryParse(value, out var date) ? date.ToString("dd MMM yyyy") : value ?? "—";

    private static bool IsPaid(InvoiceDto invoice) =>
        invoice.DocTotal > 0 && invoice.PaidToDate >= invoice.DocTotal;

    private static string InvoiceStatus(InvoiceDto invoice) =>
        IsPaid(invoice) ? "Paid" :
        string.Equals(invoice.DocStatus, "C", StringComparison.OrdinalIgnoreCase) ? "Closed" : "Open";

    private static string PaymentMethod(IncomingPaymentDto payment) =>
        payment.CashSum > 0 ? "Cash" :
        payment.TransferSum > 0 ? "POS" :
        payment.CreditSum > 0 ? "Card" :
        payment.CheckSum > 0 ? "Cheque" : "Other";
}
