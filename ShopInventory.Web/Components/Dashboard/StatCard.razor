@* One of the three figures the staff dashboard leads with.

   The card is read top-down: what it counts, the count, what the count is
   of, then — under a rule — the two secondary readings, the day-over-day
   comparison and the money. Only the lead card carries the accent, which is
   how this design says which figure the page is actually about.

   Direction is drawn as an arrow as well as coloured, so it still reads for
   anyone who cannot separate the two tints. *@

<article class="dsh-stat @(IsLead ? "dsh-stat-lead" : null)">
    <div class="dsh-stat-head">
        <span class="dsh-stat-rule" aria-hidden="true"></span>
        <span>@Label</span>
        <span class="dsh-stat-icon">
            <DashIcon Name="@Icon" Size="17" />
        </span>
    </div>

    <div class="dsh-stat-num">@Value</div>
    <div class="dsh-stat-sub">@ValueLabel</div>

    <div class="dsh-stat-foot">
        @if (!string.IsNullOrWhiteSpace(Trend))
        {
            <span class="dsh-trend @DirectionClass">
                <DashIcon Name="@DirectionIcon" Size="13" />
                <strong>@Trend</strong>
                <span>vs yesterday</span>
            </span>
        }
        <div class="dsh-stat-money">
            <strong>@Amount</strong>
            <span>@AmountLabel</span>
        </div>
    </div>
</article>

@code {
    [Parameter, EditorRequired] public string Label { get; set; } = string.Empty;
    [Parameter, EditorRequired] public string Value { get; set; } = string.Empty;
    [Parameter] public string ValueLabel { get; set; } = string.Empty;

    /// <summary>Comparison against yesterday. Omit when no comparison is available.</summary>
    [Parameter] public string? Trend { get; set; }

    /// <summary>Which way <see cref="Trend"/> moved: 1 up, 0 unchanged, -1 down.</summary>
    [Parameter] public int Direction { get; set; } = 1;

    [Parameter, EditorRequired] public string Amount { get; set; } = string.Empty;
    [Parameter] public string AmountLabel { get; set; } = "Total value";

    /// <summary>A <see cref="DashIcon"/> name.</summary>
    [Parameter, EditorRequired] public string Icon { get; set; } = string.Empty;

    /// <summary>The one card that carries the accent.</summary>
    [Parameter] public bool IsLead { get; set; }

    private string DirectionClass => Direction switch
    {
        > 0 => "dsh-trend-up",
        < 0 => "dsh-trend-down",
        _ => "dsh-trend-flat"
    };

    private string DirectionIcon => Direction switch
    {
        > 0 => "arrow-up",
        < 0 => "arrow-down",
        _ => "flat"
    };
}
