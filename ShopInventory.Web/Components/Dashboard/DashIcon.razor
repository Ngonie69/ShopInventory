@* The dashboard's icon set, drawn inline rather than taken from the Phosphor
   or Material webfont.

   The dashboard is the first page a session paints, and it paints before any
   icon font has arrived: a font-backed glyph would leave the figures headed
   by empty boxes on exactly the render most people see. These are stroke
   paths on a shared 24x24 grid, so every glyph inherits the colour of the
   text around it and scales with the box it sits in.

   The set is deliberately small — one glyph per thing this page names. Add a
   path here rather than reaching for a font. *@

<svg width="@Size" height="@Size" viewBox="0 0 24 24" fill="none" stroke="currentColor"
     stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"
     aria-hidden="true" focusable="false">
    @((MarkupString)PathFor(Name))
</svg>

@code {
    /// <summary>Key into the set below. An unknown name draws nothing.</summary>
    [Parameter, EditorRequired] public string Name { get; set; } = string.Empty;

    [Parameter] public int Size { get; set; } = 16;

    // Path data only: the <svg> above carries the grid, the stroke and the
    // colour, so a glyph is one line here.
    private static readonly Dictionary<string, string> Paths = new()
    {
        ["receipt"] = """<path d="M6 2h12v20l-3-2-3 2-3-2-3 2z"/><path d="M9.5 8h5"/><path d="M9.5 12h5"/>""",
