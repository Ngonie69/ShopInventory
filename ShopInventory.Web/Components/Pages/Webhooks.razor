@page "/webhooks"
@inject IWebhookService WebhookService
@attribute [Authorize(Roles = "Admin")]
@rendermode InteractiveServer

<PageTitle>Webhooks - Shop Inventory</PageTitle>

@* The Nocturne sheet is wwwroot/css/webhooks.css (linked from App.razor).
   Chrome and card grid from document-templates.css; the delivery log inside the
   logs dialog is audit-trail.css's grid, because that is what it is.

   This page had no sheet of its own: Bootstrap's .card, .modal, .badge, .table
   and .form-control with MudButtons on top. Every control is native and classed
   now, so app.css's global `.dark-theme input` rules are out-specified, and the
   three dialogs are offset below the app bar — as `.modal.show.d-block` they
   were centred against the whole viewport and sat under it.

   The <pre> blocks below are flush against the left margin on purpose: their
   contents render verbatim, so the Razor indentation is the code's
   indentation. *@

<div class="whk">

    <header class="whk-head">
        <div class="whk-head-inner">
            <nav class="whk-crumbs" aria-label="Breadcrumb">
                <span>Administration</span>
                <span class="whk-crumb-sep" aria-hidden="true">/</span>
                <span class="whk-crumb-now" aria-current="page">Webhooks</span>
            </nav>
            <div class="whk-head-actions">
                <button type="button" class="whk-btn whk-btn-quiet"
                        @onclick="() => showGuideSection = !showGuideSection">
                    @(showGuideSection ? "Hide guide" : "Integration guide")
                </button>
                <button type="button" class="whk-btn whk-btn-primary" @onclick="() => ShowCreateModal()">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                         stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <path d="M12 5v14"></path>
                        <path d="M5 12h14"></path>
                    </svg>
                    <span>Add webhook</span>
                </button>
            </div>
        </div>
    </header>

    <div class="whk-body">

        <section class="whk-hero">
            <div>
                <div class="whk-kicker">Outbound events</div>
                <h1>Webhooks</h1>
                <p>
                    An HTTP POST to your endpoint whenever something happens here — an invoice raised, a
                    payment taken, stock running low. Your server has the configured timeout to answer 2xx,
                    and a delivery that does not is retried with backoff.
                </p>
            </div>
        </section>

        @if (showGuideSection)
        {
            <section class="whk-panel">
                <div class="whk-panel-head">
                    <h2>Consuming a webhook</h2>
                    <div class="whk-panel-head-aside">
                        <button type="button" class="whk-btn whk-btn-quiet whk-btn-sm"
                                @onclick="() => showGuideSection = false">Hide</button>
                    </div>
                </div>
                <div class="whk-panel-body">
                    <div class="whk-guide">

                        <section>
                            <h3>Payload</h3>
                            <p>Every delivery is a POST with this JSON body. <span class="whk-code">data</span> carries the
                                event's own fields — the invoice, the payment, the stock line.</p>
<pre class="whk-pre"><code>{
  "id": "a1b2c3d4-e5f6-7890-abcd-ef1234567890",
  "event": "invoice.created",
  "timestamp": "2026-03-17T10:30:00Z",
  "data": { }
}</code></pre>
                        </section>

                        <section>
                            <h3>Headers</h3>
                            <dl class="whk-defs">
                                <dt><span class="whk-code">Content-Type</span></dt>
                                <dd><span class="whk-code">application/json</span></dd>
                                <dt><span class="whk-code">X-Webhook-Event</span></dt>
                                <dd>The event type, e.g. <span class="whk-code">invoice.created</span></dd>
                                <dt><span class="whk-code">X-Webhook-Delivery-Id</span></dt>
                                <dd>A GUID unique to this delivery attempt</dd>
                                <dt><span class="whk-code">X-Webhook-Signature</span></dt>
                                <dd>HMAC-SHA256 of the raw body — sent only when a secret is set</dd>
                            </dl>
                        </section>

                        <section>
                            <h3>Verifying the signature</h3>
                            <ol>
                                <li>Read the raw request body as UTF-8, before any JSON parsing.</li>
                                <li>Compute HMAC-SHA256 over it with your secret as the key.</li>
                                <li>Compare against the header, which is formatted <span class="whk-code">sha256=&lt;hex&gt;</span>.</li>
                            </ol>
<pre class="whk-pre"><code>// C#
using var hmac = new HMACSHA256(Encoding.UTF8.GetBytes(secret));
var hash = hmac.ComputeHash(Encoding.UTF8.GetBytes(rawBody));
var expected = $"sha256={Convert.ToHexString(hash).ToLowerInvariant()}";
bool isValid = expected == request.Headers["X-Webhook-Signature"];</code></pre>
<pre class="whk-pre"><code>// Node.js
const crypto = require('crypto');
const expected = 'sha256=' + crypto
  .createHmac('sha256', secret)
  .update(rawBody, 'utf8')
  .digest('hex');
const isValid = expected === req.headers['x-webhook-signature'];</code></pre>
                        </section>

                        <section>
                            <h3>Retries</h3>
                            <ul>
                                <li>A non-2xx response or a timeout is retried with exponential backoff — 2, 4, 8, 16 seconds.</li>
                                <li>Attempts are configurable per webhook, 1 to 10, default 3.</li>
                                <li>Timeout is configurable per webhook, 5 to 60 seconds, default 30.</li>
                            </ul>
                        </section>

                        <section>
                            <h3>A receiver</h3>
<pre class="whk-pre"><code>// C#
[HttpPost("webhook")]
public async Task&lt;IActionResult&gt; ReceiveWebhook()
{
    using var reader = new StreamReader(Request.Body);
    var body = await reader.ReadToEndAsync();

    var signature = Request.Headers["X-Webhook-Signature"].FirstOrDefault();
    if (!VerifySignature(body, signature, _mySecret))
        return Unauthorized();

    var payload = JsonSerializer.Deserialize&lt;WebhookPayload&gt;(body);
    var eventType = Request.Headers["X-Webhook-Event"].FirstOrDefault();

    switch (eventType)
    {
        case "invoice.created": break;
        case "stock.low": break;
    }

    return Ok();
}</code></pre>
<pre class="whk-pre"><code>// Node.js / Express
app.post('/webhook', express.raw({ type: 'application/json' }), (req, res) =&gt; {
  const body = req.body.toString('utf8');

  if (!verifySignature(body, req.headers['x-webhook-signature'], SECRET))
    return res.status(401).send('Invalid signature');

  const payload = JSON.parse(body);
  res.status(200).send('OK');
});</code></pre>
                        </section>

                        <div class="whk-notice whk-fam-warn">
                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                 stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                <path d="M12 4l9 16H3z"></path>
                                <path d="M12 10v4"></path>
                                <path d="M12 17.5v.01"></path>
                            </svg>
                            <div class="whk-notice-text">
                                Worth knowing before you go live:
                                <ul>
                                    <li>Answer 200 quickly and do the real work off a queue — the timeout counts your handler.</li>
                                    <li>Use Test on a hook before pointing anything real at it.</li>
                                    <li>Delivery logs carry the response code and the error, which is where a failure is diagnosed.</li>
                                    <li>Set a secret. Without one, anything that can reach your URL can pretend to be us.</li>
                                    <li>The endpoint must be HTTPS in production.</li>
                                </ul>
                            </div>
                        </div>
                    </div>
                </div>
            </section>
        }

        @if (isLoading)
        {
            <div class="whk-loading">
                <span class="whk-spin" aria-hidden="true"></span>
                <span>Loading webhooks&#8230;</span>
            </div>
        }
        else if (errorMessage != null)
        {
            <div class="whk-notice whk-fam-bad" role="alert">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                     stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <circle cx="12" cy="12" r="9"></circle>
                    <path d="M12 7v6"></path>
                    <path d="M12 16.5v.01"></path>
                </svg>
                <span class="whk-notice-text">@errorMessage</span>
                <button type="button" class="whk-btn whk-btn-quiet whk-btn-sm" @onclick="LoadWebhooks">Retry</button>
            </div>
        }
        else if (webhooks?.Any() == true)
        {
            <section class="whk-panel">
                <div class="whk-panel-head">
                    <h2>Registered</h2>
                    <span class="whk-count">
                        @webhooks.Count(w => w.IsActive) active of @webhooks.Count
                    </span>
                </div>
                <div class="whk-panel-body">
                    <div class="whk-grid">
                        @foreach (var webhook in webhooks)
                        {
                            var hook = webhook;
                            <article class="whk-card @(hook.IsActive ? "whk-card-on" : "whk-card-off")">
                                <div class="whk-card-head">
                                    <h3 class="whk-card-title" title="@hook.Name">@hook.Name</h3>
                                    <span class="whk-badge @(hook.IsActive ? "whk-fam-good" : "whk-fam-neutral")">
                                        @(hook.IsActive ? "Active" : "Paused")
                                    </span>
                                    <label class="whk-switch" title="@(hook.IsActive ? "Pause" : "Activate")">
                                        <span class="visually-hidden">@(hook.IsActive ? "Pause" : "Activate") @hook.Name</span>
                                        <input type="checkbox" checked="@hook.IsActive" @onchange="() => ToggleWebhook(hook)" />
                                        <span class="whk-track" aria-hidden="true"></span>
                                    </label>
                                </div>

                                <div class="whk-card-body">
                                    <div class="whk-block">
                                        <span class="whk-block-label">Endpoint</span>
                                        <span class="whk-url">@hook.Url</span>
                                    </div>

                                    <div class="whk-block">
                                        <span class="whk-block-label">Subscribed events</span>
                                        <div class="whk-events">
                                            @foreach (var evt in hook.Events)
                                            {
                                                <span class="whk-badge whk-badge-event whk-fam-info">@evt</span>
                                            }
                                        </div>
                                    </div>

                                    <div class="whk-figures">
                                        <div class="whk-figure @(hook.SuccessCount > 0 ? "whk-fam-good" : "")">
                                            <div class="whk-figure-num">@hook.SuccessCount</div>
                                            <div class="whk-figure-label">Delivered</div>
                                        </div>
                                        <div class="whk-figure @(hook.FailureCount > 0 ? "whk-fam-bad" : "")">
                                            <div class="whk-figure-num">@hook.FailureCount</div>
                                            <div class="whk-figure-label">Failed</div>
                                        </div>
                                        <div class="whk-figure">
                                            <div class="whk-figure-num">@hook.RetryCount</div>
                                            <div class="whk-figure-label">Retries</div>
                                        </div>
                                        <div class="whk-figure">
                                            <div class="whk-figure-num">@hook.TimeoutSeconds<span class="whk-figure-label">s</span></div>
                                            <div class="whk-figure-label">Timeout</div>
                                        </div>
                                    </div>

                                    <div class="whk-card-when">
                                        @if (hook.LastTriggeredAt.HasValue)
                                        {
                                            <text>Last fired @hook.LastTriggeredAt.Value.ToString("d MMM yyyy HH:mm")</text>
                                        }
                                        else
                                        {
                                            <text>Never fired</text>
                                        }
                                    </div>
                                </div>

                                <div class="whk-card-foot">
                                    <button type="button" class="whk-btn whk-btn-primary whk-btn-sm"
                                            disabled="@(!hook.IsActive || isTesting)" @onclick="() => TestWebhook(hook.Id)">
                                        @if (isTesting && testingWebhookId == hook.Id)
                                        {
                                            <span class="whk-spin" aria-hidden="true"></span>
                                            <span>Testing&#8230;</span>
                                        }
                                        else
                                        {
                                            <span>Test</span>
                                        }
                                    </button>
                                    <button type="button" class="whk-btn whk-btn-quiet whk-btn-sm"
                                            @onclick="() => ShowDeliveries(hook)">Logs</button>
                                    <span class="whk-card-foot-gap"></span>
                                    <button type="button" class="whk-btn whk-btn-quiet whk-btn-sm"
                                            @onclick="() => EditWebhook(hook)">Edit</button>
                                    <button type="button" class="whk-icon-btn whk-icon-btn-danger" title="Delete"
                                            aria-label="Delete webhook" @onclick="() => ConfirmDelete(hook)">
                                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                             stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                            <path d="M4 7h16"></path>
                                            <path d="M9 7V5h6v2"></path>
                                            <path d="M6 7l1 13h10l1-13"></path>
                                        </svg>
                                    </button>
                                </div>
                            </article>
                        }
                    </div>
                </div>
            </section>
        }
        else
        {
            <div class="whk-empty">
                <svg width="30" height="30" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                     stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <circle cx="12" cy="12" r="2.5"></circle>
                    <path d="M7.5 7.5a6 6 0 0 0 0 9"></path>
                    <path d="M16.5 16.5a6 6 0 0 0 0-9"></path>
                    <path d="M4.5 4.5a10 10 0 0 0 0 15"></path>
                    <path d="M19.5 19.5a10 10 0 0 0 0-15"></path>
                </svg>
                <h3>No webhooks yet</h3>
                <p>Nothing is being notified when events happen here. Add an endpoint and pick the events it should hear about.</p>
                <div class="whk-empty-actions">
                    <button type="button" class="whk-btn whk-btn-primary" @onclick="() => ShowCreateModal()">Add a webhook</button>
                </div>
            </div>
        }

        <section class="whk-panel">
            <div class="whk-panel-head">
                <h2>Event types</h2>
                <span class="whk-count">@WebhookEvents.All.Count available</span>
            </div>
            <div class="whk-panel-body">
                <div class="whk-ref">
                    @foreach (var group in WebhookEvents.Grouped)
                    {
                        <div class="whk-ref-group">
                            <h3>@group.Key</h3>
                            @foreach (var (eventType, description) in group.Value)
                            {
                                <div class="whk-ref-row">
                                    <span class="whk-code">@eventType</span>
                                    <span class="whk-ref-desc">@description</span>
                                </div>
                            }
                        </div>
                    }
                </div>
            </div>
        </section>
    </div>
</div>

@* ── Test result ───────────────────────────────────────────────────────── *@
@if (testResult != null)
{
    <div class="whk whk-toast whk-notice @(testResult.Value ? "whk-fam-good" : "whk-fam-bad")" role="status">
        @if (testResult.Value)
        {
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                 stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M20 6L9 17l-5-5"></path>
            </svg>
            <span class="whk-notice-text">Your endpoint answered 2xx. The hook is working.</span>
        }
        else
        {
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                 stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <circle cx="12" cy="12" r="9"></circle>
                <path d="M12 7v6"></path>
                <path d="M12 16.5v.01"></path>
            </svg>
            <span class="whk-notice-text">The test delivery failed. The logs carry the response code and the error.</span>
        }
        <button type="button" class="whk-notice-x" aria-label="Dismiss" @onclick="() => testResult = null">
            <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                 stroke-width="2" stroke-linecap="round" aria-hidden="true">
                <path d="M5 5l14 14M19 5L5 19"></path>
            </svg>
        </button>
    </div>
}

@* ── Create / edit ─────────────────────────────────────────────────────── *@
@if (showCreateModal)
{
    <div class="whk whk-scrim" @onclick="CloseCreateModal">
        <div class="whk-modal" role="dialog" aria-modal="true"
             aria-label="@(editingWebhook != null ? "Edit webhook" : "Add webhook")" @onclick:stopPropagation="true">
            <div class="whk-modal-head">
                <h2>@(editingWebhook != null ? "Edit webhook" : "Add webhook")</h2>
                <button type="button" class="whk-icon-btn whk-modal-x" aria-label="Close" @onclick="CloseCreateModal">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                         stroke-width="1.8" stroke-linecap="round" aria-hidden="true">
                        <path d="M5 5l14 14M19 5L5 19"></path>
                    </svg>
                </button>
            </div>
            <div class="whk-modal-body">
                @if (!string.IsNullOrEmpty(saveError))
                {
                    <div class="whk-notice whk-fam-bad" role="alert">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                             stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <circle cx="12" cy="12" r="9"></circle>
                            <path d="M12 7v6"></path>
                            <path d="M12 16.5v.01"></path>
                        </svg>
                        <span class="whk-notice-text">@saveError</span>
                    </div>
                }

                <div class="whk-form-row">
                    <div class="whk-field">
                        <label class="whk-label" for="whkName">Name <span class="whk-req" aria-hidden="true">*</span></label>
                        <input id="whkName" type="text" class="whk-input" placeholder="ERP integration"
                               @bind="newWebhook.Name" />
                        <span class="whk-hint">How this hook is identified in the list.</span>
                    </div>
                    <div class="whk-field">
                        <label class="whk-label" for="whkUrl">Endpoint <span class="whk-req" aria-hidden="true">*</span></label>
                        <input id="whkUrl" type="url" class="whk-input whk-input-code"
                               placeholder="https://your-server.com/webhook" @bind="newWebhook.Url" />
                        <span class="whk-hint">Must be HTTPS in production.</span>
                    </div>
                </div>

                <div class="whk-form-row whk-form-row-4">
                    <div class="whk-field" style="grid-column: span 2">
                        <label class="whk-label" for="whkSecret">Secret</label>
                        <input id="whkSecret" type="password" class="whk-input whk-input-code"
                               autocomplete="new-password" @bind="newWebhook.Secret" />
                        <span class="whk-hint">Signs each payload with HMAC-SHA256 so you can prove it came from here.</span>
                    </div>
                    <div class="whk-field">
                        <label class="whk-label" for="whkRetries">Retries</label>
                        <input id="whkRetries" type="number" class="whk-input" min="1" max="10"
                               @bind="newWebhook.RetryCount" />
                        <span class="whk-hint">1&#8211;10</span>
                    </div>
                    <div class="whk-field">
                        <label class="whk-label" for="whkTimeout">Timeout</label>
                        <input id="whkTimeout" type="number" class="whk-input" min="5" max="60"
                               @bind="newWebhook.TimeoutSeconds" />
                        <span class="whk-hint">5&#8211;60 seconds</span>
                    </div>
                </div>

                <div class="whk-field">
                    <span class="whk-label">Events <span class="whk-req" aria-hidden="true">*</span></span>
                    <div class="whk-picker-bar">
                        <button type="button" class="whk-btn whk-btn-quiet whk-btn-sm" @onclick="SelectAllEvents">Select all</button>
                        <button type="button" class="whk-btn whk-btn-quiet whk-btn-sm" @onclick="ClearAllEvents">Clear</button>
                        <span class="whk-picker-count">@selectedEvents.Count selected</span>
                    </div>
                    <div class="whk-picker">
                        @foreach (var group in WebhookEvents.Grouped)
                        {
                            <div class="whk-picker-group">
                                <h4>@group.Key</h4>
                                @foreach (var (eventType, description) in group.Value)
                                {
                                    var evt = eventType;
                                    <label class="whk-check" title="@description">
                                        <input type="checkbox" id="evt-@evt" checked="@selectedEvents.Contains(evt)"
                                               @onchange="(e) => ToggleEvent(evt, (bool)(e.Value ?? false))" />
                                        <span class="whk-check-label">@evt</span>
                                    </label>
                                }
                            </div>
                        }
                    </div>
                </div>
            </div>
            <div class="whk-modal-foot">
                <button type="button" class="whk-btn whk-btn-quiet" @onclick="CloseCreateModal">Cancel</button>
                <button type="button" class="whk-btn whk-btn-primary" disabled="@isSaving" @onclick="SaveWebhook">
                    @if (isSaving)
                    {
                        <span class="whk-spin" aria-hidden="true"></span>
                        <span>Saving&#8230;</span>
                    }
                    else
                    {
                        <span>@(editingWebhook != null ? "Update webhook" : "Create webhook")</span>
                    }
                </button>
            </div>
        </div>
    </div>
}

@* ── Delivery logs ─────────────────────────────────────────────────────── *@
@if (showDeliveriesModal && selectedWebhook != null)
{
    <div class="whk whk-scrim" @onclick="() => showDeliveriesModal = false">
        <div class="whk-modal whk-modal-lg" role="dialog" aria-modal="true" aria-label="Delivery logs"
             @onclick:stopPropagation="true">
            <div class="whk-modal-head">
                <h2>Delivery logs &mdash; @selectedWebhook.Name</h2>
                <button type="button" class="whk-icon-btn whk-modal-x" aria-label="Close"
                        @onclick="() => showDeliveriesModal = false">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                         stroke-width="1.8" stroke-linecap="round" aria-hidden="true">
                        <path d="M5 5l14 14M19 5L5 19"></path>
                    </svg>
                </button>
            </div>
            <div class="whk-modal-body">
                @if (deliveries?.Any() == true)
                {
                    <div class="whk-scroll">
                        <div class="whk-log" role="table" aria-label="Delivery attempts">
                            <div class="whk-log-head" role="row">
                                <span role="columnheader">Time</span>
                                <span role="columnheader">Event</span>
                                <span role="columnheader">Outcome</span>
                                <span role="columnheader">Response</span>
                                <span role="columnheader">Duration</span>
                                <span role="columnheader">Attempt</span>
                                <span role="columnheader">Error</span>
                            </div>
                            @foreach (var delivery in deliveries)
                            {
                                <div class="whk-log-row @(delivery.IsSuccess ? "" : "whk-log-row-failed")" role="row">
                                    <span class="whk-log-cell" role="cell">@delivery.CreatedAt.ToString("d MMM HH:mm:ss")</span>
                                    <span class="whk-log-cell" role="cell">
                                        <span class="whk-code">@delivery.EventType</span>
                                    </span>
                                    <span class="whk-log-cell" role="cell">
                                        <span class="whk-badge @(delivery.IsSuccess ? "whk-fam-good" : "whk-fam-bad")">
                                            @(delivery.IsSuccess ? "OK" : "Failed")
                                        </span>
                                    </span>
                                    <span class="whk-log-cell" role="cell">
                                        @if (delivery.ResponseStatusCode.HasValue)
                                        {
                                            <span class="whk-badge @(delivery.ResponseStatusCode < 300 ? "whk-fam-good" : "whk-fam-bad")">
                                                @delivery.ResponseStatusCode
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="whk-none">&#8212;</span>
                                        }
                                    </span>
                                    <span class="whk-log-cell" role="cell">@delivery.DurationMs ms</span>
                                    <span class="whk-log-cell" role="cell">@delivery.RetryAttempt</span>
                                    <span class="whk-log-cell whk-log-err" role="cell" title="@delivery.ErrorMessage">
                                        @if (!string.IsNullOrEmpty(delivery.ErrorMessage))
                                        {
                                            @TruncateUrl(delivery.ErrorMessage, 40)
                                        }
                                    </span>
                                </div>
                            }
                        </div>
                    </div>
                }
                else
                {
                    <p class="whk-modal-text">Nothing has been delivered through this hook yet.</p>
                }
            </div>
            <div class="whk-modal-foot">
                <button type="button" class="whk-btn whk-btn-quiet" @onclick="() => showDeliveriesModal = false">Close</button>
            </div>
        </div>
    </div>
}

@* ── Delete ────────────────────────────────────────────────────────────── *@
@if (showDeleteModal && webhookToDelete != null)
{
    <div class="whk whk-scrim" @onclick="() => showDeleteModal = false">
        <div class="whk-modal whk-modal-sm" role="dialog" aria-modal="true" aria-label="Delete webhook"
             @onclick:stopPropagation="true">
            <div class="whk-modal-head">
                <h2>Delete webhook</h2>
                <button type="button" class="whk-icon-btn whk-modal-x" aria-label="Close"
                        @onclick="() => showDeleteModal = false">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                         stroke-width="1.8" stroke-linecap="round" aria-hidden="true">
                        <path d="M5 5l14 14M19 5L5 19"></path>
                    </svg>
                </button>
            </div>
            <div class="whk-modal-body">
                <p class="whk-modal-text">
                    Nothing will be sent to this endpoint again, and its delivery history goes with it.
                </p>
                <div class="whk-block">
                    <span class="whk-block-label">@webhookToDelete.Name</span>
                    <span class="whk-url">@webhookToDelete.Url</span>
                </div>
            </div>
            <div class="whk-modal-foot">
                <button type="button" class="whk-btn whk-btn-quiet" @onclick="() => showDeleteModal = false">Cancel</button>
                <button type="button" class="whk-btn whk-btn-danger" @onclick="DeleteWebhook">Delete</button>
            </div>
        </div>
    </div>
}

@code {
    private List<WebhookDto>? webhooks;
    private List<WebhookDeliveryDto>? deliveries;
    private WebhookDto? selectedWebhook;
    private WebhookDto? editingWebhook;
    private WebhookDto? webhookToDelete;
    private bool isLoading = true;
    private bool isSaving = false;
    private bool isTesting = false;
    private int? testingWebhookId;
    private bool? testResult;
    private bool showCreateModal = false;
    private bool showDeliveriesModal = false;
    private bool showDeleteModal = false;
    private bool showGuideSection = false;
    private string? errorMessage;
    private string? saveError;

    private CreateWebhookRequest newWebhook = new();
    private List<string> availableEvents = WebhookEvents.All;
    private HashSet<string> selectedEvents = new();

    protected override async Task OnInitializedAsync()
    {
        availableEvents = await WebhookService.GetAvailableEventsAsync();
        await LoadWebhooks();
    }

    private async Task LoadWebhooks()
    {
        isLoading = true;
        errorMessage = null;

        try
        {
            var response = await WebhookService.GetAllWebhooksAsync();
            webhooks = response?.Webhooks ?? new();
        }
        catch (Exception ex)
        {
            errorMessage = $"Failed to load webhooks: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }

    private void ShowCreateModal()
    {
        editingWebhook = null;
        newWebhook = new CreateWebhookRequest { RetryCount = 3, TimeoutSeconds = 30 };
        selectedEvents.Clear();
        saveError = null;
        showCreateModal = true;
    }

    private void EditWebhook(WebhookDto webhook)
    {
        editingWebhook = webhook;
        newWebhook = new CreateWebhookRequest
        {
            Name = webhook.Name,
            Url = webhook.Url,
            Events = webhook.Events,
            RetryCount = webhook.RetryCount,
            TimeoutSeconds = webhook.TimeoutSeconds
        };
        selectedEvents = new HashSet<string>(webhook.Events);
        saveError = null;
        showCreateModal = true;
    }

    private void CloseCreateModal()
    {
        showCreateModal = false;
        editingWebhook = null;
        newWebhook = new();
        selectedEvents.Clear();
        saveError = null;
    }

    private void ToggleEvent(string evt, bool isChecked)
    {
        if (isChecked)
            selectedEvents.Add(evt);
        else
            selectedEvents.Remove(evt);
    }

    private void SelectAllEvents()
    {
        selectedEvents = new HashSet<string>(availableEvents);
    }

    private void ClearAllEvents()
    {
        selectedEvents.Clear();
    }

    private async Task SaveWebhook()
    {
        saveError = null;

        if (string.IsNullOrWhiteSpace(newWebhook.Name))
        {
            saveError = "Please enter a webhook name.";
            return;
        }
        if (string.IsNullOrWhiteSpace(newWebhook.Url))
        {
            saveError = "Please enter an endpoint URL.";
            return;
        }
        if (!selectedEvents.Any())
        {
            saveError = "Please select at least one event.";
            return;
        }

        newWebhook.Events = selectedEvents.ToList();
        isSaving = true;

        try
        {
            if (editingWebhook != null)
            {
                var updateRequest = new UpdateWebhookRequest
                {
                    Name = newWebhook.Name,
                    Url = newWebhook.Url,
                    Secret = newWebhook.Secret,
                    Events = newWebhook.Events,
                    RetryCount = newWebhook.RetryCount,
                    TimeoutSeconds = newWebhook.TimeoutSeconds
                };
                var result = await WebhookService.UpdateWebhookAsync(editingWebhook.Id, updateRequest);
                if (result != null)
                {
                    CloseCreateModal();
                    await LoadWebhooks();
                }
                else
                {
                    saveError = "Failed to update webhook. Please try again.";
                }
            }
            else
            {
                var result = await WebhookService.CreateWebhookAsync(newWebhook);
                if (result != null)
                {
                    CloseCreateModal();
                    await LoadWebhooks();
                }
                else
                {
                    saveError = "Failed to create webhook. Please check your inputs and try again.";
                }
            }
        }
        catch (Exception ex)
        {
            saveError = $"Error: {ex.Message}";
        }
        finally
        {
            isSaving = false;
        }
    }

    private async Task ToggleWebhook(WebhookDto webhook)
    {
        await WebhookService.ToggleWebhookAsync(webhook.Id, !webhook.IsActive);
        await LoadWebhooks();
    }

    private async Task TestWebhook(int id)
    {
        isTesting = true;
        testingWebhookId = id;
        testResult = null;
        try
        {
            var success = await WebhookService.TestWebhookAsync(id);
            testResult = success;
            await LoadWebhooks();

            // Auto-dismiss toast
            _ = Task.Run(async () =>
            {
                await Task.Delay(5000);
                await InvokeAsync(() =>
                {
                    testResult = null;
                    StateHasChanged();
                });
            });
        }
        finally
        {
            isTesting = false;
            testingWebhookId = null;
        }
    }

    private async Task ShowDeliveries(WebhookDto webhook)
    {
        selectedWebhook = webhook;
        var response = await WebhookService.GetDeliveriesAsync(webhook.Id);
        deliveries = response?.Deliveries;
        showDeliveriesModal = true;
    }

    private void ConfirmDelete(WebhookDto webhook)
    {
        webhookToDelete = webhook;
        showDeleteModal = true;
    }

    private async Task DeleteWebhook()
    {
        if (webhookToDelete == null) return;

        var success = await WebhookService.DeleteWebhookAsync(webhookToDelete.Id);
        if (success)
        {
            showDeleteModal = false;
            webhookToDelete = null;
            await LoadWebhooks();
        }
    }

    private static string GetCategoryIcon(string category) => category switch
    {
        "Invoice" => "\U0001f4c4",
        "Payment" => "\U0001f4b3",
        "Stock" => "\U0001f4e6",
        "Inventory" => "\U0001f4cb",
        "Customer" => "\U0001f465",
        "SAP" => "\U0001f504",
        _ => "\U0001f4cc"
    };

    private string TruncateUrl(string? text, int maxLength)
    {
        if (string.IsNullOrEmpty(text)) return "-";
        return text.Length <= maxLength ? text : text.Substring(0, maxLength) + "...";
    }
}
