@code {
    private static readonly int[] PageSizeOptions = [10, 25, 50, 100, 200];

    private static readonly NocturneSelectOption<int>[] PageSizeSelectOptions =
        PageSizeOptions.Select(s => new NocturneSelectOption<int>(s, s.ToString())).ToArray();

    // Written out rather than walked off the enum. Enum.GetValues yields one
    // entry per *name*, and Invoiced is an alias for Fulfilled — so the native
    // list this replaced offered "Fulfilled" twice, one of which filtered on a
    // status no order is ever stored under. The families are the ones
    // GetStatusDotClass gives the same status in the results table.
    private static readonly NocturneSelectOption<string>[] StatusFilterOptions =
    [
        new(string.Empty, "All statuses", "neutral") { RuleAfter = true },
        new(((int)SalesOrderStatus.Draft).ToString(), "Draft", "neutral"),
        new(((int)SalesOrderStatus.Pending).ToString(), "Pending", "warn"),
        new(((int)SalesOrderStatus.Approved).ToString(), "Approved", "good"),
        new(((int)SalesOrderStatus.PartiallyFulfilled).ToString(), "Partially fulfilled", "info"),
        new(((int)SalesOrderStatus.Fulfilled).ToString(), "Fulfilled", "good"),
        new(((int)SalesOrderStatus.OnHold).ToString(), "On hold", "warn"),
        new(((int)SalesOrderStatus.Cancelled).ToString(), "Cancelled", "neutral"),
        new(((int)SalesOrderStatus.Rejected).ToString(), "Rejected", "bad")
    ];

    private List<SalesOrderDto>? orders;
    private SalesOrderDto? selectedOrder;
    private SalesOrderDto? approvalOrder;

    // Read when the approval dialog opens, from the credit sweep credit control already runs, so
    // the approver sees the room before clicking rather than the shortfall afterwards.
    private CreditHeadroom? approvalHeadroom;
    private bool approvalHeadroomLoading;
    private string approvalHeadroomAsAtDisplay = string.Empty;
    private SalesOrderDto? convertOrder;
    private bool isLoading = true;
    private bool isPdfLoading = false;
    private bool isRejecting = false;
    private bool isConverting = false;
    private bool showRejectModal = false;
    private string? errorMessage;
    private string rejectReason = string.Empty;
    private string? rejectReasonError;
    private string rejectOrderNumber = string.Empty;
    private int? rejectOrderId;
    private readonly Dictionary<int, OrderActionType> orderActionStates = new();
    private DateTime? resolvedRejectedNoteRecordedAtUtc;
    private string? resolvedRejectedNoteRecordedAtLocalDisplay;

    // Filters
    private string? orderNumberFilter;
    private string? customerFilter;
    private string? statusFilter;
    private string? sourceFilter = "";
    private DateTime? fromDate;
    private DateTime? toDate;

    // Pagination — the server pages this list, so a page change is a refetch.
    private int currentPage = 1;
    private int pageSize = 10;
    private int totalPages = 1;
    private int totalCount = 0;

    private enum OrderActionType
    {
        View,
        Approve,
        PostToSap,
        ConvertToInvoice,
        UpdateStatus,
        Delete
    }

    private string RangeLabel
    {
        get
        {
            if (isLoading && orders is null)
                return "Loading…";

            var shown = orders?.Count ?? 0;
            if (totalCount == 0 || shown == 0)
                return "No orders";

            var first = ((currentPage - 1) * pageSize) + 1;
            return $"{first:N0}–{first + shown - 1:N0} of {totalCount:N0} orders";
        }
    }

    protected override async Task OnInitializedAsync()
    {
        pageSize = AppSettings.PageSize;
        // Default date range to current month so SAP queries are always date-filtered
        fromDate = new DateTime(DateTime.Today.Year, DateTime.Today.Month, 1);
        toDate = DateTime.Today;
        await LoadOrders();
        await AuditService.LogAsync(AuditActions.ViewSalesOrders, "SalesOrder", null);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        await base.OnAfterRenderAsync(firstRender);

        var recordedAtUtc = selectedOrder is null
            ? null
            : GetRejectedNote(selectedOrder)?.RecordedAtUtc;

        if (recordedAtUtc is null)
        {
            resolvedRejectedNoteRecordedAtUtc = null;
            resolvedRejectedNoteRecordedAtLocalDisplay = null;
            return;
        }

        if (resolvedRejectedNoteRecordedAtUtc == recordedAtUtc)
            return;

        resolvedRejectedNoteRecordedAtUtc = recordedAtUtc;
        resolvedRejectedNoteRecordedAtLocalDisplay = await JSRuntime.InvokeAsync<string?>(
            "shopInventory.formatUtcForBrowserLocalDisplay",
            recordedAtUtc.Value.ToString("O", System.Globalization.CultureInfo.InvariantCulture));

        await InvokeAsync(StateHasChanged);
    }

    private async Task LoadOrders()
    {
        isLoading = true;
        errorMessage = null;

        try
        {
            SalesOrderStatus? status = null;
            if (!string.IsNullOrEmpty(statusFilter) && int.TryParse(statusFilter, out var statusInt))
            {
                status = (SalesOrderStatus)statusInt;
            }

            // Only filter by source when explicitly selected; null = fetch from SAP
            SalesOrderSource? source = null;
            if (!string.IsNullOrEmpty(sourceFilter) && int.TryParse(sourceFilter, out var sourceInt))
            {
                source = (SalesOrderSource)sourceInt;
            }

            var response = await SalesOrderService.GetSalesOrdersAsync(currentPage, pageSize, status, customerFilter, fromDate,
            toDate, source, orderNumberFilter);
            if (response != null)
            {
                orders = response.Orders;
                totalCount = response.TotalCount;
                totalPages = response.TotalPages;
                await RefreshSelectedOrderAsync();
            }
            else
            {
                errorMessage = "Failed to load sales orders.";
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Error: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task ApplyFilter()
    {
        currentPage = 1;
        await LoadOrders();
    }

    private async Task ClearFilter()
    {
        orderNumberFilter = null;
        customerFilter = null;
        statusFilter = null;
        fromDate = new DateTime(DateTime.Today.Year, DateTime.Today.Month, 1);
        toDate = DateTime.Today;
        currentPage = 1;
        await LoadOrders();
    }

    private async Task HandleFilterKeyDown(KeyboardEventArgs args)
    {
        if (args.Key == "Enter")
        {
            await ApplyFilter();
        }
    }

    private async Task GoToPage(int page)
    {
        if (page >= 1 && page <= totalPages)
        {
            currentPage = page;
            await LoadOrders();
        }
    }

    private async Task OnPageSizeChanged()
    {
        currentPage = 1;
        await LoadOrders();
    }

    private async Task ViewOrder(SalesOrderDto order)
    {
        if (!TryBeginOrderAction(order.Id, OrderActionType.View))
            return;

        // Show drawer immediately with list data (header info)
        selectedOrder = order;
        StateHasChanged();

        // Fetch the full order with lines from the API
        try
        {
            var fullOrder = await SalesOrderService.GetSalesOrderDetailsAsync(order);
            if (fullOrder != null)
            {
                selectedOrder = fullOrder;
                StateHasChanged();
            }
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Failed to fetch full order details for {OrderId}", order.Id);
        }
        finally
        {
            EndOrderAction(order.Id);
            StateHasChanged();
        }
    }

    private void CloseDrawer()
    {
        selectedOrder = null;
    }

    private async Task RefreshSelectedOrderAsync()
    {
        if (selectedOrder == null)
            return;

        var refreshedOrder = orders?.FirstOrDefault(o => o.Id == selectedOrder.Id);
        if (refreshedOrder != null)
        {
            selectedOrder = refreshedOrder;
            return;
        }

        try
        {
            var fullOrder = await SalesOrderService.GetSalesOrderDetailsAsync(selectedOrder);
            if (fullOrder != null)
            {
                selectedOrder = fullOrder;
            }
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Failed to refresh selected sales order {OrderId}", selectedOrder.Id);
        }
    }

    private void NavigateToEdit(int id)
    {
        NavigationManager.NavigateTo($"/sales-orders/edit/{id}");
    }

    private async Task PrintSalesOrderPdf()
    {
        if (selectedOrder == null || isPdfLoading)
            return;

        isPdfLoading = true;
        try
        {
            var useLocal = !selectedOrder.IsSynced || !selectedOrder.SAPDocEntry.HasValue;
            var pdfId = useLocal ? selectedOrder.Id : selectedOrder.SAPDocEntry!.Value;
            var pdfBytes = await SalesOrderService.GetSalesOrderPdfAsync(pdfId, useLocal);

            if (pdfBytes == null || pdfBytes.Length == 0)
            {
                errorMessage = "Failed to retrieve sales order PDF for printing.";
                return;
            }

            var base64 = Convert.ToBase64String(pdfBytes);
            await JSRuntime.InvokeVoidAsync("printPdfFromBase64", base64);
            await AuditService.LogAsync(AuditActions.PrintSalesOrderPdf, "SalesOrder", selectedOrder.OrderNumber);
        }
        catch (Exception ex)
        {
            errorMessage = $"Print failed: {ex.Message}";
        }
        finally
        {
            isPdfLoading = false;
        }
    }

    private bool TryBeginOrderAction(int id, OrderActionType action)
    {
        if (orderActionStates.ContainsKey(id))
            return false;

        orderActionStates[id] = action;
        return true;
    }

    private void EndOrderAction(int id)
    {
        orderActionStates.Remove(id);
    }

    private bool IsOrderActionBusy(int id) => orderActionStates.ContainsKey(id);

    private bool IsOrderActionBusy(int id, OrderActionType action)
        => orderActionStates.TryGetValue(id, out var currentAction) && currentAction == action;

    private async Task OpenApprovalModal(SalesOrderDto order)
    {
        if (IsOrderActionBusy(order.Id))
            return;

        approvalOrder = order;
        approvalHeadroom = null;
        approvalHeadroomLoading = true;

        try
        {
            var response = await SalesOrderService.GetCreditHeadroomAsync(order.CardCode ?? string.Empty);

            // The dialog may have been closed, or reopened on a different order, while this was in
            // flight. Applying a stale answer would put one customer's limit against another's order.
            if (approvalOrder?.Id == order.Id)
            {
                approvalHeadroom = response?.Accounts.FirstOrDefault();
                approvalHeadroomAsAtDisplay = await ResolveHeadroomAsAtDisplayAsync(response);
            }
        }
        finally
        {
            if (approvalOrder?.Id == order.Id)
            {
                approvalHeadroomLoading = false;
            }
        }
    }

    private void CloseApprovalModal()
    {
        if (approvalOrder != null && IsOrderActionBusy(approvalOrder.Id, OrderActionType.Approve))
            return;

        approvalOrder = null;
        approvalHeadroom = null;
        approvalHeadroomLoading = false;
        approvalHeadroomAsAtDisplay = string.Empty;
    }

    /// <summary>
    /// When the balances behind the headroom were actually read, in the browser's own time zone.
    /// </summary>
    /// <remarks>
    /// Worth saying out loud rather than implying the figures are live: they come from a sweep that
    /// is cached for minutes, and the whole point of the note is that somebody is about to make a
    /// decision on them. A payment taken in between moves the real answer and not this one.
    /// </remarks>
    private async Task<string> ResolveHeadroomAsAtDisplayAsync(CreditHeadroomResponse? response)
    {
        if (response is null || response.GeneratedAt == default)
        {
            return string.Empty;
        }

        var display = await JSRuntime.InvokeAsync<string?>(
            "shopInventory.formatUtcForBrowserLocalDisplay",
            response.GeneratedAt.ToString("O", System.Globalization.CultureInfo.InvariantCulture));

        return display ?? string.Empty;
    }

    /// <summary>
    /// What this order leaves the customer, or how far over it goes. Null when there is no limit to
    /// measure against, or the headroom could not be read.
    /// </summary>
    private decimal? ApprovalHeadroomAfterOrder =>
        approvalHeadroom is { HasLimit: true } headroom && approvalOrder is not null
            ? headroom.Headroom - approvalOrder.DocTotal
            : null;

    private bool ApprovalWouldBreachCredit => ApprovalHeadroomAfterOrder is < 0;

    /// <summary>
    /// The account the limit belongs to, said the way a rep needs to hear it. For a consolidated
    /// account that is the parent — a payment against the order's own customer will not move it.
    /// </summary>
    private static string CreditAccountLabel(CreditHeadroom headroom)
    {
        var code = headroom.CreditAccountCardCode ?? headroom.CardCode;
        var name = string.IsNullOrWhiteSpace(headroom.CreditAccountName) ? code : $"{headroom.CreditAccountName} ({code})";

        return headroom.IsGroup
            ? $"Group under {name}, across {headroom.AccountCount} accounts"
            : name;
    }

    private static string Money(decimal amount, string? currency) =>
        string.IsNullOrWhiteSpace(currency) ? amount.ToString("N2") : $"{currency} {amount:N2}";

    private async Task ConfirmApproval()
    {
        if (approvalOrder == null)
            return;

        var approved = await ApproveOrder(approvalOrder.Id);
        if (approved)
            approvalOrder = null;
    }

    private async Task<bool> ApproveOrder(int id)
    {
        if (!TryBeginOrderAction(id, OrderActionType.Approve))
            return false;

        StateHasChanged();
        var approvalTimer = Stopwatch.StartNew();

        try
        {
            var result = await SalesOrderService.ApproveAsync(id);
            if (result != null)
            {
                approvalTimer.Stop();
                selectedOrder = result;
                var approvalMessage = result.IsSynced
                    ? result.SAPDocNum.HasValue
                        ? $"Order {result.OrderNumber} approved and posted to SAP successfully! (Doc #{result.SAPDocNum})"
                        : $"Order {result.OrderNumber} approved and posted to SAP successfully."
                    : $"Order {result.OrderNumber} approved successfully.";
                Snackbar.Add(approvalMessage, Severity.Success);
                Logger.LogInformation(
                    "Sales order {OrderId} approval completed in {ApprovalDurationMs} ms. SAPDocNum={SAPDocNum}",
                    id,
                    approvalTimer.ElapsedMilliseconds,
                    result.SAPDocNum);
                var auditMessage = result.IsSynced && result.SAPDocNum.HasValue
                    ? $"Approved and posted to SAP as Doc #{result.SAPDocNum}"
                    : "Approved";
                await AuditService.LogAsync(AuditActions.ApproveSalesOrder, "SalesOrder", id.ToString(), auditMessage, true);
                await LoadOrders();
                return true;
            }

            Snackbar.Add("Failed to approve order. Please try again.", Severity.Error);
            return false;
        }
        catch (HttpRequestException ex)
        {
            approvalTimer.Stop();
            Logger.LogWarning(
                ex,
                "Sales order {OrderId} approval failed after {ApprovalDurationMs} ms",
                id,
                approvalTimer.ElapsedMilliseconds);
            Snackbar.Add(ex.Message, Severity.Error);
            return false;
        }
        catch (Exception ex)
        {
            approvalTimer.Stop();
            Logger.LogError(
                ex,
                "Sales order {OrderId} approval failed after {ApprovalDurationMs} ms",
                id,
                approvalTimer.ElapsedMilliseconds);
            Snackbar.Add($"Error approving order: {ex.Message}", Severity.Error);
            return false;
        }
        finally
        {
            approvalTimer.Stop();
            EndOrderAction(id);
            StateHasChanged();
        }
    }

    private async Task PostOrderToSAP(int id)
    {
        if (!TryBeginOrderAction(id, OrderActionType.PostToSap))
            return;

        StateHasChanged();

        try
        {
            var result = await SalesOrderService.PostToSAPAsync(id);
            if (result != null)
            {
                Snackbar.Add($"Order {result.OrderNumber} posted to SAP successfully! (Doc #{result.SAPDocNum})", Severity.Success);
                await AuditService.LogAsync(AuditActions.PostSalesOrderToSAP, "SalesOrder", id.ToString(), $"SAP Doc #{result.SAPDocNum}", true);
                selectedOrder = null;
                await LoadOrders();
            }
            else
            {
                Snackbar.Add("Failed to post order to SAP. Please try again.", Severity.Error);
            }
        }
        catch (HttpRequestException ex)
        {
            Snackbar.Add($"SAP posting failed: {ex.Message}", Severity.Error);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error posting to SAP: {ex.Message}", Severity.Error);
        }
        finally
        {
            EndOrderAction(id);
            StateHasChanged();
        }
    }

    private void OpenConvertDialog(SalesOrderDto order)
    {
        if (IsOrderActionBusy(order.Id))
            return;

        convertOrder = order;
    }

    private void CloseConvertDialog()
    {
        if (isConverting)
            return;

        convertOrder = null;
    }

    private async Task ConfirmConvertToInvoice()
    {
        if (convertOrder == null)
            return;

        var order = convertOrder;
        if (!TryBeginOrderAction(order.Id, OrderActionType.ConvertToInvoice))
            return;

        isConverting = true;
        StateHasChanged();

        try
        {
            var invoice = await SalesOrderService.ConvertToInvoiceAsync(order.Id);
            if (invoice != null)
            {
                Snackbar.Add($"Order {order.OrderNumber} converted to Invoice #{invoice.DocNum} successfully!", Severity.Success);
                await AuditService.LogAsync(AuditActions.ConvertOrderToInvoice, "SalesOrder", order.Id.ToString(), $"Converted to Invoice #{invoice.DocNum}", true);
                convertOrder = null;
                await LoadOrders();
            }
            else
            {
                Snackbar.Add("Failed to convert sales order to invoice. Please try again.", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error converting order: {ex.Message}", Severity.Error);
        }
        finally
        {
            isConverting = false;
            EndOrderAction(order.Id);
            StateHasChanged();
        }
    }

    private void OpenRejectModal(SalesOrderDto order)
    {
        if (order is null || IsOrderActionBusy(order.Id))
            return;

        rejectOrderId = order.Id;
        rejectOrderNumber = order.OrderNumber;
        rejectReason = string.Empty;
        rejectReasonError = null;
        showRejectModal = true;
    }

    private void CloseRejectModal()
    {
        if (isRejecting)
            return;

        showRejectModal = false;
        rejectOrderId = null;
        rejectOrderNumber = string.Empty;
        rejectReason = string.Empty;
        rejectReasonError = null;
    }

    private async Task ConfirmRejectOrder()
    {
        if (!rejectOrderId.HasValue)
            return;

        var reason = rejectReason.Trim();
        if (string.IsNullOrWhiteSpace(reason))
        {
            rejectReasonError = "A rejection reason is required.";
            return;
        }

        var orderId = rejectOrderId.Value;
        var orderNumber = rejectOrderNumber;

        if (!TryBeginOrderAction(orderId, OrderActionType.UpdateStatus))
            return;

        rejectReasonError = null;
        isRejecting = true;
        StateHasChanged();

        try
        {
            var result = await SalesOrderService.UpdateStatusAsync(orderId, SalesOrderStatus.Rejected, reason);
            if (result != null)
            {
                if (selectedOrder?.Id == orderId)
                    selectedOrder = result;

                Snackbar.Add($"Order {orderNumber} rejected successfully.", Severity.Warning);
                await AuditService.LogAsync(AuditActions.UpdateSalesOrder, "SalesOrder", orderId.ToString(), $"Rejected: {reason}", true);
                CloseRejectModal();
                await LoadOrders();
            }
            else
            {
                Snackbar.Add("Failed to reject order. Please try again.", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error rejecting order: {ex.Message}", Severity.Error);
        }
        finally
        {
            isRejecting = false;
            EndOrderAction(orderId);
            StateHasChanged();
        }
    }

    private Task CancelOrder(int id)
        => ChangeOrderStatus(id, SalesOrderStatus.Cancelled, "Order cancelled successfully.");

    private Task RestoreOrderToDraft(int id)
        => ChangeOrderStatus(id, SalesOrderStatus.Draft, "Order moved back to draft.");

    private async Task ChangeOrderStatus(int id, SalesOrderStatus status, string successMessage)
    {
        if (!TryBeginOrderAction(id, OrderActionType.UpdateStatus))
            return;

        StateHasChanged();

        try
        {
            var result = await SalesOrderService.UpdateStatusAsync(id, status);
            if (result != null)
            {
                if (selectedOrder?.Id == id)
                {
                    selectedOrder = result;
                }

                Snackbar.Add(successMessage, Severity.Success);
                await LoadOrders();
            }
            else
            {
                Snackbar.Add($"Failed to {GetStatusChangeVerb(status)} order. Please try again.", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error updating order status: {ex.Message}", Severity.Error);
        }
        finally
        {
            EndOrderAction(id);
            StateHasChanged();
        }
    }

    private async Task DeleteOrder(int id)
    {
        if (!TryBeginOrderAction(id, OrderActionType.Delete))
            return;

        StateHasChanged();

        try
        {
            var success = await SalesOrderService.DeleteSalesOrderAsync(id);
            if (success)
            {
                Snackbar.Add("Order deleted successfully.", Severity.Success);
                await AuditService.LogAsync(AuditActions.DeleteSalesOrder, "SalesOrder", id.ToString());
                await LoadOrders();
            }
            else
            {
                Snackbar.Add("Failed to delete order. Please try again.", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error deleting order: {ex.Message}", Severity.Error);
        }
        finally
        {
            EndOrderAction(id);
            StateHasChanged();
        }
    }

    /// <summary>
    /// The dot beside a status. Nocturne reserves a colour fill for the states that
    /// need acting on; everything settled reads in neutral ink.
    /// </summary>
    private static string GetStatusDotClass(SalesOrderStatus status) => status switch
    {
        SalesOrderStatus.Draft => "is-draft",
        SalesOrderStatus.Pending => "is-pending",
        SalesOrderStatus.Approved => "is-approved",
        SalesOrderStatus.PartiallyFulfilled => "is-partial",
        SalesOrderStatus.Fulfilled or SalesOrderStatus.Invoiced => "is-fulfilled",
        SalesOrderStatus.Cancelled => "is-void",
        SalesOrderStatus.OnHold => "is-pending",
        SalesOrderStatus.Rejected => "is-bad",
        _ => "is-draft"
    };

    private static string GetStatusTextClass(SalesOrderStatus status) => status switch
    {
        SalesOrderStatus.Approved or SalesOrderStatus.PartiallyFulfilled => "is-live",
        SalesOrderStatus.Rejected => "is-bad",
        _ => string.Empty
    };

    private static RejectedStatusNote? GetRejectedNote(SalesOrderDto order)
    {
        if (order.Status != SalesOrderStatus.Rejected || string.IsNullOrWhiteSpace(order.Comments))
            return null;

        const string marker = "Status changed to Rejected:";
        var commentLines = order.Comments
            .Split(['\r', '\n'], StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);

        for (var index = commentLines.Length - 1; index >= 0; index--)
        {
            var line = commentLines[index];
            var markerIndex = line.IndexOf(marker, StringComparison.OrdinalIgnoreCase);
            if (markerIndex < 0)
                continue;

            var reason = line[(markerIndex + marker.Length)..].Trim();
            if (string.IsNullOrWhiteSpace(reason))
                return null;

            DateTime? recordedAtUtc = null;
            var closingBracketIndex = line.IndexOf(']');
            if (line.StartsWith('[') && closingBracketIndex > 1)
            {
                var timestampText = line[1..closingBracketIndex].Trim();
                if (DateTime.TryParseExact(
                    timestampText,
                    "yyyy-MM-dd HH:mm",
                    System.Globalization.CultureInfo.InvariantCulture,
                    System.Globalization.DateTimeStyles.AssumeUniversal | System.Globalization.DateTimeStyles.AdjustToUniversal,
                    out var parsedTimestamp))
                {
                    recordedAtUtc = parsedTimestamp;
                }
            }

            return new RejectedStatusNote(reason, recordedAtUtc);
        }

        return null;
    }

    private sealed record RejectedStatusNote(string Reason, DateTime? RecordedAtUtc)
    {
    }

    private string? GetRejectedNoteRecordedAtLocalDisplay(RejectedStatusNote? note)
        => note?.RecordedAtUtc is not null && resolvedRejectedNoteRecordedAtUtc == note.RecordedAtUtc
            ? resolvedRejectedNoteRecordedAtLocalDisplay
            : null;

    /// <summary>
    /// Why an unposted order is sitting where it is. The API records this on the order itself —
    /// a credit hold noted when a mobile order was priced, or the message from a posting attempt
    /// that failed — and until now nothing showed it, so a refused approval left no trace once the
    /// snackbar cleared. An order that reached SAP has nothing to explain.
    /// </summary>
    private static string? GetPostingBlockReason(SalesOrderDto order)
        => order.IsSynced || order.SAPDocNum.HasValue ? null : order.SyncError;

    /// <summary>
    /// Whether an order can still be sent for approval and on to SAP.
    /// </summary>
    /// <remarks>
    /// Draft belongs here as much as Pending. A Web order is created as Draft and auto-posted
    /// straight away; when that post is refused - an unpriced line, a credit hold, SAP down - the
    /// create path resets it to Draft and records the reason. Gating approval on Pending alone
    /// left every one of those orders with no way forward on this page: editing the order fixed
    /// the cause but no button existed to retry it, so the fix looked like it had not worked.
    /// The API has always accepted a Draft here (SalesOrderService.ApproveAsync), and the mobile
    /// drafts page has always offered it; this page was the one that did not.
    /// </remarks>
    private static bool CanApproveOrder(SalesOrderDto order)
        => !order.IsSynced && order.Status is SalesOrderStatus.Draft or SalesOrderStatus.Pending;

    private static bool CanRejectOrder(SalesOrderDto order)
        => !order.IsSynced && order.Status is SalesOrderStatus.Draft or SalesOrderStatus.Pending or SalesOrderStatus.OnHold;

    private static bool CanCancelOrder(SalesOrderDto order)
        => !order.IsSynced && order.Status is SalesOrderStatus.Draft or SalesOrderStatus.Pending or SalesOrderStatus.Approved or SalesOrderStatus.PartiallyFulfilled or SalesOrderStatus.OnHold;

    private static bool CanRestoreToDraft(SalesOrderDto order)
        => !order.IsSynced && (order.Status == SalesOrderStatus.Cancelled || order.Status == SalesOrderStatus.Rejected);

    private static bool CanDeleteOrder(SalesOrderDto order)
        => !order.IsSynced && (order.Status == SalesOrderStatus.Draft || order.Status == SalesOrderStatus.Cancelled || order.Status == SalesOrderStatus.Rejected);

    private static string GetStatusChangeVerb(SalesOrderStatus status)
        => status == SalesOrderStatus.Draft ? "restore" : "cancel";
}
