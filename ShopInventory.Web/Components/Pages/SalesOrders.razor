@page "/sales-orders"
@using System.Diagnostics
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize(Roles = "Admin,Cashier,SalesRep")]
@inject ISalesOrderService SalesOrderService
@inject NavigationManager NavigationManager
@inject ISnackbar Snackbar
@inject ILogger<SalesOrders> Logger
@inject IAppSettingsProvider AppSettings
@inject IAuditService AuditService
@inject IJSRuntime JSRuntime
@rendermode InteractiveServer

<PageTitle>Sales Orders - Shop Inventory</PageTitle>

@* Nocturne, carried by wwwroot/css/sales-orders.css (linked from App.razor) in
   both schemes, following the app's theme toggle like every other page. The
   palette and density scale are credit-notes.css's, unchanged, so the two list
   pages read as one system.

   Icon-only buttons draw their glyph inline rather than from the Phosphor font:
   the glyph is their whole label, so a font that fails to load would leave them
   reading as dead controls. *@

<div class="sox">

    <header class="sox-head">
        <div class="sox-shell">
            <div class="sox-titles">
                <div class="sox-titles-row">
                    <i class="ph ph-shopping-cart" aria-hidden="true"></i>
                    <h1 class="sox-title">Sales Orders</h1>
                </div>
                <p class="sox-sub">Track order status and fulfilment</p>
            </div>
            <div class="sox-head-actions">
                <span class="sox-count">@totalCount.ToString("N0") orders</span>
                <AuthorizeView Roles="Admin,Cashier" Context="createAccess">
                    <Authorized>
                        <a class="sox-btn sox-btn-primary" href="/sales-orders/create">
                            <i class="ph ph-plus" aria-hidden="true"></i>New sales order
                        </a>
                    </Authorized>
                </AuthorizeView>
            </div>
        </div>
        <div class="sox-rule"></div>
    </header>

    <div class="sox-body">

        @if (!string.IsNullOrEmpty(errorMessage))
        {
            <div class="sox-alert" role="alert">
                <i class="ph ph-warning-octagon" aria-hidden="true"></i>
                <div class="sox-alert-body">@errorMessage</div>
                <button type="button" class="sox-btn sox-btn-ghost sox-btn-icon-sm" title="Dismiss"
                        aria-label="Dismiss error" @onclick="() => errorMessage = null">
                    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"></path></svg>
                </button>
            </div>
        }

        @* Counted over the loaded page, not the whole result set — the labels say
           "on this page" so the numbers cannot be misread as totals. Only the
           first tile, which reads the server's count, is a true total. *@
        @if (orders?.Any() == true)
        {
            <section class="sox-stats" aria-label="Order counts">
                <div class="sox-stat">
                    <span class="sox-stat-mark" aria-hidden="true"><i class="ph ph-shopping-cart"></i></span>
                    <div>
                        <div class="sox-stat-value">@totalCount.ToString("N0")</div>
                        <div class="sox-stat-label">Total orders</div>
                    </div>
                </div>
                <div class="sox-stat">
                    <span class="sox-stat-mark is-quiet" aria-hidden="true"><i class="ph ph-clock-countdown"></i></span>
                    <div>
                        <div class="sox-stat-value">@orders.Count(o => o.Status == SalesOrderStatus.Pending)</div>
                        <div class="sox-stat-label">Pending on this page</div>
                    </div>
                </div>
                <div class="sox-stat">
                    <span class="sox-stat-mark" aria-hidden="true"><i class="ph ph-check-circle"></i></span>
                    <div>
                        <div class="sox-stat-value">@orders.Count(o => o.Status == SalesOrderStatus.Approved)</div>
                        <div class="sox-stat-label">Approved on this page</div>
                    </div>
                </div>
                <div class="sox-stat">
                    <span class="sox-stat-mark is-quiet" aria-hidden="true"><i class="ph ph-truck"></i></span>
                    <div>
                        <div class="sox-stat-value">
                            @orders.Count(o => o.Status == SalesOrderStatus.Fulfilled || o.Status == SalesOrderStatus.Invoiced)
                        </div>
                        <div class="sox-stat-label">Fulfilled on this page</div>
                    </div>
                </div>
            </section>
        }

        <section class="sox-filters">
            <div class="sox-field" style="width:150px">
                <label for="sox-f-number">Order number</label>
                <input id="sox-f-number" class="sox-input sox-input-num" type="text" placeholder="e.g. SO-001"
                       @bind="orderNumberFilter" @bind:event="oninput" @onkeydown="HandleFilterKeyDown" />
            </div>
            <div class="sox-field" style="width:190px">
                <label for="sox-f-customer">Customer</label>
                <input id="sox-f-customer" class="sox-input" type="text" placeholder="Customer code"
                       @bind="customerFilter" @bind:event="oninput" @onkeydown="HandleFilterKeyDown" />
            </div>
            <div class="sox-field" style="width:160px">
                <label for="sox-f-status">Status</label>
                <NocturneSelect Id="sox-f-status" Class="nsel-block" TValue="string"
                                Options="StatusFilterOptions" @bind-Value="statusFilter"
                                Caption="Filter by status" AriaLabel="Filter by status"
                                Placeholder="All statuses" />
            </div>
            <div class="sox-field" style="width:140px">
                <label for="sox-f-from">From date</label>
                <NocturneDateField Id="sox-f-from" @bind-Date="fromDate" />
            </div>
            <div class="sox-field" style="width:140px">
                <label for="sox-f-to">To date</label>
                <NocturneDateField Id="sox-f-to" @bind-Date="toDate" />
            </div>
            <div class="sox-filter-actions">
                <button type="button" class="sox-btn sox-btn-ghost" @onclick="ClearFilter" disabled="@isLoading">
                    Clear
                </button>
                <button type="button" class="sox-btn sox-btn-secondary" @onclick="ApplyFilter" disabled="@isLoading">
                    <i class="ph ph-magnifying-glass" aria-hidden="true"></i>@(isLoading ? "Searching…" : "Search")
                </button>
            </div>
        </section>

        <section class="sox-card">

            <div class="sox-toolbar">
                <span class="sox-range">@RangeLabel</span>
                <span class="sox-hint">
                    <i class="ph ph-cursor-click" aria-hidden="true"></i>Open an order for its lines and actions
                </span>
            </div>

            <div class="sox-tablewrap">
                <table class="sox-table">
                    <thead>
                        <tr>
                            <th>Doc entry</th>
                            <th>Doc #</th>
                            <th>Customer</th>
                            <th>Order date</th>
                            <th>Delivery</th>
                            <th>Status</th>
                            <th>Currency</th>
                            <th class="sox-num">Total</th>
                            <th>Synced</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (isLoading)
                        {
                            @for (var skeletonRow = 0; skeletonRow < 8; skeletonRow++)
                            {
                                <tr>
                                    @for (var skeletonCell = 0; skeletonCell < 10; skeletonCell++)
                                    {
                                        <td><div class="sox-skel"></div></td>
                                    }
                                </tr>
                            }
                        }
                        else if (orders is not null)
                        {
                            @foreach (var order in orders)
                            {
                                <tr @key="order.Id" class="@(IsOrderActionBusy(order.Id) ? "is-busy" : null)">
                                    <td class="sox-docentry">@(order.SAPDocEntry?.ToString() ?? order.Id.ToString())</td>
                                    <td>
                                        <button type="button" class="sox-link" disabled="@IsOrderActionBusy(order.Id)"
                                                @onclick="async () => await ViewOrder(order)">
                                            @(order.SAPDocNum?.ToString() ?? order.OrderNumber)
                                        </button>
                                    </td>
                                    <td>
                                        <span class="sox-cust">
                                            <span class="sox-cust-name">@order.CardName</span>
                                            <span class="sox-cust-code">@order.CardCode</span>
                                        </span>
                                    </td>
                                    <td class="sox-date">@order.OrderDate.ToString("dd MMM yyyy")</td>
                                    <td class="sox-date @(order.DeliveryDate.HasValue ? null : "is-unset")">
                                        @(order.DeliveryDate?.ToString("dd MMM yyyy") ?? "—")
                                    </td>
                                    <td>
                                        <span class="sox-status-wrap">
                                            <span class="sox-status">
                                                <span class="sox-dot @GetStatusDotClass(order.Status)" aria-hidden="true"></span>
                                                <span class="sox-status-text @GetStatusTextClass(order.Status)">@order.StatusName</span>
                                            </span>
                                            @if (order.IsMobileOrder)
                                            {
                                                <span class="sox-tag">
                                                    <i class="ph ph-device-mobile" aria-hidden="true"></i>Mobile
                                                </span>
                                            }
                                        </span>
                                    </td>
                                    <td class="sox-curr">@order.Currency</td>
                                    <td class="sox-num">@order.DocTotal.ToString("N2")</td>
                                    <td>
                                        @if (order.IsSynced)
                                        {
                                            <span class="sox-sync">
                                                <span class="sox-pip" aria-hidden="true"></span>Synced
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="sox-sync is-pending">
                                                <span class="sox-pip" aria-hidden="true"></span>Pending
                                            </span>
                                        }
                                    </td>
                                    <td>
                                        <span class="sox-rowactions">
                                            <button type="button" class="sox-btn sox-btn-ghost sox-btn-icon-sm"
                                                    title="View order" aria-label="View order @order.OrderNumber"
                                                    disabled="@IsOrderActionBusy(order.Id)"
                                                    @onclick="async () => await ViewOrder(order)">
                                                @if (IsOrderActionBusy(order.Id, OrderActionType.View))
                                                {
                                                    <span class="sox-spin" aria-hidden="true"></span>
                                                }
                                                else
                                                {
                                                    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M2 12s3.6-6 10-6 10 6 10 6-3.6 6-10 6-10-6-10-6z"></path><circle cx="12" cy="12" r="2.6"></circle></svg>
                                                }
                                            </button>
                                            @if ((order.Status == SalesOrderStatus.Draft || order.Status == SalesOrderStatus.Pending) && !order.IsSynced)
                                            {
                                                <button type="button" class="sox-btn sox-btn-ghost sox-btn-icon-sm"
                                                        title="Edit order" aria-label="Edit order @order.OrderNumber"
                                                        disabled="@IsOrderActionBusy(order.Id)"
                                                        @onclick="() => NavigateToEdit(order.Id)">
                                                    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 20h4L19 9a2.1 2.1 0 0 0-3-3L5 17z"></path></svg>
                                                </button>
                                            }
                                            @if (order.Status == SalesOrderStatus.Approved && order.InvoiceId == null)
                                            {
                                                <button type="button" class="sox-btn sox-btn-ghost sox-btn-icon-sm"
                                                        title="Convert to invoice" aria-label="Convert order @order.OrderNumber to invoice"
                                                        disabled="@IsOrderActionBusy(order.Id)"
                                                        @onclick="() => OpenConvertDialog(order)">
                                                    @if (IsOrderActionBusy(order.Id, OrderActionType.ConvertToInvoice))
                                                    {
                                                        <span class="sox-spin" aria-hidden="true"></span>
                                                    }
                                                    else
                                                    {
                                                        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 3h12v18l-3-2-3 2-3-2-3 2z"></path><path d="M9 8h6M9 12h6"></path></svg>
                                                    }
                                                </button>
                                            }
                                            @if (!order.IsSynced)
                                            {
                                                @if (CanApproveOrder(order))
                                                {
                                                    <button type="button" class="sox-btn sox-btn-ghost sox-btn-icon-sm"
                                                            title="Approve" aria-label="Approve order @order.OrderNumber"
                                                            disabled="@IsOrderActionBusy(order.Id)"
                                                            @onclick="() => OpenApprovalModal(order)">
                                                        @if (IsOrderActionBusy(order.Id, OrderActionType.Approve))
                                                        {
                                                            <span class="sox-spin" aria-hidden="true"></span>
                                                        }
                                                        else
                                                        {
                                                            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12.5l4.5 4.5L19 7"></path></svg>
                                                        }
                                                    </button>
                                                }
                                                @if (CanRejectOrder(order))
                                                {
                                                    <button type="button" class="sox-btn sox-btn-ghost sox-btn-icon-sm"
                                                            title="Reject" aria-label="Reject order @order.OrderNumber"
                                                            disabled="@IsOrderActionBusy(order.Id)"
                                                            @onclick="() => OpenRejectModal(order)">
                                                        <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="9"></circle><path d="M8 12h8"></path></svg>
                                                    </button>
                                                }
                                                @if (CanCancelOrder(order))
                                                {
                                                    <button type="button" class="sox-btn sox-btn-ghost sox-btn-icon-sm"
                                                            title="Cancel" aria-label="Cancel order @order.OrderNumber"
                                                            disabled="@IsOrderActionBusy(order.Id)"
                                                            @onclick="() => CancelOrder(order.Id)">
                                                        @if (IsOrderActionBusy(order.Id, OrderActionType.UpdateStatus))
                                                        {
                                                            <span class="sox-spin" aria-hidden="true"></span>
                                                        }
                                                        else
                                                        {
                                                            <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="9"></circle><path d="M5.6 5.6l12.8 12.8"></path></svg>
                                                        }
                                                    </button>
                                                }
                                                @if (CanRestoreToDraft(order))
                                                {
                                                    <button type="button" class="sox-btn sox-btn-ghost sox-btn-icon-sm"
                                                            title="Back to draft" aria-label="Move order @order.OrderNumber back to draft"
                                                            disabled="@IsOrderActionBusy(order.Id)"
                                                            @onclick="() => RestoreOrderToDraft(order.Id)">
                                                        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 9h11a5 5 0 0 1 0 10H9"></path><path d="M8 5L4 9l4 4"></path></svg>
                                                    </button>
                                                }
                                                <AuthorizeView Roles="Admin" Context="deleteAccess">
                                                    <Authorized>
                                                        @if (CanDeleteOrder(order))
                                                        {
                                                            <button type="button" class="sox-btn sox-btn-ghost sox-btn-icon-sm"
                                                                    title="Delete" aria-label="Delete order @order.OrderNumber"
                                                                    disabled="@IsOrderActionBusy(order.Id)"
                                                                    @onclick="() => DeleteOrder(order.Id)">
                                                                @if (IsOrderActionBusy(order.Id, OrderActionType.Delete))
                                                                {
                                                                    <span class="sox-spin" aria-hidden="true"></span>
                                                                }
                                                                else
                                                                {
                                                                    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 7h16"></path><path d="M9 7V5h6v2"></path><path d="M6 7l1 13h10l1-13"></path></svg>
                                                                }
                                                            </button>
                                                        }
                                                    </Authorized>
                                                </AuthorizeView>
                                            }
                                        </span>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>

            @if (!isLoading && orders?.Any() != true)
            {
                <div class="sox-empty">
                    <i class="ph ph-funnel-simple" aria-hidden="true"></i>
                    <span>No sales orders found</span>
                    <span class="sox-empty-sub">Create a new order, or widen the date range and filters to find existing ones.</span>
                </div>
            }

            <div class="sox-foot">
                <span class="sox-foot-range">@RangeLabel</span>
                <span class="sox-pagesize">
                    <span>Rows</span>
                    <NocturneSelect Class="nsel-sm nsel-end nsel-up" Options="PageSizeSelectOptions"
                                    @bind-Value="pageSize" OnChanged="OnPageSizeChanged"
                                    AriaLabel="Rows per page" />
                </span>
                <div class="sox-pager">
                    <button type="button" class="sox-btn sox-btn-secondary sox-btn-icon" title="Previous page"
                            aria-label="Previous page" disabled="@(currentPage <= 1 || isLoading)"
                            @onclick="() => GoToPage(currentPage - 1)">
                        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M15 6l-6 6 6 6"></path></svg>
                    </button>
                    <span class="sox-page-label">Page @currentPage / @Math.Max(totalPages, 1)</span>
                    <button type="button" class="sox-btn sox-btn-secondary sox-btn-icon" title="Next page"
                            aria-label="Next page" disabled="@(currentPage >= totalPages || isLoading)"
                            @onclick="() => GoToPage(currentPage + 1)">
                        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 6l6 6-6 6"></path></svg>
                    </button>
                </div>
            </div>
        </section>
    </div>
</div>

@if (selectedOrder != null)
{
    var rejectedNote = GetRejectedNote(selectedOrder);
    <div class="sox-overlay">
        <div class="sox-scrim" @onclick="CloseDrawer"></div>
        <aside class="sox-drawer" aria-label="Sales order detail">
            <div class="sox-drawer-head">
                <h2 class="sox-drawer-title">
                    <i class="ph ph-shopping-cart" aria-hidden="true"></i>
                    @selectedOrder.OrderNumber
                </h2>
                <button type="button" class="sox-btn sox-btn-ghost sox-btn-icon" title="Close"
                        aria-label="Close details" @onclick="CloseDrawer">
                    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"></path></svg>
                </button>
            </div>
            <div class="sox-drawer-body">
                <div class="sox-grid">
                    <div>
                        <div class="sox-dt">Customer</div>
                        <div class="sox-dd">@selectedOrder.CardCode — @selectedOrder.CardName</div>
                    </div>
                    <div>
                        <div class="sox-dt">Order date</div>
                        <div class="sox-dd">@selectedOrder.OrderDate.ToString("dd MMM yyyy")</div>
                    </div>
                    <div>
                        <div class="sox-dt">Delivery date</div>
                        <div class="sox-dd">@(selectedOrder.DeliveryDate?.ToString("dd MMM yyyy") ?? "Not set")</div>
                    </div>
                    <div>
                        <div class="sox-dt">Status</div>
                        <div class="sox-dd">
                            <span class="sox-status">
                                <span class="sox-dot @GetStatusDotClass(selectedOrder.Status)" aria-hidden="true"></span>
                                <span class="sox-status-text @GetStatusTextClass(selectedOrder.Status)">@selectedOrder.StatusName</span>
                            </span>
                        </div>
                    </div>
                    <div>
                        <div class="sox-dt">Currency</div>
                        <div class="sox-dd">@selectedOrder.Currency</div>
                    </div>
                    <div>
                        <div class="sox-dt">Created by</div>
                        <div class="sox-dd">@(selectedOrder.CreatedByUserName ?? "—")</div>
                    </div>
                    <div>
                        <div class="sox-dt">SAP</div>
                        <div class="sox-dd">
                            @if (selectedOrder.IsSynced)
                            {
                                <span class="sox-sync">
                                    <span class="sox-pip" aria-hidden="true"></span>
                                    @(selectedOrder.SAPDocNum.HasValue ? $"Doc #{selectedOrder.SAPDocNum}" : "Synced")
                                </span>
                            }
                            else
                            {
                                <span class="sox-sync is-pending">
                                    <span class="sox-pip" aria-hidden="true"></span>Not posted
                                </span>
                            }
                        </div>
                    </div>
                    @if (selectedOrder.InvoiceId.HasValue)
                    {
                        <div>
                            <div class="sox-dt">Invoice</div>
                            <div class="sox-dd">#@selectedOrder.InvoiceId</div>
                        </div>
                    }
                </div>

                @if (selectedOrder.Status == SalesOrderStatus.Rejected)
                {
                    <div class="sox-note is-bad">
                        <div class="sox-dt">Rejected reason</div>
                        @if (!string.IsNullOrWhiteSpace(GetRejectedNoteRecordedAtLocalDisplay(rejectedNote)))
                        {
                            <div class="sox-note-meta">Recorded @GetRejectedNoteRecordedAtLocalDisplay(rejectedNote)</div>
                        }
                        <div>
                            @(string.IsNullOrWhiteSpace(rejectedNote?.Reason)
                                ? "No rejection reason was recorded for this order."
                                : rejectedNote.Reason)
                        </div>
                    </div>
                }

                @if (!string.IsNullOrWhiteSpace(GetPostingBlockReason(selectedOrder)))
                {
                    <div class="sox-note is-bad">
                        <div class="sox-dt">Not posted to SAP</div>
                        <div>@GetPostingBlockReason(selectedOrder)</div>
                    </div>
                }

                @if (selectedOrder.Lines?.Any() == true)
                {
                    <div>
                        <div class="sox-sect"><i class="ph ph-list-bullets" aria-hidden="true"></i>Order lines</div>
                        <div class="sox-linescroll">
                            <table class="sox-lines">
                                <thead>
                                    <tr>
                                        <th>Item</th>
                                        <th>Description</th>
                                        <th class="sox-num">Qty</th>
                                        <th class="sox-num">Unit price</th>
                                        <th class="sox-num">Total</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var line in selectedOrder.Lines)
                                    {
                                        <tr>
                                            <td><span class="sox-cust-name">@line.ItemCode</span></td>
                                            <td>@line.ItemDescription</td>
                                            <td class="sox-num">@QuantityDisplay.Format(line.Quantity, line.UoMCode)</td>
                                            <td class="sox-num">@line.UnitPrice.ToString("N2")</td>
                                            <td class="sox-num">@line.LineTotal.ToString("N2")</td>
                                        </tr>
                                    }
                                </tbody>
                                <tfoot>
                                    <tr>
                                        <td colspan="4" class="sox-num">Subtotal</td>
                                        <td class="sox-num">@selectedOrder.SubTotal.ToString("N2")</td>
                                    </tr>
                                    <tr>
                                        <td colspan="4" class="sox-num">Tax</td>
                                        <td class="sox-num">@selectedOrder.TaxAmount.ToString("N2")</td>
                                    </tr>
                                </tfoot>
                            </table>
                        </div>

                        <div class="sox-total">
                            <span class="sox-total-label">Total</span>
                            <span class="sox-total-value">@selectedOrder.DocTotal.ToString("N2")</span>
                        </div>
                    </div>
                }
            </div>
            <div class="sox-drawer-foot">
                @if ((selectedOrder.Status == SalesOrderStatus.Draft || selectedOrder.Status == SalesOrderStatus.Pending)
                     && !selectedOrder.IsSynced)
                {
                    <button type="button" class="sox-btn sox-btn-secondary"
                            disabled="@IsOrderActionBusy(selectedOrder.Id)"
                            @onclick="() => NavigateToEdit(selectedOrder.Id)">
                        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 20h4L19 9a2.1 2.1 0 0 0-3-3L5 17z"></path></svg>Edit
                    </button>
                }
                @if (!selectedOrder.IsSynced && CanRejectOrder(selectedOrder))
                {
                    <button type="button" class="sox-btn sox-btn-bad"
                            disabled="@IsOrderActionBusy(selectedOrder.Id)"
                            @onclick="() => OpenRejectModal(selectedOrder)">
                        @if (IsOrderActionBusy(selectedOrder.Id, OrderActionType.UpdateStatus))
                        {
                            <span class="sox-spin" aria-hidden="true"></span>
                            <span>Rejecting…</span>
                        }
                        else
                        {
                            <span>Reject</span>
                        }
                    </button>
                }
                @if (CanApproveOrder(selectedOrder))
                {
                    <button type="button" class="sox-btn sox-btn-primary"
                            disabled="@IsOrderActionBusy(selectedOrder.Id)"
                            @onclick="() => OpenApprovalModal(selectedOrder)">
                        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12.5l4.5 4.5L19 7"></path></svg>Review &amp; approve
                    </button>
                }
                @if (selectedOrder.Status == SalesOrderStatus.Approved && !selectedOrder.IsSynced)
                {
                    <button type="button" class="sox-btn sox-btn-primary"
                            disabled="@IsOrderActionBusy(selectedOrder.Id)"
                            @onclick="() => PostOrderToSAP(selectedOrder.Id)">
                        @if (IsOrderActionBusy(selectedOrder.Id, OrderActionType.PostToSap))
                        {
                            <span class="sox-spin" aria-hidden="true"></span>
                            <span>Posting…</span>
                        }
                        else
                        {
                            <span>Post to SAP</span>
                        }
                    </button>
                }
                <button type="button" class="sox-btn sox-btn-secondary" disabled="@isPdfLoading"
                        @onclick="PrintSalesOrderPdf">
                    @if (isPdfLoading)
                    {
                        <span class="sox-spin" aria-hidden="true"></span>
                        <span>Preparing…</span>
                    }
                    else
                    {
                        <span>Print</span>
                    }
                </button>
                <button type="button" class="sox-btn sox-btn-secondary" @onclick="CloseDrawer">Close</button>
            </div>
        </aside>
    </div>
}

@if (approvalOrder != null)
{
    <div class="sox-overlay">
        <div class="sox-dialog-wrap" @onclick="CloseApprovalModal">
            <div class="sox-dialog" role="dialog" aria-modal="true" aria-labelledby="sox-approve-title"
                 @onclick:stopPropagation="true">
                <h2 class="sox-dialog-title" id="sox-approve-title">
                    <i class="ph ph-check-circle" aria-hidden="true"></i>Approve sales order
                </h2>
                <div class="sox-dialog-body">
                    @if (IsOrderActionBusy(approvalOrder.Id, OrderActionType.Approve))
                    {
                        @* Approval posts to SAP in the same call, and that round trip is long
                           enough that a spinner on the button alone reads as a hung page. *@
                        <div class="sox-working" aria-live="polite">
                            <span class="sox-spin sox-spin-lg" aria-hidden="true"></span>
                            <h3>Approving and posting to SAP</h3>
                            <p>
                                Current SAP pricing is being validated, duplicate safeguards are being
                                checked, and the order is being posted. Please keep this window open.
                            </p>
                            <div class="sox-track" aria-hidden="true"><span></span></div>
                            <div class="sox-working-meta">Order @approvalOrder.OrderNumber · retries are protected</div>
                        </div>
                    }
                    else
                    {
                        <div class="sox-summary">
                            <div class="sox-summary-item is-wide">
                                <div class="sox-dt">Customer</div>
                                <div class="sox-summary-value" title="@approvalOrder.CardName">
                                    @approvalOrder.CardCode — @approvalOrder.CardName
                                </div>
                            </div>
                            <div class="sox-summary-item">
                                <div class="sox-dt">Order</div>
                                <div class="sox-summary-value">@approvalOrder.OrderNumber</div>
                            </div>
                            <div class="sox-summary-item">
                                <div class="sox-dt">Amount</div>
                                <div class="sox-summary-value">@approvalOrder.Currency @approvalOrder.DocTotal.ToString("N2")</div>
                            </div>
                            @if (approvalOrder.Lines?.Count > 0)
                            {
                                <div class="sox-summary-item">
                                    <div class="sox-dt">Lines</div>
                                    <div class="sox-summary-value">@approvalOrder.Lines.Count</div>
                                </div>
                            }
                            <div class="sox-summary-item">
                                <div class="sox-dt">Created by</div>
                                <div class="sox-summary-value">@(approvalOrder.CreatedByUserName ?? "Unknown")</div>
                            </div>
                        </div>
                        @if (!string.IsNullOrWhiteSpace(GetPostingBlockReason(approvalOrder)))
                        {
                            @* Recorded when the order was captured, so it can be out of date — a
                               payment may have landed since. The refusal itself is SAP-side and is
                               re-checked on this click, so the button stays live. *@
                            <div class="sox-note is-bad">
                                <div class="sox-dt">This order will be refused</div>
                                <div>@GetPostingBlockReason(approvalOrder)</div>
                            </div>
                        }
                        @* The room the customer actually has, before the click rather than after it.
                           The credit gate runs SAP-side on approval and is still what decides; this
                           is the same arithmetic on the sweep credit control already runs, so an
                           approver can see how far over an order is without spending 8 to 26 seconds
                           discovering it. *@
                        @if (approvalHeadroomLoading)
                        {
                            <div class="sox-note">
                                <div class="sox-dt">Credit</div>
                                <div>Checking how much room this customer has…</div>
                            </div>
                        }
                        else if (approvalHeadroom is { HasLimit: true } headroom)
                        {
                            <div class="@(ApprovalWouldBreachCredit ? "sox-note is-bad" : "sox-note")">
                                <div class="sox-dt">
                                    @(ApprovalWouldBreachCredit ? "This order goes over the credit limit" : "Credit room")
                                </div>
                                <div>
                                    @CreditAccountLabel(headroom):
                                    limit @Money(headroom.CreditLimit, headroom.Currency),
                                    owed @Money(headroom.Exposure, headroom.Currency),
                                    room @Money(headroom.Headroom, headroom.Currency).
                                </div>
                                <div>
                                    @if (ApprovalWouldBreachCredit)
                                    {
                                        <text>
                                            This order is @Money(approvalOrder.DocTotal, approvalOrder.Currency) —
                                            @Money(-(ApprovalHeadroomAfterOrder ?? 0m), headroom.Currency) over.
                                            Take a payment against @(headroom.CreditAccountCardCode ?? headroom.CardCode),
                                            or reduce the order by at least that much.
                                        </text>
                                    }
                                    else
                                    {
                                        <text>
                                            This order is @Money(approvalOrder.DocTotal, approvalOrder.Currency),
                                            leaving @Money(ApprovalHeadroomAfterOrder ?? 0m, headroom.Currency).
                                        </text>
                                    }
                                </div>
                                <div class="sox-note-meta">
                                    Balances as at @approvalHeadroomAsAtDisplay. A payment taken since then is not reflected.
                                </div>
                            </div>
                        }
                        <div class="sox-impact">
                            <i class="ph ph-info" aria-hidden="true"></i>
                            <div>
                                <strong>This action also posts the order to SAP.</strong>
                                Prices will be refreshed from SAP before posting, so the final amount may
                                reflect the customer's current pricing.
                            </div>
                        </div>
                    }
                </div>
                <div class="sox-dialog-actions">
                    <button type="button" class="sox-btn sox-btn-secondary" @onclick="CloseApprovalModal"
                            disabled="@IsOrderActionBusy(approvalOrder.Id, OrderActionType.Approve)">
                        Cancel
                    </button>
                    <button type="button" class="sox-btn sox-btn-primary" @onclick="ConfirmApproval"
                            disabled="@IsOrderActionBusy(approvalOrder.Id, OrderActionType.Approve)">
                        @if (IsOrderActionBusy(approvalOrder.Id, OrderActionType.Approve))
                        {
                            <span class="sox-spin" aria-hidden="true"></span>
                            <span>Approving…</span>
                        }
                        else
                        {
                            <span>Approve &amp; post to SAP</span>
                        }
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@if (showRejectModal)
