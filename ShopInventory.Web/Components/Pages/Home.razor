@page "/"
@page "/dashboard"
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using ShopInventory.Web.Data
@attribute [Authorize(Roles = UserRoles.DashboardRoles)]
@inject IInvoiceService InvoiceService
@inject IPaymentService PaymentService
@inject IInventoryTransferService TransferService
@inject NavigationManager Navigation
@inject IAuditService AuditService
@rendermode InteractiveServer

<PageTitle>@(isSalesRep ? "Sales Dashboard - Kefalos Cheese" : "Dashboard - Kefalos Cheese")</PageTitle>

@* The imported Nocturne design is dark; wwwroot/css/dashboard.css (linked
   from App.razor) carries it and its light counterpart, and follows the app's
   theme toggle like every other page.

   Sales reps get a different dashboard at the same route — see
   SalesRepDashboard, which shares this stylesheet.

   The header states when the figures were read. The label it replaces said
   "Updated just now" from a static string, which stayed true for about a
   minute of a shift that runs all day. The page reads once and does not poll,
   so that stamp is also how you tell how old the figures on screen are. *@

@if (isSalesRep)
{
    <SalesRepDashboard DisplayName="@GreetingName" />
}
else
{
    <div class="dsh">

        <header class="dsh-head">
            <div class="dsh-head-inner">
                <nav class="dsh-crumbs" aria-label="Breadcrumb">
                    <span>Sales</span>
                    <span class="dsh-crumb-sep" aria-hidden="true">/</span>
                    <span class="dsh-crumb-now" aria-current="page">Dashboard</span>
                </nav>

                <div class="dsh-head-meta">
                    <span class="dsh-synced">
                        <span class="dsh-synced-dot" aria-hidden="true"></span>
                        @if (loadedAt is { } stamp)
                        {
                            @($"Read at {stamp:HH:mm}")
                        }
                        else
                        {
                            @("Reading…")
                        }
                    </span>

                    <a class="dsh-btn dsh-btn-primary dsh-btn-lg" href="/invoices/create">
                        <DashIcon Name="plus-circle" Size="15" />
                        Create invoice
                    </a>
                </div>
            </div>
        </header>

        <div class="dsh-body">

            <section class="dsh-hero">
                <div>
                    <div class="dsh-kicker">Today at a glance</div>
                    <h1>@GreetingText, @GreetingName</h1>
                    <p>
                        Invoices raised, payments received and the transfer queue as they stand now.
                        Each comparison is against the same figure yesterday.
                    </p>
                </div>
                <div class="dsh-date">
                    <DashIcon Name="calendar" Size="14" />
                    <span>@DateTime.Now.ToString("dddd d MMMM yyyy")</span>
                </div>
            </section>

            @* Three figures, and the invoice count leads: it is the one the
               shift is measured on, so it is the one that carries the accent. *@
            <section class="dsh-stats" aria-label="Today's key figures">
                <StatCard Label="Invoices"
                          Value="@todayInvoiceCount.ToString()"
                          ValueLabel="Raised today"
                          Trend="@invoiceTrend.Text"
                          Direction="@invoiceTrend.Direction"
                          Amount="@FormatMoney(invoiceTotal)"
                          AmountLabel="Total value"
                          Icon="receipt"
                          IsLead="true" />
                <StatCard Label="Payments"
                          Value="@todayPaymentCount.ToString()"
                          ValueLabel="Received today"
                          Trend="@paymentTrend.Text"
                          Direction="@paymentTrend.Direction"
                          Amount="@FormatMoney(paymentTotal)"
                          AmountLabel="Total received"
                          Icon="card" />
                @* Transfers carry no monetary value and every per-warehouse read needs a
                   warehouse code, so this card reports the approval queue across all
                   warehouses. No historical series is available, hence no trend. *@
                <StatCard Label="Pending transfers"
                          Value="@pendingTransferCount.ToString()"
                          ValueLabel="Awaiting approval"
                          Amount="@pendingTransferUnits.ToString("N0")"
                          AmountLabel="Total units"
                          Icon="swap" />
            </section>

            <section class="dsh-panels" aria-label="Recent activity">
                <ActivityTable Title="Recent invoices"
                               ViewAllHref="/invoices"
                               Kind="ActivityTable.ActivityKind.Invoices"
                               Invoices="@recentInvoices"
                               IsLoading="@isLoadingInvoices" />
                <ActivityTable Title="Recent payments"
                               ViewAllHref="/payments"
                               Kind="ActivityTable.ActivityKind.Payments"
                               Payments="@recentPayments"
                               IsLoading="@isLoadingPayments" />
            </section>

            <section class="dsh-panel" aria-labelledby="quick-actions-heading">
                <header class="dsh-panel-head">
                    <span class="dsh-panel-icon">
                        <DashIcon Name="bolt" Size="15" />
                    </span>
                    <h2 id="quick-actions-heading">Quick actions</h2>
                </header>
                <div class="dsh-quick">
                    <QuickAction Title="Create invoice"
                                 Description="Raise a new sales invoice"
                                 Href="/invoices/create"
                                 Icon="note-add" />
                    <QuickAction Title="Search invoices"
                                 Description="Find and open an invoice"
                                 Href="/invoices"
                                 Icon="search" />
                    <QuickAction Title="View products"
                                 Description="Browse the product catalogue"
                                 Href="/products"
                                 Icon="box" />
                    <QuickAction Title="View prices"
                                 Description="Check a product's price"
                                 Href="/prices"
                                 Icon="tag" />
                </div>
            </section>

        </div>
    </div>
}

@code {
    [CascadingParameter]
    private Task<AuthenticationState>? AuthTask { get; set; }

    private int todayInvoiceCount;
    private int todayPaymentCount;
    private int pendingTransferCount;
    private decimal pendingTransferUnits;
    private decimal invoiceTotal;
    private decimal paymentTotal;
    private (string? Text, int Direction) invoiceTrend;
    private (string? Text, int Direction) paymentTrend;
    private List<InvoiceDto>? recentInvoices;
    private List<IncomingPaymentDto>? recentPayments;
    private bool isLoadingInvoices = true;
    private bool isLoadingPayments = true;
    private bool isSalesRep;
    private string currentUsername = "Sales Rep";
    private bool _initialized;

    /// <summary>When the figures on screen were read. Null until the first read lands.</summary>
    private DateTime? loadedAt;

    private static string FormatMoney(decimal value) => $"USD {value:N2}";
    private string GreetingName
    {
        get
        {
            var localName = currentUsername.Split('@')[0];
            var firstName = localName
                .Replace('.', ' ')
                .Replace('_', ' ')
                .Split(' ', StringSplitOptions.RemoveEmptyEntries)
                .FirstOrDefault();

            if (string.IsNullOrWhiteSpace(firstName)) return "there";
            return firstName.Length == 1
                ? firstName.ToUpperInvariant()
                : char.ToUpperInvariant(firstName[0]) + firstName[1..];
        }
    }

    private static string GreetingText => DateTime.Now.Hour switch
    {
        < 12 => "Good morning",
        < 17 => "Good afternoon",
        _ => "Good evening"
    };

    protected override async Task OnParametersSetAsync()
    {
        if (AuthTask == null) return;

        var authState = await AuthTask;
        var user = authState.User;

        if (user.Identity?.IsAuthenticated != true) return;

        currentUsername = user.Identity?.Name ?? currentUsername;

        if (user.IsInRole("PodOperator"))
        {
            Navigation.NavigateTo("/pods", replace: true);
            return;
        }

        if (user.IsInRole("Lab") && !user.IsInRole("Admin"))
        {
            Navigation.NavigateTo("/lab/batch-status", replace: true);
            return;
        }

        if (user.IsInRole("MerchandiserPurchaseOrderViewer"))
        {
            Navigation.NavigateTo("/reports/merchandiser-purchase-orders", replace: true);
            return;
        }

        isSalesRep = user.IsInRole("SalesRep");

        if (!_initialized)
        {
            _initialized = true;

            if (!isSalesRep)
            {
                await LoadDashboardData();
            }

            await AuditService.LogAsync(AuditActions.ViewDashboard, isSalesRep ? "SalesRepDashboard" : "Dashboard", null);
        }
    }

    // The invoice date-range API clamps a page to 100 rows.
    private const int InvoicePageSize = 100;
    private const int MaxInvoiceStatPages = 10;

    private async Task LoadDashboardData()
    {
        // The recent lists feed the activity tables and are not date-scoped; the stats
        // are today-versus-yesterday. Both run together so the page paints once.
        var tasks = new[]
        {
            LoadInvoicesAsync(),
            LoadPaymentsAsync(),
            LoadInvoiceStatsAsync(),
            LoadPaymentStatsAsync(),
            LoadPendingTransfersAsync()
        };

        await Task.WhenAll(tasks);

        // Stamped once every read has landed, so the header's time describes the
        // whole page rather than whichever call returned first.
        loadedAt = DateTime.Now;
    }

    private async Task LoadPendingTransfersAsync()
    {
        try
        {
            // 200 comfortably covers an approval queue, so TotalCount and the summed
            // quantities describe the same set of transfers.
            var response = await TransferService.GetPendingTransfersAsync(
                PendingTransferStatuses.AwaitingApproval,
                pageSize: 200);

            if (response != null)
            {
                pendingTransferCount = response.TotalCount;
                pendingTransferUnits = response.Items.Sum(item => item.TotalQuantity);
            }
        }
        catch
        {
            // Preserve the existing graceful unavailable state.
        }
        finally
        {
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task LoadInvoicesAsync()
    {
        try
        {
            var invoiceResponse = await InvoiceService.GetInvoicesAsync(1, 10);
            if (invoiceResponse?.Invoices != null)
            {
                recentInvoices = invoiceResponse.Invoices;
            }
        }
        catch
        {
            // Preserve the existing graceful unavailable state.
        }
        finally
        {
            isLoadingInvoices = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task LoadPaymentsAsync()
    {
        try
        {
            var paymentResponse = await PaymentService.GetPaymentsAsync(1, 10);
            if (paymentResponse?.Payments != null)
            {
                recentPayments = paymentResponse.Payments;
            }
        }
        catch
        {
            // Preserve the existing graceful unavailable state.
        }
        finally
        {
            isLoadingPayments = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task LoadInvoiceStatsAsync()
    {
        try
        {
            var today = DateTime.Today;
            var todayTask = GetInvoiceDayTotalsAsync(today, includeValue: true);
            // Yesterday only feeds the comparison, so ask for the smallest page that
            // still returns an authoritative TotalCount.
            var yesterdayTask = GetInvoiceDayTotalsAsync(today.AddDays(-1), includeValue: false);
            await Task.WhenAll(todayTask, yesterdayTask);

            var (count, total) = await todayTask;
            var (yesterdayCount, _) = await yesterdayTask;

            todayInvoiceCount = count;
            invoiceTotal = total;
            invoiceTrend = BuildTrend(count, yesterdayCount);
        }
        catch
        {
            // Preserve the existing graceful unavailable state.
        }
        finally
        {
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task LoadPaymentStatsAsync()
    {
        try
        {
            var today = DateTime.Today;
            var todayTask = GetPaymentDayTotalsAsync(today);
            var yesterdayTask = GetPaymentDayTotalsAsync(today.AddDays(-1));
            await Task.WhenAll(todayTask, yesterdayTask);

            var (count, total) = await todayTask;
            var (yesterdayCount, _) = await yesterdayTask;

            todayPaymentCount = count;
            paymentTotal = total;
            paymentTrend = BuildTrend(count, yesterdayCount);
        }
        catch
        {
            // Preserve the existing graceful unavailable state.
        }
        finally
        {
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task<(int Count, decimal Total)> GetInvoiceDayTotalsAsync(DateTime date, bool includeValue)
    {
        var response = await InvoiceService.GetInvoicesByDateRangeAsync(
            date, date, page: 1, pageSize: includeValue ? InvoicePageSize : 1);

        if (response == null) return (0, 0m);

        // TotalCount comes from a separate count query, so it is accurate even though
        // the API clamps a page to 100 rows.
        var count = response.TotalCount;
        if (!includeValue) return (count, 0m);

        var total = response.Invoices?.Sum(invoice => invoice.DocTotal) ?? 0m;
        var fetched = response.Invoices?.Count ?? 0;

        // A day busier than one page needs following pages before the value total
        // covers the same invoices the count describes.
        for (var page = 2; fetched < count && page <= MaxInvoiceStatPages; page++)
        {
            var next = await InvoiceService.GetInvoicesByDateRangeAsync(
                date, date, page: page, pageSize: InvoicePageSize);

            if (next?.Invoices is not { Count: > 0 }) break;

            total += next.Invoices.Sum(invoice => invoice.DocTotal);
            fetched += next.Invoices.Count;
        }

        return (count, total);
    }

    private async Task<(int Count, decimal Total)> GetPaymentDayTotalsAsync(DateTime date)
    {
        // The payments date-range endpoint is unpaged, so one call covers the whole day.
        var response = await PaymentService.GetPaymentsByDateAsync(date);
        if (response?.Payments == null) return (0, 0m);

        return (response.Payments.Count, response.Payments.Sum(payment => payment.DocTotal));
    }

    /// <summary>
    /// Day-over-day change in document count. Returns no text when neither day has
    /// any documents, and an absolute delta when yesterday gives nothing to divide by.
    /// </summary>
    private static (string? Text, int Direction) BuildTrend(int today, int yesterday)
    {
        if (today == 0 && yesterday == 0) return (null, 0);
        if (yesterday == 0) return ($"+{today}", 1);

        var change = Math.Round((today - yesterday) / (double)yesterday * 100d);
        return ($"{Math.Abs(change):N0}%", Math.Sign(change));
    }
}
