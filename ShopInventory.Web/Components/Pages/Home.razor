@page "/"
@page "/dashboard"
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using ShopInventory.Web.Common
@using ShopInventory.Web.Data
@attribute [Authorize(Roles = UserRoles.DashboardRoles)]
@inject NavigationManager Navigation
@inject IAuditService AuditService
@rendermode InteractiveServer

<PageTitle>@(isSalesRep ? "Sales Dashboard - Kefalos Cheese" : "Dashboard - Kefalos Cheese")</PageTitle>

@* /dashboard serves two workspaces, and this page is only the switch between
   them: a rep sees their own orders and accounts, an administrator sees the
   state of the system. Each dashboard owns its own component and its own
   loading, so neither carries the other's services.

   The roles that used to share this route — Cashier, StockController and
   Manager — now land on the page they work from, and will get workspaces of
   their own. RoleLandingRoutes holds that chain; see
   docs/role-dashboards-plan.md. *@

@if (isSalesRep)
{
    <SalesRepDashboard DisplayName="@GreetingName" />
}
else
{
    <AdminDashboard DisplayName="@GreetingName" />
}

@code {
    [CascadingParameter]
    private Task<AuthenticationState>? AuthTask { get; set; }

    private bool isSalesRep;
    private string currentUsername = "there";
    private bool _initialized;

    /// <summary>
    /// The first name to greet by, taken from the username. An address local
    /// part carries the name in one of a few shapes — first.last, first_last,
    /// or just the name — so all three reduce to the same greeting.
    /// </summary>
    private string GreetingName
    {
        get
        {
            var localName = currentUsername.Split('@')[0];
            var firstName = localName
                .Replace('.', ' ')
                .Replace('_', ' ')
                .Split(' ', StringSplitOptions.RemoveEmptyEntries)
                .FirstOrDefault();

            if (string.IsNullOrWhiteSpace(firstName)) return "there";
            return firstName.Length == 1
                ? firstName.ToUpperInvariant()
                : char.ToUpperInvariant(firstName[0]) + firstName[1..];
        }
    }

    protected override async Task OnParametersSetAsync()
    {
        if (AuthTask == null) return;

        var authState = await AuthTask;
        var user = authState.User;

        if (user.Identity?.IsAuthenticated != true) return;

        currentUsername = user.Identity?.Name ?? currentUsername;

        // Roles this route does not serve are sent to the page they work from —
        // a POD operator to the POD dashboard, a cashier to invoices.
        // RoleLandingRoutes holds that chain for the sign-in page and
        // RedirectToLogin too, so all three agree on where a role belongs.
        var landing = RoleLandingRoutes.For(user);
        if (!string.Equals(landing, RoleLandingRoutes.Dashboard, StringComparison.OrdinalIgnoreCase))
        {
            Navigation.NavigateTo(landing, replace: true);
            return;
        }

        isSalesRep = user.IsInRole("SalesRep");

        if (!_initialized)
        {
            _initialized = true;
            await AuditService.LogAsync(
                AuditActions.ViewDashboard,
                isSalesRep ? "SalesRepDashboard" : "AdminDashboard",
                null);
        }
    }
}
