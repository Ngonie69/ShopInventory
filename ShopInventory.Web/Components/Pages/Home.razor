@page "/"
@page "/dashboard"
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using ShopInventory.Web.Common
@using ShopInventory.Web.Data
@attribute [Authorize(Roles = UserRoles.DashboardRoles)]
@inject NavigationManager Navigation
@inject IAuditService AuditService
@rendermode InteractiveServer

<PageTitle>@PageHeading</PageTitle>

@* /dashboard serves three workspaces, and this page is only the switch
   between them: a rep sees their own orders and accounts, a depot controller
   sees the depot they run, an administrator sees the state of the system.
   Each dashboard owns its own component and its own loading, so none of them
   carries another's services.

   The roles that used to share this route — Cashier, StockController and
   Manager — now land on the page they work from, and will get workspaces of
   their own. RoleLandingRoutes holds that chain; see
   docs/role-dashboards-plan.md. *@

@if (isSalesRep)
{
    <SalesRepDashboard DisplayName="@GreetingName" />
}
else if (isDepotController)
{
    <DepotDashboard DisplayName="@GreetingName" />
}
else
{
    <AdminDashboard DisplayName="@GreetingName" />
}

@code {
    [CascadingParameter]
    private Task<AuthenticationState>? AuthTask { get; set; }

    private bool isSalesRep;
    private bool isDepotController;
    private string currentUsername = "there";
    private bool _initialized;

    private string PageHeading => (isSalesRep, isDepotController) switch
    {
        (true, _) => "Sales Dashboard - Kefalos Cheese",
        (_, true) => "Depot Dashboard - Kefalos Cheese",
        _ => "Dashboard - Kefalos Cheese"
    };

    /// <summary>
    /// The first name to greet by, taken from the username. An address local
    /// part carries the name in one of a few shapes — first.last, first_last,
    /// or just the name — so all three reduce to the same greeting.
    /// </summary>
    private string GreetingName
    {
        get
        {
            var localName = currentUsername.Split('@')[0];
            var firstName = localName
                .Replace('.', ' ')
                .Replace('_', ' ')
                .Split(' ', StringSplitOptions.RemoveEmptyEntries)
                .FirstOrDefault();

            if (string.IsNullOrWhiteSpace(firstName)) return "there";
            return firstName.Length == 1
                ? firstName.ToUpperInvariant()
                : char.ToUpperInvariant(firstName[0]) + firstName[1..];
        }
    }

    protected override async Task OnParametersSetAsync()
    {
        if (AuthTask == null) return;

        var authState = await AuthTask;
        var user = authState.User;

        if (user.Identity?.IsAuthenticated != true) return;

        currentUsername = user.Identity?.Name ?? currentUsername;

        // Roles this route does not serve are sent to the page they work from —
        // a POD operator to the POD dashboard, a cashier to invoices.
        // RoleLandingRoutes holds that chain for the sign-in page and
        // RedirectToLogin too, so all three agree on where a role belongs.
        var landing = RoleLandingRoutes.For(user);
        if (!string.Equals(landing, RoleLandingRoutes.Dashboard, StringComparison.OrdinalIgnoreCase))
        {
            Navigation.NavigateTo(landing, replace: true);
            return;
        }

        isSalesRep = user.IsInRole(UserRoles.SalesRep);

        // An administrator carrying the depot role keeps the administrator's
        // dashboard, the same reading RoleLandingRoutes takes of a narrow role
        // held alongside Admin.
        isDepotController = user.IsInRole(UserRoles.DepotController) && !user.IsInRole(UserRoles.Admin);

        if (!_initialized)
        {
            _initialized = true;

            // All three dashboards are components with their own reads; this
            // page holds none of their loading.
            var page = isSalesRep ? "SalesRepDashboard"
                : isDepotController ? "DepotDashboard"
                : "AdminDashboard";

            await AuditService.LogAsync(AuditActions.ViewDashboard, page, null);
        }
    }
}
