@page "/"
@page "/dashboard"
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using ShopInventory.Web.Data
@attribute [Authorize(Roles = UserRoles.DashboardRoles)]
@inject IInvoiceService InvoiceService
@inject IPaymentService PaymentService
@inject IInventoryTransferService TransferService
@inject NavigationManager Navigation
@inject IAuditService AuditService
@rendermode InteractiveServer

<PageTitle>@(isSalesRep ? "Sales Dashboard - Kefalos Cheese" : "Dashboard - Kefalos Cheese")</PageTitle>

@if (isSalesRep)
{
    <SalesRepDashboard Username="@currentUsername" />
}
else
{
    <div class="kf-dashboard">
        <header class="kf-dashboard-header">
            <div>
                <h1>Good morning, Ngoni</h1>
                <p>Today's sales snapshot</p>
            </div>
            <div class="kf-dashboard-header__actions">
                <span class="kf-live-status"><i aria-hidden="true"></i>Updated just now</span>
                <a class="kf-primary-button" href="/invoices/create">
                    <MudIcon Icon="@Icons.Material.Outlined.AddCircleOutline" />
                    Create invoice
                </a>
            </div>
        </header>

        <section class="kf-kpi-grid" aria-label="Today’s key performance indicators">
            <StatCard Label="Invoices"
                      Value="@todayInvoiceCount.ToString()"
                      ValueLabel="Total invoices"
                      Trend="18%"
                      Amount="@FormatMoney(invoiceTotal)"
                      AmountLabel="Total value"
                      Icon="@Icons.Material.Outlined.ReceiptLong" />
            <StatCard Label="Payments"
                      Value="@todayPaymentCount.ToString()"
                      ValueLabel="Total payments"
                      Trend="24%"
                      Amount="@FormatMoney(paymentTotal)"
                      AmountLabel="Total received"
                      Icon="@Icons.Material.Outlined.Payments"
                      Sparkline="@(new[] { 20, 31, 28, 45, 41, 59, 66, 62, 82, 94 })" />
            <StatCard Label="Inventory transfers"
                      Value="@transferCount.ToString()"
                      ValueLabel="Total transfers"
                      Trend="0%"
                      Amount="USD 0.00"
                      AmountLabel="Total value"
                      Icon="@Icons.Material.Outlined.SwapHoriz"
                      IsPositive="false"
                      Sparkline="@(new[] { 35, 35, 35, 35, 35, 35, 35, 35, 35, 35 })" />
        </section>

        <section class="kf-activity-grid" aria-label="Recent sales activity">
            <ActivityTable Title="Recent invoices"
                           ViewAllHref="/invoices"
                           Kind="ActivityTable.ActivityKind.Invoices"
                           Invoices="@recentInvoices"
                           IsLoading="@isLoadingInvoices" />
            <ActivityTable Title="Recent payments"
                           ViewAllHref="/payments"
                           Kind="ActivityTable.ActivityKind.Payments"
                           Payments="@recentPayments"
                           IsLoading="@isLoadingPayments" />
        </section>

        <section class="kf-quick-panel" aria-labelledby="quick-actions-heading">
            <header class="kf-quick-panel__header">
                <span aria-hidden="true">ϟ</span>
                <h2 id="quick-actions-heading">Quick actions</h2>
            </header>
            <div class="kf-quick-grid">
                <QuickAction Title="Create invoice"
                             Description="Create a new sales invoice"
                             Href="/invoices/create"
                             Icon="@Icons.Material.Outlined.NoteAdd" />
                <QuickAction Title="Search invoices"
                             Description="Find and view invoices"
                             Href="/invoices"
                             Icon="@Icons.Material.Outlined.Search" />
                <QuickAction Title="View products"
                             Description="Browse product catalog"
                             Href="/products"
                             Icon="@Icons.Material.Outlined.Inventory2" />
                <QuickAction Title="View prices"
                             Description="Check product prices"
                             Href="/prices"
                             Icon="@Icons.Material.Outlined.Sell" />
            </div>
        </section>
    </div>
}

@code {
    [CascadingParameter]
    private Task<AuthenticationState>? AuthTask { get; set; }

    private int todayInvoiceCount;
    private int todayPaymentCount;
    private int transferCount = 0;
    private decimal invoiceTotal;
    private decimal paymentTotal;
    private List<InvoiceDto>? recentInvoices;
    private List<IncomingPaymentDto>? recentPayments;
    private bool isLoadingInvoices = true;
    private bool isLoadingPayments = true;
    private bool isSalesRep;
    private string currentUsername = "Sales Rep";
    private bool _initialized;

    private static string FormatMoney(decimal value) => $"USD {value:N2}";

    protected override async Task OnParametersSetAsync()
    {
        if (AuthTask == null) return;

        var authState = await AuthTask;
        var user = authState.User;

        if (user.Identity?.IsAuthenticated != true) return;

        currentUsername = user.Identity?.Name ?? currentUsername;

        if (user.IsInRole("PodOperator"))
        {
            Navigation.NavigateTo("/pods", replace: true);
            return;
        }

        if (user.IsInRole("Lab") && !user.IsInRole("Admin"))
        {
            Navigation.NavigateTo("/lab/batch-status", replace: true);
            return;
        }

        if (user.IsInRole("MerchandiserPurchaseOrderViewer"))
        {
            Navigation.NavigateTo("/reports/merchandiser-purchase-orders", replace: true);
            return;
        }

        isSalesRep = user.IsInRole("SalesRep");

        if (!_initialized)
        {
            _initialized = true;

            if (!isSalesRep)
            {
                await LoadDashboardData();
            }

            await AuditService.LogAsync(AuditActions.ViewDashboard, isSalesRep ? "SalesRepDashboard" : "Dashboard", null);
        }
    }

    private async Task LoadDashboardData()
    {
        var invoiceTask = LoadInvoicesAsync();
        var paymentTask = LoadPaymentsAsync();
        await Task.WhenAll(invoiceTask, paymentTask);
    }

    private async Task LoadInvoicesAsync()
    {
        try
        {
            var invoiceResponse = await InvoiceService.GetInvoicesAsync(1, 10);
            if (invoiceResponse?.Invoices != null)
            {
                recentInvoices = invoiceResponse.Invoices;
                todayInvoiceCount = invoiceResponse.Count;
                invoiceTotal = recentInvoices.Sum(invoice => invoice.DocTotal);
            }
        }
        catch
        {
            // Preserve the existing graceful unavailable state.
        }
        finally
        {
            isLoadingInvoices = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task LoadPaymentsAsync()
    {
        try
        {
            var paymentResponse = await PaymentService.GetPaymentsAsync(1, 10);
            if (paymentResponse?.Payments != null)
            {
                recentPayments = paymentResponse.Payments;
                todayPaymentCount = paymentResponse.Count;
                paymentTotal = recentPayments.Sum(payment => payment.DocTotal);
            }
        }
        catch
        {
            // Preserve the existing graceful unavailable state.
        }
        finally
        {
            isLoadingPayments = false;
            await InvokeAsync(StateHasChanged);
        }
    }
}
