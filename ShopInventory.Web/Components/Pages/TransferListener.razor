@page "/transfer-listener"
@using Microsoft.AspNetCore.Authorization
@using ShopInventory.Web.Data
@using ShopInventory.Web.Models
@attribute [Authorize(Roles = "Admin,Manager")]
@rendermode InteractiveServer

<PageTitle>Transfer listener - Shop Inventory</PageTitle>

@* Styles live in wwwroot/css/transfer-listener.css (linked from App.razor), on
   the Nocturne tokens, built from the "Transfer Listener Redesign" design.

   The page follows one transfer over three hops — read from SAP, delivered to
   this API, applied to local stock — because they fail independently and only
   the first used to be shown. The third is the API's own ledger, never the
   listener's word; see the code-behind's remarks for the day that mattered.

   Status is always a coloured dot plus a word, never colour alone. *@

<div class="tel">

    <header class="tel-head">
        <div class="tel-head-inner">
            <nav class="tel-crumbs" aria-label="Breadcrumb">
                <span>System</span>
                <span class="tel-crumb-sep" aria-hidden="true">/</span>
                <span class="tel-crumb-now" aria-current="page">Transfer listener</span>
            </nav>
            <div class="tel-head-actions">
                @if (loadedAtUtc.HasValue)
                {
                    <span class="tel-asof">
                        @if (isRefreshing)
                        {
                            <span class="tel-spin" aria-hidden="true"></span>
                        }
                        as of @FormatClock(loadedAtUtc)
                    </span>
                }
                <button type="button" class="tel-btn" @onclick="RefreshAsync" disabled="@isRefreshing">
                    <i class="ph ph-arrows-clockwise" aria-hidden="true"></i>
                    <span>Refresh</span>
                </button>
                <button type="button" class="tel-btn tel-btn-primary" @onclick="CheckNowAsync"
                        disabled="@(isChecking || status is null || !status.Reachable)"
                        title="Make the listener read SAP and retry waiting lines now, instead of at its next cycle">
                    @if (isChecking)
                    {
                        <span class="tel-spin" aria-hidden="true"></span>
                    }
                    else
                    {
                        <i class="ph ph-magnifying-glass" aria-hidden="true"></i>
                    }
                    <span>Check SAP now</span>
                </button>
            </div>
        </div>
    </header>

    <div class="tel-body">

        <div class="tel-hero">
            <div class="tel-hero-text">
                <h1 class="tel-title">Transfer listener</h1>
                <p class="tel-lede">Carries SAP stock transfers into each warehouse's local stock snapshot, which the tills sell from.</p>
            </div>
            @if (status is not null)
            {
                <span class="tel-host">@status.BaseUrl</span>
            }
        </div>

        @if (checkOutcome is not null)
        {
            <div class="tel-alert @(checkOutcome.Success ? "tel-alert-good" : "tel-alert-bad")" role="status">
                <i class="ph @(checkOutcome.Success ? "ph-check-circle" : "ph-warning-circle")" aria-hidden="true"></i>
                <div class="tel-alert-body">
                    <div class="tel-alert-head">@checkOutcome.Headline</div>
                    @if (!string.IsNullOrWhiteSpace(checkOutcome.Detail))
                    {
                        <div>@checkOutcome.Detail</div>
                    }
                    @if (!string.IsNullOrWhiteSpace(checkOutcome.ListenerMessage))
                    {
                        <div class="tel-alert-note">Listener: @checkOutcome.ListenerMessage</div>
                    }
                </div>
                <button type="button" class="tel-alert-close" aria-label="Dismiss" @onclick="() => checkOutcome = null">
                    <i class="ph ph-x" aria-hidden="true"></i>
                </button>
            </div>
        }

        @if (isLoading)
        {
            <div class="tel-card">
                <div class="tel-skeleton" style="width: 40%; margin-bottom: 12px;"></div>
                <div class="tel-skeleton" style="width: 75%;"></div>
            </div>
        }
        else
        {
            <section class="tel-verdict tel-tone-@VerdictTone" aria-label="Verdict">
                <span class="tel-verdict-mark" aria-hidden="true">
                    <i class="ph @(VerdictTone == "good" ? "ph-check-circle" : VerdictTone == "warn" ? "ph-warning" : "ph-warning-circle")"></i>
                </span>
                <div class="tel-verdict-body">
                    <h2 class="tel-verdict-head">@VerdictHeadline</h2>
                    <p class="tel-verdict-detail">@VerdictDetail</p>

                    @if (IsDeliveryLate && Delivery is { } delivery
                         && (!string.IsNullOrWhiteSpace(delivery.LastError) || !string.IsNullOrWhiteSpace(delivery.WebhookUrl)))
                    {
                        <div class="tel-verdict-cause">
                            <span class="tel-cause-call">
                                @if (!string.IsNullOrWhiteSpace(delivery.LastError))
                                {
                                    <span class="tel-cause-code">@ErrorCode(delivery.LastError)</span>
                                }
                                @if (!string.IsNullOrWhiteSpace(delivery.WebhookUrl))
                                {
                                    <span class="tel-mono">POST @delivery.WebhookUrl</span>
                                }
                            </span>
                            <span class="tel-cause-hint">
                                @DeliveryErrorHint(delivery.LastError)
                                Waiting lines replay by themselves once it is corrected, until shortly before the next 07:00 stock fetch.
                            </span>
                        </div>
                    }
                </div>
            </section>

            @if (status is not null)
            {
                <section class="tel-pipeline" aria-label="From SAP to local stock">
                    @foreach (var stage in Stages)
                    {
                        <article class="tel-stage tel-tone-@stage.Tone">
                            <div class="tel-stage-top">
                                <div class="tel-stage-name">
                                    <span class="tel-stage-step" aria-hidden="true">@stage.Step</span>
                                    <h3>@stage.Title</h3>
                                </div>
                                <span class="tel-state">
                                    <span class="tel-dot" aria-hidden="true"></span>
                                    @stage.Status
                                </span>
                            </div>
                            <div class="tel-stage-figure">
                                <span class="tel-stage-value tel-num">@stage.Figure</span>
                                <span class="tel-stage-unit">@stage.Unit</span>
                            </div>
                            <p class="tel-stage-note">@stage.Note</p>
                            @if (stage.Chips.Count > 0)
                            {
                                <div class="tel-chips">
                                    @foreach (var chip in stage.Chips)
                                    {
                                        <span class="tel-chip tel-tone-@chip.Tone">@chip.Label</span>
                                    }
                                </div>
                            }
                            <div class="tel-stage-foot">
                                <span>@stage.Foot</span>
                                @if (stage.LinksToLocalStock)
                                {
                                    <a class="tel-link" href="/local-stock">Local stock <i class="ph ph-arrow-right" aria-hidden="true"></i></a>
                                }
                            </div>
                        </article>
                    }
                </section>
            }

            @if (status is { Reachable: true })
            {
                <div class="tel-columns">

                    <section class="tel-section" aria-label="Recent transfer documents">
                        <div class="tel-section-head">
                            <h2 class="tel-section-title">Recent transfer documents</h2>
                            <span class="tel-section-note">Local stock is read from this API's ledger, not the listener's word</span>
                        </div>

                        @if (status.RecentDocuments.Count == 0)
                        {
                            <div class="tel-card tel-empty">
                                No transfer document has been seen since the listener started
                                @(Poll is null ? string.Empty : $"on {FormatClock(Poll.ProcessStartedUtc)}").
                            </div>
                        }
                        else
                        {
                            <div class="tel-table-wrap">
                                <table class="tel-table">
                                    <thead>
                                        <tr>
                                            <th scope="col">Doc</th>
                                            <th scope="col">Detected</th>
                                            <th scope="col">Movement</th>
                                            <th scope="col" class="tel-th-num">Lines</th>
                                            <th scope="col">Local stock</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var document in status.RecentDocuments)
                                        {
                                            var state = DocumentState(document);
                                            <tr>
                                                <td class="tel-mono tel-cell-doc">@(document.SapDocNum?.ToString() ?? "—")</td>
                                                <td class="tel-cell-muted tel-nowrap tel-num">@FormatShort(document.DetectedAt)</td>
                                                <td>
                                                    <div class="tel-move">
                                                        <span class="tel-dir @(IsInbound(document) ? "tel-dir-in" : "tel-dir-out")">@(document.Direction ?? "—")</span>
                                                        <span class="tel-mono">@document.SourceWarehouse</span>
                                                        <span class="tel-arrow" aria-label="to">→</span>
                                                        <span class="tel-mono">@document.DestinationWarehouse</span>
                                                    </div>
                                                    @if (document.Lines.Count > 1)
                                                    {
                                                        <details class="tel-lines">
                                                            <summary>@FirstLineSummary(document)</summary>
                                                            <ul>
                                                                @foreach (var line in document.Lines)
                                                                {
                                                                    <li>
                                                                        <span class="tel-line-qty tel-num">@line.Quantity.ToString("#,0.##")</span>
                                                                        <span>@line.ItemCode — @line.ItemDescription</span>
                                                                    </li>
                                                                }
                                                            </ul>
                                                        </details>
                                                    }
                                                    else
                                                    {
                                                        <div class="tel-move-item">@FirstLineSummary(document)</div>
                                                    }
                                                </td>
                                                <td class="tel-cell-num tel-num">@document.LineCount</td>
                                                <td class="tel-nowrap">
                                                    <span class="tel-state tel-tone-@state.Tone">
                                                        <span class="tel-dot" aria-hidden="true"></span>
                                                        <span class="tel-state-word">@state.Label</span>
                                                    </span>
                                                    <span class="tel-state-note">@state.Note</span>
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                    </section>

                    <div class="tel-aside">

                        @if (Poll is { } poll)
                        {
                            <section class="tel-section" aria-label="SAP polling">
                                <h2 class="tel-section-title">SAP polling</h2>
                                <div class="tel-card tel-rows">
                                    <div class="tel-row">
                                        <span class="tel-row-label">Poll loop</span>
                                        <span class="tel-state tel-tone-@(poll.PollingStarted ? "good" : "bad")">
                                            <span class="tel-dot" aria-hidden="true"></span>
                                            @(poll.PollingStarted ? "Running" : "Not started")
                                        </span>
                                    </div>
                                    <div class="tel-row">
                                        <span class="tel-row-label">Last successful read</span>
                                        <span class="tel-row-value @(IsPollStale ? "tel-row-value-bad" : null)">
                                            @(poll.LastSuccessUtc.HasValue ? FormatClock(poll.LastSuccessUtc) : "Never")
                                        </span>
                                    </div>
                                    <div class="tel-row">
                                        <span class="tel-row-label">Reading from</span>
                                        <span class="tel-row-value" title="The window does not advance on a failed cycle, so a backlog is retried rather than lost">
                                            @FormatClock(poll.PollingSinceUtc)
                                        </span>
                                    </div>
                                    <div class="tel-row">
                                        <span class="tel-row-label">Interval</span>
                                        <span class="tel-row-value">every @poll.PollIntervalSeconds s</span>
                                    </div>
                                    <div class="tel-row">
                                        <span class="tel-row-label">Consecutive failures</span>
                                        <span class="tel-row-value @(poll.ConsecutiveFailures > 0 ? "tel-row-value-bad" : null)">@poll.ConsecutiveFailures</span>
                                    </div>
                                    <div class="tel-row">
                                        <span class="tel-row-label">Listener started</span>
                                        <span class="tel-row-value">@FormatClock(poll.ProcessStartedUtc)</span>
                                    </div>
                                    <div class="tel-row">
                                        <span class="tel-row-label">Documents processed</span>
                                        <span class="tel-row-value">
                                            @poll.ProcessedDocuments.ToString("N0")@(poll.ResumedFromSavedState ? " · resumed from disk" : string.Empty)
                                        </span>
                                    </div>
                                    @if (status.WebhookFailureCount > 0)
                                    {
                                        <div class="tel-row">
                                            <span class="tel-row-label">Batch-sync calls failed</span>
                                            <span class="tel-row-value tel-row-value-bad">@status.WebhookFailureCount</span>
                                        </div>
                                    }
                                    <p class="tel-rows-note">
                                        Counts live in the listener's memory and reset when it restarts. Its queue of
                                        waiting lines is saved to disk and survives.
                                    </p>
                                </div>
                            </section>
                        }

                        <section class="tel-section" aria-label="Warehouses">
                            <div class="tel-section-head">
                                <h2 class="tel-section-title">Warehouses</h2>
                                <span class="tel-section-note">seen since start / applied today</span>
                            </div>
                            <div class="tel-card tel-warehouses">
                                @if (status.UnwatchedWarehouses.Count > 0)
                                {
                                    <div class="tel-coverage tel-tone-warn">
                                        <span class="tel-dot" aria-hidden="true"></span>
                                        <span>
                                            Not watched by the listener:
                                            <span class="tel-mono">@string.Join(", ", status.UnwatchedWarehouses)</span>.
                                            Their snapshot is read at 07:00 and never adjusted again.
                                        </span>
                                    </div>
                                }
                                else if (status.WatchedWarehouses.Count > 0)
                                {
                                    <div class="tel-coverage tel-tone-good">
                                        <span class="tel-dot" aria-hidden="true"></span>
                                        <span>Every snapshotted warehouse is watched (@status.WatchedWarehouses.Count)</span>
                                    </div>
                                }
                                <ul class="tel-wh-grid">
                                    @foreach (var row in WarehouseRows)
                                    {
                                        <li class="tel-wh">
                                            <span class="tel-mono">@row.Code</span>
                                            <span class="tel-wh-counts tel-num">
                                                @row.Seen / <span class="@(row.Applied > 0 ? "tel-wh-applied" : null)">@row.Applied</span>
                                            </span>
                                        </li>
                                    }
                                </ul>
                            </div>
                        </section>

                    </div>
                </div>
            }
        }
    </div>
</div>
