@code {
    private LoginModel loginModel = new();
    private string? errorMessage;
    private bool isLoading = false;
    private bool isPasskeyLoading = false;
    private bool showPassword = false;

    // 2FA challenge state
    private bool requiresTwoFactor = false;
    private string? pendingTwoFactorToken;
    private string twoFactorCode = string.Empty;
    private bool isBackupCode = false;

    [SupplyParameterFromQuery]
    public string? ReturnUrl { get; set; }

    private class LoginModel
    {
        public string Username { get; set; } = string.Empty;
        public string Password { get; set; } = string.Empty;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            // Clear any stale auth data when user explicitly visits login page
            // This prevents redirect loops caused by cached but invalid tokens
            Logger.LogDebug("Login page first render - clearing any stale auth data");
            try
            {
                await AuthStateProvider.ClearAuthData();
                AuthStateProvider.NotifyUserLogout();
            }
            catch (Exception ex)
            {
                Logger.LogDebug("Error clearing auth data: {Message}", ex.Message);
            }
        }
    }

    private void TogglePassword()
    {
        showPassword = !showPassword;
    }

    private async Task NavigateAfterLogin()
    {
        await Task.Delay(100);

        var uri = new Uri(NavigationManager.Uri);
        var queryParams = System.Web.HttpUtility.ParseQueryString(uri.Query);
        var returnUrl = queryParams["returnUrl"];

        var targetUrl = !string.IsNullOrEmpty(returnUrl) ? Uri.UnescapeDataString(returnUrl) : "/dashboard";
        Logger.LogInformation("Navigating to: {Url}", targetUrl);
        NavigationManager.NavigateTo(targetUrl);
    }

    private async Task HandleLogin()
    {
        // LoginModel carries no DataAnnotations, so EditForm's OnValidSubmit
        // fires on an empty form too; the design states the check here.
        if (string.IsNullOrWhiteSpace(loginModel.Username) || string.IsNullOrEmpty(loginModel.Password))
        {
            errorMessage = "Enter your username and password to continue.";
            return;
        }

        Logger.LogInformation("HandleLogin started for user: {Username}", loginModel.Username);
        isLoading = true;
        errorMessage = null;

        try
        {
            Logger.LogDebug("Calling AuthService.LoginAsync");
            var (success, message, response) = await AuthService.LoginAsync(loginModel.Username, loginModel.Password);
            Logger.LogInformation("LoginAsync returned: Success={Success}, Message={Message}", success, message);

            if (success && response != null)
            {
                if (response.RequiresTwoFactor)
                {
                    // Password accepted — prompt for the TOTP code
                    pendingTwoFactorToken = response.TwoFactorToken;
                    requiresTwoFactor = true;
                    return;
                }

                Logger.LogInformation("Login successful, notifying auth state provider");
                AuthStateProvider.NotifyUserAuthentication(
                response.User?.Username ?? loginModel.Username,
                response.User?.Role ?? "User");

                await AuditService.LogAsync(AuditActions.Login, response.User?.Username ?? loginModel.Username, response.User?.Role ??
"User", "Auth", null, null, "/login");
                await NavigateAfterLogin();
            }
            else
            {
                Logger.LogWarning("Login failed: {Message}", message);
                errorMessage = message;
                await AuditService.LogAsync(AuditActions.LoginFailed, loginModel.Username, "Unknown", "Auth", null, message, "/login",
false, message);
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Exception during HandleLogin");
            errorMessage = "Sign-in could not be completed right now. Please try again.";
        }
        finally
        {
            isLoading = false;
            Logger.LogDebug("HandleLogin completed, isLoading set to false");
        }
    }

    private async Task HandlePasskeyLogin()
    {
        Logger.LogInformation("HandlePasskeyLogin started");
        isPasskeyLoading = true;
        errorMessage = null;

        try
        {
            var supported = await JSRuntime.InvokeAsync<bool>("passkeys.isSupported");
            if (!supported)
            {
                errorMessage = "Passkeys are only available in supported browsers over HTTPS or localhost.";
                return;
            }

            var context = await JSRuntime.InvokeAsync<PasskeyBrowserContext>("passkeys.getContext");
            var (beginSuccess, beginMessage, ceremony) = await AuthService.BeginPasskeyLoginAsync(context.Origin, context.RpId);

            if (!beginSuccess || ceremony is null)
            {
                errorMessage = beginMessage;
                await AuditService.LogAsync(AuditActions.LoginFailed,
                    string.IsNullOrWhiteSpace(loginModel.Username) ? "Unknown" : loginModel.Username,
                    "Unknown", "Auth", null, beginMessage, "/login", false, beginMessage);
                return;
            }

            var credentialJson = await JSRuntime.InvokeAsync<string>("passkeys.authenticate", ceremony.Value.OptionsJson);
            var (success, message, response) = await AuthService.CompletePasskeyLoginAsync(
                ceremony.Value.SessionToken,
                credentialJson,
                context.Origin,
                context.RpId);

            if (success && response != null)
            {
                AuthStateProvider.NotifyUserAuthentication(
                    response.User?.Username ?? loginModel.Username,
                    response.User?.Role ?? "User");

                await AuditService.LogAsync(AuditActions.Login,
                    response.User?.Username ?? "PasskeyUser",
                    response.User?.Role ?? "User",
                    "Auth",
                    null,
                    "Passkey login completed",
                    "/login");

                await NavigateAfterLogin();
            }
            else
            {
                errorMessage = message;
                await AuditService.LogAsync(AuditActions.LoginFailed,
                    string.IsNullOrWhiteSpace(loginModel.Username) ? "Unknown" : loginModel.Username,
                    "Unknown", "Auth", null, message, "/login", false, message);
            }
        }
        catch (JSException ex)
        {
            Logger.LogWarning(ex, "Passkey browser interaction failed");
            errorMessage = GetSafePasskeyErrorMessage(ex.Message);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Exception during HandlePasskeyLogin");
            errorMessage = "Passkey sign-in could not be completed. Try again or use your password.";
        }
        finally
        {
            isPasskeyLoading = false;
        }
    }

    private async Task HandleTwoFactorSubmit()
    {
        if (string.IsNullOrWhiteSpace(twoFactorCode) || string.IsNullOrEmpty(pendingTwoFactorToken))
            return;

        isLoading = true;
        errorMessage = null;

        try
        {
            var (success, message, response) = await AuthService.CompleteTwoFactorAsync(
                pendingTwoFactorToken, twoFactorCode.Trim(), isBackupCode);

            if (success && response != null)
            {
                AuthStateProvider.NotifyUserAuthentication(
                    response.User?.Username ?? loginModel.Username,
                    response.User?.Role ?? "User");

                await AuditService.LogAsync(AuditActions.Login, response.User?.Username ?? loginModel.Username,
                    response.User?.Role ?? "User", "Auth", null, "2FA login completed", "/login");
                await NavigateAfterLogin();
            }
            else
            {
                errorMessage = message;
                twoFactorCode = string.Empty;
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Exception during 2FA challenge submission");
            errorMessage = "Two-factor verification could not be completed right now. Please try again.";
        }
        finally
        {
            isLoading = false;
        }
    }

    private void CancelTwoFactor()
    {
        requiresTwoFactor = false;
        pendingTwoFactorToken = null;
        twoFactorCode = string.Empty;
        isBackupCode = false;
        errorMessage = null;
    }

    private static string GetSafePasskeyErrorMessage(string? message)
    {
        const string defaultMessage = "Passkey sign-in could not be completed. Try again or use your password.";

        if (string.IsNullOrWhiteSpace(message))
            return defaultMessage;

        var normalizedMessage = message.ToLowerInvariant();

        if (ContainsAny(normalizedMessage, "cancelled or timed out", "canceled or timed out", "notallowederror", "timed out", "not allowed"))
            return "Passkey sign-in was cancelled or timed out. Try again when you are ready.";

        if (ContainsAny(normalizedMessage, "passkeys are only available", "passkeys require a supported browser", "securityerror", "secure context", "https"))
            return "Passkeys are only available in supported browsers over HTTPS or localhost.";

        if (ContainsAny(normalizedMessage, "browser or device does not support", "notsupportederror", "not supported"))
            return "This browser or device does not support passkeys for this action.";

        if (ContainsAny(normalizedMessage, "interrupted", "aborterror"))
            return "Passkey sign-in was interrupted. Try again.";

        return defaultMessage;
    }

    private static bool ContainsAny(string value, params string[] terms)
    {
        return terms.Any(value.Contains);
    }
}
