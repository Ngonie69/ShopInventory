@page "/login"
@using Microsoft.AspNetCore.Authorization
@using ShopInventory.Web.Data
@using ShopInventory.Web.Models
@using ShopInventory.Web.Services
@inject IAuthService AuthService
@inject NavigationManager NavigationManager
@inject CustomAuthStateProvider AuthStateProvider
@inject IJSRuntime JSRuntime
@inject ILogger<Login> Logger
@inject IAuditService AuditService
@attribute [AllowAnonymous]
@rendermode InteractiveServer
@layout EmptyLayout

<PageTitle>Login - Shop Inventory</PageTitle>

@* `sgn` is staff-signin.css's scope. This page runs on EmptyLayout, so it
   carries its own ground; the customer portal's sign-in is the same
   composition in the portal's teal. *@
<div class="sgn">

    <section class="sgn-hero">
        <div class="sgn-brand">
            <img src="images/kefalos-logo.jpg" alt="Kefalos Quality Dairy Produce" class="sgn-mark"
                 onerror="this.style.display='none'" />
            <div class="sgn-brand-rule"></div>
            <div class="sgn-brand-text">
                <span class="sgn-brand-name">Staff Portal</span>
            </div>
        </div>

        <div class="sgn-pitch">
            <div class="sgn-eyebrow">Staff workspace</div>
            <h1>Depot and sales, running on one SAP.</h1>
            <p>
                Track stock, approve orders, and run reports in one place &mdash; on the
                same SAP the office is already working from.
            </p>
            <ul class="sgn-points">
                <li>Stock levels updated as they move</li>
                <li>Every order approval in one queue</li>
                <li>Reports that export clean</li>
            </ul>
        </div>

        <div class="sgn-hero-foot">
            <span>Customer access?</span>
            <a href="/customer-portal/login">
                Customer portal
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                     stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M5 12h13" />
                    <path d="M12 6l6 6-6 6" />
                </svg>
            </a>
        </div>
    </section>

    <section class="sgn-panel">
        <div class="sgn-form">
            <span class="sgn-tag">Staff login</span>
            <h1>@(requiresTwoFactor ? "Two-step verification" : "Sign in")</h1>
            <p class="sgn-sub">
                @(requiresTwoFactor
                    ? (isBackupCode
                        ? "Enter one of your saved backup codes."
                        : "Enter the 6-digit code from your authenticator app.")
                    : "Use your staff credentials to continue.")
            </p>

            @if (!string.IsNullOrEmpty(errorMessage))
            {
                <div class="sgn-note" role="alert">
                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"
                         stroke-linecap="round" aria-hidden="true">
                        <circle cx="12" cy="12" r="9" />
                        <path d="M12 7.5v5.5" />
                        <path d="M12 16.4v.1" />
                    </svg>
                    <span>@errorMessage</span>
                </div>
            }

            @if (!requiresTwoFactor)
            {
                <EditForm Model="loginModel" OnValidSubmit="HandleLogin" FormName="LoginForm">
                    <DataAnnotationsValidator />

                    <div class="sgn-field">
                        <label for="username">Username or email</label>
                        <div class="sgn-control">
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                 stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                <circle cx="12" cy="8" r="3.6" />
                                <path d="M4.5 20c1.3-3.4 4.1-5.2 7.5-5.2s6.2 1.8 7.5 5.2" />
                            </svg>
                            <InputText id="username" class="sgn-input" @bind-Value="loginModel.Username"
                                       autocomplete="username" placeholder="Enter your username or email" />
                        </div>
                        <ValidationMessage For="@(() => loginModel.Username)" class="validation-msg" />
                    </div>

                    <div class="sgn-field">
                        <label for="password">Password</label>
                        <div class="sgn-control">
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                 stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                <rect x="4.5" y="10" width="15" height="10" rx="2.5" />
                                <path d="M8.2 10V7.4a3.8 3.8 0 0 1 7.6 0V10" />
                            </svg>
                            <input id="password" type="@(showPassword ? "text" : "password")"
                                   class="sgn-input has-reveal" @bind="loginModel.Password"
                                   placeholder="••••••••" autocomplete="current-password" />
                            <button type="button" class="sgn-reveal" @onclick="TogglePassword"
                                    aria-label="@(showPassword ? "Hide password" : "Show password")">
                                @if (showPassword)
                                {
                                    <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                         stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"
                                         aria-hidden="true">
                                        <path d="M2.5 12S6 6.2 12 6.2 21.5 12 21.5 12 18 17.8 12 17.8 2.5 12 2.5 12z" />
                                        <circle cx="12" cy="12" r="2.8" />
                                        <path d="M4 20L20 4" />
                                    </svg>
                                }
                                else
                                {
                                    <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                         stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"
                                         aria-hidden="true">
                                        <path d="M2.5 12S6 6.2 12 6.2 21.5 12 21.5 12 18 17.8 12 17.8 2.5 12 2.5 12z" />
                                        <circle cx="12" cy="12" r="2.8" />
                                    </svg>
                                }
                            </button>
                        </div>
                        <ValidationMessage For="@(() => loginModel.Password)" class="validation-msg" />
                    </div>

                    <button type="submit" class="sgn-submit" disabled="@(isLoading || isPasskeyLoading)">
                        @if (isLoading)
                        {
                            <span class="sgn-spinner"></span>
                            <span>Signing in&hellip;</span>
                        }
                        else
                        {
                            <span>Sign in</span>
                            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                 stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                <path d="M5 12h12" />
                                <path d="M11.5 6.5L18 12l-6.5 5.5" />
                            </svg>
                        }
                    </button>
                </EditForm>

                <div class="sgn-or">or</div>

                <button type="button" class="sgn-secondary" @onclick="HandlePasskeyLogin"
                        disabled="@(isLoading || isPasskeyLoading)">
                    @if (isPasskeyLoading)
                    {
                        <span class="sgn-spinner"></span>
                        <span>Checking passkey&hellip;</span>
                    }
                    else
                    {
                        <i class="bi bi-fingerprint" aria-hidden="true"></i>
                        <span>Use a passkey</span>
                    }
                </button>

                <p class="sgn-passkey-note">
                    Windows Hello, Face ID, Touch ID, or your device PIN on a supported browser.
                </p>
            }
            else
            {
                <div class="sgn-2fa-badge">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"
                         stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <rect x="4.5" y="10" width="15" height="10" rx="2.5" />
                        <path d="M8.2 10V7.4a3.8 3.8 0 0 1 7.6 0V10" />
                    </svg>
                </div>

                <div class="sgn-field">
                    <label for="twofactor-code">@(isBackupCode ? "Backup code" : "Authenticator code")</label>
                    <div class="sgn-control">
                        <input id="twofactor-code" type="text"
                               class="@(isBackupCode ? "sgn-input sgn-code is-backup" : "sgn-input sgn-code")"
                               @bind="twoFactorCode" @bind:event="oninput"
                               placeholder="@(isBackupCode ? "XXXX-XXXX" : "000000")"
                               maxlength="@(isBackupCode ? 9 : 6)"
                               inputmode="@(isBackupCode ? "text" : "numeric")"
                               autocomplete="one-time-code" />
                    </div>
                </div>

                <label class="sgn-check">
                    <input type="checkbox" @bind="isBackupCode" />
                    <span class="dot"></span>
                    Use a backup code instead
                </label>

                <button type="button" class="sgn-submit" @onclick="HandleTwoFactorSubmit"
                        disabled="@(isLoading || string.IsNullOrWhiteSpace(twoFactorCode))">
                    @if (isLoading)
                    {
                        <span class="sgn-spinner"></span>
                        <span>Verifying&hellip;</span>
                    }
                    else
                    {
                        <span>Verify</span>
                        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                             stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <path d="M5 12h12" />
                            <path d="M11.5 6.5L18 12l-6.5 5.5" />
                        </svg>
                    }
                </button>

                <button type="button" class="sgn-back" @onclick="CancelTwoFactor">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9"
                         stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <path d="M19 12H7" />
                        <path d="M12.5 6.5L6 12l6.5 5.5" />
                    </svg>
                    Back to sign in
                </button>
            }
        </div>

        <div class="sgn-copyright">&copy; 2026 Kefalos Cheese</div>
    </section>
</div>

@code {
    private LoginModel loginModel = new();
    private string? errorMessage;
    private bool isLoading = false;
    private bool isPasskeyLoading = false;
    private bool showPassword = false;

    // 2FA challenge state
    private bool requiresTwoFactor = false;
    private string? pendingTwoFactorToken;
    private string twoFactorCode = string.Empty;
    private bool isBackupCode = false;

    [SupplyParameterFromQuery]
    public string? ReturnUrl { get; set; }

    private class LoginModel
    {
        public string Username { get; set; } = string.Empty;
        public string Password { get; set; } = string.Empty;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            // Clear any stale auth data when user explicitly visits login page
            // This prevents redirect loops caused by cached but invalid tokens
            Logger.LogDebug("Login page first render - clearing any stale auth data");
            try
            {
                await AuthStateProvider.ClearAuthData();
                AuthStateProvider.NotifyUserLogout();
            }
            catch (Exception ex)
            {
                Logger.LogDebug("Error clearing auth data: {Message}", ex.Message);
            }
        }
    }

    private void TogglePassword()
    {
        showPassword = !showPassword;
    }

    private async Task NavigateAfterLogin()
    {
        await Task.Delay(100);

        var uri = new Uri(NavigationManager.Uri);
        var queryParams = System.Web.HttpUtility.ParseQueryString(uri.Query);
        var returnUrl = queryParams["returnUrl"];

        var targetUrl = !string.IsNullOrEmpty(returnUrl) ? Uri.UnescapeDataString(returnUrl) : "/dashboard";
        Logger.LogInformation("Navigating to: {Url}", targetUrl);
        NavigationManager.NavigateTo(targetUrl);
    }

    private async Task HandleLogin()
    {
        Logger.LogInformation("HandleLogin started for user: {Username}", loginModel.Username);
        isLoading = true;
        errorMessage = null;

        try
        {
            Logger.LogDebug("Calling AuthService.LoginAsync");
            var (success, message, response) = await AuthService.LoginAsync(loginModel.Username, loginModel.Password);
            Logger.LogInformation("LoginAsync returned: Success={Success}, Message={Message}", success, message);

            if (success && response != null)
            {
                if (response.RequiresTwoFactor)
                {
                    // Password accepted — prompt for the TOTP code
                    pendingTwoFactorToken = response.TwoFactorToken;
                    requiresTwoFactor = true;
                    return;
                }

                Logger.LogInformation("Login successful, notifying auth state provider");
                AuthStateProvider.NotifyUserAuthentication(
                response.User?.Username ?? loginModel.Username,
                response.User?.Role ?? "User");

                await AuditService.LogAsync(AuditActions.Login, response.User?.Username ?? loginModel.Username, response.User?.Role ??
"User", "Auth", null, null, "/login");
                await NavigateAfterLogin();
            }
            else
            {
                Logger.LogWarning("Login failed: {Message}", message);
                errorMessage = message;
                await AuditService.LogAsync(AuditActions.LoginFailed, loginModel.Username, "Unknown", "Auth", null, message, "/login",
false, message);
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Exception during HandleLogin");
            errorMessage = "Sign-in could not be completed right now. Please try again.";
        }
        finally
        {
            isLoading = false;
            Logger.LogDebug("HandleLogin completed, isLoading set to false");
        }
    }

    private async Task HandlePasskeyLogin()
    {
        Logger.LogInformation("HandlePasskeyLogin started");
        isPasskeyLoading = true;
        errorMessage = null;

        try
        {
            var supported = await JSRuntime.InvokeAsync<bool>("passkeys.isSupported");
            if (!supported)
            {
                errorMessage = "Passkeys are only available in supported browsers over HTTPS or localhost.";
                return;
            }

            var context = await JSRuntime.InvokeAsync<PasskeyBrowserContext>("passkeys.getContext");
            var (beginSuccess, beginMessage, ceremony) = await AuthService.BeginPasskeyLoginAsync(context.Origin, context.RpId);

            if (!beginSuccess || ceremony is null)
            {
                errorMessage = beginMessage;
                await AuditService.LogAsync(AuditActions.LoginFailed,
                    string.IsNullOrWhiteSpace(loginModel.Username) ? "Unknown" : loginModel.Username,
                    "Unknown", "Auth", null, beginMessage, "/login", false, beginMessage);
                return;
            }

            var credentialJson = await JSRuntime.InvokeAsync<string>("passkeys.authenticate", ceremony.Value.OptionsJson);
            var (success, message, response) = await AuthService.CompletePasskeyLoginAsync(
                ceremony.Value.SessionToken,
                credentialJson,
                context.Origin,
                context.RpId);

            if (success && response != null)
            {
                AuthStateProvider.NotifyUserAuthentication(
                    response.User?.Username ?? loginModel.Username,
                    response.User?.Role ?? "User");

                await AuditService.LogAsync(AuditActions.Login,
                    response.User?.Username ?? "PasskeyUser",
                    response.User?.Role ?? "User",
                    "Auth",
                    null,
                    "Passkey login completed",
                    "/login");

                await NavigateAfterLogin();
            }
            else
            {
                errorMessage = message;
                await AuditService.LogAsync(AuditActions.LoginFailed,
                    string.IsNullOrWhiteSpace(loginModel.Username) ? "Unknown" : loginModel.Username,
                    "Unknown", "Auth", null, message, "/login", false, message);
            }
        }
        catch (JSException ex)
        {
            Logger.LogWarning(ex, "Passkey browser interaction failed");
            errorMessage = GetSafePasskeyErrorMessage(ex.Message);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Exception during HandlePasskeyLogin");
            errorMessage = "Passkey sign-in could not be completed. Try again or use your password.";
        }
        finally
        {
            isPasskeyLoading = false;
        }
    }

    private async Task HandleTwoFactorSubmit()
    {
        if (string.IsNullOrWhiteSpace(twoFactorCode) || string.IsNullOrEmpty(pendingTwoFactorToken))
            return;

        isLoading = true;
        errorMessage = null;

        try
        {
            var (success, message, response) = await AuthService.CompleteTwoFactorAsync(
                pendingTwoFactorToken, twoFactorCode.Trim(), isBackupCode);

            if (success && response != null)
            {
                AuthStateProvider.NotifyUserAuthentication(
                    response.User?.Username ?? loginModel.Username,
                    response.User?.Role ?? "User");

                await AuditService.LogAsync(AuditActions.Login, response.User?.Username ?? loginModel.Username,
                    response.User?.Role ?? "User", "Auth", null, "2FA login completed", "/login");
                await NavigateAfterLogin();
            }
            else
            {
                errorMessage = message;
                twoFactorCode = string.Empty;
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Exception during 2FA challenge submission");
            errorMessage = "Two-factor verification could not be completed right now. Please try again.";
        }
        finally
        {
            isLoading = false;
        }
    }

    private void CancelTwoFactor()
    {
        requiresTwoFactor = false;
        pendingTwoFactorToken = null;
        twoFactorCode = string.Empty;
        isBackupCode = false;
        errorMessage = null;
    }

    private static string GetSafePasskeyErrorMessage(string? message)
    {
        const string defaultMessage = "Passkey sign-in could not be completed. Try again or use your password.";

        if (string.IsNullOrWhiteSpace(message))
            return defaultMessage;

        var normalizedMessage = message.ToLowerInvariant();

        if (ContainsAny(normalizedMessage, "cancelled or timed out", "canceled or timed out", "notallowederror", "timed out", "not allowed"))
            return "Passkey sign-in was cancelled or timed out. Try again when you are ready.";

        if (ContainsAny(normalizedMessage, "passkeys are only available", "passkeys require a supported browser", "securityerror", "secure context", "https"))
            return "Passkeys are only available in supported browsers over HTTPS or localhost.";

        if (ContainsAny(normalizedMessage, "browser or device does not support", "notsupportederror", "not supported"))
            return "This browser or device does not support passkeys for this action.";

        if (ContainsAny(normalizedMessage, "interrupted", "aborterror"))
            return "Passkey sign-in was interrupted. Try again.";

        return defaultMessage;
    }

    private static bool ContainsAny(string value, params string[] terms)
    {
        return terms.Any(value.Contains);
    }
}
