@page "/reports/desktop-sales"
@using Microsoft.AspNetCore.Authorization
@using ShopInventory.Web.Features.Reports.Queries.GetDesktopSalesAnalysis
@attribute [Authorize(Roles = "Admin,Manager,Cashier")]
@rendermode InteractiveServer

<PageTitle>@(Vans ? "Van Sales Breakdown" : "Desktop Sales Analysis") - Shop Inventory</PageTitle>

@* The till takings, broken down. An import of `Sales Breakdown.dc.html` from the "Nocturne Dark Ops
   Redesign" design project, built on the /desktop-sales vocabulary: the root keeps `ops-ds` for the
   segments, cards and break bars and `ops-dsa` for the payment-method colours and swatches, and
   `ops-sbd` in sales-breakdown.css adds what the design brought — the pinned head with its filter chips,
   the headline figure against the period before, the trading-pattern columns and the hour strip.

   Three answers feed it (see Shown in the code-behind): the whole period for the trading pattern, the
   period or picked day confined to the picked payment method for every other figure, and the same day
   across every method for "How it was paid", so the methods not picked stay there to pick instead.

   Colour is carried by payment method and nothing else, in a fixed order (Cash, Swipe, EcoCash,
   Innbucks, then anything historical), so a method keeps its colour whichever methods a period happens
   to contain. The design's four violet steps are not used: they collapse in the light theme, where
   Nocturne's accent ramp has nowhere to spread. The validated categorical hues from the page this
   replaced stand in. "Not recorded" is grey on purpose: it is not a way of paying. Every coloured mark
   sits beside its name or in a row that states the figure. *@

<div class="ops ops-ds ops-dsa ops-sbd">

    <div class="ops-sbd-head">
        <div class="ops-sbd-head-row">
            <div class="ops-sbd-title">
                <span class="ops-kicker">@(Vans ? "Van sales" : "Desktop sales") · Analysis</span>
                <h1>Sales breakdown</h1>
            </div>

            <div class="ops-sbd-controls">
                <div class="ops-field ops-sbd-shop">
                    <label class="ops-label" for="dsa-warehouse">@(Vans ? "Van" : "Shop")</label>
                    <NocturneSelect Id="dsa-warehouse" Class="nsel-block" Options="WarehouseOptions"
                                    @bind-Value="warehouse" OnChanged="ReloadScopeAsync"
                                    Caption="@($"Filter by {Place}")" AriaLabel="@($"Filter by {Place}")"
                                    Placeholder="@($"All {Place}s")" />
                </div>

                @* Not a <label>: the segment is several buttons, and a label would hand every click to
                   the first of them. *@
                <div class="ops-field">
                    <span class="ops-label" id="dsa-period-label">Period</span>
                    <div class="ops-ds-seg" role="group" aria-labelledby="dsa-period-label">
                        @foreach (var option in PeriodOptions)
                        {
                            <button type="button" class="ops-ds-seg-opt @(period == option.Key ? "is-on" : "")"
                                    aria-pressed="@(period == option.Key)"
                                    @onclick="() => SetPeriodAsync(option.Key)">@option.Label</button>
                        }
                    </div>
                </div>

                @if (period == PeriodCustom)
                {
                    <div class="ops-sbd-dates">
                        <div class="ops-field">
                            <span class="ops-label">From</span>
                            <NocturneDateField Id="dsa-from" Date="fromDate" DateChanged="OnFromDateChanged"
                                               AriaLabel="From date" />
                        </div>
                        <div class="ops-field">
                            <span class="ops-label">To</span>
                            <NocturneDateField Id="dsa-to" Date="toDate" DateChanged="OnToDateChanged"
                                               AriaLabel="To date" />
                        </div>
                    </div>
                }

                @* Only when the period actually traded in more than one: currencies are never added
                   together, so each is its own analysis. *@
                @if (shown is { Context.Currencies.Count: > 1 })
                {
                    <div class="ops-field">
                        <span class="ops-label" id="dsa-currency-label">Currency</span>
                        <div class="ops-ds-seg" role="group" aria-labelledby="dsa-currency-label">
                            @foreach (var option in shown.Context.Currencies)
                            {
                                <button type="button" class="ops-ds-seg-opt @(Currency == option.Currency ? "is-on" : "")"
                                        aria-pressed="@(Currency == option.Currency)"
                                        @onclick="() => currency = option.Currency">@option.Currency</button>
                            }
                        </div>
                    </div>
                }

                <span class="ops-sbd-vrule" aria-hidden="true"></span>

                <div class="ops-sbd-actions">
                    @if (Vans)
                    {
                        @* The review and the sale list read the counters' sales only; the vans' own pages
                           stand in for them. *@
                        <a class="ops-btn ops-btn-ghost" href="/van-sales/reports/performance">
                            <i class="ph ph-chart-line-up" aria-hidden="true"></i>
                            <span>Performance</span>
                        </a>
                        <a class="ops-btn ops-btn-ghost" href="/van-sales/invoices">
                            <i class="ph ph-list-bullets" aria-hidden="true"></i>
                            <span>Invoices</span>
                        </a>
                    }
                    else
                    {
                        <a class="ops-btn ops-btn-ghost" href="/reports/desktop-sales/review">
                            <i class="ph ph-lightbulb" aria-hidden="true"></i>
                            <span>Review</span>
                        </a>
                        @* Only for the roles that may open the list; a manager shown this link would land on
                           a refusal. *@
                        <AuthorizeView Roles="Admin,Cashier" Context="saleListCtx">
                            <Authorized>
                                <a class="ops-btn ops-btn-ghost" href="/desktop-sales">
                                    <i class="ph ph-list-bullets" aria-hidden="true"></i>
                                    <span>Sale list</span>
                                </a>
                            </Authorized>
                        </AuthorizeView>
                    }
                    <button type="button" class="ops-btn ops-btn-primary" @onclick="ExportAsync"
                            disabled="@(isExporting || shown is null)">
                        @if (isExporting)
                        {
                            <span class="ops-spin"></span>
                            <span>Exporting&hellip;</span>
                        }
                        else
                        {
                            <i class="ph ph-file-xls" aria-hidden="true"></i>
                            <span>Export</span>
                        }
                    </button>
                    <button type="button" class="ops-icon-btn" title="Refresh" aria-label="Refresh"
                            @onclick="RefreshAsync" disabled="@isLoading">
                        @if (isLoading)
                        {
                            <span class="ops-spin"></span>
                        }
                        else
                        {
                            <i class="ph ph-arrows-clockwise" aria-hidden="true"></i>
                        }
                    </button>
                </div>
            </div>
        </div>
        <div class="ops-rule-fade"></div>
    </div>

    @if (error != null)
    {
        <div class="ops-msg ops-fam-bad" role="alert">
            <i class="ph ph-warning-octagon" aria-hidden="true"></i>
            <div class="ops-msg-body">@error</div>
            <button type="button" class="ops-msg-x" aria-label="Dismiss" @onclick="() => error = null">
                <i class="ph ph-x" aria-hidden="true"></i>
            </button>
        </div>
    }

    @if (shown is null)
    {
        @if (isLoading)
        {
            <div class="ops-loading">
                <span class="ops-spin ops-spin-lg"></span>
                <p>Working out the takings&hellip;</p>
            </div>
        }
    }
    else
    {
        var view = shown;

        @* ── What the page is showing ─────────────────────────────────────── *@
        <div class="ops-sbd-scope">
            <i class="ph ph-funnel" aria-hidden="true"></i>
            <span>@RangeText(view.Context)</span>
            @if (warehouse != "")
            {
                <button type="button" class="ops-sbd-chip" @onclick="ClearShopAsync"
                        aria-label="@($"Show every {Place}, not only {ShopChip}")">
                    @ShopChip<i class="ph ph-x" aria-hidden="true"></i>
                </button>
            }
            @if (method != null)
            {
                <button type="button" class="ops-sbd-chip" @onclick="() => SetMethodAsync(null)"
                        aria-label="Show every payment method">
                    @TenderLabel(method) only<i class="ph ph-x" aria-hidden="true"></i>
                </button>
            }
            @if (day is { } pickedDay)
            {
                <button type="button" class="ops-sbd-chip" @onclick="() => SetDayAsync(null)"
                        aria-label="Show the whole period">
                    @DayLabel(pickedDay)<i class="ph ph-x" aria-hidden="true"></i>
                </button>
            }
            @if (HasChips)
            {
                <button type="button" class="ops-sbd-clear" @onclick="ClearAllAsync">Clear all</button>
            }
            @if (isLoading)
            {
                <span class="ops-spin" role="status" aria-label="Updating"></span>
            }
        </div>

        @if (view.Context.Currencies.Count == 0)
        {
            <div class="ops-empty">
                <i class="ph ph-receipt" aria-hidden="true"></i>
                <h3>No sales in this period</h3>
                <p>Nothing was @(Vans ? "sold off a van" : "rung up at a till or vending counter") @(warehouse == "" ? "" : $"{(Vans ? "by" : "at")} {ShopChip} ")between these dates. Widen the period to see more.</p>
            </div>
        }
        else
        {
            var sales = Section(view.Focus);
            var payments = Section(view.Payments);
            var columns = DayColumns(view.Context);
            var alerts = Alerts(view, columns);
            var change = ChangePercent(sales);

            <div class="ops-sbd-body @(isLoading ? "is-busy" : "")">

                @* ── The headline ─────────────────────────────────────────────────── *@
                <section class="ops-sbd-headline" aria-label="Headline figures">
                    <div class="ops-sbd-kpi">
                        <div class="ops-sbd-kpi-head"><span class="ops-sbd-kpi-rule is-accent"></span>Takings</div>
                        <div class="ops-sbd-kpi-num">@Money(sales.TotalAmount)</div>
                        <div class="ops-sbd-kpi-change">
                            @if (change is { } percent)
                            {
                                <span class="ops-sbd-delta @(percent >= 0 ? "is-up" : "is-down")">
                                    <i class="ph @(percent >= 0 ? "ph-trend-up" : "ph-trend-down")" aria-hidden="true"></i>
                                    @((percent >= 0 ? "+" : "") + percent.ToString("0.0", System.Globalization.CultureInfo.InvariantCulture))%
                                </span>
                                <span>vs previous @PreviousBasis(view.Focus) (@Money(sales.PreviousTotalAmount))</span>
                            }
                            else if (sales.TotalAmount > 0)
                            {
                                <span>Nothing taken in the previous @PreviousBasis(view.Focus)</span>
                            }
                        </div>
                        <div class="ops-sbd-kpi-sub">
                            @Plural(sales.SalesCount, "sale") over @Plural(sales.DaysTraded, "trading day") · @sales.QuantitySold.ToString("#,##0.##") units
                        </div>
                    </div>

                    <div class="ops-sbd-figures">
                        <div class="ops-sbd-kpi">
                            <div class="ops-sbd-kpi-head"><span class="ops-sbd-kpi-rule"></span>Before VAT</div>
                            <div class="ops-sbd-fig-num">@Money(sales.NetAmount)</div>
                            <div class="ops-sbd-fig-sub">VAT @Money(sales.VatAmount)@(Vans ? " · offline receipts only" : "")</div>
                        </div>
                        <div class="ops-sbd-kpi">
                            <div class="ops-sbd-kpi-head"><span class="ops-sbd-kpi-rule"></span>Average sale</div>
                            <div class="ops-sbd-fig-num">@Money(sales.AverageSale)</div>
                            <div class="ops-sbd-fig-sub">@sales.QuantitySold.ToString("#,##0.##") units · @Plural(sales.DistinctItems, "item")</div>
                        </div>
                    </div>
                </section>

                @* ── Things to check ──────────────────────────────────────────────── *@
                @if (alerts.Count > 0)
                {
                    <section class="ops-sbd-alerts" aria-label="Things to check">
                        @foreach (var alert in alerts)
                        {
                            <button type="button" class="ops-sbd-alert" @onclick="alert.Act">
                                <i class="ph @alert.Icon" aria-hidden="true"></i>
                                <span>@alert.Text</span>
                                <span class="ops-sbd-alert-cta">@alert.Action &rarr;</span>
                            </button>
                        }
                    </section>
                }

                @* ── Trading pattern ──────────────────────────────────────────────── *@
                <section class="ops-ds-card ops-sbd-pattern" aria-labelledby="dsa-pattern-title">
                    <div class="ops-ds-card-head">
                        <i class="ph ph-chart-bar" aria-hidden="true"></i>
                        <span class="ops-ds-card-label" id="dsa-pattern-title">Trading pattern</span>
                        <span class="ops-sbd-hint">click a day to filter the page</span>
                        <div class="ops-sbd-head-end">
                            <div class="ops-sbd-legend" role="group" aria-label="Show one payment method">
                                @foreach (var paymentMethod in view.Context.PaymentMethods)
                                {
                                    <button type="button"
                                            class="ops-sbd-legend-key @(method != null && method != paymentMethod ? "is-dim" : "")"
                                            aria-pressed="@(method == paymentMethod)"
                                            title="@(method == paymentMethod ? "Show every payment method" : $"Show {TenderLabel(paymentMethod)} only")"
                                            @onclick="() => SetMethodAsync(paymentMethod)">
                                        <span class="ops-dsa-swatch @TenderClass(paymentMethod)"></span>@TenderLabel(paymentMethod)
                                    </button>
                                }
                            </div>
                            <div class="ops-ds-seg" role="group" aria-label="Measure">
                                @foreach (var option in MeasureOptions)
                                {
                                    <button type="button" class="ops-ds-seg-opt @(measure == option.Key ? "is-on" : "")"
                                            aria-pressed="@(measure == option.Key)"
                                            @onclick="() => measure = option.Key">@option.Label</button>
                                }
                            </div>
                        </div>
                    </div>

                    @{
                        var tallest = columns.Count == 0 ? 0m : columns.Max(column => column.Value);
                        var step = LabelStep(columns.Count);
                        var tradedDays = columns.Count(column => column.SalesCount > 0);
                    }

                    @* The readout above the columns answers for whichever column the pointer or focus is on,
                       and for the page's own scope otherwise. Each column carries its own readout and CSS
                       swaps it in, so hovering costs no round trip to the server. *@
                    <div class="ops-sbd-plot @(columns.Count > 62 ? "is-dense" : "")">
                        <div class="ops-sbd-readout">
                            @if (view.Day is { } readoutDay)
                            {
                                <b>@(measure == MeasureSales ? Plural(sales.SalesCount, "sale") : Money(sales.TotalAmount))</b>
                                <span>@DayLabel(readoutDay) · selected · @(measure == MeasureSales ? Money(sales.TotalAmount) : Plural(sales.SalesCount, "sale"))</span>
                            }
                            else
                            {
                                <b>@(measure == MeasureSales ? Plural(columns.Sum(c => c.SalesCount), "sale") : Money(columns.Sum(c => c.TotalAmount)))</b>
                                <span>@(measure == MeasureSales ? Money(columns.Sum(c => c.TotalAmount)) : Plural(columns.Sum(c => c.SalesCount), "sale")) over @Plural(tradedDays, "trading day")</span>
                            }
                        </div>

                        <div class="ops-sbd-cols @(day != null ? "has-pick" : "")">
                            @foreach (var column in columns)
                            {
                                var picked = day == column.Date;
                                <button type="button" class="ops-sbd-col @(picked ? "is-picked" : "")"
                                        aria-pressed="@picked" aria-label="@ColumnTitle(column)" title="@ColumnTitle(column)"
                                        @onclick="() => SetDayAsync(column.Date)">
                                    <span class="ops-sbd-col-readout" aria-hidden="true">
                                        <b>@ColumnReadoutTitle(column)</b>
                                        <span>@ColumnReadoutSub(column)</span>
                                    </span>
                                    @if (column.Value > 0)
                                    {
                                        <span class="ops-sbd-col-bar" style="height:@Percent(Math.Max(column.Value, tallest * 0.015m), tallest)">
                                            @foreach (var part in column.Parts)
                                            {
                                                <span class="ops-sbd-col-seg @TenderClass(part.Method)" style="flex-grow:@Weight(part.Value)"></span>
                                            }
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="ops-sbd-col-bar is-zero"></span>
                                    }
                                </button>
                            }
                        </div>
                        <div class="ops-sbd-axis" aria-hidden="true">
                            @for (var index = 0; index < columns.Count; index++)
                            {
                                var column = columns[index];
                                var picked = day == column.Date;
                                <span class="@(picked ? "is-picked" : "")">@(index % step == 0 || picked ? column.Date.ToString("dd") : "")</span>
                            }
                        </div>
                    </div>

                    @* ── By hour of day ─────────────────────────────────────────── *@
                    @{
                        var slots = HourSlots(sales);
                        var peak = slots.Where(slot => slot.TotalAmount > 0).MaxBy(slot => slot.TotalAmount);
                    }
                    <div class="ops-sbd-hours">
                        <div class="ops-sbd-hours-main">
                            <div class="ops-ds-card-head">
                                <i class="ph ph-clock" aria-hidden="true"></i>
                                <span class="ops-ds-card-label">By hour of day</span>
                                <span class="ops-sbd-hint">@(view.Day is { } hourDay ? DayLabel(hourDay) : "summed across the period")</span>
                            </div>
                            @* One hue: this is magnitude, not identity. Each column's figure is its tooltip. *@
                            <div class="ops-sbd-hour-cols" role="img" aria-label="@HourDescription(slots)">
                                @foreach (var slot in slots)
                                {
                                    <div class="ops-sbd-hour" title="@($"{HourLabel(slot.Hour)}–{HourLabel(slot.Hour + 1)} · {Plural(slot.SalesCount, "sale")} · {Money(slot.TotalAmount)}")">
                                        <span class="ops-sbd-hour-bar @(slot.TotalAmount == 0 ? "is-zero" : "") @(slot == peak ? "is-peak" : "")"
                                              style="height:@Percent(slot.TotalAmount, peak?.TotalAmount ?? 0)"></span>
                                    </div>
                                }
                            </div>
                            <div class="ops-sbd-hour-axis" aria-hidden="true">
                                @foreach (var slot in slots)
                                {
                                    <span>@slot.Hour.ToString("00")</span>
                                }
                            </div>
                        </div>
                        <div class="ops-sbd-peak">
                            <div class="ops-sbd-peak-label">Busiest hour</div>
                            <div class="ops-sbd-peak-num">@(peak is null ? "—" : HourLabel(peak.Hour))</div>
                            <div class="ops-sbd-peak-sub">@(peak is null ? "no sales" : $"{Plural(peak.SalesCount, "sale")} · {Money(peak.TotalAmount)}")</div>
                            <div class="ops-sbd-peak-note">@(Vans ? "Time of sale (CAT)" : "Counter time (CAT)")</div>
                        </div>
                    </div>
                </section>

                <div class="ops-sbd-pair">
                    @* ── How it was paid ──────────────────────────────────────────── *@
                    <section class="ops-ds-card ops-sbd-paid" aria-labelledby="dsa-tenders-title">
                        <div class="ops-ds-card-head">
                            <i class="ph ph-wallet" aria-hidden="true"></i>
                            <span class="ops-ds-card-label" id="dsa-tenders-title">How it was paid</span>
                            <span class="ops-sbd-tally">@Money(payments.TotalAmount)</span>
                        </div>

                        @* The whole divided, before any figure is read. Each segment's name and share are in the
                           rows directly beneath, and on its tooltip. *@
                        <div class="ops-sbd-strip" role="img" aria-label="@StripDescription(payments)">
                            @foreach (var row in payments.ByPaymentMethod.Where(r => r.TotalAmount > 0))
                            {
                                <span class="ops-dsa-seg @TenderClass(row.PaymentMethod)"
                                      style="flex-grow:@Weight(row.TotalAmount)"
                                      title="@($"{TenderLabel(row.PaymentMethod)} · {Money(row.TotalAmount)} · {Pct(row.ShareOfValuePercent)}")"></span>
                            }
                        </div>

                        <div class="ops-sbd-methods">
                            @foreach (var row in payments.ByPaymentMethod)
                            {
                                var paymentMethod = row.PaymentMethod;
                                <button type="button"
                                        class="ops-sbd-method @(method != null && method != paymentMethod ? "is-dim" : "") @(row.SalesCount == 0 ? "is-idle" : "")"
                                        aria-pressed="@(method == paymentMethod)"
                                        disabled="@(row.SalesCount == 0 && method != paymentMethod)"
                                        title="@(method == paymentMethod ? "Show every payment method" : $"Show {TenderLabel(paymentMethod)} only")"
                                        @onclick="() => SetMethodAsync(paymentMethod)">
                                    <span class="ops-dsa-key">
                                        <span class="ops-dsa-swatch @TenderClass(paymentMethod)"></span>@TenderLabel(paymentMethod)
                                    </span>
                                    <span class="ops-sbd-method-total">@Money(row.TotalAmount)</span>
                                    <span class="ops-sbd-method-sub">
                                        @MethodSub(row)
                                        @* A wallet payment settles outside the till, and the reference is what ties
                                           the receipt to money that arrived. *@
                                        @if (NeedsReference(paymentMethod) && row.WithoutReferenceCount > 0)
                                        {
                                            <span class="ops-sbd-flag"><i class="ph ph-warning" aria-hidden="true"></i>@row.WithoutReferenceCount without a reference</span>
                                        }
                                    </span>
                                    <span class="ops-sbd-method-share">@Pct(row.ShareOfValuePercent)</span>
                                </button>
                            }
                        </div>
                    </section>

                    @* ── Who took it ──────────────────────────────────────────────── *@
                    <section class="ops-ds-card ops-sbd-who" aria-labelledby="dsa-breakdown-title">
                        <div class="ops-ds-card-head">
                            <i class="ph ph-storefront" aria-hidden="true"></i>
                            <span class="ops-ds-card-label" id="dsa-breakdown-title">Who took it</span>
                            <div class="ops-ds-seg ops-sbd-head-end" role="group" aria-label="Break the takings down by">
                                @foreach (var option in BreakdownOptions)
                                {
                                    <button type="button" class="ops-ds-seg-opt @(breakdown == option.Key ? "is-on" : "")"
                                            aria-pressed="@(breakdown == option.Key)"
                                            @onclick="() => breakdown = option.Key">@option.Label</button>
                                }
                            </div>
                        </div>

                        @{
                            var breakdownRows = BreakdownRows(sales);
                            var largestRow = breakdownRows.Count == 0 ? 0m : breakdownRows.Max(row => row.TotalAmount);
                        }
                        @if (breakdownRows.Count == 0)
                        {
                            <p class="ops-dsa-none">No sales to break down.</p>
                        }
                        else
                        {
                            <div class="ops-scroll">
                                <table class="ops-table ops-sbd-table">
                                    <thead>
                                        <tr>
                                            <th aria-sort="@SortState(SortName)">
                                                <button type="button" class="ops-sbd-sort" @onclick="() => sort = SortName">
                                                    <span>@BreakdownHeading</span>
                                                    @if (sort == SortName)
                                                    {
                                                        <i class="ph ph-caret-down ops-sort-mark" aria-hidden="true"></i>
                                                    }
                                                </button>
                                            </th>
                                            <th class="ops-num" aria-sort="@SortState(SortSales)">
                                                <button type="button" class="ops-sbd-sort" @onclick="() => sort = SortSales">
                                                    <span>Sales</span>
                                                    @if (sort == SortSales)
                                                    {
                                                        <i class="ph ph-caret-down ops-sort-mark" aria-hidden="true"></i>
                                                    }
                                                </button>
                                            </th>
                                            <th class="ops-num" aria-sort="@SortState(SortTakings)">
                                                <button type="button" class="ops-sbd-sort" @onclick="() => sort = SortTakings">
                                                    <span>Takings</span>
                                                    @if (sort == SortTakings)
                                                    {
                                                        <i class="ph ph-caret-down ops-sort-mark" aria-hidden="true"></i>
                                                    }
                                                </button>
                                            </th>
                                            <th class="ops-sbd-split-head">Split</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var row in breakdownRows)
                                        {
                                            <tr>
                                                <td>
                                                    <div class="ops-sbd-row-name">@BreakdownLabel(row)</div>
                                                    @if (BreakdownSub(row) is { Length: > 0 } sub)
                                                    {
                                                        <div class="ops-sub">@sub</div>
                                                    }
                                                </td>
                                                <td class="ops-num">@row.SalesCount.ToString("N0")</td>
                                                <td class="ops-num">@Money(row.TotalAmount)</td>
                                                <td>
                                                    <div class="ops-sbd-split">
                                                        <span class="ops-sbd-track">
                                                            <span class="ops-sbd-track-fill" style="width:@Percent(row.TotalAmount, largestRow)">
                                                                @foreach (var paymentMethod in view.Focus.PaymentMethods)
                                                                {
                                                                    var amount = AmountFor(row.ByPaymentMethod, paymentMethod);
                                                                    if (amount > 0)
                                                                    {
                                                                        <span class="ops-dsa-seg @TenderClass(paymentMethod)" style="flex-grow:@Weight(amount)"
                                                                              title="@($"{TenderLabel(paymentMethod)} · {Money(amount)}")"></span>
                                                                    }
                                                                }
                                                            </span>
                                                        </span>
                                                        <span class="ops-sbd-share">@Pct(row.ShareOfValuePercent)</span>
                                                    </div>
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                    </section>
                </div>

                @* ── Best sellers ─────────────────────────────────────────────────── *@
                <section class="ops-ds-card ops-sbd-items" aria-labelledby="dsa-items-title">
                    @{
                        var items = showAllItems ? sales.TopItems : sales.TopItems.Take(ItemsShown).ToList();
                    }
                    <div class="ops-ds-card-head">
                        <i class="ph ph-package" aria-hidden="true"></i>
                        <span class="ops-ds-card-label" id="dsa-items-title">Best sellers</span>
                        <span class="ops-sbd-head-end ops-sbd-hint">
                            @items.Count of @Plural(sales.DistinctItems, "item")
                            @if (sales.TopItems.Count > ItemsShown)
                            {
                                <button type="button" class="ops-sbd-clear" @onclick="() => showAllItems = !showAllItems">
                                    @(showAllItems ? $"Top {ItemsShown} only" : $"Show top {sales.TopItems.Count}")
                                </button>
                            }
                        </span>
                    </div>

                    @if (items.Count == 0)
                    {
                        <p class="ops-dsa-none">No lines were recorded on these sales.</p>
                    }
                    else
                    {
                        var topNet = items.Max(i => i.NetAmount);

                        <div class="ops-scroll">
                            <table class="ops-table ops-sbd-table">
                                <thead>
                                    <tr>
                                        <th class="ops-sbd-item-head">Item</th>
                                        <th class="ops-num">Qty</th>
                                        <th class="ops-num">Sales</th>
                                        <th class="ops-num">Value before VAT</th>
                                        <th class="ops-sbd-share-head">Share of line value</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var item in items)
                                    {
                                        <tr>
                                            <td>
                                                <div class="ops-code">@item.ItemCode</div>
                                                @if (!string.IsNullOrWhiteSpace(item.ItemDescription) && item.ItemDescription != item.ItemCode)
                                                {
                                                    <div class="ops-sub">@item.ItemDescription</div>
                                                }
                                            </td>
                                            <td class="ops-num">@item.Quantity.ToString("#,##0.##")</td>
                                            <td class="ops-num">@item.SalesCount.ToString("N0")</td>
                                            <td class="ops-num">@item.NetAmount.ToString("N2", System.Globalization.CultureInfo.InvariantCulture)</td>
                                            <td>
                                                <div class="ops-sbd-split">
                                                    <span class="ops-sbd-track">
                                                        <span class="ops-sbd-track-fill is-accent" style="width:@Percent(item.NetAmount, topNet)"></span>
                                                    </span>
                                                    <span class="ops-sbd-share">@Pct(item.ShareOfNetPercent)</span>
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </section>

                @if (sales.SalesCount == 0)
                {
                    <div class="ops-empty">
                        <i class="ph ph-receipt" aria-hidden="true"></i>
                        <h3>No sales @(view.Method is null ? "" : $"paid by {TenderLabel(view.Method)} ")@(view.Day is { } emptyDay ? $"on {DayLabel(emptyDay)}" : "in this period")</h3>
                        <p>Nothing matching was @(Vans ? "sold off a van" : "rung up at a till or vending counter"). Clear a filter or widen the period to see more.</p>
                    </div>
                }

                <div class="ops-sbd-foot">
                    <span>
                        Generated @view.Focus.GeneratedAtUtc.AddHours(2).ToString("dd MMM yyyy, HH:mm", System.Globalization.CultureInfo.InvariantCulture) · amounts in @sales.Currency, VAT included unless stated
                    </span>
                    @if (Vans)
                    {
                        @* An online sale's VAT is on its SAP invoice, not a local receipt, so the split above
                           is the offline half's. *@
                        <span>Offline uploads and live invoices both counted. VAT is known on offline receipts only.</span>
                    }
                    else
                    {
                        <span>Van sales include those made online, counted once from the receipt the handset signed.</span>
                    }
                </div>

            </div>
        }
    }

    @if (toast != null)
    {
        <div class="ops-sbd-toast" role="status">
            <i class="ph ph-check-circle" aria-hidden="true"></i>@toast
        </div>
    }
</div>
