    /// <summary>
    /// Print sheet for a held transfer. It carries a DRAFT watermark because the stock has not
    /// moved: nothing posts to SAP until every approval stage signs off.
    /// </summary>
    private string BuildPendingTransferDraftHtml(PendingInventoryTransferDto pending)
    {
        var lines = pending.Lines;
        var rows = new StringBuilder();
        var lineNumber = 1;

        foreach (var line in lines)
        {
            rows.Append($"<tr><td>{lineNumber++}</td>")
                .Append($"<td><strong>{Html(line.ItemCode)}</strong></td>")
                .Append($"<td>{Html(line.FromWarehouseCode ?? pending.FromWarehouse)}</td>")
                .Append($"<td>{Html(line.ToWarehouseCode ?? pending.ToWarehouse)}</td>")
                .Append($"<td class='num'>{Html(QuantityDisplay.Format(line.Quantity, line.UoMCode))}</td>")
                .Append($"<td>{Html(line.UoMCode)}</td></tr>");
        }

        if (lines.Count == 0)
            rows.Append("<tr><td colspan='6' class='muted'>No line items recorded.</td></tr>");

        var stages = new StringBuilder();
        foreach (var stage in pending.ApprovalStages)
        {
            stages.Append($"<tr><td>{Html(stage.StageName)}</td>")
                  .Append($"<td>{Html(string.Join(", ", stage.AuthorizerRoles))}</td>")
                  .Append($"<td>{Html(stage.Status)} ({stage.ApprovalCount}/{stage.ApprovalsRequired})</td></tr>");
        }

        if (pending.ApprovalStages.Count == 0)
            stages.Append("<tr><td colspan='3' class='muted'>No approval stages recorded.</td></tr>");

        var totalQty = Html(QuantityDisplay.Format(lines.Sum(l => l.Quantity)));
        var comments = string.IsNullOrWhiteSpace(pending.Comments)
            ? string.Empty
            : $"<div class='comments'><span class='k'>Comments</span>{Html(pending.Comments)}</div>";
        var printedAt = IAuditService.ToCAT(DateTime.UtcNow).ToString("dd MMM yyyy HH:mm");
        var submitted = pending.CreatedAtUtc.ToLocalTime().ToString("dd MMM yyyy HH:mm");
        var draftNumber = Html(DraftReference(pending));
        var logoDataUri = GetBrandLogoDataUri();
        var logo = logoDataUri == null
            ? string.Empty
            : $"<img class='logo' src='{logoDataUri}' alt='{Html(AppSettings.CompanyName)}' />";

        return $$"""
            <!doctype html>
            <html>
            <head>
                <meta charset="utf-8">
                <title>Draft Inventory Transfer {{draftNumber}}</title>
                <style>
                    @page { size: A4; margin: 14mm; }
                    body { font-family: Arial, Helvetica, sans-serif; color: #111827; font-size: 12px; margin: 0;
                           position: relative; }
                    h1 { font-size: 20px; margin: 0 0 2px; }
                    h2 { font-size: 13px; margin: 18px 0 6px; text-transform: uppercase; letter-spacing: .5px; }
                    .head { display: flex; justify-content: space-between; align-items: flex-start;
                            border-bottom: 2px solid #111827; padding-bottom: 10px; margin-bottom: 16px; }
                    .brand { display: flex; align-items: center; gap: 12px; }
                    .logo { height: 46px; width: auto; }
                    .company { font-size: 15px; font-weight: 700; }
                    .doc-no { font-size: 18px; font-weight: 700; text-align: right; }
                    .badge { display: inline-block; border: 1px solid #b45309; color: #b45309; border-radius: 3px;
                             padding: 2px 8px; font-size: 11px; font-weight: 700; letter-spacing: .5px; }
                    .route { display: flex; align-items: center; gap: 16px; border: 1px solid #d1d5db;
                             padding: 12px; margin-bottom: 16px; }
                    .route .leg { flex: 1; text-align: center; }
                    .route .leg .code { font-size: 16px; font-weight: 700; }
                    .grid { display: flex; flex-wrap: wrap; gap: 10px 32px; margin-bottom: 16px; }
                    .k { display: block; font-size: 10px; text-transform: uppercase; letter-spacing: .5px; color: #6b7280; }
                    table { width: 100%; border-collapse: collapse; }
                    th, td { text-align: left; padding: 6px 8px; border-bottom: 1px solid #e5e7eb; vertical-align: top; }
                    th { background: #f3f4f6; border-bottom: 1px solid #9ca3af; font-size: 11px;
                         text-transform: uppercase; letter-spacing: .4px; }
                    .num { text-align: right; }
                    tfoot td { font-weight: 700; border-top: 2px solid #111827; border-bottom: none; }
                    .muted { color: #6b7280; }
                    .comments { border: 1px solid #d1d5db; padding: 10px; margin-bottom: 16px; }
                    .sigs { display: flex; gap: 32px; margin-top: 40px; }
                    .sig { flex: 1; border-top: 1px solid #111827; padding-top: 6px; font-size: 11px; }
                    .notice { border: 1px solid #b45309; background: #fffbeb; color: #92400e; padding: 10px;
                              margin-top: 18px; font-size: 11px; }
                    .foot { margin-top: 24px; font-size: 10px; color: #6b7280; text-align: center; }

                    /* Sits behind the content on every printed page. print-color-adjust keeps the
                       mark visible in browsers that drop background colour when printing. */
                    .watermark { position: fixed; top: 50%; left: 50%; z-index: -1;
                                 transform: translate(-50%, -50%) rotate(-35deg);
                                 font-size: 120px; font-weight: 800; letter-spacing: 12px;
                                 color: #ef4444; opacity: .14; white-space: nowrap;
                                 -webkit-print-color-adjust: exact; print-color-adjust: exact; }
                </style>
            </head>
            <body>
                <div class="watermark">DRAFT</div>

                <div class="head">
                    <div class="brand">
                        {{logo}}
                        <div>
                            <div class="company">{{Html(AppSettings.CompanyName)}}</div>
                            <h1>Inventory Transfer &mdash; Draft</h1>
                            <span class="badge">NOT POSTED TO SAP</span>
                        </div>
                    </div>
                    <div class="doc-no">
                        {{draftNumber}}
                        <div class="muted" style="font-weight:400;font-size:11px;">
                            {{Html(FormatPendingStatus(pending))}}
                        </div>
                    </div>
                </div>

                <div class="route">
                    <div class="leg">
                        <span class="k">Source</span>
                        <span class="code">{{Html(pending.FromWarehouse)}}</span>
                    </div>
                    <div style="font-size:18px;">&rarr;</div>
                    <div class="leg">
                        <span class="k">Destination</span>
                        <span class="code">{{Html(pending.ToWarehouse)}}</span>
                    </div>
                </div>

                <div class="grid">
                    <div><span class="k">Submitted by</span>{{Html(pending.CreatedByName)}}</div>
                    <div><span class="k">Submitted</span>{{Html(submitted)}}</div>
                    <div><span class="k">Approval process</span>{{Html(pending.ApprovalTemplateName ?? "—")}}</div>
                    <div><span class="k">Total Lines</span>{{lines.Count}}</div>
                </div>

                {{comments}}

                <h2>Lines</h2>
                <table>
                    <thead>
                        <tr><th>#</th><th>Item</th><th>From</th><th>To</th><th class="num">Qty</th><th>UoM</th></tr>
                    </thead>
                    <tbody>{{rows}}</tbody>
                    <tfoot>
                        <tr><td colspan="4" class="num">Total</td><td class="num">{{totalQty}}</td><td></td></tr>
                    </tfoot>
                </table>

                <h2>Approval stages</h2>
                <table>
                    <thead>
                        <tr><th>Stage</th><th>Authorizers</th><th>Status</th></tr>
                    </thead>
                    <tbody>{{stages}}</tbody>
                </table>

                <div class="sigs">
                    <div class="sig">Issued by (name / signature / date)</div>
                    <div class="sig">Received by (name / signature / date)</div>
                </div>

                <div class="notice">
                    This is a draft. No stock has moved and no document exists in SAP. It becomes an
                    inventory transfer only once every approval stage above has been approved.
                </div>

                <div class="foot">Printed {{printedAt}} CAT</div>
            </body>
            </html>
            """;
    }

    private static string Html(string? value) => System.Net.WebUtility.HtmlEncode(value ?? string.Empty);

    // The print sheet is written into a blank iframe and printed ~300ms later, so a
    // relative <img src> can race the print call and produce a blank logo. Inlining the
    // asset as a data URI keeps the document self-contained. Encoded once per process.
    private static string? _brandLogoDataUri;
    private static bool _brandLogoResolved;

    private string? GetBrandLogoDataUri()
    {
        if (_brandLogoResolved) return _brandLogoDataUri;
        _brandLogoResolved = true;

        try
        {
            // WebRootPath is the authoritative wwwroot location in both dev and published
            // layouts. The asset is not copied to bin/, so probing AppContext.BaseDirectory
            // would miss it when running from source.
            var path = Path.Combine(Env.WebRootPath ?? string.Empty, "images", "kefalos-logo.jpg");
            if (File.Exists(path))
                _brandLogoDataUri = $"data:image/jpeg;base64,{Convert.ToBase64String(File.ReadAllBytes(path))}";
            else
                Logger.LogWarning("Brand logo not found at {Path}; printing transfer document without it", path);
        }
        catch (Exception ex)
        {
            // Branding is decorative — the document must still print without it.
            Logger.LogWarning(ex, "Failed to load brand logo for transfer document");
        }

        return _brandLogoDataUri;
    }

    private void TransferPageChanged(int i) => _transfersTable.NavigateTo(i - 1);
    private void RequestPageChanged(int i) => _requestsTable.NavigateTo(i - 1);

    private async Task PreviousPage()
    {
        if (currentPage > 1) { currentPage--; await LoadTransfers(); }
    }

    private async Task NextPage()
    {
        if (hasMore) { currentPage++; await LoadTransfers(); }
    }

    // ── Transfer Request Methods ────────────────────────
    private async Task LoadTransferRequestsAsync()
    {
        isLoadingRequests = true;
        try
        {
            var response = await TransferService.GetAllTransferRequestsAsync(transferRequestBatchSize);
            if (response?.TransferRequests != null)
            {
                transferRequests = response.TransferRequests;
                transferRequestCount = response.TransferRequests.Count;
            }
            else
            {
                transferRequests = new();
                transferRequestCount = 0;
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to load transfer requests");
        }
        finally
        {
            isLoadingRequests = false;
        }
    }

    private async Task ViewTransferRequest(InventoryTransferRequestDto request)
    {
        selectedTransferRequest = request;
        CancelEditRequestLines();
        await LoadHeldEditAsync(request.DocEntry);
    }

    private void CloseRequestModal()
    {
        selectedTransferRequest = null;
        heldEditForSelectedRequest = null;
        CancelEditRequestLines();
    }

    // ── Editing a transfer request's lines ──────────────

    /// <summary>
    /// Whether the caller may write to SAP for this request's source warehouse. Mirrors the
    /// server-side scope check so the UI can say up front whether a change will be applied or
    /// sent for approval; the server decides either way.
    /// </summary>
    private bool CanActOnRequestSource(InventoryTransferRequestDto? request)
    {
        if (request == null) return false;
        if (!IsWarehouseScopedRole(currentUserRole)) return true;
        return !string.IsNullOrWhiteSpace(request.FromWarehouse) &&
               assignedWarehouseCodes.Contains(request.FromWarehouse);
    }

    private static bool IsWarehouseScopedRole(string? role) =>
        string.Equals(role, UserRoles.DepotController, StringComparison.OrdinalIgnoreCase);

    private bool CanEditRequestLines(InventoryTransferRequestDto? request)
        => request != null &&
           IsRequestConvertible(request) &&
           request.Lines?.Any() == true &&
           heldEditForSelectedRequest == null &&
           currentUserRole is not null &&
           RequestEditorRoles.Contains(currentUserRole, StringComparer.OrdinalIgnoreCase);

    private void BeginEditRequestLines()
    {
        requestEditLines = (selectedTransferRequest?.Lines ?? [])
            .Select(line => new RequestEditLineModel
            {
                LineNum = line.LineNum,
                ItemCode = line.ItemCode,
                ItemDescription = line.ItemDescription,
                UoMCode = line.UoMCode,
                OriginalQuantity = line.Quantity,
                Quantity = line.Quantity
            })
            .ToList();
        requestEditReason = null;
        isEditingRequestLines = true;
    }

    private void CancelEditRequestLines()
    {
        isEditingRequestLines = false;
        requestEditLines = [];
        requestEditReason = null;
    }

    private void SetRequestEditQuantity(RequestEditLineModel line, string? value)
    {
        line.Quantity = decimal.TryParse(value, out var quantity) ? quantity : 0m;
    }

    private void ToggleRequestEditLineRemoval(RequestEditLineModel line)
    {
        line.Removed = !line.Removed;
        if (!line.Removed && line.Quantity <= 0)
            line.Quantity = line.OriginalQuantity;
    }

    private async Task SaveRequestEditAsync()
    {
        if (selectedTransferRequest == null || isSavingRequestEdit) return;

        var kept = requestEditLines.Where(line => !line.Removed).ToList();
        if (kept.Count == 0)
        {
            errorMessage = "A transfer request must keep at least one line. Close the request instead.";
            return;
        }

        var invalid = kept.FirstOrDefault(line => line.Quantity <= 0);
        if (invalid != null)
        {
            errorMessage = $"Line {invalid.LineNum} must keep a quantity greater than zero. Remove the line instead.";
            return;
        }

        if (kept.Count == requestEditLines.Count && kept.All(line => line.Quantity == line.OriginalQuantity))
        {
            errorMessage = "Nothing has changed on this request.";
            return;
        }

        isSavingRequestEdit = true;
        errorMessage = null;
        successMessage = null;
        StateHasChanged();
        try
        {
            var docEntry = selectedTransferRequest.DocEntry;
            var (success, message, result) = await TransferService.EditTransferRequestAsync(docEntry,
                new EditTransferRequestRequest
                {
                    Lines = kept
                        .Select(line => new EditTransferRequestLineRequest { LineNum = line.LineNum, Quantity = line.Quantity })
                        .ToList(),
                    Reason = requestEditReason
                });

            if (!success)
            {
                errorMessage = message;
                return;
            }

            successMessage = message;
            CancelEditRequestLines();

            if (result?.RequiresApproval == true)
            {
                heldEditForSelectedRequest = result.PendingEdit;
            }
            else
            {
                // The lines came back from SAP, so refresh the list the drawer was opened from.
                await LoadTransferRequestsAsync();
                selectedTransferRequest = transferRequests?.FirstOrDefault(item => item.DocEntry == docEntry)
                                          ?? selectedTransferRequest;
                await LoadHeldEditAsync(docEntry);
            }
        }
        finally
        {
            isSavingRequestEdit = false;
            StateHasChanged();
        }
    }

    // ── Held changes awaiting approval ──────────────────

    private async Task LoadHeldEditAsync(int docEntry)
    {
        heldEditForSelectedRequest = null;
        requestEditDecisionRemarks = null;
        try
        {
            var response = await TransferService.GetPendingRequestEditsAsync(
                PendingRequestEditStatuses.AwaitingApproval, docEntry);
            heldEditForSelectedRequest = response?.Items.FirstOrDefault();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to load held changes for transfer request {DocEntry}", docEntry);
        }
    }

    private async Task DecideRequestEditAsync(string decision)
    {
        var edit = heldEditForSelectedRequest;
        if (edit == null || isDecidingRequestEdit) return;

        isDecidingRequestEdit = true;
        errorMessage = null;
        successMessage = null;
        StateHasChanged();
        try
        {
            var (success, message) = await TransferService.DecidePendingRequestEditAsync(
                edit.Id, decision, remarks: requestEditDecisionRemarks);
            if (success) successMessage = message; else errorMessage = message;

            // An approval that reaches SAP rewrites the request's lines, so reload either way:
            // the stored state is what should be on screen, not what we acted against.
            await LoadTransferRequestsAsync();
            selectedTransferRequest = transferRequests?.FirstOrDefault(item => item.DocEntry == edit.RequestDocEntry)
                                      ?? selectedTransferRequest;
            await LoadHeldEditAsync(edit.RequestDocEntry);
        }
        finally
        {
            isDecidingRequestEdit = false;
            StateHasChanged();
        }
    }

    private async Task WithdrawRequestEditAsync()
    {
        var edit = heldEditForSelectedRequest;
        if (edit == null || isDecidingRequestEdit) return;

        isDecidingRequestEdit = true;
        errorMessage = null;
        successMessage = null;
        StateHasChanged();
        try
        {
            var (success, message) = await TransferService.CancelPendingRequestEditAsync(edit.Id);
            if (success) successMessage = message; else errorMessage = message;
            await LoadHeldEditAsync(edit.RequestDocEntry);
        }
        finally
        {
            isDecidingRequestEdit = false;
            StateHasChanged();
        }
    }

    private sealed class RequestEditLineModel
    {
        public int LineNum { get; set; }
        public string? ItemCode { get; set; }
        public string? ItemDescription { get; set; }
        public string? UoMCode { get; set; }
        public decimal OriginalQuantity { get; set; }
        public decimal Quantity { get; set; }
        public bool Removed { get; set; }
    }

    private async Task RefreshTransferRequests() => await LoadTransferRequestsAsync();

    private void ClearRequestFilters()
    {
        _requestSearchString = null;
        _requestFromWarehouseFilter = null;
        _requestToWarehouseFilter = null;
        _requestStatusFilter = null;
        _requestRequesterFilter = null;
        requestFromDate = null;
        requestToDate = null;
    }

    private string GetStatusCssClass(string? status) => status?.ToLower() switch
    {
        "open" or "bost_open" => "open",
        "closed" or "bost_close" => "closed",
        "approved" or "generated" or "generatedbyauthorizer" or "posted" => "approved",
        "rejected" or "notapproved" or "cancelled" or "postfailed" => "rejected",
        "pending" or "awaitingapproval" => "pending",
        _ => "open"
    };

    private string GetFriendlyStatus(string? status) => status?.ToLower() switch
    {
        "bost_open" or "open" => "Open",
        "bost_close" or "closed" => "Closed",
        "bost_delivered" => "Delivered",
        "bost_paid" => "Paid",
        "approved" => "Approved",
        "generated" => "Generated",
        "generatedbyauthorizer" => "Generated by Authorizer",
        "rejected" or "notapproved" => "Not Approved",
        "cancelled" => "Cancelled",
        "pending" => "Pending",
        _ => status ?? "Open"
    };

    private bool IsRequestConvertible(InventoryTransferRequestDto? request)
    {
        if (request == null) return false;
        var status = request.DocumentStatus?.ToLower();
        var approvalStatus = request.ApprovalStatus?.ToLower();
        return (status == null || status == "open" || status == "bost_open") &&
               (approvalStatus == null || approvalStatus == "pending");
    }

    private bool CanCurrentUserDecide(InventoryTransferRequestDto? request)
        => request is not null && request.ApprovalStages.Any(stage => CanCurrentUserDecideStage(request, stage));

    private bool CanCurrentUserDecideStage(InventoryTransferRequestDto? request, ApprovalStageProgressModel stage)
    {
        if (!IsRequestConvertible(request) || !string.Equals(stage.Status, "Pending", StringComparison.OrdinalIgnoreCase)) return false;
        if (!currentUserId.HasValue || string.IsNullOrWhiteSpace(currentUserRole)) return false;
        if (stage.Decisions.Any(x => x.AuthorizerUserId == currentUserId.Value)) return false;
        if (string.Equals(currentUserRole, "Admin", StringComparison.OrdinalIgnoreCase)) return true;
        return stage.AuthorizerUserIds.Contains(currentUserId.Value) ||
               stage.AuthorizerRoles.Contains(currentUserRole, StringComparer.OrdinalIgnoreCase);
    }

    private string GetApprovalDisplayStatus(InventoryTransferRequestDto request)
    {
        if (string.Equals(request.ApprovalStatus, "Pending", StringComparison.OrdinalIgnoreCase))
        {
            var pending = request.ApprovalStages.Where(x => x.Status == "Pending").Select(x => x.StageName).ToList();
            return pending.Count == 0 ? "Pending Approval" : $"Awaiting {string.Join(", ", pending)}";
        }
        return GetFriendlyStatus(request.ApprovalStatus ?? request.DocumentStatus);
    }

    private string GetApprovalStageLabel(InventoryTransferRequestDto request)
        => string.Equals(request.ApprovalStatus, "Pending", StringComparison.OrdinalIgnoreCase)
            ? request.ApprovalTemplateName ?? "Approval process"
            : GetFriendlyStatus(request.ApprovalStatus ?? request.DocumentStatus);

    private static bool WillCompleteApproval(InventoryTransferRequestDto request, ApprovalStageProgressModel stage)
        => stage.ApprovalCount + 1 >= stage.ApprovalsRequired &&
           request.ApprovalStages.All(x => x.StageId == stage.StageId || x.Status == "Approved");

    private bool CanCurrentUserGenerate(InventoryTransferRequestDto request)
        => string.Equals(request.ApprovalStatus, "Approved", StringComparison.OrdinalIgnoreCase) &&
           currentUserId.HasValue &&
           (string.Equals(currentUserRole, "Admin", StringComparison.OrdinalIgnoreCase) ||
            request.ApprovalStages.Any(stage => stage.AuthorizerUserIds.Contains(currentUserId.Value) ||
                                                stage.AuthorizerRoles.Contains(currentUserRole ?? string.Empty, StringComparer.OrdinalIgnoreCase)));

    private string GetApprovalActionLabel(InventoryTransferRequestDto request) => "Approve";

    private string? GetDecisionRemarks(Guid stageId)
        => decisionRemarks.TryGetValue(stageId, out var value) ? value : null;

    private void SetDecisionRemarks(Guid stageId, string? value) => decisionRemarks[stageId] = value;

    private static string GetFriendlyRoleName(string? role) => role switch
    {
        "StockController" => "Stock Officer",
        "DepotController" => "Depot Controller",
        "Admin" => "Administrator",
        null or "" => "Administrator review",
        _ => role
    };

    private static bool MatchesFilterValue(string? value, string? filter)
    {
        return string.IsNullOrWhiteSpace(filter) || string.Equals(value, filter, StringComparison.OrdinalIgnoreCase);
    }

    private static bool MatchesDateRange(string? value, DateTime? from, DateTime? to)
    {
        if (!from.HasValue && !to.HasValue)
        {
            return true;
        }

        if (!DateTime.TryParse(value, out var parsedDate))
        {
            return false;
        }

        var date = parsedDate.Date;

        if (from.HasValue && date < from.Value.Date)
        {
            return false;
        }

        if (to.HasValue && date > to.Value.Date)
        {
            return false;
        }

        return true;
    }

    private async Task ConvertRequest(InventoryTransferRequestDto request, Guid? stageId = null, bool generateDocument = false)
    {
        if (request == null) return;

        isConverting = true;
        errorMessage = null;
        successMessage = null;

        try
        {
            var selectedStageId = stageId ?? request.ApprovalStages
                .FirstOrDefault(stage => CanCurrentUserDecideStage(request, stage))?.StageId;
            var (success, message, transfer) = selectedStageId.HasValue
                ? await ApprovalProcessService.SubmitDecisionAsync(
                    request.DocEntry, selectedStageId.Value, "Approved", GetDecisionRemarks(selectedStageId.Value), generateDocument)
                : await TransferService.ConvertTransferRequestToTransferAsync(request.DocEntry);

            if (success)
            {
                successMessage = message;
                CloseRequestModal();
                await LoadTransferRequestsAsync();
            }
            else
            {
                errorMessage = message;
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error converting transfer request {DocEntry}", request.DocEntry);
            errorMessage = $"Error: {ex.Message}";
        }
        finally
        {
            isConverting = false;
            StateHasChanged();
        }
    }

    private Task GenerateApprovedRequest(InventoryTransferRequestDto request)
    {
        var stage = request.ApprovalStages.FirstOrDefault(item =>
            string.Equals(currentUserRole, "Admin", StringComparison.OrdinalIgnoreCase) ||
            (currentUserId.HasValue && item.AuthorizerUserIds.Contains(currentUserId.Value)) ||
            item.AuthorizerRoles.Contains(currentUserRole ?? string.Empty, StringComparer.OrdinalIgnoreCase));
        return stage is null ? Task.CompletedTask : ConvertRequest(request, stage.StageId, true);
    }

    private async Task RejectRequest(InventoryTransferRequestDto request, Guid? stageId = null)
    {
        isRejecting = true;
        errorMessage = null;
        successMessage = null;

        try
        {
            var selectedStageId = stageId ?? request.ApprovalStages
                .FirstOrDefault(stage => CanCurrentUserDecideStage(request, stage))?.StageId;
            bool success;
            string message;
            if (selectedStageId.HasValue)
            {
                var result = await ApprovalProcessService.SubmitDecisionAsync(
                    request.DocEntry, selectedStageId.Value, "NotApproved", GetDecisionRemarks(selectedStageId.Value));
                success = result.Success;
                message = result.Message;
            }
            else
            {
                (success, message) = await TransferService.CloseTransferRequestAsync(request.DocEntry);
            }
            if (success)
            {
                successMessage = message;
                CloseRequestModal();
                await LoadTransferRequestsAsync();
            }
            else
            {
                errorMessage = message;
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error rejecting transfer request {DocEntry}", request.DocEntry);
            errorMessage = $"Error: {ex.Message}";
        }
        finally
        {
            isRejecting = false;
            StateHasChanged();
        }
    }
