<!-- ── Transfer request detail drawer ─────────────────────── -->
@if (selectedTransferRequest != null)
{
    <div class="itx-scrim" @onclick="CloseRequestModal"></div>
    <div class="itx-drawer">
        <div class="itx-drawer-head">
            <div style="flex:1;min-width:0;">
                <div class="itx-kicker">Transfer request</div>
                <h5>#@selectedTransferRequest.DocNum</h5>
                <div class="itx-drawer-route">
                    <span class="itx-wh src">@selectedTransferRequest.FromWarehouse</span>
                    <i class="bi bi-arrow-right itx-arrow"></i>
                    <span class="itx-wh dst">@selectedTransferRequest.ToWarehouse</span>
                </div>
            </div>
            <button type="button" class="itx-btn itx-btn-icon" title="Close" aria-label="Close details"
                    @onclick="CloseRequestModal">
                @CloseGlyph
            </button>
        </div>
        <div class="itx-drawer-body">
            <div class="itx-grid">
                <div>
                    <div class="k">Status</div>
                    <div class="v">
                        <span class="itx-status @GetStatusCssClass(selectedTransferRequest.ApprovalStatus ?? selectedTransferRequest.DocumentStatus)">
                            @GetApprovalDisplayStatus(selectedTransferRequest)
                        </span>
                    </div>
                </div>
                <div>
                    <div class="k">Destination</div>
                    <div class="v">@WarehouseName(selectedTransferRequest.ToWarehouse)</div>
                </div>
                <div>
                    <div class="k">Raised</div>
                    <div class="v">@FormatDate(selectedTransferRequest.DocDate)</div>
                </div>
                <div>
                    <div class="k">Due</div>
                    <div class="v">@FormatDate(selectedTransferRequest.DueDate)</div>
                </div>
                <div>
                    <div class="k">Requester</div>
                    <div class="v">@(selectedTransferRequest.RequesterName ?? "—")</div>
                </div>
                <div>
                    <div class="k">Requested by role</div>
                    <div class="v">@GetFriendlyRoleName(selectedTransferRequest.RequestedByRole)</div>
                </div>
                <div>
                    <div class="k">Approval stage</div>
                    <div class="v">@GetApprovalStageLabel(selectedTransferRequest)</div>
                </div>
                <div>
                    <div class="k">Email</div>
                    <div class="v plain">@(selectedTransferRequest.RequesterEmail ?? "—")</div>
                </div>
                @if (!string.IsNullOrWhiteSpace(selectedTransferRequest.Comments))
                {
                    <div class="span-2">
                        <div class="k">Comments</div>
                        <div class="v plain">@selectedTransferRequest.Comments</div>
                    </div>
                }
            </div>

            @if (selectedTransferRequest.ApprovalStages.Count > 0)
            {
                <div class="itx-section">
                    <i class="bi bi-diagram-3"></i>
                    Approval Stages — @selectedTransferRequest.ApprovalTemplateName
                </div>
                <div style="margin-bottom:1rem;">
                    @foreach (var stage in selectedTransferRequest.ApprovalStages)
                    {
                        <div class="itx-stage">
                            <div style="display:flex;align-items:flex-start;justify-content:space-between;gap:.5rem;">
                                <div>
                                    <div style="font-weight:500;">@stage.StageName</div>
                                    @if (!string.IsNullOrWhiteSpace(stage.Description))
                                    {
                                        <div class="itx-stage-roles">@stage.Description</div>
                                    }
                                </div>
                                <span class="itx-status @GetStatusCssClass(stage.Status)">@GetFriendlyStatus(stage.Status)</span>
                            </div>
                            <div class="itx-note" style="margin:.5rem 0 0;">
                                Approvals: @stage.ApprovalCount/@stage.ApprovalsRequired &nbsp;|&nbsp;
                                Rejections: @stage.RejectionCount/@stage.RejectionsRequired
                            </div>
                            @if (stage.Decisions.Count > 0)
                            {
                                <div style="margin-top:.5rem;">
                                    @foreach (var decision in stage.Decisions.OrderByDescending(x => x.DecidedAtUtc))
                                    {
                                        <div style="font-size:.78rem;padding:.2rem 0;">
                                            <strong>@decision.AuthorizerName</strong>
                                            <span class="itx-status @GetStatusCssClass(decision.Decision)">@GetFriendlyStatus(decision.Decision)</span>
                                            <span class="itx-muted">@decision.DecidedAtUtc.ToLocalTime().ToString("dd MMM yyyy HH:mm")</span>
                                            @if (!string.IsNullOrWhiteSpace(decision.Remarks))
                                            {
                                                <div class="itx-muted" style="font-style:italic;">@decision.Remarks</div>
                                            }
                                        </div>
                                    }
                                </div>
                            }
                            @if (CanCurrentUserDecideStage(selectedTransferRequest, stage))
                            {
                                <label class="itx-label" for="itx-stage-remarks-@stage.StageId">Remarks</label>
                                <textarea id="itx-stage-remarks-@stage.StageId" class="itx-input" rows="2"
                                          placeholder="Optional approval or rejection remarks"
                                          value="@GetDecisionRemarks(stage.StageId)"
                                          @oninput="e => SetDecisionRemarks(stage.StageId, e.Value?.ToString())"></textarea>
                                <div class="itx-actions">
                                    <button type="button" class="itx-btn itx-btn-sm itx-btn-primary"
                                            disabled="@(isConverting || isRejecting)"
                                            @onclick="() => ConvertRequest(selectedTransferRequest, stage.StageId, false)">
                                        <i class="bi bi-check-circle"></i> Approve
                                    </button>
                                    @if (WillCompleteApproval(selectedTransferRequest, stage))
                                    {
                                        <button type="button" class="itx-btn itx-btn-sm"
                                                disabled="@(isConverting || isRejecting)"
                                                @onclick="() => ConvertRequest(selectedTransferRequest, stage.StageId, true)">
                                            <i class="bi bi-box-arrow-in-down"></i> Approve &amp; Add
                                        </button>
                                    }
                                    <button type="button" class="itx-btn itx-btn-sm itx-btn-danger"
                                            disabled="@(isConverting || isRejecting)"
                                            @onclick="() => RejectRequest(selectedTransferRequest, stage.StageId)">
                                        <i class="bi bi-x-circle"></i> Reject Approval
                                    </button>
                                </div>
                            }
                        </div>
                    }
                </div>
                @if (CanCurrentUserGenerate(selectedTransferRequest))
                {
                    <div class="itx-alert ok" style="align-items:center;">
                        <div class="itx-alert-body">All stages are approved. The SAP inventory transfer can now be generated.</div>
                        <button type="button" class="itx-btn itx-btn-sm itx-btn-primary" disabled="@isConverting"
                                @onclick="() => GenerateApprovedRequest(selectedTransferRequest)">
                            <i class="bi bi-box-arrow-in-down"></i> Add Transfer
                        </button>
                    </div>
                }
            }

            @if (heldEditForSelectedRequest != null)
            {
                <div class="itx-section">
                    <i class="bi bi-hourglass-split"></i> Change awaiting approval
                </div>
                <div class="itx-alert warn">
                    <i class="bi bi-exclamation-triangle-fill"></i>
                    <div class="itx-alert-body">
                        <strong>@heldEditForSelectedRequest.CreatedByName</strong> proposed a change on
                        @heldEditForSelectedRequest.CreatedAtUtc.ToLocalTime().ToString("dd MMM yyyy HH:mm").
                        It is not in SAP yet.
                        @if (ReassignsWarehouse(heldEditForSelectedRequest))
                        {
                            <div style="margin-top:.25rem;">
                                Warehouses: <strong>@heldEditForSelectedRequest.FromWarehouse → @heldEditForSelectedRequest.ToWarehouse</strong>
                                would become
                                <strong>@HeldEditEffectiveFrom(heldEditForSelectedRequest) → @HeldEditEffectiveTo(heldEditForSelectedRequest)</strong>.
                            </div>
                        }
                        @if (!string.IsNullOrWhiteSpace(heldEditForSelectedRequest.Reason))
                        {
                            <div style="font-style:italic;margin-top:.25rem;">@heldEditForSelectedRequest.Reason</div>
                        }
                    </div>
                </div>
                <div class="itx-lines-wrap">
                    <table class="itx-lines">
                        <thead>
                            <tr><th>#</th><th>Item</th><th class="num">Current</th><th class="num">Proposed</th></tr>
                        </thead>
                        <tbody>
                            @foreach (var line in heldEditForSelectedRequest.OriginalLines)
                            {
                                var proposed = heldEditForSelectedRequest.ProposedLines
                                    .FirstOrDefault(item => item.LineNum == line.LineNum);
                                <tr>
                                    <td>@line.LineNum</td>
                                    <td><div class="strong">@line.ItemCode</div></td>
                                    <td class="num">@QuantityDisplay.Format(line.Quantity, line.UoMCode)</td>
                                    <td class="num">
                                        @if (proposed == null)
                                        {
                                            <span class="itx-status rejected">Removed</span>
                                        }
                                        else if (proposed.Quantity != line.Quantity)
                                        {
                                            <strong>@QuantityDisplay.Format(proposed.Quantity, line.UoMCode)</strong>
                                        }
                                        else
                                        {
                                            <span class="muted">unchanged</span>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
                @if (heldEditForSelectedRequest.CanCurrentUserDecide)
                {
                    <label class="itx-label" for="itx-edit-remarks">Remarks</label>
                    <textarea id="itx-edit-remarks" class="itx-input" rows="2"
                              placeholder="Optional approval or rejection remarks"
                              value="@requestEditDecisionRemarks"
                              @oninput="e => requestEditDecisionRemarks = e.Value?.ToString()"></textarea>
                    <div class="itx-actions">
                        <button type="button" class="itx-btn itx-btn-sm itx-btn-primary" disabled="@isDecidingRequestEdit"
                                @onclick="() => DecideRequestEditAsync(ApprovedDecision)">
                            <i class="bi bi-check-circle"></i> Approve change
                        </button>
                        <button type="button" class="itx-btn itx-btn-sm itx-btn-danger" disabled="@isDecidingRequestEdit"
                                @onclick="() => DecideRequestEditAsync(RejectedDecision)">
                            <i class="bi bi-x-circle"></i> Reject change
                        </button>
                    </div>
                }
                else if (heldEditForSelectedRequest.CreatedByUserId == currentUserId)
                {
                    <div class="itx-actions">
                        <button type="button" class="itx-btn itx-btn-sm" disabled="@isDecidingRequestEdit"
                                @onclick="WithdrawRequestEditAsync">
                            <i class="bi bi-arrow-counterclockwise"></i> Withdraw change
                        </button>
                    </div>
                }
            }

            @if (selectedTransferRequest.Lines?.Any() == true)
            {
                <div class="itx-section itx-section-gap" style="justify-content:space-between;">
                    <span style="display:inline-flex;align-items:center;gap:.4rem;">
                        <i class="bi bi-list-check"></i> Request Lines (@selectedTransferRequest.Lines.Count)
                    </span>
                    @if (!isEditingRequestLines && CanEditRequestLines(selectedTransferRequest))
                    {
                        <button type="button" class="itx-btn itx-btn-sm" @onclick="BeginEditRequestLines">
                            <i class="bi bi-pencil"></i> Edit request
                        </button>
                    }
                </div>

                @if (isEditingRequestLines)
                {
                    <div class="itx-toolbar" style="margin-bottom:.6rem;">
                        <div class="itx-grow itx-field">
                            <label for="itx-edit-from-warehouse">From warehouse</label>
                            <div class="itx-select">
                                <select id="itx-edit-from-warehouse" class="itx-input"
                                        @bind="requestEditFromWarehouse">
                                    @foreach (var warehouseCode in SelectableWarehouseCodes(requestEditOriginalFromWarehouse))
                                    {
                                        <option value="@warehouseCode">@WarehouseLabel(warehouseCode)</option>
                                    }
                                </select>
                                <span class="itx-caret" aria-hidden="true"></span>
                            </div>
                        </div>
                        <div class="itx-grow itx-field">
                            <label for="itx-edit-to-warehouse">To warehouse</label>
                            <div class="itx-select">
                                <select id="itx-edit-to-warehouse" class="itx-input"
                                        @bind="requestEditToWarehouse">
                                    @foreach (var warehouseCode in SelectableWarehouseCodes(requestEditOriginalToWarehouse))
                                    {
                                        <option value="@warehouseCode">@WarehouseLabel(warehouseCode)</option>
                                    }
                                </select>
                                <span class="itx-caret" aria-hidden="true"></span>
                            </div>
                        </div>
                    </div>
                    @if (IsWarehouseScopedRole(currentUserRole))
                    {
                        <div class="itx-note" style="margin:0 0 .6rem;">
                            <i class="bi bi-info-circle"></i>
                            You can only move this request onto your own warehouses
                            (@string.Join(", ", assignedWarehouseCodes.OrderBy(code => code)));
                            its current warehouses are listed so you can leave them as they are.
                        </div>
                    }

                    <div class="itx-lines-wrap">
                        <table class="itx-lines">
                            <thead>
                                <tr>
                                    <th>#</th>
                                    <th>Item</th>
                                    <th class="num">Original</th>
                                    <th class="num">Quantity</th>
                                    <th style="width:60px;"></th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var line in requestEditLines)
                                {
                                    <tr class="@(line.Removed ? "is-removed" : null)">
                                        <td>@line.LineNum</td>
                                        <td>
                                            <div class="strong">@line.ItemCode</div>
                                            <div class="muted">@line.ItemDescription</div>
                                        </td>
                                        <td class="num muted">@QuantityDisplay.Format(line.OriginalQuantity, line.UoMCode)</td>
                                        <td class="num">
                                            @if (line.Removed)
                                            {
                                                <span class="itx-status rejected">Removed</span>
                                            }
                                            else
                                            {
                                                <input type="number" step="any" min="0"
                                                       class="itx-input itx-input-num itx-qty-input"
                                                       value="@line.Quantity"
                                                       @oninput="e => SetRequestEditQuantity(line, e.Value?.ToString())" />
                                            }
                                        </td>
                                        <td class="mid">
                                            <button type="button" class="itx-btn itx-btn-sm itx-btn-icon @(line.Removed ? null : "itx-btn-danger")"
                                                    title="@(line.Removed ? "Keep this line" : "Remove this line")"
                                                    aria-label="@(line.Removed ? "Keep this line" : "Remove this line")"
                                                    @onclick="() => ToggleRequestEditLineRemoval(line)">
                                                @if (line.Removed)
                                                {
                                                    @UndoGlyph
                                                }
                                                else
                                                {
                                                    @TrashGlyph
                                                }
                                            </button>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                            <tfoot>
                                <tr>
                                    <td colspan="3" class="num">Total</td>
                                    <td class="num">@QuantityDisplay.Format(requestEditLines.Where(l => !l.Removed).Sum(l => l.Quantity))</td>
                                    <td></td>
                                </tr>
                            </tfoot>
                        </table>
                    </div>

                    @if (!CanActOnRequestSource(selectedTransferRequest))
                    {
                        <div class="itx-alert warn" style="margin-top:.6rem;">
                            <i class="bi bi-info-circle-fill"></i>
                            <div class="itx-alert-body">
                                @selectedTransferRequest.FromWarehouse is not one of your assigned warehouses,
                                so this change will be sent for approval rather than written to SAP.
                            </div>
                        </div>
                        <label class="itx-label" for="itx-edit-reason">Reason for the change</label>
                        <textarea id="itx-edit-reason" class="itx-input" rows="2"
                                  placeholder="Tell the approver why these lines should change"
                                  value="@requestEditReason"
                                  @oninput="e => requestEditReason = e.Value?.ToString()"></textarea>
                    }

                    <div class="itx-actions">
                        <button type="button" class="itx-btn itx-btn-primary" disabled="@isSavingRequestEdit"
                                @onclick="SaveRequestEditAsync">
                            <i class="bi bi-save"></i> @(CanActOnRequestSource(selectedTransferRequest) ? "Save changes" : "Send for approval")
                        </button>
                        <button type="button" class="itx-btn" disabled="@isSavingRequestEdit"
                                @onclick="CancelEditRequestLines">
                            Cancel
                        </button>
                    </div>
                }
                else
                {
                    <div class="itx-lines-wrap">
                        <table class="itx-lines">
                            <thead>
                                <tr>
                                    <th>#</th>
                                    <th>Item</th>
                                    <th>From</th>
                                    <th>To</th>
                                    <th class="num">Qty</th>
                                    <th>UoM</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var line in selectedTransferRequest.Lines)
                                {
                                    <tr>
                                        <td>@line.LineNum</td>
                                        <td>
                                            <div class="strong">@line.ItemCode</div>
                                            <div class="muted">@line.ItemDescription</div>
                                        </td>
                                        <td><span class="itx-wh src">@line.FromWarehouseCode</span></td>
                                        <td><span class="itx-wh dst">@line.ToWarehouseCode</span></td>
                                        <td class="num">@QuantityDisplay.Format(line.Quantity, line.UoMCode)</td>
                                        <td class="muted">@line.UoMCode</td>
                                    </tr>
                                }
                            </tbody>
                            <tfoot>
                                <tr>
                                    <td colspan="4" class="num">Total</td>
                                    <td class="num">@QuantityDisplay.Format(selectedTransferRequest.Lines.Sum(l => l.Quantity))</td>
                                    <td></td>
                                </tr>
                            </tfoot>
                        </table>
                    </div>
                }
            }
        </div>
        <div class="itx-drawer-foot">
            @if (ShowsRequestConversionAction(selectedTransferRequest))
            {
                var canConvert = CanCurrentUserConvertRequest(selectedTransferRequest);
                var requiresApproval = IsWarehouseScopedRole(currentUserRole);
                <span class="itx-note">
                    <i class="bi bi-info-circle"></i>
                    @RequestConversionActionNote(selectedTransferRequest)
                </span>
                <button type="button" class="itx-btn itx-btn-primary"
                        disabled="@(isConverting || isRejecting || !canConvert)"
                        @onclick="() => ConvertRequest(selectedTransferRequest)">
                    <i class="bi @(requiresApproval ? "bi-send-check" : "bi-box-arrow-in-down")"></i>
                    @(requiresApproval ? "Submit for Approval" : "Convert to Transfer")
                </button>
                @if (selectedTransferRequest.ApprovalStages.Count == 0)
                {
                    <button type="button" class="itx-btn itx-btn-danger"
                            disabled="@(isConverting || isRejecting || !canConvert)"
                            title="Close the request in SAP without generating a transfer"
                            @onclick="() => RejectRequest(selectedTransferRequest)">
                        <i class="bi bi-x-circle"></i> Close in SAP
                    </button>
                }
            }
            <button type="button" class="itx-btn" @onclick="CloseRequestModal">Close</button>
        </div>
    </div>
}

@code {
    // ── Tab state ───────────────────────────────────────
    private int activeTabIndex = 0;

    // ── Paging inside the loaded list ───────────────────
    // The tables are plain HTML, so the page window is ours to cut: the row
    // properties below slice the sorted, filtered list rather than handing the
    // whole thing to a table component.
    private static readonly int[] PageSizeOptions = [10, 25, 50, 100, 200];
    private int _pageSize = 10;
    private int transferPage = 1;
    private int requestListPage = 1;
    private int pendingListPage = 1;

    // ── Completed transfers ─────────────────────────────
    private List<InventoryTransferDto>? transfers;
    private InventoryTransferDto? selectedTransfer;
    private bool isLoading = false;
    private bool isPrinting = false;
    private string? errorMessage;
    private string? successMessage;
    private int currentPage = 1;
    private int pageSize = 20;
    private int totalCount = 0;

    // ── Transfer requests ───────────────────────────────
    private List<InventoryTransferRequestDto>? transferRequests;
    private string? requestLoadError;
    private InventoryTransferRequestDto? selectedTransferRequest;
    private bool isLoadingRequests = false;
    private bool isConverting = false;
    private bool isRejecting = false;
    private Guid? currentUserId;
    private string? currentUserRole;
    private HashSet<string> assignedWarehouseCodes = new(StringComparer.OrdinalIgnoreCase);
    private readonly Dictionary<Guid, string?> decisionRemarks = [];
    private const int transferRequestBatchSize = 100;
    private int transferRequestCount = 0;
    private int requestPage = 1;
    private bool hasMoreRequests = false;

    // Sent to the API, which filters in SAP. Open is the default: this tab exists to action
    // requests, and all but a few thousand of the eleven thousand in SAP are closed.
    private const string OpenRequestsFilter = "open";
    private const string ClosedRequestsFilter = "closed";
    private const string AllRequestsFilter = "all";
    private string requestDocumentStatus = OpenRequestsFilter;

    // ── Direct transfers held for approval ──────────────
    private List<PendingInventoryTransferDto>? pendingTransfers;
    private PendingInventoryTransferDto? selectedPendingTransfer;
    private bool isLoadingPending = false;
    private bool isLoadingPendingDetail = false;
    private bool isDecidingPending = false;
    private int pendingTransferCount = 0;
    private string pendingStatusFilter = PendingTransferStatuses.AwaitingApproval;
    private string? pendingDecisionRemarks;
    private const string ApprovedDecision = "Approved";
    private const string RejectedDecision = "NotApproved";

    // Item names for the lines of drafts opened this session, keyed by item code. The API resolves
    // descriptions from its own item table, which no sync populates, so in practice it returns the
    // code alone and the name has to come from the web app's product cache.
    private readonly Dictionary<string, string> pendingLineItemNames = new(StringComparer.OrdinalIgnoreCase);

    // ── Editing a transfer request ──────────────────────
    private static readonly string[] RequestEditorRoles =
        [UserRoles.Admin, UserRoles.StockController, UserRoles.DepotController, UserRoles.Manager];
    // Mirrors [Authorize] on POST api/inventorytransfer/request/{docEntry}/convert. Managers may
    // edit a request but not convert one, so this is deliberately not RequestEditorRoles.
    private static readonly string[] RequestConverterRoles =
        [UserRoles.Admin, UserRoles.StockController, UserRoles.DepotController];
    private bool isEditingRequestLines = false;
    private bool isSavingRequestEdit = false;
    private bool isDecidingRequestEdit = false;
    private List<RequestEditLineModel> requestEditLines = [];
    private string requestEditFromWarehouse = string.Empty;
    private string requestEditToWarehouse = string.Empty;
    private string requestEditOriginalFromWarehouse = string.Empty;
    private string requestEditOriginalToWarehouse = string.Empty;
    private string? requestEditReason;
    private string? requestEditDecisionRemarks;
    private PendingTransferRequestEditDto? heldEditForSelectedRequest;
    private const string PendingStageStatus = "Pending";
    private const string AllStatusFilter = "all";

    // ── Warehouse picker ────────────────────────────────
    // The design draws a plain select, so the warehouse is held as its code
    // rather than as the DTO an autocomplete would have bound to.
    private bool isLoadingWarehouses = true;
    private List<WarehouseDto> cachedWarehouses = new();
    private string selectedWarehouseCode = string.Empty;

    private DateTime? fromDate;
    private DateTime? toDate;

    // ── Quick filter ────────────────────────────────────
    private string? _transferSearchString;
    private string? _requestSearchString;
    private string? _requestFromWarehouseFilter;
    private string? _requestToWarehouseFilter;
    private string? _requestStatusFilter;
    private string? _requestRequesterFilter;
    private DateTime? requestFromDate;
    private DateTime? requestToDate;

    // Search + status stay in the toolbar; the rest live behind the "Filters" toggle.
    private bool showRequestFilters = false;

    private bool _hasLoadedData = false;

    // ── Filtered collections ────────────────────────────
    private IEnumerable<InventoryTransferDto> FilteredTransfers =>
    transfers?.Where(_transferQuickFilter) ?? Enumerable.Empty<InventoryTransferDto>();

    private IEnumerable<InventoryTransferRequestDto> FilteredRequests =>
    transferRequests?.Where(_requestQuickFilter) ?? Enumerable.Empty<InventoryTransferRequestDto>();

    private int FilteredRequestCount => FilteredRequests.Count();

    private int FilteredTransferCount => FilteredTransfers.Count();

    // ── Page windows ────────────────────────────────────
    // The current page is derived rather than stored, so a filter that shrinks
    // the list below the page the user was on cannot leave the table blank.
    private static int PageCountFor(int rows, int size) => size <= 0 ? 1 : Math.Max(1, (rows + size - 1) / size);

    private static IEnumerable<T> PageWindow<T>(IEnumerable<T> rows, int page, int size)
        => size <= 0 ? rows : rows.Skip((page - 1) * size).Take(size);

    private int TransferPageCount => PageCountFor(FilteredTransferCount, _pageSize);
    private int TransferPage => Math.Clamp(transferPage, 1, TransferPageCount);

    private IEnumerable<InventoryTransferDto> TransferPageRows =>
        PageWindow(SortedTransfers.Where(_transferQuickFilter), TransferPage, _pageSize);

    private int RequestListPageCount => PageCountFor(FilteredRequestCount, _pageSize);
    private int RequestListPage => Math.Clamp(requestListPage, 1, RequestListPageCount);

    private IEnumerable<InventoryTransferRequestDto> RequestPageRows =>
        PageWindow(SortedRequests.Where(_requestQuickFilter), RequestListPage, _pageSize);

    private int PendingListPageCount => PageCountFor(pendingTransfers?.Count ?? 0, _pageSize);
    private int PendingListPage => Math.Clamp(pendingListPage, 1, PendingListPageCount);

    private IEnumerable<PendingInventoryTransferDto> PendingPageRows =>
        PageWindow(pendingTransfers ?? Enumerable.Empty<PendingInventoryTransferDto>(), PendingListPage, _pageSize);

    /// <summary>Sends every list back to its first page — used whenever a filter changes.</summary>
    private void ResetPaging()
    {
        transferPage = 1;
        requestListPage = 1;
        pendingListPage = 1;
    }

    // ── Sorting ─────────────────────────────────────────
    // The headings sort the list themselves, and the footer names the current sort in words,
    // so the key and direction have to live somewhere both can read.
    private const string SortKeyDoc = "doc";
    private const string SortKeyDate = "date";
    private const string SortKeyItems = "items";

    private string _transferSortKey = SortKeyDate;
    private int _transferSortDir = -1;
    private string _requestSortKey = SortKeyDate;
    private int _requestSortDir = -1;

    private IEnumerable<InventoryTransferDto> SortedTransfers =>
        SortRows(transfers, _transferSortKey, _transferSortDir,
                 x => x.DocNum, x => ParseDate(x.DocDate), x => x.Lines?.Count ?? 0);

    private IEnumerable<InventoryTransferRequestDto> SortedRequests =>
        SortRows(transferRequests, _requestSortKey, _requestSortDir,
                 x => x.DocNum, x => ParseDate(x.DocDate), x => x.Lines?.Count ?? 0);

    private static IEnumerable<T> SortRows<T>(List<T>? source, string key, int direction,
        Func<T, int> byDoc, Func<T, DateTime> byDate, Func<T, int> byItems)
    {
        if (source == null) return Enumerable.Empty<T>();

        return key switch
        {
            SortKeyDoc => direction == 1 ? source.OrderBy(byDoc) : source.OrderByDescending(byDoc),
            SortKeyItems => direction == 1 ? source.OrderBy(byItems) : source.OrderByDescending(byItems),
            _ => direction == 1 ? source.OrderBy(byDate) : source.OrderByDescending(byDate)
        };
    }

    // Clicking the heading that is already sorting flips the direction; any other starts descending.
    private void SortTransfers(string key)
    {
        _transferSortDir = _transferSortKey == key ? -_transferSortDir : -1;
        _transferSortKey = key;
    }

    private void SortRequests(string key)
    {
        _requestSortDir = _requestSortKey == key ? -_requestSortDir : -1;
        _requestSortKey = key;
    }

    private static string SortArrow(string activeKey, int direction, string key)
        => activeKey == key ? (direction == 1 ? "↑" : "↓") : string.Empty;

    private string TransferSortArrow(string key) => SortArrow(_transferSortKey, _transferSortDir, key);

    private string RequestSortArrow(string key) => SortArrow(_requestSortKey, _requestSortDir, key);

    private static string SortLabel(string key, int direction)
        => (key switch { SortKeyDoc => "doc #", SortKeyItems => "items", _ => "date" }) +
           (direction == 1 ? ", ascending" : ", descending");

    private string TransferSortLabel => SortLabel(_transferSortKey, _transferSortDir);

    private string RequestSortLabel => SortLabel(_requestSortKey, _requestSortDir);

    private static DateTime ParseDate(string? value)
        => DateTime.TryParse(value, out var parsed) ? parsed : DateTime.MinValue;

    // ── Row presentation ────────────────────────────────
    // The row whose drawer is open carries the accent edge, so the two read as one thing.
    private static string RowClass(bool isOpen) => isOpen ? "itx-row-click itx-row-open" : "itx-row-click";

    // ── Inline glyphs ───────────────────────────────────
    // Icon-only controls draw their glyph here rather than from the icon font:
    // the glyph is the whole label, so a font that fails to load would leave the
    // control reading as dead. Phosphor's 256-unit grid, to match the app.
    private RenderFragment CloseGlyph => @<svg viewBox="0 0 256 256" aria-hidden="true" focusable="false" fill="currentColor">
        <path d="M205.66,194.34a8,8,0,0,1-11.32,11.32L128,139.31,61.66,205.66a8,8,0,0,1-11.32-11.32L116.69,128,50.34,61.66A8,8,0,0,1,61.66,50.34L128,116.69l66.34-66.35a8,8,0,0,1,11.32,11.32L139.31,128Z" />
    </svg>;

    private RenderFragment ChevronLeftGlyph => @<svg viewBox="0 0 256 256" aria-hidden="true" focusable="false" fill="currentColor">
        <path d="M165.66,202.34a8,8,0,0,1-11.32,11.32l-80-80a8,8,0,0,1,0-11.32l80-80a8,8,0,0,1,11.32,11.32L91.31,128Z" />
    </svg>;

    private RenderFragment ChevronRightGlyph => @<svg viewBox="0 0 256 256" aria-hidden="true" focusable="false" fill="currentColor">
        <path d="M181.66,133.66l-80,80a8,8,0,0,1-11.32-11.32L164.69,128,90.34,53.66a8,8,0,0,1,11.32-11.32l80,80A8,8,0,0,1,181.66,133.66Z" />
