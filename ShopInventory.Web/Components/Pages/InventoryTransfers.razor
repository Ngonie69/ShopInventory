    // ── Summary strip ───────────────────────────────────
    private static decimal TransferUnits(InventoryTransferDto transfer)
        => transfer.Lines?.Sum(line => line.Quantity) ?? 0m;

    private static decimal RequestUnits(InventoryTransferRequestDto request)
        => request.Lines?.Sum(line => line.Quantity) ?? 0m;

    private string ScopeLabel => string.IsNullOrWhiteSpace(selectedWarehouseCode)
        ? "across all sites"
        : $"in {selectedWarehouseCode}";

    private string RangeLabel => (fromDate, toDate) switch
    {
        ({ } from, { } to) => $"{from:dd MMM yyyy} – {to:dd MMM yyyy}",
        ({ } from, null) => $"From {from:dd MMM yyyy}",
        (null, { } to) => $"Up to {to:dd MMM yyyy}",
        _ => "All dates"
    };

    private static string FormatPendingScope(string filter) => filter switch
    {
        PendingTransferStatuses.AwaitingApproval => "Awaiting approval",
        PendingTransferStatuses.Approved => "Approved — not posted",
        PendingTransferStatuses.Posted => "Posted to SAP",
        PendingTransferStatuses.PostFailed => "Failed to post",
        PendingTransferStatuses.Rejected => "Rejected",
        PendingTransferStatuses.Cancelled => "Withdrawn",
        _ => "All statuses"
    };

    /// <summary>The destination's full name, so a bare warehouse code is not the only label on the route.</summary>
    private string WarehouseName(string? code)
    {
        if (string.IsNullOrWhiteSpace(code)) return string.Empty;
        return cachedWarehouses?.FirstOrDefault(warehouse =>
            string.Equals(warehouse.WarehouseCode, code, StringComparison.OrdinalIgnoreCase))?.WarehouseName
            ?? string.Empty;
    }

    /// <summary>
    /// A document the warehouse has run past: the due date is behind us and SAP still has it open.
    /// A closed document is done with, however late it was, so it is never flagged.
    /// </summary>
    private static bool IsPastDue(string? dueDate, string? documentStatus)
    {
        if (!DateTime.TryParse(dueDate, out var due)) return false;

        var isOpen = string.IsNullOrWhiteSpace(documentStatus) ||
                     documentStatus.Equals("bost_Open", StringComparison.OrdinalIgnoreCase) ||
                     documentStatus.Equals("open", StringComparison.OrdinalIgnoreCase);

        return isOpen && due.Date < DateTime.Today;
    }

    // ── CSV export ──────────────────────────────────────
    /// <summary>
    /// Writes out what the open tab is showing — the current filters and sort, not the whole
    /// SAP page behind them, so the file matches what the user is looking at.
    /// </summary>
    private async Task ExportCurrentTabCsv()
    {
        try
        {
            var stamp = DateTime.Now.ToString("yyyyMMdd_HHmm");
            var (fileName, csv, rowCount) = activeTabIndex switch
            {
                1 => ($"Transfer_Requests_{stamp}.csv", BuildRequestsCsv(), FilteredRequestCount),
                2 => ($"Draft_Transfers_{stamp}.csv", BuildPendingCsv(), pendingTransfers?.Count ?? 0),
                _ => ($"Inventory_Transfers_{stamp}.csv", BuildTransfersCsv(), FilteredTransferCount)
            };

            // The preamble is what makes Excel read the file as UTF-8 rather than the local codepage.
            var bytes = Encoding.UTF8.GetPreamble().Concat(Encoding.UTF8.GetBytes(csv)).ToArray();
            await JS.InvokeVoidAsync("downloadFile", fileName, "text/csv;charset=utf-8",
                Convert.ToBase64String(bytes));
            await AuditService.LogAsync(AuditActions.ViewTransfers, "InventoryTransfer", null,
                $"Exported {rowCount:N0} row(s) to {fileName}.", true);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to export the transfers list to CSV");
            errorMessage = "Failed to export the list to CSV.";
        }
    }

    private string BuildTransfersCsv()
    {
        var csv = new StringBuilder("Doc #,Doc entry,From,To,Destination,Raised,Due,Lines,Units,Comments\n");
        foreach (var row in SortedTransfers.Where(_transferQuickFilter))
        {
            csv.Append(Csv(row.DocNum.ToString())).Append(',')
               .Append(Csv(row.DocEntry.ToString())).Append(',')
               .Append(Csv(row.FromWarehouse)).Append(',')
               .Append(Csv(row.ToWarehouse)).Append(',')
               .Append(Csv(WarehouseName(row.ToWarehouse))).Append(',')
               .Append(Csv(FormatDate(row.DocDate))).Append(',')
               .Append(Csv(FormatDate(row.DueDate))).Append(',')
               .Append(Csv((row.Lines?.Count ?? 0).ToString())).Append(',')
               .Append(Csv(QuantityDisplay.Format(TransferUnits(row)))).Append(',')
               .Append(Csv(row.Comments)).Append('\n');
        }
        return csv.ToString();
    }

    private string BuildRequestsCsv()
    {
        var csv = new StringBuilder("Doc #,Doc entry,From,To,Destination,Status,Raised,Due,Past due,Requester,Lines,Units\n");
        foreach (var row in SortedRequests.Where(_requestQuickFilter))
        {
            csv.Append(Csv(row.DocNum.ToString())).Append(',')
               .Append(Csv(row.DocEntry.ToString())).Append(',')
               .Append(Csv(row.FromWarehouse)).Append(',')
               .Append(Csv(row.ToWarehouse)).Append(',')
               .Append(Csv(WarehouseName(row.ToWarehouse))).Append(',')
               .Append(Csv(GetApprovalDisplayStatus(row))).Append(',')
               .Append(Csv(FormatDate(row.DocDate))).Append(',')
               .Append(Csv(FormatDate(row.DueDate))).Append(',')
               .Append(Csv(IsPastDue(row.DueDate, row.DocumentStatus) ? "Yes" : "No")).Append(',')
               .Append(Csv(row.RequesterName)).Append(',')
               .Append(Csv((row.Lines?.Count ?? 0).ToString())).Append(',')
               .Append(Csv(QuantityDisplay.Format(RequestUnits(row)))).Append('\n');
        }
        return csv.ToString();
    }

    private string BuildPendingCsv()
    {
        var csv = new StringBuilder("Draft #,From,To,Destination,Status,Submitted,Awaiting,Requested by,Lines\n");
        foreach (var row in pendingTransfers ?? [])
        {
            csv.Append(Csv(DraftReference(row))).Append(',')
               .Append(Csv(row.FromWarehouse)).Append(',')
               .Append(Csv(row.ToWarehouse)).Append(',')
               .Append(Csv(WarehouseName(row.ToWarehouse))).Append(',')
               .Append(Csv(FormatPendingStatus(row))).Append(',')
               .Append(Csv(row.CreatedAtUtc.ToLocalTime().ToString("dd MMM yyyy HH:mm"))).Append(',')
               .Append(Csv(PendingStageNames(row))).Append(',')
               .Append(Csv(row.CreatedByName)).Append(',')
               .Append(Csv(row.LineCount.ToString())).Append('\n');
        }
        return csv.ToString();
    }

    private static string Csv(string? value)
    {
        if (string.IsNullOrEmpty(value)) return string.Empty;
        return value.Contains(',') || value.Contains('"') || value.Contains('\n') || value.Contains('\r')
            ? $"\"{value.Replace("\"", "\"\"")}\""
            : value;
    }

    private bool HasActiveRequestFilters =>
        !string.IsNullOrWhiteSpace(_requestSearchString) ||
        !string.IsNullOrWhiteSpace(_requestFromWarehouseFilter) ||
        !string.IsNullOrWhiteSpace(_requestToWarehouseFilter) ||
        !string.IsNullOrWhiteSpace(_requestStatusFilter) ||
        !string.IsNullOrWhiteSpace(_requestRequesterFilter) ||
        requestFromDate.HasValue ||
        requestToDate.HasValue;

    // Only the filters hidden behind the toggle — search and status are always visible,
    // so counting them would double-report what the user can already see.
    private int ExtraRequestFilterCount =>
        (string.IsNullOrWhiteSpace(_requestFromWarehouseFilter) ? 0 : 1) +
        (string.IsNullOrWhiteSpace(_requestToWarehouseFilter) ? 0 : 1) +
        (string.IsNullOrWhiteSpace(_requestRequesterFilter) ? 0 : 1) +
        (requestFromDate.HasValue ? 1 : 0) +
        (requestToDate.HasValue ? 1 : 0);

    // ── Dropdown option lists ───────────────────────────
    // The controls are NocturneSelect, so each list is built here rather than
    // as <option>s. The three that read off the loaded requests are computed;
    // the two fixed lists are static. "open"/"all" are sentinels, not empty
    // strings, so those rows carry IsUnset where they mean "no filter".
