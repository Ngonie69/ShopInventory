    // ── Quick filters ───────────────────────────────────
    private Func<InventoryTransferDto, bool> _transferQuickFilter => x =>
    {
        if (string.IsNullOrWhiteSpace(_transferSearchString)) return true;
        if (x.DocNum.ToString().Contains(_transferSearchString, StringComparison.OrdinalIgnoreCase)) return true;
        if (x.DocEntry.ToString().Contains(_transferSearchString, StringComparison.OrdinalIgnoreCase)) return true;
        if (x.FromWarehouse?.Contains(_transferSearchString, StringComparison.OrdinalIgnoreCase) == true) return true;
        if (x.ToWarehouse?.Contains(_transferSearchString, StringComparison.OrdinalIgnoreCase) == true) return true;
        if (x.Comments?.Contains(_transferSearchString, StringComparison.OrdinalIgnoreCase) == true) return true;
        return false;
    };

    private Func<InventoryTransferRequestDto, bool> _requestQuickFilter => x =>
    {
        if (!MatchesFilterValue(x.FromWarehouse, _requestFromWarehouseFilter)) return false;
        if (!MatchesFilterValue(x.ToWarehouse, _requestToWarehouseFilter)) return false;

        if (!string.IsNullOrWhiteSpace(_requestStatusFilter) &&
            !string.Equals(GetApprovalDisplayStatus(x), _requestStatusFilter, StringComparison.OrdinalIgnoreCase))
        {
            return false;
        }

        if (!string.IsNullOrWhiteSpace(_requestRequesterFilter) &&
            !(x.RequesterName?.Contains(_requestRequesterFilter, StringComparison.OrdinalIgnoreCase) == true ||
              x.RequesterEmail?.Contains(_requestRequesterFilter, StringComparison.OrdinalIgnoreCase) == true))
        {
            return false;
        }

        if (!MatchesDateRange(x.DocDate, requestFromDate, requestToDate)) return false;

        if (string.IsNullOrWhiteSpace(_requestSearchString)) return true;
        if (x.DocNum.ToString().Contains(_requestSearchString, StringComparison.OrdinalIgnoreCase)) return true;
        if (x.DocEntry.ToString().Contains(_requestSearchString, StringComparison.OrdinalIgnoreCase)) return true;
        if (x.FromWarehouse?.Contains(_requestSearchString, StringComparison.OrdinalIgnoreCase) == true) return true;
        if (x.ToWarehouse?.Contains(_requestSearchString, StringComparison.OrdinalIgnoreCase) == true) return true;
        if (x.RequesterName?.Contains(_requestSearchString, StringComparison.OrdinalIgnoreCase) == true) return true;
        if (x.RequesterEmail?.Contains(_requestSearchString, StringComparison.OrdinalIgnoreCase) == true) return true;
        if (x.DocumentStatus?.Contains(_requestSearchString, StringComparison.OrdinalIgnoreCase) == true) return true;
        if (x.ApprovalStatus?.Contains(_requestSearchString, StringComparison.OrdinalIgnoreCase) == true) return true;
        if (GetApprovalDisplayStatus(x).Contains(_requestSearchString, StringComparison.OrdinalIgnoreCase)) return true;
        if (x.Comments?.Contains(_requestSearchString, StringComparison.OrdinalIgnoreCase) == true) return true;
        return false;
    };

    // ── Lifecycle ───────────────────────────────────────
    protected override void OnInitialized()
    {
        _pageSize = AppSettings.PageSize;
        pageSize = AppSettings.PageSize;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && !_hasLoadedData)
        {
            _hasLoadedData = true;
            await LoadApprovalContextAsync();
            if (TryGetRequestedDocumentEntry(out var requestedDocEntry))
            {
                activeTabIndex = 1;
                await LoadTransferRequestsAsync();
                selectedTransferRequest = await TransferService.GetTransferRequestByDocEntryAsync(requestedDocEntry)
                    ?? transferRequests?.FirstOrDefault(request => request.DocEntry == requestedDocEntry);
            }
            else if (TryGetRequestedPendingTransferId(out var requestedPendingId))
            {
                activeTabIndex = 2;
                await LoadPendingTransfersAsync();
                // Fetched by id rather than picked out of the list just loaded: that list is
                // filtered to what is still awaiting approval, and an approval notification is as
                // likely to be about one that has since been decided or posted.
                var pending = await TransferService.GetPendingTransferAsync(requestedPendingId);
                if (pending != null)
                {
                    selectedPendingTransfer = pending;
                    await LoadPendingLineItemNamesAsync(pending);
                }
            }
            // Only load warehouses on first render (fast, cached).
            // Transfer requests are deferred until the user switches to that tab.
            await LoadWarehousesAsync();
            await AuditService.LogAsync(AuditActions.ViewTransfers, "InventoryTransfer", null);
            StateHasChanged();
        }
    }

    private async Task LoadApprovalContextAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var userIdValue = authState.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
        currentUserId = Guid.TryParse(userIdValue, out var parsedUserId) ? parsedUserId : null;
        currentUserRole = authState.User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value;
        assignedWarehouseCodes = authState.User.FindAll("warehouse")
            .Select(claim => claim.Value)
            .Where(value => !string.IsNullOrWhiteSpace(value))
            .ToHashSet(StringComparer.OrdinalIgnoreCase);
    }

    private bool TryGetRequestedDocumentEntry(out int docEntry)
    {
        docEntry = 0;
        var query = QueryHelpers.ParseQuery(Navigation.ToAbsoluteUri(Navigation.Uri).Query);
        return query.TryGetValue("requestDocEntry", out var value) && int.TryParse(value.FirstOrDefault(), out docEntry);
    }

    /// The other half of the same deep link: a transfer approval notification points here with the
    /// document it is about, and a direct transfer is named by the id of the draft held for approval.
    private bool TryGetRequestedPendingTransferId(out Guid pendingTransferId)
    {
        pendingTransferId = Guid.Empty;
        var query = QueryHelpers.ParseQuery(Navigation.ToAbsoluteUri(Navigation.Uri).Query);
        return query.TryGetValue("pendingTransferId", out var value) && Guid.TryParse(value.FirstOrDefault(), out pendingTransferId);
    }

    private async Task LoadWarehousesAsync()
    {
        try
        {
            isLoadingWarehouses = true;
            cachedWarehouses = await CacheService.GetWarehousesAsync();
            Logger.LogInformation("Loaded {Count} warehouses", cachedWarehouses?.Count ?? 0);
            if (cachedWarehouses != null)
            {
                // A warehouse-scoped user does not run "01", so opening on it shows them an empty
                // list that reads as "there are no transfers" rather than "wrong warehouse".
                var defaultWarehouse = cachedWarehouses.FirstOrDefault(w =>
                                           w.WarehouseCode != null && assignedWarehouseCodes.Contains(w.WarehouseCode))
                                       ?? cachedWarehouses.FirstOrDefault(w => w.WarehouseCode == "01");
                if (defaultWarehouse?.WarehouseCode != null)
                    selectedWarehouseCode = defaultWarehouse.WarehouseCode;
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to load warehouses");
            errorMessage = $"Failed to load warehouses: {ex.Message}";
        }
        finally
        {
            isLoadingWarehouses = false;
        }
    }

    private string FormatDate(string? dateString)
    {
        if (string.IsNullOrEmpty(dateString)) return "—";
        return DateTime.TryParse(dateString, out var date) ? date.ToString("dd MMM yyyy") : dateString;
    }

    // ── Tab switching ───────────────────────────────────
    private async Task SwitchTab(int index)
    {
        activeTabIndex = index;
        if (index == 1 && transferRequests == null)
            await LoadTransferRequestsAsync();
        else if (index == 2 && pendingTransfers == null)
            await LoadPendingTransfersAsync();
    }

    // ── Direct transfers held for approval ──────────────
    private async Task ChangePendingStatusFilter(string? status)
    {
        pendingStatusFilter = string.IsNullOrWhiteSpace(status) ? AllStatusFilter : status;
        await LoadPendingTransfersAsync();
    }

    private async Task LoadPendingTransfersAsync()
    {
        isLoadingPending = true;
        pendingListPage = 1;
        StateHasChanged();
        try
        {
            var response = await TransferService.GetPendingTransfersAsync(pendingStatusFilter, pageSize: 200);
            pendingTransfers = response?.Items ?? [];

            // The tab badge counts what is still awaiting approval. Only a result set that could
            // contain those rows can update it — filtering to, say, Posted says nothing about how
            // many are still waiting, so the last known count stands.
            if (pendingStatusFilter is PendingTransferStatuses.AwaitingApproval or AllStatusFilter)
            {
                pendingTransferCount = pendingTransfers.Count(
                    item => item.Status == PendingTransferStatuses.AwaitingApproval);
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error loading transfers awaiting approval");
            errorMessage = "Could not load transfers awaiting approval.";
            pendingTransfers = [];
        }
        finally
        {
            isLoadingPending = false;
            StateHasChanged();
        }
    }

    /// <summary>
    /// Opens the drawer on the list row, then replaces it with the full record. The list is
    /// served without line items, so the detail call is what populates the Lines table.
    /// </summary>
    private async Task ViewPendingTransfer(PendingInventoryTransferDto pending)
    {
        selectedPendingTransfer = pending;
        pendingDecisionRemarks = null;
        await RefreshSelectedPendingTransferAsync();
    }

    private async Task RefreshSelectedPendingTransferAsync()
    {
        var id = selectedPendingTransfer?.Id;
        if (id is null) return;

        isLoadingPendingDetail = true;
        StateHasChanged();
        try
        {
            var detail = await TransferService.GetPendingTransferAsync(id.Value);
            // The drawer may have been closed or switched while the call was in flight.
            if (detail != null && selectedPendingTransfer?.Id == id)
            {
                selectedPendingTransfer = detail;
                await LoadPendingLineItemNamesAsync(detail);
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to load pending transfer {PendingId}", id);
        }
        finally
        {
            isLoadingPendingDetail = false;
            StateHasChanged();
        }
    }

    /// <summary>
    /// Fills <see cref="pendingLineItemNames"/> for the draft being opened. The product cache is
    /// held statically across circuits and is normally already warm, so this costs nothing beyond
    /// a dictionary build; a cold cache reads the web app's own product table, never SAP.
    /// </summary>
    private async Task LoadPendingLineItemNamesAsync(PendingInventoryTransferDto pending)
    {
        var wanted = pending.Lines
            .Select(line => line.ItemCode)
            .Where(code => !string.IsNullOrWhiteSpace(code) && !pendingLineItemNames.ContainsKey(code!))
            .Select(code => code!)
            .ToHashSet(StringComparer.OrdinalIgnoreCase);

        if (wanted.Count == 0) return;

        try
        {
            var products = await CacheService.GetProductsAsync();
            foreach (var product in products)
            {
                if (!string.IsNullOrWhiteSpace(product.ItemCode) &&
                    !string.IsNullOrWhiteSpace(product.ItemName) &&
                    wanted.Contains(product.ItemCode))
                {
                    pendingLineItemNames[product.ItemCode] = product.ItemName;
                }
            }
        }
        catch (Exception ex)
        {
            // The code on its own is what the drawer showed before; a name is not worth failing over.
            Logger.LogWarning(ex, "Could not resolve item names for pending transfer {PendingId}", pending.Id);
        }
    }

    /// <summary>
    /// The name to show under a draft line's item code: whatever the API resolved, else the web
    /// app's product cache. Blank when neither knows the item, which leaves the bare code.
    /// </summary>
    private string? LineItemName(PendingInventoryTransferLineDto line)
    {
        if (!string.IsNullOrWhiteSpace(line.ItemDescription))
            return line.ItemDescription;

        return line.ItemCode is not null && pendingLineItemNames.TryGetValue(line.ItemCode, out var itemName)
            ? itemName
            : null;
    }

    private void ClosePendingTransfer()
    {
        selectedPendingTransfer = null;
        pendingDecisionRemarks = null;
    }

    private static string DraftReference(PendingInventoryTransferDto pending) =>
        string.IsNullOrWhiteSpace(pending.DraftNumber) ? "—" : pending.DraftNumber;

    private async Task DecidePendingTransferAsync(PendingInventoryTransferDto pending, string decision)
    {
        if (isDecidingPending) return;

        isDecidingPending = true;
        errorMessage = null;
        successMessage = null;
        StateHasChanged();
        try
        {
            var (success, message, _) = await TransferService.DecidePendingTransferAsync(
                pending.Id, decision, remarks: pendingDecisionRemarks);
            if (success)
            {
                successMessage = message;
                ClosePendingTransfer();
            }
            else
            {
                errorMessage = message;
            }

            // A decision that is recorded but fails to post to SAP comes back as an error, and
            // the draft has still moved on to Approved or Failed to post. Refresh either way so
            // what is on screen is the stored status rather than the one we submitted against.
            await ReloadAfterPendingActionAsync();
        }
        finally
        {
            isDecidingPending = false;
            StateHasChanged();
        }
    }

    /// <summary>
    /// Reloads the queue and, when the drawer is still open, the record it is showing.
    /// </summary>
    private async Task ReloadAfterPendingActionAsync()
    {
        await LoadPendingTransfersAsync();
        await RefreshSelectedPendingTransferAsync();
    }

    private async Task RetryPendingTransferAsync(PendingInventoryTransferDto pending)
    {
        if (isDecidingPending) return;

        isDecidingPending = true;
        errorMessage = null;
        successMessage = null;
        StateHasChanged();
        try
        {
            var (success, message, _) = await TransferService.RetryPendingTransferPostAsync(pending.Id);
            if (success)
            {
                successMessage = message;
                ClosePendingTransfer();
            }
            else
            {
                errorMessage = message;
            }

            await ReloadAfterPendingActionAsync();
        }
        finally
        {
            isDecidingPending = false;
            StateHasChanged();
        }
    }

    private async Task CancelPendingTransferAsync(PendingInventoryTransferDto pending)
    {
        if (isDecidingPending) return;

        isDecidingPending = true;
        errorMessage = null;
        successMessage = null;
        StateHasChanged();
        try
        {
            var (success, message) = await TransferService.CancelPendingTransferAsync(pending.Id);
            if (success)
            {
                successMessage = message;
                ClosePendingTransfer();
            }
            else
            {
                errorMessage = message;
            }

            await ReloadAfterPendingActionAsync();
        }
        finally
        {
            isDecidingPending = false;
            StateHasChanged();
        }
    }

    private static string FormatPendingStatus(PendingInventoryTransferDto pending) => pending.Status switch
    {
        PendingTransferStatuses.AwaitingApproval => "Awaiting approval",
        // Not "posting": nothing is in flight. The post runs inside the approval request, so a
        // record read back at Approved is one whose post never finished and needs running again.
        PendingTransferStatuses.Approved => "Approved — not posted",
        PendingTransferStatuses.PostFailed => "Failed to post",
        PendingTransferStatuses.Posted => $"Posted (#{pending.SapDocNum})",
        PendingTransferStatuses.Cancelled => "Withdrawn",
        _ => pending.Status
    };

    private static string PendingStageNames(PendingInventoryTransferDto pending)
    {
        var names = pending.ApprovalStages
            .Where(stage => stage.Status == PendingStageStatus)
            .Select(stage => stage.StageName)
            .ToList();
        return names.Count == 0 ? "—" : string.Join(", ", names);
    }

    // ── Load transfers ──────────────────────────────────
    private async Task LoadTransfers()
    {
        if (string.IsNullOrWhiteSpace(selectedWarehouseCode)) return;

        isLoading = true;
        errorMessage = null;
        transferPage = 1;

        try
        {
            var warehouseCode = selectedWarehouseCode;

            if (fromDate.HasValue && toDate.HasValue)
            {
                // Fetch ALL records for the date range; the footer pages through them client-side.
                var response = await TransferService.GetTransfersByDateRangeAsync(warehouseCode, fromDate.Value, toDate.Value);
                transfers = response?.Transfers;
                totalCount = response?.Count ?? transfers?.Count ?? 0;
            }
            else if (fromDate.HasValue)
            {
                var response = await TransferService.GetTransfersByDateAsync(warehouseCode, fromDate.Value);
                transfers = response?.Transfers;
                totalCount = response?.Count ?? transfers?.Count ?? 0;
            }
            else
            {
                var response = await TransferService.GetPagedTransfersAsync(warehouseCode, currentPage, pageSize);
                if (response != null)
                {
                    transfers = response.Transfers;
                    totalCount = response.TotalCount > 0 ? response.TotalCount : response.Count;
                }
                else
                {
                    transfers = null;
                    errorMessage = "Failed to load transfers — no response from server.";
                }
            }
        }
        catch (TimeoutException ex)
        {
            Logger.LogWarning(ex, "Timeout loading transfers");
            errorMessage = "Request timed out. SAP may be responding slowly — please try again.";
        }
        catch (HttpRequestException ex)
        {
            Logger.LogError(ex, "HTTP error loading transfers");
            errorMessage = $"Connection error: {ex.Message}";
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error loading transfers");
            errorMessage = $"Error: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }

