        PageSizeOptions.Select(size => new NocturneSelectOption<int>(size, size.ToString())).ToArray();

    private static readonly NocturneSelectOption<string>[] RequestDocumentOptions =
    [
        new(OpenRequestsFilter, "Open in SAP", "good"),
        new(ClosedRequestsFilter, "Closed in SAP", "neutral"),
        new(AllRequestsFilter, "All", "info")
    ];

    private static readonly NocturneSelectOption<string>[] PendingStatusOptions =
    [
        new(PendingTransferStatuses.AwaitingApproval, "Awaiting approval", "warn"),
        new(PendingTransferStatuses.Approved, "Approved — not posted", "info"),
        new(PendingTransferStatuses.Posted, "Posted to SAP", "good"),
        new(PendingTransferStatuses.PostFailed, "Failed to post", "bad"),
        new(PendingTransferStatuses.Rejected, "Rejected", "bad"),
        new(PendingTransferStatuses.Cancelled, "Withdrawn", "neutral") { RuleAfter = true },
        new(AllStatusFilter, "All", "neutral") { IsUnset = true }
    ];

