@page "/inventory-transfers"
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.WebUtilities
@using System.Text
@using ShopInventory.Web.Services
@attribute [Authorize(Roles = UserRoles.InventoryTransferRoles)]
@inject IInventoryTransferService TransferService
@inject IApprovalProcessService ApprovalProcessService
@inject IMasterDataCacheService CacheService
@inject ILogger<InventoryTransfers> Logger
@inject IAppSettingsProvider AppSettings
@inject IAuditService AuditService
@inject AuthenticationStateProvider AuthStateProvider
@inject NavigationManager Navigation
@inject IJSRuntime JS
@inject IWebHostEnvironment Env
@rendermode InteractiveServer

<PageTitle>Inventory Transfers - Shop Inventory</PageTitle>

@* The imported Nocturne design is dark; wwwroot/css/inventory-transfers.css
   (linked from App.razor) carries it and its light counterpart, and follows the
   app's theme toggle like every other page.

   Every control on this page is native HTML: the design draws plain selects,
   date inputs and a plain table, so the MudBlazor autocomplete, pickers,
   selects, table and pagination it used to be built from are gone. Icon-only
   buttons draw their glyph inline rather than from the Bootstrap icon font —
   the glyph is their whole label, so a font that fails to load would leave
   them reading as dead controls. *@

@if (isConverting || isRejecting)
{
    <div class="itx-busy">
        <div class="itx-spin" role="status" aria-label="Working"></div>
        <strong>@(isRejecting ? "Rejecting transfer request…" : "Approving transfer request…")</strong>
        <small>Please wait while the approval decision is processed</small>
    </div>
}

<div class="itx">
<div class="itx-shell">

    <!-- ── Header ─────────────────────────────────────────── -->
    <div class="itx-head">
        <div>
            <div class="itx-kicker">Warehousing</div>
            <h1>Inventory Transfers</h1>
            <p>Stock movements between warehouses, vans and bonds.</p>
        </div>
        <div class="itx-head-actions">
            <a href="/transfer-request/create" class="itx-btn">
                <i class="bi bi-file-earmark-plus"></i> New request
            </a>
            <AuthorizeView Roles="@UserRoles.InventoryTransferRoles">
                <a href="/inventory-transfer/create" class="itx-btn itx-btn-primary">
                    <i class="bi bi-plus-lg"></i> New transfer
                </a>
            </AuthorizeView>
        </div>
    </div>

    <!-- ── Alerts ─────────────────────────────────────────── -->
    @if (!string.IsNullOrEmpty(successMessage))
    {
        <div class="itx-alert ok" role="status">
            <i class="bi bi-check-circle-fill"></i>
            <div class="itx-alert-body">@successMessage</div>
            <button type="button" class="itx-btn itx-btn-quiet itx-btn-icon itx-btn-sm" title="Dismiss"
                    aria-label="Dismiss message" @onclick="() => successMessage = null">
                @CloseGlyph
            </button>
        </div>
    }
    @if (!string.IsNullOrEmpty(errorMessage))
    {
        <div class="itx-alert err" role="alert">
            <i class="bi bi-exclamation-octagon-fill"></i>
            <div class="itx-alert-body">@errorMessage</div>
            <button type="button" class="itx-btn itx-btn-quiet itx-btn-icon itx-btn-sm" title="Dismiss"
                    aria-label="Dismiss error" @onclick="() => errorMessage = null">
                @CloseGlyph
            </button>
        </div>
    }

    <!-- ── Tabs ───────────────────────────────────────────── -->
    <div class="itx-tabs">
        <button type="button" class="itx-tab @(activeTabIndex == 0 ? "active" : "")" @onclick="() => SwitchTab(0)">
            <i class="bi bi-arrow-left-right"></i>
            Completed
            @if (totalCount > 0)
            {
                <span class="itx-tab-count">@totalCount</span>
            }
        </button>
        <button type="button" class="itx-tab @(activeTabIndex == 1 ? "active" : "")" @onclick="() => SwitchTab(1)">
            <i class="bi bi-file-earmark-text"></i>
            Requests
            @if (transferRequestCount > 0)
            {
                <span class="itx-tab-count">@transferRequestCount</span>
            }
        </button>
        <button type="button" class="itx-tab @(activeTabIndex == 2 ? "active" : "")" @onclick="() => SwitchTab(2)">
            <i class="bi bi-hourglass-split"></i>
            Awaiting approval
            @* The queue the user is expected to clear keeps the accent whichever tab is open. *@
            @if (pendingTransferCount > 0)
            {
                <span class="itx-tab-count is-urgent">@pendingTransferCount</span>
            }
        </button>
    </div>

        @if (activeTabIndex == 0)
        {
            <!-- ══════ COMPLETED TRANSFERS ══════ -->
            <div class="itx-toolbar">
                <div class="itx-grow itx-field">
                    <label for="itx-warehouse">Warehouse</label>
                    @if (isLoadingWarehouses)
                    {
                        <div class="itx-loading" style="min-height:2.25rem;">
                            <span class="itx-spin itx-spin-sm"></span>
                            <span>Loading warehouses…</span>
                        </div>
                    }
                    else
                    {
                        <NocturneSelect Id="itx-warehouse" Class="nsel-block" Options="WarehouseSelectOptions"
                                        @bind-Value="selectedWarehouseCode" Caption="Warehouse"
                                        AriaLabel="Warehouse" Placeholder="Pick a warehouse…" />
                    }
                </div>

                <div class="itx-field">
                    <label for="itx-from">From</label>
                    <NocturneDateField Id="itx-from" @bind-Date="fromDate" />
                </div>
                <div class="itx-field">
                    <label for="itx-to">To</label>
                    <NocturneDateField Id="itx-to" @bind-Date="toDate" />
                </div>

                <div class="itx-grow itx-grow-sm itx-field">
                    <label for="itx-find">Find in results</label>
                    <div class="itx-search">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"
                             stroke-linecap="round" aria-hidden="true">
                            <circle cx="11" cy="11" r="6.5"></circle>
                            <path d="M16 16l4.5 4.5"></path>
                        </svg>
                        <input id="itx-find" class="itx-input" type="search" placeholder="Doc #, warehouse, comment"
                               @bind="_transferSearchString" @bind:event="oninput" />
                    </div>
                </div>

                <div class="itx-toolbar-actions">
                    <button type="button" class="itx-btn itx-btn-primary" @onclick="LoadTransfers"
                            disabled="@(string.IsNullOrWhiteSpace(selectedWarehouseCode) || isLoading)">
                        @if (isLoading)
                        {
                            <span class="itx-spin itx-spin-sm"></span>
                        }
                        else
                        {
                            <i class="bi bi-search"></i>
                        }
                        Search
                    </button>
                    <button type="button" class="itx-btn itx-btn-quiet" @onclick="ClearFilter">Clear</button>
                </div>
            </div>

            <div class="itx-panel">

            @if (isLoading)
            {
                <div class="itx-empty">
                    <div class="itx-spin" role="status" aria-label="Loading" style="margin:0 auto .8rem;"></div>
                    <p>Loading transfers…</p>
                </div>
            }
            else if (transfers?.Any() == true)
            {
                <div class="itx-summary">
                    <div class="itx-summary-item">
                        <div class="itx-summary-k">Transfers</div>
                        <div class="itx-summary-v">
                            @FilteredTransferCount
                            <span class="itx-summary-scope">@ScopeLabel</span>
                        </div>
                    </div>
                    <div class="itx-summary-item">
                        <div class="itx-summary-k">Units moved</div>
                        <div class="itx-summary-v">@QuantityDisplay.Format(FilteredTransfers.Sum(TransferUnits))</div>
                    </div>
                    <div class="itx-summary-item accent">
                        <div class="itx-summary-k">Lines</div>
                        <div class="itx-summary-v">@FilteredTransfers.Sum(x => x.Lines?.Count ?? 0)</div>
                    </div>
                    <div class="itx-summary-range">@RangeLabel</div>
                </div>
                <div class="itx-tablewrap">
                    <table class="itx-table">
                        <thead>
                            <tr>
                                <th style="width:120px;">
                                    <button type="button" class="itx-th-sort" @onclick="@(() => SortTransfers(SortKeyDoc))">
                                        Doc #<span class="itx-sort-arrow">@TransferSortArrow(SortKeyDoc)</span>
                                    </button>
                                </th>
                                <th>Route</th>
                                <th style="width:125px;">
                                    <button type="button" class="itx-th-sort" @onclick="@(() => SortTransfers(SortKeyDate))">
                                        Raised<span class="itx-sort-arrow">@TransferSortArrow(SortKeyDate)</span>
                                    </button>
                                </th>
                                <th style="width:125px;">Due</th>
                                <th class="itx-col-right" style="width:85px;">
                                    <button type="button" class="itx-th-sort" @onclick="@(() => SortTransfers(SortKeyItems))">
                                        Items<span class="itx-sort-arrow">@TransferSortArrow(SortKeyItems)</span>
                                    </button>
                                </th>
                                <th class="itx-col-right" style="width:110px;">&nbsp;</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var transfer in TransferPageRows)
                            {
                                <tr @key="transfer.DocEntry" class="@RowClass(selectedTransfer?.DocEntry == transfer.DocEntry)"
                                    @onclick="() => ViewTransfer(transfer)">
                                    <td><span class="itx-doc">#@transfer.DocNum</span></td>
                                    <td>
                                        <span class="itx-route">
                                            <span class="itx-wh src">@transfer.FromWarehouse</span>
                                            <i class="bi bi-arrow-right itx-arrow"></i>
                                            <span class="itx-wh dst">@transfer.ToWarehouse</span>
                                            <span class="itx-dest">@WarehouseName(transfer.ToWarehouse)</span>
                                        </span>
                                    </td>
                                    @* No Status column here: everything on this tab is a stock
                                       movement SAP has already taken, so the design's status
                                       would read "Posted" on every row. *@
                                    <td class="itx-num">@FormatDate(transfer.DocDate)</td>
                                    <td class="itx-num">@FormatDate(transfer.DueDate)</td>
                                    <td class="itx-col-right">
                                        <span class="itx-wh count">@(transfer.Lines?.Count ?? 0)</span>
                                    </td>
                                    <td class="itx-col-right">
                                        <span class="itx-open">Open <i class="bi bi-chevron-right"></i></span>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                @if (FilteredTransferCount == 0)
                {
                    <div class="itx-empty">
                        <i class="bi bi-funnel itx-empty-icon"></i>
                        <h6>Nothing matches those filters</h6>
                        <p>No transfers match "@_transferSearchString".</p>
                        <button type="button" class="itx-btn" @onclick="@(() => _transferSearchString = null)">
                            Clear filters
                        </button>
                    </div>
                }

                <div class="itx-foot">
                    <span>Showing @FilteredTransferCount of @totalCount · sorted by @TransferSortLabel</span>
                    <span class="itx-foot-actions">
                        <span class="itx-page-size">
                            <label for="itx-page-size-t">Show</label>
                            <NocturneSelect Id="itx-page-size-t" Class="nsel-sm" Options="PageSizeSelectOptions"
                                            @bind-Value="_pageSize" OnChanged="ResetPaging"
                                            AriaLabel="Rows per page" />
                            <span>per page</span>
                        </span>
                        <span class="itx-pager">
                            <button type="button" class="itx-btn itx-btn-sm itx-btn-icon" title="Previous page"
                                    aria-label="Previous page" disabled="@(TransferPage <= 1)"
                                    @onclick="@(() => transferPage = TransferPage - 1)">
                                @ChevronLeftGlyph
                            </button>
                            <span class="itx-page-label">Page @TransferPage / @TransferPageCount</span>
                            <button type="button" class="itx-btn itx-btn-sm itx-btn-icon" title="Next page"
                                    aria-label="Next page" disabled="@(TransferPage >= TransferPageCount)"
                                    @onclick="@(() => transferPage = TransferPage + 1)">
                                @ChevronRightGlyph
                            </button>
                        </span>
                        <button type="button" class="itx-btn itx-btn-sm" @onclick="ExportCurrentTabCsv">
                            <i class="bi bi-filetype-csv"></i> Export CSV
                        </button>
                    </span>
                </div>
            }
            else if (!string.IsNullOrWhiteSpace(selectedWarehouseCode))
            {
                <div class="itx-empty">
                    <i class="bi bi-inbox itx-empty-icon"></i>
                    <h6>Nothing matches those filters</h6>
                    <p>Nothing in <strong>@selectedWarehouseCode</strong> for this date range. Widen the date range, or pick another warehouse.</p>
                    <button type="button" class="itx-btn" @onclick="LoadTransfers">
                        <i class="bi bi-arrow-clockwise"></i> Retry
                    </button>
                </div>
            }
            else
            {
                <div class="itx-empty">
                    <i class="bi bi-search itx-empty-icon"></i>
                    <h6>Search transfers</h6>
                    <p>Pick a warehouse, then hit Search.</p>
                </div>
            }
            </div>
        }
        else if (activeTabIndex == 1)
        {
            <!-- ══════ TRANSFER REQUESTS ══════ -->
            <div class="itx-toolbar">
                <div class="itx-grow itx-field">
                    <label for="itx-req-find">Find in results</label>
                    <div class="itx-search">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"
                             stroke-linecap="round" aria-hidden="true">
                            <circle cx="11" cy="11" r="6.5"></circle>
                            <path d="M16 16l4.5 4.5"></path>
                        </svg>
                        <input id="itx-req-find" class="itx-input" type="search" placeholder="Doc #, route, requester…"
                               @bind="_requestSearchString" @bind:event="oninput" />
                    </div>
                </div>
                <div class="itx-field">
                    @* Asks SAP for this slice, unlike the approval filter which sifts what is loaded. *@
                    <label for="itx-req-docs">Documents</label>
                    <NocturneSelect TValue="string" Id="itx-req-docs" Class="nsel-block"
                                    Options="RequestDocumentOptions" Value="@requestDocumentStatus"
                                    ValueChanged="@(value => ChangeRequestDocumentStatus(value))"
                                    Disabled="isLoadingRequests" Caption="Documents" AriaLabel="Documents" />
                </div>
                <div class="itx-field">
                    <label for="itx-req-approval">Approval</label>
                    <NocturneSelect Id="itx-req-approval" Class="nsel-block" Options="RequestApprovalOptions"
                                    @bind-Value="_requestStatusFilter" OnChanged="ResetPaging"
                                    Caption="Filter by approval state" AriaLabel="Filter by approval state"
                                    Placeholder="Any approval state" />
                </div>

                <div class="itx-toolbar-actions">
                    <button type="button" class="itx-btn @(showRequestFilters || ExtraRequestFilterCount > 0 ? "is-on" : "")"
                            @onclick="() => showRequestFilters = !showRequestFilters">
                        <i class="bi bi-sliders"></i> Filters
                        @if (ExtraRequestFilterCount > 0)
                        {
                            <span class="itx-btn-count">@ExtraRequestFilterCount</span>
                        }
                    </button>
                    <button type="button" class="itx-btn itx-btn-icon" title="Reload transfer requests"
                            aria-label="Reload transfer requests" @onclick="RefreshTransferRequests"
                            disabled="@isLoadingRequests">
                        <i class="bi bi-arrow-clockwise"></i>
                    </button>
                </div>
            </div>

            @if (showRequestFilters)
            {
                <div class="itx-filters">
                    <div class="itx-field">
                        <label for="itx-req-from-wh">From warehouse</label>
                        <NocturneSelect Id="itx-req-from-wh" Class="nsel-block" Options="RequestFromWarehouseSelectOptions"
                                        @bind-Value="_requestFromWarehouseFilter" OnChanged="ResetPaging"
                                        Caption="Filter by source" AriaLabel="Filter by source warehouse"
                                        Placeholder="Any source" />
                    </div>
                    <div class="itx-field">
                        <label for="itx-req-to-wh">To warehouse</label>
                        <NocturneSelect Id="itx-req-to-wh" Class="nsel-block" Options="RequestToWarehouseSelectOptions"
                                        @bind-Value="_requestToWarehouseFilter" OnChanged="ResetPaging"
                                        Caption="Filter by destination" AriaLabel="Filter by destination warehouse"
                                        Placeholder="Any destination" />
                    </div>
                    <div class="itx-field">
                        <label for="itx-req-requester">Requester</label>
                        <input id="itx-req-requester" class="itx-input" type="search" placeholder="Name or email…"
                               @bind="_requestRequesterFilter" @bind:event="oninput" />
                    </div>
                    <div class="itx-field">
                        <label for="itx-req-from">From date</label>
                        <NocturneDateField Id="itx-req-from" @bind-Date="requestFromDate" />
                    </div>
                    <div class="itx-field">
                        <label for="itx-req-to">To date</label>
                        <NocturneDateField Id="itx-req-to" @bind-Date="requestToDate" />
                    </div>
                    <div class="itx-filters-foot">
                        <button type="button" class="itx-btn itx-btn-sm" @onclick="ClearRequestFilters"
                                disabled="@(!HasActiveRequestFilters)">
                            Clear all filters
                        </button>
                    </div>
                </div>
            }

            <div class="itx-panel">
            @if (isLoadingRequests)
            {
                <div class="itx-empty">
                    <div class="itx-spin" role="status" aria-label="Loading" style="margin:0 auto .8rem;"></div>
                    <p>Loading transfer requests…</p>
                </div>
            }
            else if (transferRequests?.Any() == true)
            {
                <div class="itx-summary">
                    <div class="itx-summary-item">
                        <div class="itx-summary-k">Requests</div>
                        <div class="itx-summary-v">
                            @FilteredRequestCount
                            <span class="itx-summary-scope">on page @requestPage</span>
                        </div>
                    </div>
                    <div class="itx-summary-item">
                        <div class="itx-summary-k">Units requested</div>
                        <div class="itx-summary-v">@QuantityDisplay.Format(FilteredRequests.Sum(RequestUnits))</div>
                    </div>
                    <div class="itx-summary-item accent">
                        <div class="itx-summary-k">Awaiting you</div>
                        <div class="itx-summary-v">@FilteredRequests.Count(CanCurrentUserDecide)</div>
                    </div>
                    <div class="itx-summary-range">
                        @if (HasActiveRequestFilters)
                        {
                            <span>Filtered from @transferRequestCount on this page</span>
                        }
                        else
                        {
                            <span>Newest first</span>
                        }
                    </div>
                </div>
                @* SAP holds over eleven thousand transfer requests, so the list walks
                   SAP a page at a time; the footer pages within whatever is loaded. *@
                <div class="itx-meta">
                    <span class="itx-spacer"></span>
                    <button type="button" class="itx-btn itx-btn-sm" @onclick="PreviousRequestPage"
                            disabled="@(requestPage <= 1 || isLoadingRequests)">
                        <i class="bi bi-chevron-left"></i> Newer
                    </button>
                    <button type="button" class="itx-btn itx-btn-sm" @onclick="NextRequestPage"
                            disabled="@(!hasMoreRequests || isLoadingRequests)">
                        Older <i class="bi bi-chevron-right"></i>
                    </button>
                </div>
                <div class="itx-tablewrap">
                    <table class="itx-table">
                        <thead>
                            <tr>
                                <th style="width:120px;">
                                    <button type="button" class="itx-th-sort" @onclick="@(() => SortRequests(SortKeyDoc))">
                                        Doc #<span class="itx-sort-arrow">@RequestSortArrow(SortKeyDoc)</span>
                                    </button>
                                </th>
                                <th>Route</th>
                                <th style="width:160px;">Status</th>
                                <th style="width:125px;">
                                    <button type="button" class="itx-th-sort" @onclick="@(() => SortRequests(SortKeyDate))">
                                        Raised<span class="itx-sort-arrow">@RequestSortArrow(SortKeyDate)</span>
                                    </button>
                                </th>
                                <th style="width:125px;">Due</th>
                                <th style="width:140px;">Requester</th>
                                <th class="itx-col-right" style="width:85px;">
                                    <button type="button" class="itx-th-sort" @onclick="@(() => SortRequests(SortKeyItems))">
                                        Items<span class="itx-sort-arrow">@RequestSortArrow(SortKeyItems)</span>
                                    </button>
                                </th>
                                <th class="itx-col-right" style="width:120px;">&nbsp;</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var request in RequestPageRows)
                            {
                                var requestLate = IsPastDue(request.DueDate, request.DocumentStatus);
                                <tr @key="request.DocEntry" class="@RowClass(selectedTransferRequest?.DocEntry == request.DocEntry)"
                                    @onclick="() => ViewTransferRequest(request)">
                                    <td><span class="itx-doc">#@request.DocNum</span></td>
                                    <td>
                                        <span class="itx-route">
                                            <span class="itx-wh src">@request.FromWarehouse</span>
                                            <i class="bi bi-arrow-right itx-arrow"></i>
                                            <span class="itx-wh dst">@request.ToWarehouse</span>
                                            <span class="itx-dest">@WarehouseName(request.ToWarehouse)</span>
                                        </span>
                                    </td>
                                    <td>
                                        <span class="itx-status @GetStatusCssClass(request.ApprovalStatus ?? request.DocumentStatus)">
                                            @GetApprovalDisplayStatus(request)
                                        </span>
                                    </td>
                                    <td class="itx-num">@FormatDate(request.DocDate)</td>
                                    <td class="itx-num">
                                        <span class="@(requestLate ? "itx-due-late" : null)">@FormatDate(request.DueDate)</span>
                                        @if (requestLate)
                                        {
                                            <span class="itx-due-note">past due</span>
                                        }
                                    </td>
                                    <td>@(request.RequesterName ?? "—")</td>
                                    <td class="itx-col-right">
                                        <span class="itx-wh count">@(request.Lines?.Count ?? 0)</span>
                                    </td>
                                    <td class="itx-col-right">
                                        @if (CanCurrentUserDecide(request))
                                        {
                                            <span class="itx-open"><i class="bi bi-check2-square"></i> Decide</span>
                                        }
                                        else
                                        {
                                            <span class="itx-open">Open <i class="bi bi-chevron-right"></i></span>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                @if (FilteredRequestCount == 0)
                {
                    <div class="itx-empty">
                        <i class="bi bi-funnel itx-empty-icon"></i>
                        <h6>Nothing matches those filters</h6>
                        <p>No transfer requests match the current filters.</p>
                        <button type="button" class="itx-btn" @onclick="ClearRequestFilters"
                                disabled="@(!HasActiveRequestFilters)">
                            Clear filters
                        </button>
                    </div>
                }

                <div class="itx-foot">
                    <span>Showing @FilteredRequestCount of @transferRequestCount · sorted by @RequestSortLabel</span>
                    <span class="itx-foot-actions">
                        <span class="itx-page-size">
                            <label for="itx-page-size-r">Show</label>
                            <NocturneSelect Id="itx-page-size-r" Class="nsel-sm" Options="PageSizeSelectOptions"
                                            @bind-Value="_pageSize" OnChanged="ResetPaging"
                                            AriaLabel="Rows per page" />
                            <span>per page</span>
                        </span>
                        <span class="itx-pager">
                            <button type="button" class="itx-btn itx-btn-sm itx-btn-icon" title="Previous page"
                                    aria-label="Previous page" disabled="@(RequestListPage <= 1)"
                                    @onclick="@(() => requestListPage = RequestListPage - 1)">
                                @ChevronLeftGlyph
                            </button>
                            <span class="itx-page-label">Page @RequestListPage / @RequestListPageCount</span>
                            <button type="button" class="itx-btn itx-btn-sm itx-btn-icon" title="Next page"
                                    aria-label="Next page" disabled="@(RequestListPage >= RequestListPageCount)"
                                    @onclick="@(() => requestListPage = RequestListPage + 1)">
                                @ChevronRightGlyph
                            </button>
                        </span>
                        <button type="button" class="itx-btn itx-btn-sm" @onclick="ExportCurrentTabCsv">
                            <i class="bi bi-filetype-csv"></i> Export CSV
                        </button>
                    </span>
                </div>
            }
            else if (requestLoadError != null)
            {
                <div class="itx-empty">
                    <i class="bi bi-exclamation-octagon itx-empty-icon"></i>
                    <h6>Transfer requests could not be loaded</h6>
                    <p>@requestLoadError</p>
                    <button type="button" class="itx-btn" @onclick="RefreshTransferRequests">
                        <i class="bi bi-arrow-clockwise"></i> Retry
                    </button>
                </div>
            }
            else
            {
                <div class="itx-empty">
                    <i class="bi bi-file-earmark-text itx-empty-icon"></i>
                    <h6>No transfer requests</h6>
                    <p>
                        @(requestDocumentStatus switch
                        {
                            OpenRequestsFilter => "Nothing is open in SAP right now.",
                            ClosedRequestsFilter => "Nothing closed in SAP.",
                            _ => "No transfer requests have been created yet."
                        })
                    </p>
                    <a href="/transfer-request/create" class="itx-btn itx-btn-primary">
                        <i class="bi bi-plus-lg"></i> Create first request
                    </a>
                </div>
            }
            </div>
        }
        else if (activeTabIndex == 2)
        {
            <!-- ══════ DIRECT TRANSFERS AWAITING APPROVAL ══════ -->
            <div class="itx-toolbar">
                <div class="itx-grow itx-field">
                    <label for="itx-pending-status">Status</label>
                    <NocturneSelect TValue="string" Id="itx-pending-status" Class="nsel-block"
                                    Options="PendingStatusOptions" Value="@pendingStatusFilter"
                                    ValueChanged="@(value => ChangePendingStatusFilter(value))"
                                    Disabled="isLoadingPending" Caption="Filter by status"
                                    AriaLabel="Filter by status" />
                </div>
                <div class="itx-toolbar-actions">
                    <button type="button" class="itx-btn" @onclick="LoadPendingTransfersAsync" disabled="@isLoadingPending">
                        <i class="bi bi-arrow-clockwise"></i> Refresh
                    </button>
                </div>
            </div>

            <div class="itx-panel">
            @if (isLoadingPending)
            {
                <div class="itx-empty">
                    <div class="itx-spin" role="status" aria-label="Loading" style="margin:0 auto .8rem;"></div>
                    <p>Loading transfers awaiting approval…</p>
                </div>
            }
            else if (pendingTransfers?.Any() == true)
            {
                <div class="itx-summary">
                    <div class="itx-summary-item">
                        <div class="itx-summary-k">Drafts</div>
                        <div class="itx-summary-v">@pendingTransfers.Count</div>
                    </div>
                    <div class="itx-summary-item">
                        <div class="itx-summary-k">Lines</div>
                        <div class="itx-summary-v">@pendingTransfers.Sum(x => x.LineCount)</div>
                    </div>
                    <div class="itx-summary-item accent">
                        <div class="itx-summary-k">Awaiting you</div>
                        <div class="itx-summary-v">@pendingTransfers.Count(x => x.CanCurrentUserDecide)</div>
                    </div>
                    <div class="itx-summary-range">@FormatPendingScope(pendingStatusFilter)</div>
                </div>
                <div class="itx-tablewrap">
                    <table class="itx-table">
                        <thead>
                            <tr>
                                <th style="width:120px;">Draft #</th>
                                <th>Route</th>
                                <th style="width:160px;">Status</th>
                                <th style="width:150px;">Submitted</th>
                                <th style="width:150px;">Awaiting</th>
                                <th style="width:140px;">Requested by</th>
                                <th class="itx-col-right" style="width:85px;">Items</th>
                                <th class="itx-col-right" style="width:180px;">&nbsp;</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var pending in PendingPageRows)
                            {
                                <tr @key="pending.Id" class="@RowClass(selectedPendingTransfer?.Id == pending.Id)"
                                    @onclick="() => ViewPendingTransfer(pending)">
                                    <td><span class="itx-doc">@DraftReference(pending)</span></td>
                                    <td>
                                        <span class="itx-route">
                                            <span class="itx-wh src">@pending.FromWarehouse</span>
                                            <i class="bi bi-arrow-right itx-arrow"></i>
                                            <span class="itx-wh dst">@pending.ToWarehouse</span>
                                            <span class="itx-dest">@WarehouseName(pending.ToWarehouse)</span>
                                        </span>
                                    </td>
                                    <td>
                                        <span class="itx-status @GetStatusCssClass(pending.Status)">@FormatPendingStatus(pending)</span>
                                    </td>
                                    <td class="itx-num">@pending.CreatedAtUtc.ToLocalTime().ToString("dd MMM yyyy HH:mm")</td>
                                    <td>@PendingStageNames(pending)</td>
                                    <td>@pending.CreatedByName</td>
                                    <td class="itx-col-right">
                                        <span class="itx-wh count">@pending.LineCount</span>
                                    </td>
                                    @* Row actions stop the click bubbling: the row itself opens the drawer. *@
                                    <td class="itx-col-right" @onclick:stopPropagation="true">
                                        <span class="itx-rowactions">
                                            @if (pending.CanCurrentUserDecide)
                                            {
                                                <button type="button" class="itx-btn itx-btn-sm itx-btn-primary" disabled="@isDecidingPending"
                                                        @onclick="@(() => DecidePendingTransferAsync(pending, ApprovedDecision))">
                                                    Approve
                                                </button>
                                                <button type="button" class="itx-btn itx-btn-sm" disabled="@isDecidingPending"
                                                        @onclick="@(() => DecidePendingTransferAsync(pending, RejectedDecision))">
                                                    Reject
                                                </button>
                                            }
                                            @* Approved belongs here too: the post runs inside the approval request, so a
                                               record still sitting at Approved is one whose post never finished. *@
                                            else if (pending.Status is PendingTransferStatuses.PostFailed or PendingTransferStatuses.Approved)
                                            {
                                                <button type="button" class="itx-btn itx-btn-sm" disabled="@isDecidingPending"
                                                        title="Post this approved transfer to SAP"
                                                        @onclick="() => RetryPendingTransferAsync(pending)">
                                                    <i class="bi bi-arrow-clockwise"></i> Post to SAP
                                                </button>
                                            }
                                            else if (pending.Status == PendingTransferStatuses.AwaitingApproval && pending.CreatedByUserId == currentUserId)
                                            {
                                                <button type="button" class="itx-btn itx-btn-sm" disabled="@isDecidingPending"
                                                        @onclick="() => CancelPendingTransferAsync(pending)">
                                                    Withdraw
                                                </button>
                                            }
                                            else
                                            {
                                                <span class="itx-open">Open <i class="bi bi-chevron-right"></i></span>
                                            }
                                        </span>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <div class="itx-foot">
                    <span>Showing @PendingPageRows.Count() of @pendingTransfers.Count draft(s)</span>
                    <span class="itx-foot-actions">
                        <span class="itx-pager">
                            <button type="button" class="itx-btn itx-btn-sm itx-btn-icon" title="Previous page"
                                    aria-label="Previous page" disabled="@(PendingListPage <= 1)"
                                    @onclick="@(() => pendingListPage = PendingListPage - 1)">
                                @ChevronLeftGlyph
                            </button>
                            <span class="itx-page-label">Page @PendingListPage / @PendingListPageCount</span>
                            <button type="button" class="itx-btn itx-btn-sm itx-btn-icon" title="Next page"
                                    aria-label="Next page" disabled="@(PendingListPage >= PendingListPageCount)"
                                    @onclick="@(() => pendingListPage = PendingListPage + 1)">
                                @ChevronRightGlyph
                            </button>
                        </span>
                        <button type="button" class="itx-btn itx-btn-sm" @onclick="ExportCurrentTabCsv">
                            <i class="bi bi-filetype-csv"></i> Export CSV
                        </button>
                    </span>
                </div>
            }
            else
            {
                <div class="itx-empty">
                    <i class="bi bi-hourglass itx-empty-icon"></i>
                    <h6>Nothing awaiting approval</h6>
                    <p>Inventory transfers appear here after they are submitted, until every approval stage signs off.</p>
                </div>
            }
            </div>
        }
</div>
</div>

<!-- ── Pending transfer detail drawer ─────────────────────── -->
@if (selectedPendingTransfer != null)
{
    <div class="itx-scrim" @onclick="ClosePendingTransfer"></div>
    <div class="itx-drawer">
        <div class="itx-drawer-head">
            <div style="flex:1;min-width:0;">
                <div class="itx-kicker">Draft transfer</div>
                <h5>@DraftReference(selectedPendingTransfer)</h5>
                <div class="itx-drawer-route">
                    <span class="itx-wh src">@selectedPendingTransfer.FromWarehouse</span>
                    <i class="bi bi-arrow-right itx-arrow"></i>
                    <span class="itx-wh dst">@selectedPendingTransfer.ToWarehouse</span>
                </div>
            </div>
            <button type="button" class="itx-btn itx-btn-icon" title="Close" aria-label="Close details"
                    @onclick="ClosePendingTransfer">
                @CloseGlyph
            </button>
        </div>
        <div class="itx-drawer-body">
            <div class="itx-grid">
                <div>
                    <div class="k">Status</div>
                    <div class="v">
                        <span class="itx-status @GetStatusCssClass(selectedPendingTransfer.Status)">
                            @FormatPendingStatus(selectedPendingTransfer)
                        </span>
                    </div>
                </div>
                <div>
                    <div class="k">Destination</div>
                    <div class="v">@WarehouseName(selectedPendingTransfer.ToWarehouse)</div>
                </div>
                <div>
                    <div class="k">Submitted</div>
                    <div class="v">@selectedPendingTransfer.CreatedAtUtc.ToLocalTime().ToString("dd MMM yyyy HH:mm")</div>
                </div>
                <div>
                    <div class="k">Submitted by</div>
                    <div class="v">@selectedPendingTransfer.CreatedByName (@selectedPendingTransfer.CreatedByRole)</div>
                </div>
                <div>
                    <div class="k">Approval process</div>
                    <div class="v">@(selectedPendingTransfer.ApprovalTemplateName ?? "—")</div>
                </div>
                @if (selectedPendingTransfer.SapDocNum.HasValue)
                {
                    <div>
                        <div class="k">SAP document</div>
                        <div class="v">#@selectedPendingTransfer.SapDocNum</div>
                    </div>
                }
                @if (!string.IsNullOrWhiteSpace(selectedPendingTransfer.Comments))
                {
                    <div class="span-2">
                        <div class="k">Comments</div>
                        <div class="v plain">@selectedPendingTransfer.Comments</div>
                    </div>
                }
            </div>

            @if (!string.IsNullOrWhiteSpace(selectedPendingTransfer.LastError))
            {
                <div class="itx-alert err">
                    <i class="bi bi-exclamation-octagon-fill"></i>
                    <div class="itx-alert-body">@selectedPendingTransfer.LastError</div>
                </div>
            }
            else if (selectedPendingTransfer.Status == PendingTransferStatuses.Approved)
            {
                @* Approval is complete but SAP never took the document, so no stock has moved.
                   Nothing retries on its own — say so rather than leave it looking in progress. *@
                <div class="itx-alert warn">
                    <i class="bi bi-exclamation-triangle-fill"></i>
                    <div class="itx-alert-body">
                        This transfer is fully approved but has not reached SAP, so no stock has moved.
                        Use <strong>Post to SAP</strong> below to complete it.
                    </div>
                </div>
            }

            <div class="itx-section"><i class="bi bi-diagram-3"></i> Approval stages</div>
            <ul class="itx-stagelist">
                @foreach (var stage in selectedPendingTransfer.ApprovalStages)
                {
                    <li>
                        <span>
                            <strong>@stage.StageName</strong>
                            <span class="itx-stage-roles">@string.Join(", ", stage.AuthorizerRoles)</span>
                        </span>
                        <span class="itx-status @GetStatusCssClass(stage.Status)">
                            @GetFriendlyStatus(stage.Status) (@stage.ApprovalCount/@stage.ApprovalsRequired)
                        </span>
                    </li>
                }
            </ul>

            <div class="itx-section itx-section-gap"><i class="bi bi-list-check"></i> Lines · @selectedPendingTransfer.LineCount</div>
            @if (isLoadingPendingDetail)
            {
                <div class="itx-loading">
                    <span class="itx-spin itx-spin-sm"></span>
                    <span>Loading lines…</span>
                </div>
            }
            else if (selectedPendingTransfer.Lines.Count == 0)
            {
                <p class="itx-note">No line items could be read for this draft.</p>
            }
            else
            {
                <div class="itx-lines-wrap">
                    <table class="itx-lines">
                        <thead>
                            <tr><th>Item</th><th>From</th><th>To</th><th class="num">Qty</th><th>UoM</th></tr>
                        </thead>
                        <tbody>
                            @foreach (var line in selectedPendingTransfer.Lines)
                            {
                                <tr>
                                    <td>
                                        <div class="strong">@line.ItemCode</div>
                                        @{ var itemName = LineItemName(line); }
                                        @if (!string.IsNullOrWhiteSpace(itemName))
                                        {
                                            <div class="muted">@itemName</div>
                                        }
                                    </td>
                                    <td><span class="itx-wh src">@(line.FromWarehouseCode ?? selectedPendingTransfer.FromWarehouse)</span></td>
                                    <td><span class="itx-wh dst">@(line.ToWarehouseCode ?? selectedPendingTransfer.ToWarehouse)</span></td>
                                    <td class="num">@QuantityDisplay.Format(line.Quantity, line.UoMCode)</td>
                                    <td class="muted">@(line.UoMCode ?? "—")</td>
                                </tr>
                            }
                        </tbody>
                        <tfoot>
                            <tr>
                                <td colspan="3" class="num">Total</td>
                                <td class="num">@QuantityDisplay.Format(selectedPendingTransfer.Lines.Sum(l => l.Quantity))</td>
                                <td></td>
                            </tr>
                        </tfoot>
                    </table>
                </div>
            }

            @if (selectedPendingTransfer.CanCurrentUserDecide)
            {
                <label class="itx-label" for="itx-pending-remarks">Remarks (optional)</label>
                <textarea id="itx-pending-remarks" class="itx-input" rows="2"
                          placeholder="Optional approval or rejection remarks"
                          @bind="pendingDecisionRemarks"></textarea>
                <div class="itx-actions">
                    <button type="button" class="itx-btn itx-btn-primary" disabled="@isDecidingPending"
                            @onclick="@(() => DecidePendingTransferAsync(selectedPendingTransfer, ApprovedDecision))">
                        <i class="bi bi-check-lg"></i> Approve
                    </button>
                    <button type="button" class="itx-btn itx-btn-danger" disabled="@isDecidingPending"
                            @onclick="@(() => DecidePendingTransferAsync(selectedPendingTransfer, RejectedDecision))">
                        <i class="bi bi-x-lg"></i> Reject
                    </button>
                </div>
            }
        </div>
        <div class="itx-drawer-foot">
            <button type="button" class="itx-btn itx-btn-primary"
                    disabled="@(isPrinting || isLoadingPendingDetail)"
                    @onclick="() => PrintPendingTransferDraft(selectedPendingTransfer)">
                <i class="bi bi-printer"></i> Print Draft
            </button>
            @if (selectedPendingTransfer.Status is PendingTransferStatuses.Approved or PendingTransferStatuses.PostFailed)
            {
                <button type="button" class="itx-btn itx-btn-primary" disabled="@isDecidingPending"
                        title="Post this approved transfer to SAP"
                        @onclick="() => RetryPendingTransferAsync(selectedPendingTransfer)">
                    <i class="bi bi-arrow-clockwise"></i> Post to SAP
                </button>
            }
            <button type="button" class="itx-btn" @onclick="ClosePendingTransfer">Close</button>
        </div>
    </div>
}

