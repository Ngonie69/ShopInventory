@page "/credit-notes/approvals"
@using Microsoft.AspNetCore.Authorization
@using ShopInventory.Web.Data
@using ShopInventory.Web.Models
@attribute [Authorize(Roles = UserRoles.CreditNoteApprovalRoles)]
@rendermode InteractiveServer

<PageTitle>Credit Note Approvals - Shop Inventory</PageTitle>

@* Nocturne, a decision queue: queue tiles across the top, one two-line row per request, and the
   request itself in a right-hand drawer that walks the queue. wwwroot/css/credit-note-approvals.css
   (in the staff bundle) carries both schemes and follows the app's theme toggle. Icon-only buttons
   draw their glyph inline rather than from the Phosphor font, because the glyph is the whole label
   and a font that fails to load would leave them reading as dead controls. *@

<div class="cna cna-q">

    <header class="cna-head">
        <div class="cna-shell">
            <div class="cna-titles">
                <div class="cna-titles-row">
                    <i class="ph ph-seal-check" aria-hidden="true"></i>
                    <h1 class="cna-title">Credit Note Approvals</h1>
                </div>
                <p class="cna-sub">Credit memos raised in SAP and held for approval. Every decision is recorded in SAP.</p>
            </div>
            <div class="cna-head-actions">
                @if (listReadAt is DateTime readAt)
                {
                    <span class="cna-count">Read from SAP at @readAt.ToString("HH:mm")</span>
                }
                <button type="button" class="cna-btn cna-btn-secondary cna-btn-lg" @onclick="RefreshAsync" disabled="@isLoading">
                    @if (isLoading)
                    {
                        <span class="cna-spin" aria-hidden="true"></span>
                    }
                    else
                    {
                        <i class="ph ph-arrows-clockwise" aria-hidden="true"></i>
                    }
                    <span>Refresh</span>
                </button>
            </div>
        </div>
        <div class="cna-rule"></div>
    </header>

    <div class="cna-body">

        @if (!string.IsNullOrEmpty(errorMessage))
        {
            <div class="cna-alert" role="alert">
                <i class="ph ph-warning-octagon" aria-hidden="true"></i>
                <div class="cna-alert-body">@errorMessage</div>
                <button type="button" class="cna-btn cna-btn-ghost cna-btn-icon-sm" title="Dismiss"
                        aria-label="Dismiss error" @onclick="() => errorMessage = null">
                    <svg viewBox="0 0 256 256" aria-hidden="true" focusable="false">
                        <path d="M205.66,194.34a8,8,0,0,1-11.32,11.32L128,139.31,61.66,205.66a8,8,0,0,1-11.32-11.32L116.69,128,50.34,61.66A8,8,0,0,1,61.66,50.34L128,116.69l66.34-66.35a8,8,0,0,1,11.32,11.32L139.31,128Z" />
                    </svg>
                </button>
            </div>
        }

        @* The queue tiles. Each is a status filter with the length of its queue on it, so the page
           answers "how much is waiting" before anything is opened. *@
        <nav class="cna-queues" aria-label="Queues">
            @foreach (var queue in Queues)
            {
                <button type="button" class="cna-queue @(statusFilter == queue.Value ? "is-on" : "")"
                        aria-pressed="@(statusFilter == queue.Value)"
                        @onclick="() => SetStatusFilterAsync(queue.Value)">
                    <span class="cna-queue-label">
                        <span class="cna-queue-dot @queue.Modifier" aria-hidden="true"></span>@queue.Label
                    </span>
                    <span class="cna-queue-count">@QueueCount(queue.Value)</span>
                    <span class="cna-queue-hint">@queue.Hint</span>
                </button>
            }
        </nav>

        @* What the last decision or add said. It outlives the drawer: a decision moves the drawer on to
           the next request, and SAP deletes the approval request with an add. A failed fiscalisation, or
           an approval SAP recorded without approving the draft, keeps the notice colour. *@
        @if (!string.IsNullOrEmpty(notice))
        {
            <div class="@(noticeNeedsAttention ? "cna-blocked cna-added" : "cna-done cna-added")" role="status">
                <i class="ph @(noticeNeedsAttention ? "ph-warning" : "ph-check-circle")" aria-hidden="true"></i>
                <div class="cna-alert-body">
                    <div>@notice</div>
                    @if (!string.IsNullOrEmpty(noticeSource))
                    {
                        <div class="cna-added-source">@noticeSource</div>
                    }
                </div>
                <button type="button" class="cna-btn cna-btn-ghost cna-btn-icon-sm" title="Dismiss"
                        aria-label="Dismiss notice" @onclick="DismissNotice">
                    <svg viewBox="0 0 256 256" aria-hidden="true" focusable="false">
                        <path d="M205.66,194.34a8,8,0,0,1-11.32,11.32L128,139.31,61.66,205.66a8,8,0,0,1-11.32-11.32L116.69,128,50.34,61.66A8,8,0,0,1,61.66,50.34L128,116.69l66.34-66.35a8,8,0,0,1,11.32,11.32L139.31,128Z" />
                    </svg>
                </button>
            </div>
        }

        <section class="cna-filters">
            <div class="cna-search">
                <label for="cna-f-customer" class="cna-visually-hidden">Customer</label>
                <i class="ph ph-magnifying-glass" aria-hidden="true"></i>
                @* Not @bind:event="oninput": that narrowed the rows on every keystroke. The value is
                   set on input so the box keeps up, and the rows follow once the typing rests. *@
                <input id="cna-f-customer" class="cna-input" type="search" placeholder="Customer name or code"
                       value="@customerFilter" @oninput="OnCustomerFilterInputAsync" />
            </div>
            @if (!string.IsNullOrWhiteSpace(customerFilter))
            {
                <button type="button" class="cna-btn cna-btn-ghost cna-btn-lg" @onclick="ClearCustomerFilter">Clear</button>
            }
            <span class="cna-filter-note">Narrows the page on screen</span>
        </section>

        <section class="cna-card" aria-label="Requests">

            <div class="cna-toolbar">
                <h2 class="cna-list-title">@ListTitle</h2>
                <span class="cna-range">@RangeLabel</span>
                <span class="cna-hint">Open a request to review it</span>
            </div>

            <ul class="cna-list">
                @if (isLoading)
                {
                    @for (var skeletonRow = 0; skeletonRow < 6; skeletonRow++)
                    {
                        <li class="cna-item cna-item-skel">
                            <div class="cna-skel" style="width:38%"></div>
                            <div class="cna-skel" style="width:72%"></div>
                            <div class="cna-skel" style="width:48%"></div>
                        </li>
                    }
                }
                else
                {
                    @foreach (var request in VisibleRequests)
                    {
                        <li @key="request.Code" class="cna-item @RowClass(request)">
                            <button type="button" class="cna-row" aria-current="@(detailCode == request.Code ? "true" : null)"
                                    @onclick="() => OpenAsync(request.Code)">
                                <span class="cna-row-main">
                                    <span class="cna-row-top">
                                        <span class="cna-row-name">@(request.CardName ?? "—")</span>
                                        <span class="cna-pill @StatusModifier(request.Status)">@StatusLabel(request.Status)</span>
                                    </span>
                                    <span class="cna-row-reason">
                                        @(string.IsNullOrWhiteSpace(request.Comments) ? "No reason given on the draft" : request.Comments)
                                    </span>
                                    <span class="cna-row-meta">
                                        <span>#@request.Code</span>
                                        @if (request.DraftNum is int draftNum)
                                        {
                                            <span>Draft @draftNum</span>
                                        }
                                        @if (!string.IsNullOrWhiteSpace(request.CardCode))
                                        {
                                            <span>@request.CardCode</span>
                                        }
                                        <span>@(request.OriginatorName ?? request.OriginatorUserCode ?? "—") · @(request.StageName ?? "—")</span>
                                        @if (request.HasAttachment)
                                        {
                                            <span class="cna-row-clip"><i class="ph ph-paperclip" aria-hidden="true"></i>Attachment</span>
                                        }
                                    </span>
                                </span>
                                <span class="cna-row-side">
                                    <span class="cna-row-amount">@request.DocTotal.ToString("N2") <span class="cna-row-cur">@request.DocCurrency</span></span>
                                    <span class="cna-row-date">@FormatDate(RaisedDate(request))</span>
                                    @if (!string.IsNullOrEmpty(AgeText(request)))
                                    {
                                        <span class="cna-row-age @(IsLate(request) ? "is-late" : "")">
                                            <i class="ph ph-clock" aria-hidden="true"></i>@AgeText(request)
                                        </span>
                                    }
                                </span>
                                <i class="ph ph-caret-right cna-row-chev" aria-hidden="true"></i>
                            </button>
                        </li>
                    }
                }
            </ul>

            @if (!isLoading && VisibleRequests.Count == 0)
            {
                <div class="cna-empty">
                    <i class="ph ph-seal-check" aria-hidden="true"></i>
                    <span>@EmptyMessage</span>
                </div>
            }

            <div class="cna-foot">
                <span class="cna-foot-range">@RangeLabel</span>
                <div class="cna-pager">
                    <button type="button" class="cna-btn cna-btn-secondary cna-btn-icon" title="Previous page"
                            aria-label="Previous page" disabled="@(currentPage <= 1 || isLoading)" @onclick="PreviousPageAsync">
                        <svg viewBox="0 0 256 256" aria-hidden="true" focusable="false">
                            <path d="M165.66,202.34a8,8,0,0,1-11.32,11.32l-80-80a8,8,0,0,1,0-11.32l80-80a8,8,0,0,1,11.32,11.32L91.31,128Z" />
                        </svg>
                    </button>
                    <span class="cna-page-label">Page @currentPage / @TotalPages</span>
                    <button type="button" class="cna-btn cna-btn-secondary cna-btn-icon" title="Next page"
                            aria-label="Next page" disabled="@(!CanGoNext || isLoading)" @onclick="NextPageAsync">
                        <svg viewBox="0 0 256 256" aria-hidden="true" focusable="false">
                            <path d="M181.66,133.66l-80,80a8,8,0,0,1-11.32-11.32L164.69,128,90.34,53.66a8,8,0,0,1,11.32-11.32l80,80A8,8,0,0,1,181.66,133.66Z" />
                        </svg>
                    </button>
                </div>
            </div>
        </section>
    </div>
</div>

@if (detailCode is not null)
{
    <div class="cna-overlay cna-q">
        <div class="cna-scrim" @onclick="CloseDetail"></div>
        <aside class="cna-drawer" aria-label="Approval request details">
            <div class="cna-drawer-head">
                @if (detail is not null)
                {
                    <span class="cna-pill @StatusModifier(detail.Request.Status)">@StatusLabel(detail.Request.Status)</span>
                }
                <h2 class="cna-drawer-title">Request @detailCode</h2>
                @if (detail?.Request.DraftNum is int drawerDraft)
                {
                    <span class="cna-drawer-draft">Draft @drawerDraft</span>
                }
                <div class="cna-drawer-nav">
                    @if (!string.IsNullOrEmpty(OpenPosition))
                    {
                        <span class="cna-drawer-pos">@OpenPosition</span>
                    }
                    <button type="button" class="cna-btn cna-btn-ghost cna-btn-icon cna-btn-quiet" title="Previous request"
                            aria-label="Previous request" disabled="@(!CanOpenPrevious)" @onclick="OpenPreviousAsync">
                        <svg viewBox="0 0 256 256" aria-hidden="true" focusable="false">
                            <path d="M213.66,165.66a8,8,0,0,1-11.32,0L128,91.31,53.66,165.66a8,8,0,0,1-11.32-11.32l80-80a8,8,0,0,1,11.32,0l80,80A8,8,0,0,1,213.66,165.66Z" />
                        </svg>
                    </button>
                    <button type="button" class="cna-btn cna-btn-ghost cna-btn-icon cna-btn-quiet" title="Next request"
                            aria-label="Next request" disabled="@(!CanOpenNext)" @onclick="OpenNextAsync">
                        <svg viewBox="0 0 256 256" aria-hidden="true" focusable="false">
                            <path d="M213.66,101.66l-80,80a8,8,0,0,1-11.32,0l-80-80A8,8,0,0,1,53.66,90.34L128,164.69l74.34-74.35a8,8,0,0,1,11.32,11.32Z" />
                        </svg>
                    </button>
                    <span class="cna-drawer-sep" aria-hidden="true"></span>
                    <button type="button" class="cna-btn cna-btn-ghost cna-btn-icon cna-btn-quiet" title="Close"
                            aria-label="Close details" @onclick="CloseDetail">
                        <svg viewBox="0 0 256 256" aria-hidden="true" focusable="false">
                            <path d="M205.66,194.34a8,8,0,0,1-11.32,11.32L128,139.31,61.66,205.66a8,8,0,0,1-11.32-11.32L116.69,128,50.34,61.66A8,8,0,0,1,61.66,50.34L128,116.69l66.34-66.35a8,8,0,0,1,11.32,11.32L139.31,128Z" />
                        </svg>
                    </button>
                </div>
            </div>
            <div class="cna-drawer-body">
                @if (isLoadingDetail)
                {
                    <div class="cna-note">Reading the request from SAP…</div>
                }
                else if (detail is null)
                {
                    <div class="cna-alert" role="alert">
                        <i class="ph ph-warning-octagon" aria-hidden="true"></i>
                        <div class="cna-alert-body">@(detailError ?? "This request could not be read from SAP.")</div>
                    </div>
                }
                else
                {
                    var request = detail.Request;

                    @if (!string.IsNullOrEmpty(detailError))
                    {
                        <div class="cna-alert" role="alert">
                            <i class="ph ph-warning-octagon" aria-hidden="true"></i>
                            <div class="cna-alert-body">@detailError</div>
                        </div>
                    }

                    <div class="cna-summary">
                        <h3 class="cna-summary-name">@(request.CardName ?? "—")</h3>
                        <div class="cna-summary-sub">
                            @(request.CardCode ?? "—") · raised @FormatDate(RaisedDate(request))
                            by @(request.OriginatorName ?? request.OriginatorUserCode ?? "—")
                        </div>
                        <div class="cna-summary-total">
                            <span class="cna-summary-amount">@request.DocTotal.ToString("N2")</span>
                            <span class="cna-summary-cur">@request.DocCurrency</span>
                            <span class="cna-summary-label">Credit total</span>
                        </div>
                    </div>

                    <div class="cna-note cna-reason-box">
                        <div class="cna-dt">Reason for credit</div>
                        <div class="cna-reason-full">@(string.IsNullOrWhiteSpace(request.Comments) ? "No reason given on the draft." : request.Comments)</div>
                    </div>

                    <div class="cna-grid">
                        <div>
                            <div class="cna-dt">Template</div>
                            <div class="cna-dd">@(request.TemplateName ?? "—")</div>
                        </div>
                        <div>
                            <div class="cna-dt">Current stage</div>
                            <div class="cna-dd">@(detail.Stage?.Name ?? request.StageName ?? "—")</div>
                        </div>
                        <div>
                            <div class="cna-dt">Document date</div>
                            <div class="cna-dd">@FormatDate(request.DocDate)</div>
                        </div>
                        <div>
                            <div class="cna-dt">Waiting</div>
                            <div class="cna-dd @(IsLate(request) ? "is-late" : "")">@(string.IsNullOrEmpty(AgeText(request)) ? "—" : AgeText(request))</div>
                        </div>
                        @if (!string.IsNullOrWhiteSpace(request.NumAtCard))
                        {
                            <div>
                                <div class="cna-dt">Customer reference</div>
                                <div class="cna-dd">@request.NumAtCard</div>
                            </div>
                        }
                        @if (request.CreditNoteDocEntry is int creditNoteDocEntry)
                        {
                            <div>
                                <div class="cna-dt">Credit note</div>
                                <div class="cna-dd">DocEntry @creditNoteDocEntry</div>
                            </div>
                        }
                    </div>

                    @if (detail.Lines.Count > 0)
                    {
                        <div>
                            <div class="cna-sect">Draft lines</div>
                            <div class="cna-lines-wrap">
                                <table class="cna-lines">
                                    <thead>
                                        <tr>
                                            <th>Item</th>
                                            <th>Description</th>
                                            <th class="cna-num">Qty</th>
                                            <th class="cna-num">Price</th>
                                            <th class="cna-num">Total</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var line in detail.Lines)
                                        {
                                            <tr>
                                                <td class="cna-line-item">@line.ItemCode</td>
                                                <td>@line.ItemDescription</td>
                                                <td class="cna-num">@QuantityDisplay.Format(line.Quantity)</td>
                                                <td class="cna-num">@line.UnitPrice.ToString("N2")</td>
                                                <td class="cna-num">@line.LineTotal.ToString("N2")</td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    }

                    <div>
                        <div class="cna-sect">Attachments</div>
                        @if (detail.AttachmentsUnavailable)
                        {
                            <div class="cna-note">The attached files could not be listed. @detail.AttachmentsMessage</div>
                        }
                        else if (detail.Attachments.Count == 0)
                        {
                            @* Nothing to check the return against is worth saying loudly while a decision is
                               still open; once it is decided it is only a fact. *@
                            <div class="@(request.CanDecide ? "cna-blocked" : "cna-note")">
                                @(request.CanDecide
                                    ? "Nothing is attached to this draft in SAP. Check the return before approving."
                                    : "Nothing is attached to this draft in SAP.")
                            </div>
                        }
                        else
                        {
                            <div class="cna-files">
                                @foreach (var file in detail.Attachments)
                                {
                                    <div class="cna-file">
                                        <i class="@FileIcon(file)" aria-hidden="true"></i>
                                        <div class="cna-file-body">
                                            <div class="cna-file-name" title="@file.FileName">@file.FileName</div>
                                            <div class="cna-file-meta">@FormatDate(file.AttachedOn)</div>
                                        </div>
                                        <div class="cna-file-actions">
                                            @if (file.IsViewable)
                                            {
                                                <button type="button" class="cna-btn cna-btn-ghost cna-btn-lg"
                                                        @onclick="() => ViewAttachmentAsync(file)">View</button>
                                            }
                                            <button type="button" class="cna-btn cna-btn-secondary cna-btn-lg"
                                                    @onclick="() => DownloadAttachmentAsync(file)">
                                                <i class="ph ph-download-simple" aria-hidden="true"></i>
                                                <span>Download</span>
                                            </button>
                                        </div>
                                    </div>
                                }
                            </div>
                        }

                        @if (!string.IsNullOrEmpty(attachmentError))
                        {
                            <div class="cna-alert" role="alert" style="margin-top:var(--cna-s2)">
                                <i class="ph ph-warning-octagon" aria-hidden="true"></i>
                                <div class="cna-alert-body">@attachmentError</div>
                            </div>
                        }
                    </div>

                    <div>
                        <div class="cna-sect">Approval path</div>
                        <ol class="cna-path">
                            @foreach (var step in ApprovalPath(detail))
                            {
                                <li class="cna-path-step">
                                    <span class="cna-path-dot @step.Modifier" aria-hidden="true"></span>
                                    <div class="cna-path-body">
                                        <div class="cna-path-who">@step.Who</div>
                                        <div class="cna-path-meta">@step.Meta</div>
                                        @if (step.Remark is not null)
                                        {
                                            <div class="cna-path-remark">“@step.Remark”</div>
                                        }
                                    </div>
                                </li>
                            }
                        </ol>
                    </div>

                    @if (!request.CanDecide && !request.CanAdd && !string.IsNullOrWhiteSpace(request.StatusNote))
                    {
                        <div class="cna-blocked">
                            <i class="ph ph-info" aria-hidden="true"></i>
                            <div class="cna-alert-body">@request.StatusNote</div>
                        </div>
                    }
                }
            </div>

            @if (detail?.Request.CanDecide == true)
            {
                <div class="cna-drawer-foot cna-decide">
                    <div class="cna-field">
                        <label for="cna-remarks">
                            Remarks <span class="cna-field-aside">Optional · up to 150 characters</span>
                        </label>
                        <textarea id="cna-remarks" class="cna-input cna-textarea" maxlength="150"
                                  placeholder="Recorded in SAP beside your name"
                                  @bind="decisionRemarks"></textarea>
                    </div>
                    <div class="cna-decide-actions">
                        <button type="button" class="cna-btn cna-btn-bad cna-btn-lg cna-decide-reject" @onclick="RejectAsync" disabled="@isSubmitting">
                            @if (isSubmitting && submittingAction == "reject")
                            {
                                <span class="cna-spin" aria-hidden="true"></span>
                            }
                            else
                            {
                                <i class="ph ph-x" aria-hidden="true"></i>
                            }
                            <span>Reject</span>
                        </button>
                        <button type="button" class="cna-btn cna-btn-approve cna-btn-lg cna-decide-approve" @onclick="ApproveAsync" disabled="@isSubmitting">
                            @if (isSubmitting && submittingAction == "approve")
                            {
                                <span class="cna-spin" aria-hidden="true"></span>
                            }
                            else
                            {
                                <i class="ph ph-check" aria-hidden="true"></i>
                            }
                            <span>Approve @FormatMoney(detail.Request.DocTotal, detail.Request.DocCurrency)</span>
                        </button>
                    </div>
                </div>
            }
            else if (detail?.Request.CanAdd == true)
            {
                @* CanAdd says SAP would take the add, not that this person may make it. *@
                <AuthorizeView Roles="@UserRoles.CreditNoteAddRoles" Context="addCtx">
                    <Authorized>
                        <div class="cna-drawer-foot cna-decide">
                            <div class="cna-foot-note">
                                <i class="ph ph-info" aria-hidden="true"></i>
                                <span>Approved and waiting to be added. Adding posts the credit note in SAP and sends it for fiscalisation.</span>
                            </div>
                            <button type="button" class="cna-btn cna-btn-fill cna-btn-lg" @onclick="OpenAddConfirm" disabled="@isSubmitting">
                                <i class="ph ph-plus-circle" aria-hidden="true"></i>
                                <span>Add credit note</span>
                            </button>
                        </div>
                    </Authorized>
                    <NotAuthorized>
                        <div class="cna-drawer-foot cna-decide">
                            <div class="cna-foot-note">
                                <i class="ph ph-info" aria-hidden="true"></i>
                                <span>Approved. Waiting for someone who may add credit notes.</span>
                            </div>
                        </div>
                    </NotAuthorized>
                </AuthorizeView>
            }
        </aside>
    </div>
}

@if (showAddConfirm && detail is not null)
{
    <div class="cna-overlay">
        <div class="cna-dialog-wrap" @onclick="CloseAddConfirm">
            <div class="cna-dialog" role="dialog" aria-modal="true" aria-label="Add credit note"
                 @onclick:stopPropagation="true">
                <h2 class="cna-dialog-title"><i class="ph ph-plus-circle" aria-hidden="true"></i>Add credit note</h2>
                <div class="cna-dialog-body">
                    <dl class="cna-confirm-facts">
                        <div><dt>Customer</dt><dd>@detail.Request.CardName</dd></div>
                        <div><dt>Draft</dt><dd>@(detail.Request.DraftNum?.ToString() ?? "—")</dd></div>
                        <div class="cna-confirm-total">
                            <dt>Credit total</dt>
                            <dd>@FormatMoney(detail.Request.DocTotal, detail.Request.DocCurrency)</dd>
                        </div>
                    </dl>
                    <div class="cna-blocked">
                        <i class="ph ph-warning" aria-hidden="true"></i>
                        <div class="cna-alert-body">The document is created in SAP and fiscalised. This cannot be undone.</div>
                    </div>
                </div>
                <div class="cna-dialog-actions">
                    <button type="button" class="cna-btn cna-btn-secondary cna-btn-lg" @onclick="CloseAddConfirm"
                            disabled="@isSubmitting">Cancel</button>
                    <button type="button" class="cna-btn cna-btn-fill cna-btn-lg" @onclick="AddAsync" disabled="@isSubmitting">
                        @if (isSubmitting)
                        {
                            <span class="cna-spin" aria-hidden="true"></span>
                        }
                        <span>Add credit note</span>
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@if (showViewer)
{
    <div class="cna-overlay">
        <div class="cna-dialog-wrap" @onclick="CloseViewerAsync">
            <div class="cna-viewer" role="dialog" aria-modal="true" aria-label="Attachment viewer"
                 @onclick:stopPropagation="true">
                <div class="cna-viewer-head">
                    <h2 class="cna-viewer-name">@viewerFileName</h2>
                    <button type="button" class="cna-btn cna-btn-secondary cna-btn-sm"
                            @onclick="() => DownloadAttachmentAsync(viewerFile!)">Download</button>
                    <button type="button" class="cna-btn cna-btn-ghost cna-btn-icon" title="Close"
                            aria-label="Close viewer" @onclick="CloseViewerAsync">
                        <svg viewBox="0 0 256 256" aria-hidden="true" focusable="false">
                            <path d="M205.66,194.34a8,8,0,0,1-11.32,11.32L128,139.31,61.66,205.66a8,8,0,0,1-11.32-11.32L116.69,128,50.34,61.66A8,8,0,0,1,61.66,50.34L128,116.69l66.34-66.35a8,8,0,0,1,11.32,11.32L139.31,128Z" />
                        </svg>
                    </button>
                </div>
                <div class="cna-viewer-body">
                    @if (isLoadingViewer)
                    {
                        <span class="cna-spin cna-spin-lg" aria-hidden="true"></span>
                    }
                    else if (viewerMimeType?.StartsWith("image/") == true)
                    {
                        <img src="@viewerObjectUrl" alt="@viewerFileName" class="cna-viewer-image" />
                    }
                    else if (viewerMimeType == "application/pdf")
                    {
                        <iframe src="@viewerObjectUrl" class="cna-viewer-pdf" title="@viewerFileName"></iframe>
                    }
                    else
                    {
                        <div class="cna-viewer-fallback">
                            <i class="ph ph-file" aria-hidden="true"></i>
                            <span>This file cannot be shown here. Download it instead.</span>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
}
