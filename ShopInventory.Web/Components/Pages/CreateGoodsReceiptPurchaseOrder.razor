@page "/goods-receipt-pos/create"
@attribute [Authorize(Roles = "Admin,Manager")]
@rendermode InteractiveServer

<PageTitle>Create Goods Receipt PO</PageTitle>

@* Nocturne. wwwroot/css/purchase-forms.css (linked from App.razor) carries the
   design and its light counterpart, and follows the app's theme toggle like
   every other page. The sheet is shared with the other four purchase forms —
   see its header for why one sheet rather than five, and why its palette is
   the purchase registers' rather than sales-forms'.

   The line editor is a CSS grid rather than a <table>: the column set differs
   per document and is one variable in that sheet, which a table's cells cannot
   carry.

   Icons are drawn inline rather than set from the icon font: a font that
   failed to arrive would leave the controls whose glyph is their whole label
   reading as dead squares. *@

<datalist id="goods-receipt-products">
    @foreach (var product in products)
    {
        <option value="@product.ItemCode">@product.ItemName</option>
    }
</datalist>

<datalist id="goods-receipt-warehouses">
    @foreach (var warehouse in warehouses)
    {
        <option value="@warehouse.WarehouseCode">@warehouse.WarehouseName</option>
    }
</datalist>

<div class="pfm is-receipt">
    <div class="pfm-shell">

        <nav class="pfm-crumbs" aria-label="Breadcrumb">
            <a href="/goods-receipt-pos">Goods receipt POs</a>
            <span class="pfm-crumb-sep" aria-hidden="true">/</span>
            <span class="pfm-crumb-now">New</span>
        </nav>

        <header class="pfm-head">
            <div class="pfm-head-main">
                <div class="pfm-kicker">Purchasing</div>
                <h1>New goods receipt PO</h1>
                <p>
                    Post stock received from a supplier &#8212; what arrived, at what value, and
                    which purchase-order line each receipt closes in SAP.
                </p>
            </div>
            <div class="pfm-stats">
                <div class="pfm-stat">
                    <div class="pfm-stat-k">Lines</div>
                    <div class="pfm-stat-v">@goodsReceipt.Lines.Count</div>
                </div>
                <div class="pfm-stat">
                    <div class="pfm-stat-k">Subtotal</div>
                    <div class="pfm-stat-v">@SubTotal.ToString("N2")</div>
                </div>
                <div class="pfm-stat">
                    <div class="pfm-stat-k">Estimated</div>
                    <div class="pfm-stat-v is-total">@EstimatedTotal.ToString("N2")</div>
                </div>
            </div>
        </header>

        @if (!string.IsNullOrWhiteSpace(errorMessage))
        {
            <div class="pfm-alert is-err" role="alert">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"
                     stroke-linecap="round" aria-hidden="true">
                    <circle cx="12" cy="12" r="9"></circle>
                    <path d="M12 7.5v5.5M12 16.2v.1"></path>
                </svg>
                <div class="pfm-alert-bd">@errorMessage</div>
                <button type="button" class="pfm-alert-x" aria-label="Dismiss" @onclick="() => errorMessage = null">
                    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"
                         stroke-linecap="round" aria-hidden="true">
                        <path d="M6 6l12 12M18 6L6 18"></path>
                    </svg>
                </button>
            </div>
        }

        @if (!string.IsNullOrWhiteSpace(successMessage))
        {
            <div class="pfm-alert is-ok" role="status">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"
                     stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M5 12.5l4.5 4.5L19 7"></path>
                </svg>
                <div class="pfm-alert-bd">@successMessage</div>
            </div>
        }

        <div class="pfm-grid">
            <div class="pfm-main">

                <section class="pfm-card">
                    <div class="pfm-card-hd">
                        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                             stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <path d="M4 21V6l7-3v18"></path>
                            <path d="M11 9h6a2 2 0 0 1 2 2v10"></path>
                            <path d="M2 21h20M7 8v.01M7 12v.01M7 16v.01"></path>
                        </svg>
                        <h2>Supplier</h2>
                    </div>
                    <div class="pfm-card-bd">
                        @if (isLoadingLookups)
                        {
                            <div class="pfm-loading">
                                <span class="pfm-spin" aria-hidden="true"></span>
                                <span>Loading suppliers, products and warehouses&#8230;</span>
                            </div>
                        }
                        else if (selectedSupplier is not null)
                        {
                            <div class="pfm-party">
                                <div>
                                    <div class="pfm-party-code">
                                        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                             stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"
                                             aria-hidden="true">
                                            <path d="M5 12.5l4.5 4.5L19 7"></path>
                                        </svg>
                                        @selectedSupplier.CardCode
                                    </div>
                                    <div class="pfm-party-name">@selectedSupplier.CardName</div>
                                    @if (!string.IsNullOrWhiteSpace(selectedSupplier.Currency)
                                        && !string.Equals(selectedSupplier.Currency, "##", StringComparison.OrdinalIgnoreCase))
                                    {
                                        <div class="pfm-party-meta"><span>@selectedSupplier.Currency</span></div>
                                    }
                                </div>
                                <button type="button" class="pfm-btn-x" aria-label="Clear the supplier"
                                        @onclick="ClearSupplier">
                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"
                                         stroke-linecap="round" aria-hidden="true">
                                        <path d="M6 6l12 12M18 6L6 18"></path>
                                    </svg>
                                </button>
                            </div>
                        }
                        else
                        {
                            @* Not a <label>: it wraps a popup whose clicks a label would
                               swallow by refocusing the input behind it. *@
                            <div class="pfm-lab">
                                <span class="pfm-lab-t" id="grpo-c-supplier-label">
                                    Supplier <span class="pfm-req">*</span>
                                </span>
                                <span class="pfm-combo">
                                    <input class="pfm-input @(HasError("CardCode") ? "is-bad" : "")" type="text"
                                           aria-labelledby="grpo-c-supplier-label"
                                           autocomplete="off" placeholder="Search a supplier code or name&#8230;"
                                           value="@supplierSearchTerm" @oninput="OnSupplierInput"
                                           @onfocus="ShowSupplierResults" @onblur="HandleSupplierBlur" />
                                    @if (showSupplierResults && FilteredSuppliers.Any())
                                    {
                                        <span class="pfm-drop is-wide" @onmousedown:preventDefault>
                                            @foreach (var supplier in FilteredSuppliers)
                                            {
                                                <button type="button" class="pfm-drop-i"
                                                        @onmousedown="() => SelectSupplier(supplier)">
                                                    <span>
                                                        <span class="pfm-drop-code">@supplier.CardCode</span>
                                                        <span class="pfm-drop-sub">@supplier.CardName</span>
                                                    </span>
                                                    @if (!string.IsNullOrWhiteSpace(supplier.Currency)
                                                        && !string.Equals(supplier.Currency, "##", StringComparison.OrdinalIgnoreCase))
                                                    {
                                                        <span class="pfm-drop-price">@supplier.Currency</span>
                                                    }
                                                </button>
                                            }
                                        </span>
                                    }
                                    else if (showSupplierResults && !string.IsNullOrWhiteSpace(supplierSearchTerm))
                                    {
                                        <span class="pfm-drop">
                                            <span class="pfm-drop-empty">No supplier matches that.</span>
                                        </span>
                                    }
                                </span>
                                @if (HasError("CardCode"))
                                {
                                    <span class="pfm-field-err">@GetError("CardCode")</span>
                                }
                            </div>
                        }
                    </div>
                </section>

                <section class="pfm-card">
                    <div class="pfm-card-hd">
                        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                             stroke-width="1.7" stroke-linecap="round" aria-hidden="true">
                            <circle cx="12" cy="12" r="9"></circle>
                            <path d="M12 11v5M12 7.8v.1"></path>
                        </svg>
                        <h2>Receipt details</h2>
                    </div>
                    <div class="pfm-card-bd">
                        <div class="pfm-fields">
                            <div class="pfm-lab">
                                <span class="pfm-lab-t">Posting date</span>
                                <NocturneDateField Id="grpo-c-doc-date" @bind-Date="goodsReceipt.DocDate"
                                                   AriaLabel="Posting date" />
                            </div>
                            <div class="pfm-lab">
                                <span class="pfm-lab-t">Due date</span>
                                <NocturneDateField Id="grpo-c-due-date" @bind-Date="goodsReceipt.DocDueDate"
                                                   AriaLabel="Due date" />
                            </div>
                            <label class="pfm-lab">
                                <span class="pfm-lab-t">Currency</span>
                                <input class="pfm-input" type="text" placeholder="USD"
                                       @bind="goodsReceipt.DocCurrency" />
                            </label>
                            <label class="pfm-lab">
                                <span class="pfm-lab-t">Supplier reference</span>
                                <input class="pfm-input" type="text" placeholder="The supplier's own number"
                                       @bind="goodsReceipt.NumAtCard" />
                            </label>
                            <label class="pfm-lab">
                                <span class="pfm-lab-t">Header discount %</span>
                                <input class="pfm-input" type="number" step="0.01"
                                       @bind-value="goodsReceipt.DiscountPercent" />
                            </label>
                            <label class="pfm-lab pfm-span3">
                                <span class="pfm-lab-t">Comments</span>
                                <textarea class="pfm-area" rows="3" placeholder="Optional notes for SAP"
                                          @bind="goodsReceipt.Comments"></textarea>
                            </label>
                        </div>
                    </div>
                </section>

                <section class="pfm-card">
                    <div class="pfm-card-hd">
                        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                             stroke-width="1.7" stroke-linecap="round" aria-hidden="true">
                            <path d="M8 6h12M8 12h12M8 18h12M4 6v.01M4 12v.01M4 18v.01"></path>
                        </svg>
                        <h2>Received lines</h2>
                        <span class="pfm-count">@goodsReceipt.Lines.Count</span>
                        <span class="pfm-spacer"></span>
                        <button type="button" class="pfm-btn pfm-btn-accent" @onclick="AddLine">
                            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                 stroke-width="2" stroke-linecap="round" aria-hidden="true">
                                <path d="M12 5v14M5 12h14"></path>
                            </svg>
                            <span>Add line</span>
                        </button>
                    </div>

                    @if (HasError("Lines"))
                    {
                        <div class="pfm-card-bd" style="padding-bottom:0">
                            <div class="pfm-err-panel">
                                <div class="pfm-err-panel-t">@GetError("Lines")</div>
                            </div>
                        </div>
                    }

                    <div class="pfm-lines">
                        <div class="pfm-lines-inner">
                            <div class="pfm-row is-head">
                                <span>#</span>
                                <span>Item</span>
                                <span>Description</span>
                                <span class="pfm-r">Qty</span>
                                <span class="pfm-r">Unit price</span>
                                <span>Warehouse</span>
                                <span>Tax</span>
                                <span class="pfm-r">PO entry</span>
                                <span class="pfm-r">PO line</span>
                                <span class="pfm-r">Total</span>
                                <span></span>
                            </div>

                            @for (var index = 0; index < goodsReceipt.Lines.Count; index++)
                            {
                                var lineIndex = index;
                                var line = goodsReceipt.Lines[lineIndex];

                                <div class="pfm-row">
                                    <span class="pfm-n">@(lineIndex + 1)</span>
                                    <input class="pfm-input pfm-cell @(HasError($"Lines[{lineIndex}].ItemCode") ? "is-bad" : "")"
                                           list="goods-receipt-products" placeholder="Item code"
                                           @bind="line.ItemCode" @onblur="() => SyncProduct(lineIndex)" />
                                    <input class="pfm-input pfm-desc" placeholder="Description"
                                           @bind="line.ItemDescription" />
                                    <input class="pfm-input pfm-num @(HasError($"Lines[{lineIndex}].Quantity") ? "is-bad" : "")"
                                           type="number" step="0.01" @bind-value="line.Quantity" />
                                    <input class="pfm-input pfm-num @(HasError($"Lines[{lineIndex}].UnitPrice") ? "is-bad" : "")"
                                           type="number" step="0.01" @bind-value="line.UnitPrice" />
                                    <input class="pfm-input pfm-cell" list="goods-receipt-warehouses"
                                           placeholder="Warehouse" @bind="line.WarehouseCode" />
                                    <input class="pfm-input pfm-cell" placeholder="Tax" @bind="line.TaxCode" />
                                    @* The order line this receipt closes. Optional — a receipt can
                                       be posted without one — but SAP only ties the two documents
                                       together when both are given. *@
                                    <input class="pfm-input pfm-num" type="number" @bind-value="line.BaseEntry" />
                                    <input class="pfm-input pfm-num" type="number" @bind-value="line.BaseLine" />
                                    <span class="pfm-amt-v pfm-r">@CalculateLineTotal(line).ToString("N2")</span>
                                    <button type="button" class="pfm-btn-x" aria-label="Remove this line"
                                            disabled="@(goodsReceipt.Lines.Count == 1)"
                                            @onclick="() => RemoveLine(lineIndex)">
                                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"
                                             stroke-linecap="round" aria-hidden="true">
                                            <path d="M6 6l12 12M18 6L6 18"></path>
                                        </svg>
                                    </button>

                                    @if (HasError($"Lines[{lineIndex}].ItemCode") || HasError($"Lines[{lineIndex}].Quantity")
                                        || HasError($"Lines[{lineIndex}].UnitPrice"))
                                    {
                                        <span class="pfm-row-err">
                                            @(HasError($"Lines[{lineIndex}].ItemCode")
                                                ? GetError($"Lines[{lineIndex}].ItemCode")
                                                : HasError($"Lines[{lineIndex}].Quantity")
                                                    ? GetError($"Lines[{lineIndex}].Quantity")
                                                    : GetError($"Lines[{lineIndex}].UnitPrice"))
                                        </span>
                                    }
                                </div>
                            }

                            <button type="button" class="pfm-addline" @onclick="AddLine">
                                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                     stroke-width="2" stroke-linecap="round" aria-hidden="true">
                                    <path d="M12 5v14M5 12h14"></path>
                                </svg>
                                <span>Add another line</span>
                            </button>
                        </div>
                    </div>
                </section>
            </div>

            <aside class="pfm-aside">
                <section class="pfm-card pfm-total-card">
                    <div class="pfm-total-hd">
                        <span class="pfm-total-k">Estimated total</span>
                        <span class="pfm-total-cur">@goodsReceipt.DocCurrency</span>
                    </div>
                    <div class="pfm-total-v">@EstimatedTotal.ToString("N2")</div>

                    <div class="pfm-gap-md">
                        <div class="pfm-sum">
                            <span>Subtotal</span>
                            <span class="pfm-sum-v">@SubTotal.ToString("N2")</span>
                        </div>
                        <div class="pfm-sum">
                            <span>Header discount</span>
                            <span class="pfm-sum-v">@HeaderDiscountAmount.ToString("N2")</span>
                        </div>
                        <div class="pfm-sum-rule" aria-hidden="true"></div>
                        <div class="pfm-sum">
                            <span>Lines</span>
                            <span class="pfm-sum-v">@goodsReceipt.Lines.Count</span>
                        </div>
                    </div>

                    <div class="pfm-gap-md">
                        <button type="button" class="pfm-btn-solid" @onclick="SubmitAsync"
                                disabled="@(isSubmitting || isLoadingLookups)">
                            @if (isSubmitting)
                            {
                                <span class="pfm-spin on-solid" aria-hidden="true"></span>
                                <span>Creating&#8230;</span>
                            }
                            else
                            {
                                <span>Create receipt</span>
                            }
                        </button>
                        <button type="button" class="pfm-btn pfm-btn-wide" style="margin-top:8px"
                                disabled="@isSubmitting" @onclick="GoBack">
                            Cancel
                        </button>
                    </div>
                </section>

                <section class="pfm-card pfm-panel">
                    <div class="pfm-panel-hd">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                             stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <path d="M5 12.5l4.5 4.5L19 7"></path>
                        </svg>
                        <span>Before posting</span>
                    </div>
                    <div class="pfm-checks">
                        <div class="pfm-checks-i @(selectedSupplier is null ? "is-no" : "")">
                            <span class="pfm-checks-ic">
                                <svg width="9" height="9" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                     stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                    <path d="M5 12.5l4.5 4.5L19 7"></path>
                                </svg>
                            </span>
                            <span>A supplier is chosen</span>
                        </div>
                        <div class="pfm-checks-i @(goodsReceipt.Lines.Any(l => !string.IsNullOrWhiteSpace(l.ItemCode)) ? "" : "is-no")">
                            <span class="pfm-checks-ic">
                                <svg width="9" height="9" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                     stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                    <path d="M5 12.5l4.5 4.5L19 7"></path>
                                </svg>
                            </span>
                            <span>At least one line has an item</span>
                        </div>
                    </div>
                </section>

                <div class="pfm-info-note">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"
                         stroke-linecap="round" aria-hidden="true">
                        <circle cx="12" cy="12" r="9"></circle>
                        <path d="M12 11v5M12 7.8v.1"></path>
                    </svg>
                    <span>
                        Give the PO entry and line where this receipt should close specific
                        purchase-order lines in SAP. The base document type is fixed to purchase order.
                    </span>
                </div>
            </aside>
        </div>
    </div>
</div>
