@page "/credit-notes"
@using MediatR
@using Microsoft.AspNetCore.Authorization
@using ShopInventory.Web.Features.CreditNotes.Commands.ApproveCreditNote
@using ShopInventory.Web.Features.CreditNotes.Commands.BulkCancelCreditNotes
@using ShopInventory.Web.Features.CreditNotes.Commands.DeleteCreditNote
@using ShopInventory.Web.Features.CreditNotes.Commands.DuplicateCancelledCreditNotes
@using ShopInventory.Web.Features.CreditNotes.Queries.GetCreditNotes
@attribute [Authorize(Roles = "Admin,Cashier")]
@inject IMediator Mediator
@inject ICreditNoteService CreditNoteService
@inject IInvoiceService InvoiceService
@inject ILogger<CreditNotes> Logger
@inject IAppSettingsProvider AppSettings
@inject IAuditService AuditService
@inject ISnackbar Snackbar
@inject IJSRuntime JS
@rendermode InteractiveServer

<PageTitle>Credit Notes - Shop Inventory</PageTitle>

@* The imported Nocturne design is dark; wwwroot/css/credit-notes.css (linked
   from App.razor) carries it and its light counterpart, and follows the app's
   theme toggle like every other page. Icon-only buttons draw their glyph
   inline rather than from the Phosphor font: the glyph is their whole label,
   so a font that fails to load would leave them reading as dead controls. *@

<div class="cnx">

    <header class="cnx-head">
        <div class="cnx-shell">
            <div class="cnx-titles">
                <div class="cnx-titles-row">
                    <i class="ph ph-receipt" aria-hidden="true"></i>
                    <h1 class="cnx-title">Credit Notes</h1>
                </div>
                <p class="cnx-sub">Customer credits and adjustments</p>
            </div>
            <div class="cnx-head-actions">
                <span class="cnx-count">@totalCount.ToString("N0") notes</span>
                <a class="cnx-btn cnx-btn-primary" href="/credit-notes/create">
                    <i class="ph ph-plus" aria-hidden="true"></i>New credit note
                </a>
            </div>
        </div>
        <div class="cnx-rule"></div>
    </header>

    <div class="cnx-body">

        @if (!string.IsNullOrEmpty(errorMessage))
        {
            <div class="cnx-alert" role="alert">
                <i class="ph ph-warning-octagon" aria-hidden="true"></i>
                <div class="cnx-alert-body">@errorMessage</div>
                <button type="button" class="cnx-btn cnx-btn-ghost cnx-btn-icon-sm" title="Dismiss"
                        aria-label="Dismiss error" @onclick="() => errorMessage = null">
                    <svg viewBox="0 0 256 256" aria-hidden="true" focusable="false">
                        <path d="M205.66,194.34a8,8,0,0,1-11.32,11.32L128,139.31,61.66,205.66a8,8,0,0,1-11.32-11.32L116.69,128,50.34,61.66A8,8,0,0,1,61.66,50.34L128,116.69l66.34-66.35a8,8,0,0,1,11.32,11.32L139.31,128Z" />
                    </svg>
                </button>
            </div>
        }

        <section class="cnx-filters">
            <div class="cnx-field" style="width:132px">
                <label for="cnx-f-number">Credit note #</label>
                <input id="cnx-f-number" class="cnx-input cnx-input-num" type="text" placeholder="CN-001"
                       @bind="creditNoteNumberFilter" @bind:event="oninput" @onkeydown="HandleFilterKeyDown" />
            </div>
            <div class="cnx-field" style="width:196px">
                <label for="cnx-f-customer">Customer</label>
                <input id="cnx-f-customer" class="cnx-input" type="text" placeholder="Code or name"
                       @bind="customerFilter" @bind:event="oninput" @onkeydown="HandleFilterKeyDown" />
            </div>
            <div class="cnx-field" style="width:150px">
                <label for="cnx-f-status">Status</label>
                <div class="cnx-select">
                    <select id="cnx-f-status" class="cnx-input" @bind="statusFilter" @bind:after="ApplyFilters">
                        <option value="">All statuses</option>
                        @foreach (CreditNoteStatus status in Enum.GetValues<CreditNoteStatus>())
                        {
                            <option value="@(((int)status).ToString())">@status</option>
                        }
                    </select>
                    <span class="cnx-caret" aria-hidden="true"></span>
                </div>
            </div>
            <div class="cnx-field" style="width:150px">
                <label for="cnx-f-fiscal">Fiscal state</label>
                <div class="cnx-select">
                    <select id="cnx-f-fiscal" class="cnx-input" @bind="fiscalStatusFilter" @bind:after="ApplyFilters">
                        <option value="">All fiscal states</option>
                        <option value="Fiscalised">Fiscalised</option>
                        <option value="Not Fiscalised">Not Fiscalised</option>
                        <option value="Unknown">Unknown</option>
                    </select>
                    <span class="cnx-caret" aria-hidden="true"></span>
                </div>
            </div>
            <div class="cnx-field" style="width:134px">
                <label for="cnx-f-from">From date</label>
                <input id="cnx-f-from" class="cnx-input cnx-input-num" type="date" @bind="fromDate" />
            </div>
            <div class="cnx-field" style="width:134px">
                <label for="cnx-f-to">To date</label>
                <input id="cnx-f-to" class="cnx-input cnx-input-num" type="date" @bind="toDate" />
            </div>
            <div class="cnx-filter-actions">
                @if (FiltersActive)
                {
                    <button type="button" class="cnx-btn cnx-btn-ghost" @onclick="ClearFilter">Clear</button>
                }
                <button type="button" class="cnx-btn cnx-btn-secondary" @onclick="ApplyFilters">
                    <i class="ph ph-magnifying-glass" aria-hidden="true"></i>Apply
                </button>
            </div>
        </section>

        <section class="cnx-card">

            <div class="cnx-toolbar">
                @if (SelectedCreditNoteCount > 0)
                {
                    <span class="cnx-selected">
                        <span class="cnx-pip" aria-hidden="true"></span>@SelectedCreditNoteCount selected
                    </span>
                    <div class="cnx-toolbar-actions">
                        <button type="button" class="cnx-btn cnx-btn-secondary cnx-btn-sm"
                                title="Cancel the selected SAP credit notes" @onclick="OpenBulkCancelModal"
                                disabled="@(!CanOpenBulkCancel)">
                            <i class="ph ph-prohibit" aria-hidden="true"></i>Cancel selected
                        </button>
                        <button type="button" class="cnx-btn cnx-btn-secondary cnx-btn-sm"
                                title="Create replacements for the selected cancelled credit notes"
                                @onclick="OpenDuplicateCancelledModal" disabled="@(!CanOpenDuplicateCancelled)">
                            <i class="ph ph-copy" aria-hidden="true"></i>Duplicate
                        </button>
                        <button type="button" class="cnx-btn cnx-btn-ghost cnx-btn-sm" @onclick="ClearSelection">
                            Deselect
                        </button>
                    </div>
                }
                else
                {
                    <span class="cnx-range">@RangeLabel</span>
                    <span class="cnx-hint">
                        <i class="ph ph-cursor-click" aria-hidden="true"></i>Select rows to cancel or duplicate
                    </span>
                }
            </div>

            <div class="cnx-tablewrap">
                <table class="cnx-table">
                    <thead>
                        <tr>
                            <th>
                                <input class="cnx-check" type="checkbox" title="Select visible credit notes"
                                       aria-label="Select visible credit notes"
                                       checked="@AreAllDisplayedCreditNotesSelected()"
                                       @onchange="ToggleAllDisplayedCreditNotes" />
                            </th>
                            <th class="cnx-th-sort" @onclick="() => SortBy(SortKey.Number)">
                                Note #<span class="cnx-sort-mark">@SortMark(SortKey.Number)</span>
                            </th>
                            <th>Customer</th>
                            <th class="cnx-th-sort" @onclick="() => SortBy(SortKey.Date)">
                                Date<span class="cnx-sort-mark">@SortMark(SortKey.Date)</span>
                            </th>
                            <th>Type</th>
                            <th>Status</th>
                            <th>Fiscal</th>
                            <th>Reason</th>
                            <th class="cnx-th-sort cnx-num" @onclick="() => SortBy(SortKey.Total)">
                                Total<span class="cnx-sort-mark">@SortMark(SortKey.Total)</span>
                            </th>
                            <th class="cnx-num">Balance</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (isLoading)
                        {
                            @for (var skeletonRow = 0; skeletonRow < 8; skeletonRow++)
                            {
                                <tr>
                                    @for (var skeletonCell = 0; skeletonCell < 11; skeletonCell++)
                                    {
                                        <td><div class="cnx-skel"></div></td>
                                    }
                                </tr>
                            }
                        }
                        else
                        {
                            @foreach (var note in pageRows)
                            {
                                <tr @key="GetCreditNoteSelectionKey(note)" class="@GetRowClass(note)">
                                    <td>
                                        <input class="cnx-check" type="checkbox" title="Select credit note"
                                               aria-label="Select credit note @FormatCreditNoteNumber(note.CreditNoteNumber)"
                                               checked="@IsCreditNoteSelected(note)"
                                               disabled="@(!CanSelectCreditNote(note))"
                                               @onchange="args => ToggleCreditNoteSelection(note, args)" />
                                    </td>
                                    <td>
                                        <button type="button" class="cnx-link" @onclick="() => ViewCreditNote(note)">
                                            @FormatCreditNoteNumber(note.CreditNoteNumber)
                                        </button>
                                    </td>
                                    <td>
                                        <span class="cnx-cust">
                                            <span class="cnx-cust-name">@note.CardName</span>
                                            <span class="cnx-cust-code">@note.CardCode</span>
                                        </span>
                                    </td>
                                    <td class="cnx-date">@note.CreditNoteDate.ToString("dd MMM yyyy")</td>
                                    <td><span class="cnx-tag">@note.TypeName</span></td>
                                    <td>
                                        <span class="cnx-status">
                                            <span class="cnx-dot @GetStatusDotClass(note.Status)" aria-hidden="true"></span>
                                            <span class="cnx-status-text @(note.Status == CreditNoteStatus.Applied ? "is-applied" : "")">@note.StatusName</span>
                                        </span>
                                    </td>
                                    <td class="cnx-fiscal">@note.FiscalizationStatus</td>
                                    <td>
                                        <span class="cnx-reason" title="@note.Reason">@(string.IsNullOrWhiteSpace(note.Reason) ? "—" : note.Reason)</span>
                                    </td>
                                    <td class="cnx-num">@note.DocTotal.ToString("N2")</td>
                                    <td class="cnx-num">
                                        <span class="cnx-bal @(HasOpenBalance(note) ? "is-open" : "")">
                                            @(HasOpenBalance(note) ? note.Balance.ToString("N2") : "—")
                                        </span>
                                    </td>
                                    <td>
                                        <span class="cnx-rowactions">
                                            <button type="button" class="cnx-btn cnx-btn-ghost cnx-btn-icon-sm"
                                                    title="View credit note" aria-label="View credit note"
                                                    @onclick="() => ViewCreditNote(note)">
                                                <svg viewBox="0 0 256 256" aria-hidden="true" focusable="false">
                                                    <path d="M247.31,124.76c-.35-.79-8.82-19.58-27.65-38.41C194.57,61.26,162,48,128,48S61.43,61.26,36.34,86.35C17.51,105.18,9,124,8.69,124.76a8,8,0,0,0,0,6.5c.35.79,8.82,19.57,27.65,38.4C61.43,194.74,94,208,128,208s66.57-13.26,91.66-38.34c18.83-18.83,27.3-37.61,27.65-38.4A8,8,0,0,0,247.31,124.76ZM128,192c-30.78,0-57.67-11.19-79.93-33.25A133.47,133.47,0,0,1,25,128,133.33,133.33,0,0,1,48.07,97.25C70.33,75.19,97.22,64,128,64s57.67,11.19,79.93,33.25A133.46,133.46,0,0,1,231.05,128C223.84,141.46,192.43,192,128,192Zm0-112a48,48,0,1,0,48,48A48,48,0,0,0,128,80Zm0,80a32,32,0,1,1,32-32A32,32,0,0,1,128,160Z" />
                                                </svg>
                                            </button>
                                            @if (note.Status == CreditNoteStatus.Pending)
                                            {
                                                <button type="button" class="cnx-btn cnx-btn-ghost cnx-btn-icon-sm"
                                                        title="Approve" aria-label="Approve credit note"
                                                        @onclick="() => ApproveCreditNote(note.Id)">
                                                    <svg viewBox="0 0 256 256" aria-hidden="true" focusable="false">
                                                        <path d="M229.66,77.66l-128,128a8,8,0,0,1-11.32,0l-56-56a8,8,0,0,1,11.32-11.32L96,188.69,218.34,66.34a8,8,0,0,1,11.32,11.32Z" />
                                                    </svg>
                                                </button>
                                            }
                                            @if (note.Status == CreditNoteStatus.Draft || note.Status == CreditNoteStatus.Cancelled)
                                            {
                                                <button type="button" class="cnx-btn cnx-btn-ghost cnx-btn-icon-sm"
                                                        title="Delete" aria-label="Delete credit note"
                                                        @onclick="() => DeleteCreditNote(note.Id)">
                                                    <svg viewBox="0 0 256 256" aria-hidden="true" focusable="false">
                                                        <path d="M216,48H176V40a24,24,0,0,0-24-24H104A24,24,0,0,0,80,40v8H40a8,8,0,0,0,0,16h8V208a16,16,0,0,0,16,16H192a16,16,0,0,0,16-16V64h8a8,8,0,0,0,0-16ZM96,40a8,8,0,0,1,8-8h48a8,8,0,0,1,8,8v8H96Zm96,168H64V64H192ZM112,104v64a8,8,0,0,1-16,0V104a8,8,0,0,1,16,0Zm48,0v64a8,8,0,0,1-16,0V104a8,8,0,0,1,16,0Z" />
                                                    </svg>
                                                </button>
                                            }
                                        </span>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>

            @if (!isLoading && totalCount == 0)
            {
                <div class="cnx-empty">
                    <i class="ph ph-funnel-simple" aria-hidden="true"></i>
                    <span>No credit notes match these filters</span>
                    @if (FiltersActive)
                    {
                        <button type="button" class="cnx-btn cnx-btn-ghost cnx-btn-sm" @onclick="ClearFilter">
                            Clear filters
                        </button>
                    }
                </div>
            }

            <div class="cnx-foot">
                <span class="cnx-foot-range">@RangeLabel</span>
                <div class="cnx-pager">
                    <button type="button" class="cnx-btn cnx-btn-secondary cnx-btn-icon" title="Previous page"
                            aria-label="Previous page" disabled="@(currentPage <= 1)" @onclick="PreviousPage">
                        <svg viewBox="0 0 256 256" aria-hidden="true" focusable="false">
                            <path d="M165.66,202.34a8,8,0,0,1-11.32,11.32l-80-80a8,8,0,0,1,0-11.32l80-80a8,8,0,0,1,11.32,11.32L91.31,128Z" />
                        </svg>
                    </button>
                    <span class="cnx-page-label">Page @currentPage / @totalPages</span>
                    <button type="button" class="cnx-btn cnx-btn-secondary cnx-btn-icon" title="Next page"
                            aria-label="Next page" disabled="@(currentPage >= totalPages)" @onclick="NextPage">
                        <svg viewBox="0 0 256 256" aria-hidden="true" focusable="false">
                            <path d="M181.66,133.66l-80,80a8,8,0,0,1-11.32-11.32L164.69,128,90.34,53.66a8,8,0,0,1,11.32-11.32l80,80A8,8,0,0,1,181.66,133.66Z" />
                        </svg>
                    </button>
                </div>
            </div>
        </section>
    </div>
</div>

@if (selectedCreditNote != null)
{
    <div class="cnx-overlay">
        <div class="cnx-scrim" @onclick="CloseCreditNoteDetails"></div>
        <aside class="cnx-drawer" aria-label="Credit note details">
            <div class="cnx-drawer-head">
                <h2 class="cnx-drawer-title">
                    <i class="ph ph-receipt" aria-hidden="true"></i>
                    @FormatCreditNoteNumber(selectedCreditNote.CreditNoteNumber)
                </h2>
                <button type="button" class="cnx-btn cnx-btn-ghost cnx-btn-icon" title="Close"
                        aria-label="Close details" @onclick="CloseCreditNoteDetails">
                    <svg viewBox="0 0 256 256" aria-hidden="true" focusable="false">
                        <path d="M205.66,194.34a8,8,0,0,1-11.32,11.32L128,139.31,61.66,205.66a8,8,0,0,1-11.32-11.32L116.69,128,50.34,61.66A8,8,0,0,1,61.66,50.34L128,116.69l66.34-66.35a8,8,0,0,1,11.32,11.32L139.31,128Z" />
                    </svg>
                </button>
            </div>
            <div class="cnx-drawer-body">
                <div class="cnx-grid">
                    <div>
                        <div class="cnx-dt">Customer</div>
                        <div class="cnx-dd">@selectedCreditNote.CardCode — @selectedCreditNote.CardName</div>
                    </div>
                    <div>
                        <div class="cnx-dt">Date</div>
                        <div class="cnx-dd">@selectedCreditNote.CreditNoteDate.ToString("dd MMM yyyy")</div>
                    </div>
                    <div>
                        <div class="cnx-dt">Type</div>
                        <div class="cnx-dd"><span class="cnx-tag">@selectedCreditNote.TypeName</span></div>
                    </div>
                    <div>
                        <div class="cnx-dt">Status</div>
                        <div class="cnx-dd">
                            <span class="cnx-status">
                                <span class="cnx-dot @GetStatusDotClass(selectedCreditNote.Status)" aria-hidden="true"></span>
                                <span class="cnx-status-text @(selectedCreditNote.Status == CreditNoteStatus.Applied ? "is-applied" : "")">@selectedCreditNote.StatusName</span>
                            </span>
                        </div>
                    </div>
                    <div>
                        <div class="cnx-dt">Fiscal status</div>
                        <div class="cnx-dd">@selectedCreditNote.FiscalizationStatus</div>
                    </div>
                    <div>
                        <div class="cnx-dt">Currency</div>
                        <div class="cnx-dd">@selectedCreditNote.Currency</div>
                    </div>
                    @if (selectedCreditNote.FiscalReceiptGlobalNo.HasValue)
                    {
                        <div>
                            <div class="cnx-dt">Fiscal receipt #</div>
                            <div class="cnx-dd">@selectedCreditNote.FiscalReceiptGlobalNo</div>
                        </div>
                    }
                    <div>
                        <div class="cnx-dt">Restock items</div>
                        <div class="cnx-dd">@(selectedCreditNote.RestockItems ? "Yes" : "No")</div>
                    </div>
                </div>

                @if (!string.IsNullOrEmpty(selectedCreditNote.Reason))
                {
                    <div class="cnx-note">
                        <div class="cnx-dt">Reason</div>
                        @selectedCreditNote.Reason
                    </div>
                }

                @if (selectedCreditNote.OriginalInvoiceDocEntry.HasValue)
                {
                    <div>
                        <div class="cnx-sect"><i class="ph ph-link" aria-hidden="true"></i>Source invoice</div>
                        @if (isLoadingSourceInvoice)
                        {
                            <div class="cnx-note">Fetching the linked invoice details…</div>
                        }
                        else if (selectedSourceInvoice != null)
                        {
                            <div class="cnx-grid">
                                <div>
                                    <div class="cnx-dt">Invoice #</div>
                                    <div class="cnx-dd">@selectedSourceInvoice.DocNum</div>
                                </div>
                                <div>
                                    <div class="cnx-dt">Doc entry</div>
                                    <div class="cnx-dd">@selectedSourceInvoice.DocEntry</div>
                                </div>
                                <div>
                                    <div class="cnx-dt">Customer</div>
                                    <div class="cnx-dd">@selectedSourceInvoice.CardCode — @selectedSourceInvoice.CardName</div>
                                </div>
                                <div>
                                    <div class="cnx-dt">Invoice date</div>
                                    <div class="cnx-dd">@FormatDate(selectedSourceInvoice.DocDate)</div>
                                </div>
                                <div>
                                    <div class="cnx-dt">Currency</div>
                                    <div class="cnx-dd">@selectedSourceInvoice.DocCurrency</div>
                                </div>
                                <div>
                                    <div class="cnx-dt">Invoice total</div>
                                    <div class="cnx-dd">@selectedSourceInvoice.DocTotal.ToString("N2")</div>
                                </div>
                                @if (!string.IsNullOrWhiteSpace(selectedSourceInvoice.NumAtCard))
                                {
                                    <div>
                                        <div class="cnx-dt">Reference</div>
                                        <div class="cnx-dd">@selectedSourceInvoice.NumAtCard</div>
                                    </div>
                                }
                            </div>
                        }
                        else
                        {
                            <div class="cnx-note">Linked invoice DocEntry: @selectedCreditNote.OriginalInvoiceDocEntry</div>
                        }
                    </div>
                }

                @if (isLoadingDetail)
                {
                    <div>
                        <div class="cnx-sect"><i class="ph ph-list-bullets" aria-hidden="true"></i>Credit note lines</div>
                        <div class="cnx-note">Fetching the document from SAP…</div>
                    </div>
                }
                else if (detailUnavailable)
                {
                    <div>
                        <div class="cnx-sect"><i class="ph ph-list-bullets" aria-hidden="true"></i>Credit note lines</div>
                        <div class="cnx-note">
                            The lines could not be read from SAP. The totals above come from the local
                            projection and are current as of the last synchronisation.
                        </div>
                    </div>
                }
                else if (selectedCreditNote.Lines?.Any() == true)
                {
                    <div>
                        <div class="cnx-sect"><i class="ph ph-list-bullets" aria-hidden="true"></i>Credit note lines</div>
                        <table class="cnx-lines">
                            <thead>
                                <tr>
                                    <th>Item</th>
                                    <th>Description</th>
                                    <th class="cnx-num">Qty</th>
                                    <th class="cnx-num">Unit price</th>
                                    <th class="cnx-num">Total</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var line in selectedCreditNote.Lines)
                                {
                                    <tr>
                                        <td><span class="cnx-cust-name">@line.ItemCode</span></td>
                                        <td>@line.ItemDescription</td>
                                        <td class="cnx-num">@QuantityDisplay.Format(line.Quantity)</td>
                                        <td class="cnx-num">@line.UnitPrice.ToString("N2")</td>
                                        <td class="cnx-num">@line.LineTotal.ToString("N2")</td>
                                    </tr>
                                }
                            </tbody>
                            <tfoot>
                                <tr>
                                    <td colspan="4" class="cnx-num">Subtotal</td>
                                    <td class="cnx-num">@selectedCreditNote.SubTotal.ToString("N2")</td>
                                </tr>
                                <tr>
                                    <td colspan="4" class="cnx-num">Tax</td>
                                    <td class="cnx-num">@selectedCreditNote.TaxAmount.ToString("N2")</td>
                                </tr>
                            </tfoot>
                        </table>

                        <div class="cnx-total" style="margin-top:var(--cnx-s4)">
                            <span class="cnx-total-label">Total</span>
                            <span class="cnx-total-value">@selectedCreditNote.DocTotal.ToString("N2")</span>
                        </div>
                    </div>
                }
            </div>
            <div class="cnx-drawer-foot">
                <button type="button" class="cnx-btn cnx-btn-secondary" @onclick="CloseCreditNoteDetails">Close</button>
            </div>
        </aside>
    </div>
}

@if (showBulkCancelModal)
{
    <div class="cnx-overlay">
        <div class="cnx-dialog-wrap" @onclick="CloseBulkCancelModal">
            <div class="cnx-dialog" role="dialog" aria-modal="true" aria-label="Cancel credit notes"
                 @onclick:stopPropagation="true">
                <h2 class="cnx-dialog-title"><i class="ph ph-prohibit" aria-hidden="true"></i>Cancel credit notes</h2>
                <div class="cnx-dialog-body">
                    <div class="cnx-confirm">
                        <span class="cnx-confirm-count">@SelectedCancelableCreditNoteCount</span>
                        <div>
                            <div class="cnx-confirm-copy">Cancel selected SAP credit notes</div>
                            <div class="cnx-confirm-sub">Already cancelled and unsynced rows are excluded.</div>
                        </div>
                    </div>
                    <div class="cnx-field">
                        <label for="cnx-cancel-reason">Reason</label>
                        <textarea id="cnx-cancel-reason" class="cnx-input cnx-textarea" @bind="bulkCancelReason"
                                  placeholder="Optional cancellation note"></textarea>
                    </div>
                </div>
                <div class="cnx-dialog-actions">
                    <button type="button" class="cnx-btn cnx-btn-secondary" @onclick="CloseBulkCancelModal"
                            disabled="@isBulkCancelling">Close</button>
                    <button type="button" class="cnx-btn cnx-btn-bad" @onclick="BulkCancelSelectedAsync"
                            disabled="@(isBulkCancelling || SelectedCancelableCreditNoteCount == 0)">
                        @if (isBulkCancelling)
                        {
                            <span class="cnx-spin" aria-hidden="true"></span>
                        }
                        <span>Cancel @SelectedCancelableCreditNoteCount</span>
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@if (showDuplicateCancelledModal)
{
    <div class="cnx-overlay">
        <div class="cnx-dialog-wrap" @onclick="CloseDuplicateCancelledModal">
            <div class="cnx-dialog" role="dialog" aria-modal="true" aria-label="Duplicate cancelled credit notes"
                 @onclick:stopPropagation="true">
                <h2 class="cnx-dialog-title"><i class="ph ph-copy" aria-hidden="true"></i>Duplicate cancelled</h2>
                <div class="cnx-dialog-body">
                    <div class="cnx-confirm">
                        <span class="cnx-confirm-count">@SelectedCancelledCreditNoteCount</span>
                        <div>
                            <div class="cnx-confirm-copy">Create replacement credit notes</div>
                            <div class="cnx-confirm-sub">An Excel file downloads after SAP returns the new numbers.</div>
                        </div>
                    </div>
                    <div class="cnx-field">
                        <label for="cnx-dup-reason">Reason</label>
                        <textarea id="cnx-dup-reason" class="cnx-input cnx-textarea" @bind="duplicateCancelledReason"
                                  placeholder="Optional reason for the replacement credit notes"></textarea>
                    </div>
                </div>
                <div class="cnx-dialog-actions">
                    <button type="button" class="cnx-btn cnx-btn-secondary" @onclick="CloseDuplicateCancelledModal"
                            disabled="@isDuplicatingCancelled">Close</button>
                    <button type="button" class="cnx-btn cnx-btn-primary" @onclick="DuplicateCancelledSelectedAsync"
                            disabled="@(isDuplicatingCancelled || SelectedCancelledCreditNoteCount == 0)">
                        @if (isDuplicatingCancelled)
                        {
                            <span class="cnx-spin" aria-hidden="true"></span>
                        }
                        <span>Duplicate @SelectedCancelledCreditNoteCount</span>
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private enum SortKey { Number, Date, Total }

    /// <summary>
    /// The date range is the server-side filter; everything else is applied here, so the fetch asks
    /// for the whole range in one go rather than paging the API.
    /// </summary>
    private const int FetchPageSize = 10000;

    /// <summary>
    /// The whole filtered result set, kept sorted; <see cref="pageRows"/> is the slice on screen.
    /// </summary>
    private List<CreditNoteDto> creditNotes = new();
    private List<CreditNoteDto> pageRows = new();

    private CreditNoteDto? selectedCreditNote;
    private InvoiceDto? selectedSourceInvoice;
    private bool isLoading = true;
    private bool isLoadingSourceInvoice;
    private bool isLoadingDetail;
    private bool detailUnavailable;

    /// <summary>Which row the drawer was opened on, so a slow fetch cannot land in a later one.</summary>
    private int? openDetailKey;
    private string? errorMessage;
    private readonly HashSet<int> selectedCreditNoteDocEntries = new();
    private bool showBulkCancelModal;
    private bool showDuplicateCancelledModal;
    private bool isBulkCancelling;
    private bool isDuplicatingCancelled;
    private string? bulkCancelReason;
    private string? duplicateCancelledReason;

    // Filters — the pending values the fields bind to, and the applied values the list reflects.
    private string? creditNoteNumberFilter;
    private string? customerFilter;
    private string? statusFilter;
    private string? fiscalStatusFilter;
    private DateTime? fromDate;
    private DateTime? toDate;
    private string? appliedCreditNoteNumberFilter;
    private string? appliedCustomerFilter;
    private string? appliedStatusFilter;
    private string? appliedFiscalStatusFilter;
    private DateTime? appliedFromDate;
    private DateTime? appliedToDate;

    // Paging and sorting are done here rather than in a table component: the design's
    // pager is prev/next over a fixed page size, and the sort is on three columns.
    private int currentPage = 1;
    private int pageSize = 25;
    private int totalPages = 1;
    private int totalCount;
    private SortKey sortKey = SortKey.Number;
    private bool sortAscending;

    private DateTime DefaultFromDate => new(DateTime.Today.Year, DateTime.Today.Month, 1);

    private string RangeLabel
    {
        get
        {
            if (isLoading)
            {
                return "Loading…";
            }

            if (totalCount == 0)
            {
                return "No results";
            }

            var first = ((currentPage - 1) * pageSize) + 1;
            var last = Math.Min(currentPage * pageSize, totalCount);
            return $"{first}–{last} of {totalCount:N0}";
        }
    }

    private bool FiltersActive =>
        !string.IsNullOrWhiteSpace(creditNoteNumberFilter)
        || !string.IsNullOrWhiteSpace(customerFilter)
        || !string.IsNullOrWhiteSpace(statusFilter)
        || !string.IsNullOrWhiteSpace(fiscalStatusFilter)
        || fromDate?.Date != DefaultFromDate
        || toDate?.Date != DateTime.Today;

    private IReadOnlyList<CreditNoteDto> SelectedCreditNotes => creditNotes
        .Where(note => selectedCreditNoteDocEntries.Contains(GetCreditNoteSelectionKey(note)))
        .ToList();

    private int SelectedCreditNoteCount => SelectedCreditNotes.Count;

    private int SelectedCancelableCreditNoteCount => GetSelectedCancelableDocEntries().Count;

    private int SelectedCancelledCreditNoteCount => GetSelectedCancelledDocEntries().Count;

    private bool CanOpenBulkCancel =>
        !isLoading && !isBulkCancelling && !isDuplicatingCancelled && SelectedCancelableCreditNoteCount > 0;

    private bool CanOpenDuplicateCancelled =>
        !isLoading && !isBulkCancelling && !isDuplicatingCancelled && SelectedCancelledCreditNoteCount > 0;

    private static int GetCreditNoteSelectionKey(CreditNoteDto note) => note.SAPDocEntry ?? note.Id;

    private static bool CanSelectCreditNote(CreditNoteDto note) => note.SAPDocEntry.HasValue;

    private static bool CanCancelCreditNote(CreditNoteDto note) =>
        note.SAPDocEntry.HasValue && note.Status != CreditNoteStatus.Cancelled;

    private static bool CanDuplicateCreditNote(CreditNoteDto note) =>
        note.SAPDocEntry.HasValue && note.Status == CreditNoteStatus.Cancelled;

    private bool IsCreditNoteSelected(CreditNoteDto note) =>
        selectedCreditNoteDocEntries.Contains(GetCreditNoteSelectionKey(note));

    /// <summary>
    /// The header checkbox covers the rows on screen, not the whole result set — the design's
    /// bulk actions read as acting on what the user can see.
    /// </summary>
    private bool AreAllDisplayedCreditNotesSelected()
    {
        var selectable = pageRows.Where(CanSelectCreditNote).ToList();
        return selectable.Count > 0 && selectable.All(IsCreditNoteSelected);
    }

    private void ToggleAllDisplayedCreditNotes(ChangeEventArgs args)
    {
        var isSelected = IsChecked(args);
        foreach (var note in pageRows.Where(CanSelectCreditNote))
        {
            SetCreditNoteSelection(note, isSelected);
        }
    }

    private void ToggleCreditNoteSelection(CreditNoteDto note, ChangeEventArgs args) =>
        SetCreditNoteSelection(note, IsChecked(args));

    private void SetCreditNoteSelection(CreditNoteDto note, bool isSelected)
    {
        if (!CanSelectCreditNote(note))
        {
            return;
        }

        var key = GetCreditNoteSelectionKey(note);
        if (isSelected)
        {
            selectedCreditNoteDocEntries.Add(key);
        }
        else
        {
            selectedCreditNoteDocEntries.Remove(key);
        }
    }

    private void ClearSelection() => selectedCreditNoteDocEntries.Clear();

    private static bool IsChecked(ChangeEventArgs args) =>
        args.Value is bool value
            ? value
            : string.Equals(args.Value?.ToString(), "true", StringComparison.OrdinalIgnoreCase)
              || string.Equals(args.Value?.ToString(), "on", StringComparison.OrdinalIgnoreCase);

    private List<int> GetSelectedCancelableDocEntries() => SelectedCreditNotes
        .Where(CanCancelCreditNote)
        .Select(note => note.SAPDocEntry!.Value)
        .Distinct()
        .ToList();

    private List<int> GetSelectedCancelledDocEntries() => SelectedCreditNotes
        .Where(CanDuplicateCreditNote)
        .Select(note => note.SAPDocEntry!.Value)
        .Distinct()
        .ToList();

    private void RemoveSelectedDocEntries(IEnumerable<int> docEntries)
    {
        foreach (var docEntry in docEntries)
        {
            selectedCreditNoteDocEntries.Remove(docEntry);
        }
    }

    private void PruneSelectedCreditNotes()
    {
        var currentKeys = creditNotes
            .Where(CanSelectCreditNote)
            .Select(GetCreditNoteSelectionKey)
            .ToHashSet();

        selectedCreditNoteDocEntries.RemoveWhere(key => !currentKeys.Contains(key));
    }

    protected override void OnInitialized()
    {
        pageSize = Math.Max(1, AppSettings.PageSize);
        // Default the range to the current month so the SAP query is always date-filtered.
        fromDate = DefaultFromDate;
        toDate = DateTime.Today;
        SyncAppliedFilters();
    }

    /// <summary>
    /// The list is fetched after the first render, not in OnInitializedAsync: the SAP read is the
    /// slow part of this page, and awaiting it before the first render left the whole page blank
    /// for its duration. The shell and the skeleton rows paint immediately instead.
    /// </summary>
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        await LoadCreditNotes();

        // The audit write is not on the path to showing the list, so it does not hold it up.
        _ = LogViewAsync();
    }

    private async Task LogViewAsync()
    {
        try
        {
            await AuditService.LogAsync(AuditActions.ViewCreditNotes, "CreditNote", null);
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Failed to record the credit-notes view in the audit trail");
        }
    }

    private async Task LoadCreditNotes()
    {
        isLoading = true;
        errorMessage = null;
        StateHasChanged();

        try
        {
            var result = await Mediator.Send(new GetCreditNotesQuery(
                1,
                FetchPageSize,
                null,
                null,
                appliedFromDate,
                appliedToDate));

            if (!result.IsError)
            {
                creditNotes = ApplyVisibleCreditNoteFilters(result.Value.CreditNotes ?? new List<CreditNoteDto>());
                PruneSelectedCreditNotes();
                SortCreditNotes();
                currentPage = 1;
                RecomputePage();
            }
            else
            {
                errorMessage = result.FirstError.Description;
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to load credit notes");
            errorMessage = "Failed to load credit notes.";
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    private void SortCreditNotes()
    {
        var direction = sortAscending ? 1 : -1;
        creditNotes.Sort((left, right) => direction * (sortKey switch
        {
            SortKey.Date => left.CreditNoteDate.CompareTo(right.CreditNoteDate),
            SortKey.Total => left.DocTotal.CompareTo(right.DocTotal),
            _ => (left.SAPDocNum ?? left.Id).CompareTo(right.SAPDocNum ?? right.Id)
        }));
    }

    private void RecomputePage()
    {
        totalCount = creditNotes.Count;
        totalPages = Math.Max(1, (int)Math.Ceiling(totalCount / (double)pageSize));
        currentPage = Math.Clamp(currentPage, 1, totalPages);
        pageRows = creditNotes
            .Skip((currentPage - 1) * pageSize)
            .Take(pageSize)
            .ToList();
    }

    private void SortBy(SortKey key)
    {
        // A fresh column starts descending — newest note, latest date, largest total first.
        sortAscending = sortKey == key && !sortAscending;
        sortKey = key;
        SortCreditNotes();
        currentPage = 1;
        RecomputePage();
    }

    private string SortMark(SortKey key) => sortKey != key ? string.Empty : sortAscending ? "▲" : "▼";

    private void PreviousPage()
    {
        currentPage = Math.Max(1, currentPage - 1);
        RecomputePage();
    }

    private void NextPage()
    {
        currentPage = Math.Min(totalPages, currentPage + 1);
        RecomputePage();
    }

    private static string? NormalizeFilterValue(string? value) =>
        string.IsNullOrWhiteSpace(value) ? null : value.Trim();

    private void SyncAppliedFilters()
    {
        appliedCreditNoteNumberFilter = NormalizeFilterValue(creditNoteNumberFilter);
        appliedCustomerFilter = NormalizeFilterValue(customerFilter);
        appliedStatusFilter = NormalizeFilterValue(statusFilter);
        appliedFiscalStatusFilter = NormalizeFilterValue(fiscalStatusFilter);
        appliedFromDate = fromDate?.Date;
        appliedToDate = toDate?.Date;
    }

    private async Task ApplyFilters()
    {
        SyncAppliedFilters();
        await LoadCreditNotes();
    }

    private async Task HandleFilterKeyDown(KeyboardEventArgs args)
    {
        if (!string.Equals(args.Key, "Enter", StringComparison.OrdinalIgnoreCase))
        {
            return;
        }

        await ApplyFilters();
    }

    private async Task ClearFilter()
    {
        creditNoteNumberFilter = null;
        customerFilter = null;
        statusFilter = null;
        fiscalStatusFilter = null;
        fromDate = DefaultFromDate;
        toDate = DateTime.Today;
        await ApplyFilters();
    }

    private List<CreditNoteDto> ApplyVisibleCreditNoteFilters(IEnumerable<CreditNoteDto> source)
    {
        var status = ParseStatusFilter(appliedStatusFilter);

        return source
            .Where(note => string.IsNullOrWhiteSpace(appliedCustomerFilter)
                || MatchesCustomerFilter(note, appliedCustomerFilter))
            .Where(note => !status.HasValue || note.Status == status.Value)
            .Where(note => string.IsNullOrWhiteSpace(appliedFiscalStatusFilter)
                || MatchesFiscalStatus(note.FiscalizationStatus, appliedFiscalStatusFilter))
            .Where(note => string.IsNullOrWhiteSpace(appliedCreditNoteNumberFilter)
                || (note.CreditNoteNumber?.Contains(appliedCreditNoteNumberFilter, StringComparison.OrdinalIgnoreCase) == true))
            .ToList();
    }

    private static CreditNoteStatus? ParseStatusFilter(string? filterValue)
        => int.TryParse(filterValue, out var statusValue) && Enum.IsDefined(typeof(CreditNoteStatus), statusValue)
            ? (CreditNoteStatus)statusValue
            : null;

    private static bool MatchesCustomerFilter(CreditNoteDto note, string customerFilter)
        => (note.CardCode?.Contains(customerFilter, StringComparison.OrdinalIgnoreCase) == true)
            || (note.CardName?.Contains(customerFilter, StringComparison.OrdinalIgnoreCase) == true);

    private static bool MatchesFiscalStatus(string? actualStatus, string? filterStatus)
        => NormalizeFiscalStatus(actualStatus) == NormalizeFiscalStatus(filterStatus);

    private static string NormalizeFiscalStatus(string? status)
        => status?.Trim().ToLowerInvariant() switch
        {
            "fiscalised" => "fiscalised",
            "not fiscalised" => "not fiscalised",
            _ => "unknown"
        };

    /// <summary>
    /// Opens the drawer on the row's own header, then fetches the document. The list is served from
    /// the local SAP projection, which keeps headers only — the lines and the link to the original
    /// invoice come from this per-document read, the same way the quotations list works.
    /// </summary>
    private async Task ViewCreditNote(CreditNoteDto note)
    {
        var requestKey = GetCreditNoteSelectionKey(note);

        selectedCreditNote = note;
        selectedSourceInvoice = null;
        isLoadingSourceInvoice = false;
        isLoadingDetail = true;
        detailUnavailable = false;
        openDetailKey = requestKey;

        try
        {
            var detail = await CreditNoteService.GetCreditNoteByIdAsync(requestKey);

            // The drawer may have been closed, or reopened on another row, while this was in flight.
            if (openDetailKey != requestKey)
            {
                return;
            }

            if (detail is null)
            {
                detailUnavailable = true;
                return;
            }

            selectedCreditNote = detail;
            isLoadingDetail = false;

            if (!detail.OriginalInvoiceDocEntry.HasValue)
            {
                return;
            }

            isLoadingSourceInvoice = true;
            StateHasChanged();

            var invoice = await InvoiceService.GetInvoiceByDocEntryAsync(detail.OriginalInvoiceDocEntry.Value);
            if (openDetailKey == requestKey)
            {
                selectedSourceInvoice = invoice;
            }
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Failed to load detail for credit note {DocEntry}", requestKey);

            if (openDetailKey == requestKey)
            {
                detailUnavailable = true;
            }
        }
        finally
        {
            if (openDetailKey == requestKey)
            {
                isLoadingDetail = false;
                isLoadingSourceInvoice = false;
            }
        }
    }

    private void CloseCreditNoteDetails()
    {
        selectedCreditNote = null;
        selectedSourceInvoice = null;
        isLoadingSourceInvoice = false;
        isLoadingDetail = false;
        detailUnavailable = false;
        openDetailKey = null;
    }

    private static string FormatDate(string? dateStr)
    {
        if (string.IsNullOrWhiteSpace(dateStr))
        {
            return "—";
        }

        return DateTime.TryParse(dateStr, out var date)
            ? date.ToString("dd MMM yyyy")
            : dateStr;
    }

    private async Task ApproveCreditNote(int id)
    {
        var result = await Mediator.Send(new ApproveCreditNoteCommand(id));
        if (result.IsError)
        {
            Snackbar.Add(result.FirstError.Description, Severity.Error);
            return;
        }

        Snackbar.Add("Credit note approved.", Severity.Success);
        await LoadCreditNotes();
    }

    private async Task DeleteCreditNote(int id)
    {
        var result = await Mediator.Send(new DeleteCreditNoteCommand(id));
        if (result.IsError)
        {
            Snackbar.Add(result.FirstError.Description, Severity.Error);
            return;
        }

        Snackbar.Add("Credit note deleted.", Severity.Success);
        await LoadCreditNotes();
    }

    private void OpenBulkCancelModal()
    {
        if (!CanOpenBulkCancel)
        {
            Snackbar.Add("Select SAP credit notes that are not cancelled.", Severity.Warning);
            return;
        }

        bulkCancelReason = null;
        showBulkCancelModal = true;
    }

    private void CloseBulkCancelModal()
    {
        if (isBulkCancelling)
        {
            return;
        }

        showBulkCancelModal = false;
        bulkCancelReason = null;
    }

    private async Task BulkCancelSelectedAsync()
    {
        var docEntries = GetSelectedCancelableDocEntries();
        if (docEntries.Count == 0)
        {
            Snackbar.Add("Select SAP credit notes that are not cancelled.", Severity.Warning);
            return;
        }

        isBulkCancelling = true;
        errorMessage = null;

        try
        {
            var result = await Mediator.Send(new BulkCancelCreditNotesCommand(docEntries, bulkCancelReason));
            if (result.IsError)
            {
                Snackbar.Add(result.FirstError.Description, Severity.Error);
                return;
            }

            var response = result.Value;
            var severity = response.FailedCount == 0
                ? Severity.Success
                : response.SuccessCount > 0 ? Severity.Warning : Severity.Error;

            Snackbar.Add($"Cancelled {response.SuccessCount} of {response.RequestedCount} credit notes.", severity);
            showBulkCancelModal = false;
            bulkCancelReason = null;
            RemoveSelectedDocEntries(docEntries);
            await LoadCreditNotes();
        }
        catch (FluentValidation.ValidationException ex)
        {
            Snackbar.Add(ex.Errors.FirstOrDefault()?.ErrorMessage ?? "Select at least one credit note.", Severity.Warning);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Bulk credit note cancellation failed");
            Snackbar.Add("Failed to cancel selected credit notes.", Severity.Error);
        }
        finally
        {
            isBulkCancelling = false;
        }
    }

    private void OpenDuplicateCancelledModal()
    {
        if (!CanOpenDuplicateCancelled)
        {
            Snackbar.Add("Select cancelled SAP credit notes to duplicate.", Severity.Warning);
            return;
        }

        duplicateCancelledReason = null;
        showDuplicateCancelledModal = true;
    }

    private void CloseDuplicateCancelledModal()
    {
        if (isDuplicatingCancelled)
        {
            return;
        }

        showDuplicateCancelledModal = false;
        duplicateCancelledReason = null;
    }

    private async Task DuplicateCancelledSelectedAsync()
    {
        var docEntries = GetSelectedCancelledDocEntries();
        if (docEntries.Count == 0)
        {
            Snackbar.Add("Select cancelled SAP credit notes to duplicate.", Severity.Warning);
            return;
        }

        isDuplicatingCancelled = true;
        errorMessage = null;

        try
        {
            var result = await Mediator.Send(new DuplicateCancelledCreditNotesCommand(docEntries, duplicateCancelledReason));
            if (result.IsError)
            {
                Snackbar.Add(result.FirstError.Description, Severity.Error);
                return;
            }

            var export = result.Value;
            await JS.InvokeVoidAsync("downloadFile", export.FileName, export.ContentType, export.Base64Content);

            var response = export.OperationResult;
            var severity = response.FailedCount == 0
                ? Severity.Success
                : response.SuccessCount > 0 ? Severity.Warning : Severity.Error;

            Snackbar.Add($"Duplicated {response.SuccessCount} of {response.RequestedCount} credit notes.", severity);
            showDuplicateCancelledModal = false;
            duplicateCancelledReason = null;
            RemoveSelectedDocEntries(docEntries);
            await LoadCreditNotes();
        }
        catch (FluentValidation.ValidationException ex)
        {
            Snackbar.Add(ex.Errors.FirstOrDefault()?.ErrorMessage ?? "Select at least one cancelled credit note.",
Severity.Warning);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Cancelled credit note duplication failed");
            Snackbar.Add("Failed to duplicate selected credit notes.", Severity.Error);
        }
        finally
        {
            isDuplicatingCancelled = false;
        }
    }

    private static bool IsVoid(CreditNoteStatus status) =>
        status is CreditNoteStatus.Cancelled or CreditNoteStatus.Voided;

    /// <summary>
    /// The design tints a selected row with the accent, drops drafts and voided rows to 66% so the
    /// live notes carry the eye, and strikes voided ones through.
    /// </summary>
    private string GetRowClass(CreditNoteDto note)
    {
        var classes = new List<string>(3);

        if (IsCreditNoteSelected(note))
        {
            classes.Add("is-selected");
        }

        if (IsVoid(note.Status) || note.Status == CreditNoteStatus.Draft)
        {
            classes.Add("is-dim");
        }

        if (IsVoid(note.Status))
        {
            classes.Add("is-void");
        }

        return string.Join(' ', classes);
    }

    /// <summary>
    /// The design paints the accent dot on applied notes, a mid neutral on the ones still open,
    /// and progressively fainter neutrals on drafts and voided rows.
    /// </summary>
    private static string GetStatusDotClass(CreditNoteStatus status) => status switch
    {
        CreditNoteStatus.Applied => "is-applied",
        CreditNoteStatus.Draft => "is-draft",
        CreditNoteStatus.Cancelled or CreditNoteStatus.Voided => "is-void",
        _ => string.Empty
    };

    private static bool HasOpenBalance(CreditNoteDto note) => note.Balance > 0 && !IsVoid(note.Status);

    private static string FormatCreditNoteNumber(string? creditNoteNumber)
    {
        if (string.IsNullOrEmpty(creditNoteNumber)) return "—";
        if (creditNoteNumber.StartsWith("SAP-CN", StringComparison.OrdinalIgnoreCase))
        {
            return creditNoteNumber.Substring(6).TrimStart('-', ' ');
        }
        return creditNoteNumber;
    }
}
