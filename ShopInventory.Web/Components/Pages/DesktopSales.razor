@* The credit dialog, which used to be written out here in full. It is now shared with the vending
   and van sale lists, which had no way to raise a credit at all — see DesktopCreditNoteDialog. *@
<DesktopCreditNoteDialog Reference="@creditSale?.ExternalReferenceId"
                         SaleNumber="@creditSale?.Number"
                         Currency="@creditSale?.Currency"
                         IsConsolidated="@(creditSale?.ConsolidationId is not null)"
                         OnClosed="CloseDesktopCredit" />

@code {
    // ── The credit dialog ────────────────────────────────────────────────
    //
    // Only what opening and closing it needs. Everything the dialog itself does — the receipt, the
    // line selection, the reasons, the two submit actions, chasing a stalled credit — moved into
    // DesktopCreditNoteDialog when the vending and van sale lists needed the same thing.

    private DesktopSaleDto? creditSale;

    private async Task OpenDesktopCredit()
    {
        creditSale = selectedSale;
        selectedSale = null;
        // The dialog loads itself from the reference; nothing to read here.
        await Task.CompletedTask;
    }

    /// <summary>
    /// Closes the credit dialog back to the sale it was opened from, with its credits re-read.
    /// </summary>
    /// <remarks>
    /// The dialog is opened from the drawer and takes its place, so closing it returns there rather
    /// than to the bare list — and a credit just raised has to show in the drawer's own block, which
    /// was read before the dialog existed.
    /// </remarks>
    private async Task CloseDesktopCredit()
    {
        selectedSale = creditSale;
        creditSale = null;
        await LoadDrawerCredits();
    }


    private const string PeriodToday = "today";
    private const string PeriodWeek = "week";
    private const string PeriodMonth = "month";
    private const string PeriodCustom = "custom";

    private sealed record Choice(string Value, string Label);

    private static readonly Choice[] PeriodOptions =
    [
        new(PeriodToday, "Today"),
        new(PeriodWeek, "Last 7 days"),
        new(PeriodMonth, "Last 30 days"),
        new(PeriodCustom, "Range")
    ];

    private static readonly Choice[] PaymentDifferenceOptions =
    [
        new(PaidAny, "Any"),
        new(PaidExact, "Exact"),
        new(PaidUnder, "Underpaid"),
        new(PaidOver, "Overpaid")
    ];

    private const string PaidAny = "any";
    private const string PaidExact = "exact";
    private const string PaidUnder = "under";
    private const string PaidOver = "over";

    /// <summary>
    /// How the whole result set is ordered, which is the API's job and not this page's.
    /// </summary>
    /// <remarks>
    /// Sorting the fifty rows this page holds would be sorting a page of the answer rather than the
    /// answer, and "total, high to low" would name the largest sale on page three instead of the
    /// largest sale. Newest is marked unset because it is the resting order, not a choice somebody
    /// made — the trigger would otherwise sit in its "something is set" state from first paint.
    /// </remarks>
    private static readonly NocturneSelectOption<string>[] SortOptions =
    [
        new("newest", "Newest first") { IsUnset = true },
        new("oldest", "Oldest first"),
        new("total-desc", "Total, high to low"),
        new("total-asc", "Total, low to high"),
        new("customer", "Customer")
    ];

    private static readonly NocturneSelectOption<int>[] PageSizeOptions =
    [
        new(10, "10"),
        new(25, "25"),
        new(50, "50") { IsUnset = true },
        new(100, "100"),
        new(200, "200")
    ];

    /// <summary>
    /// What to call a stored <c>SourceSystem</c>.
    /// </summary>
    /// <remarks>
    /// The channel chips are drawn from what the period actually holds rather than from a list kept
    /// here, so this names the ones it can and lets anything else through as the API spells it — a
    /// source added to a till before it is added here must still be reachable.
    ///
    /// The online van source is absent on purpose, and so is its row: those are receipt carriers whose
    /// invoice reached SAP through a reservation, they are not sales awaiting anything, and the API's
    /// default scope already leaves them out of both the list and this facet.
    /// </remarks>
    private static string ChannelName(string? source) => source switch
    {
        "KefalosShopTill" => "Shop till",
        "KefalosVending" => "Vending",
        "KefalosVanSales" => "Van sales",
        "DESKTOP_APP" => "Legacy desktop",
        DesktopSalesFilterValues.Blank => "Not recorded",
        _ => Blank(source)
    };

    private List<DesktopSaleDto> sales = new();
    private DesktopSaleDto? selectedSale;
    private EndOfDayReportDto? report;

    private bool isLoading;
    private bool isConsolidating;
    private bool isExporting;
    private bool showConsolidate;
    private DateTime? lastPolledAt;

    // ── Posting to SAP ───────────────────────────────────────────────────
    //
    // Selection is held by external reference rather than by row index or by the DTO itself: a
    // SignalR push reloads this page underneath the operator, and after it every `DesktopSaleDto`
    // in `sales` is a different object. Keyed on the reference, a selection survives that reload —
    // and the reference is what the API is sent anyway.

    private readonly HashSet<string> selected = new(StringComparer.Ordinal);

    private bool isPosting;

    /// <summary>The one sale a single post is in flight for, so only its button spins.</summary>
    private string? postingReference;

    /// <summary>A fiscalisation retry is in flight for the sale open in the drawer.</summary>
    private bool isRetryingFiscal;

    private bool showBulkPost;
    private DesktopSalesBulkPostResultDto? bulkResult;

    private List<DesktopSaleDto> postableOnPage => sales.Where(s => s.CanPostToSap).ToList();

    private bool allPostableSelected =>
        postableOnPage.Count > 0 && postableOnPage.All(s => selected.Contains(s.ExternalReferenceId));

    private decimal selectedValue =>
        sales.Where(s => selected.Contains(s.ExternalReferenceId)).Sum(s => s.TotalAmount);

    // One notice for everything this page does itself; the Snackbar is left to
    // the push events, which arrive while the user is looking elsewhere.
    private string? notice;
    private string noticeFamily = "ops-fam-info";
    private string noticeIcon = "ph-info";

    // ── Filters ──────────────────────────────────────────────────────────
    //
    // Five of these are sets rather than single values, which is the change the design's third
    // revision asked for and the reason `GET sales` grew plural parameters. Held as ordered sets so
    // that the pills below read in the order the chips were pressed rather than in an order that
    // shuffles as a HashSet rehashes.
    //
    // The period is deliberately not one of the filters `filterCount` counts. It is where the
    // operator is looking, not a narrowing of it: the day is the page's subject, and a "1 filter"
    // badge on an untouched page would be the panel's first lie.

    private readonly List<string> pickedWarehouses = [];
    private readonly List<string> pickedConsolidation = [];
    private readonly List<string> pickedFiscal = [];
    private readonly List<string> pickedPayments = [];
    private readonly List<string> pickedChannels = [];

    private string filterSearch = "";
    private string filterCardCode = "";
    private string amountMin = "";
    private string amountMax = "";
    private string paidCompare = PaidAny;
    private string sort = "newest";

    private string period = PeriodToday;
    private DateTime? filterFromDate;
    private DateTime? filterToDate;

    /// <summary>Whether the chip panel is showing. Open on arrival, as the design draws it.</summary>
    private bool filtersOpen = true;

    // Pagination
    private int currentPage = 1;
    private int pageSize = 50;
    private int totalCount;

    /// <summary>What the period holds before the panel narrowed it, for "filtered from N".</summary>
    private int unfilteredCount;

    private bool hasMore;
    private int totalPages => totalCount > 0 ? (int)Math.Ceiling((double)totalCount / pageSize) : 1;

    /// <summary>What each chip group would return, as the API counted it. Null before the first load.</summary>
    private DesktopSalesFacetsDto? facets;

    private int filterCount => activeFilters.Count;

    /// <summary>Whether the operator is looking for one sale rather than reading a day.</summary>
    /// <remarks>
    /// While this is true the period is not sent, so the search reaches the whole history. The two
    /// cannot both apply: a credit is raised against a sale that was made before today, and a search
    /// that silently kept the date filter would report the sale as missing.
    ///
    /// Everything else in the panel still applies. A search finds; it does not widen.
    /// </remarks>
    private bool IsSearching => !string.IsNullOrWhiteSpace(filterSearch);

    protected override async Task OnInitializedAsync()
    {
        filterFromDate = DateTime.Today;
        filterToDate = DateTime.Today;

        await LoadData();
        await AuditService.LogAsync(AuditActions.ViewDesktopTransactions, "DesktopSale", null);

        HubService.OnDesktopSaleCreated += OnSaleCreated;
        HubService.OnConsolidationCompleted += OnConsolidationDone;
    }

    private async void OnSaleCreated()
    {
        await InvokeAsync(async () =>
        {
            Snackbar.Add("New desktop sale received", Severity.Info);
            await LoadData();
            StateHasChanged();
        });
    }

    private async void OnConsolidationDone()
    {
        await InvokeAsync(async () =>
        {
            Snackbar.Add("Consolidation completed — data refreshed", Severity.Success);
            await LoadData();
            StateHasChanged();
        });
    }

    // ── Loading ──────────────────────────────────────────────────────────

    private async Task LoadData()
    {
        isLoading = true;
        StateHasChanged();

        try
        {
            var response = await DesktopService.GetDesktopSalesAsync(new DesktopSalesQuery
            {
                Search = Trimmed(filterSearch),
                CardCode = Trimmed(filterCardCode),
                Warehouses = pickedWarehouses,
                ConsolidationStatuses = pickedConsolidation,
                FiscalizationStatuses = pickedFiscal,
                PaymentMethods = pickedPayments,
                SourceSystems = pickedChannels,
                MinTotal = Amount(amountMin),
                MaxTotal = Amount(amountMax),
                PaymentDifference = paidCompare == PaidAny ? null : paidCompare,
                Sort = sort,
                // Not while searching. A customer returns goods days after buying them, so a search
                // pinned to Today would answer "no such sale" for the ordinary case — see IsSearching.
                FromDate = IsSearching ? null : filterFromDate,
                ToDate = IsSearching ? null : filterToDate,
                Page = currentPage,
                PageSize = pageSize,

                // The filter panel draws them, so they are worth the five grouped counts they cost.
                IncludeFacets = true
            });

            if (response != null)
            {
                sales = response.Sales;
                totalCount = response.TotalCount;
                hasMore = response.HasMore;
                facets = response.Facets;

                // Never below the total. An API that predates facets sends neither, and a page that
                // took its zero would draw "filtered from 0" beside a list of fifty.
                unfilteredCount = Math.Max(response.UnfilteredCount, response.TotalCount);
                lastPolledAt = DateTime.Now;

                // After every reload, including the ones a SignalR push triggers. A sale that has
                // just posted is no longer postable, so this is also what takes it back out of the
                // selection when somebody else posted it while this page was open.
                PruneSelection();

                ClearError();
            }
            else
            {
                SayError("Failed to load desktop sales. Check that the API is running.");
            }

            report = await DesktopService.GetEndOfDayReportAsync(filterFromDate);
        }
        catch (Exception ex)
        {
            SayError($"Error: {ex.Message}");
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task RefreshData()
    {
        currentPage = 1;
        await LoadData();
    }

    // ── Filters ──────────────────────────────────────────────────────────
    // Every one of these is a single deliberate act — picking a warehouse,
    // committing a card code, choosing a period — so each reloads on its own
    // rather than waiting behind a Search button the design does not draw.

    private async Task ApplyFilters()
    {
        currentPage = 1;
        await LoadData();
    }

    private async Task SetPeriod(string value)
    {
        if (period == value)
        {
            return;
        }

        period = value;

        if (value == PeriodToday)
        {
            filterFromDate = DateTime.Today;
            filterToDate = DateTime.Today;
        }
        else if (value == PeriodWeek)
        {
            filterFromDate = DateTime.Today.AddDays(-6);
            filterToDate = DateTime.Today;
        }
        else if (value == PeriodMonth)
        {
            filterFromDate = DateTime.Today.AddDays(-29);
            filterToDate = DateTime.Today;
        }
        // "custom" keeps whatever pair is already in the fields and reveals them.

        await ApplyFilters();
    }

    private async Task OnFromDateChanged(DateTime? value)
    {
        filterFromDate = value;
        await ApplyFilters();
    }

    private async Task OnToDateChanged(DateTime? value)
    {
        filterToDate = value;
        await ApplyFilters();
    }

    private async Task SetPaidCompare(string value)
    {
        if (paidCompare == value)
        {
            return;
        }

        paidCompare = value;
        await ApplyFilters();
    }

    /// <summary>Changes how many rows a page holds, back to the first page.</summary>
    /// <remarks>
    /// Back to page one because the page the operator is on does not survive the change. On 200 rows
    /// a page, page four of a 900-row set is rows 601–800; on 10 it does not exist.
    /// </remarks>
    private async Task SetPageSize(int value)
    {
        if (pageSize == value)
        {
            return;
        }

        pageSize = value;
        await ApplyFilters();
    }

    /// <summary>Picks a chip up or puts it down, and reloads.</summary>
    /// <remarks>
    /// Appended rather than inserted, so the pills read in the order they were pressed.
    /// </remarks>
    private async Task ToggleChip(ChipGroupKey key, string value)
    {
        var picked = PickedFor(key);

        if (!picked.Remove(value))
        {
            picked.Add(value);
        }

        await ApplyFilters();
    }

    private List<string> PickedFor(ChipGroupKey key) => key switch
    {
        ChipGroupKey.Consolidation => pickedConsolidation,
        ChipGroupKey.Fiscal => pickedFiscal,
        ChipGroupKey.Warehouse => pickedWarehouses,
        ChipGroupKey.Payment => pickedPayments,
        _ => pickedChannels
    };

    /// <summary>
    /// Everything the panel set, dropped at once — and nothing else.
    /// </summary>
    /// <remarks>
    /// The period stays. It is where the operator is looking rather than a narrowing of it, and a
    /// Clear that quietly threw a week away and went back to today would be the one press on this
    /// page that loses work.
    /// </remarks>
    private async Task ClearFilters()
    {
        pickedWarehouses.Clear();
        pickedConsolidation.Clear();
        pickedFiscal.Clear();
        pickedPayments.Clear();
        pickedChannels.Clear();

        filterSearch = "";
        filterCardCode = "";
        amountMin = "";
        amountMax = "";
        paidCompare = PaidAny;

        await ApplyFilters();
    }

    // ── The chip groups ──────────────────────────────────────────────────
    //
    // Drawn from the counts the API sends rather than from lists kept here, which is what makes a
    // chip a promise: it exists because a sale exists behind it, and the number on it is what
    // pressing it would give. The two enum groups are ordered as a person reads them — awaiting,
    // closed, broken, left out — rather than by count, which would reshuffle the row on every
    // reload; the three open-ended ones keep the API's order, which is largest first.
    //
    // A value that is picked but has nothing left to match keeps a chip at zero. Dropping it would
    // leave a filter that is on, is narrowing the list, and has no control anywhere to turn it off.

    private enum ChipGroupKey { Consolidation, Fiscal, Warehouse, Payment, Channel }

    private sealed record Chip(string Value, string Label, int Count, string? Family, bool IsOn);

    private sealed record ChipGroup(ChipGroupKey Key, string Name, List<Chip> Chips);

    private static readonly string[] ConsolidationOrder = ["Pending", "Consolidated", "Failed", "Excluded"];
    private static readonly string[] FiscalOrder = ["Success", "Pending", "Failed", "Skipped"];

    private List<ChipGroup> ChipGroups =>
    [
        new(ChipGroupKey.Consolidation, "Consolidation",
            Chips(facets?.Consolidation, pickedConsolidation, ConsolidationLabel, ConsolidationFamily, ConsolidationOrder)),
        new(ChipGroupKey.Fiscal, "Fiscal result",
            Chips(facets?.Fiscalization, pickedFiscal, Blank, FiscalFamily, FiscalOrder)),
        new(ChipGroupKey.Warehouse, "Warehouse",
            Chips(facets?.Warehouse, pickedWarehouses, Blank, _ => null)),
        new(ChipGroupKey.Payment, "Payment method",
            Chips(facets?.PaymentMethod, pickedPayments, TenderName, _ => null)),
        new(ChipGroupKey.Channel, "Channel",
            Chips(facets?.SourceSystem, pickedChannels, ChannelName, _ => null))
    ];

    private static List<Chip> Chips(
        List<DesktopSalesFacetDto>? counted,
        List<string> picked,
        Func<string?, string> label,
        Func<string?, string?> family,
        string[]? order = null)
    {
        var counts = (counted ?? [])
            .GroupBy(facet => facet.Value, StringComparer.Ordinal)
            .ToDictionary(g => g.Key, g => g.Sum(facet => facet.Count), StringComparer.Ordinal);

        // What the period holds, plus anything picked that it no longer does.
        var values = counts.Keys
            .Union(picked, StringComparer.Ordinal)
            .ToList();

        if (order is not null)
        {
            // The stated order first, then anything the API knows about and this page does not — a
            // status added to the enum must still be reachable rather than silently dropped.
            values = values
                .OrderBy(value => Array.FindIndex(order, o => string.Equals(o, value, StringComparison.OrdinalIgnoreCase)) is var i && i >= 0 ? i : order.Length)
                .ThenBy(value => value, StringComparer.Ordinal)
                .ToList();
        }

        return values
            .Select(value => new Chip(
                value,
                label(value),
                counts.GetValueOrDefault(value),
                family(value),
                picked.Contains(value, StringComparer.Ordinal)))
            .ToList();
    }

    // ── What is set ──────────────────────────────────────────────────────

    private sealed record Pill(string Group, string Label, Func<Task> Remove);

    /// <summary>
    /// Every filter the panel has set, each with the means to take it off.
    /// </summary>
    /// <remarks>
    /// This is also what the "Filters" badge counts, so the badge and the pills cannot disagree about
    /// how many there are. The period is not here — see the filter fields above for why.
    /// </remarks>
    private List<Pill> activeFilters
    {
        get
        {
            var pills = new List<Pill>();

            void Group(ChipGroupKey key, string name, Func<string?, string> label)
            {
                foreach (var value in PickedFor(key).ToList())
                {
                    pills.Add(new Pill(name, label(value), () => ToggleChip(key, value)));
                }
            }

            Group(ChipGroupKey.Consolidation, "Consolidation", ConsolidationLabel);
            Group(ChipGroupKey.Fiscal, "Fiscal", Blank);
            Group(ChipGroupKey.Warehouse, "Warehouse", Blank);
            Group(ChipGroupKey.Payment, "Payment", TenderName);
            Group(ChipGroupKey.Channel, "Channel", ChannelName);

            if (!string.IsNullOrWhiteSpace(filterSearch))
            {
                pills.Add(new Pill("Search", filterSearch.Trim(), async () =>
                {
                    filterSearch = "";
                    await ApplyFilters();
                }));
            }

            if (!string.IsNullOrWhiteSpace(filterCardCode))
            {
                pills.Add(new Pill("Customer", filterCardCode.Trim(), async () =>
                {
                    filterCardCode = "";
                    await ApplyFilters();
                }));
            }

            // One pill for the window rather than two, because half an amount range is not a filter
            // anybody set on purpose — the two ends are one thought and come off together.
            if (Amount(amountMin) is not null || Amount(amountMax) is not null)
            {
                var low = Amount(amountMin);
                var high = Amount(amountMax);
                var label = low is null ? $"up to {high:N2}"
                    : high is null ? $"from {low:N2}"
                    : $"{low:N2}–{high:N2}";

                pills.Add(new Pill("Total", label, async () =>
                {
                    amountMin = "";
                    amountMax = "";
                    await ApplyFilters();
                }));
            }

            if (paidCompare != PaidAny)
            {
                var label = PaymentDifferenceOptions.First(o => o.Value == paidCompare).Label;
                pills.Add(new Pill("Payment", label, () => SetPaidCompare(PaidAny)));
            }

            return pills;
        }
    }

    /// <summary>The text of a filter field, or null where the field is empty.</summary>
    private static string? Trimmed(string? value) =>
        string.IsNullOrWhiteSpace(value) ? null : value.Trim();

    /// <summary>
    /// One end of the amount window, or null where it is empty or is not a number.
    /// </summary>
    /// <remarks>
    /// Invariant, because this becomes a query-string value the API parses invariantly — a browser
    /// in a comma-decimal locale would otherwise send "12,50" and be read as twelve. Unparseable text
    /// is no filter rather than a zero: half-typed input must not empty the list under the operator.
    /// </remarks>
    private static decimal? Amount(string? text) =>
        decimal.TryParse(Trimmed(text), NumberStyles.Number, CultureInfo.InvariantCulture, out var value)
            ? value
            : null;

    // ── Paging ───────────────────────────────────────────────────────────

    private async Task NextPage()
    {
        if (hasMore)
        {
            currentPage++;
            await LoadData();
        }
    }

    private async Task PreviousPage()
    {
        if (currentPage > 1)
        {
            currentPage--;
            await LoadData();
        }
    }

    // ── The detail drawer ────────────────────────────────────────────────

    private async Task SelectSale(DesktopSaleDto sale)
    {
        selectedSale = sale;
        await LoadDrawerCredits();
    }

    private void CloseDrawer()
    {
        selectedSale = null;
        drawerCredits = [];
        drawerCreditsError = null;
    }

    // ── What has been credited back ──────────────────────────────────────
    //
    // The credits against the open sale, read when the drawer opens. They are not on the list row:
    // a credit is rare, a page is fifty rows, and reading them per row would put fifty queries
    // behind a list that is refreshed by every SignalR push.
    //
    // Keyed by reference so that a reply arriving after the operator has stepped to the next sale is
    // dropped rather than shown against the wrong one — the drawer's up/down keys walk the page far
    // faster than a round trip completes.

    private List<DesktopCreditNoteResult> drawerCredits = [];
    private string? drawerCreditsError;
    private bool drawerCreditsBusy;

    /// <summary>What ZIMRA holds against this sale — the only credits that gave anything back.</summary>
    private decimal CreditedAmount => drawerCredits
        .Where(note => string.Equals(note.Status, "Fiscalised", StringComparison.OrdinalIgnoreCase))
        .Sum(note => note.Amount);

    private async Task LoadDrawerCredits()
    {
        var sale = selectedSale;
        drawerCredits = [];
        drawerCreditsError = null;

        // Only a fiscalised sale can have been credited: a credit is raised against the original
        // receipt, and there is none to raise it against until the device has signed one.
        if (sale is null || sale.FiscalizationStatus is not "Success")
        {
            drawerCreditsBusy = false;
            return;
        }

        drawerCreditsBusy = true;
        var reference = sale.ExternalReferenceId;
        try
        {
            var notes = await DesktopService.GetCreditNotesAsync(reference);
            if (selectedSale?.ExternalReferenceId != reference)
            {
                return;
            }

            drawerCredits = notes;
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Could not read the credit notes for sale {Reference}", reference);
            if (selectedSale?.ExternalReferenceId != reference)
            {
                return;
            }

            // Said rather than swallowed. A drawer that quietly showed no credit notes because the
            // read failed would tell an operator this sale had never been credited.
            drawerCreditsError = "The credit notes for this sale could not be read.";
        }
        finally
        {
            if (selectedSale?.ExternalReferenceId == reference)
            {
                drawerCreditsBusy = false;
            }
        }
    }

    // Picked and open are different states and a row can be both: picked is
    // what the Post button will send, open is what the drawer is showing.
    private string RowClass(DesktopSaleDto sale)
    {
        var picked = selected.Contains(sale.ExternalReferenceId);
        var open = selectedSale?.Id == sale.Id;
        return picked && open ? "is-picked is-open" : picked ? "is-picked" : open ? "is-open" : "";
    }

    // Up and down wrap within the loaded page. Falling off the end into the
    // next page would fetch behind the drawer and rewrite the list underneath
    // it; the pager is where changing page belongs.
    private async Task StepSale(int direction)
    {
        if (selectedSale == null || sales.Count < 2)
        {
            return;
        }

        var index = sales.FindIndex(s => s.Id == selectedSale.Id);
        if (index < 0)
        {
            return;
        }

        selectedSale = sales[((index + direction) % sales.Count + sales.Count) % sales.Count];
        await LoadDrawerCredits();
    }

    // What the customer handed over, and what went back. A sale can carry no
    // tender at all — an account transfer the till never settled, a card that
    // was declined — and "tendered 0.00 · change 0.00" states that far less
    // clearly than saying so.
    private string tenderText
    {
        get
        {
            var sale = selectedSale!;
            if (sale.AmountPaid <= 0)
            {
                return "no payment recorded";
            }

            var tendered = $"tendered {Money(sale.AmountPaid, sale.Currency)}";
            var change = sale.AmountPaid - sale.TotalAmount;
            return change > 0 ? $"{tendered} · change {Money(change, sale.Currency)}" : tendered;
        }
    }

    // The QR payload is the ZIMRA verification URL, not an image — see
    // FiscalReceiptQrComposer.BuildQrPayload, which composes it as
    // {qrUrl}/{device}{date}{receipt}{code}. FiscalQrCode.ToImageSource renders
    // it as something scannable; this is the same string as something clickable,
    // for whoever is reading the drawer at a desk rather than holding a phone.
    // Anything that is not an http(s) URL gets no link: the column is 500
    // characters of whatever the platform returned, and older rows predate the
    // composer.
    private string? verifyUrl
    {
        get
        {
            var raw = selectedSale?.FiscalQRCode?.Trim();
            if (string.IsNullOrEmpty(raw))
            {
                return null;
            }

            return Uri.TryCreate(raw, UriKind.Absolute, out var uri) &&
                   (uri.Scheme == Uri.UriSchemeHttp || uri.Scheme == Uri.UriSchemeHttps)
                ? raw
                : null;
        }
    }

    // ── The trail ────────────────────────────────────────────────────────
    // Four steps, each read off a column rather than a script: when the sale
    // was captured, whether the device signed it, whether the close took it,
    // and what it became in SAP. The design's fourth step assumes a ledger
    // posting time this page has no field for; the SAP document number is the
    // fact that actually answers "and then what", so that is what it states.
    //
    // The last step is the one place the trail and the drawer's refusal banner
    // describe the same thing. They are not redundant: the banner carries SAP's
    // verbatim words, which is a paragraph, and the trail says which step the
    // sale stopped at, which is a line.

    private sealed record TrailStep(string Label, string Meta, string Family, bool IsNow = false);

    private List<TrailStep> trail
    {
        get
        {
            var sale = selectedSale!;

            var origin = new List<string> { Full(sale.CreatedAt) };
            if (!string.IsNullOrWhiteSpace(sale.CreatedByName))
            {
                // The name only. A trail line is read at a glance, and the account id — which the
                // "Captured by" fact above still shows when it is all there is — is not.
                origin.Add(sale.CreatedByName);
            }
            if (!string.IsNullOrWhiteSpace(sale.SourceSystem))
            {
                origin.Add(sale.SourceSystem);
            }

            var steps = new List<TrailStep>
            {
                new("Raised in the desktop app", string.Join(" · ", origin), "ops-fam-good")
            };

            steps.Add(sale.FiscalizationStatus?.ToLowerInvariant() switch
            {
                "success" => new TrailStep(
                    "Fiscalized on the device",
                    string.IsNullOrWhiteSpace(sale.FiscalReceiptNumber)
                        ? "the authority accepted the receipt"
                        : $"receipt {sale.FiscalReceiptNumber} accepted",
                    "ops-fam-good"),
                // The device's own words where it gave any. "Could not sign" alone reads the same for a
                // card that was busy for a second and a line the device will refuse every time.
                "failed" => new TrailStep(
                    "Fiscalization failed",
                    string.Join(" · ", new[]
                    {
                        string.IsNullOrWhiteSpace(sale.FiscalError)
                            ? "the device could not sign this receipt"
                            : sale.FiscalError,
                        sale.FiscalizationAttempts > 1 ? $"{sale.FiscalizationAttempts} attempts" : null
                    }.Where(part => part is not null)),
                    "ops-fam-bad"),
                "skipped" => new TrailStep(
                    "Fiscalization skipped",
                    "this sale was not put to the device",
                    "ops-fam-neutral"),
                _ => new TrailStep(
                    "Awaiting fiscalization",
                    "the device has not signed this receipt yet",
                    "ops-fam-accent",
                    IsNow: true)
            });

            steps.Add(sale.ConsolidationStatus?.ToLowerInvariant() switch
            {
                "consolidated" => new TrailStep(
                    "Consolidated into the back office",
                    sale.ConsolidationId.HasValue ? $"run #{sale.ConsolidationId}" : "closed",
                    "ops-fam-good"),
                "failed" => new TrailStep(
                    "Consolidation failed",
                    "the run could not take this sale",
                    "ops-fam-bad"),
                "excluded" => new TrailStep(
                    "Excluded from the close",
                    "left out of the consolidation run",
                    "ops-fam-neutral"),
                _ => new TrailStep(
                    "Awaiting day close",
                    "stays on the device until the day is consolidated",
                    "ops-fam-accent",
                    IsNow: true)
            });

            // Two routes reach SAP and they write different columns. The
            // per-sale posting job — and the Post to SAP button, which is the
            // same work asked for now — stamps SapDocNum on the row; the
            // end-of-day run groups a customer's sales into one consolidated
            // invoice and stamps the DocNum on the *consolidation*, leaving only
            // ConsolidationId here. Reading one and not the other is why a
            // consolidated sale used to look like it had gone nowhere.
            if (sale.SapDocNum.HasValue)
            {
                var meta = sale.PostedAt.HasValue
                    ? $"invoice {sale.SapDocNum} · {Full(sale.PostedAt.Value)}"
                    : $"invoice {sale.SapDocNum}";
                steps.Add(new TrailStep("Posted to SAP", meta, "ops-fam-good"));
            }
            else if (HeldUntil(sale) is { } trailHeldUntil)
            {
                steps.Add(new TrailStep(
                    "Waiting to resend to SAP",
                    $"no clear answer to the last post · sent again after {Clock(trailHeldUntil)}",
                    "ops-fam-warn"));
            }
            else if (!string.IsNullOrWhiteSpace(sale.LastPostingError))
            {
                steps.Add(new TrailStep(
                    "SAP refused it",
                    sale.PostingAttempts > 0
                        ? $"{sale.PostingAttempts} attempt{(sale.PostingAttempts == 1 ? "" : "s")} so far — see above for what SAP said"
                        : "see above for what SAP said",
                    "ops-fam-bad"));
            }
            else if (sale.ConsolidationId.HasValue)
            {
                steps.Add(new TrailStep(
                    "Posted with the consolidation run",
                    $"run #{sale.ConsolidationId} carries the SAP invoice, not this row",
                    "ops-fam-good"));
            }
            else if (Is(sale.ConsolidationStatus, "Consolidated"))
            {
                steps.Add(new TrailStep(
                    "No SAP document recorded",
                    "the sale is closed, but nothing on this row names the invoice it became",
                    "ops-fam-warn"));
            }
            else if (Is(sale.ConsolidationStatus, "Excluded"))
            {
                steps.Add(new TrailStep(
                    "No SAP document",
                    "an excluded sale is never invoiced",
                    "ops-fam-neutral"));
            }
            else
            {
                steps.Add(new TrailStep(
                    "Not in SAP yet",
                    sale.CanPostToSap
                        ? "posts with the day, or now with Post to SAP"
                        : "posts as part of the day's consolidation",
                    "ops-fam-neutral"));
            }

            return steps;
        }
    }

    // ── Posting to SAP ───────────────────────────────────────────────────

    private void ToggleSelected(DesktopSaleDto sale, ChangeEventArgs args)
    {
        if (args.Value is true)
        {
            selected.Add(sale.ExternalReferenceId);
        }
        else
        {
            selected.Remove(sale.ExternalReferenceId);
        }
    }

    /// <remarks>
    /// Clears only this page's postable rows rather than the whole set, so unticking here does not
    /// silently drop a selection made on a page the operator has already left.
    /// </remarks>
    private void ToggleSelectAll(ChangeEventArgs args)
    {
        var references = postableOnPage.Select(s => s.ExternalReferenceId);

        if (args.Value is true)
        {
            foreach (var reference in references)
            {
                selected.Add(reference);
            }
        }
        else
        {
            foreach (var reference in references.ToList())
            {
                selected.Remove(reference);
            }
        }
    }

    /// <summary>
    /// Drops references the current list no longer offers.
    /// </summary>
    /// <remarks>
    /// Called after every reload. Without it a filter change would leave a selection the operator
    /// cannot see, and the hero would offer to post rows that are no longer on the page — which is
    /// the one thing a count on a button must never do.
    /// </remarks>
    private void PruneSelection()
    {
        if (selected.Count == 0)
        {
            return;
        }

        var onPage = sales
            .Where(s => s.CanPostToSap)
            .Select(s => s.ExternalReferenceId)
            .ToHashSet(StringComparer.Ordinal);

        selected.RemoveWhere(reference => !onPage.Contains(reference));
    }

    private void OpenBulkPost() => showBulkPost = true;

    private void CloseBulkPost() => showBulkPost = false;

    private void CloseBulkResult() => bulkResult = null;

    /// <summary>
    /// Posts the one sale open in the drawer.
    /// </summary>
    /// <remarks>
    /// The drawer closes on success and stays open on failure. A sale that posted has nothing left
    /// to say — the row behind it now carries its invoice number — while a sale SAP refused is
    /// exactly what the drawer is for, and closing it would hide the reason the operator asked for.
    /// </remarks>
    private async Task PostOne(DesktopSaleDto sale)
    {
        if (isPosting)
        {
            return;
        }

        isPosting = true;
        postingReference = sale.ExternalReferenceId;
        StateHasChanged();

        try
        {
            var (result, error) = await DesktopService.PostSaleToSapAsync(sale.ExternalReferenceId);

            if (error is null)
            {
                selected.Remove(sale.ExternalReferenceId);
                selectedSale = null;
            }

            // Reloaded before the outcome is said, not after: a successful reload clears a red notice,
            // and SAP's refusal is the one thing the operator pressed Post to read.
            await LoadData();

            if (error is not null)
            {
                SayError(error);
                return;
            }

            Say(
                result!.Message ?? $"{sale.ExternalReferenceId} reached SAP.",
                result.Outcome == DesktopSalePostOutcomes.Posted ? "ops-fam-good" : "ops-fam-info",
                result.Outcome == DesktopSalePostOutcomes.Posted ? "ph-check-circle" : "ph-info");
        }
        catch (Exception ex)
        {
            SayError($"The post could not be sent: {ex.Message}");
        }
        finally
        {
            isPosting = false;
            postingReference = null;
        }
    }

    /// <summary>
    /// Asks the device to sign the sale open in the drawer.
    /// </summary>
    /// <remarks>
    /// The drawer stays open either way. A sale that now has a receipt can be posted from the same
    /// footer, and one the device refused needs its reason on screen.
    /// </remarks>
    private async Task RetryFiscalisation(DesktopSaleDto sale)
    {
        if (isRetryingFiscal)
        {
            return;
        }

        isRetryingFiscal = true;
        StateHasChanged();

        try
        {
            var (result, error) = await DesktopService.RetrySaleFiscalisationAsync(sale.ExternalReferenceId);

            // Reloaded before the outcome is said, not after: a successful reload clears a red notice,
            // and the device's refusal is the one thing the operator pressed Retry to read.
            await LoadData();

            // Re-pointed at the reloaded row so the drawer shows the new status, receipt and buttons.
            selectedSale = sales.FirstOrDefault(s => s.ExternalReferenceId == sale.ExternalReferenceId)
                ?? selectedSale;

            if (error is not null)
            {
                SayError(error);
            }
            else
            {
                Say(
                    result!.Message ?? $"{sale.ExternalReferenceId} is fiscalised.",
                    "ops-fam-good",
                    "ph-check-circle");
            }
        }
        catch (Exception ex)
        {
            SayError($"The retry could not be sent: {ex.Message}");
        }
        finally
        {
            isRetryingFiscal = false;
        }
    }

    private async Task PostSelected()
    {
        if (isPosting || selected.Count == 0)
        {
            return;
        }

        isPosting = true;
        StateHasChanged();

        // Snapshotted before the call. A push can reload `sales` while this is in flight, and the
        // results have to be matched against what was actually sent.
        var references = selected.ToList();

        try
        {
            var (result, error) = await DesktopService.PostSalesToSapAsync(references);
            showBulkPost = false;

            if (error is null)
            {
                bulkResult = result;

                // Only the ones SAP now holds leave the selection. Whatever failed or was refused stays
                // ticked, so pressing the button again retries exactly those rather than making the
                // operator find them in the list a second time.
                foreach (var row in result!.Results.Where(InSap))
                {
                    selected.Remove(row.ExternalReferenceId);
                }
            }

            // Reloaded before the outcome is said: a successful reload clears a red notice, and both
            // the API's refusal and a summary with SAP refusals in it are red.
            await LoadData();

            if (error is not null)
            {
                SayError(error);
                return;
            }

            Say(Summarise(result!), SummaryFamily(result!), SummaryIcon(result!));
        }
        catch (Exception ex)
        {
            showBulkPost = false;
            await LoadData();
            SayError($"The batch could not be completed: {ex.Message}");
        }
        finally
        {
            isPosting = false;
        }
    }

    private static bool InSap(DesktopSalePostResultDto row) =>
        row.Outcome is DesktopSalePostOutcomes.Posted or DesktopSalePostOutcomes.AlreadyInSap;

    private static string Summarise(DesktopSalesBulkPostResultDto result)
    {
        var parts = new List<string>();

        if (result.Posted > 0) parts.Add($"{result.Posted} posted");
        if (result.AlreadyInSap > 0) parts.Add($"{result.AlreadyInSap} already in SAP");
        if (result.InProgress > 0) parts.Add($"{result.InProgress} already being posted");
        if (result.Failed > 0) parts.Add($"{result.Failed} refused by SAP");
        if (result.NotPostable > 0) parts.Add($"{result.NotPostable} not postable");

        return parts.Count == 0
            ? "Nothing was posted."
            : $"{string.Join(", ", parts)}.";
    }

    // A batch with anything unresolved in it is not a success, whatever else went right: the row
    // that did not post is the one somebody has to come back to.
    private static string SummaryFamily(DesktopSalesBulkPostResultDto result) =>
        result.Failed > 0 ? "ops-fam-bad"
        : result.NotPostable > 0 || result.InProgress > 0 ? "ops-fam-warn"
        : "ops-fam-good";

    private static string SummaryIcon(DesktopSalesBulkPostResultDto result) =>
        result.Failed > 0 ? "ph-warning-octagon"
        : result.NotPostable > 0 || result.InProgress > 0 ? "ph-warning"
        : "ph-check-circle";

    // ── Consolidation ────────────────────────────────────────────────────

    private void OpenConsolidate() => showConsolidate = true;

    private void CloseConsolidate() => showConsolidate = false;

    private decimal awaitingValue => DesktopSalesDaySummary.AwaitingValue(report);

    // The day the summary card and the dialog describe. The run closes this day, so the dialog's
    // figures and the run always describe the same day.
    private DateTime? consolidationDate => report?.ReportDate.Date;

    private bool canConsolidate => consolidationDate is { } day && day <= DateTime.Today;

    private async Task TriggerConsolidation()
    {
        if (consolidationDate is not { } day || !canConsolidate)
        {
            return;
        }

        isConsolidating = true;
        StateHasChanged();
        try
        {
            var (result, error) = await DesktopService.TriggerConsolidationAsync(day);
            showConsolidate = false;

            if (result is null)
            {
                SayError(error ?? "The consolidation run could not be started.");
                return;
            }

            if (result.FailedPostings > 0)
            {
                SayError($"Consolidated {result.TotalSalesProcessed} sale(s) for {day:dd MMM yyyy}: "
                    + $"{result.SuccessfulPostings} invoice(s) posted, {result.FailedPostings} customer(s) "
                    + "not posted. Their sales are still listed as unposted.");
            }
            else
            {
                Say($"Consolidated {result.TotalSalesProcessed} sale(s) for {day:dd MMM yyyy} into "
                    + $"{result.SuccessfulPostings} SAP invoice(s).",
                    "ops-fam-good", "ph-check-circle");
            }

            await LoadData();
        }
        catch (Exception ex)
        {
            showConsolidate = false;
            SayError($"Consolidation failed: {ex.Message}");
        }
        finally
        {
            isConsolidating = false;
        }
    }

    private async Task ExportToExcel()
    {
        if (sales.Count == 0)
        {
            return;
        }

        isExporting = true;
        StateHasChanged();
        try
        {
            var bytes = ExportService.ExportDesktopSalesToExcel(sales, report, filterFromDate, filterToDate);
            var base64 = Convert.ToBase64String(bytes);
            await JS.InvokeVoidAsync("downloadFile", $"Desktop_Sales_{DateTime.Now:yyyyMMdd_HHmm}.xlsx", base64);
        }
        catch (Exception ex)
        {
            SayError($"Export failed: {ex.Message}");
        }
        finally
        {
            isExporting = false;
            StateHasChanged();
        }
    }

    // ── Notices ──────────────────────────────────────────────────────────

    private void Say(string text, string family, string icon)
    {
        notice = text;
        noticeFamily = family;
        noticeIcon = icon;
    }

    private void SayError(string text) => Say(text, "ops-fam-bad", "ph-warning-octagon");

    // A successful reload clears a failure that is no longer true, and leaves a
    // consolidation result standing — that one is news, not an error state.
    private void ClearError()
    {
        if (noticeFamily == "ops-fam-bad")
        {
            notice = null;
        }
    }

    // ── The day summary ──────────────────────────────────────────────────

    private string dayLabel => report == null
        ? "Day in progress"
        : report.ReportDate.Date == DateTime.Today
            ? "Day in progress"
            : report.ReportDate.ToString("dd MMM yyyy");

    // The arithmetic lives in DesktopSalesDaySummary so it can be tested; this
    // page only draws it. Drawn from the report rather than from `sales`, which
    // is one page of a filtered list and would make the lanes disagree with the
    // total above them.
    private List<DesktopSalesDaySummary.Lane> lanes => DesktopSalesDaySummary.Lanes(report);

    private int laneTotal => lanes.Sum(l => l.Count);

    private int consolidatedCount => DesktopSalesDaySummary.ConsolidatedCount(report);

    private List<DesktopSalesDaySummary.PartnerValue> topPartners => DesktopSalesDaySummary.OnDevice(report);

    private decimal topPartnerMax => topPartners.Count > 0 ? topPartners.Max(b => b.TotalAmount) : 0m;

    // ── Text ─────────────────────────────────────────────────────────────

    // The count answers the filter panel and sits between it and the table; the
    // foot is left to say how fresh the rows under it are. The design puts a
    // "refreshes every 30s" note there — nothing on this page polls on a timer,
    // so it says what actually brings a new row in.
    //
    // Which rows, not how many: on page four of a 900-row set "showing 50 of 900"
    // is true of every page, and the pager below already says which one this is.
    // The order is no longer stated here either — it is a control now, six inches
    // to the right, and restating it would be a second place for it to be wrong.
    private string shownText
    {
        get
        {
            if (totalCount == 0)
            {
                return "No invoices";
            }

            var first = ((currentPage - 1) * pageSize) + 1;
            return $"Showing {first}–{first + sales.Count - 1} of {totalCount} invoices";
        }
    }

    private string footerText => lastPolledAt.HasValue
        ? $"Polled {lastPolledAt:HH:mm:ss} · rows arrive as the devices report in"
        : "Rows arrive as the devices report in";

    private string emptyTitle => filterCount > 0 ? "Nothing matches these filters" : "The day is clear";

    private string emptyBody => filterCount > 0
        ? "Widen the period or drop a filter to see the rest of the day."
        : "Invoices fiscalized on the desktop apps appear here within a few seconds of being issued.";

    // ── Formatting ───────────────────────────────────────────────────────

    // The report carries no currency of its own, so its figures borrow the one
    // the loaded sales are in. With nothing loaded the amount stands alone
    // rather than being labelled with a guess.
    private string currencyCode => sales.FirstOrDefault()?.Currency ?? "";

    private string Money(decimal value) => Money(value, currencyCode);

    private static string Money(decimal value, string? code) =>
        string.IsNullOrEmpty(code) ? value.ToString("N2") : $"{code} {value.ToString("N2")}";

    private static string Percent(int part, int whole) =>
        whole <= 0 ? "0%" : ((double)part / whole * 100).ToString("0.##", CultureInfo.InvariantCulture) + "%";

    private static string Percent(decimal part, decimal whole) =>
        whole <= 0 ? "0%" : ((double)(part / whole) * 100).ToString("0.##", CultureInfo.InvariantCulture) + "%";

    // The +2h is the app's standing display offset for these timestamps.
    private static string Stamp(DateTime createdAt)
    {
        var local = createdAt.AddHours(2);
        return local.Date == DateTime.Today ? local.ToString("HH:mm") : local.ToString("dd MMM HH:mm");
    }

    // The drawer states a date whatever day the row is from: it is read on its
    // own, away from the column that made "12:17" unambiguous.
    private static string Full(DateTime utc) => utc.AddHours(2).ToString("dd MMM yyyy, HH:mm");

    private static string Clock(DateTime utc) => utc.AddHours(2).ToString("HH:mm", CultureInfo.InvariantCulture);

    /// <summary>
    /// When the API will send a sale held after an unanswered post to SAP again, or null when it is
    /// not held. Checked against the clock as well as the API's answer, so a drawer left open past
    /// the end of the hold stops claiming it.
    /// </summary>
    private static DateTime? HeldUntil(DesktopSaleDto sale) =>
        !sale.SapDocNum.HasValue && sale.PostHeldUntilUtc is { } until && until > DateTime.UtcNow
            ? until
            : null;

    private static bool Is(string? status, string value) =>
        string.Equals(status, value, StringComparison.OrdinalIgnoreCase);

    private static string Blank(string? text) => string.IsNullOrWhiteSpace(text) ? "—" : text;

    // ── Who captured the sale ────────────────────────────────────────────
    //
    // The column behind this holds an account id and nothing else — every writer of it stores
    // `account.UserId` — so the drawer used to state a GUID where it meant to name a cashier. The API
    // resolves the id against the account (see SaleOperatorNames); these two say what to show when it
    // could not.
    //
    // Rows written before accounts were ids carry the name itself, and those are shown as they stand.

    private static string CapturedBy(DesktopSaleDto sale)
    {
        if (!string.IsNullOrWhiteSpace(sale.CreatedByName))
        {
            return sale.CreatedByName;
        }

        if (string.IsNullOrWhiteSpace(sale.CreatedBy))
        {
            return "—";
        }

        return Guid.TryParse(sale.CreatedBy.Trim(), out _) ? "Account no longer exists" : sale.CreatedBy;
    }

    /// <summary>The bare account id, in the one case where it is the only thing left to show.</summary>
    /// <remarks>
    /// A deleted account is still the account a support call is about, and the id is what matches the
    /// sale to the till's own logs. It is stated under the sentence above rather than in place of it.
    /// </remarks>
    private static string? UnresolvedAccount(DesktopSaleDto sale) =>
        string.IsNullOrWhiteSpace(sale.CreatedByName) && Guid.TryParse(sale.CreatedBy?.Trim(), out var id)
            ? id.ToString()
            : null;

    // A tender as the counter names it. Older rows carry the till's own casing, so the comparison is
    // case-blind; a sale nobody recorded a tender for says so rather than showing an empty cell.
    private static string TenderName(string? tender) =>
        string.IsNullOrWhiteSpace(tender) || tender == DesktopSalesFilterValues.Blank ? "Not recorded"
        : tender.Trim().Equals("ecocash", StringComparison.OrdinalIgnoreCase) ? "EcoCash"
        : tender.Trim();

    private static string ConsolidationLabel(string? status) =>
        Is(status, "Pending") ? "Awaiting close" : Blank(status);

    private static string FiscalFamily(string? status) => status?.ToLowerInvariant() switch
    {
        "success" => "ops-fam-good",
        "pending" => "ops-fam-warn",
        "failed" => "ops-fam-bad",
        "skipped" => "ops-fam-neutral",
        _ => "ops-fam-neutral"
    };

    // Awaiting close takes the accent rather than a warning hue: it is the
    // expected state of a sale the day has not closed on yet, not a problem.
    private static string ConsolidationFamily(string? status) => status?.ToLowerInvariant() switch
    {
        "consolidated" => "ops-fam-good",
        "pending" => "ops-fam-accent",
        "failed" => "ops-fam-bad",
        "excluded" => "ops-fam-neutral",
        _ => "ops-fam-neutral"
    };

    // A settlement that was never attempted is not a fault — most of these are read seconds after
    // the invoice posted — so null takes the accent the way "awaiting close" does. Unmapped is a
    // warning rather than a failure: nothing broke, but no amount of waiting will fix it either.
    private static string PaymentFamily(string? status) => status switch
    {
        DesktopSalePaymentStatuses.Posted => "ops-fam-good",
        DesktopSalePaymentStatuses.PostedUnconfirmed => "ops-fam-good",
        DesktopSalePaymentStatuses.Failed => "ops-fam-bad",
        DesktopSalePaymentStatuses.Unmapped => "ops-fam-warn",
        _ => "ops-fam-accent"
    };

    private static string PaymentLabel(string? status) => status switch
    {
        DesktopSalePaymentStatuses.Posted => "Settled",
        // Named for what actually happened rather than for the status word. SAP showed the invoice
        // already paid, so nothing was sent — and an operator reading "PostedUnconfirmed" would
        // reasonably go looking for a payment this system never made.
        DesktopSalePaymentStatuses.PostedUnconfirmed => "Already settled in SAP",
        // Both are picked up again by the customer's next daily payment, rather than retried alone.
        DesktopSalePaymentStatuses.Failed => "Payment failed · on the next daily payment",
        DesktopSalePaymentStatuses.Unmapped => "Tender not mapped",
        // No sale is settled on its own. The invoice stays open until the customer's 17:00 payment.
        _ => "Awaiting the 17:00 daily payment"
    };

    private static string PostOutcomeFamily(string? outcome) => outcome switch
    {
        DesktopSalePostOutcomes.Posted => "ops-fam-good",
        DesktopSalePostOutcomes.AlreadyInSap => "ops-fam-good",
        DesktopSalePostOutcomes.InProgress => "ops-fam-accent",
        DesktopSalePostOutcomes.Failed => "ops-fam-bad",
        _ => "ops-fam-warn"
    };

    private static string PostOutcomeLabel(string? outcome) => outcome switch
    {
        DesktopSalePostOutcomes.Posted => "Posted",
        DesktopSalePostOutcomes.AlreadyInSap => "Already in SAP",
        DesktopSalePostOutcomes.InProgress => "Being posted",
        DesktopSalePostOutcomes.Failed => "SAP refused it",
        DesktopSalePostOutcomes.NotPostable => "Not postable",
        _ => Blank(outcome)
    };

    public void Dispose()
    {
        HubService.OnDesktopSaleCreated -= OnSaleCreated;
        HubService.OnConsolidationCompleted -= OnConsolidationDone;
    }
}
