@page "/desktop-sales"
@using System.Globalization
@using Microsoft.AspNetCore.Authorization
@using ShopInventory.Web.Services
@attribute [Authorize(Roles = "Admin,Cashier")]
@inject IDesktopIntegrationService DesktopService
@inject IMasterDataCacheService MasterDataCache
@inject IReportExportService ExportService
@inject INotificationHubService HubService
@inject IJSRuntime JS
@inject ISnackbar Snackbar
@inject IAuditService AuditService
@implements IDisposable
@rendermode InteractiveServer

<PageTitle>Desktop Sales - Shop Inventory</PageTitle>

@* Built from `Desktop Sales.dc.html` in the "Nocturne Dark Ops Redesign" design
   project. Styles live in wwwroot/css/operations.css (linked from App.razor),
   shared with the other five operational pages — see that file's header for why
   an imported design joined the derived sheet rather than taking one of its
   own. `ops` is the scope; `ops-ds` is this page's own half of it. The 542-line
   inline <style> block is gone.

   **The design's per-sale actions are not built, deliberately.** Its earlier
   revision drew a checkbox per row and a "Consolidate 4" button; this one moves
   the same idea into the drawer as "Consolidate now" and "Exclude from close",
   and adds a "Receipt PDF". None of the three exists behind this page.
   `IDesktopIntegrationService.TriggerConsolidationAsync()` takes no arguments —
   the run is end-of-day and server-side, there is no endpoint that accepts a
   set of sales or excludes one, and no receipt PDF is kept for a desktop sale.
   A "Consolidate now" in a drawer about one invoice that silently closed the
   whole day would be worse than no button. The hero's `Consolidate day` names
   what the API actually does, and the dialog confirms it. If a selective
   endpoint ever appears, those controls and a `Consolidate N` label are the
   only markup this page is missing.

   Three other places where the design assumed data this page does not have:

   - Its status lanes come from the end-of-day report's consolidation counts
     rather than an invented per-device lifecycle, and its per-site value bars
     became per-customer, because `BusinessPartnerSummaries` is the breakdown
     the report returns.
   - Its drawer prints a raised time and a fiscalized time. A desktop sale
     carries `CreatedAt` and nothing else, so one stamp is stated once.
   - Its trail ends at "Posted to ledger" with a journal number. There is no
     ledger posting time on this row; there is a SAP document number, by two
     different routes (see `trail`), and that is the fact the last step states.

   The fiscal signature panel is the one part of this revision that needed new
   data, and it needed none from SAP: `FiscalQRCode`, `FiscalVerificationCode`,
   `FiscalDeviceNumber` and `FiscalDayNo` have always come back from
   `GET /api/DesktopIntegration/sales` and were simply missing from the Web's
   hand-written mirror of that DTO. `SapDocNum` and `PostedAt` were added to
   the API's list DTO for the trail's last step. *@

<div class="ops ops-ds">

    <div class="ops-hero">
        <div class="ops-hero-text">
            <div class="ops-ds-kicker-row">
                <span class="ops-kicker">Offline fiscalization</span>
                <span class="ops-ds-kicker-rule"></span>
                @* The dot animates only while the hub is up. A still dot is the
                   disconnected state, not an animation that failed to start. *@
                <span class="ops-ds-live">
                    <span class="ops-ds-live-dot @(HubService.IsConnected ? "" : "is-off")"></span>
                    @(HubService.IsConnected ? "Live" : "Offline")
                </span>
            </div>
            <h1>Desktop Sales</h1>
            <p>
                Invoices raised in the desktop apps and fiscalized on the local device.
                They stay here until the day is consolidated into the back office.
            </p>
        </div>

        <div class="ops-ds-hero-side">
            <div class="ops-ds-poll">
                <div class="ops-ds-poll-now">
                    @(lastPolledAt.HasValue ? $"Polled {lastPolledAt:HH:mm:ss}" : "Not polled yet")
                </div>
                <div class="ops-ds-poll-then">
                    @(report != null ? $"Report generated {report.GeneratedAt.AddHours(2):dd MMM, HH:mm}" : "No report yet")
                </div>
            </div>
            <div class="ops-hero-actions">
                <button type="button" class="ops-btn ops-btn-primary" @onclick="OpenConsolidate"
                        disabled="@(isConsolidating || isLoading)">
                    @if (isConsolidating)
                    {
                        <span class="ops-spin"></span>
                        <span>Consolidating&hellip;</span>
                    }
                    else
                    {
                        <i class="ph ph-paper-plane-tilt" aria-hidden="true"></i>
                        <span>Consolidate day</span>
                    }
                </button>
                <button type="button" class="ops-btn ops-btn-ghost" @onclick="ExportToExcel"
                        disabled="@(isExporting || sales.Count == 0)">
                    @if (isExporting)
                    {
                        <span class="ops-spin"></span>
                        <span>Exporting&hellip;</span>
                    }
                    else
                    {
                        <i class="ph ph-file-xls" aria-hidden="true"></i>
                        <span>Export</span>
                    }
                </button>
                <button type="button" class="ops-icon-btn" title="Refresh" aria-label="Refresh"
                        @onclick="RefreshData" disabled="@isLoading">
                    @if (isLoading)
                    {
                        <span class="ops-spin"></span>
                    }
                    else
                    {
                        <i class="ph ph-arrows-clockwise" aria-hidden="true"></i>
                    }
                </button>
            </div>
        </div>
    </div>

    <div class="ops-rule-fade"></div>

    @if (report != null)
    {
        <div class="ops-ds-summary">
            @* The day, divided. The strip states the split before the four
               numbers do, so the shape of the day is readable before a single
               figure is; each lane and its share of the strip read the same
               family, so a lane cannot be one colour and its bar another. *@
            <div class="ops-ds-card">
                <div class="ops-ds-card-head">
                    <span class="ops-ds-card-label">@dayLabel</span>
                    <span class="ops-ds-card-tally">
                        <b>@report.TotalSalesCount</b>
                        <span>fiscalized</span>
                    </span>
                </div>

                @if (laneTotal > 0)
                {
                    <div class="ops-ds-strip">
                        @foreach (var lane in lanes.Where(l => l.Count > 0))
                        {
                            <div class="ops-ds-strip-seg @lane.Family"
                                 style="width:@Percent(lane.Count, laneTotal)"></div>
                        }
                    </div>
                }

                <div class="ops-ds-lanes">
                    @foreach (var lane in lanes)
                    {
                        <div class="ops-ds-lane @lane.Family">
                            <div class="ops-ds-lane-num">@lane.Count</div>
                            <div class="ops-ds-lane-name">@lane.Name</div>
                        </div>
                    }
                </div>

                @* Net, not the gross the day totals to: the design states the
                   three amounts side by side, and Net beside VAT that adds up
                   to something else would be read as an arithmetic error.
                   `TotalSalesAmount` is subtotal + VAT — see
                   CreateDesktopSaleHandler — so the subtraction is exact. *@
                <div class="ops-ds-aside ops-ds-aside-ruled">
                    <span>Net <b>@Money(report.TotalSalesAmount - report.TotalVatAmount)</b></span>
                    <span>VAT <b>@Money(report.TotalVatAmount)</b></span>
                    <span>Paid <b>@Money(report.TotalAmountPaid)</b></span>
                </div>
            </div>

            @* The headline is what has *not* reached the back office yet, not
               the day's total — that number is the one the Consolidate button
               acts on, and the day's total is stated beside the lanes. *@
            <div class="ops-ds-card">
                <div class="ops-ds-card-head">
                    <i class="ph ph-hard-drives" aria-hidden="true"></i>
                    <span class="ops-ds-card-label">Value on the device</span>
                </div>

                <div class="ops-ds-value">
                    <b>@Money(awaitingValue)</b>
                </div>
                <div class="ops-ds-aside">
                    <span>not yet in the back office · @report.UnpostedInvoiceCount awaiting close</span>
                </div>

                @if (topPartners.Count > 0)
                {
                    <div class="ops-ds-split"></div>
                    <div class="ops-ds-breakdown">
                        <div class="ops-ds-card-label">Largest customers</div>
                        @foreach (var partner in topPartners)
                        {
                            <div class="ops-ds-break-row">
                                <span class="ops-ds-break-code" title="@(partner.CardName ?? partner.CardCode)">
                                    @partner.CardCode
                                </span>
                                <span class="ops-ds-break-track">
                                    <span class="ops-ds-break-fill"
                                          style="width:@Percent(partner.TotalAmount, topPartnerMax)"></span>
                                </span>
                                <span class="ops-ds-break-val">@Money(partner.TotalAmount)</span>
                            </div>
                        }
                    </div>
                }
            </div>
        </div>
    }

    @if (notice != null)
    {
        <div class="ops-msg @noticeFamily" role="alert">
            <i class="ph @noticeIcon" aria-hidden="true"></i>
            <div class="ops-msg-body">@notice</div>
            <button type="button" class="ops-msg-x" aria-label="Dismiss" @onclick="() => notice = null">
                <i class="ph ph-x" aria-hidden="true"></i>
            </button>
        </div>
    }

    <div class="ops-ds-filters">
        <div class="ops-field">
            <label class="ops-label" for="ds-warehouse">Warehouse</label>
            <NocturneSelect Id="ds-warehouse" Class="nsel-block" Options="WarehouseFilterOptions"
                            @bind-Value="filterWarehouse" OnChanged="ApplyFilters"
                            Caption="Filter by warehouse" AriaLabel="Filter by warehouse"
                            Placeholder="All warehouses" />
        </div>

        <div class="ops-field ops-field-wide">
            <label class="ops-label" for="ds-customer">Customer</label>
            @* The API filters on card code alone, so the placeholder says so
               rather than promising a name search that would return nothing. *@
            <input id="ds-customer" type="search" class="ops-input" placeholder="Card code"
                   @bind="filterCardCode" @bind:after="ApplyFilters" />
        </div>

        <div class="ops-field">
            <label class="ops-label" for="ds-status">Consolidation</label>
            <NocturneSelect Id="ds-status" Class="nsel-block" TValue="string"
                            Options="ConsolidationFilterOptions" @bind-Value="filterStatus"
                            OnChanged="ApplyFilters" Caption="Filter by consolidation"
                            AriaLabel="Filter by consolidation" Placeholder="Any status" />
        </div>

        @* Not a <label>: the segment is three buttons, and a label would
           hand every click to the first of them. *@
        <div class="ops-field ops-ds-seg-field">
            <span class="ops-label" id="ds-period-label">Period</span>
            <div class="ops-ds-seg" role="group" aria-labelledby="ds-period-label">
                <button type="button" class="ops-ds-seg-opt @(period == PeriodToday ? "is-on" : "")"
                        aria-pressed="@(period == PeriodToday)" @onclick="() => SetPeriod(PeriodToday)">Today</button>
                <button type="button" class="ops-ds-seg-opt @(period == PeriodWeek ? "is-on" : "")"
                        aria-pressed="@(period == PeriodWeek)" @onclick="() => SetPeriod(PeriodWeek)">Last 7 days</button>
                <button type="button" class="ops-ds-seg-opt @(period == PeriodCustom ? "is-on" : "")"
                        aria-pressed="@(period == PeriodCustom)" @onclick="() => SetPeriod(PeriodCustom)">Range</button>
            </div>
        </div>

        @if (period == PeriodCustom)
        {
            @* Not <label>s either: NocturneDateField carries a button and a
               popup, which a label would swallow the clicks of. *@
            <div class="ops-ds-dates">
                <div class="ops-field">
                    <span class="ops-label">From</span>
                    <NocturneDateField Id="ds-f-from" Date="filterFromDate" DateChanged="OnFromDateChanged"
                                       AriaLabel="From date" />
                </div>
                <div class="ops-field">
                    <span class="ops-label">To</span>
                    <NocturneDateField Id="ds-f-to" Date="filterToDate" DateChanged="OnToDateChanged"
                                       AriaLabel="To date" />
                </div>
            </div>
        }

        @* The count sits with the controls that decide it rather than under
           the table: it is the answer to the filter row, and by the foot of a
           50-row page the question is off screen. Clear appears only once
           there is something to clear — the design draws it always, but a
           button that does nothing on an unfiltered page is a dead control. *@
        <div class="ops-ds-filter-tail">
            <span class="ops-ds-shown">@shownText</span>
            @if (hasFilters)
            {
                <button type="button" class="ops-btn ops-btn-ghost ops-btn-sm" @onclick="ClearFilters">
                    <i class="ph ph-x" aria-hidden="true"></i>Clear
                </button>
            }
        </div>
    </div>

    <div class="ops-rule-fade"></div>

    @if (isLoading)
    {
        <div class="ops-loading">
            <span class="ops-spin ops-spin-lg"></span>
            <p>Loading desktop sales&hellip;</p>
        </div>
    }
    else if (sales.Count > 0)
    {
        <div>
            <div class="ops-scroll">
                <table class="ops-table mobile-card-table">
                    <thead>
                        <tr>
                            <th>Fiscal number</th>
                            <th>Customer</th>
                            <th>Warehouse</th>
                            <th>Fiscalized</th>
                            <th class="ops-num">Total</th>
                            <th class="ops-num">Paid</th>
                            <th>Fiscal</th>
                            <th>Consolidation</th>
                            @* Empty on purpose: the mark below is a hover cue
                               for a row that already announces itself as a
                               button, not a column of data. *@
                            <th class="ops-ds-chev-cell"><span class="visually-hidden">Open</span></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var sale in sales)
                        {
                            <tr class="@(selectedSale?.Id == sale.Id ? "is-open" : "")"
                                @onclick="() => SelectSale(sale)">
                                <td data-label="Fiscal number">
                                    <span class="ops-code">@sale.ExternalReferenceId</span>
                                </td>
                                <td data-label="Customer" class="ops-name">
                                    @(sale.CardName ?? sale.CardCode)
                                    @if (sale.CardName != null)
                                    {
                                        <span class="ops-sub"> · @sale.CardCode</span>
                                    }
                                </td>
                                <td data-label="Warehouse">@sale.WarehouseCode</td>
                                <td data-label="Fiscalized" class="ops-ds-when">@Stamp(sale.CreatedAt)</td>
                                <td data-label="Total" class="ops-num">@Money(sale.TotalAmount, sale.Currency)</td>
                                <td data-label="Paid" class="ops-num">@Money(sale.AmountPaid, sale.Currency)</td>
                                <td data-label="Fiscal">
                                    <span class="ops-ds-state @FiscalFamily(sale.FiscalizationStatus)">
                                        <span class="ops-dot"></span>@Blank(sale.FiscalizationStatus)
                                    </span>
                                </td>
                                <td data-label="Consolidation">
                                    <span class="ops-ds-state @ConsolidationFamily(sale.ConsolidationStatus)">
                                        <span class="ops-dot"></span>@ConsolidationLabel(sale.ConsolidationStatus)
                                    </span>
                                    @if (sale.ConsolidationId.HasValue)
                                    {
                                        <div class="ops-sub">Run #@sale.ConsolidationId</div>
                                    }
                                </td>
                                <td class="ops-ds-chev-cell">
                                    <i class="ph ph-arrow-right ops-ds-chev" aria-hidden="true"></i>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <div class="ops-ds-foot">
                <span class="ops-ds-foot-info">@footerText</span>
                @if (totalPages > 1)
                {
                    <div class="ops-pages">
                        <button type="button" class="ops-step" disabled="@(currentPage == 1)" @onclick="PreviousPage">
                            <i class="ph ph-caret-left" aria-hidden="true"></i>Previous
                        </button>
                        <span class="ops-page-now">@currentPage of @totalPages</span>
                        <button type="button" class="ops-step" disabled="@(!hasMore)" @onclick="NextPage">
                            Next<i class="ph ph-caret-right" aria-hidden="true"></i>
                        </button>
                    </div>
                }
            </div>
        </div>
    }
    else
    {
        <div class="ops-empty">
            <i class="ph ph-receipt" aria-hidden="true"></i>
            <h3>@emptyTitle</h3>
            <p>@emptyBody</p>
            @if (hasFilters)
            {
                <div class="ops-empty-actions">
                    <button type="button" class="ops-btn ops-btn-ghost" @onclick="ClearFilters">
                        <i class="ph ph-x-circle" aria-hidden="true"></i>Clear filters
                    </button>
                </div>
            }
        </div>
    }
</div>

@* Both overlays are siblings of `.ops`, not children — see operations.css's
   header for why they carry `.ops-overlay` themselves. *@
@if (showConsolidate)
{
    <div class="ops-overlay ops-overlay-center" @onclick="CloseConsolidate">
        <div class="ops-dialog" role="dialog" aria-modal="true" aria-label="Consolidate the day"
             @onclick:stopPropagation="true">
            <div class="ops-dialog-head">
                <h2>Consolidate the day</h2>
                <button type="button" class="ops-x" aria-label="Close" @onclick="CloseConsolidate">
                    <i class="ph ph-x" aria-hidden="true"></i>
                </button>
            </div>

            <div class="ops-dialog-body">
                <p class="ops-ds-lede">
                    Everything still awaiting close is uploaded to the back office as one
                    consolidation document. Fiscal numbers stay as they were issued on the device.
                </p>

                <dl class="ops-ds-facts">
                    <dt>Awaiting close</dt>
                    <dd>@(report?.UnpostedInvoiceCount ?? 0)</dd>
                    <dt>Value listed</dt>
                    <dd>@Money(awaitingValue)</dd>
                    <dt>Already consolidated</dt>
                    <dd>@(report?.PostedInvoiceCount ?? 0)</dd>
                    <dt>Posting date</dt>
                    <dd>@DateTime.Today.ToString("dd.MM.yyyy")</dd>
                </dl>

                @if (report != null && report.ReportDate.Date != DateTime.Today)
                {
                    <div class="ops-msg ops-fam-warn">
                        <i class="ph ph-warning" aria-hidden="true"></i>
                        <div class="ops-msg-body">
                            The figures above are for @report.ReportDate.ToString("dd MMM yyyy"), but the
                            run itself always closes today. Set the period back to Today to see what it
                            will actually pick up.
                        </div>
                    </div>
                }
            </div>

            <div class="ops-dialog-foot">
                <button type="button" class="ops-btn ops-btn-ghost" @onclick="CloseConsolidate">Cancel</button>
                <button type="button" class="ops-btn ops-btn-primary" @onclick="TriggerConsolidation"
                        disabled="@isConsolidating">
                    @if (isConsolidating)
                    {
                        <span class="ops-spin"></span>
                        <span>Consolidating&hellip;</span>
                    }
                    else
                    {
                        <span>Consolidate</span>
                    }
                </button>
            </div>
        </div>
    </div>
}

@if (selectedSale != null)
{
    <div class="ops-overlay ops-overlay-right" @onclick="CloseDrawer">
        <aside class="ops-drawer ops-ds-drawer" role="dialog" aria-modal="true"
               aria-label="Fiscalized invoice @selectedSale.ExternalReferenceId"
               @onclick:stopPropagation="true">

            @* The head states the document rather than the page: a kicker, the
               fiscal reference in full, and the two statuses as marks. The
               reference is a long device-issued string, so it wraps instead of
               being truncated into something nobody can match to a receipt. *@
            <div class="ops-drawer-head ops-ds-dhead">
                <div class="ops-ds-dhead-id">
                    <span class="ops-kicker">Fiscalized invoice</span>
                    <span class="ops-ds-dhead-ref">@selectedSale.ExternalReferenceId</span>
                </div>

                @* Up and down walk the page that is loaded, not the whole
                   result set — paging is what the pager is for, and a Next
                   that silently fetched the next page would move the list
                   under the user while they were reading one row of it. *@
                <div class="ops-ds-dnav">
                    <button type="button" class="ops-icon-btn" title="Previous sale"
                            aria-label="Previous sale" disabled="@(sales.Count < 2)"
                            @onclick="() => StepSale(-1)">
                        <i class="ph ph-caret-up" aria-hidden="true"></i>
                    </button>
                    <button type="button" class="ops-icon-btn" title="Next sale"
                            aria-label="Next sale" disabled="@(sales.Count < 2)"
                            @onclick="() => StepSale(1)">
                        <i class="ph ph-caret-down" aria-hidden="true"></i>
                    </button>
                    <button type="button" class="ops-icon-btn" title="Close"
                            aria-label="Close" @onclick="CloseDrawer">
                        <i class="ph ph-x" aria-hidden="true"></i>
                    </button>
                </div>

                <div class="ops-ds-dtags">
                    <span class="ops-badge @ConsolidationFamily(selectedSale.ConsolidationStatus)">
                        @ConsolidationLabel(selectedSale.ConsolidationStatus)
                    </span>
                    <span class="ops-ds-state @FiscalFamily(selectedSale.FiscalizationStatus)">
                        <span class="ops-dot"></span>Fiscal @Blank(selectedSale.FiscalizationStatus)
                    </span>
                    @* One timestamp, stated once. The design shows a raised
                       time and a fiscalized time; a desktop sale carries
                       CreatedAt and nothing else, and two labels over one
                       value would invent a gap nobody measured. *@
                    <span class="ops-ds-dwhen">@Full(selectedSale.CreatedAt)</span>
                </div>
            </div>

            <div class="ops-drawer-body">
                <div class="ops-ds-headline">
                    <b>@Money(selectedSale.TotalAmount, selectedSale.Currency)</b>
                    <span>@tenderText</span>
                </div>

                <div class="ops-defs">
                    <div>
                        <div class="ops-def-k">Customer</div>
                        <div class="ops-def-v">@(selectedSale.CardName ?? selectedSale.CardCode)</div>
                    </div>
                    <div>
                        <div class="ops-def-k">Card code</div>
                        <div class="ops-def-v">@selectedSale.CardCode</div>
                    </div>
                    <div>
                        <div class="ops-def-k">Warehouse</div>
                        <div class="ops-def-v">@selectedSale.WarehouseCode</div>
                    </div>
                    <div>
                        <div class="ops-def-k">Raised in</div>
                        <div class="ops-def-v">@Blank(selectedSale.SourceSystem)</div>
                    </div>
                    <div>
                        <div class="ops-def-k">Captured by</div>
                        <div class="ops-def-v">@Blank(selectedSale.CreatedBy)</div>
                    </div>
                    <div>
                        <div class="ops-def-k">Payment method</div>
                        <div class="ops-def-v">@Blank(selectedSale.PaymentMethod)</div>
                    </div>
                    @if (!string.IsNullOrWhiteSpace(selectedSale.PaymentReference))
                    {
                        <div>
                            <div class="ops-def-k">Payment reference</div>
                            <div class="ops-def-v">@selectedSale.PaymentReference</div>
                        </div>
                    }
                </div>

                @if (selectedSale.Lines.Count > 0)
                {
                    <div class="ops-ds-block">
                        <div class="ops-def-k">Lines</div>
                        <table class="ops-table">
                            <thead>
                                <tr>
                                    <th>Item</th>
                                    <th class="ops-num">Qty</th>
                                    <th class="ops-num">Unit price</th>
                                    <th class="ops-num">Total</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var line in selectedSale.Lines)
                                {
                                    <tr>
                                        <td>
                                            <span class="ops-code">@line.ItemCode</span>
                                            @if (!string.IsNullOrEmpty(line.ItemDescription))
                                            {
                                                <div class="ops-sub">@line.ItemDescription</div>
                                            }
                                        </td>
                                        <td class="ops-num">@QuantityDisplay.Format(line.Quantity)</td>
                                        <td class="ops-num">@line.UnitPrice.ToString("N2")</td>
                                        <td class="ops-num">@line.LineTotal.ToString("N2")</td>
                                    </tr>
                                }
                            </tbody>
                        </table>

                        @* Just "VAT": the design labels it 13%, but the rate is
                           charged per line at its own tax code's rate — see
                           CreateDesktopSaleHandler — so a basket carrying a
                           zero-rated item is not 13% of anything. *@
                        <div class="ops-ds-sum">
                            <div>
                                <span>Net</span>
                                <span>@Money(selectedSale.TotalAmount - selectedSale.VatAmount, selectedSale.Currency)</span>
                            </div>
                            <div>
                                <span>VAT</span>
                                <span>@Money(selectedSale.VatAmount, selectedSale.Currency)</span>
                            </div>
                            <div class="ops-ds-sum-total">
                                <span>Total</span>
                                <span>@Money(selectedSale.TotalAmount, selectedSale.Currency)</span>
                            </div>
                        </div>
                    </div>
                }

                @* Only drawn when the device actually signed something. A panel
                   headed "Fiscal signature" over four em dashes says the receipt
                   is unsigned far less clearly than its absence does, and the
                   trail below already carries that fact in words. *@
                @if (hasFiscalBlock)
                {
                    <div class="ops-ds-sig">
                        <div class="ops-ds-sig-head">
                            <i class="ph ph-seal-check" aria-hidden="true"></i>
                            <span class="ops-ds-card-label">Fiscal signature</span>
                        </div>

                        @if (!string.IsNullOrWhiteSpace(selectedSale.FiscalVerificationCode))
                        {
                            <div class="ops-ds-sig-code">@GroupCode(selectedSale.FiscalVerificationCode)</div>
                        }

                        <div class="ops-ds-sig-foot">
                            <span>@signatureMeta</span>
                            @* FiscalQRCode holds the ZIMRA verification URL
                               itself rather than an image, so it is a link and
                               not a picture. Guarded all the same: an older row
                               could hold something that is not a URL. *@
                            @if (verifyUrl != null)
                            {
                                <a class="ops-ds-verify" href="@verifyUrl" target="_blank" rel="noopener noreferrer">
                                    Verify with ZIMRA<i class="ph ph-arrow-up-right" aria-hidden="true"></i>
                                </a>
                            }
                        </div>
                    </div>
                }

                <div class="ops-ds-block">
                    <div class="ops-def-k">Consolidation trail</div>
                    <div class="ops-ds-trail">
                        @foreach (var step in trail)
                        {
                            <div class="ops-ds-trail-step @step.Family">
                                <div class="ops-ds-trail-rail">
                                    <span class="ops-ds-trail-mark @(step.IsNow ? "is-now" : "")"></span>
                                </div>
                                <div class="ops-ds-trail-body">
                                    <div class="ops-ds-trail-label">@step.Label</div>
                                    <div class="ops-ds-trail-meta">@step.Meta</div>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>

            @* The design's three per-sale actions — Consolidate now, Exclude
               from close, Receipt PDF — are not drawn, for the same reason its
               row checkboxes are not: nothing behind this page can do any of
               them. Consolidation is a whole-day, server-side run that takes no
               argument, there is no exclude endpoint, and no receipt PDF is
               kept for a desktop sale. A Consolidate that quietly closed the
               whole day would be the worst of the three. *@
            <div class="ops-drawer-foot">
                <button type="button" class="ops-btn ops-btn-ghost" @onclick="CloseDrawer">Close</button>
            </div>
        </aside>
    </div>
}

@code {
    private const string PeriodToday = "today";
    private const string PeriodWeek = "week";
    private const string PeriodCustom = "custom";

    private List<DesktopSaleDto> sales = new();
    private List<WarehouseDto> warehouses = new();

    private IEnumerable<NocturneSelectOption<string>> WarehouseFilterOptions =>
        warehouses
            .Where(w => !string.IsNullOrWhiteSpace(w.WarehouseCode))
            .Select(w => new NocturneSelectOption<string>(w.WarehouseCode!, w.WarehouseCode!, "info"))
            .Prepend(NocturneSelectOption.All("All warehouses"));

    private static readonly NocturneSelectOption<string>[] ConsolidationFilterOptions =
    [
        new(string.Empty, "Any status", "neutral") { IsUnset = true, RuleAfter = true },
        new("Pending", "Awaiting close", "warn"),
        new("Consolidated", "Consolidated", "good"),
        new("Failed", "Failed", "bad"),
        new("Excluded", "Excluded", "neutral")
    ];
    private DesktopSaleDto? selectedSale;
    private EndOfDayReportDto? report;

    private bool isLoading;
    private bool isConsolidating;
    private bool isExporting;
    private bool showConsolidate;
    private DateTime? lastPolledAt;

    // One notice for everything this page does itself; the Snackbar is left to
    // the push events, which arrive while the user is looking elsewhere.
    private string? notice;
    private string noticeFamily = "ops-fam-info";
    private string noticeIcon = "ph-info";

    // Filters
    private string filterWarehouse = "";
    private string filterCardCode = "";
    private string filterStatus = "";
    private string period = PeriodToday;
    private DateTime? filterFromDate;
    private DateTime? filterToDate;

    // Pagination
    private int currentPage = 1;
    private int pageSize = 50;
    private int totalCount;
    private bool hasMore;
    private int totalPages => totalCount > 0 ? (int)Math.Ceiling((double)totalCount / pageSize) : 1;

    private bool hasFilters =>
        filterWarehouse != "" || filterCardCode != "" || filterStatus != "" || period != PeriodToday;

    protected override async Task OnInitializedAsync()
    {
        filterFromDate = DateTime.Today;
        filterToDate = DateTime.Today;

        var warehouseList = await MasterDataCache.GetWarehousesAsync();
        warehouses = warehouseList?.Where(w => w.IsActive).ToList() ?? new();

        await LoadData();
        await AuditService.LogAsync(AuditActions.ViewDesktopTransactions, "DesktopSale", null);

        HubService.OnDesktopSaleCreated += OnSaleCreated;
        HubService.OnConsolidationCompleted += OnConsolidationDone;
    }

    private async void OnSaleCreated()
    {
        await InvokeAsync(async () =>
        {
            Snackbar.Add("New desktop sale received", Severity.Info);
            await LoadData();
            StateHasChanged();
        });
    }

    private async void OnConsolidationDone()
    {
        await InvokeAsync(async () =>
        {
            Snackbar.Add("Consolidation completed — data refreshed", Severity.Success);
            await LoadData();
            StateHasChanged();
        });
    }

    // ── Loading ──────────────────────────────────────────────────────────

    private async Task LoadData()
    {
        isLoading = true;
        StateHasChanged();

        try
        {
            var response = await DesktopService.GetDesktopSalesAsync(
                string.IsNullOrEmpty(filterWarehouse) ? null : filterWarehouse,
                string.IsNullOrEmpty(filterCardCode) ? null : filterCardCode,
                string.IsNullOrEmpty(filterStatus) ? null : filterStatus,
                filterFromDate,
                filterToDate,
                currentPage,
                pageSize);

            if (response != null)
            {
                sales = response.Sales;
                totalCount = response.TotalCount;
                hasMore = response.HasMore;
                lastPolledAt = DateTime.Now;
                ClearError();
            }
            else
            {
                SayError("Failed to load desktop sales. Check that the API is running.");
            }

            report = await DesktopService.GetEndOfDayReportAsync(filterFromDate);
        }
        catch (Exception ex)
        {
            SayError($"Error: {ex.Message}");
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task RefreshData()
    {
        currentPage = 1;
        await LoadData();
    }

    // ── Filters ──────────────────────────────────────────────────────────
    // Every one of these is a single deliberate act — picking a warehouse,
    // committing a card code, choosing a period — so each reloads on its own
    // rather than waiting behind a Search button the design does not draw.

    private async Task ApplyFilters()
    {
        currentPage = 1;
        await LoadData();
    }

    private async Task SetPeriod(string value)
    {
        if (period == value)
        {
            return;
        }

        period = value;

        if (value == PeriodToday)
        {
            filterFromDate = DateTime.Today;
            filterToDate = DateTime.Today;
        }
        else if (value == PeriodWeek)
        {
            filterFromDate = DateTime.Today.AddDays(-6);
            filterToDate = DateTime.Today;
        }
        // "custom" keeps whatever pair is already in the fields and reveals them.

        await ApplyFilters();
    }

    private async Task OnFromDateChanged(DateTime? value)
    {
        filterFromDate = value;
        await ApplyFilters();
    }

    private async Task OnToDateChanged(DateTime? value)
    {
        filterToDate = value;
        await ApplyFilters();
    }

    private async Task ClearFilters()
    {
        filterWarehouse = "";
        filterCardCode = "";
        filterStatus = "";
        period = PeriodToday;
        filterFromDate = DateTime.Today;
        filterToDate = DateTime.Today;
        await ApplyFilters();
    }

    // ── Paging ───────────────────────────────────────────────────────────

    private async Task NextPage()
    {
        if (hasMore)
        {
            currentPage++;
            await LoadData();
        }
    }

    private async Task PreviousPage()
    {
        if (currentPage > 1)
        {
            currentPage--;
            await LoadData();
        }
    }

    // ── The detail drawer ────────────────────────────────────────────────

    private void SelectSale(DesktopSaleDto sale) => selectedSale = sale;

    private void CloseDrawer() => selectedSale = null;

    // Up and down wrap within the loaded page. Falling off the end into the
    // next page would fetch behind the drawer and rewrite the list underneath
    // it; the pager is where changing page belongs.
    private void StepSale(int direction)
    {
        if (selectedSale == null || sales.Count < 2)
        {
            return;
        }

        var index = sales.FindIndex(s => s.Id == selectedSale.Id);
        if (index < 0)
        {
            return;
        }

        selectedSale = sales[((index + direction) % sales.Count + sales.Count) % sales.Count];
    }

    // What the customer handed over, and what went back. A sale can carry no
    // tender at all — an account transfer the till never settled, a card that
    // was declined — and "tendered 0.00 · change 0.00" states that far less
    // clearly than saying so.
    private string tenderText
    {
        get
        {
            var sale = selectedSale!;
            if (sale.AmountPaid <= 0)
            {
                return "no payment recorded";
            }

            var tendered = $"tendered {Money(sale.AmountPaid, sale.Currency)}";
            var change = sale.AmountPaid - sale.TotalAmount;
            return change > 0 ? $"{tendered} · change {Money(change, sale.Currency)}" : tendered;
        }
    }

    // ── The fiscal block ─────────────────────────────────────────────────
    // Four columns the API has always returned and this page never read. They
    // are the only record of what the device signed: the receipt was signed
    // under the sale's own external reference rather than a SAP document
    // number, so the invoice it eventually becomes never restates them.

    private bool hasFiscalBlock =>
        selectedSale != null &&
        (!string.IsNullOrWhiteSpace(selectedSale.FiscalVerificationCode) ||
         !string.IsNullOrWhiteSpace(selectedSale.FiscalReceiptNumber) ||
         !string.IsNullOrWhiteSpace(selectedSale.FiscalDeviceNumber) ||
         !string.IsNullOrWhiteSpace(selectedSale.FiscalDayNo) ||
         verifyUrl != null);

    private string signatureMeta
    {
        get
        {
            var sale = selectedSale!;
            var parts = new List<string>();

            if (!string.IsNullOrWhiteSpace(sale.FiscalReceiptNumber))
            {
                parts.Add($"Receipt {sale.FiscalReceiptNumber}");
            }

            if (!string.IsNullOrWhiteSpace(sale.FiscalDeviceNumber))
            {
                parts.Add($"device {sale.FiscalDeviceNumber}");
            }

            if (!string.IsNullOrWhiteSpace(sale.FiscalDayNo))
            {
                parts.Add($"fiscal day {sale.FiscalDayNo}");
            }

            return parts.Count > 0 ? string.Join(" · ", parts) : "Signed on the device";
        }
    }

    // The QR payload is the ZIMRA verification URL, not an image — see
    // FiscalReceiptQrComposer.BuildQrPayload, which composes it as
    // {qrUrl}/{device}{date}{receipt}{code}. Anything that is not an http(s)
    // URL is not turned into a link: the column is 500 characters of whatever
    // the platform returned, and older rows predate the composer.
    private string? verifyUrl
    {
        get
        {
            var raw = selectedSale?.FiscalQRCode?.Trim();
            if (string.IsNullOrEmpty(raw))
            {
                return null;
            }

            return Uri.TryCreate(raw, UriKind.Absolute, out var uri) &&
                   (uri.Scheme == Uri.UriSchemeHttp || uri.Scheme == Uri.UriSchemeHttps)
                ? raw
                : null;
        }
    }

    // Blocks of four, the way the receipt prints it. Display only — the code
    // goes to ZIMRA unbroken, and nothing here sends it anywhere.
    private static string GroupCode(string? code)
    {
        if (string.IsNullOrWhiteSpace(code))
        {
            return "";
        }

        var groups = new List<string>();
        for (var i = 0; i < code.Length; i += 4)
        {
            groups.Add(code.Substring(i, Math.Min(4, code.Length - i)));
        }

        return string.Join("-", groups);
    }

    // ── The trail ────────────────────────────────────────────────────────
    // Four steps, each read off a column rather than a script: when the sale
    // was captured, whether the device signed it, whether the close took it,
    // and what it became in SAP. The design's fourth step assumes a ledger
    // posting time this page has no field for; the SAP document number is the
    // fact that actually answers "and then what", so that is what it states.

    private sealed record TrailStep(string Label, string Meta, string Family, bool IsNow = false);

    private List<TrailStep> trail
    {
        get
        {
            var sale = selectedSale!;

            var origin = new List<string> { Full(sale.CreatedAt) };
            if (!string.IsNullOrWhiteSpace(sale.CreatedBy))
            {
                origin.Add(sale.CreatedBy);
            }
            if (!string.IsNullOrWhiteSpace(sale.SourceSystem))
            {
                origin.Add(sale.SourceSystem);
            }

            var steps = new List<TrailStep>
            {
                new("Raised in the desktop app", string.Join(" · ", origin), "ops-fam-good")
            };

            steps.Add(sale.FiscalizationStatus?.ToLowerInvariant() switch
            {
                "success" => new TrailStep(
                    "Fiscalized on the device",
                    string.IsNullOrWhiteSpace(sale.FiscalReceiptNumber)
                        ? "the authority accepted the receipt"
                        : $"receipt {sale.FiscalReceiptNumber} accepted",
                    "ops-fam-good"),
                "failed" => new TrailStep(
                    "Fiscalization failed",
                    "the device could not sign this receipt",
                    "ops-fam-bad"),
                "skipped" => new TrailStep(
                    "Fiscalization skipped",
                    "this sale was not put to the device",
                    "ops-fam-neutral"),
                _ => new TrailStep(
                    "Awaiting fiscalization",
                    "the device has not signed this receipt yet",
                    "ops-fam-accent",
                    IsNow: true)
            });

            steps.Add(sale.ConsolidationStatus?.ToLowerInvariant() switch
            {
                "consolidated" => new TrailStep(
                    "Consolidated into the back office",
                    sale.ConsolidationId.HasValue ? $"run #{sale.ConsolidationId}" : "closed",
                    "ops-fam-good"),
                "failed" => new TrailStep(
                    "Consolidation failed",
                    "the run could not take this sale",
                    "ops-fam-bad"),
                "excluded" => new TrailStep(
                    "Excluded from the close",
                    "left out of the consolidation run",
                    "ops-fam-neutral"),
                _ => new TrailStep(
                    "Awaiting day close",
                    "stays on the device until the day is consolidated",
                    "ops-fam-accent",
                    IsNow: true)
            });

            // Two routes reach SAP and they write different columns. The
            // per-sale posting job stamps SapDocNum on the row; the end-of-day
            // run groups a customer's sales into one consolidated invoice and
            // stamps the DocNum on the *consolidation*, leaving only
            // ConsolidationId here. Reading one and not the other is why a
            // consolidated sale used to look like it had gone nowhere.
            if (sale.SapDocNum.HasValue)
            {
                var meta = sale.PostedAt.HasValue
                    ? $"invoice {sale.SapDocNum} · {Full(sale.PostedAt.Value)}"
                    : $"invoice {sale.SapDocNum}";
                steps.Add(new TrailStep("Posted to SAP", meta, "ops-fam-good"));
            }
            else if (sale.ConsolidationId.HasValue)
            {
                steps.Add(new TrailStep(
                    "Posted with the consolidation run",
                    $"run #{sale.ConsolidationId} carries the SAP invoice, not this row",
                    "ops-fam-good"));
            }
            else if (Is(sale.ConsolidationStatus, "Consolidated"))
            {
                steps.Add(new TrailStep(
                    "No SAP document recorded",
                    "the sale is closed, but nothing on this row names the invoice it became",
                    "ops-fam-warn"));
            }
            else if (Is(sale.ConsolidationStatus, "Excluded"))
            {
                steps.Add(new TrailStep(
                    "No SAP document",
                    "an excluded sale is never invoiced",
                    "ops-fam-neutral"));
            }
            else
            {
                steps.Add(new TrailStep(
                    "Not in SAP yet",
                    "posts as part of the day's consolidation",
                    "ops-fam-neutral"));
            }

            return steps;
        }
    }

    // ── Consolidation ────────────────────────────────────────────────────

    private void OpenConsolidate() => showConsolidate = true;

    private void CloseConsolidate() => showConsolidate = false;

    private decimal awaitingValue => report?.UnpostedSales.Sum(s => s.Amount) ?? 0m;

    private async Task TriggerConsolidation()
    {
        isConsolidating = true;
        StateHasChanged();
        try
        {
            var success = await DesktopService.TriggerConsolidationAsync();
            showConsolidate = false;

            if (success)
            {
                Say("End-of-day consolidation triggered. The back office picks the invoices up as the run completes.",
                    "ops-fam-good", "ph-check-circle");
                await LoadData();
            }
            else
            {
                SayError("The consolidation run could not be started.");
            }
        }
        catch (Exception ex)
        {
            showConsolidate = false;
            SayError($"Consolidation failed: {ex.Message}");
        }
        finally
        {
            isConsolidating = false;
        }
    }

    private async Task ExportToExcel()
    {
        if (sales.Count == 0)
        {
            return;
        }

        isExporting = true;
        StateHasChanged();
        try
        {
            var bytes = ExportService.ExportDesktopSalesToExcel(sales, report, filterFromDate, filterToDate);
            var base64 = Convert.ToBase64String(bytes);
            await JS.InvokeVoidAsync("downloadFile", $"Desktop_Sales_{DateTime.Now:yyyyMMdd_HHmm}.xlsx", base64);
        }
        catch (Exception ex)
        {
            SayError($"Export failed: {ex.Message}");
        }
        finally
        {
            isExporting = false;
            StateHasChanged();
        }
    }

    // ── Notices ──────────────────────────────────────────────────────────

    private void Say(string text, string family, string icon)
    {
        notice = text;
        noticeFamily = family;
        noticeIcon = icon;
    }

    private void SayError(string text) => Say(text, "ops-fam-bad", "ph-warning-octagon");

    // A successful reload clears a failure that is no longer true, and leaves a
    // consolidation result standing — that one is news, not an error state.
    private void ClearError()
    {
        if (noticeFamily == "ops-fam-bad")
        {
            notice = null;
        }
    }

    // ── The day summary ──────────────────────────────────────────────────

    private sealed record Lane(string Name, int Count, string Family);

    private string dayLabel => report == null
        ? "Day in progress"
        : report.ReportDate.Date == DateTime.Today
            ? "Day in progress"
            : report.ReportDate.ToString("dd MMM yyyy");

    // Drawn from the report rather than from `sales`, which is one page of a
    // filtered list and would make the lanes disagree with the total above them.
    // The unposted list carries a status per row; the counts it does not explain
    // fall into "awaiting close", so the four always add up to the day.
    private List<Lane> lanes
    {
        get
        {
            if (report == null)
            {
                return new();
            }

            var listed = report.UnpostedSales;
            var failed = listed.Count(s => Is(s.ConsolidationStatus, "Failed"));
            var excluded = listed.Count(s => Is(s.ConsolidationStatus, "Excluded"));
            var awaiting = Math.Max(0, report.UnpostedInvoiceCount - failed - excluded);

            return new()
            {
                new Lane("Awaiting close", awaiting, "ops-fam-accent"),
                new Lane("Consolidated", report.PostedInvoiceCount, "ops-fam-good"),
                new Lane("Failed", failed, "ops-fam-bad"),
                new Lane("Excluded", excluded, "ops-fam-neutral")
            };
        }
    }

    private int laneTotal => lanes.Sum(l => l.Count);

    private List<BPSummaryDto> topPartners => report?.BusinessPartnerSummaries
        .Where(b => b.TotalAmount > 0)
        .OrderByDescending(b => b.TotalAmount)
        .Take(5)
        .ToList() ?? new();

    private decimal topPartnerMax => topPartners.Count > 0 ? topPartners.Max(b => b.TotalAmount) : 0m;

    // ── Text ─────────────────────────────────────────────────────────────

    // The count answers the filter row and sits with it; the foot is left to
    // say how fresh the rows under it are. The design puts a "refreshes every
    // 30s" note there — nothing on this page polls on a timer, so it says what
    // actually brings a new row in.
    private string shownText => $"Showing {sales.Count} of {totalCount} · newest first";

    private string footerText => lastPolledAt.HasValue
        ? $"Polled {lastPolledAt:HH:mm:ss} · rows arrive as the devices report in"
        : "Rows arrive as the devices report in";

    private string emptyTitle => hasFilters ? "Nothing matches these filters" : "The day is clear";

    private string emptyBody => hasFilters
        ? "Widen the period or clear the filters to see the rest of the day."
        : "Invoices fiscalized on the desktop apps appear here within a few seconds of being issued.";

    // ── Formatting ───────────────────────────────────────────────────────

    // The report carries no currency of its own, so its figures borrow the one
    // the loaded sales are in. With nothing loaded the amount stands alone
    // rather than being labelled with a guess.
    private string currencyCode => sales.FirstOrDefault()?.Currency ?? "";

    private string Money(decimal value) => Money(value, currencyCode);

    private static string Money(decimal value, string? code) =>
        string.IsNullOrEmpty(code) ? value.ToString("N2") : $"{code} {value.ToString("N2")}";

    private static string Percent(int part, int whole) =>
        whole <= 0 ? "0%" : ((double)part / whole * 100).ToString("0.##", CultureInfo.InvariantCulture) + "%";

    private static string Percent(decimal part, decimal whole) =>
        whole <= 0 ? "0%" : ((double)(part / whole) * 100).ToString("0.##", CultureInfo.InvariantCulture) + "%";

    // The +2h is the app's standing display offset for these timestamps.
    private static string Stamp(DateTime createdAt)
    {
        var local = createdAt.AddHours(2);
        return local.Date == DateTime.Today ? local.ToString("HH:mm") : local.ToString("dd MMM HH:mm");
    }

    // The drawer states a date whatever day the row is from: it is read on its
    // own, away from the column that made "12:17" unambiguous.
    private static string Full(DateTime utc) => utc.AddHours(2).ToString("dd MMM yyyy, HH:mm");

    private static bool Is(string? status, string value) =>
        string.Equals(status, value, StringComparison.OrdinalIgnoreCase);

    private static string Blank(string? text) => string.IsNullOrWhiteSpace(text) ? "—" : text;

    private static string ConsolidationLabel(string? status) =>
        Is(status, "Pending") ? "Awaiting close" : Blank(status);

    private static string FiscalFamily(string? status) => status?.ToLowerInvariant() switch
    {
        "success" => "ops-fam-good",
        "pending" => "ops-fam-warn",
        "failed" => "ops-fam-bad",
        "skipped" => "ops-fam-neutral",
        _ => "ops-fam-neutral"
    };

    // Awaiting close takes the accent rather than a warning hue: it is the
    // expected state of a sale the day has not closed on yet, not a problem.
    private static string ConsolidationFamily(string? status) => status?.ToLowerInvariant() switch
    {
        "consolidated" => "ops-fam-good",
        "pending" => "ops-fam-accent",
        "failed" => "ops-fam-bad",
        "excluded" => "ops-fam-neutral",
        _ => "ops-fam-neutral"
    };

    public void Dispose()
    {
        HubService.OnDesktopSaleCreated -= OnSaleCreated;
        HubService.OnConsolidationCompleted -= OnConsolidationDone;
    }
}
