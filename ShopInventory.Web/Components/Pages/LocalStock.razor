@page "/local-stock"
@using Microsoft.AspNetCore.Authorization
@using ShopInventory.Web.Data
@using ShopInventory.Web.Models
@using ShopInventory.Web.Services
@attribute [Authorize(Roles = "Admin,StockController,DepotController")]
@inject IDesktopIntegrationService DesktopService
@inject IMasterDataCacheService MasterDataCache
@inject IReportExportService ExportService
@inject INotificationHubService HubService
@inject IJSRuntime JS
@inject ISnackbar Snackbar
@inject IAuditService AuditService
@inject AuthenticationStateProvider AuthStateProvider
@implements IDisposable
@rendermode InteractiveServer

<PageTitle>Local Stock - Shop Inventory</PageTitle>

@* Nocturne. wwwroot/css/local-stock.css (linked from App.razor) carries the
   design and its light counterpart, and follows the app's theme toggle.
   Derived from business-partners.css like audit-trail.css beside it; that
   sheet's header says what the shared palette costs.

   Icons are drawn inline rather than from the Phosphor or Bootstrap icon
   fonts: the search glyph sits inside a field and the twisty is the only thing
   saying a row opens, so a font that failed to load would leave both reading
   as nothing.

   The items are a CSS grid rather than a <table>: a batch row spans two of the
   seven columns and lines up with the item above it, and below 1040px the same
   markup re-lays as a labelled card, which a table cannot do.

   The snapshot date is NocturneDateField — it takes the shorthand people type
   (`030826`) and draws a calendar that belongs to this design, neither of which
   a native date input does. *@

<div class="lst">

    <header class="lst-head">
        <div class="lst-head-inner">
            <label class="lst-head-search">
                <span class="visually-hidden">Search the loaded items</span>
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"
                     stroke-linecap="round" aria-hidden="true">
                    <circle cx="11" cy="11" r="7"></circle>
                    <path d="M20 20l-3.5-3.5"></path>
                </svg>
                @* Disabled rather than hidden until a snapshot is loaded: a search
                   that comes and goes makes the header jump. *@
                <input class="lst-input lst-input-search" type="search" autocomplete="off"
                       placeholder="@(stockResult == null ? "Load a snapshot to search…" : "Item code or description…")"
                       disabled="@(stockResult == null)" @bind="searchTerm" @bind:event="oninput" />
            </label>
            <div class="lst-head-meta">
                @if (HubService.IsConnected)
                {
                    <span class="lst-live" title="Receiving live stock updates">
                        <span class="lst-live-dot" aria-hidden="true"></span>Live
                    </span>
                }
                <button type="button" class="lst-btn lst-btn-quiet" disabled="@isLoading" @onclick="LoadStock">
                    @if (isLoading)
                    {
                        <span class="lst-spin" aria-hidden="true"></span>
                        <span>Loading&#8230;</span>
                    }
                    else
                    {
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                             stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <path d="M20 11a8 8 0 0 0-13.7-5.3L4 8"></path>
                            <path d="M4 4v4h4"></path>
                            <path d="M4 13a8 8 0 0 0 13.7 5.3L20 16"></path>
                            <path d="M20 20v-4h-4"></path>
                        </svg>
                        <span>Refresh</span>
                    }
                </button>
                <button type="button" class="lst-btn lst-btn-quiet"
                        disabled="@(isExporting || stockResult == null || !filteredItems.Any())" @onclick="ExportToExcel">
                    @if (isExporting)
                    {
                        <span class="lst-spin" aria-hidden="true"></span>
                        <span>Exporting&#8230;</span>
                    }
                    else
                    {
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                             stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <path d="M12 3v12"></path>
                            <path d="M7.5 10.5L12 15l4.5-4.5"></path>
                            <path d="M4 19h16"></path>
                        </svg>
                        <span>Export</span>
                    }
                </button>
                <button type="button" class="lst-btn lst-btn-primary" disabled="@isFetching" @onclick="TriggerStockFetch">
                    @if (isFetching)
                    {
                        <span class="lst-spin" aria-hidden="true"></span>
                        <span>Fetching&#8230;</span>
                    }
                    else
                    {
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                             stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <path d="M7 18a4.5 4.5 0 0 1 .6-9 6 6 0 0 1 11.4 2 3.5 3.5 0 0 1-.5 7"></path>
                            <path d="M12 12v7M9 16.5l3 3 3-3"></path>
                        </svg>
                        <span>Fetch stock</span>
                    }
                </button>
            </div>
        </div>
    </header>

    <div class="lst-body">

        <section class="lst-hero">
            <div>
                <div class="lst-kicker">Operations</div>
                <h1>Local stock</h1>
                <p>The day's snapshot from SAP, adjusted as transfers and sales move stock through the warehouse.</p>
            </div>
        </section>

        @if (fetchProgress != null)
        {
            var pct = fetchProgress.TotalCount > 0
                ? (int)((double)fetchProgress.CompletedCount / fetchProgress.TotalCount * 100)
                : 0;

            <section class="lst-fetch" aria-live="polite">
                <div class="lst-fetch-head">
                    <span class="lst-spin" aria-hidden="true"></span>
                    <h2>
                        @(fetchProgress.Status switch
                        {
                            "Complete" => "Stock fetch complete",
                            "Initializing" => "Starting the stock fetch…",
                            _ => "Fetching stock from SAP…"
                        })
                    </h2>
                    <span class="lst-fetch-count">
                        @fetchProgress.CompletedCount / @fetchProgress.TotalCount warehouses
                    </span>
                </div>

                <div class="lst-rail" role="progressbar" aria-valuenow="@pct" aria-valuemin="0" aria-valuemax="100">
                    <div class="lst-rail-fill" style="width:@(pct)%"></div>
                </div>

                @if (fetchProgress.Status == "Initializing" && !HubService.IsConnected)
                {
                    <p class="lst-fetch-note">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                             stroke-width="1.7" stroke-linecap="round" aria-hidden="true">
                            <circle cx="12" cy="12" r="9"></circle>
                            <path d="M12 11v5.5M12 7.8v.1"></path>
                        </svg>
                        Live updates are unavailable, so this will refresh on its own once the fetch finishes.
                    </p>
                }

                @* A finished warehouse is the way into its snapshot, so its chip is
                   a button and the rest are not. *@
                <div class="lst-chips">
                    @foreach (var wh in warehouses)
                    {
                        var whCode = wh.WarehouseCode ?? "";
                        var isDone = fetchProgress.CompletedWarehouses.Contains(whCode);
                        var isFailed = isDone && fetchProgress.FailedWarehouses.Contains(whCode);
                        var isActive = !isDone && fetchProgress.CompletedCount < fetchProgress.TotalCount
                            && fetchProgress.CompletedWarehouses.Count > 0
                            && whCode == GetNextWarehouse(fetchProgress);

                        if (isFailed)
                        {
                            <button type="button" class="lst-chip lst-chip-failed"
                                    title="The fetch for @whCode failed. Show it, then refresh it from SAP"
                                    @onclick="() => SelectCompletedWarehouse(whCode)">
                                <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                     stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"
                                     aria-hidden="true">
                                    <path d="M7 7l10 10M17 7L7 17"></path>
                                </svg>
                                @whCode
                            </button>
                        }
                        else if (isDone)
                        {
                            <button type="button" class="lst-chip lst-chip-done"
                                    title="Show the snapshot for @whCode"
                                    @onclick="() => SelectCompletedWarehouse(whCode)">
                                <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                     stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"
                                     aria-hidden="true">
                                    <path d="M5 12.5l4.5 4.5L19 7"></path>
                                </svg>
                                @whCode
                            </button>
                        }
                        else
                        {
                            <span class="lst-chip @(isActive ? "lst-chip-active" : "")">@whCode</span>
                        }
                    }
                </div>
            </section>
        }

        @if (stockResult != null)
        {
            var outOfStock = stockResult.Items.Count(i => i.AvailableQuantity <= 0);

            <section class="lst-stats">
                <div class="lst-stat lst-stat-lead">
                    <div class="lst-stat-head"><span class="lst-stat-rule" aria-hidden="true"></span>Total items</div>
                    <div class="lst-stat-num">@stockResult.Items.Count.ToString("N0")</div>
                    <div class="lst-stat-sub">In this snapshot</div>
                </div>
                <div class="lst-stat">
                    <div class="lst-stat-head"><span class="lst-stat-rule" aria-hidden="true"></span>In stock</div>
                    <div class="lst-stat-num">@stockResult.Items.Count(i => i.AvailableQuantity > 0).ToString("N0")</div>
                    <div class="lst-stat-sub">Something available</div>
                </div>
                <div class="lst-stat @(outOfStock > 0 ? "lst-stat-alert" : "")">
                    <div class="lst-stat-head"><span class="lst-stat-rule" aria-hidden="true"></span>Out of stock</div>
                    <div class="lst-stat-num">@outOfStock.ToString("N0")</div>
                    <div class="lst-stat-sub">Nothing left to sell</div>
                </div>
                <div class="lst-stat">
                    <div class="lst-stat-head"><span class="lst-stat-rule" aria-hidden="true"></span>Transfer adjusted</div>
                    <div class="lst-stat-num">@stockResult.Items.Count(i => i.TransferAdjustment != 0).ToString("N0")</div>
                    <div class="lst-stat-sub">Moved since the snapshot</div>
                </div>
            </section>
        }

        <section class="lst-panel">
            <div class="lst-panel-head">
                <h2>Items</h2>
                @if (stockResult != null)
                {
                    <span class="lst-count">@filteredItems.Count().ToString("N0") shown</span>
                    <span class="lst-snap @GetSnapshotFamily(stockResult.SnapshotStatus)">
                        <span class="lst-snap-dot" aria-hidden="true"></span>
                        @stockResult.WarehouseCode · @stockResult.SnapshotDate.ToString("dd MMM yyyy") ·
                        @stockResult.SnapshotStatus
                    </span>
                }
            </div>

            <div class="lst-filters">
                <label class="lst-field lst-field-warehouse">
                    <span class="lst-label">Warehouse</span>
                    <NocturneSelect Class="nsel-block" Options="WarehouseSelectOptions"
                                    @bind-Value="selectedWarehouse" Caption="Warehouse"
                                    AriaLabel="Warehouse" Placeholder="Select a warehouse" />
                </label>
                @* Not a <label>: the field carries a button and a popup, which a
                   label would swallow the clicks of. *@
                <div class="lst-field lst-field-date">
                    <span class="lst-label">Snapshot date</span>
                    <NocturneDateField @bind-Date="snapshotDate" AriaLabel="Snapshot date" />
                </div>
                <div class="lst-field">
                    <span class="lst-label">&nbsp;</span>
                    <button type="button" class="lst-btn lst-btn-primary"
                            disabled="@(isLoading || string.IsNullOrEmpty(selectedWarehouse))" @onclick="LoadStock">
                        Load
                    </button>
                </div>
                @* Today's ledger only, and one warehouse at a time: it re-reads every item in
                   the warehouse from SAP, which is what a goods receipt PO needs and what the
                   hourly pass deliberately does not do. A van is not re-read: the API has the
                   transfer listener check SAP for transfers instead, since a van's figure is its
                   morning load plus the day's transfers. *@
                <div class="lst-field">
                    <span class="lst-label">&nbsp;</span>
                    <button type="button" class="lst-btn lst-btn-quiet"
                            title="Shops: re-read the quantities from SAP now, less till sales SAP has not received yet. Vans: pick up transfers made since the morning load. A failed snapshot is fetched again."
                            disabled="@(isRefreshing || isLoading || string.IsNullOrEmpty(selectedWarehouse))"
                            @onclick="RefreshFromSap">
                        @if (isRefreshing)
                        {
                            <span class="lst-spin" aria-hidden="true"></span>
                            <span>Refreshing&#8230;</span>
                        }
                        else
                        {
                            <span>Refresh quantities from SAP</span>
                        }
                    </button>
                </div>
                @* Hidden while the list could not be read: an editor with nothing to start from
                   would save whatever was added as the whole list. *@
                @if (canManageTracked && savedTracked.Count > 0)
                {
                    <div class="lst-field">
                        <span class="lst-label">&nbsp;</span>
                        <button type="button" class="lst-btn lst-btn-quiet"
                                aria-expanded="@(isEditingTracked ? "true" : "false")"
                                title="Choose which warehouses the daily snapshot covers"
                                @onclick="ToggleTrackedEditor">
                            <span>Tracked warehouses</span>
                        </button>
                    </div>
                }
            </div>

            @* The whole list is staged here and saved in one call, so a half-made change never reaches
               the snapshot job. Removing a shop is the dangerous edit: once its snapshot is gone its
               till reads zero stock and refuses every sale, so pending removals are named before the
               save rather than discovered after it. *@
            @if (isEditingTracked)
            {
                <section class="lst-track" aria-label="Tracked warehouses">
                    <div class="lst-track-head">
                        <h3>Tracked warehouses <span class="lst-track-count">@stagedTracked.Count</span></h3>
                        <p>
                            The 07:00 snapshot covers these, and transfers and sales adjust them through the day.
                            A till selling from a warehouse that is not tracked reads zero stock.
                        </p>
                    </div>

                    <ul class="lst-track-list">
                        @foreach (var trackedCode in stagedTracked)
                        {
                            var isNew = !savedTracked.Contains(trackedCode, StringComparer.OrdinalIgnoreCase);
                            var trackedName = WarehouseName(trackedCode);
                            <li class="lst-track-item @(isNew ? "lst-track-new" : "")" data-code="@trackedCode">
                                <span class="lst-track-name">@trackedName</span>
                                @* A warehouse the cache has no name for would otherwise print its code twice. *@
                                @if (!string.Equals(trackedName, trackedCode, StringComparison.OrdinalIgnoreCase))
                                {
                                    <span class="lst-track-code">@trackedCode</span>
                                }
                                <button type="button" class="lst-track-remove"
                                        aria-label="@($"Stop tracking {trackedCode}")" title="@($"Stop tracking {trackedCode}")"
                                        disabled="@(isSavingTracked || stagedTracked.Count == 1)"
                                        @onclick="() => RemoveTracked(trackedCode)">
                                    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                         stroke-width="2" stroke-linecap="round" aria-hidden="true">
                                        <path d="M6 6l12 12M18 6L6 18"></path>
                                    </svg>
                                </button>
                            </li>
                        }
                    </ul>

                    <div class="lst-track-add">
                        <div class="lst-field">
                            <span class="lst-label">Add a warehouse</span>
                            <NocturneSelect Class="nsel-block" Options="UntrackedSelectOptions"
                                            @bind-Value="warehouseToAdd" Caption="Warehouse"
                                            AriaLabel="Warehouse to track" Placeholder="Choose a warehouse"
                                            EmptyText="Every active warehouse is tracked" />
                        </div>
                        <button type="button" class="lst-btn lst-btn-quiet"
                                disabled="@(isSavingTracked || string.IsNullOrEmpty(warehouseToAdd))"
                                @onclick="AddTracked">
                            Add
                        </button>
                    </div>

                    @if (TrackedRemovals.Count > 0)
                    {
                        <div class="lst-msg lst-msg-bad lst-track-msg" role="status">
                            <span>
                                Removing @string.Join(", ", TrackedRemovals). From the next snapshot on, a till
                                selling from @(TrackedRemovals.Count == 1 ? "it" : "any of them") reads zero
                                stock and refuses every sale, and transfers stop adjusting today's figures.
                            </span>
                        </div>
                    }

                    @if (trackedError is not null)
                    {
                        <div class="lst-msg lst-msg-bad lst-track-msg" role="alert"><span>@trackedError</span></div>
                    }

                    <div class="lst-track-actions">
                        <button type="button" class="lst-btn lst-btn-primary"
                                disabled="@(isSavingTracked || !TrackedChanged)" @onclick="SaveTracked">
                            @if (isSavingTracked)
                            {
                                <span class="lst-spin" aria-hidden="true"></span>
                                <span>Saving&#8230;</span>
                            }
                            else
                            {
                                <span>Save</span>
                            }
                        </button>
                        <button type="button" class="lst-btn lst-btn-quiet" disabled="@isSavingTracked"
                                @onclick="ToggleTrackedEditor">
                            Cancel
                        </button>
                        <span class="lst-track-note">
                            TransferEventListener keeps its own list. The Transfer listener page names any
                            tracked warehouse it does not watch.
                        </span>
                    </div>
                </section>
            }

            @* A warehouse just added has no snapshot until the next 07:00 fetch; this gives it one now
               without re-reading every other warehouse. *@
            @if (justAddedTracked.Count > 0 && !isEditingTracked)
            {
                <div class="lst-msg lst-track-msg" role="status">
                    <span>
                        @string.Join(", ", justAddedTracked) @(justAddedTracked.Count == 1 ? "has" : "have")
                        no snapshot until the next 07:00 fetch.
                    </span>
                    <button type="button" class="lst-btn lst-btn-quiet lst-track-fetch"
                            disabled="@isFetching" @onclick="FetchJustAdded">
                        Fetch @(justAddedTracked.Count == 1 ? "its" : "their") stock now
                    </button>
                </div>
            }

            @if (stockResult != null && !string.IsNullOrWhiteSpace(stockResult.LastError))
            {
                var failed = string.Equals(stockResult.SnapshotStatus, "Failed", StringComparison.OrdinalIgnoreCase);
                <div class="lst-msg @(failed ? "lst-msg-bad" : "")" role="status">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"
                         stroke-linecap="round" aria-hidden="true">
                        <circle cx="12" cy="12" r="9"></circle>
                        <path d="M12 7.5v5.5M12 16.2v.1"></path>
                    </svg>
                    <span>
                        @if (failed)
                        {
                            <text>The fetch from SAP failed: @(stockResult.LastError!.TrimEnd('.')). Refresh quantities from SAP fetches it again.</text>
                        }
                        else
                        {
                            @stockResult.LastError
                        }
                    </span>
                </div>
            }

            @if (warehouseListError != null)
            {
                <div class="lst-msg" role="alert">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"
                         stroke-linecap="round" aria-hidden="true">
                        <circle cx="12" cy="12" r="9"></circle>
                        <path d="M12 7.5v5.5M12 16.2v.1"></path>
                    </svg>
                    <span>@warehouseListError</span>
                </div>
            }

            @if (errorMessage != null)
            {
                <div class="lst-msg" role="alert">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"
                         stroke-linecap="round" aria-hidden="true">
                        <circle cx="12" cy="12" r="9"></circle>
                        <path d="M12 7.5v5.5M12 16.2v.1"></path>
                    </svg>
                    <span>@errorMessage</span>
                </div>
            }

            @if (isLoading)
            {
                <div class="lst-loading">
                    <span class="lst-spin" aria-hidden="true"></span>
                    <span>Loading local stock&#8230;</span>
                </div>
            }
            else if (string.IsNullOrEmpty(selectedWarehouse))
            {
                <div class="lst-empty">
                    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"
                         stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <path d="M3 10.5L12 4l9 6.5V20H3z"></path>
                        <path d="M8.5 20v-6h7v6"></path>
                    </svg>
                    <h3>Pick a warehouse</h3>
                    <p>Choose one above to see the stock it is holding today.</p>
                </div>
            }
            else
            {
                var items = filteredItems.ToList();

                if (items.Count > 0)
                {
                    <div class="lst-scroll">
                        <div class="lst-grid" role="table" aria-label="Stock items">
                            <div class="lst-thead" role="row">
                                <span></span>
                                <span role="columnheader">Item code</span>
                                <span role="columnheader">Description</span>
                                <span role="columnheader" class="lst-n">In stock</span>
                                <span role="columnheader" class="lst-n">Original</span>
                                <span role="columnheader" class="lst-n">Adjustment</span>
                                <span role="columnheader" class="lst-n">Sold today</span>
                                <span role="columnheader" class="lst-n" title="@NotInSapHint">Not in SAP</span>
                                <span role="columnheader" class="lst-batches">Batches</span>
                            </div>

                            @foreach (var item in items)
                            {
                                var opens = item.Batches.Count > 1;
                                var isOpen = expandedItems.Contains(item.ItemCode);
                                var adj = item.TransferAdjustment;

                                <div class="lst-row @(opens ? "lst-row-open" : "") @(isOpen ? "lst-row-on" : "")"
                                     role="row" @onclick="() => { if (opens) ToggleExpand(item.ItemCode); }">
                                    <span class="lst-caretcell" role="cell">
                                        @if (opens)
                                        {
                                            <svg class="lst-twist" width="12" height="12" viewBox="0 0 24 24" fill="none"
                                                 stroke="currentColor" stroke-width="2" stroke-linecap="round"
                                                 stroke-linejoin="round" aria-hidden="true">
                                                <path d="M9.5 5.5L16 12l-6.5 6.5"></path>
                                            </svg>
                                        }
                                    </span>
                                    <span class="lst-code" role="cell">@item.ItemCode</span>
                                    <span class="lst-desc" role="cell">@(item.ItemDescription ?? "—")</span>
                                    <span class="lst-n @GetQtyClass(item.AvailableQuantity)" role="cell">
                                        <span class="lst-rl">In stock</span>@QuantityDisplay.Format(item.AvailableQuantity)
                                    </span>
                                    <span class="lst-n lst-was" role="cell">
                                        <span class="lst-rl">Original</span>@QuantityDisplay.Format(item.OriginalQuantity)
                                    </span>
                                    <span class="lst-n @GetAdjClass(adj)" role="cell">
                                        <span class="lst-rl">Adjustment</span>@(adj > 0 ? "+" : "")@QuantityDisplay.Format(Math.Abs(adj))
                                    </span>
                                    <span class="lst-n @(item.SoldToday == 0 ? "lst-adj-nil" : "lst-sold")" role="cell">
                                        <span class="lst-rl">Sold today</span>@QuantityDisplay.Format(item.SoldToday)
                                    </span>
                                    @* Blank on a past snapshot: the figure is the position now, and
                                       showing it under an old date would read as that day's. *@
                                    <span class="lst-n @(item.SoldNotInSap > 0 ? "lst-held" : "lst-adj-nil")" role="cell"
                                          title="@NotInSapHint">
                                        <span class="lst-rl">Not in SAP</span>@(item.SoldNotInSap is { } held ? QuantityDisplay.Format(held) : "—")
                                    </span>
                                    <span class="lst-batches" role="cell">
                                        <span class="lst-rl">Batches</span>@item.Batches.Count
                                    </span>
                                </div>

                                @if (isOpen && opens)
                                {
                                    @foreach (var batch in item.Batches.OrderBy(b => b.ExpiryDate))
                                    {
                                        <div class="lst-row lst-row-batch" role="row">
                                            <span class="lst-caretcell" role="cell"></span>
                                            <span class="lst-batch-id" role="cell">
                                                Batch <span class="lst-batch-no">@(batch.BatchNumber ?? "N/A")</span>
                                                @if (batch.ExpiryDate.HasValue)
                                                {
                                                    <span class="lst-batch-exp">
                                                        · expires @batch.ExpiryDate.Value.ToString("dd MMM yyyy")
                                                    </span>
                                                }
                                            </span>
                                            <span class="lst-n @GetQtyClass(batch.AvailableQuantity)" role="cell">
                                                <span class="lst-rl">In stock</span>@QuantityDisplay.Format(batch.AvailableQuantity)
                                            </span>
                                            <span class="lst-n lst-was" role="cell">
                                                <span class="lst-rl">Original</span>@QuantityDisplay.Format(batch.OriginalQuantity)
                                            </span>
                                        </div>
                                    }
                                }
                            }
                        </div>
                    </div>
                }
                else if (stockResult != null)
                {
                    <div class="lst-empty">
                        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                             stroke-width="1.5" stroke-linecap="round" aria-hidden="true">
                            <circle cx="11" cy="11" r="7"></circle>
                            <path d="M20 20l-3.5-3.5"></path>
                        </svg>
                        <h3>Nothing to show</h3>
                        @if (string.IsNullOrWhiteSpace(searchTerm))
                        {
                            <p>This warehouse has no stock recorded for the chosen date.</p>
                        }
                        else
                        {
                            <p>No item in this snapshot matches &#8220;@searchTerm&#8221;.</p>
                        }
                    </div>
                }
            }
        </section>
    </div>
</div>

@code {
    private List<WarehouseDto> warehouses = new();

    private IEnumerable<NocturneSelectOption<string>> WarehouseSelectOptions =>
        warehouses
            .Where(wh => !string.IsNullOrWhiteSpace(wh.WarehouseCode))
            .Select(wh => new NocturneSelectOption<string>(
                wh.WarehouseCode!, wh.WarehouseName ?? wh.WarehouseCode!) { Hint = wh.WarehouseCode });
    private LocalStockResultDto? stockResult;
    private HashSet<string> expandedItems = new();
    private StockFetchProgressModel? fetchProgress;

    private bool isLoading = false;
    private bool isFetching = false;
    private bool isRefreshing = false;
    private bool isExporting = false;
    private string? errorMessage;

    // Kept apart from errorMessage, which every stock load clears: the warehouse list is read once, and
    // the operator should still be able to see why the picker lists every warehouse after picking one.
    private string? warehouseListError;

    private string selectedWarehouse = "";

    // Tracked-warehouse editor. savedTracked is what the API holds; stagedTracked is the edit in progress.
    private List<WarehouseDto> allWarehouses = new();
    private List<string> savedTracked = new();
    private List<string> stagedTracked = new();
    private List<string> justAddedTracked = new();
    private string warehouseToAdd = "";
    private string? trackedError;
    private bool canManageTracked;
    private bool isEditingTracked;
    private bool isSavingTracked;

    private List<string> TrackedRemovals =>
        savedTracked.Except(stagedTracked, StringComparer.OrdinalIgnoreCase).ToList();

    private bool TrackedChanged =>
        TrackedRemovals.Count > 0
        || stagedTracked.Except(savedTracked, StringComparer.OrdinalIgnoreCase).Any();

    private IEnumerable<NocturneSelectOption<string>> UntrackedSelectOptions =>
        allWarehouses
            .Where(wh => wh.IsActive && !string.IsNullOrWhiteSpace(wh.WarehouseCode)
                         && !stagedTracked.Contains(wh.WarehouseCode!, StringComparer.OrdinalIgnoreCase))
            .OrderBy(wh => wh.WarehouseCode, StringComparer.OrdinalIgnoreCase)
            .Select(wh => new NocturneSelectOption<string>(
                wh.WarehouseCode!, wh.WarehouseName ?? wh.WarehouseCode!) { Hint = wh.WarehouseCode });

    private string WarehouseName(string code) =>
        allWarehouses.FirstOrDefault(wh => string.Equals(wh.WarehouseCode, code, StringComparison.OrdinalIgnoreCase))
            ?.WarehouseName ?? code;
    private DateTime? snapshotDate;
    private string searchTerm = "";

    private IEnumerable<LocalStockItemDto> filteredItems
    {
        get
        {
            if (stockResult == null) return Enumerable.Empty<LocalStockItemDto>();
            var items = stockResult.Items.AsEnumerable();
            if (!string.IsNullOrWhiteSpace(searchTerm))
            {
                var term = searchTerm.ToLowerInvariant();
                items = items.Where(i =>
                    (i.ItemCode?.ToLowerInvariant().Contains(term) ?? false) ||
                    (i.ItemDescription?.ToLowerInvariant().Contains(term) ?? false));
            }
            return items;
        }
    }

    protected override async Task OnInitializedAsync()
    {
        snapshotDate = DateTime.UtcNow.Date;

        var user = (await AuthStateProvider.GetAuthenticationStateAsync()).User;
        // Admin only, as the API's PUT is: the list decides which warehouses every till can sell from.
        canManageTracked = user.IsInRole(UserRoles.Admin);

        allWarehouses = await MasterDataCache.GetWarehousesAsync() ?? new();
        await LoadMonitoredWarehousesAsync();

        await AuditService.LogAsync(AuditActions.ViewStock, "LocalStock", null);

        // Subscribe to real-time stock updates
        HubService.OnStockSnapshotUpdated += OnStockUpdated;
        HubService.OnStockFetchProgress += OnFetchProgress;
        HubService.OnDesktopSaleCreated += OnSaleAffectsStock;
    }

    private async Task LoadMonitoredWarehousesAsync()
    {
        // Load only warehouses configured for daily stock monitoring
        var (monitoredCodes, monitoredError) = await DesktopService.GetMonitoredWarehousesAsync();

        warehouseListError = monitoredError is null
            ? null
            : $"Could not read which warehouses are monitored, so every active warehouse is listed. {monitoredError}";

        if (monitoredCodes is { Count: > 0 })
        {
            savedTracked = monitoredCodes;
            var monitoredSet = new HashSet<string>(monitoredCodes, StringComparer.OrdinalIgnoreCase);
            warehouses = allWarehouses
                .Where(w => w.IsActive && w.WarehouseCode is not null && monitoredSet.Contains(w.WarehouseCode))
                .ToList();
        }
        else
        {
            // Fallback to all active warehouses if API call fails. Nothing is known to be tracked, so
            // the editor has nothing to start from and its button is hidden.
            savedTracked = new();
            isEditingTracked = false;
            warehouses = allWarehouses.Where(w => w.IsActive).ToList();
        }
    }

    private void ToggleTrackedEditor()
    {
        isEditingTracked = !isEditingTracked;
        stagedTracked = savedTracked.ToList();
        warehouseToAdd = "";
        trackedError = null;
    }

    private void AddTracked()
    {
        if (string.IsNullOrWhiteSpace(warehouseToAdd)) return;
        if (!stagedTracked.Contains(warehouseToAdd, StringComparer.OrdinalIgnoreCase))
        {
            stagedTracked.Add(warehouseToAdd);
        }
        warehouseToAdd = "";
    }

    private void RemoveTracked(string code)
    {
        // The API refuses an empty list; the last row's button is disabled for the same reason.
        if (stagedTracked.Count > 1)
        {
            stagedTracked.RemoveAll(c => string.Equals(c, code, StringComparison.OrdinalIgnoreCase));
        }
    }

    private async Task SaveTracked()
    {
        isSavingTracked = true;
        trackedError = null;
        try
        {
            var added = stagedTracked.Except(savedTracked, StringComparer.OrdinalIgnoreCase).ToList();
            var removed = TrackedRemovals;

            var (saved, error) = await DesktopService.SaveMonitoredWarehousesAsync(stagedTracked);
            if (saved is null)
            {
                trackedError = error ?? "The warehouses could not be saved.";
                return;
            }

            await LoadMonitoredWarehousesAsync();
            justAddedTracked = added;
            isEditingTracked = false;

            if (removed.Any(code => string.Equals(code, selectedWarehouse, StringComparison.OrdinalIgnoreCase)))
            {
                selectedWarehouse = "";
                stockResult = null;
            }

            Snackbar.Add($"Tracking {saved.Count} warehouses", Severity.Success);
        }
        finally
        {
            isSavingTracked = false;
        }
    }

    private async Task FetchJustAdded()
    {
        var codes = justAddedTracked.ToList();
        if (codes.Count == 0) return;

        if (await DesktopService.TriggerStockFetchAsync(codes))
        {
            justAddedTracked = new();
            Snackbar.Add($"Fetching stock for {string.Join(", ", codes)} from SAP", Severity.Info);
        }
        else
        {
            Snackbar.Add($"Could not start the stock fetch for {string.Join(", ", codes)}", Severity.Error);
        }
    }

    private async void OnStockUpdated()
    {
        await InvokeAsync(async () =>
        {
            // StockSnapshotUpdated fires at the end of the entire fetch — always reset
            isFetching = false;
            fetchProgress = null;

            if (!string.IsNullOrEmpty(selectedWarehouse))
            {
                Snackbar.Add("Stock fetch complete — refreshing", Severity.Success);
                await LoadStock();
            }
            StateHasChanged();
        });
    }

    private async void OnFetchProgress(StockFetchProgressModel progress)
    {
        await InvokeAsync(() =>
        {
            fetchProgress = progress;
            if (progress.Status == "Complete")
            {
                isFetching = false;
                // Clear progress after a short delay to let user see 100%
                _ = Task.Delay(3000).ContinueWith(_ =>
                    InvokeAsync(() => { fetchProgress = null; StateHasChanged(); }));
            }
            StateHasChanged();
        });
    }

    private string GetNextWarehouse(StockFetchProgressModel progress)
    {
        return warehouses
            .Select(w => w.WarehouseCode)
            .FirstOrDefault(wc => wc is not null && !progress.CompletedWarehouses.Contains(wc)) ?? "";
    }

    private async void SelectCompletedWarehouse(string warehouseCode)
    {
        selectedWarehouse = warehouseCode;
        await LoadStock();
        StateHasChanged();
    }

    private async void OnSaleAffectsStock()
    {
        await InvokeAsync(async () =>
        {
            if (!string.IsNullOrEmpty(selectedWarehouse))
            {
                // Stock quantities change when a desktop sale deducts from snapshot
                await LoadStock();
                StateHasChanged();
            }
        });
    }

    private async Task LoadStock()
    {
        if (string.IsNullOrEmpty(selectedWarehouse)) return;

        isLoading = true;
        errorMessage = null;
        expandedItems.Clear();
        StateHasChanged();

        try
        {
            var (snapshot, error) = await DesktopService.GetLocalStockAsync(selectedWarehouse, snapshotDate);
            stockResult = snapshot;

            // Two different answers: the API said there is no snapshot for that day, or it could not be
            // asked. They used to read the same.
            if (error is not null)
            {
                errorMessage = $"Could not load the stock snapshot. {error}";
            }
            else if (stockResult == null)
            {
                errorMessage = "No snapshot found for this warehouse and date. Stock may not have been fetched yet.";
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Error: {ex.Message}";
            stockResult = null;
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task RefreshFromSap()
    {
        if (string.IsNullOrEmpty(selectedWarehouse)) return;

        isRefreshing = true;
        errorMessage = null;
        StateHasChanged();

        try
        {
            var (result, error) = await DesktopService.RefreshWarehouseStockAsync(selectedWarehouse);
            if (result == null)
            {
                Snackbar.Add(error ?? "The refresh failed.", Severity.Error);

                // A failed re-fetch records its reason on the snapshot; reload so the page shows it.
                await LoadStock();
                return;
            }

            if (result.ViaTransferListener)
            {
                Snackbar.Add(
                    (result.TransfersApplied == 0
                        ? $"No new transfers for {result.WarehouseCode} "
                        : $"{result.TransfersApplied:N0} new transfer line(s) applied to {result.WarehouseCode} ")
                    + $"({result.TransfersToday:N0} today)"
                    + (result.TransfersPending > 0
                        ? $". {result.TransfersPending:N0} transfer line(s) are still waiting at the transfer listener."
                        : ""),
                    result.TransfersPending > 0 ? Severity.Warning : Severity.Success);

                snapshotDate = result.LedgerDay;
                await LoadStock();
                return;
            }

            var changed = result.ItemsCorrected + result.ItemsAdded;
            Snackbar.Add(
                result.SnapshotRefetched
                    ? $"{result.WarehouseCode} had no usable snapshot for today, so it was fetched from SAP again "
                      + $"({result.RowsFetched:N0} rows)"
                    : changed == 0
                    ? $"{result.WarehouseCode} already matches SAP ({result.ItemsChecked:N0} items checked)"
                    : $"{result.WarehouseCode} refreshed from SAP: {result.ItemsCorrected:N0} updated, "
                      + $"{result.ItemsAdded:N0} added",
                Severity.Success);

            // The refresh acts on today's ledger, whatever date the page was showing.
            snapshotDate = result.LedgerDay;
            await LoadStock();
        }
        finally
        {
            isRefreshing = false;
            StateHasChanged();
        }
    }

    private async Task TriggerStockFetch()
    {
        isFetching = true;
        // Show immediate progress panel so user sees feedback even without SignalR
        fetchProgress = new StockFetchProgressModel
        {
            TotalCount = warehouses.Count,
            CompletedCount = 0,
            Status = "Initializing",
            CurrentWarehouse = "",
            CompletedWarehouses = new()
        };
        StateHasChanged();
        try
        {
            var success = await DesktopService.TriggerStockFetchAsync();
            if (!success)
            {
                Snackbar.Add("Failed to trigger stock fetch", Severity.Error);
                isFetching = false;
                fetchProgress = null;
                return;
            }

            Snackbar.Add("Stock fetch started — progress will update in real-time", Severity.Info);

            // If SignalR isn't connected, poll the API to detect completion
            if (!HubService.IsConnected)
            {
                _ = PollForFetchCompletionAsync();
            }

            // Safety timeout — if no SignalR events arrive within 5 minutes, reset
            _ = Task.Delay(TimeSpan.FromMinutes(5)).ContinueWith(_ =>
                InvokeAsync(() =>
                {
                    if (isFetching)
                    {
                        isFetching = false;
                        fetchProgress = null;
                        Snackbar.Add("Stock fetch timed out — check server logs", Severity.Warning);
                        StateHasChanged();
                    }
                }));
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error: {ex.Message}", Severity.Error);
            isFetching = false;
            fetchProgress = null;
        }
    }

    private async Task PollForFetchCompletionAsync()
    {
        // Poll each warehouse to detect completion when SignalR is unavailable
        var completed = new List<string>();
        while (isFetching && completed.Count < warehouses.Count)
        {
            await Task.Delay(10_000); // check every 10 seconds
            if (!isFetching) break;

            foreach (var wh in warehouses)
            {
                var whCode = wh.WarehouseCode ?? "";
                if (completed.Contains(whCode)) continue;
                try
                {
                    // A progress poll: a failed tick is simply not progress, and the next one asks again.
                    var (result, _) = await DesktopService.GetLocalStockAsync(whCode, DateTime.UtcNow.Date);
                    if (result != null && result.SnapshotStatus == "Complete")
                    {
                        completed.Add(whCode);
                    }
                }
                catch { /* ignore polling errors */ }
            }

            await InvokeAsync(() =>
            {
                if (!isFetching) return;
                fetchProgress = new StockFetchProgressModel
                {
                    TotalCount = warehouses.Count,
                    CompletedCount = completed.Count,
                    Status = completed.Count >= warehouses.Count ? "Complete" : "InProgress",
                    CurrentWarehouse = "",
                    CompletedWarehouses = new List<string>(completed)
                };
                StateHasChanged();
            });
        }

        // Fetch done
        await InvokeAsync(async () =>
        {
            isFetching = false;
            if (completed.Count > 0)
            {
                Snackbar.Add($"Stock fetch complete — {completed.Count} warehouses updated", Severity.Success);
                // Auto-select first warehouse if none selected
                if (string.IsNullOrEmpty(selectedWarehouse) && completed.Count > 0)
                {
                    selectedWarehouse = completed.First();
                }
                await LoadStock();
            }
            _ = Task.Delay(3000).ContinueWith(_ =>
                InvokeAsync(() => { fetchProgress = null; StateHasChanged(); }));
            StateHasChanged();
        });
    }

    private void ToggleExpand(string itemCode)
    {
        if (!expandedItems.Remove(itemCode))
            expandedItems.Add(itemCode);
    }

    // The four steps a quantity can be in; the sheet colours each from a family.
    /// <summary>
    /// What the Not in SAP column means, for the header and every cell. A depot reads it before keying
    /// a transfer in the SAP client, which cannot see these sales — see
    /// docs/operations/stock-out-of-till-warehouses.md.
    /// </summary>
    private const string NotInSapHint =
        "Sold at the tills and not yet invoiced in SAP. SAP still counts these units, so leave them in the "
        + "warehouse: never move more than SAP shows less this figure.";

    private static string GetQtyClass(decimal qty) => qty switch
    {
        > 100 => "lst-q-good",
        > 10 => "lst-q-info",
        > 0 => "lst-q-warn",
        _ => "lst-q-bad"
    };

    private static string GetAdjClass(decimal adj) => adj switch
    {
        > 0 => "lst-adj-up",
        < 0 => "lst-adj-down",
        _ => "lst-adj-nil"
    };

    private static string GetSnapshotFamily(string status) => status.ToLower() switch
    {
        "complete" => "lst-fam-good",
        "pending" => "lst-fam-warn",
        "failed" => "lst-fam-bad",
        _ => "lst-fam-warn"
    };

    private async Task ExportToExcel()
    {
        if (stockResult == null || !filteredItems.Any()) return;
        isExporting = true;
        StateHasChanged();
        try
        {
            var bytes = ExportService.ExportLocalStockToExcel(stockResult);
            var base64 = Convert.ToBase64String(bytes);
            await JS.InvokeVoidAsync("downloadFile", $"Local_Stock_{stockResult.WarehouseCode}_{DateTime.Now:yyyyMMdd_HHmm}.xlsx", base64);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Export failed: {ex.Message}", Severity.Error);
        }
        finally
        {
            isExporting = false;
            StateHasChanged();
        }
    }

    public void Dispose()
    {
        HubService.OnStockSnapshotUpdated -= OnStockUpdated;
        HubService.OnStockFetchProgress -= OnFetchProgress;
        HubService.OnDesktopSaleCreated -= OnSaleAffectsStock;
    }
}
