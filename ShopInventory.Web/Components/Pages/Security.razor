@page "/security"
@using ShopInventory.Web.Models
@using ShopInventory.Web.Services
@using Microsoft.AspNetCore.Authorization
@inject ITwoFactorWebService TwoFactorService
@inject IAuditService AuditService
@inject IJSRuntime JS
@inject NavigationManager NavigationManager
@inject ILogger<Security> Logger
@attribute [Authorize]
@rendermode InteractiveServer

<PageTitle>Security Settings - Shop Inventory</PageTitle>

@* The Nocturne sheet is wwwroot/css/security.css (linked from App.razor). Its
   chrome is audit-trail.css's; the two-column stack of settings cards is this
   page's own, because nothing here is a row of anything.

   It lives in a file rather than in the <style> block this page used to carry,
   and here that mattered more than on most pages: eleven password and code
   fields, all of which app.css's global `.dark-theme input` rule would repaint
   #1e293b. It also replaces about forty inline `style=` attributes holding
   hard-coded hexes, none of which followed the theme — which is why the side
   column used to be light-mode text on a dark ground.

   The modals carry `.sec` themselves. They sit outside the page element, and
   that class is what puts the page's tokens in reach. *@

<div class="sec">

    <header class="sec-head">
        <div class="sec-head-inner">
            <nav class="sec-crumbs" aria-label="Breadcrumb">
                <span>Account</span>
                <span class="sec-crumb-sep" aria-hidden="true">/</span>
                <span class="sec-crumb-now" aria-current="page">Security</span>
            </nav>
        </div>
    </header>

    <div class="sec-body">

        <section class="sec-hero">
            <div>
                <div class="sec-kicker">Account protection</div>
                <h1>Security</h1>
                <p>
                    How this account is signed into, and what has been done with it lately. A second factor
                    is the single change that matters most here — everything else on the page assumes
                    someone already has the password.
                </p>
            </div>
        </section>

        @if (!string.IsNullOrEmpty(successMessage))
        {
            <div class="sec-notice sec-fam-good" role="status">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                     stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M20 6L9 17l-5-5"></path>
                </svg>
                <span class="sec-notice-text">@successMessage</span>
            </div>
        }
        @if (!string.IsNullOrEmpty(errorMessage))
        {
            <div class="sec-notice sec-fam-bad" role="alert">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                     stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <circle cx="12" cy="12" r="9"></circle>
                    <path d="M12 7v6"></path>
                    <path d="M12 16.5v.01"></path>
                </svg>
                <span class="sec-notice-text">@errorMessage</span>
            </div>
        }

        @if (isLoading)
        {
            <div class="sec-loading">
                <span class="sec-spin" aria-hidden="true"></span>
                <span>Loading security settings&#8230;</span>
            </div>
        }
        else
        {
            var twoFactorOn = twoFactorStatus?.IsEnabled == true;
            var codesLeft = twoFactorStatus?.BackupCodesRemaining ?? 0;
            var score = CalculateSecurityScore();
            var scoreFam = ScoreFamily(score);

            <section class="sec-stats">
                <div class="sec-stat @(twoFactorOn ? "sec-stat-good" : "sec-stat-alert")">
                    <div class="sec-stat-head"><span class="sec-stat-rule"></span>Two-factor</div>
                    <div class="sec-stat-num">@(twoFactorOn ? "On" : "Off")</div>
                    <div class="sec-stat-sub">@(twoFactorOn ? "a code is required at login" : "password alone gets in")</div>
                </div>
                <div class="sec-stat @(twoFactorOn && codesLeft == 0 ? "sec-stat-alert" : "")">
                    <div class="sec-stat-head"><span class="sec-stat-rule"></span>Backup codes</div>
                    <div class="sec-stat-num">@codesLeft</div>
                    <div class="sec-stat-sub">left to use if the app is lost</div>
                </div>
                <div class="sec-stat @(passkeys.Any() ? "sec-stat-good" : "")">
                    <div class="sec-stat-head"><span class="sec-stat-rule"></span>Passkeys</div>
                    <div class="sec-stat-num">@passkeys.Count</div>
                    <div class="sec-stat-sub">devices that can sign in without a password</div>
                </div>
                <div class="sec-stat">
                    <div class="sec-stat-head"><span class="sec-stat-rule"></span>Today</div>
                    <div class="sec-stat-num">@(activitySummary?.ActionsToday ?? 0)</div>
                    <div class="sec-stat-sub">actions on this account</div>
                </div>
                <div class="sec-stat">
                    <div class="sec-stat-head"><span class="sec-stat-rule"></span>This week</div>
                    <div class="sec-stat-num">@(activitySummary?.ActionsThisWeek ?? 0)</div>
                    <div class="sec-stat-sub">actions on this account</div>
                </div>
            </section>

            @if (isSettingUp && setupData != null)
            {
                <section class="sec-card sec-card-setup">
                    <div class="sec-card-head">
                        <h2>Set up two-factor authentication</h2>
                        <div class="sec-card-head-aside">
                            <span class="sec-badge sec-fam-accent">In progress</span>
                        </div>
                    </div>
                    <div class="sec-card-body">
                        <div class="sec-steps">
                            <div class="sec-step">
                                <div class="sec-step-head">
                                    <span class="sec-step-num">1</span>
                                    <span>Scan the code</span>
                                </div>
                                <p>Open your authenticator app — Google Authenticator, Authy, 1Password — and scan this.</p>
                                <div class="sec-qr">
                                    <img src="https://api.qrserver.com/v1/create-qr-code/?size=200x200&data=@Uri.EscapeDataString(setupData.QrCodeUri)"
                                         alt="Two-factor setup QR code" />
                                </div>
                                <div class="sec-field">
                                    <label class="sec-label" for="secManualKey">Or enter this key by hand</label>
                                    <div class="sec-input-group">
                                        <input id="secManualKey" type="text" class="sec-input sec-input-code"
                                               value="@setupData.ManualEntryKey" readonly />
                                        <button type="button" class="sec-icon-btn" title="Copy" aria-label="Copy key"
                                                @onclick="() => CopyToClipboard(setupData.ManualEntryKey)">
                                            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                                 stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                                <rect x="9" y="9" width="11" height="11" rx="2"></rect>
                                                <path d="M5 15V5a2 2 0 0 1 2-2h8"></path>
                                            </svg>
                                        </button>
                                    </div>
                                </div>
                            </div>

                            <div class="sec-step">
                                <div class="sec-step-head">
                                    <span class="sec-step-num">2</span>
                                    <span>Enter the code it shows</span>
                                </div>
                                <div class="sec-field">
                                    <label class="sec-label" for="secVerify">Verification code</label>
                                    <input id="secVerify" type="text" class="sec-input sec-input-code" maxlength="6"
                                           inputmode="numeric" autocomplete="one-time-code" placeholder="000000"
                                           @bind="verificationCode" @bind:event="oninput" />
                                </div>
                                <div class="sec-actions">
                                    <button type="button" class="sec-btn sec-btn-primary"
                                            disabled="@(string.IsNullOrEmpty(verificationCode) || verificationCode.Length != 6 || isVerifying)"
                                            @onclick="VerifyAndEnable2FA">
                                        @if (isVerifying)
                                        {
                                            <span class="sec-spin" aria-hidden="true"></span>
                                            <span>Verifying&#8230;</span>
                                        }
                                        else
                                        {
                                            <span>Verify and enable</span>
                                        }
                                    </button>
                                    <button type="button" class="sec-btn sec-btn-quiet" @onclick="CancelSetup">Cancel</button>
                                </div>

                                <div class="sec-step-head">
                                    <span class="sec-step-num">3</span>
                                    <span>Save the backup codes</span>
                                </div>
                                <div class="sec-notice sec-fam-warn">
                                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                         stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                        <path d="M12 4l9 16H3z"></path>
                                        <path d="M12 10v4"></path>
                                        <path d="M12 17.5v.01"></path>
                                    </svg>
                                    <span class="sec-notice-text">
                                        A one-time set of codes appears once verification succeeds, and is never shown
                                        again. They are the only way back in if the authenticator is lost.
                                    </span>
                                </div>
                            </div>
                        </div>
                    </div>
                </section>
            }

            <div class="sec-cols">

                <div class="sec-col">

                    <section class="sec-card">
                        <div class="sec-card-head">
                            <h2>Two-factor authentication</h2>
                            <div class="sec-card-head-aside">
                                <span class="sec-badge @(twoFactorOn ? "sec-fam-good" : "sec-fam-warn")">
                                    @(twoFactorOn ? "Enabled" : "Disabled")
                                </span>
                            </div>
                        </div>
                        <div class="sec-card-body">
                            @if (twoFactorOn)
                            {
                                <p>
                                    A code from your authenticator app is required at every login.
                                    @if (twoFactorStatus!.EnabledAt.HasValue)
                                    {
                                        <text> Turned on @twoFactorStatus.EnabledAt.Value.ToString("d MMMM yyyy").</text>
                                    }
                                </p>
                                <div class="sec-notice @(codesLeft > 0 ? "sec-fam-info" : "sec-fam-warn")">
                                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                         stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                        <circle cx="12" cy="12" r="9"></circle>
                                        <path d="M12 11v5"></path>
                                        <path d="M12 7.5v.01"></path>
                                    </svg>
                                    <span class="sec-notice-text">
                                        @if (codesLeft > 0)
                                        {
                                            <text>@codesLeft backup @(codesLeft == 1 ? "code" : "codes") remaining.</text>
                                        }
                                        else
                                        {
                                            <text>No backup codes left. Losing the authenticator would lock this account out.</text>
                                        }
                                    </span>
                                </div>
                                <div class="sec-actions">
                                    <button type="button" class="sec-btn sec-btn-quiet" @onclick="ShowRegenerateBackupCodes">
                                        Regenerate backup codes
                                    </button>
                                    <button type="button" class="sec-btn sec-btn-danger" @onclick="ShowDisable2FA">
                                        Disable
                                    </button>
                                </div>
                            }
                            else
                            {
                                <p>
                                    Requires a code from your authenticator app on top of the password, so a stolen
                                    password on its own is not enough to sign in.
                                </p>
                                <div class="sec-notice sec-fam-warn">
                                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                         stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                        <path d="M12 4l9 16H3z"></path>
                                        <path d="M12 10v4"></path>
                                        <path d="M12 17.5v.01"></path>
                                    </svg>
                                    <span class="sec-notice-text">
                                        This is the single change on the page that matters most.
                                    </span>
                                </div>
                                <div class="sec-actions">
                                    <button type="button" class="sec-btn sec-btn-primary" @onclick="StartSetup2FA">
                                        Enable two-factor authentication
                                    </button>
                                </div>
                            }
                        </div>
                    </section>

                    <section class="sec-card">
                        <div class="sec-card-head">
                            <h2>Passkeys</h2>
                            <div class="sec-card-head-aside">
                                <span class="sec-badge @(passkeys.Any() ? "sec-fam-good" : "sec-fam-neutral")">
                                    @(passkeys.Any() ? $"{passkeys.Count} registered" : "None yet")
                                </span>
                            </div>
                        </div>
                        <div class="sec-card-body">
                            <p>
                                Sign in with Windows Hello, Face ID, Touch ID or a device PIN instead of typing a
                                password. Passkeys need HTTPS or localhost and a browser that supports them.
                            </p>

                            @if (!string.IsNullOrEmpty(passkeySuccessMessage))
                            {
                                <div class="sec-notice sec-fam-good" role="status">
                                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                         stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                        <path d="M20 6L9 17l-5-5"></path>
                                    </svg>
                                    <span class="sec-notice-text">@passkeySuccessMessage</span>
                                </div>
                            }
                            @if (!string.IsNullOrEmpty(passkeyErrorMessage))
                            {
                                <div class="sec-notice sec-fam-bad" role="alert">
                                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                         stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                        <circle cx="12" cy="12" r="9"></circle>
                                        <path d="M12 7v6"></path>
                                        <path d="M12 16.5v.01"></path>
                                    </svg>
                                    <span class="sec-notice-text">@passkeyErrorMessage</span>
                                </div>
                            }

                            <div class="sec-form">
                                <div class="sec-field">
                                    <label class="sec-label" for="secPasskeyName">Passkey name</label>
                                    <input id="secPasskeyName" type="text" class="sec-input" placeholder="Office laptop"
                                           @bind="newPasskeyName" @bind:event="oninput" />
                                    <span class="sec-hint">Names the device, so an old one can be told apart later.</span>
                                </div>
                                <div class="sec-actions">
                                    <button type="button" class="sec-btn sec-btn-primary"
                                            disabled="@isRegisteringPasskey" @onclick="RegisterPasskey">
                                        @if (isRegisteringPasskey)
                                        {
                                            <span class="sec-spin" aria-hidden="true"></span>
                                            <span>Waiting for the device&#8230;</span>
                                        }
                                        else
                                        {
                                            <span>Add passkey</span>
                                        }
                                    </button>
                                </div>
                            </div>

                            @if (passkeys.Any())
                            {
                                <div class="sec-list">
                                    @foreach (var passkey in passkeys)
                                    {
                                        <div class="sec-list-row">
                                            <div class="sec-list-text">
                                                <div class="sec-list-name">@passkey.FriendlyName</div>
                                                <div class="sec-list-meta">
                                                    Added @passkey.CreatedAt.ToString("d MMM yyyy")@(passkey.LastUsedAt.HasValue
                                                        ? $" · last used {passkey.LastUsedAt.Value:d MMM yyyy HH:mm}"
                                                        : " · never used")
                                                </div>
                                            </div>
                                            <svg class="sec-list-mark" width="17" height="17" viewBox="0 0 24 24" fill="none"
                                                 stroke="currentColor" stroke-width="1.5" stroke-linecap="round" aria-hidden="true">
                                                <path d="M12 4a8 8 0 0 0-8 8v3"></path>
                                                <path d="M20 12a8 8 0 0 0-4-6.9"></path>
                                                <path d="M8 12a4 4 0 0 1 8 0v6"></path>
                                                <path d="M12 12v8"></path>
                                            </svg>
                                        </div>
                                    }
                                </div>
                            }
                        </div>
                    </section>

                    <section class="sec-card">
                        <div class="sec-card-head">
                            <h2>Login credentials</h2>
                        </div>
                        <div class="sec-card-body">
                            <p>Change the username or email this account signs in with. The current password confirms it is you.</p>
                            @if (isLoadingCredentials)
                            {
                                <div class="sec-loading sec-loading-inline">
                                    <span class="sec-spin" aria-hidden="true"></span>
                                    <span>Loading credentials&#8230;</span>
                                </div>
                            }
                            else
                            {
                                <div class="sec-form">
                                    <div class="sec-field">
                                        <label class="sec-label" for="secUsername">Username</label>
                                        <input id="secUsername" type="text" class="sec-input" autocomplete="username"
                                               @bind="credUsername" @bind:event="oninput" />
                                    </div>
                                    <div class="sec-field">
                                        <label class="sec-label" for="secEmail">Email</label>
                                        <input id="secEmail" type="email" class="sec-input" autocomplete="email"
                                               @bind="credEmail" @bind:event="oninput" />
                                    </div>
                                    <div class="sec-field">
                                        <label class="sec-label" for="secCredPwd">
                                            Current password <span class="sec-req" aria-hidden="true">*</span>
                                        </label>
                                        <input id="secCredPwd" type="password" class="sec-input" autocomplete="current-password"
                                               placeholder="Confirm with your current password"
                                               @bind="credPassword" @bind:event="oninput" />
                                    </div>
                                    @if (!string.IsNullOrEmpty(credSuccessMessage))
                                    {
                                        <div class="sec-notice sec-fam-good" role="status">
                                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                                 stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                                <path d="M20 6L9 17l-5-5"></path>
                                            </svg>
                                            <span class="sec-notice-text">@credSuccessMessage</span>
                                        </div>
                                    }
                                    @if (!string.IsNullOrEmpty(credErrorMessage))
                                    {
                                        <div class="sec-notice sec-fam-bad" role="alert">
                                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                                 stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                                <circle cx="12" cy="12" r="9"></circle>
                                                <path d="M12 7v6"></path>
                                                <path d="M12 16.5v.01"></path>
                                            </svg>
                                            <span class="sec-notice-text">@credErrorMessage</span>
                                        </div>
                                    }
                                    <div class="sec-actions">
                                        <button type="button" class="sec-btn sec-btn-primary"
                                                disabled="@(!IsCredentialsValid || isUpdatingCredentials)" @onclick="UpdateCredentials">
                                            @if (isUpdatingCredentials)
                                            {
                                                <span class="sec-spin" aria-hidden="true"></span>
                                                <span>Updating&#8230;</span>
                                            }
                                            else
                                            {
                                                <span>Update credentials</span>
                                            }
                                        </button>
                                    </div>
                                </div>
                            }
                        </div>
                    </section>

                    <section class="sec-card">
                        <div class="sec-card-head">
                            <h2>Change password</h2>
                        </div>
                        <div class="sec-card-body">
                            <div class="sec-form">
                                <div class="sec-field">
                                    <label class="sec-label" for="secCurrentPwd">Current password</label>
                                    <input id="secCurrentPwd" type="password" class="sec-input" autocomplete="current-password"
                                           @bind="currentPassword" />
                                </div>
                                <div class="sec-field">
                                    <label class="sec-label" for="secNewPwd">New password</label>
                                    <input id="secNewPwd" type="password" class="sec-input" autocomplete="new-password"
                                           @bind="newPassword" @bind:event="oninput" />
                                    <div class="sec-rules" aria-label="Password requirements">
                                        <span class="sec-rule @(newPassword.Length >= 8 ? "sec-rule-pass" : "")">
                                            <span class="sec-rule-mark" aria-hidden="true"></span>8 characters
                                        </span>
                                        <span class="sec-rule @(System.Text.RegularExpressions.Regex.IsMatch(newPassword, "[A-Z]") ? "sec-rule-pass" : "")">
                                            <span class="sec-rule-mark" aria-hidden="true"></span>Uppercase
                                        </span>
                                        <span class="sec-rule @(System.Text.RegularExpressions.Regex.IsMatch(newPassword, "[a-z]") ? "sec-rule-pass" : "")">
                                            <span class="sec-rule-mark" aria-hidden="true"></span>Lowercase
                                        </span>
                                        <span class="sec-rule @(System.Text.RegularExpressions.Regex.IsMatch(newPassword, "[0-9]") ? "sec-rule-pass" : "")">
                                            <span class="sec-rule-mark" aria-hidden="true"></span>Number
                                        </span>
                                        <span class="sec-rule @(System.Text.RegularExpressions.Regex.IsMatch(newPassword, @"[^a-zA-Z0-9]") ? "sec-rule-pass" : "")">
                                            <span class="sec-rule-mark" aria-hidden="true"></span>Symbol
                                        </span>
                                        <span class="sec-rule @(newPassword == confirmPassword && confirmPassword.Length > 0 ? "sec-rule-pass" : "")">
                                            <span class="sec-rule-mark" aria-hidden="true"></span>Matches
                                        </span>
                                    </div>
                                </div>
                                <div class="sec-field">
                                    <label class="sec-label" for="secConfirmPwd">Confirm new password</label>
                                    <input id="secConfirmPwd" type="password" class="sec-input" autocomplete="new-password"
                                           @bind="confirmPassword" @bind:event="oninput" />
                                </div>
                                <div class="sec-actions">
                                    <button type="button" class="sec-btn sec-btn-primary"
                                            disabled="@(!IsPasswordValid || isChangingPassword)" @onclick="ChangePassword">
                                        @if (isChangingPassword)
                                        {
                                            <span class="sec-spin" aria-hidden="true"></span>
                                            <span>Updating&#8230;</span>
                                        }
                                        else
                                        {
                                            <span>Update password</span>
                                        }
                                    </button>
                                </div>
                            </div>
                        </div>
                    </section>

                    <section class="sec-card">
                        <div class="sec-card-head">
                            <h2>Recent activity</h2>
                            <div class="sec-card-head-aside">
                                <a class="sec-btn sec-btn-ghost" href="/user-activity">View all</a>
                            </div>
                        </div>
                        <div class="sec-card-body">
                            @if (recentActivity.Any())
                            {
                                <div class="sec-activity">
                                    @foreach (var activity in recentActivity)
                                    {
                                        <div class="sec-activity-row">
                                            <span class="sec-dot @(activity.IsSuccess ? "" : "sec-dot-fail")" aria-hidden="true"></span>
                                            <div class="sec-activity-text">
                                                <div class="sec-activity-action">@FormatAction(activity.Action)</div>
                                                <div class="sec-activity-meta">
                                                    @if (!string.IsNullOrEmpty(activity.EntityType))
                                                    {
                                                        <span>@activity.EntityType</span>
                                                    }
                                                    @if (!string.IsNullOrEmpty(activity.Details))
                                                    {
                                                        <span> &middot; @TruncateText(activity.Details, 60)</span>
                                                    }
                                                </div>
                                            </div>
                                            <span class="sec-activity-time">@activity.TimeAgo</span>
                                        </div>
                                    }
                                </div>
                            }
                            else
                            {
                                <div class="sec-empty">
                                    <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                         stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                        <circle cx="12" cy="12" r="9"></circle>
                                        <path d="M12 7v5l3 2"></path>
                                    </svg>
                                    <span>Nothing recorded against this account yet.</span>
                                </div>
                            }
                        </div>
                    </section>
                </div>

                <div class="sec-col">

                    <section class="sec-card">
                        <div class="sec-card-head">
                            <h2>Security score</h2>
                        </div>
                        <div class="sec-card-body">
                            <div class="sec-score">
                                <div class="sec-score-ring @scoreFam">
                                    <svg viewBox="0 0 36 36" role="img" aria-label="Security score @score out of 100">
                                        <path class="sec-score-track"
                                              d="M18 2.0845a15.9155 15.9155 0 0 1 0 31.831a15.9155 15.9155 0 0 1 0-31.831"
                                              fill="none" stroke-width="3" />
                                        <path class="sec-score-arc"
                                              d="M18 2.0845a15.9155 15.9155 0 0 1 0 31.831a15.9155 15.9155 0 0 1 0-31.831"
                                              fill="none" stroke-width="3" stroke-dasharray="@score, 100"
                                              stroke-linecap="round" />
                                    </svg>
                                    <div class="sec-score-face">
