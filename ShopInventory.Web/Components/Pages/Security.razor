                        Every code issued before now stops working. Anything written down becomes worthless.
                    </span>
                </div>
                <div class="sec-field">
                    <label class="sec-label" for="secRegenCode">Authenticator code</label>
                    <input id="secRegenCode" type="text" class="sec-input sec-input-code" maxlength="6"
                           inputmode="numeric" autocomplete="one-time-code" placeholder="000000" @bind="regenerateCode" />
                </div>
            </div>
            <div class="sec-modal-foot">
