@page "/security"
@using ShopInventory.Web.Models
@using ShopInventory.Web.Services
@using Microsoft.AspNetCore.Authorization
@inject ITwoFactorWebService TwoFactorService
@inject IAuditService AuditService
@inject IJSRuntime JS
@inject NavigationManager NavigationManager
@inject ILogger<Security> Logger
@attribute [Authorize]
@rendermode InteractiveServer

<PageTitle>Security Settings - Shop Inventory</PageTitle>

@* The Nocturne sheet is wwwroot/css/security.css (linked from App.razor), built
   from the "Security Page Redesign" design canvas. Its header says what the
   page is made of and why.

   The modals carry `.sec` themselves. They sit outside the page element, and
   that class is what puts the page's tokens in reach. *@

<div class="sec">

    <header class="sec-head">
        <div class="sec-head-inner">
            <nav class="sec-crumbs" aria-label="Breadcrumb">
                <span>Account</span>
                <span class="sec-crumb-sep" aria-hidden="true">/</span>
                @if (IsEnrolling)
                {
                    <span>Security</span>
                    <span class="sec-crumb-sep" aria-hidden="true">/</span>
                    <span class="sec-crumb-now" aria-current="page">Two-factor</span>
                }
                else
                {
                    <span class="sec-crumb-now" aria-current="page">Security</span>
                }
            </nav>
            <div class="sec-head-actions">
                <a class="sec-more" href="/user-activity">Audit trail</a>
            </div>
        </div>
    </header>

    <div class="sec-body">

        @if (!string.IsNullOrEmpty(successMessage))
        {
            <div class="sec-notice sec-fam-good" role="status">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                     stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M20 6L9 17l-5-5"></path>
                </svg>
                <span class="sec-notice-text">@successMessage</span>
            </div>
        }
        @if (!string.IsNullOrEmpty(errorMessage))
        {
            <div class="sec-notice sec-fam-bad" role="alert">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                     stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <circle cx="12" cy="12" r="9"></circle>
                    <path d="M12 7v6"></path>
                    <path d="M12 16.5v.01"></path>
                </svg>
                <span class="sec-notice-text">@errorMessage</span>
            </div>
        }

        @if (isLoading)
        {
            <div class="sec-loading">
                <span class="sec-spin" aria-hidden="true"></span>
                <span>Loading security settings&#8230;</span>
            </div>
        }
        else if (IsEnrolling)
        {
            <section class="sec-enrol" aria-labelledby="secEnrolTitle">
                <div class="sec-enrol-head">
                    <div>
                        <div class="sec-kicker">Two-factor authentication</div>
                        <h1 id="secEnrolTitle">Link an authenticator app</h1>
                        <p>About a minute. Once it's on, signing in asks for the password and a 6-digit code from your phone.</p>
                    </div>
                    <button type="button" class="sec-btn sec-btn-quiet sec-btn-tall" @onclick="CancelSetup">Cancel</button>
                </div>

                <ol class="sec-steps">
                    <li class="sec-step">
                        <div class="sec-step-head"><span class="sec-step-num">1</span>Scan the code</div>
                        <p>Google Authenticator, Microsoft Authenticator, Authy or 1Password.</p>
                        <div class="sec-qr">
                            <img src="https://api.qrserver.com/v1/create-qr-code/?size=200x200&data=@Uri.EscapeDataString(setupData!.QrCodeUri)"
                                 alt="Two-factor setup QR code" />
                        </div>
                        <div class="sec-field">
                            <label class="sec-label" for="secManualKey">Can't scan? Type this key</label>
                            <div class="sec-input-group">
                                <input id="secManualKey" type="text" class="sec-input sec-input-code"
                                       value="@setupData.ManualEntryKey" readonly />
                                <button type="button" class="sec-icon-btn" title="Copy" aria-label="Copy key"
                                        @onclick="() => CopyToClipboard(setupData.ManualEntryKey)">
                                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                         stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                        <rect x="9" y="9" width="11" height="11" rx="2"></rect>
                                        <path d="M5 15V5a2 2 0 0 1 2-2h8"></path>
                                    </svg>
                                </button>
                            </div>
                        </div>
                    </li>

                    <li class="sec-step sec-step-now">
                        <div class="sec-step-head"><span class="sec-step-num">2</span>Enter the code it shows</div>
                        <p>The app shows a new 6-digit code every 30 seconds. Any current one works.</p>
                        <div class="sec-field">
                            <label class="sec-label" for="secVerify">Verification code</label>
                            <input id="secVerify" type="text" class="sec-input sec-input-otp" maxlength="6"
                                   inputmode="numeric" autocomplete="one-time-code" placeholder="······"
                                   @bind="verificationCode" @bind:event="oninput" />
                        </div>
                        <div class="sec-step-fill"></div>
                        <button type="button" class="sec-btn sec-btn-primary sec-btn-tall"
                                disabled="@(string.IsNullOrEmpty(verificationCode) || verificationCode.Length != 6 || isVerifying)"
                                @onclick="VerifyAndEnable2FA">
                            @if (isVerifying)
                            {
                                <span class="sec-spin" aria-hidden="true"></span>
                                <span>Verifying&#8230;</span>
                            }
                            else
                            {
                                <span>Verify and turn on</span>
                            }
                        </button>
                    </li>

                    <li class="sec-step sec-step-later">
                        <div class="sec-step-head"><span class="sec-step-num">3</span>Save your backup codes</div>
                        <p>
                            Ten single-use codes appear once step 2 succeeds — shown once, never again. They're the
                            only way back in if the phone is lost.
                        </p>
                        <div class="sec-ghosts" aria-hidden="true">
                            @for (var i = 0; i < 10; i++)
                            {
                                <span></span>
                            }
                        </div>
                        <div class="sec-notice sec-fam-warn">
                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                 stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                <path d="M12 4l9 16H3z"></path>
                                <path d="M12 10v4"></path>
                                <path d="M12 17.5v.01"></path>
                            </svg>
                            <span class="sec-notice-text">Keep them somewhere other than the phone.</span>
                        </div>
                    </li>
                </ol>
            </section>
        }
        else
        {
            var twoFactorOn = twoFactorStatus?.IsEnabled == true;
            var codesLeft = twoFactorStatus?.BackupCodesRemaining ?? 0;
            var score = CalculateSecurityScore();
            var scoreFam = ScoreFamily(score);
            var next = NextStep(score);

            <section class="sec-hero">
                <div class="sec-hero-text">
                    <div class="sec-kicker">Account protection</div>
                    <h1>Security</h1>
                    <p>
                        How this account signs in, and what it has done lately. Everything here assumes someone may
                        already have the password — the second factor is what stops them.
                    </p>
                    @if (!string.IsNullOrWhiteSpace(originalCredUsername))
                    {
                        <div class="sec-who">
                            <span class="sec-avatar" aria-hidden="true">@Initials(originalCredUsername)</span>
                            <span>Signed in as <strong>@originalCredUsername</strong></span>
                        </div>
                    }
                </div>

                <div class="sec-posture">
                    <div class="sec-posture-top">
                        <div class="sec-score @scoreFam" role="img" aria-label="Security score @score out of 100">
                            <span class="sec-score-num">@score</span>
                            <span class="sec-score-of">/ 100</span>
                        </div>
                        <span class="sec-badge @scoreFam">
                            @(score >= 80 ? "Well protected" : score >= 50 ? "Adequate" : "Needs attention")
                        </span>
                    </div>
                    <ul class="sec-layers" aria-label="Protection in place">
                        <li class="sec-layer sec-layer-on">&#10003; Password</li>
                        <li class="sec-layer @(twoFactorOn ? "sec-layer-on" : "")">@(twoFactorOn ? "✓" : "○") Two-factor</li>
                        <li class="sec-layer @(codesLeft > 0 ? "sec-layer-on" : "")">@(codesLeft > 0 ? "✓" : "○") Backup codes</li>
                        <li class="sec-layer @(passkeys.Any() ? "sec-layer-on" : "")">@(passkeys.Any() ? "✓" : "○") Passkey</li>
                    </ul>
                    @if (next is { } step)
                    {
                        <div class="sec-next @step.Family">
                            <div class="sec-next-text">
                                <span class="sec-next-kicker">Next step</span>
                                <span class="sec-next-title">@step.Title</span>
                                <span class="sec-next-sub">@step.Sub</span>
                            </div>
                            <button type="button" class="sec-btn sec-btn-primary" @onclick="step.Act">@step.Action</button>
                        </div>
                    }
                    else
                    {
                        <p class="sec-posture-note">
                            Both factors are in place and there are codes to fall back on. Nothing to do here.
                        </p>
                    }
                </div>
            </section>

            <div class="sec-grid">
                <div class="sec-main">

                    <section class="sec-section" aria-labelledby="secMethodsTitle">
                        <div class="sec-section-head">
                            <div>
                                <h2 id="secMethodsTitle">Sign-in methods</h2>
                                <p>What it takes to get into this account.</p>
                            </div>
                        </div>
                        <div class="sec-panel">

                            <div class="sec-method">
                                <div class="sec-method-row">
                                    <span class="sec-tile sec-fam-neutral" aria-hidden="true">
                                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                             stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
                                            <circle cx="8" cy="15" r="4"></circle>
                                            <path d="M10.8 12.2L20 3M17 6l3 3M14.5 8.5l2 2"></path>
                                        </svg>
                                    </span>
                                    <div class="sec-method-text">
                                        <div class="sec-method-name">Password <span class="sec-badge sec-fam-good">Set</span></div>
                                        <div class="sec-method-desc">Required at every sign-in. Changing it signs this session out.</div>
                                    </div>
                                    <div class="sec-method-actions">
                                        <button type="button" class="sec-btn sec-btn-quiet" aria-expanded="@(openRow == "password" ? "true" : "false")"
                                                @onclick='() => ToggleRow("password")'>
                                            @(openRow == "password" ? "Cancel" : "Change")
                                        </button>
                                    </div>
                                </div>
                                @if (openRow == "password")
                                {
                                    <div class="sec-method-sub sec-drawer">
                                        <div class="sec-fields-3">
                                            <div class="sec-field">
                                                <label class="sec-label" for="secCurrentPwd">Current password</label>
                                                <input id="secCurrentPwd" type="password" class="sec-input" autocomplete="current-password"
                                                       @bind="currentPassword" @bind:event="oninput" />
                                            </div>
                                            <div class="sec-field">
                                                <label class="sec-label" for="secNewPwd">New password</label>
                                                <input id="secNewPwd" type="password" class="sec-input" autocomplete="new-password"
                                                       @bind="newPassword" @bind:event="oninput" />
                                            </div>
                                            <div class="sec-field">
                                                <label class="sec-label" for="secConfirmPwd">Confirm new password</label>
                                                <input id="secConfirmPwd" type="password" class="sec-input" autocomplete="new-password"
                                                       @bind="confirmPassword" @bind:event="oninput" />
                                            </div>
                                        </div>
                                        <div class="sec-drawer-foot">
                                            <div class="sec-rules" aria-label="Password requirements">
                                                <span class="sec-rule @(newPassword.Length >= 8 ? "sec-rule-pass" : "")">
                                                    <span class="sec-rule-mark" aria-hidden="true"></span>8 characters
                                                </span>
                                                <span class="sec-rule @(System.Text.RegularExpressions.Regex.IsMatch(newPassword, "[A-Z]") ? "sec-rule-pass" : "")">
                                                    <span class="sec-rule-mark" aria-hidden="true"></span>Uppercase
                                                </span>
                                                <span class="sec-rule @(System.Text.RegularExpressions.Regex.IsMatch(newPassword, "[a-z]") ? "sec-rule-pass" : "")">
                                                    <span class="sec-rule-mark" aria-hidden="true"></span>Lowercase
                                                </span>
                                                <span class="sec-rule @(System.Text.RegularExpressions.Regex.IsMatch(newPassword, "[0-9]") ? "sec-rule-pass" : "")">
                                                    <span class="sec-rule-mark" aria-hidden="true"></span>Number
                                                </span>
                                                <span class="sec-rule @(System.Text.RegularExpressions.Regex.IsMatch(newPassword, @"[^a-zA-Z0-9]") ? "sec-rule-pass" : "")">
                                                    <span class="sec-rule-mark" aria-hidden="true"></span>Symbol
                                                </span>
                                                <span class="sec-rule @(newPassword == confirmPassword && confirmPassword.Length > 0 ? "sec-rule-pass" : "")">
                                                    <span class="sec-rule-mark" aria-hidden="true"></span>Matches
                                                </span>
                                            </div>
                                            <button type="button" class="sec-btn sec-btn-primary"
                                                    disabled="@(!IsPasswordValid || isChangingPassword)" @onclick="ChangePassword">
                                                @if (isChangingPassword)
                                                {
                                                    <span class="sec-spin" aria-hidden="true"></span>
                                                    <span>Updating&#8230;</span>
                                                }
                                                else
                                                {
                                                    <span>Update password</span>
                                                }
                                            </button>
                                        </div>
                                    </div>
                                }
                            </div>

                            <div class="sec-method">
                                <div class="sec-method-row">
                                    <span class="sec-tile @(twoFactorOn ? "sec-fam-good" : "sec-fam-warn")" aria-hidden="true">
                                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                             stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
                                            <path d="M12 3l8 3v6c0 4.5-3.4 8-8 9-4.6-1-8-4.5-8-9V6z"></path>
                                            <path d="M9 12l2 2 4-4"></path>
                                        </svg>
                                    </span>
                                    <div class="sec-method-text">
                                        <div class="sec-method-name">
                                            Two-factor authentication
                                            <span class="sec-badge @(twoFactorOn ? "sec-fam-good" : "sec-fam-warn")">@(twoFactorOn ? "On" : "Off")</span>
                                        </div>
                                        <div class="sec-method-desc">
                                            @if (twoFactorOn)
                                            {
                                                <text>A code from your authenticator app is asked for at every sign-in.</text>
                                                @if (twoFactorStatus!.EnabledAt.HasValue)
                                                {
                                                    <text> On since @twoFactorStatus.EnabledAt.Value.ToString("d MMM yyyy").</text>
                                                }
                                            }
                                            else
                                            {
                                                <text>A 6-digit code from an authenticator app, on top of the password. A stolen password alone stops being enough.</text>
                                            }
                                        </div>
                                    </div>
                                    <div class="sec-method-actions">
                                        @if (twoFactorOn)
                                        {
                                            <button type="button" class="sec-btn sec-btn-danger" @onclick="ShowDisable2FA">Turn off</button>
                                        }
                                        else
                                        {
                                            <button type="button" class="sec-btn sec-btn-primary" @onclick="StartSetup2FA">Set up</button>
                                        }
                                    </div>
                                </div>
                                <div class="sec-method-sub sec-codes-strip @(twoFactorOn ? "" : "sec-codes-off") @(twoFactorOn && codesLeft < 5 ? "sec-codes-low" : "")">
                                    <div class="sec-codes-text">
                                        <div class="sec-codes-label">
                                            Backup codes
                                            <span>
                                                @if (!twoFactorOn)
                                                {
                                                    <text>Issued once two-factor is on</text>
                                                }
                                                else if (codesLeft == 0)
                                                {
                                                    <text>None left — losing the authenticator would lock this account out</text>
                                                }
                                                else
                                                {
                                                    <text>@codesLeft of 10 left</text>
                                                }
                                            </span>
                                        </div>
                                        <div class="sec-pips" aria-hidden="true">
                                            @for (var i = 0; i < 10; i++)
                                            {
                                                <span class="sec-pip @(i < codesLeft ? "sec-pip-on" : "")"></span>
                                            }
                                        </div>
                                    </div>
                                    <button type="button" class="sec-btn sec-btn-quiet" disabled="@(!twoFactorOn)"
                                            @onclick="ShowRegenerateBackupCodes">Regenerate</button>
                                </div>
                            </div>

                            <div class="sec-method">
                                <div class="sec-method-row">
                                    <span class="sec-tile @(passkeys.Any() ? "sec-fam-good" : "sec-fam-neutral")" aria-hidden="true">
                                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                             stroke-width="1.6" stroke-linecap="round">
                                            <path d="M12 4a8 8 0 0 0-8 8v3"></path>
                                            <path d="M20 12a8 8 0 0 0-4-6.9"></path>
                                            <path d="M8 12a4 4 0 0 1 8 0v6"></path>
                                            <path d="M12 12v8"></path>
                                        </svg>
                                    </span>
                                    <div class="sec-method-text">
                                        <div class="sec-method-name">
                                            Passkeys
                                            <span class="sec-badge @(passkeys.Any() ? "sec-fam-good" : "sec-fam-neutral")">
                                                @(passkeys.Any() ? $"{passkeys.Count} registered" : "None yet")
                                            </span>
                                        </div>
                                        <div class="sec-method-desc">
                                            Windows Hello, Face ID, Touch ID or a device PIN instead of a password. Needs HTTPS and a browser that supports them.
                                        </div>
                                    </div>
                                    <div class="sec-method-actions">
                                        <button type="button" class="sec-btn sec-btn-quiet" aria-expanded="@(openRow == "passkey" ? "true" : "false")"
                                                @onclick='() => ToggleRow("passkey")'>
                                            @(openRow == "passkey" ? "Cancel" : "Add passkey")
                                        </button>
                                    </div>
                                </div>

                                @if (!string.IsNullOrEmpty(passkeySuccessMessage))
                                {
                                    <div class="sec-method-sub sec-notice sec-fam-good" role="status">
                                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                             stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                            <path d="M20 6L9 17l-5-5"></path>
                                        </svg>
                                        <span class="sec-notice-text">@passkeySuccessMessage</span>
                                    </div>
                                }
                                @if (!string.IsNullOrEmpty(passkeyErrorMessage))
                                {
                                    <div class="sec-method-sub sec-notice sec-fam-bad" role="alert">
                                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                             stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                            <circle cx="12" cy="12" r="9"></circle>
                                            <path d="M12 7v6"></path>
                                            <path d="M12 16.5v.01"></path>
                                        </svg>
                                        <span class="sec-notice-text">@passkeyErrorMessage</span>
                                    </div>
                                }

                                @if (passkeys.Any())
                                {
                                    <ul class="sec-method-sub sec-keys">
                                        @foreach (var passkey in passkeys)
                                        {
                                            <li class="sec-key">
                                                <span class="sec-key-text">
                                                    <span class="sec-key-name">@passkey.FriendlyName</span>
                                                    <span class="sec-key-meta">
                                                        Added @passkey.CreatedAt.ToString("d MMM yyyy")@(passkey.LastUsedAt.HasValue
                                                            ? $" · last used {passkey.LastUsedAt.Value:d MMM yyyy HH:mm}"
                                                            : " · never used")
                                                    </span>
                                                </span>
                                                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                                     stroke-width="1.5" stroke-linecap="round" aria-hidden="true">
                                                    <path d="M12 4a8 8 0 0 0-8 8v3"></path>
                                                    <path d="M20 12a8 8 0 0 0-4-6.9"></path>
                                                    <path d="M8 12a4 4 0 0 1 8 0v6"></path>
                                                    <path d="M12 12v8"></path>
                                                </svg>
                                            </li>
                                        }
                                    </ul>
                                }

                                @if (openRow == "passkey")
                                {
                                    <div class="sec-method-sub sec-inline-form">
                                        <div class="sec-field">
                                            <label class="sec-label" for="secPasskeyName">Name this device</label>
                                            <input id="secPasskeyName" type="text" class="sec-input" placeholder="Office laptop"
                                                   @bind="newPasskeyName" @bind:event="oninput" />
                                        </div>
                                        <button type="button" class="sec-btn sec-btn-primary sec-btn-tall"
                                                disabled="@isRegisteringPasskey" @onclick="RegisterPasskey">
                                            @if (isRegisteringPasskey)
                                            {
                                                <span class="sec-spin" aria-hidden="true"></span>
                                                <span>Waiting for the device&#8230;</span>
                                            }
                                            else
                                            {
                                                <span>Continue on device</span>
                                            }
                                        </button>
                                    </div>
                                }
                            </div>
                        </div>
                    </section>

                    <section class="sec-section" aria-labelledby="secLoginTitle">
                        <div class="sec-section-head">
                            <div>
                                <h2 id="secLoginTitle">Login details</h2>
                                <p>The name and email this account signs in with. Your current password confirms a change.</p>
                            </div>
                        </div>
                        <div class="sec-panel sec-login">
                            @if (isLoadingCredentials)
                            {
                                <div class="sec-loading sec-loading-inline">
                                    <span class="sec-spin" aria-hidden="true"></span>
                                    <span>Loading credentials&#8230;</span>
                                </div>
                            }
                            else
                            {
                                <div class="sec-fields-2">
                                    <div class="sec-field">
                                        <label class="sec-label" for="secUsername">Username</label>
                                        <input id="secUsername" type="text" class="sec-input" autocomplete="username"
                                               @bind="credUsername" @bind:event="oninput" />
                                    </div>
                                    <div class="sec-field">
                                        <label class="sec-label" for="secEmail">Email</label>
                                        <input id="secEmail" type="email" class="sec-input" autocomplete="email"
                                               @bind="credEmail" @bind:event="oninput" />
                                    </div>
                                </div>
                                @if (!string.IsNullOrEmpty(credSuccessMessage))
                                {
                                    <div class="sec-notice sec-fam-good" role="status">
                                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                             stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                            <path d="M20 6L9 17l-5-5"></path>
                                        </svg>
                                        <span class="sec-notice-text">@credSuccessMessage</span>
                                    </div>
                                }
                                @if (!string.IsNullOrEmpty(credErrorMessage))
                                {
                                    <div class="sec-notice sec-fam-bad" role="alert">
                                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                             stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                            <circle cx="12" cy="12" r="9"></circle>
                                            <path d="M12 7v6"></path>
                                            <path d="M12 16.5v.01"></path>
                                        </svg>
                                        <span class="sec-notice-text">@credErrorMessage</span>
                                    </div>
                                }
                                <div class="sec-login-foot">
                                    <div class="sec-field">
                                        <label class="sec-label" for="secCredPwd">Current password</label>
                                        <input id="secCredPwd" type="password" class="sec-input" autocomplete="current-password"
                                               placeholder="Required to save" @bind="credPassword" @bind:event="oninput" />
                                    </div>
                                    <span class="sec-login-state">@(HasCredentialChanges ? "Unsaved changes." : "No changes yet.")</span>
                                    <button type="button" class="sec-btn sec-btn-primary sec-btn-tall"
                                            disabled="@(!IsCredentialsValid || isUpdatingCredentials)" @onclick="UpdateCredentials">
                                        @if (isUpdatingCredentials)
                                        {
                                            <span class="sec-spin" aria-hidden="true"></span>
                                            <span>Saving&#8230;</span>
                                        }
                                        else
                                        {
                                            <span>Save changes</span>
                                        }
                                    </button>
                                </div>
                            }
                        </div>
                    </section>

                    <section class="sec-section" id="activity" aria-labelledby="secActivityTitle">
                        <div class="sec-section-head">
                            <div>
                                <h2 id="secActivityTitle">Recent activity</h2>
                                <p>
                                    <strong>@(activitySummary?.ActionsToday ?? 0)</strong> actions today ·
                                    <strong>@(activitySummary?.ActionsThisWeek ?? 0)</strong> this week
                                </p>
                            </div>
                            <a class="sec-more" href="/user-activity">View all &#8594;</a>
                        </div>
                        <div class="sec-panel">
                            @if (recentActivity.Any())
                            {
                                <ol class="sec-activity">
                                    @foreach (var activity in recentActivity)
                                    {
                                        <li class="sec-activity-row @(activity.IsSuccess ? "" : "sec-activity-fail")">
                                            <span class="sec-dot @(activity.IsSuccess ? "" : "sec-dot-fail")" aria-hidden="true"></span>
                                            <span class="sec-activity-text">
                                                <span class="sec-activity-action">@FormatAction(activity.Action)</span>
                                                @if (!activity.IsSuccess)
                                                {
                                                    <span class="sec-visually-hidden">Failed.</span>
                                                }
                                                <span class="sec-activity-meta">
                                                    @ActivityMeta(activity)
                                                </span>
                                            </span>
                                            <span class="sec-activity-time">@activity.TimeAgo</span>
                                        </li>
                                    }
                                </ol>
                            }
                            else
                            {
                                <div class="sec-empty">
                                    <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                         stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                        <circle cx="12" cy="12" r="9"></circle>
                                        <path d="M12 7v5l3 2"></path>
                                    </svg>
                                    <span>Nothing recorded against this account yet.</span>
                                </div>
                            }
                        </div>
                    </section>
                </div>

                <aside class="sec-rail">
                    <section class="sec-panel sec-checklist" aria-labelledby="secChecklistTitle">
                        <div class="sec-checklist-head">
                            <h2 id="secChecklistTitle">Checklist</h2>
                            <span>@((twoFactorOn ? 1 : 0) + (codesLeft > 0 ? 1 : 0) + (passkeys.Any() ? 1 : 0)) of 3 in place</span>
                        </div>
                        <ul class="sec-checks">
                            <li class="sec-check @(twoFactorOn ? "sec-check-on" : "")">
                                <span class="sec-check-mark" aria-hidden="true">
                                    <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                         stroke-width="3.5" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6L9 17l-5-5"></path></svg>
                                </span>
                                <span class="sec-check-text">
                                    <span class="sec-check-title">Two-factor on</span>
                                    <span class="sec-check-sub">A stolen password stops being enough</span>
                                </span>
                            </li>
                            <li class="sec-check @(codesLeft > 0 ? "sec-check-on" : "")">
                                <span class="sec-check-mark" aria-hidden="true">
                                    <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                         stroke-width="3.5" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6L9 17l-5-5"></path></svg>
                                </span>
                                <span class="sec-check-text">
                                    <span class="sec-check-title">Backup codes saved</span>
                                    <span class="sec-check-sub">The way back in if the phone is gone</span>
                                </span>
                            </li>
                            <li class="sec-check @(passkeys.Any() ? "sec-check-on" : "")">
                                <span class="sec-check-mark" aria-hidden="true">
                                    <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                         stroke-width="3.5" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6L9 17l-5-5"></path></svg>
                                </span>
                                <span class="sec-check-text">
                                    <span class="sec-check-title">At least one passkey</span>
                                    <span class="sec-check-sub">Nothing to phish if there is no password to type</span>
                                </span>
                            </li>
                        </ul>
                        <div class="sec-habits">
                            <span class="sec-habits-kicker">Habits</span>
                            <p><strong>Keep this login to yourself.</strong> A shared login makes the activity log meaningless.</p>
                            <p><strong>Glance at activity now and then.</strong> A login you don't recognise is the first sign.</p>
                        </div>
                    </section>

                    <nav class="sec-panel sec-links" aria-label="Related pages">
                        <a class="sec-link" href="/user-activity">
                            <span>Login history and audit trail</span>
                            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"
                                 stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 6l6 6-6 6"></path></svg>
                        </a>
                        <a class="sec-link" href="/settings">
                            <span>Account settings</span>
                            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"
                                 stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 6l6 6-6 6"></path></svg>
                        </a>
                        <a class="sec-link" href="/notifications">
                            <span>Notifications</span>
                            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"
                                 stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 6l6 6-6 6"></path></svg>
                        </a>
                    </nav>
                </aside>
            </div>
        }
    </div>
</div>

@* ── Disable 2FA ───────────────────────────────────────────────────────── *@
@if (showDisableModal)
{
    <div class="sec sec-scrim" @onclick="() => showDisableModal = false">
        <div class="sec-modal sec-modal-danger" role="dialog" aria-modal="true"
             aria-label="Turn off two-factor authentication" @onclick:stopPropagation="true">
            <div class="sec-modal-head">
                <h2>Turn off two-factor?</h2>
                <button type="button" class="sec-icon-btn sec-modal-x" aria-label="Close"
                        @onclick="() => showDisableModal = false">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                         stroke-width="1.8" stroke-linecap="round" aria-hidden="true">
                        <path d="M5 5l14 14M19 5L5 19"></path>
                    </svg>
                </button>
            </div>
            <div class="sec-modal-body">
                <div class="sec-notice sec-fam-bad">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                         stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <path d="M12 4l9 16H3z"></path>
                        <path d="M12 10v4"></path>
                        <path d="M12 17.5v.01"></path>
                    </svg>
                    <span class="sec-notice-text">
                        The password alone will get into this account again. Existing backup codes stop working.
                    </span>
                </div>
                <div class="sec-field">
                    <label class="sec-label" for="secDisablePwd">Current password</label>
                    <input id="secDisablePwd" type="password" class="sec-input" autocomplete="current-password"
                           @bind="disablePassword" @bind:event="oninput" />
                </div>
                <div class="sec-field">
                    <label class="sec-label" for="secDisableCode">Authenticator code</label>
                    <input id="secDisableCode" type="text" class="sec-input sec-input-code" maxlength="6"
                           inputmode="numeric" autocomplete="one-time-code" placeholder="000000"
                           @bind="disableCode" @bind:event="oninput" />
                </div>
            </div>
            <div class="sec-modal-foot">
                <button type="button" class="sec-btn sec-btn-quiet" @onclick="() => showDisableModal = false">Cancel</button>
                <button type="button" class="sec-btn sec-btn-danger"
                        disabled="@(string.IsNullOrEmpty(disablePassword) || string.IsNullOrEmpty(disableCode) || isDisabling)"
                        @onclick="Disable2FA">
                    @if (isDisabling)
                    {
                        <span class="sec-spin" aria-hidden="true"></span>
                        <span>Turning off&#8230;</span>
                    }
                    else
                    {
                        <span>Turn off</span>
                    }
                </button>
            </div>
        </div>
    </div>
}

@* ── Regenerate backup codes ───────────────────────────────────────────── *@
@if (showRegenerateModal)
{
    <div class="sec sec-scrim" @onclick="CloseRegenerateModal">
        <div class="sec-modal" role="dialog" aria-modal="true" aria-label="Regenerate backup codes"
             @onclick:stopPropagation="true">
            <div class="sec-modal-head">
                <h2>Regenerate backup codes</h2>
                <button type="button" class="sec-icon-btn sec-modal-x" aria-label="Close" @onclick="CloseRegenerateModal">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                         stroke-width="1.8" stroke-linecap="round" aria-hidden="true">
                        <path d="M5 5l14 14M19 5L5 19"></path>
                    </svg>
                </button>
            </div>
            <div class="sec-modal-body">
                <div class="sec-notice sec-fam-info">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                         stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <circle cx="12" cy="12" r="9"></circle>
                        <path d="M12 11v5"></path>
                        <path d="M12 7.5v.01"></path>
                    </svg>
                    <span class="sec-notice-text">
                        Every code issued before now stops working. Anything written down becomes worthless.
                    </span>
                </div>
                <div class="sec-field">
                    <label class="sec-label" for="secRegenCode">Authenticator code</label>
                    <input id="secRegenCode" type="text" class="sec-input sec-input-code" maxlength="6"
                           inputmode="numeric" autocomplete="one-time-code" placeholder="000000"
                           @bind="regenerateCode" @bind:event="oninput" />
                </div>
            </div>
            <div class="sec-modal-foot">
                <button type="button" class="sec-btn sec-btn-quiet" @onclick="CloseRegenerateModal">Cancel</button>
                <button type="button" class="sec-btn sec-btn-primary"
                        disabled="@(string.IsNullOrEmpty(regenerateCode) || isRegenerating)" @onclick="RegenerateBackupCodes">
                    @if (isRegenerating)
                    {
                        <span class="sec-spin" aria-hidden="true"></span>
                        <span>Regenerating&#8230;</span>
                    }
                    else
                    {
                        <span>Regenerate</span>
                    }
                </button>
            </div>
        </div>
    </div>
}

@* ── Backup codes ──────────────────────────────────────────────────────────
   Shown once, straight after the API issued them, so it does not close on a
   stray click outside it or an X: Done is the only way out, and Done waits
   for the tick that says they are stored. *@
@if (showBackupCodesModal)
{
    <div class="sec sec-scrim">
        <div class="sec-modal" role="dialog" aria-modal="true" aria-labelledby="secCodesTitle">
            <div class="sec-modal-head">
                <h2 id="secCodesTitle">@backupCodesModalTitle</h2>
            </div>
            <div class="sec-modal-body">
                <div class="sec-notice sec-fam-warn">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                         stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <path d="M12 4l9 16H3z"></path>
                        <path d="M12 10v4"></path>
                        <path d="M12 17.5v.01"></path>
                    </svg>
                    <span class="sec-notice-text">@backupCodesModalDescription</span>
                </div>
                <ol class="sec-codes">
                    @for (var i = 0; i < displayedBackupCodes.Count; i++)
                    {
                        <li><span>@(i + 1)</span><span class="sec-code">@displayedBackupCodes[i]</span></li>
                    }
                </ol>
                <label class="sec-ack">
                    <input type="checkbox" @bind="backupCodesAcknowledged" />
                    I've stored these somewhere other than my phone
                </label>
            </div>
            <div class="sec-modal-foot sec-modal-foot-split">
                <div>
                    <button type="button" class="sec-btn sec-btn-quiet" @onclick="CopyDisplayedBackupCodesToClipboard">Copy</button>
                    <button type="button" class="sec-btn sec-btn-quiet" @onclick="DownloadBackupCodes">Download .txt</button>
                </div>
                <button type="button" class="sec-btn sec-btn-primary" disabled="@(!backupCodesAcknowledged)"
                        @onclick="CloseBackupCodesModal">Done</button>
            </div>
        </div>
    </div>
}

@code {
    private bool isLoading = true;

    // Which sign-in method row has its form open under it: "password", "passkey" or none.
    private string? openRow;
    private string? successMessage;
    private string? errorMessage;

    // 2FA state
    private TwoFactorStatusModel? twoFactorStatus;
    private bool isSettingUp = false;
    private TwoFactorSetupModel? setupData;
    private string verificationCode = "";
    private bool isVerifying = false;

    // Disable 2FA state
    private bool showDisableModal = false;
    private string disablePassword = "";
    private string disableCode = "";
    private bool isDisabling = false;

    // Regenerate state
    private bool showRegenerateModal = false;
    private string regenerateCode = "";
    private bool isRegenerating = false;
    private bool showBackupCodesModal = false;
    private string backupCodesModalTitle = string.Empty;
    private string backupCodesModalDescription = string.Empty;
    private List<string> displayedBackupCodes = new();
    private bool backupCodesAcknowledged;

    private bool IsEnrolling => isSettingUp && setupData != null;

    // Password change state
    private string currentPassword = "";
    private string newPassword = "";
    private string confirmPassword = "";
    private bool isChangingPassword = false;

    // Credentials update state
    private string credUsername = "";
    private string credEmail = "";
    private string credPassword = "";
    private bool isUpdatingCredentials = false;
    private bool isLoadingCredentials = true;
    private string originalCredUsername = "";
    private string originalCredEmail = "";
    private string? credSuccessMessage;
    private string? credErrorMessage;

    // Passkey state
    private List<PasskeyCredentialInfo> passkeys = new();
    private string newPasskeyName = string.Empty;
    private bool isRegisteringPasskey = false;
    private string? passkeySuccessMessage;
    private string? passkeyErrorMessage;

    private bool IsCredentialsValid =>
        !string.IsNullOrWhiteSpace(credPassword) &&
        HasCredentialChanges &&
        (!string.IsNullOrWhiteSpace(credUsername) || credEmail != null);

    private bool HasCredentialChanges =>
        !string.Equals(credUsername.Trim(), originalCredUsername, StringComparison.OrdinalIgnoreCase) ||
        !string.Equals(credEmail.Trim(), originalCredEmail, StringComparison.OrdinalIgnoreCase);

    // Activity state
    private List<LoginActivityModel> recentActivity = new();
    private MyAuditActivity? myActivity;
    private UserActivityMeResponse? activitySummary;

    private bool IsPasswordValid =>
    !string.IsNullOrEmpty(currentPassword) &&
    newPassword.Length >= 8 &&
    System.Text.RegularExpressions.Regex.IsMatch(newPassword, "[A-Z]") &&
    System.Text.RegularExpressions.Regex.IsMatch(newPassword, "[a-z]") &&
    System.Text.RegularExpressions.Regex.IsMatch(newPassword, "[0-9]") &&
    System.Text.RegularExpressions.Regex.IsMatch(newPassword, @"[^a-zA-Z0-9]") &&
    newPassword == confirmPassword;

    protected override async Task OnInitializedAsync()
    {
        await LoadAllData();
    }

    private async Task LoadAllData()
    {
        isLoading = true;
        isLoadingCredentials = true;
        try
        {
            var statusTask = TwoFactorService.GetStatusAsync();
            var credentialsTask = TwoFactorService.GetCredentialsAsync();
            var passkeysTask = TwoFactorService.GetPasskeysAsync();

            await Task.WhenAll(statusTask, credentialsTask, passkeysTask);

            twoFactorStatus = statusTask.Result;
            passkeys = passkeysTask.Result;

            var creds = credentialsTask.Result;
            if (creds != null)
            {
                credUsername = creds.Username;
                credEmail = creds.Email ?? "";
                originalCredUsername = credUsername;
                originalCredEmail = credEmail;
            }

            await LoadRecentActivityAsync();

            // Also load summary from the data we already have
            activitySummary = BuildActivitySummaryFromRecent();
        }
        catch (Exception ex)
        {
            errorMessage = $"Failed to load security settings: {ex.Message}";
        }
        finally
        {
            isLoading = false;
            isLoadingCredentials = false;
        }
    }

    private async Task RegisterPasskey()
    {
        isRegisteringPasskey = true;
        passkeyErrorMessage = null;
        passkeySuccessMessage = null;

        try
        {
            var supported = await JS.InvokeAsync<bool>("passkeys.isSupported");
            if (!supported)
            {
                passkeyErrorMessage = "Passkeys are only available in supported browsers over HTTPS or localhost.";
                return;
            }

            var context = await JS.InvokeAsync<PasskeyBrowserContext>("passkeys.getContext");
            var friendlyName = string.IsNullOrWhiteSpace(newPasskeyName)
                ? $"Passkey {passkeys.Count + 1}"
                : newPasskeyName.Trim();

            var (beginSuccess, beginMessage, ceremony) = await TwoFactorService.BeginPasskeyRegistrationAsync(
                friendlyName,
                context.Origin,
                context.RpId);

            if (!beginSuccess || ceremony is null)
            {
                passkeyErrorMessage = beginMessage;
                return;
            }

            var credentialJson = await JS.InvokeAsync<string>("passkeys.register", ceremony.Value.OptionsJson);
            var (completeSuccess, completeMessage, credential) = await TwoFactorService.CompletePasskeyRegistrationAsync(
                ceremony.Value.SessionToken,
                credentialJson,
                context.Origin,
                context.RpId);

            if (!completeSuccess || credential is null)
            {
                passkeyErrorMessage = completeMessage;
                return;
            }

            passkeySuccessMessage = $"Passkey '{credential.FriendlyName}' added successfully.";
            newPasskeyName = string.Empty;
            openRow = null;
            await LoadAllData();
            await AuditService.LogAsync("RegisterPasskey", "Security", $"Registered passkey '{credential.FriendlyName}'");
        }
        catch (JSException ex)
        {
            Logger.LogWarning(ex, "Passkey browser interaction failed during registration");
            passkeyErrorMessage = GetSafePasskeyRegistrationErrorMessage(ex.Message);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Unexpected error during passkey registration");
            passkeyErrorMessage = "Passkey registration could not be completed right now. Please try again.";
        }
        finally
        {
            isRegisteringPasskey = false;
        }
    }

    private static string GetSafePasskeyRegistrationErrorMessage(string? message)
    {
        const string defaultMessage = "Passkey registration could not be completed right now. Please try again.";

        if (string.IsNullOrWhiteSpace(message))
            return defaultMessage;

        var normalizedMessage = message.ToLowerInvariant();

        if (ContainsAny(normalizedMessage, "cancelled or timed out", "canceled or timed out", "notallowederror", "timed out", "not allowed"))
            return "Passkey registration was cancelled or timed out. Try again when you are ready.";

        if (ContainsAny(normalizedMessage, "passkeys are only available", "passkeys require a supported browser", "securityerror", "secure context", "https"))
            return "Passkeys are only available in supported browsers over HTTPS or localhost.";

        if (ContainsAny(normalizedMessage, "browser or device does not support", "notsupportederror", "not supported"))
            return "This browser or device does not support passkeys for this action.";

        if (ContainsAny(normalizedMessage, "already registered", "invalidstateerror"))
            return "This passkey is already registered on this device or account.";

        if (ContainsAny(normalizedMessage, "interrupted", "aborterror"))
            return "Passkey registration was interrupted. Try again.";

        return defaultMessage;
    }

    private static bool ContainsAny(string value, params string[] terms)
    {
        return terms.Any(value.Contains);
    }

    private async Task LoadRecentActivityAsync()
    {
        if (string.IsNullOrWhiteSpace(credUsername))
        {
            recentActivity = new();
            myActivity = null;
            return;
        }

        // The account's own history. GetLogsAsync(username: ...) read the whole audit log filtered by
        // name, which needs audit.view; every role but Admin is refused it.
        myActivity = await AuditService.GetMyRecentActivityAsync(credUsername, 10);
        recentActivity = myActivity.Items
            .Select(log => new LoginActivityModel
            {
                Action = log.Action,
                EntityType = log.EntityType,
                EntityId = log.EntityId,
                Details = log.Details ?? log.ErrorMessage,
                PageUrl = log.PageUrl,
                IsSuccess = log.IsSuccess,
                Timestamp = log.Timestamp
            })
            .ToList();
    }

    private UserActivityMeResponse? BuildActivitySummaryFromRecent()
    {
        return new UserActivityMeResponse
        {
            // The API's own counts for the account. Counting the ten rows on screen capped "this week"
            // at ten, so that is only the fallback for when the API could not answer.
            ActionsToday = myActivity?.ActionsToday ?? recentActivity.Count(a => a.Timestamp.Date == DateTime.UtcNow.Date),
            ActionsThisWeek = myActivity?.ActionsThisWeek ?? recentActivity.Count,
            RecentActivities = recentActivity
        };
    }

    // ── 2FA Methods ──────────────────────────────────────

    private async Task StartSetup2FA()
    {
        openRow = null;
        isLoading = true;
        errorMessage = null;
        CloseBackupCodesModal();
        try
        {
            setupData = await TwoFactorService.InitiateSetupAsync();
            if (setupData != null)
                isSettingUp = true;
            else
                errorMessage = "Failed to initiate 2FA setup. Please try again.";
        }
        catch (HttpRequestException ex)
        {
            errorMessage = $"Failed to initiate 2FA setup: {ex.Message}";
        }
        catch (Exception ex)
        {
            errorMessage = $"Error starting 2FA setup: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }

    private void CancelSetup()
    {
        isSettingUp = false;
        setupData = null;
        verificationCode = "";
    }

    private async Task VerifyAndEnable2FA()
    {
        if (string.IsNullOrEmpty(verificationCode) || verificationCode.Length != 6) return;
        isVerifying = true;
        errorMessage = null;
        try
        {
            var (success, message, backupCodes) = await TwoFactorService.EnableTwoFactorAsync(verificationCode);
            if (success)
            {
                successMessage = message;
                isSettingUp = false;
                setupData = null;
                verificationCode = "";
                await LoadAllData();
                ShowBackupCodes(
                    "Save these backup codes",
                    "Each works once, in place of an authenticator code. This is the only time they're shown.",
                    backupCodes);
                await AuditService.LogAsync("Enable2FA", "Security", "Two-factor authentication enabled");
            }
            else
            {
                errorMessage = message;
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Error enabling 2FA: {ex.Message}";
        }
        finally
        {
            isVerifying = false;
        }
    }

    private void ShowDisable2FA()
    {
        disablePassword = "";
        disableCode = "";
        showDisableModal = true;
    }

    private async Task Disable2FA()
    {
        if (string.IsNullOrEmpty(disablePassword) || string.IsNullOrEmpty(disableCode)) return;
        isDisabling = true;
        errorMessage = null;
        try
        {
            var (success, message) = await TwoFactorService.DisableTwoFactorAsync(disablePassword, disableCode);
            if (success)
            {
                successMessage = "Two-factor authentication has been disabled.";
                showDisableModal = false;
                disablePassword = "";
                disableCode = "";
                await LoadAllData();
                await AuditService.LogAsync("Disable2FA", "Security", "Two-factor authentication disabled");
            }
            else
            {
                errorMessage = message;
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Error disabling 2FA: {ex.Message}";
        }
        finally
        {
            isDisabling = false;
        }
    }

    private void ShowRegenerateBackupCodes()
    {
        regenerateCode = "";
        showRegenerateModal = true;
    }

    private async Task RegenerateBackupCodes()
    {
        if (string.IsNullOrEmpty(regenerateCode)) return;
        isRegenerating = true;
        errorMessage = null;
        try
        {
            var (success, message, backupCodes) = await TwoFactorService.RegenerateBackupCodesAsync(regenerateCode);
            if (!success)
            {
                errorMessage = message;
            }
            else
            {
                successMessage = message;
                showRegenerateModal = false;
                regenerateCode = "";
                await LoadAllData();
                ShowBackupCodes(
                    "Your new backup codes",
                    "The previous set stopped working just now. Each of these works once, and this is the only time they're shown.",
                    backupCodes);
                await AuditService.LogAsync("RegenerateBackupCodes", "Security", "Backup codes regenerated");
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Error regenerating backup codes: {ex.Message}";
        }
        finally
        {
            isRegenerating = false;
        }
    }

    private void CloseRegenerateModal()
    {
        showRegenerateModal = false;
        regenerateCode = "";
    }

    private void ShowBackupCodes(string title, string description, List<string>? backupCodes)
    {
        displayedBackupCodes = backupCodes ?? new List<string>();
        if (displayedBackupCodes.Count == 0)
        {
            return;
        }

        backupCodesModalTitle = title;
        backupCodesModalDescription = description;
        backupCodesAcknowledged = false;
        showBackupCodesModal = true;
    }

    private void CloseBackupCodesModal()
    {
        showBackupCodesModal = false;
        backupCodesAcknowledged = false;
        backupCodesModalTitle = string.Empty;
        backupCodesModalDescription = string.Empty;
        displayedBackupCodes = new List<string>();
    }

    // ── Credentials Update ─────────────────────────────

    private async Task UpdateCredentials()
    {
        if (!IsCredentialsValid) return;
        isUpdatingCredentials = true;
        credErrorMessage = null;
        credSuccessMessage = null;
        try
        {
            var (success, message, data) = await TwoFactorService.UpdateCredentialsAsync(
                credUsername, string.IsNullOrWhiteSpace(credEmail) ? null : credEmail, credPassword);

            if (success)
            {
                credSuccessMessage = data?.Message ?? $"Login credentials updated successfully. Your login username is '{credUsername}'.";
                credPassword = "";
                if (data != null)
                {
                    credUsername = data.Username;
                    credEmail = data.Email ?? "";
                    originalCredUsername = credUsername;
                    originalCredEmail = credEmail;
                }
                await AuditService.LogAsync("UpdateCredentials", "Security", "Login credentials updated");
            }
            else
            {
                credErrorMessage = message;
            }
        }
        catch (Exception ex)
        {
            credErrorMessage = $"Error updating credentials: {ex.Message}";
        }
        finally
        {
            isUpdatingCredentials = false;
        }
    }

    // ── Password Change ──────────────────────────────────

    private async Task ChangePassword()
    {
        if (!IsPasswordValid) return;
        isChangingPassword = true;
        errorMessage = null;
        successMessage = null;
        try
        {
            var (success, message) = await TwoFactorService.ChangePasswordAsync(credUsername, currentPassword, newPassword,
confirmPassword);
            if (success)
            {
                successMessage = "Password changed successfully. Please sign in again with your new password.";
                currentPassword = "";
                newPassword = "";
                confirmPassword = "";
                await AuditService.LogAsync("ChangePassword", "Security", "Password changed");
                NavigationManager.NavigateTo("/login", forceLoad: true);
            }
            else
            {
                errorMessage = message;
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Error changing password: {ex.Message}";
        }
        finally
        {
            isChangingPassword = false;
        }
    }

    // ── Helpers ──────────────────────────────────────────

    private void ToggleRow(string row)
    {
        openRow = openRow == row ? null : row;
        if (openRow == "passkey")
        {
            passkeyErrorMessage = null;
            passkeySuccessMessage = null;
        }
    }

    // The one thing the posture panel points at, weakest layer first. Null when
    // every layer the page can check is in place.
    private sealed record PostureStep(string Title, string Sub, string Action, string Family, Func<Task> Act);

    private PostureStep? NextStep(int score)
    {
        var twoFactorOn = twoFactorStatus?.IsEnabled == true;
        var codesLeft = twoFactorStatus?.BackupCodesRemaining ?? 0;

        if (!twoFactorOn)
        {
            // Turning it on issues a fresh set of ten codes, so it earns the
            // two-factor points and both backup-code steps at once.
            var gain = Math.Min(100, score + 60) - score;
            return new PostureStep("Turn on two-factor authentication",
                gain > 0 ? $"Worth +{gain} — it also issues backup codes." : "It also issues backup codes.",
                "Set up", "sec-fam-warn", StartSetup2FA);
        }

        if (codesLeft == 0)
            return new PostureStep("Regenerate backup codes",
                "None left — losing the authenticator would lock this account out.",
                "Regenerate", "sec-fam-warn", () => { ShowRegenerateBackupCodes(); return Task.CompletedTask; });

        if (codesLeft < 5)
            return new PostureStep("Top up backup codes",
                $"Only {codesLeft} left. A new set replaces them all.",
                "Regenerate", "sec-fam-info", () => { ShowRegenerateBackupCodes(); return Task.CompletedTask; });

        if (!passkeys.Any())
            return new PostureStep("Add a passkey",
                "Sign in with the device itself — nothing to phish if there is no password to type.",
                "Add passkey", "sec-fam-info", () => { openRow = "passkey"; return Task.CompletedTask; });

        return null;
    }

    private static string Initials(string username)
    {
        var parts = System.Text.RegularExpressions.Regex.Split(username, "[^A-Za-z0-9]+")
            .Where(p => p.Length > 0)
            .Take(2)
            .Select(p => char.ToUpperInvariant(p[0]));
        var initials = string.Concat(parts);
        return initials.Length > 0 ? initials : "?";
    }

    private static string ActivityMeta(LoginActivityModel activity)
    {
        var parts = new List<string>();
        if (!string.IsNullOrEmpty(activity.EntityType)) parts.Add(activity.EntityType);
        if (!string.IsNullOrEmpty(activity.Details)) parts.Add(TruncateText(activity.Details, 60));
        return string.Join(" · ", parts);
    }

    private async Task DownloadBackupCodes()
    {
        if (displayedBackupCodes.Count == 0) return;

        var lines = new List<string>
        {
            $"Shop Inventory backup codes for {originalCredUsername}",
            $"Issued {DateTime.Now:d MMMM yyyy HH:mm}. Each code works once. Issuing a new set cancels these.",
            string.Empty
        };
        lines.AddRange(displayedBackupCodes.Select((code, i) => $"{i + 1,2}. {code}"));

        var base64 = Convert.ToBase64String(System.Text.Encoding.UTF8.GetBytes(string.Join(Environment.NewLine, lines) + Environment.NewLine));
        try
        {
            await JS.InvokeVoidAsync("downloadFile", "shopinventory-backup-codes.txt", "text/plain", base64);
        }
        catch (JSException ex)
        {
            Logger.LogWarning(ex, "Backup code download failed in the browser");
            errorMessage = "The download could not be started. Copy the codes instead.";
        }
    }

    // The score's three steps as family classes rather than hexes, so the ring,
    // the number and the verdict take one hue between them and it darkens on
    // paper with everything else in nocturne-tokens.css. The thresholds are the
    // ones CalculateSecurityScore was already written against.
    private static string ScoreFamily(int score) =>
        score >= 80 ? "sec-fam-good" : score >= 50 ? "sec-fam-warn" : "sec-fam-bad";

    private int CalculateSecurityScore()
    {
        var score = 30; // Base score for having an account
        if (twoFactorStatus?.IsEnabled == true) score += 40;
        if (passkeys.Any()) score += 20;
        if (twoFactorStatus?.BackupCodesRemaining > 0) score += 15;
        if (twoFactorStatus?.BackupCodesRemaining >= 5) score += 5;
        if (recentActivity.All(a => a.IsSuccess)) score += 10;
        return Math.Min(100, score);
    }

    private static string FormatAction(string action)
    {
        // Convert PascalCase to readable: "ViewInvoice" → "View Invoice"
        return System.Text.RegularExpressions.Regex.Replace(action, "(?<=[a-z])(?=[A-Z])", " ");
    }

    private static string TruncateText(string text, int maxLen) =>
    text.Length <= maxLen ? text : text[..maxLen] + "...";

    private async Task CopyToClipboard(string text)
    {
        try
        {
            await JS.InvokeVoidAsync("navigator.clipboard.writeText", text);
            successMessage = "Copied to clipboard!";
        }
        catch { }
    }

    private async Task CopyDisplayedBackupCodesToClipboard()
    {
        if (displayedBackupCodes.Count > 0)
        {
            await CopyToClipboard(string.Join("\n", displayedBackupCodes));
        }
    }
}
