@page "/backups"
@inject IBackupService BackupService
@inject IJSRuntime JS
@inject IAuditService AuditService
@attribute [Authorize(Roles = "Admin")]
@rendermode InteractiveServer

<PageTitle>Backups - Shop Inventory</PageTitle>

@* The Nocturne sheet is wwwroot/css/backups.css (linked from App.razor),
   derived from audit-trail.css — a backup run is an audit event with a start,
   a duration, an outcome and someone who asked for it, so the grid, the family
   badges and the row-to-card treatment below 1040px are that page's. It lives
   in a file rather than in the <style> block this page used to carry because
   app.css's global `.dark-theme input/select/textarea` rules have to be
   out-specified, which a scoped block cannot do.

   Restore is the one filled button in the module. Everything else in Nocturne
   is outlined, but next to Cancel an outline would make overwriting the live
   database look like an equally ordinary choice. *@

<div class="bak">

    <header class="bak-head">
        <div class="bak-head-inner">
            <nav class="bak-crumbs" aria-label="Breadcrumb">
                <span>Administration</span>
                <span class="bak-crumb-sep" aria-hidden="true">/</span>
                <span class="bak-crumb-now" aria-current="page">Backups</span>
            </nav>
            <div class="bak-head-actions">
                <button type="button" class="bak-btn bak-btn-primary" disabled="@isCreating" @onclick="OpenCreateModal">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                         stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <path d="M12 5v14"></path>
                        <path d="M5 12h14"></path>
                    </svg>
                    <span>Create backup</span>
                </button>
            </div>
        </div>
    </header>

    <div class="bak-body">

        <section class="bak-hero">
            <div>
                <div class="bak-kicker">Disaster recovery</div>
                <h1>Database backups</h1>
                <p>
                    Every restore point taken of the application database, and what each one cost to take.
                    Restoring overwrites the live data, so the two dates above the history are the ones
                    worth reading first.
                </p>
            </div>
        </section>

        @if (stats != null)
        {
            <section class="bak-stats">
                <div class="bak-stat bak-stat-lead">
                    <div class="bak-stat-head"><span class="bak-stat-rule"></span>Backups</div>
                    <div class="bak-stat-num">@stats.TotalBackups</div>
                    <div class="bak-stat-sub">restore points held</div>
                </div>
                <div class="bak-stat">
                    <div class="bak-stat-head"><span class="bak-stat-rule"></span>Successful</div>
                    <div class="bak-stat-num">@stats.SuccessfulBackups</div>
                    <div class="bak-stat-sub">completed without error</div>
                </div>
                <div class="bak-stat @(stats.FailedBackups > 0 ? "bak-stat-alert" : "")">
                    <div class="bak-stat-head"><span class="bak-stat-rule"></span>Failed</div>
                    <div class="bak-stat-num">@stats.FailedBackups</div>
                    <div class="bak-stat-sub">did not produce a file</div>
                </div>
                <div class="bak-stat">
                    <div class="bak-stat-head"><span class="bak-stat-rule"></span>Total size</div>
                    <div class="bak-stat-num bak-stat-num-text">@stats.TotalSizeFormatted</div>
                    <div class="bak-stat-sub">across every file kept</div>
                </div>
            </section>

            @if (stats.LastBackupAt.HasValue)
            {
                <section class="bak-strip">
                    <div class="bak-strip-item">
                        <span class="bak-strip-label">Last backup</span>
                        <span class="bak-strip-value">@stats.LastBackupAt.Value.ToString("d MMM yyyy HH:mm")</span>
                    </div>
                    @if (stats.NextScheduledBackup.HasValue)
                    {
                        <div class="bak-strip-item">
                            <span class="bak-strip-label">Next scheduled</span>
                            <span class="bak-strip-value">@stats.NextScheduledBackup.Value.ToString("d MMM yyyy HH:mm")</span>
                        </div>
                    }
                </section>
            }
        }

        @if (isLoading)
        {
            <div class="bak-loading">
                <span class="bak-spin" aria-hidden="true"></span>
                <span>Loading backups&#8230;</span>
            </div>
        }
        else if (errorMessage != null)
        {
            <div class="bak-notice bak-notice-bad" role="alert">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                     stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <circle cx="12" cy="12" r="9"></circle>
                    <path d="M12 7v6"></path>
                    <path d="M12 16.5v.01"></path>
                </svg>
                <span class="bak-notice-text">@errorMessage</span>
                <button type="button" class="bak-btn bak-btn-quiet" @onclick="RetryLoad">Retry</button>
            </div>
        }
        else if (backups?.Any() == true)
        {
            <section class="bak-panel">
                <div class="bak-panel-head">
                    <h2>Backup history</h2>
                    <span class="bak-count">@backups.Count @(backups.Count == 1 ? "run" : "runs")</span>
                </div>

                <div class="bak-scroll">
                    <div class="bak-grid" role="table" aria-label="Backup history">
                        <div class="bak-thead" role="row">
                            <span role="columnheader">File</span>
                            <span role="columnheader">Type</span>
                            <span role="columnheader">Status</span>
                            <span role="columnheader">Size</span>
                            <span role="columnheader">Started</span>
                            <span role="columnheader">Duration</span>
                            <span role="columnheader">Created by</span>
                            <span role="columnheader">Storage</span>
                            <span role="columnheader">Actions</span>
                        </div>

                        @foreach (var backup in backups)
                        {
                            var b = backup;
                            <div class="bak-row @RowState(b.Status)" role="row">
                                <div class="bak-file" role="cell">
                                    <div class="bak-file-name" title="@b.FileName">@b.FileName</div>
                                    @if (!string.IsNullOrEmpty(b.Description))
                                    {
                                        <div class="bak-file-desc" title="@b.Description">@b.Description</div>
                                    }
                                </div>
                                <div role="cell">
                                    <span class="bak-rl">Type</span>
                                    <span class="bak-badge @TypeFamily(b.BackupType)">@b.BackupType</span>
                                </div>
                                <div role="cell">
                                    <span class="bak-rl">Status</span>
                                    <span class="bak-badge @StatusFamily(b.Status)"
                                          title="@(string.IsNullOrEmpty(b.ErrorMessage) ? null : b.ErrorMessage)">
                                        @if (b.Status == "InProgress")
                                        {
                                            <span class="bak-spin bak-spin-xs" aria-hidden="true"></span>
                                        }
                                        @b.Status
                                    </span>
                                </div>
                                <div class="bak-num" role="cell">
                                    <span class="bak-rl">Size</span>@b.SizeFormatted
                                </div>
                                <div class="bak-num" role="cell">
                                    <span class="bak-rl">Started</span>@b.StartedAt.ToString("d MMM HH:mm")
                                </div>
                                <div class="bak-num" role="cell">
                                    <span class="bak-rl">Duration</span>
                                    @if (b.Duration.HasValue)
                                    {
                                        @b.Duration.Value.ToString(@"mm\:ss")
                                    }
                                    else if (b.Status == "InProgress")
                                    {
                                        <span class="bak-spin bak-spin-xs" aria-hidden="true"></span>
                                    }
                                    else
                                    {
                                        <span class="bak-none">&#8212;</span>
                                    }
                                </div>
                                <div class="bak-text" role="cell">
                                    <span class="bak-rl">Created by</span>@(b.CreatedByUserName ?? "System")
                                </div>
                                <div role="cell">
                                    <span class="bak-rl">Storage</span>
                                    @if (b.IsOffsite)
                                    {
                                        <span class="bak-badge bak-fam-good">Cloud</span>
                                    }
                                    else
                                    {
                                        <span class="bak-badge bak-fam-neutral">Local</span>
                                    }
                                </div>
                                <div role="cell">
                                    <span class="bak-rl">Actions</span>
                                    <div class="bak-actions">
                                        @if (b.Status == "Completed")
                                        {
                                            <button type="button" class="bak-icon-btn" title="Download"
                                                    aria-label="Download backup" @onclick="() => DownloadBackup(b.Id)">
                                                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                                     stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                                    <path d="M12 4v11"></path>
                                                    <path d="M8 11l4 4 4-4"></path>
                                                    <path d="M5 19h14"></path>
                                                </svg>
                                            </button>
                                            <button type="button" class="bak-icon-btn bak-icon-btn-warn" title="Restore"
                                                    aria-label="Restore from this backup" @onclick="() => ConfirmRestore(b)">
                                                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                                     stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                                    <path d="M4 13a8 8 0 1 0 2.3-5.7L4 9"></path>
                                                    <path d="M4 4v5h5"></path>
                                                </svg>
                                            </button>
                                        }
                                        <button type="button" class="bak-icon-btn bak-icon-btn-danger" title="Delete"
                                                aria-label="Delete backup" @onclick="() => ConfirmDelete(b)">
                                            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                                 stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                                <path d="M4 7h16"></path>
                                                <path d="M9 7V5h6v2"></path>
                                                <path d="M6 7l1 13h10l1-13"></path>
                                            </svg>
                                        </button>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </section>
        }
        else
        {
            <div class="bak-empty">
                <svg width="30" height="30" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                     stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <ellipse cx="12" cy="6" rx="8" ry="3"></ellipse>
                    <path d="M4 6v12c0 1.7 3.6 3 8 3s8-1.3 8-3V6"></path>
                    <path d="M4 12c0 1.7 3.6 3 8 3s8-1.3 8-3"></path>
                </svg>
                <h3>No backups yet</h3>
                <p>Nothing has been captured. Until a backup exists there is no restore point for this database.</p>
                <div class="bak-empty-actions">
                    <button type="button" class="bak-btn bak-btn-primary" @onclick="OpenCreateModal">Create the first backup</button>
                </div>
            </div>
        }
    </div>
</div>

@* ── Create ────────────────────────────────────────────────────────────── *@
@if (showCreateModal)
{
    <div class="bak bak-scrim" @onclick="() => showCreateModal = false">
        <div class="bak-modal" role="dialog" aria-modal="true" aria-label="Create backup"
             @onclick:stopPropagation="true">
            <div class="bak-modal-head">
                <h2>Create backup</h2>
                <button type="button" class="bak-icon-btn bak-modal-x" aria-label="Close"
                        @onclick="() => showCreateModal = false">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                         stroke-width="1.8" stroke-linecap="round" aria-hidden="true">
                        <path d="M5 5l14 14M19 5L5 19"></path>
                    </svg>
                </button>
            </div>
            <div class="bak-modal-body">
                <div class="bak-field">
                    <label class="bak-label" for="bakType">Backup type</label>
                    <div class="bak-select">
                        <select id="bakType" class="bak-input" @bind="newBackup.BackupType">
                            <option value="Full">Full</option>
                            <option value="Incremental">Incremental</option>
                            <option value="Differential">Differential</option>
                        </select>
                        <span class="bak-caret" aria-hidden="true"></span>
                    </div>
                </div>
                <div class="bak-field">
                    <label class="bak-label" for="bakDesc">Description</label>
                    <textarea id="bakDesc" class="bak-textarea" rows="2" @bind="newBackup.Description"
                              placeholder="What this restore point is for"></textarea>
                    <span class="bak-hint">Optional, but it is the only thing that tells the runs apart in a list.</span>
                </div>
                <div class="bak-field">
                    <label class="@(CloudUploadAvailable ? "bak-switch" : "bak-switch bak-switch-off")">
                        <input type="checkbox" @bind="newBackup.UploadToCloud" disabled="@(!CloudUploadAvailable)" />
                        <span class="bak-track" aria-hidden="true"></span>
                        <span>Upload to cloud storage</span>
                    </label>
                    @if (!CloudUploadAvailable)
                    {
                        <span class="bak-hint">
                            Cloud storage is not configured in this environment, so the file stays on the server it
                            was taken on — which is also the server it would be lost with.
                        </span>
                    }
                </div>
            </div>
            <div class="bak-modal-foot">
                <button type="button" class="bak-btn bak-btn-quiet" @onclick="() => showCreateModal = false">Cancel</button>
                <button type="button" class="bak-btn bak-btn-primary" disabled="@isCreating" @onclick="CreateBackup">
                    @if (isCreating)
                    {
                        <span class="bak-spin" aria-hidden="true"></span>
                        <span>Starting&#8230;</span>
                    }
                    else
                    {
                        <span>Start backup</span>
                    }
                </button>
            </div>
        </div>
    </div>
}

@* ── Restore ───────────────────────────────────────────────────────────── *@
@if (showRestoreModal && backupToRestore != null)
{
    <div class="bak bak-scrim" @onclick="() => showRestoreModal = false">
        <div class="bak-modal bak-modal-danger" role="dialog" aria-modal="true" aria-label="Confirm restore"
             @onclick:stopPropagation="true">
            <div class="bak-modal-head">
                <h2>Restore this backup?</h2>
                <button type="button" class="bak-icon-btn bak-modal-x" aria-label="Close"
                        @onclick="() => showRestoreModal = false">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                         stroke-width="1.8" stroke-linecap="round" aria-hidden="true">
                        <path d="M5 5l14 14M19 5L5 19"></path>
                    </svg>
                </button>
            </div>
            <div class="bak-modal-body">
                <div class="bak-notice bak-notice-bad">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                         stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <path d="M12 4l9 16H3z"></path>
                        <path d="M12 10v4"></path>
                        <path d="M12 17.5v.01"></path>
                    </svg>
                    <span class="bak-notice-text">
                        Every change made since this file was taken will be gone. There is no undo, and no second
                        backup is made first.
                    </span>
                </div>
                <div class="bak-dl">
                    <div class="bak-dl-row">
                        <span class="bak-dt">File</span>
                        <span class="bak-dd">@backupToRestore.FileName</span>
                    </div>
                    <div class="bak-dl-row">
                        <span class="bak-dt">Taken</span>
                        <span class="bak-dd">@backupToRestore.StartedAt.ToString("d MMM yyyy HH:mm")</span>
                    </div>
                    <div class="bak-dl-row">
                        <span class="bak-dt">Size</span>
                        <span class="bak-dd">@backupToRestore.SizeFormatted</span>
                    </div>
                </div>
            </div>
            <div class="bak-modal-foot">
                <button type="button" class="bak-btn bak-btn-quiet" @onclick="() => showRestoreModal = false">Cancel</button>
                <button type="button" class="bak-btn bak-btn-danger" disabled="@isRestoring" @onclick="RestoreBackup">
                    @if (isRestoring)
                    {
                        <span class="bak-spin" aria-hidden="true"></span>
                        <span>Restoring&#8230;</span>
                    }
                    else
                    {
                        <span>Restore database</span>
                    }
                </button>
            </div>
        </div>
    </div>
}

@* ── Delete ────────────────────────────────────────────────────────────── *@
@if (showDeleteModal && backupToDelete != null)
{
    <div class="bak bak-scrim" @onclick="() => showDeleteModal = false">
        <div class="bak-modal" role="dialog" aria-modal="true" aria-label="Delete backup"
             @onclick:stopPropagation="true">
            <div class="bak-modal-head">
                <h2>Delete backup</h2>
                <button type="button" class="bak-icon-btn bak-modal-x" aria-label="Close"
                        @onclick="() => showDeleteModal = false">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                         stroke-width="1.8" stroke-linecap="round" aria-hidden="true">
                        <path d="M5 5l14 14M19 5L5 19"></path>
                    </svg>
                </button>
            </div>
            <div class="bak-modal-body">
                <p class="bak-modal-text">
                    The file is removed from storage permanently. The run stays out of the history with it.
                </p>
                <div class="bak-dl">
                    <div class="bak-dl-row">
                        <span class="bak-dt">File</span>
                        <span class="bak-dd">@backupToDelete.FileName</span>
                    </div>
                    <div class="bak-dl-row">
                        <span class="bak-dt">Size</span>
                        <span class="bak-dd">@backupToDelete.SizeFormatted</span>
                    </div>
                </div>
            </div>
            <div class="bak-modal-foot">
                <button type="button" class="bak-btn bak-btn-quiet" @onclick="() => showDeleteModal = false">Cancel</button>
                <button type="button" class="bak-btn bak-btn-danger" @onclick="DeleteBackup">Delete backup</button>
            </div>
        </div>
    </div>
}

@* ── Toast ─────────────────────────────────────────────────────────────── *@
@if (!string.IsNullOrEmpty(toastMessage))
{
    <div class="bak bak-toast bak-notice @(toastIsError ? "bak-notice-bad" : "bak-notice-good")" role="status">
        @if (toastIsError)
        {
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                 stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <circle cx="12" cy="12" r="9"></circle>
                <path d="M12 7v6"></path>
                <path d="M12 16.5v.01"></path>
            </svg>
        }
        else
        {
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                 stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M20 6L9 17l-5-5"></path>
            </svg>
        }
        <span class="bak-notice-text">@toastMessage</span>
        <button type="button" class="bak-notice-x" aria-label="Dismiss" @onclick="() => toastMessage = string.Empty">
            <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                 stroke-width="2" stroke-linecap="round" aria-hidden="true">
                <path d="M5 5l14 14M19 5L5 19"></path>
            </svg>
        </button>
    </div>
}

@code {
    private const bool CloudUploadAvailable = false;

    private List<BackupDto>? backups;
    private BackupStatsDto? stats;
    private BackupDto? backupToRestore;
    private BackupDto? backupToDelete;
    private bool isLoading = true;
    private bool isCreating = false;
    private bool isRestoring = false;
    private bool showCreateModal = false;
    private bool showRestoreModal = false;
    private bool showDeleteModal = false;
    private string? errorMessage;
    private string toastMessage = string.Empty;
    private bool toastIsError = false;

    private CreateBackupRequest newBackup = new();

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
        await AuditService.LogAsync(AuditActions.ViewBackups, "Backup", null);
    }

    private async Task LoadData()
    {
        isLoading = true;
        errorMessage = null;

        try
        {
            var backupTask = BackupService.GetAllBackupsAsync();
            var statsTask = BackupService.GetStatsAsync();
            await Task.WhenAll(backupTask, statsTask);

            var response = await backupTask;
            stats = await statsTask;

            if (response != null)
            {
                backups = response.Backups.OrderByDescending(b => b.StartedAt).ToList();
            }
            else
            {
                errorMessage = "Failed to load backups. The API may be unavailable.";
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Error: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task RetryLoad()
    {
        await LoadData();
    }

    private void OpenCreateModal()
    {
        newBackup.UploadToCloud = CloudUploadAvailable && newBackup.UploadToCloud;
        showCreateModal = true;
    }

    private async Task CreateBackup()
    {
        isCreating = true;
        try
        {
            var request = new CreateBackupRequest
            {
                BackupType = newBackup.BackupType,
                Description = newBackup.Description,
                UploadToCloud = CloudUploadAvailable && newBackup.UploadToCloud
            };

            var result = await BackupService.CreateBackupAsync(request);
            if (result != null)
            {
                showCreateModal = false;
                newBackup = new();
                ShowToast("Backup created successfully");
                await AuditService.LogAsync(AuditActions.CreateBackup, "Backup", result.Id.ToString(), $"Type: {result.BackupType}",
true);
                await LoadData();
            }
            else
            {
                ShowToast("Failed to create backup", true);
            }
        }
        catch (Exception ex)
        {
            ShowToast($"Error creating backup: {ex.Message}", true);
        }
        finally
        {
            isCreating = false;
        }
    }

    private void ConfirmRestore(BackupDto backup)
    {
        backupToRestore = backup;
        showRestoreModal = true;
    }

    private async Task RestoreBackup()
    {
        if (backupToRestore == null) return;

        isRestoring = true;
        try
        {
            var success = await BackupService.RestoreBackupAsync(backupToRestore.Id);
            if (success)
            {
                showRestoreModal = false;
                backupToRestore = null;
                ShowToast("Backup restored successfully");
                await AuditService.LogAsync(AuditActions.RestoreBackup, "Backup", backupToRestore?.Id.ToString());
                await LoadData();
            }
            else
            {
                ShowToast("Failed to restore backup", true);
            }
        }
        catch (Exception ex)
        {
            ShowToast($"Error restoring backup: {ex.Message}", true);
        }
        finally
        {
            isRestoring = false;
        }
    }

    private void ConfirmDelete(BackupDto backup)
    {
        backupToDelete = backup;
        showDeleteModal = true;
    }

    private async Task DeleteBackup()
    {
        if (backupToDelete == null) return;

        try
        {
            var success = await BackupService.DeleteBackupAsync(backupToDelete.Id);
            if (success)
            {
                showDeleteModal = false;
                backupToDelete = null;
                ShowToast("Backup deleted successfully");
                await AuditService.LogAsync(AuditActions.DeleteBackup, "Backup", backupToDelete?.Id.ToString());
                await LoadData();
            }
            else
            {
                ShowToast("Failed to delete backup", true);
            }
        }
        catch (Exception ex)
        {
            ShowToast($"Error deleting backup: {ex.Message}", true);
        }
    }

    private async Task DownloadBackup(int id)
    {
        try
        {
            var backup = backups?.FirstOrDefault(b => b.Id == id);
            if (backup == null) return;

            await JS.InvokeVoidAsync("downloadAuthenticatedFile", $"/download/backup/{id}", backup.FileName);
            await AuditService.LogAsync(AuditActions.DownloadBackup, "Backup", id.ToString());
        }
        catch (Exception ex)
        {
            ShowToast($"Error downloading backup: {ex.Message}", true);
        }
    }

    private void ShowToast(string message, bool isError = false)
    {
        toastMessage = message;
        toastIsError = isError;
        StateHasChanged();

        _ = Task.Run(async () =>
        {
            await Task.Delay(5000);
            toastMessage = string.Empty;
            await InvokeAsync(StateHasChanged);
        });
    }

    // Both columns take one hue off the six-family set in nocturne-tokens.css,
    // so a badge's ink is mixed from the same value as its wash and the two
    // cannot drift apart.
    private static string StatusFamily(string status) => status switch
    {
        "Completed" => "bak-fam-good",
        "InProgress" => "bak-fam-accent",
        "Failed" => "bak-fam-bad",
        _ => "bak-fam-neutral"
    };

    private static string TypeFamily(string type) => type switch
    {
        "Full" => "bak-fam-accent",
        "Incremental" => "bak-fam-info",
        "Differential" => "bak-fam-warn",
        _ => "bak-fam-neutral"
    };

    // A run that failed or is still going is the one worth finding in a long
    // history, so it takes an edge mark. Everything else is an ordinary row.
    private static string RowState(string status) => status switch
    {
        "Failed" => "bak-row-failed",
        "InProgress" => "bak-row-running",
        _ => ""
    };
}
