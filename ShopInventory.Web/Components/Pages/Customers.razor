@page "/customers"
@using Microsoft.AspNetCore.Authorization
@using ShopInventory.Web.Data
@attribute [Authorize(Roles = UserRoles.CatalogueRoles)]
@rendermode InteractiveServer

<PageTitle>Business Partners - Shop Inventory</PageTitle>

@* The imported Nocturne design is dark; wwwroot/css/business-partners.css
   (linked from App.razor) carries it and its light counterpart, and follows
   the app's theme toggle like every other page.

   Icons are drawn inline rather than from the Phosphor font: the search glyph
   sits inside a field and the two row actions are icon-only, so a font that
   failed to load would leave them reading as nothing.

   The directory is a plain CSS grid rather than MudTable. The design's row is
   nine columns wide with a per-column treatment MudTable's cells cannot carry,
   and below 900px the same markup re-lays as a labelled card — which a table
   element cannot do at all. *@

<div class="bp">

    <header class="bp-head">
        <div class="bp-head-inner">
            <label class="bp-head-search">
                <span class="visually-hidden">Search business partners</span>
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"
                     stroke-linecap="round" aria-hidden="true">
                    <circle cx="11" cy="11" r="7"></circle>
                    <path d="M20 20l-3.5-3.5"></path>
                </svg>
                <input class="bp-input bp-input-search" type="search" autocomplete="off"
                       placeholder="Search by code, name, or email…"
                       @bind="searchTerm" @bind:event="oninput" />
            </label>
            <div class="bp-head-meta">
                @if (lastSyncTime.HasValue)
                {
                    <span class="bp-synced">Synced @lastSyncTime.Value.ToLocalTime().ToString("d MMM yyyy, HH:mm")</span>
                }
                <button type="button" class="bp-btn bp-btn-ghost" disabled="@(isLoading || isSyncing)"
                        @onclick="RefreshFromApi">
                    @if (isSyncing)
                    {
                        <span class="bp-spin" aria-hidden="true"></span>
                        <span>Syncing&#8230;</span>
                    }
                    else
                    {
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                             stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <path d="M20 11a8 8 0 0 0-13.7-5.3L4 8"></path>
                            <path d="M4 4v4h4"></path>
                            <path d="M4 13a8 8 0 0 0 13.7 5.3L20 16"></path>
                            <path d="M20 20v-4h-4"></path>
                        </svg>
                        <span>Refresh</span>
                    }
                </button>
            </div>
        </div>
    </header>

    <div class="bp-body">

        <section class="bp-hero">
            <div>
                <div class="bp-kicker">Master data</div>
                <h1>Business partners</h1>
                <p>Customers, suppliers and the accounts they trade on &#8212; mirrored from SAP.</p>
            </div>
            <div class="bp-scopes" role="group" aria-label="Partner type">
                @foreach (var (value, label) in Scopes)
                {
                    <button type="button" class="bp-scope @(scope == value ? "bp-scope-on" : "")"
                            aria-pressed="@(scope == value)" @onclick="() => SetScope(value)">
                        @label
                    </button>
                }
            </div>
        </section>

        @if (!string.IsNullOrEmpty(errorMessage))
        {
            <div class="bp-msg" role="alert">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"
                     stroke-linecap="round" aria-hidden="true">
                    <circle cx="12" cy="12" r="9"></circle>
                    <path d="M12 7.5v5.5M12 16.2v.1"></path>
                </svg>
                <span>@errorMessage</span>
                <button type="button" class="bp-msg-x" aria-label="Dismiss" @onclick="() => errorMessage = null">
                    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"
                         stroke-linecap="round" aria-hidden="true">
                        <path d="M6 6l12 12M18 6L6 18"></path>
                    </svg>
                </button>
            </div>
        }

        @if (isLoading)
        {
            <div class="bp-loading">
                <span class="bp-spin" aria-hidden="true"></span>
                <span>Loading business partners&#8230;</span>
            </div>
        }
        else
        {
            var rows = Filtered;
            var page = ClampPage(rows.Count);

            <section class="bp-stats">
                <div class="bp-stat bp-stat-lead">
                    <div class="bp-stat-head"><span class="bp-stat-rule" aria-hidden="true"></span>Customers</div>
                    <div class="bp-stat-num">@CustomerCount.ToString("N0")</div>
                    <div class="bp-stat-sub">Trading accounts</div>
                </div>
                <div class="bp-stat">
                    <div class="bp-stat-head"><span class="bp-stat-rule" aria-hidden="true"></span>Suppliers</div>
                    <div class="bp-stat-num">@SupplierCount.ToString("N0")</div>
                    <div class="bp-stat-sub">Goods and services</div>
                </div>
                <div class="bp-stat">
                    <div class="bp-stat-head"><span class="bp-stat-dot" aria-hidden="true"></span>Active</div>
                    <div class="bp-stat-num">@ActiveCount.ToString("N0")</div>
                    @* The cache only ever holds active partners, so this equals the
                       total on file — say so rather than imply a comparison. *@
                    <div class="bp-stat-sub">Only active partners are cached</div>
                </div>
                <div class="bp-stat">
                    <div class="bp-stat-head"><span class="bp-stat-rule" aria-hidden="true"></span>Total outstanding</div>
                    <div class="bp-stat-num">@TotalOutstanding.ToString("N0")</div>
                    <div class="bp-stat-sub">Sum of balances owed</div>
                </div>
            </section>

            <section class="bp-panel">
                <div class="bp-panel-head">
                    <h2>Directory</h2>
                    <span class="bp-count">@rows.Count.ToString("N0") shown · @AllCount.ToString("N0") total</span>
                    <div class="bp-panel-tools">
                        <button type="button" class="bp-tool @(showFilters ? "bp-tool-on" : "")"
                                aria-expanded="@showFilters" @onclick="() => showFilters = !showFilters">
                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                 stroke-width="1.7" stroke-linecap="round" aria-hidden="true">
                                <path d="M4 6h16M7 12h10M10 18h4"></path>
                            </svg>
                            Filters@(ActiveFilterCount > 0 ? $" ({ActiveFilterCount})" : "")
                        </button>
                        <button type="button" class="bp-tool" disabled="@(isExporting || rows.Count == 0)"
                                @onclick="() => ExportCsv(rows)">
                            @if (isExporting)
                            {
                                <span class="bp-spin" aria-hidden="true"></span>
                                <span>Exporting&#8230;</span>
                            }
                            else
                            {
                                <span>Export</span>
                            }
                        </button>
                    </div>
                </div>

                @if (showFilters)
                {
                    <div class="bp-filters">
                        <label class="bp-field">
                            <span class="bp-label">Channel</span>
                            <NocturneSelect Class="nsel-block" Options="ChannelFilterOptions"
                                            @bind-Value="channelFilter" OnChanged="ResetPage"
                                            Caption="Filter by channel" AriaLabel="Filter by channel" />
                        </label>
                        <label class="bp-field">
                            <span class="bp-label">Currency</span>
                            <NocturneSelect Class="nsel-block" Options="CurrencyFilterOptions"
                                            @bind-Value="currencyFilter" OnChanged="ResetPage"
                                            Caption="Filter by currency" AriaLabel="Filter by currency" />
                        </label>
                        @if (ActiveFilterCount > 0)
                        {
                            <div class="bp-field">
                                <span class="bp-label">&nbsp;</span>
                                <button type="button" class="bp-btn bp-btn-quiet" @onclick="ClearFilters">
                                    Clear filters
                                </button>
                            </div>
                        }
                    </div>
                }

                @if (rows.Count == 0)
                {
                    <div class="bp-empty">
                        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                             stroke-width="1.5" stroke-linecap="round" aria-hidden="true">
                            <circle cx="11" cy="11" r="7"></circle>
                            <path d="M20 20l-3.5-3.5"></path>
                        </svg>
                        @if (AllCount == 0)
                        {
                            <span>Nothing cached yet &#8212; refresh to pull the business partners from SAP.</span>
                            <div class="bp-empty-actions">
                                <button type="button" class="bp-btn bp-btn-primary" disabled="@isSyncing"
                                        @onclick="RefreshFromApi">
                                    Refresh from SAP
                                </button>
                            </div>
                        }
                        else
                        {
                            <span>No business partners match the current search and filters.</span>
                            <div class="bp-empty-actions">
                                <button type="button" class="bp-btn bp-btn-quiet" @onclick="ClearAllCriteria">
                                    Clear search and filters
                                </button>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <div class="bp-scroll">
                        <div class="bp-grid" role="table" aria-label="Business partners">
                            <div class="bp-thead" role="row">
                                <span role="columnheader">Code</span>
                                <span role="columnheader">Name</span>
                                <span role="columnheader">Type</span>
                                <span role="columnheader">Contact</span>
                                <span role="columnheader">Location</span>
                                <span role="columnheader">Ccy</span>
                                <span role="columnheader" class="bp-num">Balance</span>
                                <span role="columnheader">Status</span>
                                <span role="columnheader" class="bp-num">Actions</span>
                            </div>

                            @foreach (var partner in rows.Skip((page - 1) * pageSize).Take(pageSize))
                            {
                                var cardCode = partner.CardCode ?? string.Empty;
                                var balance = partner.Balance ?? 0m;
                                @* The row's click is a pointer convenience; the eye button
                                   beside it is the control keyboards and screen readers use. *@
                                <div class="bp-row" role="row" @onclick="() => ViewCustomer(partner)">
                                    <span class="bp-code" role="cell">@cardCode</span>
                                    <span class="bp-name-cell" role="cell">
                                        <span class="bp-avatar" aria-hidden="true">@Initials(partner.CardName)</span>
                                        <span class="bp-name">@partner.CardName</span>
                                    </span>
                                    <span class="bp-cell-type" role="cell">
                                        <span class="bp-type @(IsCustomer(partner.CardType) ? "bp-type-customer" : "")">
                                            @GetTypeLabel(partner.CardType)
                                        </span>
                                    </span>
                                    <span class="bp-contact" role="cell">
                                        <span class="bp-rl">Contact</span>
                                        @if (!string.IsNullOrWhiteSpace(partner.Email))
                                        {
                                            <a href="mailto:@partner.Email" @onclick:stopPropagation>@partner.Email</a>
                                        }
                                        else
                                        {
                                            @(string.IsNullOrWhiteSpace(partner.Phone1) ? "—" : partner.Phone1)
                                        }
                                    </span>
                                    <span class="bp-loc" role="cell">
                                        <span class="bp-rl">Location</span>@Location(partner)
                                    </span>
                                    <span class="bp-ccy" role="cell">
                                        <span class="bp-rl">Currency</span>@(partner.Currency ?? "USD")
                                    </span>
                                    <span class="bp-bal bp-num @BalanceClass(balance)" role="cell">
                                        <span class="bp-rl">Balance</span>@FormatBalance(balance)
                                    </span>
                                    <span class="bp-cell-status" role="cell">
                                        <span class="bp-status @(partner.IsActive ? "" : "bp-status-off")">
                                            <span class="bp-dot" aria-hidden="true"></span>
                                            @(partner.IsActive ? "Active" : "Inactive")
                                        </span>
                                    </span>
                                    <span class="bp-actions" role="cell">
                                        <button type="button" class="bp-icon-btn" title="Open @cardCode"
                                                aria-label="Open @cardCode" @onclick="() => ViewCustomer(partner)"
                                                @onclick:stopPropagation>
                                            <svg width="15" height="15" viewBox="0 0 24 24" fill="none"
                                                 stroke="currentColor" stroke-width="1.6" stroke-linecap="round"
                                                 aria-hidden="true">
                                                <path d="M2 12s3.6-6 10-6 10 6 10 6-3.6 6-10 6-10-6-10-6z"></path>
                                                <circle cx="12" cy="12" r="2.6"></circle>
                                            </svg>
                                        </button>
                                        <button type="button" class="bp-icon-btn" title="Invoices for @cardCode"
                                                aria-label="Invoices for @cardCode" @onclick="() => NavigateToInvoices(cardCode)"
                                                @onclick:stopPropagation>
                                            <svg width="15" height="15" viewBox="0 0 24 24" fill="none"
                                                 stroke="currentColor" stroke-width="1.6" stroke-linecap="round"
                                                 stroke-linejoin="round" aria-hidden="true">
                                                <path d="M6 3h12v18l-3-2-3 2-3-2-3 2z"></path>
                                                <path d="M9 8h6M9 12h6"></path>
                                            </svg>
                                        </button>
                                    </span>
                                </div>
                            }
                        </div>
                    </div>

                    <div class="bp-foot">
                        <label class="bp-per">
                            <span>Show</span>
                            <NocturneSelect Class="nsel-sm nsel-up" Options="PageSizeSelectOptions"
                                            @bind-Value="pageSize" OnChanged="ResetPage"
                                            AriaLabel="Rows per page" />
                            <span>per page</span>
                        </label>
                        <div class="bp-pages">
                            <button type="button" class="bp-step" disabled="@(page <= 1)"
                                    @onclick="() => GoToPage(page - 1)">
                                Prev
                            </button>
                            @foreach (var slot in PageSlots(page, PageCount(rows.Count)))
                            {
                                if (slot is null)
                                {
                                    <span class="bp-gap" aria-hidden="true">…</span>
                                }
                                else
                                {
                                    var number = slot.Value;
                                    <button type="button" class="bp-page @(number == page ? "bp-page-on" : "")"
                                            aria-current="@(number == page ? "page" : null)"
                                            aria-label="Page @number" @onclick="() => GoToPage(number)">
                                        @number
                                    </button>
                                }
                            }
                            <button type="button" class="bp-step" disabled="@(page >= PageCount(rows.Count))"
                                    @onclick="() => GoToPage(page + 1)">
                                Next
                            </button>
                        </div>
                    </div>
                }
            </section>
        }
    </div>
</div>

@* The overlay is a peer of the page root rather than a child, so it carries
   .bp-overlay: the sheet pairs that class with .bp everywhere the design system
   is scoped, which is what gets the palette and the control styles down here.
   Neither element may carry .bp itself — its min-height: 100vh would beat the
   drawer's height and push the footer below the fold. *@
@if (selectedCustomer is not null)
{
    var partner = selectedCustomer;
    var cardCode = partner.CardCode ?? string.Empty;
    var balance = partner.Balance ?? 0m;

    <div class="bp-overlay">
        <div class="bp-scrim" @onclick="CloseDrawer"></div>
        <aside class="bp-drawer" role="dialog" aria-modal="true" aria-label="@partner.CardName">
            <div class="bp-drawer-head">
                <div>
                    <h2>@partner.CardName</h2>
                    <div class="bp-drawer-sub">@cardCode · @GetTypeLabel(partner.CardType)</div>
                </div>
                <button type="button" class="bp-icon-btn" style="margin-left:auto" aria-label="Close"
                        @onclick="CloseDrawer">
                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                         stroke-linecap="round" aria-hidden="true">
                        <path d="M6 6l12 12M18 6L6 18"></path>
                    </svg>
                </button>
            </div>

            <div class="bp-drawer-body">

                <section class="bp-section">
                    <h3>Statement</h3>
                    <div class="bp-stmt">
                        @* The label names the field by `for` rather than wrapping it: the date
                           field carries its own calendar button, and a wrapping label would
                           forward a click on that button to the text input as well. *@
                        <div class="bp-field">
                            <label class="bp-label" for="bp-stmt-from">From</label>
                            <NocturneDateField Id="bp-stmt-from" @bind-Date="statementFromDate" />
                        </div>
                        <div class="bp-field">
                            <label class="bp-label" for="bp-stmt-to">To</label>
                            <NocturneDateField Id="bp-stmt-to" @bind-Date="statementToDate" />
                        </div>
                        <button type="button" class="bp-btn bp-btn-primary bp-btn-lg" disabled="@isGeneratingStatement"
                                @onclick="() => GenerateStatement(cardCode)">
                            @if (isGeneratingStatement)
                            {
                                <span class="bp-spin" aria-hidden="true"></span>
                                <span>Generating&#8230;</span>
                            }
                            else
                            {
                                <span>Generate PDF</span>
                            }
                        </button>
                    </div>
                </section>

                <section class="bp-section">
                    <h3>General</h3>
                    <div class="bp-dl">
                        <div>
                            <div class="bp-dt">Code</div>
                            <div class="bp-dd bp-dd-num">@cardCode</div>
                        </div>
                        <div>
                            <div class="bp-dt">Group code</div>
                            <div class="bp-dd">@Dash(partner.GroupCode)</div>
                        </div>
                        <div>
                            <div class="bp-dt">Type</div>
                            <div class="bp-dd">@GetTypeLabel(partner.CardType)</div>
                        </div>
                        <div>
                            <div class="bp-dt">Status</div>
                            <div class="bp-dd">
                                <span class="bp-status @(partner.IsActive ? "" : "bp-status-off")">
                                    <span class="bp-dot" aria-hidden="true"></span>
                                    @(partner.IsActive ? "Active" : "Inactive")
                                </span>
                            </div>
                        </div>
                        @if (!string.IsNullOrWhiteSpace(partner.Channel))
                        {
                            <div>
                                <div class="bp-dt">Channel</div>
                                <div class="bp-dd">@partner.Channel</div>
                            </div>
                        }
                        @if (!string.IsNullOrWhiteSpace(partner.PriceListName))
                        {
                            <div>
                                <div class="bp-dt">Price list</div>
                                <div class="bp-dd">@partner.PriceListName</div>
                            </div>
                        }
                    </div>
                </section>

                <section class="bp-section">
                    <h3>Contact</h3>
                    <div class="bp-dl">
                        <div class="bp-dl-wide">
                            <div class="bp-dt">Email</div>
                            <div class="bp-dd">
                                @if (!string.IsNullOrWhiteSpace(partner.Email))
                                {
                                    <a href="mailto:@partner.Email">@partner.Email</a>
                                }
                                else
                                {
                                    <span>—</span>
                                }
                            </div>
                        </div>
                        <div>
                            <div class="bp-dt">Phone 1</div>
                            <div class="bp-dd bp-dd-num">@Dash(partner.Phone1)</div>
                        </div>
                        <div>
                            <div class="bp-dt">Phone 2</div>
                            <div class="bp-dd bp-dd-num">@Dash(partner.Phone2)</div>
                        </div>
                        <div class="bp-dl-wide">
                            <div class="bp-dt">Address</div>
                            <div class="bp-dd">@Dash(partner.Address)</div>
                        </div>
                        <div class="bp-dl-wide">
                            <div class="bp-dt">City / country</div>
                            <div class="bp-dd">@Location(partner)</div>
                        </div>
                    </div>
                </section>

                <section class="bp-section">
                    <h3>Financial</h3>
                    <div class="bp-dl">
                        <div>
                            <div class="bp-dt">Currency</div>
                            <div class="bp-dd">@(partner.Currency ?? "USD")</div>
                        </div>
                        <div>
                            <div class="bp-dt">Balance</div>
                            <div class="bp-dd bp-dd-num @BalanceClass(balance)">@FormatBalance(balance)</div>
                        </div>
                    </div>
                </section>

            </div>

            <div class="bp-drawer-foot">
                <button type="button" class="bp-btn bp-btn-quiet" @onclick="CloseDrawer">Close</button>
                <button type="button" class="bp-btn bp-btn-primary bp-btn-lg" @onclick="() => NavigateToInvoices(cardCode)">
                    View invoices
                </button>
            </div>
        </aside>
    </div>
}
