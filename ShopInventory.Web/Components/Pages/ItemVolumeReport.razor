@page "/reports/item-volume"
@using ShopInventory.Web.Features.Reports.Queries.GetItemVolumeSalesReport
@attribute [Authorize(Roles = "Admin,SalesRep")]
@inherits ItemVolumeReportPageBase
@rendermode InteractiveServer

<PageTitle>Item Volume - Shop Inventory</PageTitle>

@* Nocturne, carried by wwwroot/css/item-volume.css (linked from App.razor) in
   both schemes. The palette and density scale are order-fulfillment.css's,
   unchanged, so this reads as part of the same system as the report it sits
   beside in the nav.

   The volume figure is the point of the page, so it is the first figure and the
   first column everywhere. Quantity is kept next to it rather than dropped,
   because a reader checking a factor needs to see the number it was applied to.

   Items with no factor are called out rather than silently excluded: their
   quantity is real, so a volume total that quietly leaves them out would be
   wrong in a way nothing on screen would explain. *@

<div class="ivx">

    <header class="ivx-head">
        <div class="ivx-shell">
            <div class="ivx-titles">
                <span class="ivx-kicker">Sales analysis</span>
                <div class="ivx-titles-row">
                    <i class="ph ph-drop" aria-hidden="true"></i>
                    <h1 class="ivx-title">Item volume</h1>
                </div>
                <p class="ivx-sub">
                    Quantity invoiced less quantity credited, converted to volume, for the items and business
                    partners you choose.
                </p>
            </div>
            <div class="ivx-head-actions">
                @if (report is not null)
                {
                    <span class="ivx-count">@FormatVolume(report.Summary.NetVolume) net volume</span>
                }
                <button type="button" class="ivx-btn ivx-btn-secondary" @onclick="ExportToExcelAsync"
                        disabled="@(!CanExport)">
                    <i class="ph ph-file-xls" aria-hidden="true"></i>@(isExporting ? "Exporting…" : "Export Excel")
                </button>
            </div>
        </div>
        <div class="ivx-rule"></div>
    </header>

    <div class="ivx-body">

        <nav class="ivx-tabs" aria-label="Report views">
            <a class="ivx-tab is-current" href="/reports/item-volume">
                <i class="ph ph-drop" aria-hidden="true"></i>Item volume
            </a>
            <a class="ivx-tab" href="/reports/customer-revenue">
                <i class="ph ph-currency-dollar" aria-hidden="true"></i>Customer revenue
            </a>
            <AuthorizeView Roles="Admin" Context="conversionsCtx">
                <Authorized>
                    <a class="ivx-tab" href="/reports/volume-conversions">
                        <i class="ph ph-sliders-horizontal" aria-hidden="true"></i>Conversion factors
                    </a>
                </Authorized>
            </AuthorizeView>
        </nav>

        @if (!string.IsNullOrWhiteSpace(errorMessage))
        {
            <div class="ivx-alert" role="alert">
                <i class="ph ph-warning-octagon" aria-hidden="true"></i>
                <div class="ivx-alert-body">@errorMessage</div>
            </div>
        }

        @if (!string.IsNullOrWhiteSpace(optionsWarning))
        {
            <div class="ivx-alert is-info">
                <i class="ph ph-info" aria-hidden="true"></i>
                <div class="ivx-alert-body">@optionsWarning</div>
            </div>
        }

        <section class="ivx-filters">
            <div class="ivx-field" style="width:150px">
                <label for="ivx-from">From</label>
                <NocturneDateField Id="ivx-from" @bind-Date="fromDate" AriaLabel="From date" Disabled="@isLoading" />
            </div>
            <div class="ivx-field" style="width:150px">
                <label for="ivx-to">To</label>
                <NocturneDateField Id="ivx-to" @bind-Date="toDate" AriaLabel="To date" Disabled="@isLoading" />
            </div>
            <div class="ivx-field" style="width:150px">
                <label for="ivx-grouping">Group by</label>
                <div class="ivx-select">
                    <select id="ivx-grouping" class="ivx-input" value="@grouping" @onchange="OnGroupingChanged"
                            disabled="@isLoading">
                        <option value="@ItemVolumeSalesGrouping.Daily">Daily</option>
                        <option value="@ItemVolumeSalesGrouping.Weekly">Weekly</option>
                        <option value="@ItemVolumeSalesGrouping.Monthly">Monthly</option>
                    </select>
                    <span class="ivx-caret" aria-hidden="true"></span>
                </div>
            </div>
            <div class="ivx-field" style="width:240px">
                <label>Business partners</label>
                <IvxMultiSelect Options="accountOptions" Selected="selectedAccounts"
                                SelectedChanged="OnAccountsChanged" Placeholder="Choose partners"
                                Icon="ph-users-three" AriaLabel="Business partners"
                                SearchPlaceholder="Search or type a code"
                                EmptyText="No cached partners" Disabled="@(isLoading || isLoadingOptions)" />
                <span class="ivx-field-hint">Ranges like VAN008-019 are expanded.</span>
            </div>
            <div class="ivx-field" style="width:240px">
                <label>Items</label>
                <IvxMultiSelect Options="itemOptions" Selected="selectedItems" SelectedChanged="OnItemsChanged"
                                Placeholder="All items" Icon="ph-cube" AriaLabel="Items"
                                SearchPlaceholder="Search or type an item code"
                                EmptyText="No cached products" Disabled="@(isLoading || isLoadingOptions)" />
                <span class="ivx-field-hint">Leave empty for every item traded.</span>
            </div>
            <div class="ivx-filter-actions">
                <button type="button" class="ivx-btn ivx-btn-ghost" @onclick="ResetFilters" disabled="@isLoading">
                    Reset
                </button>
                <button type="button" class="ivx-btn ivx-btn-primary" @onclick="RunReportAsync" disabled="@(!CanRun)">
                    <i class="ph ph-arrow-clockwise" aria-hidden="true"></i>@(isLoading ? "Loading…" : PrimaryActionLabel)
                </button>
            </div>
        </section>

        @if (selectedAccounts.Count > 0 || selectedItems.Count > 0)
        {
            <div class="ivx-chips">
                @foreach (var account in selectedAccounts)
                {
                    <span class="ivx-chip"><i class="ph ph-user-circle" aria-hidden="true"></i>@account</span>
                }
                @foreach (var item in selectedItems)
                {
                    <span class="ivx-chip"><i class="ph ph-cube" aria-hidden="true"></i>@item</span>
                }
            </div>
        }

        @if (isLoading)
        {
            <section class="ivx-card">
                <div class="ivx-empty">
                    <div class="ivx-spinner" aria-hidden="true"></div>
                    <strong>Reading invoices and credit notes</strong>
                    <span class="ivx-empty-sub">Both sides of the window come from SAP, so a wide range takes a
                        moment.</span>
                </div>
            </section>
        }
        else if (report is null)
        {
            <section class="ivx-card">
                <div class="ivx-empty">
                    <i class="ph ph-drop" aria-hidden="true"></i>
                    <strong>Ready to run</strong>
                    <span class="ivx-empty-sub">Choose a date range and at least one business partner. Leave the item
                        picker empty to cover everything those partners traded.</span>
                </div>
            </section>
        }
        else
        {
            <section class="ivx-figures">
                <article class="ivx-figure">
                    <span class="ivx-figure-mark"><i class="ph ph-drop" aria-hidden="true"></i></span>
                    <div class="ivx-figure-text">
                        <div class="ivx-figure-value">@FormatVolume(report.Summary.NetVolume)</div>
                        <div class="ivx-figure-label">Net volume</div>
                        <div class="ivx-figure-note">
                            @FormatVolume(report.Summary.InvoicedVolume) invoiced less
                            @FormatVolume(report.Summary.CreditedVolume) credited
                        </div>
                    </div>
                </article>
                <article class="ivx-figure">
                    <span class="ivx-figure-mark is-quiet"><i class="ph ph-package" aria-hidden="true"></i></span>
                    <div class="ivx-figure-text">
                        <div class="ivx-figure-value">@FormatQuantity(report.Summary.NetQuantity)</div>
                        <div class="ivx-figure-label">Net quantity</div>
                        <div class="ivx-figure-note">
                            @FormatQuantity(report.Summary.InvoicedQuantity) invoiced less
                            @FormatQuantity(report.Summary.CreditedQuantity) credited
                        </div>
                    </div>
                </article>
                <article class="ivx-figure">
                    <span class="ivx-figure-mark is-quiet"><i class="ph ph-receipt" aria-hidden="true"></i></span>
                    <div class="ivx-figure-text">
                        <div class="ivx-figure-value">@report.Summary.InvoiceCount.ToString("N0")</div>
                        <div class="ivx-figure-label">Invoices</div>
                        <div class="ivx-figure-note">@report.Summary.CreditNoteCount.ToString("N0") credit notes over
                            @report.Summary.ActiveAccountCount of @report.Summary.RequestedAccountCount partners</div>
                    </div>
                </article>
                <article class="ivx-figure">
                    <span class="ivx-figure-mark @(report.Summary.ItemsWithoutFactorCount > 0 ? "is-warn" : "is-ok")">
                        <i class="ph @(report.Summary.ItemsWithoutFactorCount > 0 ? "ph-warning" : "ph-check-circle")"
                           aria-hidden="true"></i>
                    </span>
                    <div class="ivx-figure-text">
                        <div class="ivx-figure-value @(report.Summary.ItemsWithoutFactorCount > 0 ? "is-warn" : "")">
                            @report.Summary.ItemsWithoutFactorCount.ToString("N0")
                        </div>
                        <div class="ivx-figure-label">Items without a factor</div>
                        <div class="ivx-figure-note">
                            @(report.Summary.ItemsWithoutFactorCount > 0
                                ? $"{FormatQuantity(report.Summary.QuantityWithoutFactor)} units not converted"
                                : $"All {report.Summary.ItemCount:N0} items converted")
                        </div>
                    </div>
                </article>
            </section>

            @if (report.ItemCodesWithoutFactor.Count > 0)
            {
                <div class="ivx-alert is-warn">
                    <i class="ph ph-warning" aria-hidden="true"></i>
                    <div class="ivx-alert-body">
                        <strong>The net volume above is a floor.</strong>
                        @report.ItemCodesWithoutFactor.Count item(s) moved in this window with no conversion factor, so
                        their quantity is not in the volume totals:
                        @string.Join(", ", report.ItemCodesWithoutFactor.Take(24))@(report.ItemCodesWithoutFactor.Count > 24 ? ", …" : "")
                    </div>
                    <AuthorizeView Roles="Admin" Context="fixCtx">
                        <Authorized>
                            <div class="ivx-alert-actions">
                                <a class="ivx-btn ivx-btn-secondary ivx-btn-sm" href="/reports/volume-conversions">
                                    Add factors
                                </a>
                            </div>
                        </Authorized>
                    </AuthorizeView>
                </div>
            }

            <section class="ivx-card">
                <div class="ivx-toolbar">
                    <div class="ivx-toolbar-titles">
                        <h2 class="ivx-toolbar-title">Volume by item</h2>
                        <p class="ivx-toolbar-sub">@FormattedRange · every selected partner combined</p>
                    </div>
                    @if (report.GeneratedAtUtc != default)
                    {
                        <span class="ivx-count">Updated @FormatGeneratedAt()</span>
                    }
                </div>

                @if (report.ItemTotals.Count == 0)
                {
                    <div class="ivx-empty">
                        <i class="ph ph-file-dashed" aria-hidden="true"></i>
                        <strong>Nothing moved in this window</strong>
                        <span class="ivx-empty-sub">Widen the date range, or check the partner and item
                            selection.</span>
                    </div>
                }
                else
                {
                    <div class="ivx-tablewrap">
                        <table class="ivx-table is-wide is-padded">
                            <thead>
                                <tr>
                                    <th>Item</th>
                                    <th class="ivx-num">Factor</th>
                                    <th class="ivx-num">Invoiced qty</th>
                                    <th class="ivx-num">Credited qty</th>
                                    <th class="ivx-num">Net qty</th>
                                    <th class="ivx-num">Net volume</th>
                                    <th class="ivx-num">Net revenue</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in report.ItemTotals)
                                {
                                    <tr>
                                        <td>
                                            <div class="ivx-item">
                                                <span class="ivx-item-name">@item.ItemName</span>
                                                <span class="ivx-item-code">@item.ItemCode</span>
                                            </div>
                                        </td>
                                        <td class="ivx-num">
                                            @if (item.HasVolumeFactor)
                                            {
                                                @FormatFactor(item.VolumeFactor)
                                            }
                                            else
                                            {
                                                <span class="ivx-flag is-warn"><i class="ph ph-warning"
                                                                                  aria-hidden="true"></i>none</span>
                                            }
                                        </td>
                                        <td class="ivx-num">@FormatQuantity(item.InvoicedQuantity)</td>
                                        <td class="ivx-num">
                                            @if (item.CreditedQuantity != 0)
                                            {
                                                <span class="ivx-money is-credit">@FormatQuantity(item.CreditedQuantity)</span>
                                            }
                                            else
                                            {
                                                <span class="ivx-none">—</span>
                                            }
                                        </td>
                                        <td class="ivx-num">@FormatQuantity(item.NetQuantity)</td>
                                        <td class="ivx-num">
                                            <span class="ivx-volume @(item.HasVolumeFactor ? "" : "is-missing")">
                                                @(item.HasVolumeFactor ? FormatVolume(item.NetVolume) : "not converted")
                                            </span>
                                        </td>
                                        <td class="ivx-num ivx-money">@FormatMoney(item.NetRevenueUsd, item.NetRevenueZig)</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </section>

            <section class="ivx-card">
                <div class="ivx-toolbar">
                    <div class="ivx-toolbar-titles">
                        <h2 class="ivx-toolbar-title">By business partner</h2>
                        <p class="ivx-toolbar-sub">Open a partner for the items behind its total.</p>
                    </div>
                    <span class="ivx-count">@ActiveAccounts.Count with activity</span>
                </div>

                @if (ActiveAccounts.Count == 0)
                {
                    <div class="ivx-empty">
                        <i class="ph ph-file-dashed" aria-hidden="true"></i>
                        <strong>No partner activity</strong>
                        <span class="ivx-empty-sub">None of the selected partners invoiced in this window.</span>
                    </div>
                }
                else
                {
                    <div class="ivx-groups">
                        @foreach (var account in ActiveAccounts.OrderByDescending(a => a.NetVolume))
                        {
                            var code = account.CardCode;
                            var isOpen = openAccountCode == code;
                            <div class="ivx-group @(isOpen ? "is-open" : "")">
                                <button type="button" class="ivx-grouphead" @onclick="@(() => ToggleAccount(code))"
                                        aria-expanded="@isOpen">
                                    <span class="ivx-twist" aria-hidden="true">
                                        <svg width="10" height="10" viewBox="0 0 10 10">
                                            <path d="M3 1l4 4-4 4" fill="none" stroke="currentColor" stroke-width="1.5"
                                                  stroke-linecap="round" stroke-linejoin="round" />
                                        </svg>
                                    </span>
                                    <span class="ivx-group-id">
                                        <span class="ivx-group-name">@account.CardName</span>
                                        <span class="ivx-group-code">@account.CardCode</span>
                                    </span>
                                    <span class="ivx-group-figs">
                                        <span class="ivx-kv">
                                            <span class="ivx-kv-label">Net volume</span>
                                            <span class="ivx-kv-value">@FormatVolume(account.NetVolume)</span>
                                        </span>
                                        <span class="ivx-kv">
                                            <span class="ivx-kv-label">Net qty</span>
                                            <span class="ivx-kv-value is-quiet">@FormatQuantity(account.NetQuantity)</span>
                                        </span>
                                        <span class="ivx-kv">
                                            <span class="ivx-kv-label">Credited qty</span>
                                            <span class="ivx-kv-value @(account.CreditedQuantity != 0 ? "is-bad" : "is-quiet")">
                                                @FormatQuantity(account.CreditedQuantity)
                                            </span>
                                        </span>
                                        <span class="ivx-kv">
                                            <span class="ivx-kv-label">Net revenue</span>
                                            <span class="ivx-kv-value is-quiet">@FormatMoney(account.NetRevenueUsd, account.NetRevenueZig)</span>
                                        </span>
                                        @if (account.ItemsWithoutFactorCount > 0)
                                        {
                                            <span class="ivx-kv">
                                                <span class="ivx-kv-label">Unconverted</span>
                                                <span class="ivx-kv-value is-warn">@account.ItemsWithoutFactorCount items</span>
                                            </span>
                                        }
                                    </span>
                                </button>

                                @if (isOpen)
                                {
                                    <div class="ivx-group-body">
                                        <div class="ivx-tablewrap">
                                            <table class="ivx-table">
                                                <thead>
                                                    <tr>
                                                        <th>Item</th>
                                                        <th class="ivx-num">Factor</th>
                                                        <th class="ivx-num">Invoiced qty</th>
                                                        <th class="ivx-num">Credited qty</th>
                                                        <th class="ivx-num">Net qty</th>
                                                        <th class="ivx-num">Net volume</th>
                                                    </tr>
                                                </thead>
                                                <tbody>
                                                    @foreach (var item in account.Items)
                                                    {
                                                        <tr>
                                                            <td>
                                                                <div class="ivx-item">
                                                                    <span class="ivx-item-name">@item.ItemName</span>
                                                                    <span class="ivx-item-code">@item.ItemCode</span>
                                                                </div>
                                                            </td>
                                                            <td class="ivx-num">@FormatFactor(item.VolumeFactor)</td>
                                                            <td class="ivx-num">@FormatQuantity(item.InvoicedQuantity)</td>
                                                            <td class="ivx-num">@FormatQuantity(item.CreditedQuantity)</td>
                                                            <td class="ivx-num">@FormatQuantity(item.NetQuantity)</td>
                                                            <td class="ivx-num">
                                                                <span class="ivx-volume @(item.HasVolumeFactor ? "" : "is-missing")">
                                                                    @(item.HasVolumeFactor ? FormatVolume(item.NetVolume) : "not converted")
                                                                </span>
                                                            </td>
                                                        </tr>
                                                    }
                                                </tbody>
                                            </table>
                                        </div>
                                    </div>
                                }
                            </div>
                        }
                    </div>
                }
            </section>

            <section class="ivx-card">
                <div class="ivx-toolbar">
                    <div class="ivx-toolbar-titles">
                        <h2 class="ivx-toolbar-title">By @GroupingPeriodNoun</h2>
                        <p class="ivx-toolbar-sub">Only @GroupingPeriodNoun with movement are listed.</p>
                    </div>
                </div>

                @if (VisiblePeriods.Count == 0)
                {
                    <div class="ivx-empty">
                        <i class="ph ph-calendar-blank" aria-hidden="true"></i>
                        <strong>No period activity</strong>
                    </div>
                }
                else
                {
                    <div class="ivx-tablewrap">
                        <table class="ivx-table is-padded">
                            <thead>
                                <tr>
                                    <th>Period</th>
                                    <th class="ivx-num">Invoices</th>
                                    <th class="ivx-num">Credit notes</th>
                                    <th class="ivx-num">Net qty</th>
                                    <th class="ivx-num">Net volume</th>
                                    <th class="ivx-num">Net revenue</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var period in VisiblePeriods)
                                {
                                    <tr>
                                        <td>@period.Label</td>
                                        <td class="ivx-num">@period.InvoiceCount</td>
                                        <td class="ivx-num">@period.CreditNoteCount</td>
                                        <td class="ivx-num">@FormatQuantity(period.NetQuantity)</td>
                                        <td class="ivx-num ivx-volume">@FormatVolume(period.NetVolume)</td>
                                        <td class="ivx-num ivx-money">@FormatMoney(period.NetRevenueUsd, period.NetRevenueZig)</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </section>
        }
    </div>
</div>

@code {
    private string? openAccountCode;

    private void ToggleAccount(string cardCode) =>
        openAccountCode = openAccountCode == cardCode ? null : cardCode;

    protected override string ReportName => "Item Volume";
}
