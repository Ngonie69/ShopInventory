@page "/fiscalisation/offline-lease"
@using ShopInventory.Web.Services
@inject IOfflineSigningLeaseService OfflineSigningLeaseService
@inject ILogger<OfflineSigningLease> Logger
@attribute [Authorize(Roles = "Admin")]
@rendermode InteractiveServer

<PageTitle>Offline signing - Shop Inventory</PageTitle>

@* Borrows the settings stylesheet (wwwroot/css/settings.css, linked from App.razor) so this reads as
   part of the same admin surface rather than a page of its own invention. *@

<div class="stg">

    <header class="stg-header">
        <div class="stg-header-inner">
            <div class="stg-header-title">
                <div class="stg-header-title-row">
                    <i class="ph ph-signature"></i>
                    <h1>Offline signing</h1>
                </div>
                <p>Which van may complete sales without signal</p>
            </div>
            <div class="stg-header-actions">
                <button type="button" class="stg-btn" disabled="@isLoading" @onclick="LoadAsync">
                    <i class="ph ph-arrows-clockwise"></i> Refresh
                </button>
            </div>
        </div>
    </header>

    <div class="stg-body stg-body-solo">
        <main class="stg-main">

            @if (!string.IsNullOrEmpty(successMessage))
            {
                <div class="stg-alert stg-alert-success">
                    <i class="ph ph-check-circle"></i>
                    <span>@successMessage</span>
                    <button type="button" class="stg-alert-close" @onclick="() => successMessage = null"><i class="ph ph-x"></i></button>
                </div>
            }

            @if (!string.IsNullOrEmpty(errorMessage))
            {
                <div class="stg-alert stg-alert-error">
                    <i class="ph ph-warning-circle"></i>
                    <span>@errorMessage</span>
                    <button type="button" class="stg-alert-close" @onclick="() => errorMessage = null"><i class="ph ph-x"></i></button>
                </div>
            }

            <section class="stg-card">
                <div class="stg-section-head">
                    <span class="stg-section-icon"><i class="ph ph-info"></i></span>
                    <div class="stg-section-text">
                        <h2>One device, one signer</h2>
                        <p>
                            A fiscal device is a single chain of receipts, each one signed over the one before it.
                            Only the nominated handset can sign into that chain while out of coverage — every other
                            van is refused and told who has it, which is the design working rather than a fault.
                            Vans that are not nominated still trade normally wherever there is signal.
                        </p>
                    </div>
                </div>
            </section>

            @* Registration comes before nomination on the page because it comes before it in fact: a
               device nobody carries has nobody to nominate. *@
            <section class="stg-card">
                <div class="stg-section-head">
                    <span class="stg-section-icon"><i class="ph ph-plus-circle"></i></span>
                    <div class="stg-section-text">
                        <h2>Register a fiscal device</h2>
                        <p>
                            Give a van the ZIMRA device it signs as. The Fiscalisation platform is asked what
                            the device actually is before anything is saved, because the number on its own
                            cannot tell you whether it is a van's device or this server's.
                        </p>
                    </div>
                </div>

                <div class="stg-row">
                    <div class="stg-row-info">
                        <div class="stg-row-label"><span>Device id</span></div>
                        <span class="stg-row-desc">
                            The number ZIMRA registered the device under. It is read from the Fiscalisation
                            platform, not from this application, so a device added there is available here
                            straight away.
                        </span>
                    </div>
                    <div class="stg-row-control">
                        <input id="osl-device-id" class="stg-input" type="number" min="1" step="1"
                               style="max-width:9rem"
                               placeholder="e.g. 7"
                               disabled="@isChecking"
                               value="@deviceIdInput"
                               @onchange="OnDeviceIdChanged" />
                        <button id="osl-check" type="button" class="stg-btn"
                                disabled="@(isChecking || deviceIdInput is not > 0)"
                                @onclick="() => CheckAsync()">
                            @if (isChecking)
                            {
                                <span class="stg-spin"></span><span>Checking…</span>
                            }
                            else
                            {
                                <text><i class="ph ph-magnifying-glass"></i> Check</text>
                            }
                        </button>
                    </div>
                </div>

                <div class="stg-row">
                    <div class="stg-row-info">
                        <div class="stg-row-label"><span>Give it to</span></div>
                        <span class="stg-row-desc">
                            One handset, and only one — the receipt chain has a single writer. A van already
                            carrying another device is shown with it, because giving this one to that van
                            takes the other away.
                        </span>
                    </div>
                    <div class="stg-row-control">
                        <NocturneSelect Class="nsel-block" TValue="string"
                                        Options="HandsetOptions"
                                        Value="@handsetSelection"
                                        ValueChanged="@(value => OnHandsetChanged(value))"
                                        OnChanged="@(() => CheckAsync())"
                                        Disabled="@isChecking"
                                        Caption="Handset to register the device to"
                                        AriaLabel="Handset to register the device to"
                                        Placeholder="Choose a handset" />
                    </div>
                </div>

                @if (preview is not null)
                {
                    <div class="stg-row">
                        <div class="stg-row-info">
                            <div class="stg-row-label"><span>Serial number</span></div>
                            <span class="stg-row-desc">
                                @(string.IsNullOrWhiteSpace(preview.BranchName)
                                    ? "As ZIMRA holds it."
                                    : $"At {preview.BranchName}.")
                                @if (!string.IsNullOrWhiteSpace(preview.TaxPayerName))
                                {
                                    <text> Registered to @preview.TaxPayerName.</text>
                                }
                            </span>
                        </div>
                        <div class="stg-row-control">
                            <span class="stg-tag stg-tag-neutral">@(preview.SerialNumber ?? "Unknown")</span>
                        </div>
                    </div>

                    <div class="stg-row">
                        <div class="stg-row-info">
                            <div class="stg-row-label"><span>Operating mode</span></div>
                            <span class="stg-row-desc">
                                Only an Offline device signs its own receipts. An Online device's sequence
                                belongs to FDMS, which makes it this server's to post on and not a van's.
                            </span>
                        </div>
                        <div class="stg-row-control">
                            <span class="stg-tag @(IsHandsetMode(preview.OperatingMode) ? "stg-tag-neutral" : "stg-tag-danger")">
                                @(preview.OperatingMode ?? "Unknown")
                            </span>
                        </div>
                    </div>

                    <div class="stg-row">
                        <div class="stg-row-info">
                            <div class="stg-row-label"><span>Certificate</span></div>
                            <span class="stg-row-desc">
                                A van out of coverage cannot be told its certificate lapsed, so it is worth
                                knowing here rather than in a dead spot.
                            </span>
                        </div>
                        <div class="stg-row-control">
                            @if (preview.CertificateValidTill is null)
                            {
                                <span class="stg-tag stg-tag-neutral">Unknown</span>
                            }
                            else
                            {
                                <span class="stg-tag @(preview.CertificateDaysRemaining is > 30 ? "stg-tag-neutral" : "stg-tag-danger")">
                                    @preview.CertificateValidTill.Value.ToLocalTime().ToString("dd MMM yyyy")
                                </span>
                            }
                        </div>
                    </div>

                    <div class="stg-row">
                        <div class="stg-row-info">
                            <div class="stg-row-label"><span>Registered to</span></div>
                            <span class="stg-row-desc">
                                The handset that signs as this device today. Only one account may carry it.
                            </span>
                        </div>
                        <div class="stg-row-control">
                            <span class="stg-tag stg-tag-neutral">@(preview.CurrentHolderLabel ?? "Nobody")</span>
                        </div>
                    </div>

                    @foreach (var finding in preview.Findings)
                    {
                        <div class="stg-alert @AlertClass(finding.Severity)">
                            <i class="ph @AlertIcon(finding.Severity)"></i>
                            <span>@finding.Message</span>
                        </div>
                    }

                    @if (registerForceWarning is not null)
                    {
                        <div class="stg-alert stg-alert-warn">
                            <i class="ph ph-warning"></i>
                            <div>
                                <p style="margin:0 0 .5rem">@registerForceWarning</p>
                                <button type="button" class="stg-btn stg-btn-danger"
                                        disabled="@isRegistering"
                                        @onclick="() => RegisterAsync(force: true)">
                                    Move it anyway
                                </button>
                                <button type="button" class="stg-btn" @onclick="() => registerForceWarning = null">
                                    Leave it where it is
                                </button>
                            </div>
                        </div>
                    }

                    <div class="stg-row">
                        <div class="stg-row-info">
                            <div class="stg-row-label"><span>@(preview.CanRelease ? "Release the device" : "Save the registration")</span></div>
                            <span class="stg-row-desc">
                                @if (preview.CanRelease)
                                {
                                    <text>
                                        Takes the device off @preview.CurrentHolderLabel and clears its nomination,
                                        leaving it free to register elsewhere. This is the step that checks whether
                                        that handset is still carrying receipts.
                                    </text>
                                }
                                else
                                {
                                    <text>
                                        The same checks run again on save — a device's mode or certificate can
                                        change between looking and deciding. Nominating the van to sign offline is
                                        the separate step below.
                                    </text>
                                }
                            </span>
                        </div>
                        <div class="stg-row-control">
                            <button id="osl-register" type="button"
                                    class="stg-btn @(preview.CanRelease ? "stg-btn-danger" : "stg-btn-primary")"
                                    disabled="@(isRegistering || !(preview.CanRegister || preview.CanRelease))"
                                    @onclick="() => RegisterAsync(force: false)">
                                @if (isRegistering)
                                {
                                    <span class="stg-spin"></span><span>Saving…</span>
                                }
                                else if (preview.CanRelease)
                                {
                                    <text>Release</text>
                                }
                                else
                                {
                                    <text>Register</text>
                                }
                            </button>
                        </div>
                    </div>
                }
            </section>

            @if (isLoading)
            {
                <div class="stg-pane-loading"><span class="stg-spin"></span><span>Loading offline signing…</span></div>
            }
            else if (devices.Count == 0)
            {
                <section class="stg-card">
                    <div class="stg-section-head">
                        <span class="stg-section-icon"><i class="ph ph-device-mobile-slash"></i></span>
                        <div class="stg-section-text">
                            <h2>No handsets are registered to a fiscal device</h2>
                            <p>
                                Offline signing is nominated per fiscal device, and no active user carries one yet.
                                Until a handset is registered against a device, every van trades online only.
                                Register one above, and it appears here to be nominated.
                            </p>
                        </div>
                    </div>
                </section>
            }
            else
            {
                @foreach (var device in devices)
                {
                    var deviceId = device.Lease.DeviceId;

                    <section class="stg-card">
                        <div class="stg-section-head">
                            <span class="stg-section-icon"><i class="ph ph-receipt"></i></span>
                            <div class="stg-section-text">
                                <h2>Fiscal device @deviceId</h2>
                                <p>@device.Candidates.Count handset(s) registered against this device.</p>
                            </div>
                        </div>

                        <div class="stg-row">
                            <div class="stg-row-info">
                                <div class="stg-row-label"><span>Signing offline</span></div>
                                <span class="stg-row-desc">
                                    @if (device.Lease.HolderUserId is null)
                                    {
                                        <text>
                                            Nobody is nominated, so no van can complete a sale out of coverage on this
                                            device. Safe, but it costs the sales a dead spot would otherwise take.
                                        </text>
                                    }
                                    else
                                    {
                                        <text>Nominated @Moment(device.Lease.AssignedAtUtc)@(string.IsNullOrWhiteSpace(device.Lease.AssignedByName) ? "" : $" by {device.Lease.AssignedByName}").</text>
                                    }
                                </span>
                            </div>
                            <div class="stg-row-control">
                                @if (device.Lease.HolderUserId is null)
                                {
                                    <span class="stg-tag stg-tag-neutral">Nobody</span>
                                }
                                else
                                {
                                    <span class="stg-tag stg-tag-neutral">@device.Lease.HolderLabel</span>
                                }
                            </div>
                        </div>

                        @if (device.Lease.HolderUserId is not null)
                        {
                            <div class="stg-row">
                                <div class="stg-row-info">
                                    <div class="stg-row-label"><span>Receipts still on that handset</span></div>
                                    <span class="stg-row-desc">
                                        Signed receipts it has not yet uploaded. Offline signing cannot move to another
                                        van until this reaches zero, or the receipts still on it are lost from the chain.
                                        @if (device.Lease.HolderLastSeenAtUtc is not null)
                                        {
                                            <text> Last heard from @Moment(device.Lease.HolderLastSeenAtUtc).</text>
                                        }
                                    </span>
                                </div>
                                <div class="stg-row-control">
                                    @* Danger on both "some" and "not reported": each one blocks a handover,
                                       and reading silence as an empty queue is the mistake that forks a chain. *@
                                    @if (device.Lease.HolderPendingSales is null)
                                    {
                                        <span class="stg-tag stg-tag-danger">Not reported</span>
                                    }
                                    else if (device.Lease.HolderPendingSales == 0)
                                    {
                                        <span class="stg-tag stg-tag-neutral">None</span>
                                    }
                                    else
                                    {
                                        <span class="stg-tag stg-tag-danger">@device.Lease.HolderPendingSales waiting</span>
                                    }
                                </div>
                            </div>
                        }

                        <div class="stg-row">
                            <div class="stg-row-info">
                                <div class="stg-row-label"><span>Give it to</span></div>
                                <span class="stg-row-desc">
                                    The van going out of coverage. Changing this refuses every other handset a lease
                                    from its next sync onwards.
                                </span>
                            </div>
                            <div class="stg-row-control">
                                <select class="stg-select"
                                        disabled="@(savingDeviceId == deviceId)"
                                        value="@SelectionFor(deviceId, device.Lease.HolderUserId)"
                                        @onchange="e => OnSelectionChanged(deviceId, e)">
                                    <option value="">Nobody</option>
                                    @foreach (var candidate in device.Candidates)
                                    {
                                        <option value="@candidate.UserId">@candidate.Label</option>
                                    }
                                </select>
                                <button type="button" class="stg-btn stg-btn-primary"
                                        disabled="@(savingDeviceId == deviceId || !HasChange(deviceId, device.Lease.HolderUserId))"
                                        @onclick="() => SaveAsync(deviceId, force: false)">
                                    @if (savingDeviceId == deviceId)
                                    {
                                        <span class="stg-spin"></span><span>Saving…</span>
                                    }
                                    else
                                    {
                                        <text>Save</text>
                                    }
                                </button>
                            </div>
                        </div>

                        @if (pendingForce.TryGetValue(deviceId, out var warning))
                        {
                            @* The one screen in this app where a confirm is not ceremony: the API has already
                               refused, and going ahead loses receipts that exist on a handset somewhere. *@
                            <div class="stg-alert stg-alert-warn">
                                <i class="ph ph-warning"></i>
                                <div>
                                    <p style="margin:0 0 .5rem">@warning</p>
                                    <button type="button" class="stg-btn stg-btn-danger"
                                            disabled="@(savingDeviceId == deviceId)"
                                            @onclick="() => SaveAsync(deviceId, force: true)">
                                        Move it anyway
                                    </button>
                                    <button type="button" class="stg-btn" @onclick="() => CancelForce(deviceId)">
                                        Leave it where it is
                                    </button>
                                </div>
                            </div>
                        }
                    </section>
                }
            }
        </main>
    </div>
</div>

@code {
    private List<FiscalDeviceOfflineLeaseSummaryResponse> devices = [];

    /// <summary>What the office has picked but not yet saved, per device. Empty string means nobody.</summary>
    private readonly Dictionary<int, string> selections = [];

    /// <summary>Devices where the API refused the move and said why, awaiting a deliberate second click.</summary>
    private readonly Dictionary<int, string> pendingForce = [];

    private bool isLoading = true;
    private int? savingDeviceId;
    private string? successMessage;
    private string? errorMessage;

    // --- Registering a device to a handset ---

    /// <summary>Every active van account, and the device each already carries.</summary>
    private List<FiscalDeviceHandsetResponse> handsets = [];

    private int? deviceIdInput;

    /// <summary>The chosen handset's id as text; empty means "release this device".</summary>
    private string handsetSelection = string.Empty;

    /// <summary>What the platform last said about <see cref="deviceIdInput"/>. Null until it is asked.</summary>
    private FiscalDevicePreviewResponse? preview;

    private bool isChecking;
    private bool isRegistering;

    /// <summary>Set when the API refused because the outgoing handset is still carrying receipts.</summary>
    private string? registerForceWarning;

    protected override async Task OnInitializedAsync() => await LoadAsync();

    /// <summary>
    /// The handsets a device can be given to, plus the row that takes it away from everyone.
    /// </summary>
    /// <remarks>
    /// The device a handset already carries goes in the hint rather than the label, because it is the
    /// thing that changes the meaning of choosing that row: picking a van that is already on device 3
    /// takes device 3 off it. Family follows the same fact so it reads before the text does.
    /// </remarks>
    private IEnumerable<INocturneSelectOption<string>> HandsetOptions
    {
        get
        {
            yield return new NocturneSelectOption<string>(
                string.Empty, "Nobody — release this device", "neutral")
            {
                RuleAfter = true,
                IsUnset = true
            };

            foreach (var handset in handsets)
            {
                var carries = handset.FiscalDeviceId is > 0;
                var carriesThisOne = handset.FiscalDeviceId == deviceIdInput;

                yield return new NocturneSelectOption<string>(
                    handset.UserId.ToString(),
                    handset.Label,
                    carries && !carriesThisOne ? "warn" : "good")
                {
                    Hint = carries ? $"device {handset.FiscalDeviceId}" : handset.Role
                };
            }
        }
    }

    private static bool IsHandsetMode(string? mode) =>
        string.Equals(mode?.Trim(), "Offline", StringComparison.OrdinalIgnoreCase);

    private static string AlertClass(string severity) => severity switch
    {
        "Block" => "stg-alert-error",
        "Warn" => "stg-alert-warn",
        _ => "stg-alert-info"
    };

    private static string AlertIcon(string severity) => severity switch
    {
        "Block" => "ph-x-circle",
        "Warn" => "ph-warning",
        _ => "ph-info"
    };

    private async Task OnDeviceIdChanged(ChangeEventArgs args)
    {
        deviceIdInput = int.TryParse(args.Value?.ToString(), out var parsed) && parsed > 0 ? parsed : null;

        // Whatever the platform said was about the previous number.
        preview = null;
        registerForceWarning = null;

        await Task.CompletedTask;
    }

    private async Task OnHandsetChanged(string? value)
    {
        handsetSelection = value ?? string.Empty;
        registerForceWarning = null;

        await Task.CompletedTask;
    }

    /// <summary>Asks the platform what this device is, and what registering it would mean.</summary>
    private async Task CheckAsync()
    {
        if (deviceIdInput is not { } deviceId)
        {
            return;
        }

        isChecking = true;
        errorMessage = null;
        successMessage = null;
        registerForceWarning = null;

        var result = await OfflineSigningLeaseService.PreviewDeviceAsync(deviceId, ChosenHandsetId());

        isChecking = false;

        if (result.Success)
        {
            preview = result.Device;
            return;
        }

        preview = null;
        errorMessage = result.Message;
    }

    private Guid? ChosenHandsetId() =>
        string.IsNullOrWhiteSpace(handsetSelection) ? null : Guid.Parse(handsetSelection);

    private async Task RegisterAsync(bool force)
    {
        if (deviceIdInput is not { } deviceId)
        {
            return;
        }

        isRegistering = true;
        errorMessage = null;
        successMessage = null;

        var handsetId = ChosenHandsetId();
        var result = await OfflineSigningLeaseService.RegisterHandsetAsync(deviceId, handsetId, force);

        isRegistering = false;

        if (result.Success)
        {
            registerForceWarning = null;
            preview = result.Device;

            successMessage = result.Device?.CurrentHolderLabel is { } holder
                ? $"{holder} now signs as fiscal device {deviceId}. Nominate it below to let it trade out of coverage."
                : $"Fiscal device {deviceId} is not registered to any handset now.";

            Logger.LogInformation(
                "Fiscal device {DeviceId} registration changed from the admin screen{Forced}.",
                deviceId,
                force ? " (forced)" : string.Empty);

            // The device list below is built from who carries what, so it has to be re-read.
            await LoadAsync();
            return;
        }

        if (result.NeedsForce)
        {
            registerForceWarning = result.Message;
            return;
        }

        errorMessage = result.Message;
    }

    private async Task LoadAsync()
    {
        isLoading = true;
        pendingForce.Clear();

        // Read together: the registration card needs the handset list whether or not any device exists
        // yet, and an empty overview is the normal state on a fleet that has not registered one.
        var handsetList = await OfflineSigningLeaseService.GetHandsetsAsync();
        handsets = handsetList ?? [];

        var overview = await OfflineSigningLeaseService.GetOverviewAsync();

        if (overview is null)
        {
            errorMessage = "We couldn't read offline signing right now. Please try again.";
            devices = [];
        }
        else
        {
            devices = overview;
            selections.Clear();

            foreach (var device in devices)
            {
                selections[device.Lease.DeviceId] = device.Lease.HolderUserId?.ToString() ?? string.Empty;
            }
        }

        isLoading = false;
    }

    private string SelectionFor(int deviceId, Guid? holderUserId) =>
        selections.TryGetValue(deviceId, out var selected)
            ? selected
            : holderUserId?.ToString() ?? string.Empty;

    private bool HasChange(int deviceId, Guid? holderUserId) =>
        SelectionFor(deviceId, holderUserId) != (holderUserId?.ToString() ?? string.Empty);

    private void OnSelectionChanged(int deviceId, ChangeEventArgs args)
    {
        selections[deviceId] = args.Value?.ToString() ?? string.Empty;

        // A fresh choice supersedes whatever the last refusal was about.
        pendingForce.Remove(deviceId);
    }

    private void CancelForce(int deviceId)
    {
        pendingForce.Remove(deviceId);

        var device = devices.FirstOrDefault(entry => entry.Lease.DeviceId == deviceId);
        selections[deviceId] = device?.Lease.HolderUserId?.ToString() ?? string.Empty;
    }

    private async Task SaveAsync(int deviceId, bool force)
    {
        savingDeviceId = deviceId;
        successMessage = null;
        errorMessage = null;

        var selected = SelectionFor(deviceId, null);
        Guid? holderUserId = string.IsNullOrWhiteSpace(selected) ? null : Guid.Parse(selected);

        var result = await OfflineSigningLeaseService.AssignAsync(deviceId, holderUserId, force);

        savingDeviceId = null;

        if (result.Success)
        {
            pendingForce.Remove(deviceId);

            successMessage = result.Lease?.HolderLabel is null
                ? $"Nobody is signing offline on device {deviceId} now."
                : $"{result.Lease.HolderLabel} is signing offline on device {deviceId} now.";

            Logger.LogInformation(
                "Offline signing on device {DeviceId} changed from the admin screen{Forced}.",
                deviceId,
                force ? " (forced)" : string.Empty);

            await LoadAsync();
            return;
        }

        if (result.NeedsForce)
        {
            // Not an error to dismiss — a question. The message carries the consequence, so it is shown
            // as-is rather than reworded into something reassuring.
            pendingForce[deviceId] = result.Message;
            return;
        }

        errorMessage = result.Message;
    }

    private static string Moment(DateTime? utc) =>
        utc is null ? "at an unknown time" : $"on {utc.Value.ToLocalTime():dd MMM yyyy HH:mm}";
}
