@page "/quotations/create"
@using Microsoft.AspNetCore.Authorization
@using MudBlazor
@attribute [Authorize(Roles = "Admin,Cashier")]
@inject IQuotationService QuotationService
@inject IBusinessPartnerService BusinessPartnerService
@inject IMasterDataCacheService CacheService
@inject IPriceService PriceService
@inject IBusinessPartnerPricingService BusinessPartnerPricingService
@inject NavigationManager NavigationManager
@inject ISnackbar Snackbar
@using ShopInventory.Web.Data
@using ShopInventory.Web.Services
@inject ILogger<CreateQuotation> Logger
@inject IAppSettingsProvider AppSettings
@inject IAuditService AuditService
@rendermode InteractiveServer

<PageTitle>Create Quotation - Shop Inventory</PageTitle>

@* Styles live in wwwroot/css/sales-forms.css (linked from App.razor), shared
   with the other four sales document forms — see that file's header. The sheet
   carries a light and a dark palette and follows the app's theme toggle.

   `is-quote` selects this form's line-editor columns from the sheet: a
   quotation prices VAT per line where the order form picks a warehouse.

   Icon-only controls draw their glyph inline rather than from the Phosphor
   font: the glyph is their whole label, so a font that failed to load would
   leave them reading as dead controls. Icons beside a word keep the font. *@

<div class="sfm is-quote">
    <div class="sfm-accentbar"></div>
    <div class="sfm-shell">

        <!-- ── Breadcrumb strip ───────────────────────────────────────── -->
        <div class="sfm-crumbs">
            <a href="/quotations">Quotations</a>
            <span class="sfm-crumb-sep">/</span>
            <span class="sfm-crumb-now">Create new</span>
            <span class="sfm-spacer"></span>
            <a href="/quotations" class="sfm-btn"><i class="ph ph-arrow-left"></i>Back</a>
        </div>

        <!-- ── Head ───────────────────────────────────────────────────── -->
        <div class="sfm-head">
            <div class="sfm-head-main">
                <h1>Create quotation</h1>
                <p>A priced offer to a customer &middot; convertible to a sales order once accepted</p>
            </div>
            <div class="sfm-stats">
                <div class="sfm-stat">
                    <div class="sfm-stat-k">Lines</div>
                    <div class="sfm-stat-v">@newQuotation.Lines.Count</div>
                </div>
                <div class="sfm-stat">
                    <div class="sfm-stat-k">Subtotal</div>
                    <div class="sfm-stat-v">@CalculateSubTotal().ToString("N2")</div>
                </div>
                <div class="sfm-stat">
                    <div class="sfm-stat-k">VAT</div>
                    <div class="sfm-stat-v is-vat">@CalculateVatAmount().ToString("N2")</div>
                </div>
                <div class="sfm-stat">
                    <div class="sfm-stat-k">Grand total</div>
                    <div class="sfm-stat-v is-total">@CalculateTotal().ToString("N2")</div>
                </div>
            </div>
        </div>

        @if (isLoadingMasterData)
        {
            <div class="sfm-card sfm-loading">
                <span class="sfm-spin"></span>Loading master data&hellip;
            </div>
        }
        else
        {
            <div class="sfm-grid">
                <div class="sfm-main">

                    <!-- ── Customer ───────────────────────────────────── -->
                    <section class="sfm-card">
                        <div class="sfm-card-hd">
                            <i class="ph ph-user-circle"></i>
                            <h2>Customer</h2>
                            <span class="sfm-spacer"></span>
                            <span class="sfm-note">@allBusinessPartners.Count.ToString("N0") cached</span>
                        </div>
                        <div class="sfm-card-bd sfm-fields">
                            @* Not a <label>: the field carries a clear button and a result list, and a
                               label would forward stray clicks on them back to the input. *@
                            <div class="sfm-lab sfm-span2">
                                <span class="sfm-lab-t">Customer <span class="sfm-req">*</span></span>
                                <div class="sfm-combo">
                                    <input class="sfm-input @(createValidationErrors.ContainsKey("Customer") ? "is-bad" : "")"
                                           @bind="bpSearchTerm" @bind:event="oninput"
                                           @onfocus="() => showBPDropdown = true" @onblur="OnBPSearchBlur"
                                           placeholder="Search by code or name&hellip;" autocomplete="off" />
                                    @if (selectedBusinessPartner != null)
                                    {
                                        <button type="button" class="sfm-combo-clear" @onclick="ClearSelectedBP"
                                                title="Clear customer" aria-label="Clear customer">
                                            <i class="ph ph-x"></i>
                                        </button>
                                    }
                                    @if (showBPDropdown)
                                    {
                                        <div class="sfm-drop is-wide">
                                            @if (!filteredBusinessPartners.Any())
                                            {
                                                <div class="sfm-drop-empty">No customers match that search.</div>
                                            }
                                            else
                                            {
                                                @foreach (var bp in filteredBusinessPartners.Take(15))
                                                {
                                                    <button type="button" class="sfm-drop-i"
                                                            @onmousedown:preventDefault="true"
                                                            @onmousedown="() => SelectBusinessPartner(bp)">
                                                        <span>
                                                            <span class="sfm-drop-code">@bp.CardCode</span>
                                                            <span class="sfm-drop-sub">@bp.CardName</span>
                                                        </span>
                                                        @if (!string.IsNullOrEmpty(bp.Currency))
                                                        {
                                                            <span class="sfm-note">@bp.Currency</span>
                                                        }
                                                    </button>
                                                }
                                                @if (filteredBusinessPartners.Count() > 15)
                                                {
                                                    <div class="sfm-drop-empty">
                                                        @filteredBusinessPartners.Count().ToString("N0") match &mdash; type more to narrow.
                                                    </div>
                                                }
                                            }
                                        </div>
                                    }
                                </div>
                                @if (createValidationErrors.ContainsKey("Customer"))
                                {
                                    <div class="sfm-field-err">@createValidationErrors["Customer"]</div>
                                }
                            </div>

                            @if (selectedBusinessPartner != null)
                            {
                                <div class="sfm-lab sfm-span2">
                                    <span class="sfm-lab-t">Selected</span>
                                    <div class="sfm-field-meta">
                                        <i class="ph-fill ph-check-circle"></i>@selectedBusinessPartner.CardCode
                                        &mdash; @selectedBusinessPartner.CardName
                                        @if (!string.IsNullOrWhiteSpace(selectedBusinessPartner.Phone1))
                                        {
                                            <span> &middot; @selectedBusinessPartner.Phone1</span>
                                        }
                                        @if (!string.IsNullOrWhiteSpace(selectedBusinessPartner.Currency))
                                        {
                                            <span> &middot; @selectedBusinessPartner.Currency</span>
                                        }
                                    </div>
                                </div>
                            }
                        </div>
                    </section>

                    <!-- ── Quotation details ──────────────────────────── -->
                    <section class="sfm-card">
                        <div class="sfm-card-hd">
                            <i class="ph ph-info"></i>
                            <h2>Quotation details</h2>
                        </div>
                        <div class="sfm-card-bd sfm-fields">
                            <label class="sfm-lab">
                                @* A native date input rather than MudDatePicker: it themes from this
                                   sheet, and opens the platform picker. It shows the operator's own
                                   locale format, not AppSettings.DateFormat — the browser owns that. *@
                                <span class="sfm-lab-t">Valid until</span>
                                <input type="date" class="sfm-input" @bind="validUntilDate" />
                            </label>
                            <label class="sfm-lab">
                                <span class="sfm-lab-t">Currency <span class="sfm-req">*</span></span>
                                <select class="sfm-select @(createValidationErrors.ContainsKey("Currency") ? "is-bad" : "")"
                                        @bind="newQuotation.Currency">
                                    <option value="">Select&hellip;</option>
                                    <option value="USD">USD</option>
                                    <option value="ZIG">ZIG</option>
                                    <option value="ZAR">ZAR</option>
                                    <option value="BWP">BWP</option>
                                    <option value="EUR">EUR</option>
                                    <option value="GBP">GBP</option>
                                </select>
                                @if (createValidationErrors.ContainsKey("Currency"))
                                {
                                    <div class="sfm-field-err">@createValidationErrors["Currency"]</div>
                                }
                            </label>
                            <label class="sfm-lab">
                                <span class="sfm-lab-t">Contact person</span>
                                <input class="sfm-input" @bind="newQuotation.ContactPerson" placeholder="Contact name" />
                            </label>
                            <label class="sfm-lab">
                                <span class="sfm-lab-t">Customer reference</span>
                                <input class="sfm-input" @bind="newQuotation.CustomerRefNo" placeholder="Reference number" />
                            </label>
                            <label class="sfm-lab">
                                <span class="sfm-lab-t">Header discount %</span>
                                <input type="number" min="0" max="100" step="0.1" class="sfm-input"
                                       @bind="newQuotation.DiscountPercent" />
                            </label>
                            <label class="sfm-lab sfm-span3">
                                <span class="sfm-lab-t">Ship / bill address</span>
                                <input class="sfm-input" value="@GetSelectedAddress()"
                                       placeholder="Select a customer to populate" readonly />
                            </label>
                            <label class="sfm-lab sfm-span2">
                                <span class="sfm-lab-t">Comments</span>
                                <input class="sfm-input" @bind="newQuotation.Comments" placeholder="Additional notes" />
                            </label>
                            <label class="sfm-lab sfm-span2">
                                <span class="sfm-lab-t">Terms &amp; conditions</span>
                                <input class="sfm-input" @bind="newQuotation.TermsAndConditions"
                                       placeholder="Payment terms, delivery terms&hellip;" />
                            </label>
                        </div>
                    </section>

                    <!-- ── Lines ──────────────────────────────────────── -->
                    <section class="sfm-card">
                        <div class="sfm-card-hd">
                            <i class="ph ph-list-bullets"></i>
                            <h2>Line items</h2>
                            <span class="sfm-spacer"></span>
                            <span class="sfm-count">@newQuotation.Lines.Count</span>
                        </div>
                        <div class="sfm-lines @(IsAnyPickerOpen ? "is-picking" : "")">
                            <div class="sfm-lines-inner">
                                @if (!newQuotation.Lines.Any())
                                {
                                    <button type="button" class="sfm-addline" @onclick="AddLineItem">
                                        <i class="ph ph-plus"></i>Add the first line
                                    </button>
                                }
                                else
                                {
                                    <div class="sfm-row is-head">
                                        <div>#</div>
                                        <div>Item</div>
                                        <div>Description</div>
                                        <div class="sfm-r">Qty</div>
                                        <div class="sfm-r">Unit price</div>
                                        <div class="sfm-r">Disc %</div>
                                        <div class="sfm-r">VAT %</div>
                                        <div class="sfm-r">Total</div>
                                        <div></div>
                                    </div>

                                    @for (int i = 0; i < newQuotation.Lines.Count; i++)
                                    {
                                        var index = i;
                                        var line = newQuotation.Lines[index];
                                        var lineState = GetLineState(index);
                                        var lineErrors = GetLineValidationErrors(index);

                                        <div class="sfm-row">
                                            <div class="sfm-n">@(index + 1)</div>
                                            <div class="sfm-combo">
                                                <input class="sfm-input sfm-cell @(lineErrors.ContainsKey("ItemCode") ? "is-bad" : "")"
                                                       value="@line.ItemCode"
                                                       @oninput="e => OnItemCodeInput(index, e.Value?.ToString())"
                                                       @onkeydown="e => OnItemCodeKeyDown(index, e)"
                                                       @onfocus="() => OnItemCodeFocus(index)"
                                                       @onblur="() => OnItemCodeBlur(index)"
                                                       placeholder="Search&hellip;" autocomplete="off" />
                                                @if (lineState.ShowProductDropdown && lineState.FilteredProducts.Any())
                                                {
                                                    <div class="sfm-drop is-wide">
                                                        @foreach (var product in lineState.FilteredProducts.Take(10))
                                                        {
                                                            var isCustomerPrice = HasSpecialPrice(product.ItemCode);
                                                            <button type="button"
                                                                    class="sfm-drop-i @(lineState.SuggestedProduct == product ? "is-sel" : "")"
                                                                    @onmousedown:preventDefault="true"
                                                                    @onmousedown="async () => await SelectProduct(index, product)">
                                                                <span>
                                                                    <span class="sfm-drop-code">@product.ItemCode</span>
                                                                    <span class="sfm-drop-sub">@TruncateName(product.ItemName, 30)</span>
                                                                </span>
                                                                <span class="sfm-drop-price @(isCustomerPrice ? "is-customer" : "")">
                                                                    @GetDisplayPrice(product).ToString("N2")
                                                                </span>
                                                            </button>
                                                        }
                                                        @if (lineState.FilteredProducts.Count > 10)
                                                        {
                                                            <div class="sfm-drop-empty">
                                                                @(lineState.FilteredProducts.Count - 10) more &mdash; type to narrow.
                                                            </div>
                                                        }
                                                    </div>
                                                }
                                            </div>
                                            <input class="sfm-input sfm-desc" value="@line.ItemDescription"
                                                   placeholder="Select an item" readonly />
                                            <input type="number" min="0.0001" step="1"
                                                   class="sfm-input sfm-num @(lineErrors.ContainsKey("Quantity") ? "is-bad" : "")"
                                                   value="@line.Quantity"
                                                   @onchange="e => OnQuantityChange(index, e.Value?.ToString())" />
                                            <input type="number" min="0" step="0.01"
                                                   class="sfm-input sfm-num @(lineErrors.ContainsKey("UnitPrice") ? "is-bad" : "")"
                                                   value="@line.UnitPrice"
                                                   @onchange="e => OnUnitPriceChange(index, e.Value?.ToString())" />
                                            @* step matches SAP's six-decimal discounts so a special price like 5.714286% is not flagged as invalid *@
                                            <input type="number" min="0" max="100" step="0.000001"
                                                   class="sfm-input sfm-num" @bind="line.DiscountPercent" />
                                            <input type="number" min="0" max="100" step="0.1"
                                                   class="sfm-input sfm-num" @bind="line.TaxPercent" />
                                            <div class="sfm-r">
                                                <div class="sfm-amt-v">@CalculateLineTotal(line).ToString("N2")</div>
                                                @if (HasSpecialPrice(line.ItemCode))
                                                {
                                                    <div class="sfm-amt-x">Special price</div>
                                                }
                                            </div>
                                            @* The glyph is drawn inline, not set in the icon font: it is this
                                               button's only label, so a font that fails to load would leave an
                                               empty square that reads as a broken control. *@
                                            <button type="button" class="sfm-btn-x" title="Remove line"
                                                    aria-label="Remove line @(index + 1)"
                                                    @onclick="() => RemoveLineItem(index)">
                                                <svg viewBox="0 0 256 256" aria-hidden="true" focusable="false">
                                                    <path d="M205.66,194.34a8,8,0,0,1-11.32,11.32L128,139.31,61.66,205.66a8,8,0,0,1-11.32-11.32L116.69,128,50.34,61.66A8,8,0,0,1,61.66,50.34L128,116.69l66.34-66.35a8,8,0,0,1,11.32,11.32L139.31,128Z" />
                                                </svg>
                                            </button>
                                            @if (lineErrors.Any())
                                            {
                                                <div class="sfm-row-err">@string.Join(" · ", lineErrors.Values)</div>
                                            }
                                        </div>
                                    }

                                    <button type="button" class="sfm-addline" @onclick="AddLineItem">
                                        <i class="ph ph-plus"></i>Add another line
                                    </button>
                                }
                            </div>
                        </div>
                    </section>
                </div>

                <!-- ── Aside ──────────────────────────────────────────── -->
                <aside class="sfm-aside">
                    <div class="sfm-card sfm-total-card">
                        <div class="sfm-total-hd">
                            <span class="sfm-total-k">Grand total</span>
                            <span class="sfm-total-cur">
                                @(string.IsNullOrWhiteSpace(newQuotation.Currency) ? "No currency" : newQuotation.Currency)
                            </span>
                        </div>
                        <div class="sfm-total-v">@CalculateTotal().ToString("N2")</div>
                        <div class="sfm-total-sub">
                            @newQuotation.Lines.Count line(s) &middot; subtotal @CalculateSubTotal().ToString("N2")
                        </div>
                        <div class="sfm-total-sub">
                            Header discount @newQuotation.DiscountPercent.ToString("N1")%
                            = @CalculateHeaderDiscountAmount().ToString("N2")
                        </div>
                        <div class="sfm-total-sub">VAT @CalculateVatAmount().ToString("N2")</div>

                        @if (createValidationErrors.Any() || lineValidationErrors.Any())
                        {
                            <div class="sfm-err-panel">
                                <div class="sfm-err-panel-t">
                                    <i class="ph ph-warning"></i>Please fix the following
                                </div>
                                <ul>
                                    @foreach (var error in createValidationErrors.Values)
                                    {
                                        <li>@error</li>
                                    }
                                    @foreach (var lineError in lineValidationErrors)
                                    {
                                        @foreach (var error in lineError.Value.Values)
                                        {
                                            <li>Line @(lineError.Key + 1): @error</li>
                                        }
                                    }
                                </ul>
                            </div>
                        }

                        @* Submit is never disabled by validity: a greyed-out button states that
                           something is wrong without saying what. Clicking always explains. Same
                           rule as the two transfer forms. *@
                        <button type="button" class="sfm-btn-solid" @onclick="CreateQuotationAsync" disabled="@isCreating">
                            @if (isCreating)
                            {
                                <span class="sfm-spin on-solid"></span>
                                <span>Creating&hellip;</span>
                            }
                            else
                            {
                                <i class="ph-fill ph-check-circle"></i>
                                <span>Create quotation</span>
                            }
                        </button>
                        <a href="/quotations" class="sfm-btn sfm-btn-wide sfm-gap-sm">Cancel</a>
                    </div>

                    <div class="sfm-card sfm-panel">
                        <div class="sfm-card-hd">
                            <i class="ph ph-shield-check"></i>
                            <span class="sfm-panel-t">Pre-flight checks</span>
                            <span class="sfm-spacer"></span>
                            <span class="sfm-note">@PassedCheckCount/3</span>
                        </div>
                        <div class="sfm-checks">
                            <div class="sfm-checks-i @(HasCustomer ? "" : "is-no")">
                                <span class="sfm-checks-ic"><i class="ph-fill @(HasCustomer ? "ph-check" : "ph-x")"></i></span>
                                <span>Customer selected</span>
                            </div>
                            <div class="sfm-checks-i @(HasCurrency ? "" : "is-no")">
                                <span class="sfm-checks-ic"><i class="ph-fill @(HasCurrency ? "ph-check" : "ph-x")"></i></span>
                                <span>Currency chosen</span>
                            </div>
                            <div class="sfm-checks-i @(LinesComplete ? "" : "is-no")">
                                <span class="sfm-checks-ic"><i class="ph-fill @(LinesComplete ? "ph-check" : "ph-x")"></i></span>
                                <span>All lines complete</span>
                            </div>
                        </div>
                    </div>

                    <div class="sfm-card sfm-panel">
                        <div class="sfm-card-hd">
                            <i class="ph ph-database"></i>
                            <span class="sfm-panel-t">Cached data</span>
                        </div>
                        <div class="sfm-cache">
                            <div class="sfm-cache-i"><i class="ph ph-users"></i>@allBusinessPartners.Count.ToString("N0") customers</div>
                            <div class="sfm-cache-i"><i class="ph ph-cube"></i>@cachedProducts.Count.ToString("N0") products</div>
                        </div>
                    </div>
                </aside>
            </div>
        }
    </div>
</div>

@code {
    private const decimal DefaultVatPercent = 15.5m;

    private CreateQuotationRequest newQuotation = new()
    {
        Currency = string.Empty
    };
    private DateTime? validUntilDate;
    private bool isCreating = false;
    private bool isLoadingMasterData = true;

    private List<BusinessPartnerDto> allBusinessPartners = new();
    private List<ProductDto> cachedProducts = new();
    private BusinessPartnerDto? selectedBusinessPartner;
    private Dictionary<string, ResolvedItemPrice> customerPricing = new(StringComparer.OrdinalIgnoreCase);
    private int? customerPriceListNum;
    private string? bpSearchTerm;
    private bool showBPDropdown = false;

    private Dictionary<int, LineState> lineStates = new();
    private Dictionary<string, string> createValidationErrors = new();
    private Dictionary<int, Dictionary<string, string>> lineValidationErrors = new();

    private sealed class LineState
    {
        public string SearchTerm { get; set; } = string.Empty;
        public bool ShowProductDropdown { get; set; }
        public List<ProductDto> FilteredProducts { get; set; } = new();
        public ProductDto? SuggestedProduct { get; set; }
        public string SuggestionSuffix { get; set; } = string.Empty;
    }

    // ── Pre-flight checks ───────────────────────────────
    // Stated in the aside so the operator sees what is still missing before
    // pressing Create, rather than after the round trip.

    private bool HasCustomer => selectedBusinessPartner != null
        && !string.IsNullOrEmpty(newQuotation.CardCode);

    private bool HasCurrency => !string.IsNullOrWhiteSpace(newQuotation.Currency);

    private bool LinesComplete => newQuotation.Lines.Any()
        && newQuotation.Lines.All(l => !string.IsNullOrWhiteSpace(l.ItemCode) && l.Quantity > 0);

    private int PassedCheckCount =>
        (HasCustomer ? 1 : 0) + (HasCurrency ? 1 : 0) + (LinesComplete ? 1 : 0);

    // The line scroller clips vertically as well as horizontally, which would cut
    // an open item picker off at the bottom of the table; the clip is lifted while
    // one is open. See .sfm-lines.is-picking.
    private bool IsAnyPickerOpen => lineStates.Values.Any(s => s.ShowProductDropdown);

    private IEnumerable<BusinessPartnerDto> filteredBusinessPartners
    {
        get
        {
            if (string.IsNullOrWhiteSpace(bpSearchTerm))
            {
                return allBusinessPartners.Take(50);
            }

            var search = bpSearchTerm.ToLowerInvariant();
            return allBusinessPartners.Where(bp =>
                (bp.CardCode?.ToLowerInvariant().Contains(search) ?? false) ||
                (bp.CardName?.ToLowerInvariant().Contains(search) ?? false));
        }
    }

    protected override async Task OnInitializedAsync()
    {
        validUntilDate = DateTime.UtcNow.AddDays(30);
        await LoadMasterData();
    }

    private async Task LoadMasterData()
    {
        isLoadingMasterData = true;

        try
        {
            var response = await BusinessPartnerService.GetBusinessPartnersAsync();
            allBusinessPartners = response?.BusinessPartners?.Where(bp => bp.CardType == "cCustomer").ToList() ?? new();
            cachedProducts = await CacheService.GetProductsAsync();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error loading master data for quotation creation");
        }
        finally
        {
            isLoadingMasterData = false;
        }
    }

    private async Task SelectBusinessPartnerAsync(BusinessPartnerDto bp)
    {
        selectedBusinessPartner = bp;
        newQuotation.CardCode = bp.CardCode ?? string.Empty;
        newQuotation.CardName = bp.CardName;
        newQuotation.ShipToAddress = bp.Address;
        newQuotation.BillToAddress = bp.Address;
        bpSearchTerm = $"{bp.CardCode} - {bp.CardName}";
        showBPDropdown = false;

        createValidationErrors.Remove("Customer");

        if (!string.IsNullOrWhiteSpace(bp.Currency))
        {
            newQuotation.Currency = bp.Currency.Trim().ToUpperInvariant();
            createValidationErrors.Remove("Currency");
        }

        await LoadBusinessPartnerPricesAsync(bp);
        UpdateExistingLinePrices();
    }

    private void SelectBusinessPartner(BusinessPartnerDto bp)
    {
        _ = SelectBusinessPartnerAsync(bp);
    }

    private void ClearSelectedBP()
    {
        selectedBusinessPartner = null;
        newQuotation.CardCode = string.Empty;
        newQuotation.CardName = null;
        newQuotation.ShipToAddress = null;
        newQuotation.BillToAddress = null;
        bpSearchTerm = null;
        customerPricing.Clear();
        customerPriceListNum = null;
        UpdateExistingLinePrices();
    }

    private async Task OnBPSearchBlur()
    {
        await Task.Delay(200);
        showBPDropdown = false;
    }

    private void AddLineItem()
    {
        newQuotation.Lines.Add(new CreateQuotationLineRequest
        {
            Quantity = 1,
            UnitPrice = 0,
            TaxPercent = DefaultVatPercent
        });
        createValidationErrors.Remove("Lines");
    }

    private void RemoveLineItem(int index)
    {
        if (index < 0 || index >= newQuotation.Lines.Count)
        {
            return;
        }

        newQuotation.Lines.RemoveAt(index);
        lineStates.Remove(index);
        lineValidationErrors.Remove(index);

        var oldStates = new Dictionary<int, LineState>(lineStates);
        var oldErrors = new Dictionary<int, Dictionary<string, string>>(lineValidationErrors);
        lineStates.Clear();
        lineValidationErrors.Clear();

        for (int i = 0; i < newQuotation.Lines.Count; i++)
        {
            var oldIndex = i >= index ? i + 1 : i;
            if (oldStates.TryGetValue(oldIndex, out var state))
            {
                lineStates[i] = state;
            }
            if (oldErrors.TryGetValue(oldIndex, out var errors))
            {
                lineValidationErrors[i] = errors;
            }
        }
    }

    private LineState GetLineState(int index)
    {
        if (!lineStates.ContainsKey(index))
        {
            lineStates[index] = new LineState();
        }

        return lineStates[index];
    }

    private Dictionary<string, string> GetLineValidationErrors(int index)
    {
        return lineValidationErrors.TryGetValue(index, out var errors)
            ? errors
            : new Dictionary<string, string>();
    }

    private void UpdateExistingLinePrices()
    {
        foreach (var line in newQuotation.Lines)
        {
            if (!string.IsNullOrWhiteSpace(line.ItemCode))
            {
                var product = cachedProducts.FirstOrDefault(p =>
                    string.Equals(p.ItemCode, line.ItemCode, StringComparison.OrdinalIgnoreCase));
                var defaultPrice = product?.Price ?? line.UnitPrice;
                ApplyPricing(line, GetPricingForItem(line.ItemCode, defaultPrice));
            }
        }
    }

    private async Task LoadBusinessPartnerPricesAsync(BusinessPartnerDto bp)
    {
        try
        {
            var lookup = await BusinessPartnerPricingService.LoadPriceLookupAsync(bp);
            customerPricing = lookup.Pricing;
            customerPriceListNum = lookup.PriceListNum;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error loading quotation prices for {CardCode}", bp.CardCode);
            customerPricing.Clear();
            customerPriceListNum = null;
        }
    }

    private ResolvedItemPrice GetPricingForItem(string? itemCode, decimal defaultPrice)
    {
        if (string.IsNullOrEmpty(itemCode))
        {
            return ResolvedItemPrice.Flat(defaultPrice);
        }

        return customerPricing.TryGetValue(itemCode, out var customerPrice)
            ? customerPrice
            : ResolvedItemPrice.Flat(defaultPrice);
    }

    /// <summary>
    /// Shows a customer's special price the way SAP does - the price list price in Unit Price and the
    /// gap in Discount % - rather than collapsing both into a net price with an empty discount.
    /// </summary>
    private static void ApplyPricing(CreateQuotationLineRequest line, ResolvedItemPrice pricing)
    {
        line.UnitPrice = pricing.UnitPrice;
        line.DiscountPercent = pricing.DiscountPercent;
    }

    private bool HasSpecialPrice(string? itemCode)
        => !string.IsNullOrEmpty(itemCode)
            && customerPricing.TryGetValue(itemCode, out var pricing)
            && pricing.DiscountPercent > 0;

    private void OnItemCodeInput(int index, string? value)
    {
        var line = newQuotation.Lines[index];
        line.ItemCode = value ?? string.Empty;

        var state = GetLineState(index);
        state.SearchTerm = value ?? string.Empty;
        state.SuggestedProduct = null;
        state.SuggestionSuffix = string.Empty;

        if (lineValidationErrors.TryGetValue(index, out var errors))
        {
            errors.Remove("ItemCode");
        }

        if (string.IsNullOrWhiteSpace(value))
        {
            line.ItemDescription = string.Empty;
            state.FilteredProducts = new List<ProductDto>();
            state.ShowProductDropdown = false;
            return;
        }

        var searchLower = value.ToLowerInvariant();
        var searchUpper = value.ToUpperInvariant();

        state.FilteredProducts = cachedProducts.Where(product =>
            (product.ItemCode?.ToUpperInvariant().StartsWith(searchUpper) ?? false) ||
            (product.ItemCode?.ToLowerInvariant().Contains(searchLower) ?? false) ||
            (product.ItemName?.ToLowerInvariant().Contains(searchLower) ?? false) ||
            (product.BarCode?.ToLowerInvariant().Contains(searchLower) ?? false))
            .OrderByDescending(product => product.ItemCode?.ToUpperInvariant().StartsWith(searchUpper) ?? false)
            .ThenBy(product => product.ItemCode)
            .ToList();

        var exactMatch = state.FilteredProducts.FirstOrDefault(product =>
            product.ItemCode?.ToUpperInvariant().StartsWith(searchUpper) ?? false);

        if (exactMatch != null && !string.IsNullOrEmpty(exactMatch.ItemCode))
        {
            state.SuggestedProduct = exactMatch;
            state.SuggestionSuffix = exactMatch.ItemCode.Substring(value.Length);
        }

        state.ShowProductDropdown = state.FilteredProducts.Any();
        StateHasChanged();
    }

    private async Task OnItemCodeKeyDown(int index, KeyboardEventArgs e)
    {
        var state = GetLineState(index);

        if ((e.Key == "Tab" || e.Key == "ArrowRight") && state.SuggestedProduct != null)
        {
            if (e.Key == "Tab" || !string.IsNullOrEmpty(state.SuggestionSuffix))
            {
                await SelectProduct(index, state.SuggestedProduct);
            }
        }
        else if (e.Key == "ArrowDown" && state.ShowProductDropdown && state.FilteredProducts.Any())
        {
            var currentIndex = state.SuggestedProduct != null ? state.FilteredProducts.IndexOf(state.SuggestedProduct) : -1;
            var nextIndex = Math.Min(currentIndex + 1, state.FilteredProducts.Count - 1);
            state.SuggestedProduct = state.FilteredProducts[nextIndex];
            StateHasChanged();
        }
        else if (e.Key == "ArrowUp" && state.ShowProductDropdown && state.FilteredProducts.Any())
        {
            var currentIndex = state.SuggestedProduct != null ? state.FilteredProducts.IndexOf(state.SuggestedProduct) : state.FilteredProducts.Count;
            var previousIndex = Math.Max(currentIndex - 1, 0);
            state.SuggestedProduct = state.FilteredProducts[previousIndex];
            StateHasChanged();
        }
        else if (e.Key == "Enter" && state.SuggestedProduct != null)
        {
            await SelectProduct(index, state.SuggestedProduct);
        }
        else if (e.Key == "Escape")
        {
            state.ShowProductDropdown = false;
            state.SuggestedProduct = null;
            state.SuggestionSuffix = string.Empty;
            StateHasChanged();
        }
    }

    private void OnItemCodeFocus(int index)
    {
        var state = GetLineState(index);
        if (!string.IsNullOrEmpty(state.SearchTerm) || cachedProducts.Any())
        {
            state.ShowProductDropdown = true;
            if (string.IsNullOrEmpty(state.SearchTerm))
            {
                state.FilteredProducts = cachedProducts.Take(15).ToList();
            }
        }
    }

    private async Task OnItemCodeBlur(int index)
    {
        await Task.Delay(200);
        var state = GetLineState(index);
        state.ShowProductDropdown = false;
        state.SuggestionSuffix = string.Empty;
        StateHasChanged();
    }

    private async Task SelectProduct(int index, ProductDto product)
    {
        var line = newQuotation.Lines[index];
        line.ItemCode = product.ItemCode ?? string.Empty;
        line.ItemDescription = product.ItemName ?? string.Empty;
        line.UoMCode = product.UoM;
        ApplyPricing(line, GetPricingForItem(product.ItemCode, product.Price));

        if (!string.IsNullOrEmpty(product.ItemCode))
        {
            try
            {
                var pricing = await BusinessPartnerPricingService.ResolveItemPriceAsync(
                    product.ItemCode,
                    newQuotation.Currency,
                    product.Price,
                    newQuotation.CardCode,
                    customerPriceListNum,
                    customerPricing);

                ApplyPricing(line, pricing);
            }
            catch (Exception ex)
            {
                Logger.LogWarning(ex, "Failed to resolve BP-aware quotation price for item {ItemCode}", product.ItemCode);
            }
        }

        var state = GetLineState(index);
        state.ShowProductDropdown = false;
        state.SearchTerm = product.ItemCode ?? string.Empty;
        state.SuggestedProduct = null;
        state.SuggestionSuffix = string.Empty;

        if (lineValidationErrors.TryGetValue(index, out var errors))
        {
            errors.Remove("ItemCode");
            if (line.UnitPrice > 0)
            {
                errors.Remove("UnitPrice");
            }
        }

        StateHasChanged();
    }

    private void OnQuantityChange(int index, string? value)
    {
        var line = newQuotation.Lines[index];
        if (decimal.TryParse(value, out var quantity))
        {
            line.Quantity = quantity < 0 ? 0 : quantity;
        }
        else
        {
            line.Quantity = 0;
        }

        if (lineValidationErrors.TryGetValue(index, out var errors))
        {
            errors.Remove("Quantity");
        }

        StateHasChanged();
    }

    private void OnUnitPriceChange(int index, string? value)
    {
        var line = newQuotation.Lines[index];
        if (decimal.TryParse(value, out var unitPrice))
        {
            line.UnitPrice = unitPrice < 0 ? 0 : unitPrice;
        }
        else
        {
            line.UnitPrice = 0;
        }

        if (lineValidationErrors.TryGetValue(index, out var errors) && line.UnitPrice > 0)
        {
            errors.Remove("UnitPrice");
        }

        StateHasChanged();
    }

    private decimal GetDisplayPrice(ProductDto product)
    {
        return GetPricingForItem(product.ItemCode, product.Price).NetPrice;
    }

    private decimal CalculateLineTotal(CreateQuotationLineRequest line)
    {
        var subtotal = line.Quantity * line.UnitPrice;
        return line.DiscountPercent > 0 ? subtotal * (1 - line.DiscountPercent / 100) : subtotal;
    }

    private decimal CalculateSubTotal()
    {
        return newQuotation.Lines.Sum(CalculateLineTotal);
    }

    private decimal CalculateVatAmount()
    {
        return newQuotation.Lines.Sum(line => CalculateLineTotal(line) * line.TaxPercent / 100);
    }

    private decimal CalculateHeaderDiscountAmount()
    {
        return CalculateSubTotal() * newQuotation.DiscountPercent / 100;
    }

    private decimal CalculateTotal()
    {
        return CalculateSubTotal() - CalculateHeaderDiscountAmount() + CalculateVatAmount();
    }

    private string GetSelectedAddress()
    {
        return !string.IsNullOrWhiteSpace(selectedBusinessPartner?.Address)
            ? selectedBusinessPartner.Address
            : string.Empty;
    }

    private string TruncateName(string? name, int maxLength)
    {
        return name?.Length > maxLength ? name[..maxLength] + "..." : name ?? string.Empty;
    }

    private bool ValidateCreateForm()
    {
        createValidationErrors.Clear();
        lineValidationErrors.Clear();

        if (selectedBusinessPartner == null || string.IsNullOrEmpty(newQuotation.CardCode))
        {
            createValidationErrors["Customer"] = "Please select a customer";
        }

        if (string.IsNullOrWhiteSpace(newQuotation.Currency))
        {
            createValidationErrors["Currency"] = "Please select a currency";
        }

        if (!newQuotation.Lines.Any())
        {
            createValidationErrors["Lines"] = "At least one line item is required";
        }

        var hasMissingPrice = false;

        for (int i = 0; i < newQuotation.Lines.Count; i++)
        {
            var line = newQuotation.Lines[i];
            var errors = new Dictionary<string, string>();

            if (string.IsNullOrWhiteSpace(line.ItemCode))
            {
                errors["ItemCode"] = "Item code is required";
            }
            if (line.Quantity <= 0)
            {
                errors["Quantity"] = "Quantity must be greater than 0";
            }
            if (line.UnitPrice <= 0)
            {
                errors["UnitPrice"] = "Unit price must be greater than 0";
                hasMissingPrice = true;
            }

            if (errors.Any())
            {
                lineValidationErrors[i] = errors;
            }
        }

        if (hasMissingPrice)
        {
            Snackbar.Add("One or more line items still have no price. Select an item with a valid price or enter one manually.", Severity.Warning);
        }

        return !createValidationErrors.Any() && !lineValidationErrors.Any();
    }

    private async Task CreateQuotationAsync()
    {
        if (!ValidateCreateForm())
        {
            return;
        }

        isCreating = true;

        try
        {
            newQuotation.ValidUntil = validUntilDate;
            var created = await QuotationService.CreateQuotationAsync(newQuotation);

            if (created != null)
            {
                Snackbar.Add($"Quotation {created.QuotationNumber} created successfully!", Severity.Success);
                await AuditService.LogAsync(AuditActions.CreateQuotation, "Quotation", created.QuotationNumber);
                NavigationManager.NavigateTo("/quotations");
            }
            else
            {
                Snackbar.Add("Failed to create quotation.", Severity.Error);
                await AuditService.LogAsync(AuditActions.CreateQuotation, "Quotation", newQuotation.CardCode, null, false, "Failed to create quotation");
            }
        }
        catch (HttpRequestException ex)
        {
            Snackbar.Add($"Failed to create quotation: {ex.Message}", Severity.Error);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error: {ex.Message}", Severity.Error);
        }
        finally
        {
            isCreating = false;
        }
    }
}