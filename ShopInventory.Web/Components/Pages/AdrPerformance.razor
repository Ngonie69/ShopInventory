    {
        var many = SelectedAdr is null;
        var items = conversion.Items.Where(item => item.ShortQuantity > 0).ToList();
        <p class="vsp-note">
            Ordered units against units the van invoiced, on orders it has invoiced. Short value is what the
            shortfall would have sold for at the order's own prices.
        </p>
        <div class="vs-table-wrap">
            <table class="vs-table">
                <thead>
                    <tr>
                        @if (many)
                        {
                            <th>ADR</th>
                        }
                        <th>Item</th>
                        <th class="vs-num">Ordered</th>
                        <th class="vs-num">Supplied</th>
                        <th>Fill rate</th>
                        <th class="vs-num">Short value</th>
                        <th class="vs-num">Shops let down</th>
                    </tr>
                </thead>
