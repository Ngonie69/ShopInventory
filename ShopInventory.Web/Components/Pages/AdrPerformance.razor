@page "/van-sales/reports/adr-performance"
@* Admin and Manager only, like the other van performance reports. *@
@attribute [Authorize(Roles = "Admin,Manager")]
@rendermode InteractiveServer
@using System.Globalization
@using ShopInventory.Web.Models
@inject IVanSalesReportService VanSalesReportService
@inject IReportExportService ExportService
@inject IJSRuntime JS
@inject NavigationManager Navigation
@implements IDisposable

<PageTitle>ADR Performance - Shop Inventory</PageTitle>

@* What the ADRs ordered, and how much of it became actual sales on the van.

   Every ADR order is followed through the invoice queue to the van sale it became (the API's
   AdrConversion), so the page leads on what was sold, not on what was written down. The gap
   between the two is split into reasons that add back up to it.

   Carried by wwwroot/css/van-sales.css in both schemes: the shared `vs-` chrome, the performance
   page's `vsp-` tiles and headings, and `vsadr-` for what only this page draws. Drawn from the
   "ADR Performance Redesign" design canvas (2026-10-29).

   Money is per currency, as on every van report; the tiles, charts and rankings lead on the
   currency most was ordered in, and the other currencies are named under them. *@

<div class="vs vsadr">

    <div class="vs-head">
        <div>
            <h2 class="vs-title">ADR performance</h2>
            <p class="vs-subtitle">
                What the ADRs ordered, and how much of it became actual sales on the van — order by
                order, matched to the invoice it turned into.
            </p>
        </div>
        <div class="vs-actions">
            <button class="vs-btn" @onclick="ExportAsync" disabled="@(isLoading || report is null)">
                Export to Excel
            </button>
        </div>
    </div>

    <VanReportPeriodBar IdPrefix="vsadr" @bind-From="fromDate" @bind-To="toDate" RecentDays="RecentDays"
                        OnRun="LoadAsync" Loading="isLoading" ReadAtUtc="readAtUtc"
                        ShownFrom="report?.FromDate" ShownTo="report?.ToDate">
        <NocturneSelect Id="vsadr-adr" Class="nsel-block" TValue="string"
                        Options="AdrFilterOptions" @bind-Value="selectedAdrId"
                        OnChanged="LoadAsync" AriaLabel="Filter by ADR"
                        Placeholder="All ADRs" />
    </VanReportPeriodBar>

    @if (loadError is not null)
    {
        <div class="vs-notice">@loadError</div>
    }

    @if (isLoading)
    {
        <div class="vs-loading">
            <MudProgressCircular Indeterminate="true" Size="Size.Small" />
            <span>Reading the period…</span>
        </div>
    }
    else if (report is null && loadError is not null)
    {
        @* The error above says why the page is empty; nothing to choose. *@
    }
    else if (report is null)
    {
        <div class="vs-empty">
            <div class="vs-empty-title">Nothing loaded yet</div>
            <div>Choose a period and run the report.</div>
        </div>
    }
    else if (report.Adrs.Count == 0)
    {
        <div class="vs-empty">
            <div class="vs-empty-title">No ADRs to report on</div>
            <div>No active ADR account, and none with orders or sales in this period.</div>
        </div>
    }
    else if (report.Conversion is not { } conversion)
    {
        <div class="vs-notice">
            The API answering this page is older than the page and does not follow orders to their
            invoices. Deploy the API to see the order-to-sale figures.
        </div>
    }
    else
    {
        var lead = AdrConversionReading.LeadCurrency(conversion);
        var focus = FocusSummary(conversion);
        var focusPrevious = FocusPrevious(conversion);
        var money = focus.In(lead);
        var previousMoney = focusPrevious?.In(lead);
        var allMoney = conversion.Overall.In(lead);

        @if (SelectedAdr is { } adr)
        {
            var route = conversion.Adrs.FirstOrDefault(row => row.UserId == adr.UserId);
            <div class="vsadr-who">
                <span class="vsadr-avatar" aria-hidden="true">@Initials(adr.DisplayName)</span>
                <div>
                    <h3 class="vsadr-who-name">
                        @adr.DisplayName
                        <span class="vs-chip @(adr.IsActive ? "vs-chip-good" : "vs-chip-quiet")">@(adr.IsActive ? "Active" : "Inactive")</span>
                    </h3>
                    <div class="vsp-sub">
                        ADR · @(route?.RouteName is { } routeName ? $"Route {route.RouteCode} {routeName}" : "no route assigned")
                        · van account @(adr.VanAccountCode ?? "—")
                        · @adr.ActiveDays.ToString("N0") days active
                    </div>
                </div>
                <button type="button" class="vs-btn vsadr-back" @onclick="ClearAdrAsync">All ADRs</button>
            </div>
        }

        @* ── From order to actual sale ───────────────────────────────────── *@
        <section class="vsadr-card vsadr-funnel" aria-labelledby="vsadr-funnel-h">
            <div class="vsadr-card-head">
                <div>
                    <h3 id="vsadr-funnel-h" class="vsadr-card-title">From order to actual sale</h3>
                    <p class="vsp-note">
                        Every order in the period, followed to the van invoice it became@(lead is null ? "." : $", in {lead}.")
                        @OtherCurrencies(focus.Money, lead)
                    </p>
                </div>
                <div class="vsadr-headline">
                    <span class="vsadr-headline-value @Tone(money?.Conversion)">@Rate(money?.Conversion, 1)</span>
                    <span class="vsadr-headline-text">
                        of ordered value became actual sales
                        @if (SelectedAdr is not null)
                        {
                            <span class="vsp-sub">all ADRs @Rate(allMoney?.Conversion, 1)</span>
                        }
                        @Delta(Points(money?.Conversion, previousMoney?.Conversion), "pts")
                    </span>
                </div>
            </div>

            <div class="vsadr-stages">
                @foreach (var stage in Stages(focus, money))
                {
                    <div class="vsadr-stage">
                        <div class="vsp-kpi-label">@stage.Label</div>
                        <div class="vsadr-stage-figure">
                            <span class="vsadr-stage-value vsadr-ink-@stage.Tone">@Money(lead, stage.Value)</span>
                            <span class="vsp-sub">@stage.Orders</span>
                        </div>
                        <div class="vsadr-bar"><span class="vsadr-bar-fill vsadr-fill-@stage.Tone" style="width:@Width(stage.Share)"></span></div>
                        <div class="vsp-sub">@stage.Note</div>
                    </div>
                }
            </div>
        </section>

        @* ── The six figures, each against the period before ──────────────── *@
        <div class="vsp-kpis">
            <div class="vsp-kpi">
                <div class="vsp-kpi-label">Actual sales from orders</div>
                <div class="vsp-kpi-value">@Money(lead, money?.Invoiced)</div>
                <div class="vsp-kpi-sub">
                    @(money?.MarginPercent is { } margin ? $"GP {margin:N1}% on SAP cost" : showGp ? "GP not costed yet" : "GP not read")
                </div>
                @Delta(Change(money?.Invoiced, previousMoney?.Invoiced), "%")
            </div>
            <div class="vsp-kpi">
                <div class="vsp-kpi-label">Order-to-sale conversion</div>
                <div class="vsp-kpi-value">@Rate(money?.Conversion, 1)</div>
                <div class="vsp-kpi-sub">of @Money(lead, money?.Ordered) ordered</div>
                @Delta(Points(money?.Conversion, previousMoney?.Conversion), "pts")
            </div>
            <div class="vsp-kpi">
                <div class="vsp-kpi-label">Fill rate</div>
                <div class="vsp-kpi-value">@Rate(money?.FillRate, 1)</div>
                <div class="vsp-kpi-sub">
                    of invoiced orders' value delivered · @focus.Counts.InvoicedInFull.ToString("N0") of @focus.Counts.Invoiced.ToString("N0") in full
                </div>
                @Delta(Points(money?.FillRate, previousMoney?.FillRate), "pts")
            </div>
            <div class="vsp-kpi">
                <div class="vsp-kpi-label">Order to invoice</div>
                <div class="vsp-kpi-value">@Days(focus.MedianDaysToInvoice)</div>
                <div class="vsp-kpi-sub">median · @Rate(focus.InvoicedByNextDay) invoiced by the next day</div>
                @Delta(DaysFaster(focus.MedianDaysToInvoice, focusPrevious?.MedianDaysToInvoice), "days")
            </div>
            <div class="vsp-kpi">
                <div class="vsp-kpi-label">Strike rate</div>
                <div class="vsp-kpi-value">@Rate(focus.StrikeRate)</div>
                <div class="vsp-kpi-sub">
                    @(focus.Calls is { } calls ? $"{focus.ProductiveCalls:N0} productive of {calls:N0} calls" : "no visits recorded")
                </div>
                @Delta(Points(focus.StrikeRate, focusPrevious?.StrikeRate), "pts")
            </div>
            <div class="vsp-kpi">
                <div class="vsp-kpi-label">Share of van sales</div>
                <div class="vsp-kpi-value">@Rate(money?.VanShare, 1)</div>
                <div class="vsp-kpi-sub">of @Money(lead, money?.VanSales) the serving vans took</div>
                @Delta(Points(money?.VanShare, previousMoney?.VanShare), "pts")
            </div>
        </div>

        @if (conversion.Previous is { } previous)
        {
            <p class="vsp-note vsadr-compare-note">
                Arrows compare with @VanReportPeriod.Describe(previous.FromDate, previous.ToDate).
            </p>
        }

        @if (report.Caveats.Count > 0)
        {
            <div class="vsp-caveats">
                <div class="vsp-caveats-head">What this period could not answer</div>
                <ul class="vsp-caveats-list">
                    @foreach (var caveat in report.Caveats)
                    {
                        <li>@caveat</li>
                    }
                </ul>
            </div>
        }

        @* ── Day by day, and where the gap went ─────────────────────────────── *@
        <div class="vsadr-pair">
            <section class="vsadr-card vsadr-wide" aria-labelledby="vsadr-days-h">
                <div class="vsadr-card-head">
                    <div>
                        <h3 id="vsadr-days-h" class="vsadr-card-title">Ordered against invoiced, day by day</h3>
                        <p class="vsp-note">
                            The pale bar is what was ordered that day; the solid bar inside it is what the van
                            invoiced from those orders@(lead is null ? "" : $", in {lead}").
                        </p>
                    </div>
                    <div class="vsadr-legend">
                        <span><i class="vsadr-key vsadr-key-ordered"></i>Ordered</span>
                        <span><i class="vsadr-key vsadr-key-invoiced"></i>Invoiced</span>
                    </div>
                </div>
                @{
                    var chart = ChartDays(conversion, lead);
                    var peak = chart.Count == 0 ? 0m : chart.Max(day => day.Ordered);
                }
                @if (chart.Count == 0 || peak <= 0)
                {
                    <div class="vs-metric-none">No priced orders in this period.</div>
                }
                else
                {
                    <div class="vsadr-chart-wrap">
                        <div class="vsadr-chart" role="img"
                             aria-label="@($"Ordered against invoiced over {chart.Count} trading days")"
                             style="--vsadr-cols:@chart.Count">
                            @foreach (var day in chart)
                            {
                                var conversionRate = day.Ordered > 0 ? (double)(day.Invoiced / day.Ordered) : 0;
                                <div class="vsadr-col"
                                     title="@($"{day.Date:ddd dd MMM} — ordered {lead} {day.Ordered:N2}, invoiced {lead} {day.Invoiced:N2} ({conversionRate:P0})")">
                                    <div class="vsadr-col-ordered" style="height:@Width((double)(day.Ordered / peak))">
                                        <div class="vsadr-col-invoiced" style="height:@Width(Math.Min(conversionRate, 1))"></div>
                                    </div>
                                    <span class="vsadr-col-label @(day.Date.DayOfWeek == DayOfWeek.Saturday ? "vsadr-col-sat" : null)">
                                        @(day.Date.DayOfWeek == DayOfWeek.Saturday ? "S" : day.Date.Day.ToString(CultureInfo.InvariantCulture))
                                    </span>
                                </div>
                            }
                        </div>
                    </div>
                    <p class="vsp-note">
                        Peak day @Money(lead, peak). The most recent days settle as the vans invoice them.
                    </p>
                }
            </section>

            <section class="vsadr-card vsadr-narrow" aria-labelledby="vsadr-gap-h">
                <h3 id="vsadr-gap-h" class="vsadr-card-title">Where the other @Money(lead, money?.Gap) went</h3>
                <p class="vsp-note">
                    The @Rate(money is { Ordered: > 0 } ? (double)(money.Gap / money.Ordered) : null, 1) of ordered
                    value that did not become a sale, by reason.
                </p>
                @{
                    var reasons = AdrConversionReading.GapReasons(focus, money);
                    var positive = reasons.Where(reason => reason.Value > 0).Sum(reason => reason.Value);
                }
                @if (positive > 0)
                {
                    <div class="vsadr-gapbar" role="img" aria-label="@GapLabel(reasons, positive)">
                        @for (var i = 0; i < reasons.Count; i++)
                        {
                            if (reasons[i].Value > 0)
                            {
                                <span class="vsadr-gap-@i" style="width:@Width((double)(reasons[i].Value / positive))"></span>
                            }
                        }
                    </div>
                }
                <ul class="vsadr-reasons">
                    @for (var i = 0; i < reasons.Count; i++)
                    {
                        var reason = reasons[i];
                        <li>
                            <i class="vsadr-key vsadr-gap-@i" aria-hidden="true"></i>
                            <div>
                                <div class="vsadr-reason-line">
                                    <span class="vsadr-reason-name">@reason.Reason</span>
                                    <span class="vsadr-reason-value">@Money(lead, reason.Value)</span>
                                </div>
                                <div class="vsp-sub">
                                    @reason.Explanation · @reason.Orders.ToString("N0") order@(reason.Orders == 1 ? "" : "s")
                                </div>
                            </div>
                        </li>
                    }
                </ul>
            </section>
        </div>

        @* ── The league ─────────────────────────────────────────────────────── *@
        @if (SelectedAdr is null)
        {
            <section class="vsadr-card vsadr-flush" aria-labelledby="vsadr-league-h">
                <div class="vsadr-card-head vsadr-pad">
                    <div>
                        <h3 id="vsadr-league-h" class="vsadr-card-title">ADR league — ranked on actual sales</h3>
                        <p class="vsp-note">
                            An ADR whose orders never arrive ranks below one whose orders land. Choose a name to see
                            that ADR on their own.
                        </p>
                    </div>
                </div>
                <div class="vs-table-wrap">
                    <table class="vs-table vsadr-league">
                        <thead>
                            <tr>
                                <th class="vs-num">#</th>
                                <th>ADR · route</th>
                                <th class="vs-num">Days</th>
                                <th class="vs-num">Calls</th>
                                <th class="vs-num">Strike</th>
                                <th class="vs-num">Orders</th>
                                <th class="vs-num">Ordered</th>
                                <th class="vs-num">Invoiced</th>
                                <th>Conversion</th>
                                <th class="vs-num">Fill</th>
                                <th class="vs-num">Days to inv.</th>
                                <th>Share of van sales</th>
                                @if (showGp)
                                {
                                    <th class="vs-num">GP %</th>
                                }
                            </tr>
                        </thead>
                        <tbody>
                            @{ var rank = 0; }
                            @foreach (var (row, person) in League(conversion, lead))
                            {
                                var rowMoney = row.Summary.In(lead);
                                rank++;
                                <tr>
                                    <td class="vs-num"><span class="vsadr-rank">@rank</span></td>
                                    <td>
                                        <button type="button" class="vsadr-name" @onclick="() => SelectAdrAsync(row.UserId)">
                                            @(person?.DisplayName ?? "Unknown ADR")
                                        </button>
                                        @if (person is { IsActive: false })
                                        {
                                            <span class="vsp-sub">inactive</span>
                                        }
                                        <div class="vsp-sub">@(row.RouteName is null ? person?.VanAccountCode ?? "no route" : $"{row.RouteCode} {row.RouteName}")</div>
                                    </td>
                                    <td class="vs-num">@(person?.ActiveDays.ToString("N0") ?? "—")</td>
                                    <td class="vs-num">@(row.Summary.Calls?.ToString("N0") ?? "—")</td>
                                    <td class="vs-num">@Rate(row.Summary.StrikeRate)</td>
                                    <td class="vs-num">@row.Summary.Counts.Ordered.ToString("N0")</td>
                                    <td class="vs-num">@Amount(rowMoney?.Ordered)</td>
                                    <td class="vs-num vsadr-strong">@Amount(rowMoney?.Invoiced)</td>
                                    <td>@Meter(rowMoney?.Conversion)</td>
                                    <td class="vs-num @(rowMoney?.FillRate is < 0.85 ? "vsadr-warn" : null)">@Rate(rowMoney?.FillRate)</td>
                                    <td class="vs-num">@Days(row.Summary.MedianDaysToInvoice, shortForm: true)</td>
                                    <td>@Meter(rowMoney?.VanShare, neutral: true)</td>
                                    @if (showGp)
                                    {
                                        <td class="vs-num">@(rowMoney?.MarginPercent is { } rowMargin ? $"{rowMargin:N1}%" : "—")</td>
                                    }
                                </tr>
                            }
                        </tbody>
                        <tfoot>
                            <tr>
                                <td></td>
                                <td>All ADRs · @report.Overall.ActiveAdrCount.ToString("N0") active of @report.Overall.AdrCount.ToString("N0")</td>
                                <td class="vs-num">—</td>
                                <td class="vs-num">@(conversion.Overall.Calls?.ToString("N0") ?? "—")</td>
                                <td class="vs-num">@Rate(conversion.Overall.StrikeRate)</td>
                                <td class="vs-num">@conversion.Overall.Counts.Ordered.ToString("N0")</td>
                                <td class="vs-num">@Amount(allMoney?.Ordered)</td>
                                <td class="vs-num">@Amount(allMoney?.Invoiced)</td>
                                <td>@Rate(allMoney?.Conversion, 1)</td>
                                <td class="vs-num">@Rate(allMoney?.FillRate, 1)</td>
                                <td class="vs-num">@Days(conversion.Overall.MedianDaysToInvoice, shortForm: true)</td>
                                <td>@Rate(allMoney?.VanShare, 1)</td>
                                @if (showGp)
                                {
                                    <td class="vs-num">@(allMoney?.MarginPercent is { } allMargin ? $"{allMargin:N1}%" : "—")</td>
                                }
                            </tr>
                        </tfoot>
                    </table>
                </div>
            </section>
        }

        @* ── Rhythm and the order book ─────────────────────────────────────── *@
        <div class="vsadr-pair">
            <section class="vsadr-card vsadr-narrow" aria-labelledby="vsadr-week-h">
                <h3 id="vsadr-week-h" class="vsadr-card-title">Weekday rhythm</h3>
                <p class="vsp-note">Calls made, how many ordered, and how much of the ordered value was invoiced.</p>
                <table class="vs-table">
                    <thead>
                        <tr><th>Day</th><th class="vs-num">Calls</th><th class="vs-num">Strike</th><th>Conversion</th></tr>
                    </thead>
                    <tbody>
                        @foreach (var weekday in Weekdays(conversion, lead))
                        {
                            <tr>
                                <td>@weekday.Day</td>
                                <td class="vs-num">@(weekday.Calls?.ToString("N0") ?? "—")</td>
                                <td class="vs-num">@Rate(weekday.Strike)</td>
                                <td>@Meter(weekday.Conversion)</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </section>

            <section class="vsadr-card vsadr-narrow" aria-labelledby="vsadr-book-h">
                <h3 id="vsadr-book-h" class="vsadr-card-title">Who raised the order book</h3>
                <p class="vsp-note">
                    Every live sales order in the period, from every source, by who raised it — so the ADRs
                    read against everyone who takes orders. Grouped on each person's role today.
                </p>
                <table class="vs-table">
                    <thead>
                        <tr><th>Raised by</th><th class="vs-num">Orders</th><th>Value</th><th>Share</th></tr>
                    </thead>
                    <tbody>
                        @foreach (var channel in report.OrdersByChannel)
                        {
                            var share = channel.Shares.FirstOrDefault(part => SameCurrency(part.Currency, lead ?? string.Empty))
                                        ?? channel.Shares.FirstOrDefault();
                            <tr class="@(channel.IsAdr ? "vsadr-self" : null)">
                                <td>@channel.Channel</td>
                                <td class="vs-num">@channel.OrderCount.ToString("N0")</td>
                                <td>@ChannelValues(channel.Shares)</td>
                                <td>@Meter(share?.Share, neutral: true)</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </section>
        </div>

        @* ── Shops, items and orders ───────────────────────────────────────── *@
        <div class="vsp-sections">
            @foreach (var (key, label, count) in new[]
            {
                (TabShops, "Shops", conversion.Shops.Count),
                (TabItems, "Items short", conversion.Items.Count(item => item.ShortQuantity > 0)),
                (TabOrders, "Order ledger", conversion.Orders.Count)
            })
            {
                <button type="button"
                        class="vs-chip @(activeTab == key ? "vs-chip-info" : "vs-chip-quiet")"
                        @onclick="() => ShowTab(key)">
                    @label
                    <span class="vsp-section-count">@count.ToString("N0")</span>
                </button>
            }
        </div>

        @if (activeTab == TabShops)
        {
            @ShopsTable(conversion, lead)
        }
        else if (activeTab == TabItems)
        {
            @ItemsTable(conversion, lead)
        }
        else
        {
            @LedgerTable(conversion)
        }
    }
</div>

@code {
    private AdrPerformanceReportResponse? report;

    /// <summary>Whether the sales figures carry SAP's booked gross profit.</summary>
    private bool showGp => report?.Margin is { Available: true };

    /// <summary>
    /// The ADRs the last unfiltered load held. Kept apart from <see cref="report"/> because a load
    /// for one ADR returns one row, and building the picker from that would leave nobody else to
    /// choose.
    /// </summary>
    private List<AdrPerformanceRow> adrs = [];

    private DateTime? fromDate;
    private DateTime? toDate;
    private string? selectedAdrId;

    private bool isLoading;
    private string? loadError;
    private DateTime? readAtUtc;

    /// <summary>The page's own default, shown as a preset beside the standard ones.</summary>
    private static readonly int[] RecentDays = [30];

    /// <summary>The most rows a table draws; the export carries every one.</summary>
    private const int RowsShown = 200;

    private const string TabQueryName = "tab";
    private const string OutcomeQueryName = "outcome";

    [SupplyParameterFromQuery(Name = VanReportLinks.From)] private string? FromQuery { get; set; }
    [SupplyParameterFromQuery(Name = VanReportLinks.To)] private string? ToQuery { get; set; }
    [SupplyParameterFromQuery(Name = VanReportLinks.Rep)] private string? RepQuery { get; set; }
    [SupplyParameterFromQuery(Name = TabQueryName)] private string? TabQuery { get; set; }
    [SupplyParameterFromQuery(Name = OutcomeQueryName)] private string? OutcomeQuery { get; set; }

    private readonly LatestLoad loads = new();

    private const string TabShops = "shops";
    private const string TabItems = "items";
    private const string TabOrders = "orders";
    private string activeTab = TabShops;

    /// <summary>The ledger's outcome filter: null for every order.</summary>
    private string? outcomeFilter;

    private static readonly (string? Key, string Label)[] OutcomeFilters =
    [
        (null, "All"),
        (AdrOutcome.ShortSupplied, "Short-supplied"),
        (AdrOutcome.NoLinkedInvoice, "No linked invoice"),
        (AdrOutcome.NotYetInSap, "Not yet in SAP"),
        (AdrOutcome.Cancelled, "Cancelled")
    ];

    private IEnumerable<INocturneSelectOption<string>> AdrFilterOptions =>
        new[] { NocturneSelectOption.All("All ADRs") }
            .Concat(adrs
                .OrderBy(adr => adr.DisplayName, StringComparer.OrdinalIgnoreCase)
                .Select(adr => new NocturneSelectOption<string>(adr.UserId.ToString("N"), adr.DisplayName)
                {
                    Hint = adr.VanAccountCode
                }));

    private AdrPerformanceRow? SelectedAdr =>
        Guid.TryParse(selectedAdrId, out var id) ? report?.Adrs.FirstOrDefault(adr => adr.UserId == id) : null;

    private AdrPerformanceRow? Person(Guid userId) =>
        report?.Adrs.FirstOrDefault(adr => adr.UserId == userId) ?? adrs.FirstOrDefault(adr => adr.UserId == userId);

    protected override async Task OnInitializedAsync()
    {
        // A link or a refresh opens the report as it was; otherwise the page's own last 30 days.
        var (defaultFrom, defaultTo) = VanReportPeriod.LastDays(RecentDays[0], VanReportPeriod.TodayCat);
        fromDate = VanReportPeriod.ParseDay(FromQuery) ?? defaultFrom;
        toDate = VanReportPeriod.ParseDay(ToQuery) ?? defaultTo;
        selectedAdrId = VanReportLinks.ParseRep(RepQuery) is { } adrFromLink ? VanReportLinks.RepKey(adrFromLink) : null;

        if (TabQuery is TabShops or TabItems or TabOrders)
        {
            activeTab = TabQuery;
        }

        outcomeFilter = OutcomeFilters.FirstOrDefault(filter => filter.Key == OutcomeQuery).Key;

        await LoadAsync();
    }

    private async Task SelectAdrAsync(Guid userId)
    {
        selectedAdrId = userId.ToString("N");
        await LoadAsync();
    }

    private async Task ClearAdrAsync()
    {
        selectedAdrId = null;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        var token = loads.Begin();
        isLoading = true;
        loadError = null;
        StateHasChanged();

        try
        {
            Guid? adrId = Guid.TryParse(selectedAdrId, out var parsed) ? parsed : null;

            var result = await VanSalesReportService.GetAdrPerformanceReportAsync(
                fromDate, toDate, adrId, cancellationToken: token);
            report = result.Value;

            if (report is null)
            {
                loadError = result.Error;
                return;
            }

            readAtUtc = DateTime.UtcNow;
            WriteQuery();

            if (adrId is null)
            {
                adrs = report.Adrs;
            }
            else if (report.Adrs.Count > 0 && adrs.All(adr => adr.UserId != adrId))
            {
                // Opened from a link to one ADR: the picker has no list yet, and saying "All ADRs" over one
                // ADR's figures would be wrong. It names them until "All ADRs" loads the rest.
                adrs = [.. adrs, .. report.Adrs];
            }
            else if (report.Adrs.Count == 0)
            {
                // An ADR the new period does not hold would leave the page empty with no reason given.
                selectedAdrId = null;
                await LoadAsync();
            }
        }
        catch (OperationCanceledException) when (token.IsCancellationRequested)
        {
            // A newer load replaced this one and owns the page now.
        }
        catch (Exception ex)
        {
            loadError = $"Failed to load the ADR performance report: {ex.Message}";
        }
        finally
        {
            if (!token.IsCancellationRequested)
            {
                isLoading = false;
                StateHasChanged();
            }
        }
    }

    private void ShowTab(string key)
    {
        activeTab = key;
        WriteQuery();
    }

    private void ShowOutcome(string? outcome)
    {
        outcomeFilter = outcome;
        WriteQuery();
    }

    /// <summary>The period, the ADR, the open tab and the ledger filter, in the page's own URL.</summary>
    private void WriteQuery()
    {
        var values = VanReportLinks.Query(
            report?.FromDate ?? fromDate,
            report?.ToDate ?? toDate,
            rep: VanReportLinks.ParseRep(selectedAdrId));
        values[TabQueryName] = activeTab == TabShops ? null : activeTab;
        values[OutcomeQueryName] = activeTab == TabOrders ? outcomeFilter : null;
        VanReportLinks.WriteQuery(Navigation, values);
    }

    public void Dispose() => loads.Dispose();

    private async Task ExportAsync()
    {
        if (report is null)
        {
            return;
        }

        try
        {
            var bytes = ExportService.ExportAdrPerformanceToExcel(report);
            var who = SelectedAdr is { } adr ? $"_{adr.Username}" : string.Empty;
            var fileName = $"AdrPerformance_{report.FromDate:yyyyMMdd}-{report.ToDate:yyyyMMdd}{who}.xlsx";

            await JS.InvokeVoidAsync("downloadFile", fileName, Convert.ToBase64String(bytes));
        }
        catch (Exception ex)
        {
            loadError = $"The export could not be downloaded: {ex.Message}";
        }
    }

    // ── What the page shows ─────────────────────────────────────────────────────

    /// <summary>The chosen ADR's figures, or every ADR's when none is chosen.</summary>
    private AdrConversionSummary FocusSummary(AdrConversionReport conversion) =>
        SelectedAdr is { } adr
            ? conversion.Adrs.FirstOrDefault(row => row.UserId == adr.UserId)?.Summary ?? new AdrConversionSummary()
            : conversion.Overall;

    private AdrConversionSummary? FocusPrevious(AdrConversionReport conversion) =>
        conversion.Previous is not { } previous ? null
        : SelectedAdr is { } adr ? previous.Adrs.FirstOrDefault(row => row.UserId == adr.UserId)?.Summary
        : previous.Overall;

    private sealed record Stage(string Label, decimal? Value, string Orders, double? Share, string Tone, string Note);

    private static IEnumerable<Stage> Stages(AdrConversionSummary summary, AdrConversionMoney? money)
    {
        var counts = summary.Counts;
        var ordered = money?.Ordered ?? 0m;
        double? Of(decimal? value) => ordered > 0 && value is { } part ? (double)(part / ordered) : null;

        yield return new Stage("Ordered", money?.Ordered, $"{counts.Ordered:N0} orders", ordered > 0 ? 1 : null, "accent",
            $"{counts.Cancelled:N0} cancelled since");
        yield return new Stage("Reached SAP", money?.ReachedSap, $"{counts.ReachedSap:N0} orders", Of(money?.ReachedSap), "accent",
            $"{Rate(Of(money?.ReachedSap), 1)} · {counts.NotYetInSap:N0} still waiting");
        yield return new Stage("Invoiced — actual sales", money?.Invoiced, $"{counts.Invoiced:N0} orders", Of(money?.Invoiced), "info",
            $"{Rate(Of(money?.Invoiced), 1)} of ordered value");
        yield return new Stage("Never became a sale", money?.Gap, Rate(Of(money?.Gap), 1), Of(money?.Gap), "warn",
            "Split by reason below");
    }

    private sealed record ChartDay(DateTime Date, decimal Ordered, decimal Invoiced);

    /// <summary>Each trading day's orders in the lead currency, across whichever ADRs the page shows.</summary>
    private static List<ChartDay> ChartDays(AdrConversionReport conversion, string? lead) =>
        conversion.Days
            .GroupBy(day => day.TradingDate.Date)
            .Select(group =>
            {
                var money = group.SelectMany(day => day.Money).Where(part => SameCurrency(part.Currency, lead ?? string.Empty)).ToList();
                return new ChartDay(group.Key, money.Sum(part => part.Ordered), money.Sum(part => part.Invoiced));
            })
            .Where(day => day.Ordered > 0 || day.Invoiced > 0)
            .OrderBy(day => day.Date)
            .ToList();

    private sealed record Weekday(string Day, int? Calls, double? Strike, double? Conversion);

    private static IEnumerable<Weekday> Weekdays(AdrConversionReport conversion, string? lead) =>
        conversion.Days
            .GroupBy(day => day.TradingDate.DayOfWeek)
            .OrderBy(group => ((int)group.Key + 6) % 7)
            .Select(group =>
            {
                var called = group.Where(day => day.Calls is not null).ToList();
                int? calls = called.Count == 0 ? null : called.Sum(day => day.Calls!.Value);
                var money = group.SelectMany(day => day.Money).Where(part => SameCurrency(part.Currency, lead ?? string.Empty)).ToList();
                var ordered = money.Sum(part => part.Ordered);
                return new Weekday(
                    CultureInfo.InvariantCulture.DateTimeFormat.GetDayName(group.Key),
                    calls,
                    calls is > 0 ? (double)called.Sum(day => day.ProductiveCalls) / calls.Value : null,
                    ordered > 0 ? (double)(money.Sum(part => part.Invoiced) / ordered) : null);
            });

    /// <summary>The ADRs ranked on what their orders actually sold, in the lead currency.</summary>
    private IEnumerable<(AdrConversionRow Row, AdrPerformanceRow? Person)> League(AdrConversionReport conversion, string? lead) =>
        conversion.Adrs
            .Select(row => (Row: row, Person: Person(row.UserId)))
            .OrderByDescending(pair => pair.Row.Summary.In(lead)?.Invoiced ?? 0m)
            .ThenByDescending(pair => pair.Row.Summary.In(lead)?.Ordered ?? 0m)
            .ThenBy(pair => pair.Person?.DisplayName, StringComparer.OrdinalIgnoreCase);

    private RenderFragment ShopsTable(AdrConversionReport conversion, string? lead) => __builder =>
    {
        var many = SelectedAdr is null;
        <p class="vsp-note">
            Did each shop's orders arrive? A shop visited and never ordered for is listed too. Flags mark
            shops that order but are not receiving.
        </p>
        <div class="vs-table-wrap">
            <table class="vs-table">
                <thead>
                    <tr>
                        @if (many)
                        {
                            <th>ADR</th>
                        }
                        <th>Shop</th>
                        <th class="vs-num">Visits</th>
                        <th class="vs-num">Orders</th>
                        <th class="vs-num">Ordered</th>
                        <th class="vs-num">Invoiced</th>
                        <th>Conversion</th>
                        <th class="vs-num">Short</th>
                        <th>Last order</th>
                        <th>Flag</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var shop in conversion.Shops.Take(RowsShown))
                    {
                        var shopMoney = shop.Money.FirstOrDefault(part => SameCurrency(part.Currency, lead ?? string.Empty));
                        var flag = AdrConversionReading.ShopFlag(shop, lead);
                        <tr>
                            @if (many)
                            {
                                <td>@(Person(shop.UserId)?.DisplayName ?? "—")</td>
                            }
                            <td>@shop.DisplayName <span class="vsp-sub">@shop.CustomerCode</span></td>
                            <td class="vs-num">@shop.Visits.ToString("N0")</td>
                            <td class="vs-num">@shop.Orders.ToString("N0")</td>
                            <td class="vs-num">@Amount(shopMoney?.Ordered)</td>
                            <td class="vs-num vsadr-strong">@Amount(shopMoney?.Invoiced)</td>
                            <td>@Meter(shopMoney?.Conversion)</td>
                            <td class="vs-num @(shopMoney is { ShortSupplied: > 0 } ? "vsadr-warn" : null)">@Amount(shopMoney?.ShortSupplied)</td>
                            <td>@(shop.LastOrderOn?.ToString("ddd dd MMM") ?? "—")</td>
                            <td>
                                @if (flag is not null)
                                {
                                    <span class="vs-chip vs-chip-warn">@flag</span>
                                }
                            </td>
                        </tr>
                    }
                    @if (conversion.Shops.Count == 0)
                    {
                        <tr><td colspan="10" class="vs-metric-none">No shop recorded on any order or visit.</td></tr>
                    }
                </tbody>
            </table>
        </div>
        @RowsNote(conversion.Shops.Count, "shops")
    };

