    private RenderFragment LedgerTable(AdrConversionReport conversion) => __builder =>
    {
        var many = SelectedAdr is null;
        var orders = conversion.Orders.Where(order => outcomeFilter is null || order.Outcome == outcomeFilter).ToList();
        <div class="vsadr-filters" role="group" aria-label="Filter the ledger by outcome">
            @foreach (var (key, label) in OutcomeFilters)
            {
                var count = key is null ? conversion.Orders.Count : conversion.Orders.Count(order => order.Outcome == key);
                <button type="button" aria-pressed="@(outcomeFilter == key ? "true" : "false")"
                        class="vs-chip @(outcomeFilter == key ? "vs-chip-info" : "vs-chip-quiet")"
                        @onclick="() => ShowOutcome(key)">
                    @label <span class="vsp-section-count">@count.ToString("N0")</span>
                </button>
            }
        </div>
        <p class="vsp-note">Newest first. Variance is invoiced minus ordered; the outcome says why they differ.</p>
        <div class="vs-table-wrap">
            <table class="vs-table">
                <thead>
                    <tr>
                        <th>Captured</th>
                        <th>Order</th>
                        @if (many)
                        {
                            <th>ADR</th>
                        }
                        <th>Shop</th>
                        <th class="vs-num">Ordered</th>
                        <th>SAP order</th>
                        <th>Invoice</th>
                        <th class="vs-num">Invoiced</th>
                        <th class="vs-num">Days</th>
                        <th class="vs-num">Variance</th>
                        <th>Outcome</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var order in orders.Take(RowsShown))
                    {
                        <tr class="@(order.Outcome == AdrOutcome.Cancelled ? "vsadr-cancelled" : null)">
                            <td>@order.CapturedAtCat.ToString("ddd dd MMM HH:mm")</td>
                            <td>@order.OrderNumber</td>
                            @if (many)
                            {
                                <td>@(Person(order.UserId)?.DisplayName ?? "—")</td>
                            }
                            <td>@order.DisplayCustomer</td>
                            <td class="vs-num">@($"{order.Currency} {order.Ordered:N2}")</td>
                            <td>@(order.SapOrderDocNum?.ToString(CultureInfo.InvariantCulture) ?? "—")</td>
                            <td>
                                @if (order.InvoiceReference is null)
                                {
                                    <span>—</span>
                                }
                                else
                                {
                                    @(order.InvoiceDocNum?.ToString(CultureInfo.InvariantCulture) ?? "not posted yet")
                                    <span class="vsp-sub">@order.InvoiceReference</span>
                                }
                            </td>
                            <td class="vs-num">@(order.Invoiced is { } invoiced ? invoiced.ToString("N2") : "—")</td>
                            <td class="vs-num">@(order.DaysToInvoice is { } days ? days.ToString("N1") : "—")</td>
                            <td class="vs-num @(order.Variance is < 0 ? "vsadr-warn" : null)">@(order.Variance is { } variance ? variance.ToString("N2") : "—")</td>
                            <td><span class="vs-chip @OutcomeChip(order.Outcome)">@order.Outcome</span></td>
                        </tr>
                    }
                    @if (orders.Count == 0)
                    {
                        <tr><td colspan="11" class="vs-metric-none">No orders with this outcome in the period.</td></tr>
                    }
                </tbody>
            </table>
        </div>
        @RowsNote(orders.Count, "orders")
    };

    // ── Formatting ──────────────────────────────────────────────────────────────
    //
    // An em dash for every unavailable value, never a zero standing in for one.

    private static RenderFragment RowsNote(int count, string noun) => __builder =>
    {
        if (count > RowsShown)
        {
            <p class="vsp-note">
                Showing the first @RowsShown.ToString("N0") of @count.ToString("N0") @noun. The Excel export carries every one.
            </p>
        }
    };

    private static string Money(string? currency, decimal? value) =>
        value is { } amount && currency is not null ? $"{currency} {amount:N2}" : "—";

    private static string Amount(decimal? value) => value is { } amount ? amount.ToString("N2") : "—";

    private static string Rate(double? rate, int decimals = 0) =>
        rate is { } value ? value.ToString(decimals == 0 ? "P0" : "P1") : "—";

    private static string Days(double? days, bool shortForm = false) =>
        days is not { } value ? "—" : shortForm ? value.ToString("N1") : $"{value:N1} days";

    private static string Quantity(decimal quantity, string? unit) =>
        unit is null ? quantity.ToString("N0") : $"{quantity:N0} {unit}";

    private static string Width(double? share) =>
        $"{Math.Clamp((share ?? 0) * 100, 0, 100).ToString("F1", CultureInfo.InvariantCulture)}%";

    private static string Tone(double? conversion) => conversion switch
    {
        null => "vsadr-ink-mute",
        >= 0.85 => "vsadr-ink-info",
        >= 0.75 => "vsadr-ink-mute",
        _ => "vsadr-ink-warn"
    };

    private static string Initials(string name) =>
        string.Concat(name.Split(' ', StringSplitOptions.RemoveEmptyEntries).Take(2).Select(part => char.ToUpperInvariant(part[0])));

    private static string OtherCurrencies(List<AdrConversionMoney> money, string? lead)
    {
        var others = money.Where(part => !SameCurrency(part.Currency, lead ?? string.Empty)).ToList();
        return others.Count == 0
            ? string.Empty
            : $"Also {string.Join(", ", others.Select(part => $"{part.Currency} {part.Invoiced:N0} sold of {part.Ordered:N0} ({Rate(part.Conversion)})"))}.";
    }

    private static string GapLabel(IReadOnlyList<(string Reason, string Explanation, int Orders, decimal Value)> reasons, decimal positive) =>
        string.Join(", ", reasons.Where(reason => reason.Value > 0)
            .Select(reason => $"{reason.Reason} {(double)(reason.Value / positive):P0}"));

    /// <summary>A rate as a bar with its figure, toned by how well it reads.</summary>
    private static RenderFragment Meter(double? rate, bool neutral = false) => __builder =>
    {
        if (rate is not { } value)
        {
            <span class="vs-metric-none">—</span>
            return;
        }

        var tone = neutral ? "accent" : value >= 0.85 ? "info" : value >= 0.75 ? "mute" : "warn";
        <span class="vsadr-meter">
            <span class="vsadr-meter-track"><span class="vsadr-meter-fill vsadr-fill-@tone" style="width:@Width(value)"></span></span>
            <span class="vsadr-meter-value vsadr-ink-@tone">@value.ToString("P0")</span>
        </span>
    };

    /// <summary>A change against the period before. Days count as better when they fall.</summary>
    private static RenderFragment Delta(double? change, string unit) => __builder =>
    {
        if (change is not { } value)
        {
            return;
        }

        var better = value >= 0;
        var magnitude = Math.Abs(value);
        var text = unit switch
        {
            "pts" => $"{magnitude:N1} pts",
            "%" => $"{magnitude:N0}%",
            "days" => $"{magnitude:N1} days {(better ? "faster" : "slower")}",
            _ => magnitude.ToString("N1")
        };
        <span class="vsadr-delta @(better ? "vsadr-delta-up" : "vsadr-delta-down")">
            <span aria-hidden="true">@(better ? "▲" : "▼")</span>
            <span class="vsadr-sr">@(better ? "up" : "down")</span>
            @text
        </span>
    };

    private static double? Points(double? now, double? before) =>
        now is { } current && before is { } previous ? (current - previous) * 100 : null;

    private static double? Change(decimal? now, decimal? before) =>
        now is { } current && before is { } previous && previous > 0 ? (double)((current - previous) / previous) * 100 : null;

    private static double? DaysFaster(double? now, double? before) =>
        now is { } current && before is { } previous ? previous - current : null;

    private static string ChannelValues(List<AdrChannelShare> shares) =>
        shares.Count == 0
            ? "—"
            : string.Join(", ", shares.Select(share => $"{share.Currency} {share.Gross:N2}"));

    private static string OutcomeChip(string outcome) => outcome switch
    {
        AdrOutcome.InvoicedInFull => "vs-chip-good",
        AdrOutcome.ShortSupplied => "vs-chip-warn",
        AdrOutcome.Cancelled => "vs-chip-bad",
        AdrOutcome.NoLinkedInvoice => "vs-chip-info",
        _ => "vs-chip-quiet"
    };

    private static bool SameCurrency(string left, string right) =>
        string.Equals(left, right, StringComparison.OrdinalIgnoreCase);
}
