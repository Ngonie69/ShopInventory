@page "/desktop-transactions"
@using Microsoft.AspNetCore.Authorization
@using ShopInventory.Web.Services
@attribute [Authorize(Roles = "Admin")]
@implements IAsyncDisposable
@inject IDesktopIntegrationService DesktopService
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@rendermode InteractiveServer
<PageTitle>Desktop Transactions - Shop Inventory</PageTitle>
@* Built from `Desktop Transactions.dc.html`. Styles live in
   wwwroot/css/operations.css (linked from App.razor), shared with the other
   four operational pages — `ops` is the scope, `ops-dt` this page's own half.

   The design replaces five MudDataGrids and a MudTabs with one fixed-layout
   table and a detail panel beside it: every lane has the same seven columns,
   so every lane is the same table, and selecting a row opens the panel that
   used to be an expanding child row. Row actions moved into that panel. The
   Mud surfaces are gone, and so is the `.ops.ops-dt .mud-…` block that
   existed only to skin them.

   What the trade costs is worth stating: MudDataGrid's per-column sort and
   filter menus. The design answers them with the search box — which matches
   reference, counterparty, type and site at once — and a status filter, over
   a list the footer states is newest-first.

   The rows are projected into one `QueueRow` shape rather than rendered from
   three DTOs, which is what lets the five lanes share a table. Nothing the
   old expanding rows showed was dropped: it moved into `Facts`, which is a
   per-lane list rather than a fixed set, because an invoice's fiscal receipt
   and a reservation's expiry are not the same six fields. *@

<div class="ops ops-dt">

    <div class="ops-hero">
        <div class="ops-hero-text">
            <div class="ops-kicker">Desktop sync</div>
            <h1>Desktop Transactions</h1>
            <p>
                Invoices, transfers and reservations submitted from the desktop applications,
                and what SAP has done with each one.
            </p>
        </div>
        <div class="ops-hero-actions">
            <div class="ops-dt-sync">
                <div class="ops-dt-sync-now">Last sync @_lastSync.ToString("HH:mm:ss")</div>
                <div class="ops-dt-sync-note">Polling SAP every @PollSeconds seconds</div>
            </div>
            <button type="button" class="ops-btn ops-btn-primary" @onclick="RefreshAll" disabled="@_isLoading">
                @if (_isLoading)
                {
                    <span class="ops-spin"></span>
                    <span>Refreshing…</span>
                }
                else
                {
                    <i class="ph ph-arrows-clockwise" aria-hidden="true"></i>
                    <span>Refresh</span>
                }
            </button>
        </div>
    </div>

    <div class="ops-rule-fade"></div>

    @* ─── The two queues, each as a total, five states and their proportions ─── *@
    <div class="ops-dt-queues">
        @if (_stats is not null)
        {
            @RenderQueueCard("ph-receipt", "Invoice queue", "documents", _stats.TotalQueued,
                     _stats.Pending, _stats.Processing, _stats.Completed + _stats.Fiscalized,
                     _stats.Failed + _stats.RequiresReview, _stats.Cancelled)
        }
        @if (_transferStats is not null)
        {
            @RenderQueueCard("ph-arrows-left-right", "Transfer queue", "movements", _transferStats.TotalQueued,
                     _transferStats.Pending, _transferStats.Processing, _transferStats.Completed,
                     _transferStats.Failed + _transferStats.RequiresReview, _transferStats.Cancelled)
        }
    </div>

    @if (RejectedCount > 0)
    {
        <div class="ops-msg ops-msg-row ops-fam-accent">
            <span class="ops-dot ops-fam-bad"></span>
            <div class="ops-msg-body ops-msg-said">
                @RejectedCount @(RejectedCount == 1 ? "document was" : "documents were") rejected by SAP and
                @(RejectedCount == 1 ? "is" : "are") waiting on a person@(OldestRejected is null
                    ? "." : $" — the oldest has been open since {OldestRejected.Value.ToLocalTime():HH:mm on d MMM}.")
            </div>
            <div class="ops-msg-actions">
                <button type="button" class="ops-btn ops-btn-ghost ops-btn-sm" @onclick="GoToReview">Review failures</button>
                <button type="button" class="ops-btn ops-btn-primary ops-btn-sm" @onclick="RetryAll" disabled="@_isLoading">Retry all</button>
            </div>
        </div>
    }

    @* ─── Lanes, search and filters ─── *@
    <div class="ops-dt-tabrow">
        <div class="ops-tabs" role="tablist">
            @foreach (var lane in Lanes)
            {
                <button type="button" role="tab" class="@($"ops-tab{(lane == _lane ? " is-on" : string.Empty)}")"
                        aria-selected="@(lane == _lane)" @onclick="() => SelectLane(lane)">
                    <span>@LaneLabel(lane)</span>
                    <span class="ops-tab-count">@RowsFor(lane).Count</span>
                </button>
            }
        </div>
        <div class="ops-dt-tabtools">
            <div class="ops-search">
                <i class="ph ph-magnifying-glass" aria-hidden="true"></i>
                <input type="search" class="ops-input" value="@_query" @oninput="OnQueryInput"
                       placeholder="Search reference, party, type" aria-label="Search this queue" />
            </div>
            <button type="button" class="@($"ops-btn ops-btn-ghost{(_filtersOpen ? " is-on" : string.Empty)}")"
                    aria-expanded="@_filtersOpen" @onclick="() => _filtersOpen = !_filtersOpen">
                <i class="ph ph-funnel" aria-hidden="true"></i>
                <span>Filters</span>
            </button>
        </div>
    </div>

    @if (_filtersOpen)
    {
        <div class="ops-dt-filters">
            <div class="ops-field">
                <label class="ops-label" for="ops-dt-status">SAP status</label>
                <NocturneSelect TValue="string" Id="ops-dt-status" Class="nsel-block"
                                Options="StatusFilterOptions" Value="@_statusFilter"
                                ValueChanged="@(status => OnStatusFilterChanged(status))"
                                Caption="Filter by SAP status" AriaLabel="Filter by SAP status"
                                Placeholder="All statuses" />
            </div>
            @if (!string.IsNullOrEmpty(_statusFilter) || !string.IsNullOrWhiteSpace(_query))
            {
                <button type="button" class="ops-btn ops-btn-ghost" @onclick="ClearFilters">Clear</button>
            }
        </div>
    }

    @* ─── The lane, and the selected row beside it ─── *@
    <div class="ops-dt-split">
        <div class="ops-dt-main">
            <div class="ops-panel">
                @if (_isLoading && _rowsLoaded is false)
                {
                    <div class="ops-loading">
                        <span class="ops-spin ops-spin-lg"></span>
                        <p>Reading the desktop queues…</p>
                    </div>
                }
                else if (VisibleRows.Count == 0)
                {
                    <div class="ops-empty">
                        <i class="ph @(IsFiltered ? "ph-magnifying-glass" : "ph-tray")" aria-hidden="true"></i>
                        <h3>@EmptyTitle</h3>
                        <p>@EmptyBody</p>
                        @if (IsFiltered)
                        {
                            <div class="ops-empty-actions">
                                <button type="button" class="ops-btn ops-btn-ghost" @onclick="ClearFilters">Clear the filters</button>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <div class="ops-scroll">
                        <table class="ops-table ops-dt-table">
                            @* Six fixed columns totalling 682px; the
                               counterparty takes whatever is left. See
                               `.ops-dt-table` in operations.css. *@
                            <colgroup>
                                <col style="width: 112px" />
                                <col style="width: 132px" />
                                <col />
                                <col style="width: 88px" />
                                <col style="width: 118px" />
                                <col style="width: 116px" />
                                <col style="width: 116px" />
                            </colgroup>
                            <thead>
                                <tr>
                                    <th>Reference</th>
                                    <th>@TypeHeader</th>
                                    <th>@PartyHeader</th>
                                    <th>Submitted</th>
                                    <th class="ops-num">@ValueHeader</th>
                                    <th>SAP status</th>
                                    <th>SAP document</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var row in VisibleRows)
                                {
                                    <tr class="@(row.Key == _selectedKey ? "is-on" : null)" @key="row.Key"
                                        @onclick="() => SelectRow(row.Key)">
                                        <td class="ops-dt-cut" title="@row.Reference">@row.Reference</td>
                                        <td class="ops-dt-cut" title="@row.Kind">@row.Kind</td>
                                        <td class="ops-dt-cut" title="@row.PartyLine">
                                            <span class="ops-name">@row.Party</span>
                                            @if (!string.IsNullOrWhiteSpace(row.Site))
                                            {
                                                <span class="ops-sub"> · @row.Site</span>
                                            }
                                        </td>
                                        <td class="ops-dt-cut">@row.Submitted.ToString("HH:mm")</td>
                                        <td class="ops-num">@row.Value</td>
                                        <td>
                                            <span class="@($"ops-dt-state {ReadStatus(row.Status).Family}")">
                                                <span class="ops-dot"></span>@ReadStatus(row.Status).Label
                                            </span>
                                        </td>
                                        <td class="ops-dt-cut">@row.Document</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                    <div class="ops-foot">
                        <span class="ops-foot-info">
                            Showing @VisibleRows.Count of @RowsFor(_lane).Count · newest first ·
                            refreshed at @_lastSync.ToString("HH:mm:ss")
                        </span>
                    </div>
                }
            </div>
        </div>

        @if (Selected is { } sel)
        {
            <aside class="ops-dt-detail" aria-label="Transaction detail">
                <div class="ops-dt-detail-head">
                    <div>
                        <div class="ops-dt-detail-kind">@sel.Kind</div>
                        <div class="ops-dt-detail-ref">@sel.Reference</div>
                    </div>
                    <button type="button" class="ops-icon-btn ops-dt-detail-x" title="Close" aria-label="Close detail"
                            @onclick="() => _selectedKey = null">
                        <i class="ph ph-x" aria-hidden="true"></i>
                    </button>
                </div>

                <div class="ops-dt-facts">
                    @foreach (var fact in sel.Facts)
                    {
                        <div class="ops-dt-fact-k">@fact.Key</div>
                        <div class="ops-dt-fact-v">@fact.Value</div>
                    }
                </div>

                @if (sel.Log.Count > 0)
                {
                    <div class="ops-dt-rule"></div>
                    <div>
                        <div class="ops-dt-log-title">Sync log</div>
                        <div class="ops-dt-log">
                            @foreach (var entry in sel.Log)
                            {
                                <div class="ops-dt-log-row">
                                    <span class="ops-dt-log-t">@(entry.At?.ToString("HH:mm:ss") ?? "—")</span>
                                    <span class="@($"ops-dt-log-msg {entry.Family}")">@entry.Message</span>
                                </div>
                            }
                        </div>
                    </div>
                }

                @if (!string.IsNullOrWhiteSpace(sel.Error))
                {
                    <div class="ops-dt-err">@sel.Error</div>
                }

                @if (sel.CanRetry || sel.CanCancel)
                {
                    <div class="ops-dt-detail-acts">
                        @if (sel.CanRetry)
                        {
                            <button type="button" class="ops-btn ops-btn-primary" @onclick="() => RetrySelected(sel)">Retry sync</button>
                        }
                        @if (sel.CanCancel)
                        {
                            <button type="button" class="ops-btn ops-btn-danger" @onclick="() => CancelSelected(sel)">Cancel</button>
                        }
                    </div>
                }
            </aside>
        }
    </div>
</div>

@code {
    private const int PollSeconds = 60;
    private static readonly TimeSpan PollInterval = TimeSpan.FromSeconds(PollSeconds);

    private bool _isLoading = true;
    private bool _rowsLoaded;
    private Lane _lane = Lane.Invoices;
    private string? _selectedKey;
    private string _query = string.Empty;
    private string _statusFilter = string.Empty;
    private bool _filtersOpen;
    private DateTime _lastSync = DateTime.Now;

    private PeriodicTimer? _pollTimer;
    private CancellationTokenSource? _pollCancellation;
    private Task? _pollTask;

    private InvoiceQueueStatsDto? _stats;
    private InventoryTransferQueueStatsDto? _transferStats;

    private List<QueueRow> _invoices = [];
    private List<QueueRow> _invoiceReview = [];
    private List<QueueRow> _transfers = [];
    private List<QueueRow> _transferReview = [];
    private List<QueueRow> _reservations = [];

    private enum Lane { Invoices, Review, Transfers, TransferReview, Reservations }

    private static readonly Lane[] Lanes =
        [Lane.Invoices, Lane.Review, Lane.Transfers, Lane.TransferReview, Lane.Reservations];

    // ─── One shape for every lane ─────────────────────────────────────────
    // `Source` is the DTO the row came from; retry and cancel dispatch on it
    // rather than each row carrying its own closures.
    private sealed class QueueRow
    {
        public required string Key { get; init; }
        public required string Reference { get; init; }
        public required string Kind { get; init; }
        public required string Party { get; init; }
        public string? Site { get; init; }
        public DateTime Submitted { get; init; }
        public required string Value { get; init; }
        public required string Status { get; init; }
        public required string Document { get; init; }
        public string? Error { get; init; }
        public List<KeyValuePair<string, string>> Facts { get; init; } = [];
        public List<LogEntry> Log { get; init; } = [];
        public bool CanRetry { get; init; }
        public bool CanCancel { get; init; }
        public required object Source { get; init; }

        public string PartyLine => string.IsNullOrWhiteSpace(Site) ? Party : $"{Party} · {Site}";
    }

    private sealed record LogEntry(DateTime? At, string Message, string Family);

    // ─── Lifecycle ────────────────────────────────────────────────────────

    protected override async Task OnInitializedAsync()
    {
        await RefreshAll();
        StartPolling();
    }

    private void StartPolling()
    {
        _pollCancellation = new CancellationTokenSource();
        _pollTimer = new PeriodicTimer(PollInterval);
        _pollTask = PollAsync(_pollCancellation.Token);
    }

    // The hero says the page polls SAP every 60 seconds, so it does. A tick
    // that lands while a refresh is already running is skipped rather than
    // queued — the seven calls below are not cheap, and doubling them up only
    // makes the next tick later.
    private async Task PollAsync(CancellationToken cancellationToken)
    {
        if (_pollTimer is null)
        {
            return;
        }

        try
        {
            while (await _pollTimer.WaitForNextTickAsync(cancellationToken))
            {
                if (_isLoading)
                {
                    continue;
                }

                await InvokeAsync(() => RefreshAll(quiet: true));
            }
        }
        catch (OperationCanceledException)
        {
        }
    }

    public async ValueTask DisposeAsync()
    {
        _pollCancellation?.Cancel();
        _pollTimer?.Dispose();

        if (_pollTask is not null)
        {
            try
            {
                await _pollTask;
            }
            catch (OperationCanceledException)
            {
            }
        }

        _pollCancellation?.Dispose();
    }

    // ─── Loading ──────────────────────────────────────────────────────────

    private Task RefreshAll() => RefreshAll(quiet: false);

    private async Task RefreshAll(bool quiet)
    {
        _isLoading = true;
        StateHasChanged();

        try
        {
            var statsTask = DesktopService.GetQueueStatsAsync();
            var queueTask = DesktopService.GetPendingQueueAsync();
            var reviewTask = DesktopService.GetInvoicesRequiringReviewAsync();
            var reservationsTask = DesktopService.GetReservationsAsync(
                status: string.IsNullOrEmpty(_statusFilter) ? null : _statusFilter);
            var transferStatsTask = DesktopService.GetTransferQueueStatsAsync();
            var transferQueueTask = DesktopService.GetPendingTransferQueueAsync();
            var transferReviewTask = DesktopService.GetTransfersRequiringReviewAsync();

            await Task.WhenAll(statsTask, queueTask, reviewTask, reservationsTask,
                transferStatsTask, transferQueueTask, transferReviewTask);

            _stats = await statsTask;
            _transferStats = await transferStatsTask;
            _invoices = Project(await queueTask);
            _invoiceReview = Project(await reviewTask);
            _transfers = Project(await transferQueueTask);
            _transferReview = Project(await transferReviewTask);
            _reservations = Project(await reservationsTask);

            _rowsLoaded = true;
            _lastSync = DateTime.Now;
        }
        catch (Exception ex)
        {
            // A background tick that fails is not worth a toast on top of
            // whatever the person is reading; the "last sync" clock not moving
            // is the signal.
            if (!quiet)
            {
                Snackbar.Add($"Error loading data: {ex.Message}", Severity.Error);
            }
        }
        finally
        {
            _isLoading = false;
            StateHasChanged();
        }
    }

    // ─── Projection ───────────────────────────────────────────────────────

    private static List<QueueRow> Project(List<InvoiceQueueStatusDto>? source) =>
        (source ?? []).Select(ToRow).OrderByDescending(row => row.Submitted).ToList();

    private static List<QueueRow> Project(List<InventoryTransferQueueStatusDto>? source) =>
        (source ?? []).Select(ToRow).OrderByDescending(row => row.Submitted).ToList();

    private static List<QueueRow> Project(List<StockReservationDto>? source) =>
        (source ?? []).Select(ToRow).OrderByDescending(row => row.Submitted).ToList();

    private static QueueRow ToRow(InvoiceQueueStatusDto item)
    {
        var facts = new List<KeyValuePair<string, string>>
        {
            new("Customer", Dash(item.CustomerCode)),
            new("Warehouse", Dash(item.WarehouseCode)),
            new("Source system", Dash(item.SourceSystem)),
            new("Submitted at", item.CreatedAt.ToLocalTime().ToString("d MMM yyyy, HH:mm")),
            new("Value", $"{item.Currency} {item.TotalAmount:N2}"),
            new("SAP document", item.SapDocNum?.ToString() ?? "Not assigned"),
            new("SAP doc entry", Dash(item.SapDocEntry)),
            new("Reservation", Dash(item.ReservationId)),
            new("Retries", $"{item.RetryCount} of {item.MaxRetries}")
        };

        if (!string.IsNullOrWhiteSpace(item.FiscalDeviceNumber))
        {
            facts.Add(new("Fiscal device", item.FiscalDeviceNumber));
        }

        if (!string.IsNullOrWhiteSpace(item.FiscalReceiptNumber))
        {
            facts.Add(new("Fiscal receipt", item.FiscalReceiptNumber));
        }

        if (item.WaitTimeSeconds > 0)
        {
            facts.Add(new("Wait time", FormatWaitTime(item.WaitTimeSeconds)));
        }

        if (item.NextRetryAt.HasValue)
        {
            facts.Add(new("Next retry", item.NextRetryAt.Value.ToLocalTime().ToString("d MMM, HH:mm")));
        }

        return new QueueRow
        {
            Key = $"inv-{item.QueueId}",
            Reference = Dash(item.ExternalReference),
            Kind = Dash(item.SourceSystem),
            Party = Dash(item.CustomerCode),
            Site = item.WarehouseCode,
            Submitted = item.CreatedAt.ToLocalTime(),
            Value = $"{item.Currency} {item.TotalAmount:N2}",
            Status = item.Status,
            Document = item.SapDocNum?.ToString() ?? "—",
            Error = item.LastError,
            Facts = facts,
            Log = BuildLog(item.CreatedAt, item.ProcessingStartedAt, item.ProcessedAt, item.NextRetryAt,
                item.SourceSystem, item.SapDocNum, item.Status, item.RetryCount, item.MaxRetries),
            CanRetry = item.CanRetry,
            CanCancel = item.CanCancel,
            Source = item
        };
    }

    private static QueueRow ToRow(InventoryTransferQueueStatusDto item)
    {
        var facts = new List<KeyValuePair<string, string>>
        {
            new("From warehouse", Dash(item.FromWarehouse)),
            new("To warehouse", Dash(item.ToWarehouse)),
            new("Quantity", QuantityDisplay.Format(item.TotalQuantity)),
            new("Lines", item.LineCount.ToString()),
            new("Source system", Dash(item.SourceSystem)),
            new("Submitted at", item.CreatedAt.ToLocalTime().ToString("d MMM yyyy, HH:mm")),
            new("SAP document", item.SapDocNum?.ToString() ?? "Not assigned"),
            new("SAP doc entry", Dash(item.SapDocEntry)),
            new("Retries", $"{item.RetryCount} of {item.MaxRetries}")
        };

        if (item.WaitTimeSeconds > 0)
        {
            facts.Add(new("Wait time", FormatWaitTime(item.WaitTimeSeconds)));
        }

        if (item.NextRetryAt.HasValue)
        {
            facts.Add(new("Next retry", item.NextRetryAt.Value.ToLocalTime().ToString("d MMM, HH:mm")));
        }

        return new QueueRow
        {
            Key = $"trf-{item.QueueId}",
            Reference = Dash(item.ExternalReference),
            Kind = item.IsTransferRequest ? "Transfer request" : "Direct transfer",
            Party = $"{Dash(item.FromWarehouse)} → {Dash(item.ToWarehouse)}",
            Site = item.LineCount == 1 ? "1 line" : $"{item.LineCount} lines",
            Submitted = item.CreatedAt.ToLocalTime(),
            Value = QuantityDisplay.Format(item.TotalQuantity),
            Status = item.Status,
            Document = item.SapDocNum?.ToString() ?? "—",
            Error = item.LastError,
            Facts = facts,
            Log = BuildLog(item.CreatedAt, item.ProcessingStartedAt, item.ProcessedAt, item.NextRetryAt,
                item.SourceSystem, item.SapDocNum, item.Status, item.RetryCount, item.MaxRetries),
            CanRetry = item.CanRetry,
            CanCancel = item.CanCancel,
            Source = item
        };
    }

    private static QueueRow ToRow(StockReservationDto item)
    {
        var facts = new List<KeyValuePair<string, string>>
        {
            new("Customer", Dash(item.CardCode)),
            new("Name", Dash(item.CardName)),
            new("Document type", Dash(item.DocumentType)),
            new("Source system", Dash(item.SourceSystem)),
            new("Created by", Dash(item.CreatedBy)),
            new("Created", item.CreatedAt.ToLocalTime().ToString("d MMM yyyy, HH:mm")),
            new("Expires", item.ExpiresAt.ToLocalTime().ToString("d MMM yyyy, HH:mm")),
            new("SAP document", item.SAPDocNum?.ToString() ?? "Not assigned"),
            new("Reserved value", item.Lines.Sum(line => line.LineTotal).ToString("N2"))
        };

        var log = new List<LogEntry>
        {
            new(item.CreatedAt.ToLocalTime(), $"Reserved from {Dash(item.SourceSystem)}", "ops-fam-neutral")
        };

        if (item.ConfirmedAt.HasValue)
        {
            log.Add(new(item.ConfirmedAt.Value.ToLocalTime(),
                item.SAPDocNum.HasValue ? $"Confirmed as {item.SAPDocNum}" : "Confirmed", "ops-fam-good"));
        }

        if (item.CancelledAt.HasValue)
        {
            log.Add(new(item.CancelledAt.Value.ToLocalTime(), "Cancelled — stock released", "ops-fam-neutral"));
        }

        if (!item.ConfirmedAt.HasValue && !item.CancelledAt.HasValue)
        {
            log.Add(new(item.ExpiresAt.ToLocalTime(),
                item.ExpiresAt <= DateTime.UtcNow ? "Expired — stock released" : "Holds stock until", "ops-fam-warn"));
        }

        return new QueueRow
        {
            Key = $"res-{item.ReservationId}",
            Reference = Dash(item.ExternalReferenceId),
            Kind = Dash(item.DocumentType),
            Party = Dash(item.CardName ?? item.CardCode),
            Site = item.Lines.Count == 1 ? "1 item" : $"{item.Lines.Count} items",
            Submitted = item.CreatedAt.ToLocalTime(),
            Value = item.Lines.Sum(line => line.LineTotal).ToString("N2"),
            Status = item.Status,
            Document = item.SAPDocNum?.ToString() ?? "—",
            Facts = facts,
            Log = log,
            CanCancel = string.Equals(item.Status, "Pending", StringComparison.OrdinalIgnoreCase),
            Source = item
        };
    }

    // The queues carry no event stream, so the log is read off the timestamps
    // the row already has. Every line below is a stored value, not a guess.
    private static List<LogEntry> BuildLog(
        DateTime createdAt, DateTime? processingStartedAt, DateTime? processedAt, DateTime? nextRetryAt,
        string sourceSystem, int? sapDocNum, string status, int retryCount, int maxRetries)
    {
        var failed = status is "Failed" or "RequiresReview";

        var log = new List<LogEntry>
        {
            new(createdAt.ToLocalTime(), $"Submitted from {Dash(sourceSystem)}", "ops-fam-neutral")
        };

        if (processingStartedAt.HasValue)
        {
            log.Add(new(processingStartedAt.Value.ToLocalTime(), "Posting to SAP started", "ops-fam-info"));
        }

        if (processedAt.HasValue)
        {
            log.Add(sapDocNum.HasValue
                ? new(processedAt.Value.ToLocalTime(), $"Posted as {sapDocNum}", "ops-fam-good")
                : new(processedAt.Value.ToLocalTime(), "Rejected by SAP", "ops-fam-bad"));
        }

        if (retryCount > 0)
        {
            log.Add(new(null, $"Retry {retryCount} of {maxRetries} {(failed ? "failed" : "sent")}",
                failed ? "ops-fam-bad" : "ops-fam-info"));
        }

        if (nextRetryAt.HasValue)
        {
            log.Add(new(nextRetryAt.Value.ToLocalTime(), "Next retry scheduled", "ops-fam-warn"));
        }

        return log;
    }

    // ─── The lane on screen ───────────────────────────────────────────────

    private List<QueueRow> RowsFor(Lane lane) => lane switch
    {
        Lane.Invoices => _invoices,
        Lane.Review => _invoiceReview,
        Lane.Transfers => _transfers,
        Lane.TransferReview => _transferReview,
        _ => _reservations
    };

    private static string LaneLabel(Lane lane) => lane switch
    {
        Lane.Invoices => "Invoice queue",
        Lane.Review => "Needs review",
        Lane.Transfers => "Transfer queue",
        Lane.TransferReview => "Transfers need review",
        _ => "Stock reservations"
    };

    private string TypeHeader => _lane switch
    {
        Lane.Transfers or Lane.TransferReview => "Type",
        Lane.Reservations => "Document",
        _ => "Source"
    };

    private string PartyHeader => _lane switch
    {
        Lane.Transfers or Lane.TransferReview => "Route",
        _ => "Customer"
    };

    private string ValueHeader => _lane switch
    {
        Lane.Transfers or Lane.TransferReview => "Quantity",
        _ => "Value"
    };

    private bool IsFiltered => !string.IsNullOrWhiteSpace(_query) || !string.IsNullOrEmpty(_statusFilter);

    private List<QueueRow> VisibleRows
    {
        get
        {
            IEnumerable<QueueRow> rows = RowsFor(_lane);

            if (!string.IsNullOrEmpty(_statusFilter))
            {
                rows = rows.Where(row => string.Equals(row.Status, _statusFilter, StringComparison.OrdinalIgnoreCase));
            }

            var query = _query.Trim();
            if (query.Length > 0)
            {
                rows = rows.Where(row =>
                    row.Reference.Contains(query, StringComparison.OrdinalIgnoreCase)
                    || row.Kind.Contains(query, StringComparison.OrdinalIgnoreCase)
                    || row.Party.Contains(query, StringComparison.OrdinalIgnoreCase)
                    || (row.Site ?? string.Empty).Contains(query, StringComparison.OrdinalIgnoreCase));
            }

            return rows.ToList();
        }
    }

    // Only the statuses this lane can actually show, so the filter never
    // offers a choice that empties the table for no visible reason.
    private List<string> StatusOptions => RowsFor(_lane)
        .Select(row => row.Status)
        .Where(status => !string.IsNullOrWhiteSpace(status))
        .Distinct(StringComparer.OrdinalIgnoreCase)
        .OrderBy(status => status, StringComparer.OrdinalIgnoreCase)
        .ToList();

    private QueueRow? Selected => _selectedKey is null
        ? null
        : VisibleRows.FirstOrDefault(row => row.Key == _selectedKey);

    private string EmptyTitle => IsFiltered
        ? "Nothing matches those filters"
        : _lane switch
        {
            Lane.Review or Lane.TransferReview => "All clear",
            Lane.Transfers => "No transfers queued",
            Lane.Reservations => "No reservations found",
            _ => "No invoices queued"
        };

    private string EmptyBody => IsFiltered
        ? "Clear the search and the status filter to see the whole queue for this tab."
        : _lane switch
        {
            Lane.Review => "No invoices have failed often enough to need a person.",
            Lane.TransferReview => "No transfers have failed often enough to need a person.",
            Lane.Reservations => "Stock reservations taken by the desktop applications appear here until they are confirmed or expire.",
            _ => "Documents submitted from the desktop applications land here within a few seconds of being sent."
        };

    // ─── Interaction ──────────────────────────────────────────────────────

    private void SelectLane(Lane lane)
    {
        if (_lane == lane)
        {
            return;
        }

        _lane = lane;
        _selectedKey = null;
        // A status that exists in one lane rarely exists in the next, and a
        // filter that silently empties the tab you just opened reads as a bug.
        _statusFilter = string.Empty;
    }

    private void SelectRow(string key) => _selectedKey = _selectedKey == key ? null : key;

    private void OnQueryInput(ChangeEventArgs args)
    {
        _query = args.Value?.ToString() ?? string.Empty;
        _selectedKey = null;
    }

    // ReadStatus is the same helper the results table labels a row with, so the
    // menu and the rows can never disagree about what a raw status is called.
    private IEnumerable<NocturneSelectOption<string>> StatusFilterOptions =>
        StatusOptions
            .Select(status => new NocturneSelectOption<string>(status, ReadStatus(status).Label, "info"))
            .Prepend(NocturneSelectOption.All("All statuses"));

    private async Task OnStatusFilterChanged(string? status)
    {
        _statusFilter = status ?? string.Empty;
        _selectedKey = null;

        // Reservations are filtered by the API, not in the browser: the list
        // is paged server-side, so filtering only what arrived would hide rows
        // that match.
        if (_lane == Lane.Reservations)
        {
            await ReloadReservations();
        }
    }

    private void ClearFilters()
    {
        _query = string.Empty;
        _statusFilter = string.Empty;
        _selectedKey = null;
    }

    private async Task ReloadReservations()
    {
        _isLoading = true;
        StateHasChanged();

        try
        {
            _reservations = Project(await DesktopService.GetReservationsAsync(
                status: string.IsNullOrEmpty(_statusFilter) ? null : _statusFilter));
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error loading reservations: {ex.Message}", Severity.Error);
        }
        finally
        {
            _isLoading = false;
            StateHasChanged();
        }
    }

    private void GoToReview() =>
        SelectLane(_invoiceReview.Count == 0 && _transferReview.Count > 0 ? Lane.TransferReview : Lane.Review);

    // ─── Actions ──────────────────────────────────────────────────────────

    private async Task RetrySelected(QueueRow row)
    {
        var ok = row.Source switch
        {
            InvoiceQueueStatusDto invoice => await DesktopService.RetryQueuedInvoiceAsync(invoice.ExternalReference),
            InventoryTransferQueueStatusDto transfer => await DesktopService.RetryQueuedTransferAsync(transfer.ExternalReference),
            _ => false
        };

        Snackbar.Add(ok ? $"{row.Reference} queued for retry" : $"Failed to retry {row.Reference}",
            ok ? Severity.Success : Severity.Error);

        if (ok)
        {
            await RefreshAll();
        }
    }

    private async Task CancelSelected(QueueRow row)
    {
        var (title, body) = row.Source switch
        {
            InvoiceQueueStatusDto => ("Cancel invoice",
                $"Cancel the queued invoice '{row.Reference}'? This also releases the reserved stock."),
            InventoryTransferQueueStatusDto => ("Cancel transfer",
                $"Cancel the queued transfer '{row.Reference}'?"),
            _ => ("Cancel reservation",
                $"Cancel the reservation '{row.Reference}'? This releases the reserved stock.")
        };

        var confirmed = await DialogService.ShowMessageBoxAsync(title, body, yesText: "Cancel it", cancelText: "Keep");
        if (confirmed != true)
        {
            return;
        }

        var ok = row.Source switch
        {
            InvoiceQueueStatusDto invoice => await DesktopService.CancelQueuedInvoiceAsync(invoice.ExternalReference),
            InventoryTransferQueueStatusDto transfer => await DesktopService.CancelQueuedTransferAsync(transfer.ExternalReference),
            StockReservationDto reservation => await DesktopService.CancelReservationAsync(
                reservation.ReservationId, "Cancelled from web admin"),
            _ => false
        };

        Snackbar.Add(ok ? $"{row.Reference} cancelled" : $"Failed to cancel {row.Reference}",
            ok ? Severity.Success : Severity.Error);

        if (ok)
        {
            _selectedKey = null;
            await RefreshAll();
        }
    }

    // Every rejected document, resubmitted in one go. Confirmed first: this
    // posts N documents to SAP, and the banner is a single click away from
    // anywhere on the page.
    private async Task RetryAll()
    {
        var pending = _invoiceReview.Concat(_transferReview)
            .Concat(_invoices.Where(row => row.Status is "Failed" or "RequiresReview"))
            .Concat(_transfers.Where(row => row.Status is "Failed" or "RequiresReview"))
            .Where(row => row.CanRetry)
            .GroupBy(row => row.Key)
            .Select(group => group.First())
            .ToList();

        if (pending.Count == 0)
        {
            Snackbar.Add("Nothing here can be retried — those documents are out of attempts.", Severity.Info);
            return;
        }

        var confirmed = await DialogService.ShowMessageBoxAsync(
            "Retry all",
            $"Resubmit {pending.Count} rejected {(pending.Count == 1 ? "document" : "documents")} to SAP?",
            yesText: "Retry all",
            cancelText: "Not now");

        if (confirmed != true)
        {
            return;
        }

        var done = 0;
        foreach (var row in pending)
        {
            var ok = row.Source switch
            {
                InvoiceQueueStatusDto invoice => await DesktopService.RetryQueuedInvoiceAsync(invoice.ExternalReference),
                InventoryTransferQueueStatusDto transfer => await DesktopService.RetryQueuedTransferAsync(transfer.ExternalReference),
                _ => false
            };

            if (ok)
            {
                done++;
            }
        }

        Snackbar.Add(
            done == pending.Count
                ? $"{done} {(done == 1 ? "document" : "documents")} queued for retry"
                : $"{done} of {pending.Count} queued for retry — the rest were rejected outright",
            done == pending.Count ? Severity.Success : Severity.Warning);

        await RefreshAll();
    }

    // ─── The banner ───────────────────────────────────────────────────────

    private int RejectedCount =>
        (_stats?.Failed ?? 0) + (_stats?.RequiresReview ?? 0)
        + (_transferStats?.Failed ?? 0) + (_transferStats?.RequiresReview ?? 0);

    private DateTime? OldestRejected => _invoiceReview
        .Concat(_transferReview)
        .Concat(_invoices.Where(row => row.Status is "Failed" or "RequiresReview"))
        .Concat(_transfers.Where(row => row.Status is "Failed" or "RequiresReview"))
        .Select(row => (DateTime?)row.Submitted)
        .Min();

    // ─── Helpers ──────────────────────────────────────────────────────────

    // The eight queue states, read down onto the five the design draws.
    // Confirmed and Fiscalized both mean SAP has the document; Expired and
    // Cancelled both mean it never will.
    private static (string Label, string Family) ReadStatus(string? status) => status?.ToLowerInvariant() switch
    {
        "pending" => ("Queued", "ops-fam-neutral"),
        "processing" => ("Posting", "ops-fam-info"),
        "completed" or "confirmed" => ("Posted", "ops-fam-good"),
        "fiscalized" => ("Fiscalized", "ops-fam-good"),
        "failed" => ("Failed", "ops-fam-bad"),
        "requiresreview" => ("Needs review", "ops-fam-bad"),
        "cancelled" => ("Cancelled", "ops-fam-neutral"),
        "expired" => ("Expired", "ops-fam-neutral"),
        _ => (string.IsNullOrWhiteSpace(status) ? "Unknown" : status, "ops-fam-neutral")
    };

    private static string Dash(string? value) => string.IsNullOrWhiteSpace(value) ? "—" : value;

    private static string FormatWaitTime(int seconds)
    {
        if (seconds < 60) return $"{seconds}s";
        if (seconds < 3600) return $"{seconds / 60}m {seconds % 60}s";
        return $"{seconds / 3600}h {seconds % 3600 / 60}m";
    }

    private static string Share(int part, int total) =>
        total <= 0 ? "0%" : ((double)part / total * 100).ToString("0.#") + "%";

    private RenderFragment RenderQueueCard(
        string icon, string label, string noun, int total,
        int queued, int posting, int posted, int failed, int cancelled) => @<div class="ops-panel ops-dt-queue">
        <div class="ops-dt-queue-head">
            <i class="ph @icon" aria-hidden="true"></i>
            <span>@label</span>
            <div class="ops-dt-queue-total">
                <b>@total.ToString("N0")</b>
                <span>@noun</span>
            </div>
        </div>
        <div class="ops-dt-lane">
            <div class="ops-dt-lane-fig ops-fam-neutral">
                <div class="ops-dt-lane-n">@queued.ToString("N0")</div>
                <div class="ops-dt-lane-k"><span class="ops-dot"></span>Queued</div>
            </div>
            <div class="ops-dt-lane-fig ops-fam-info">
                <div class="ops-dt-lane-n">@posting.ToString("N0")</div>
                <div class="ops-dt-lane-k"><span class="ops-dot"></span>Posting</div>
            </div>
            <div class="ops-dt-lane-fig ops-fam-good">
                <div class="ops-dt-lane-n">@posted.ToString("N0")</div>
                <div class="ops-dt-lane-k"><span class="ops-dot"></span>Posted</div>
            </div>
            <div class="ops-dt-lane-fig ops-fam-bad">
                <div class="ops-dt-lane-n">@failed.ToString("N0")</div>
                <div class="ops-dt-lane-k"><span class="ops-dot"></span>Failed</div>
            </div>
            <div class="ops-dt-lane-fig ops-fam-neutral">
                <div class="ops-dt-lane-n">@cancelled.ToString("N0")</div>
                <div class="ops-dt-lane-k"><span class="ops-dot"></span>Cancelled</div>
            </div>
        </div>
        @* Five segments, not four: the five figures above are every status the
           queue has, so the bar and the total agree. *@
        <div class="ops-dt-bar" aria-hidden="true">
            <span class="ops-fam-good" style="width: @Share(posted, total)"></span>
            <span class="ops-fam-info" style="width: @Share(posting, total)"></span>
            <span class="ops-fam-neutral" style="width: @Share(queued, total)"></span>
            <span class="ops-fam-bad" style="width: @Share(failed, total)"></span>
            <span class="ops-fam-neutral" style="width: @Share(cancelled, total); opacity: .45"></span>
        </div>
    </div>;
}
