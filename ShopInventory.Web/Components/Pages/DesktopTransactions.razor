@page "/desktop-transactions"
@using Microsoft.AspNetCore.Authorization
@using ShopInventory.Web.Services
@attribute [Authorize(Roles = "Admin")]
@inject IDesktopIntegrationService DesktopService
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@rendermode InteractiveServer
<PageTitle>Desktop Transactions - Shop Inventory</PageTitle>
@* Styles live in wwwroot/css/operations.css (linked from App.razor), shared
   with the other four operational pages — see that file's header. `ops` is the
   scope; `ops-dt` is this page's own half of it.
   The five MudDataGrids stay. They carry this page's sorting, filtering and
   cell templates, and lifting that out to hand-written tables would be a large
   behavioural change made for a visual reason — so the page's own chrome moved
   to the Nocturne vocabulary and the Mud surfaces are skinned from `.ops-dt`
   instead. The 155-line inline <style> block is gone.
   The file was also double-spaced: 2,964 of its 4,358 lines were blank, which
   is the only reason it read as the largest page in the app. *@

<div class="ops ops-dt">
        <div class="ops-hero">
        <div class="ops-hero-text">
            <div class="ops-kicker">Desktop sync</div>
            <h1>Desktop Transactions</h1>
            <p>
                Invoices, transfers and reservations submitted from the desktop applications,
                and what SAP has done with each one.
            </p>
        </div>
        <div class="ops-hero-actions">
            <button type="button" class="ops-btn ops-btn-primary" @onclick="RefreshAll" disabled="@_isLoading">
                @if (_isLoading)
                {
                    <span class="ops-spin"></span>
                    <span>Refreshing&hellip;</span>
                }
                else
                {
                    <i class="ph ph-arrows-clockwise" aria-hidden="true"></i>
                    <span>Refresh</span>
                }
            </button>
        </div>
    </div>
    @* ─── Dashboard Banner: compact pill-style stats ─── *@
    <div class="ops-dt-queues">
        @if (_stats != null)
        {
            <div class="ops-panel ops-dt-queue">
                <div class="ops-dt-queue-head">
                    <i class="ph ph-receipt" aria-hidden="true"></i>
                    Invoice Queue
                </div>
                <div class="ops-dt-pills">
                    <button type="button" class="ops-dt-pill ops-fam-warn" @onclick="@(() => NavigateToTab(0))" title="View pending invoices">
                        <span class="ops-dt-pill-count">@_stats.Pending</span> Pending
                    </button>
                    <button type="button" class="ops-dt-pill ops-fam-info" @onclick="@(() => NavigateToTab(0))" title="View processing invoices">
                        <span class="ops-dt-pill-count">@_stats.Processing</span> Processing
                    </button>
                    <button type="button" class="ops-dt-pill ops-fam-good" @onclick="@(() => NavigateToTab(0))" title="View completed invoices">
                        <span class="ops-dt-pill-count">@_stats.Completed</span> Completed
                    </button>
                    <button type="button" class="ops-dt-pill ops-fam-bad" @onclick="@(() => NavigateToTab(0))" title="View failed invoices">
                        <span class="ops-dt-pill-count">@_stats.Failed</span> Failed
                    </button>
                    @if (_stats.RequiresReview > 0)
                    {
                        <button type="button" class="ops-dt-pill ops-fam-accent" @onclick="@(() => NavigateToTab(1))" title="View invoices needing review">
                            <span class="ops-dt-pill-count">@_stats.RequiresReview</span> Review
                        </button>
                    }
                    <button type="button" class="ops-dt-pill ops-fam-neutral" @onclick="@(() => NavigateToTab(0))" title="View all invoices">
                        <span class="ops-dt-pill-count">@_stats.TotalQueued</span> Total
                    </button>
                </div>
            </div>
        }
        @if (_transferStats != null)
        {
            <div class="ops-panel ops-dt-queue">
                <div class="ops-dt-queue-head">
                    <i class="ph ph-arrows-left-right" aria-hidden="true"></i>
                    Transfer Queue
                </div>
                <div class="ops-dt-pills">
                    <button type="button" class="ops-dt-pill ops-fam-warn" @onclick="@(() => NavigateToTab(2))" title="View pending transfers">
                        <span class="ops-dt-pill-count">@_transferStats.Pending</span> Pending
                    </button>
                    <button type="button" class="ops-dt-pill ops-fam-info" @onclick="@(() => NavigateToTab(2))" title="View processing transfers">
                        <span class="ops-dt-pill-count">@_transferStats.Processing</span> Processing
                    </button>
                    <button type="button" class="ops-dt-pill ops-fam-good" @onclick="@(() => NavigateToTab(2))" title="View completed transfers">
                        <span class="ops-dt-pill-count">@_transferStats.Completed</span> Completed
                    </button>
                    <button type="button" class="ops-dt-pill ops-fam-bad" @onclick="@(() => NavigateToTab(2))" title="View failed transfers">
                        <span class="ops-dt-pill-count">@_transferStats.Failed</span> Failed
                    </button>
                    @if (_transferStats.RequiresReview > 0)
                    {
                        <button type="button" class="ops-dt-pill ops-fam-accent" @onclick="@(() => NavigateToTab(3))" title="View transfers needing review">
                            <span class="ops-dt-pill-count">@_transferStats.RequiresReview</span> Review
                        </button>
                    }
                    <button type="button" class="ops-dt-pill ops-fam-neutral" @onclick="@(() => NavigateToTab(2))" title="View all transfers">
                        <span class="ops-dt-pill-count">@_transferStats.TotalQueued</span> Total
                    </button>
                </div>
            </div>
        }
    </div>
    @* ─── Tabs ─── *@
    <MudPaper Elevation="0" Class="mt-2" Style="border: 1px solid rgba(0,0,0,0.08); border-radius: 12px; overflow: hidden;">
        <MudTabs Elevation="0" Rounded="false" ApplyEffectsToContainer="true" TabPanelsClass="pa-4"
            @bind-ActivePanelIndex="_activeTab" Color="Color.Transparent" SliderColor="Color.Primary"
            TabHeaderClass="ops-dt-tabhead">
            @* ═══ Invoice Queue Tab ═══ *@
            <MudTabPanel Text="Invoice Queue" Icon="@Icons.Material.Outlined.Queue" BadgeData="@_queuedInvoices?.Count"
                BadgeColor="Color.Primary">
                @if (_isLoading)
                {
                    <MudProgressLinear Indeterminate="true" Color="Color.Primary" Class="my-2" Style="border-radius: 4px;" />
                }
                else if (_queuedInvoices == null || !_queuedInvoices.Any())
                {
                    <div class="ops-empty">
    <i class="ph ph-tray" aria-hidden="true"></i>
    <h3>No queued invoices</h3>
    <p>Desktop invoice submissions will appear here</p>
</div>
                }
                else
                {
                    <MudDataGrid T="InvoiceQueueStatusDto" Items="@_queuedInvoices" SortMode="SortMode.Multiple"
                        Filterable="true" Hover="true" Dense="true" Bordered="false"
                        RowStyle="font-size: 0.875rem;" HeaderClass="dt-grid-header"
                        RowClick="@((DataGridRowClickEventArgs<InvoiceQueueStatusDto> args) => ToggleInvoiceExpand(args.Item))">
                        <Columns>
                            <TemplateColumn Title="" Sortable="false" Filterable="false" CellStyle="width: 40px; padding: 4px 8px;">
                                <CellTemplate>
                                    <MudIconButton Icon="@(_expandedInvoiceId == context.Item.QueueId ? Icons.Material.Filled.ExpandLess : Icons.Material.Filled.ExpandMore)"
                                        Size="Size.Small"
                                        OnClick="@(() => ToggleInvoiceExpand(context.Item))" />
                                </CellTemplate>
                            </TemplateColumn>
                            <PropertyColumn Property="x => x.ExternalReference" Title="Reference">
                                <CellTemplate>
                                    <MudText Typo="Typo.body2" Style="font-weight: 600;">@context.Item.ExternalReference</MudText>
                                </CellTemplate>
                            </PropertyColumn>
                            <PropertyColumn Property="x => x.CustomerCode" Title="Customer" />
                            <PropertyColumn Property="x => x.Status" Title="Status">
                                <CellTemplate>
                                    <span class="ops-badge @GetStatusFamily(context.Item.Status)">@context.Item.Status</span>
                                </CellTemplate>
                            </PropertyColumn>
                            <PropertyColumn Property="x => x.TotalAmount" Title="Amount" Format="N2">
                                <CellTemplate>
                                    <MudText Typo="Typo.body2" Style="font-variant-numeric: tabular-nums;">
                                        @context.Item.Currency @context.Item.TotalAmount.ToString("N2")
                                    </MudText>
                                </CellTemplate>
                            </PropertyColumn>
                            <PropertyColumn Property="x => x.SapDocNum" Title="SAP Doc#">
                                <CellTemplate>
                                    @if (context.Item.SapDocNum.HasValue)
                                    {
                                        <MudChip T="string" Size="Size.Small" Color="Color.Success" Variant="Variant.Outlined"
                                            Style="font-size: 0.75rem;">@context.Item.SapDocNum</MudChip>
                                    }
                                    else
                                    {
                                        <MudText Typo="Typo.caption" Color="Color.Secondary">&mdash;</MudText>
                                    }
                                </CellTemplate>
                            </PropertyColumn>
                            <PropertyColumn Property="x => x.CreatedAt" Title="Created" Format="g">
                                <CellTemplate>
                                    <MudText Typo="Typo.caption" Color="Color.Secondary">@context.Item.CreatedAt.ToLocalTime().ToString("g")</MudText>
                                </CellTemplate>
                            </PropertyColumn>
                            <TemplateColumn Title="Actions" Sortable="false">
                                <CellTemplate>
                                    <MudStack Row="true" Spacing="0">
                                        @if (context.Item.CanRetry)
                                        {
                                            <MudTooltip Text="Retry">
                                                <MudIconButton Icon="@Icons.Material.Outlined.Replay" Size="Size.Small"
                                                    Color="Color.Primary" OnClick="@(() => RetryInvoice(context.Item))" />
                                            </MudTooltip>
                                        }
                                        @if (context.Item.CanCancel)
                                        {
                                            <MudTooltip Text="Cancel">
                                                <MudIconButton Icon="@Icons.Material.Outlined.Close" Size="Size.Small"
                                                    Color="Color.Error" OnClick="@(() => CancelQueuedInvoice(context.Item))" />
                                            </MudTooltip>
                                        }
                                    </MudStack>
                                </CellTemplate>
                            </TemplateColumn>
                        </Columns>
                        <ChildRowContent>
                            @if (_expandedInvoiceId == context.Item.QueueId)
                            {
                                <td colspan="100">
                                    <div class="ops-dt-expand">
                                        <div class="ops-dt-expand-title">Invoice Details</div>
                                        <div class="ops-dt-mini">
                                            <div>
                                                <div class="ops-dt-mini-k">External Reference</div>
                                                <div class="ops-dt-mini-v">@context.Item.ExternalReference</div>
                                            </div>
                                            <div>
                                                <div class="ops-dt-mini-k">Reservation ID</div>
                                                <div class="ops-dt-mini-v">@(string.IsNullOrEmpty(context.Item.ReservationId) ? "—" : context.Item.ReservationId)</div>
                                            </div>
                                            <div>
                                                <div class="ops-dt-mini-k">Customer</div>
                                                <div class="ops-dt-mini-v">@context.Item.CustomerCode</div>
                                            </div>
                                            <div>
                                                <div class="ops-dt-mini-k">Amount</div>
                                                <div class="ops-dt-mini-v">@context.Item.Currency @context.Item.TotalAmount.ToString("N2")</div>
                                            </div>
                                            <div>
                                                <div class="ops-dt-mini-k">Warehouse</div>
                                                <div class="ops-dt-mini-v">@(context.Item.WarehouseCode ?? "—")</div>
                                            </div>
                                            <div>
                                                <div class="ops-dt-mini-k">SAP Document</div>
                                                <div class="ops-dt-mini-v">@(context.Item.SapDocNum?.ToString() ?? "Not yet posted")</div>
                                            </div>
                                            <div>
                                                <div class="ops-dt-mini-k">SAP Doc Entry</div>
                                                <div class="ops-dt-mini-v">@(context.Item.SapDocEntry ?? "—")</div>
                                            </div>
                                            <div>
                                                <div class="ops-dt-mini-k">Source System</div>
                                                <div class="ops-dt-mini-v">@context.Item.SourceSystem</div>
                                            </div>
                                            <div>
                                                <div class="ops-dt-mini-k">Status</div>
                                                <div class="ops-dt-mini-v"><span class="ops-badge @GetStatusFamily(context.Item.Status)">@context.Item.Status</span></div>
                                            </div>
                                            <div>
                                                <div class="ops-dt-mini-k">Retry Count</div>
                                                <div class="ops-dt-mini-v">@context.Item.RetryCount / @context.Item.MaxRetries</div>
                                            </div>
                                            <div>
                                                <div class="ops-dt-mini-k">Created</div>
                                                <div class="ops-dt-mini-v">@context.Item.CreatedAt.ToLocalTime().ToString("F")</div>
                                            </div>
                                            @if (context.Item.ProcessingStartedAt.HasValue)
                                            {
                                                <div>
                                                    <div class="ops-dt-mini-k">Processing Started</div>
                                                    <div class="ops-dt-mini-v">@context.Item.ProcessingStartedAt.Value.ToLocalTime().ToString("F")</div>
                                                </div>
                                            }
                                            @if (context.Item.ProcessedAt.HasValue)
                                            {
                                                <div>
                                                    <div class="ops-dt-mini-k">Processed At</div>
                                                    <div class="ops-dt-mini-v">@context.Item.ProcessedAt.Value.ToLocalTime().ToString("F")</div>
                                                </div>
                                            }
                                            @if (context.Item.NextRetryAt.HasValue)
                                            {
                                                <div>
                                                    <div class="ops-dt-mini-k">Next Retry</div>
                                                    <div class="ops-dt-mini-v">@context.Item.NextRetryAt.Value.ToLocalTime().ToString("g")</div>
                                                </div>
                                            }
                                            @if (!string.IsNullOrEmpty(context.Item.FiscalDeviceNumber))
                                            {
                                                <div>
                                                    <div class="ops-dt-mini-k">Fiscal Device</div>
                                                    <div class="ops-dt-mini-v">@context.Item.FiscalDeviceNumber</div>
                                                </div>
                                            }
                                            @if (!string.IsNullOrEmpty(context.Item.FiscalReceiptNumber))
                                            {
                                                <div>
                                                    <div class="ops-dt-mini-k">Fiscal Receipt</div>
                                                    <div class="ops-dt-mini-v">@context.Item.FiscalReceiptNumber</div>
                                                </div>
                                            }
                                            @if (context.Item.WaitTimeSeconds > 0)
                                            {
                                                <div>
                                                    <div class="ops-dt-mini-k">Wait Time</div>
                                                    <div class="ops-dt-mini-v">@FormatWaitTime(context.Item.WaitTimeSeconds)</div>
                                                </div>
                                            }
                                        </div>
                                        @if (!string.IsNullOrEmpty(context.Item.LastError))
                                        {
                                            <MudAlert Severity="Severity.Error" Dense="true" Variant="Variant.Outlined" Class="mt-3"
                                                Style="border-radius: 8px; font-size: 0.8125rem;">
                                                <strong>Last Error:</strong> @context.Item.LastError
                                            </MudAlert>
                                        }
                                        <MudStack Row="true" Spacing="2" Class="mt-3">
                                            @if (context.Item.CanRetry)
                                            {
                                                <MudButton Variant="Variant.Filled" Size="Size.Small" Color="Color.Primary"
                                                    StartIcon="@Icons.Material.Outlined.Replay"
                                                    OnClick="@(() => RetryInvoice(context.Item))"
                                                    Style="border-radius: 6px; text-transform: none; font-weight: 600;">
                                                    Retry
                                                </MudButton>
                                            }
                                            @if (context.Item.CanCancel)
                                            {
                                                <MudButton Variant="Variant.Outlined" Size="Size.Small" Color="Color.Error"
                                                    StartIcon="@Icons.Material.Outlined.Close"
                                                    OnClick="@(() => CancelQueuedInvoice(context.Item))"
                                                    Style="border-radius: 6px; text-transform: none; font-weight: 600;">
                                                    Cancel
                                                </MudButton>
                                            }
                                        </MudStack>
                                    </div>
                                </td>
                            }
                        </ChildRowContent>
                    </MudDataGrid>
                }
            </MudTabPanel>
            @* ═══ Needs Review Tab ═══ *@
            <MudTabPanel Text="Needs Review" Icon="@Icons.Material.Outlined.ErrorOutline" BadgeData="@_reviewInvoices?.Count"
                BadgeColor="Color.Error">
                @if (_isLoading)
                {
                    <MudProgressLinear Indeterminate="true" Color="Color.Primary" Class="my-2" Style="border-radius: 4px;" />
                }
                else if (_reviewInvoices == null || !_reviewInvoices.Any())
                {
                    <div class="ops-empty">
    <i class="ph ph-check-circle" aria-hidden="true"></i>
    <h3>All clear</h3>
    <p>No invoices require manual review</p>
</div>
                }
                else
                {
                    <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined" Dense="true" Class="mb-4"
                        Style="border-radius: 8px;">
                        These invoices have failed multiple times and require manual intervention.
                    </MudAlert>
                    <MudDataGrid T="InvoiceQueueStatusDto" Items="@_reviewInvoices" SortMode="SortMode.Multiple" Hover="true"
                        Dense="true" Bordered="false"
                        RowClick="@((DataGridRowClickEventArgs<InvoiceQueueStatusDto> args) => ToggleInvoiceExpand(args.Item))">
                        <Columns>
                            <TemplateColumn Title="" Sortable="false" Filterable="false" CellStyle="width: 40px; padding: 4px 8px;">
                                <CellTemplate>
                                    <MudIconButton Icon="@(_expandedInvoiceId == context.Item.QueueId ? Icons.Material.Filled.ExpandLess : Icons.Material.Filled.ExpandMore)"
                                        Size="Size.Small"
                                        OnClick="@(() => ToggleInvoiceExpand(context.Item))" />
                                </CellTemplate>
                            </TemplateColumn>
                            <PropertyColumn Property="x => x.ExternalReference" Title="Reference">
                                <CellTemplate>
                                    <MudText Typo="Typo.body2" Style="font-weight: 600;">@context.Item.ExternalReference</MudText>
                                </CellTemplate>
                            </PropertyColumn>
                            <PropertyColumn Property="x => x.CustomerCode" Title="Customer" />
                            <PropertyColumn Property="x => x.TotalAmount" Title="Amount">
                                <CellTemplate>
                                    <MudText Typo="Typo.body2" Style="font-variant-numeric: tabular-nums;">
                                        @context.Item.Currency @context.Item.TotalAmount.ToString("N2")
                                    </MudText>
                                </CellTemplate>
                            </PropertyColumn>
                            <PropertyColumn Property="x => x.LastError" Title="Last Error">
                                <CellTemplate>
                                    <MudTooltip Text="@context.Item.LastError">
                                        <MudText Typo="Typo.caption"
                                            Style="max-width: 250px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; color: #ef4444;">
                                            @(context.Item.LastError?.Length > 60 ? context.Item.LastError.Substring(0, 60) + "..." : context.Item.LastError)
                                        </MudText>
                                    </MudTooltip>
                                </CellTemplate>
                            </PropertyColumn>
                            <PropertyColumn Property="x => x.CreatedAt" Title="Created">
                                <CellTemplate>
                                    <MudText Typo="Typo.caption" Color="Color.Secondary">@context.Item.CreatedAt.ToLocalTime().ToString("g")</MudText>
                                </CellTemplate>
                            </PropertyColumn>
                            <TemplateColumn Title="Actions" Sortable="false">
                                <CellTemplate>
                                    <MudStack Row="true" Spacing="1">
                                        <MudButton Variant="Variant.Filled" Size="Size.Small" Color="Color.Primary"
                                            StartIcon="@Icons.Material.Outlined.Replay"
                                            OnClick="@(() => RetryInvoice(context.Item))"
                                            Style="border-radius: 6px; text-transform: none; font-weight: 600; font-size: 0.75rem;">
                                            Retry
                                        </MudButton>
                                        <MudButton Variant="Variant.Outlined" Size="Size.Small" Color="Color.Error"
                                            StartIcon="@Icons.Material.Outlined.Close"
                                            OnClick="@(() => CancelQueuedInvoice(context.Item))"
                                            Style="border-radius: 6px; text-transform: none; font-weight: 600; font-size: 0.75rem;">
                                            Cancel
                                        </MudButton>
                                    </MudStack>
                                </CellTemplate>
                            </TemplateColumn>
                        </Columns>
                        <ChildRowContent>
                            @if (_expandedInvoiceId == context.Item.QueueId)
                            {
                                <td colspan="100">
                                    <div class="ops-dt-expand">
                                        <div class="ops-dt-expand-title">Full Details</div>
                                        <div class="ops-dt-mini">
                                            <div>
                                                <div class="ops-dt-mini-k">External Reference</div>
                                                <div class="ops-dt-mini-v">@context.Item.ExternalReference</div>
                                            </div>
                                            <div>
                                                <div class="ops-dt-mini-k">Reservation ID</div>
                                                <div class="ops-dt-mini-v">@(string.IsNullOrEmpty(context.Item.ReservationId) ? "—" : context.Item.ReservationId)</div>
                                            </div>
                                            <div>
                                                <div class="ops-dt-mini-k">Customer</div>
                                                <div class="ops-dt-mini-v">@context.Item.CustomerCode</div>
                                            </div>
                                            <div>
                                                <div class="ops-dt-mini-k">Amount</div>
                                                <div class="ops-dt-mini-v">@context.Item.Currency @context.Item.TotalAmount.ToString("N2")</div>
                                            </div>
                                            <div>
                                                <div class="ops-dt-mini-k">Warehouse</div>
                                                <div class="ops-dt-mini-v">@(context.Item.WarehouseCode ?? "—")</div>
                                            </div>
                                            <div>
                                                <div class="ops-dt-mini-k">SAP Document</div>
                                                <div class="ops-dt-mini-v">@(context.Item.SapDocNum?.ToString() ?? "Not yet posted")</div>
                                            </div>
                                            <div>
                                                <div class="ops-dt-mini-k">Source System</div>
                                                <div class="ops-dt-mini-v">@context.Item.SourceSystem</div>
                                            </div>
                                            <div>
                                                <div class="ops-dt-mini-k">Retry Count</div>
                                                <div class="ops-dt-mini-v">@context.Item.RetryCount / @context.Item.MaxRetries</div>
                                            </div>
                                            <div>
                                                <div class="ops-dt-mini-k">Created</div>
                                                <div class="ops-dt-mini-v">@context.Item.CreatedAt.ToLocalTime().ToString("F")</div>
                                            </div>
                                            @if (context.Item.NextRetryAt.HasValue)
                                            {
                                                <div>
                                                    <div class="ops-dt-mini-k">Next Retry</div>
                                                    <div class="ops-dt-mini-v">@context.Item.NextRetryAt.Value.ToLocalTime().ToString("g")</div>
                                                </div>
                                            }
                                        </div>
                                        @if (!string.IsNullOrEmpty(context.Item.LastError))
                                        {
                                            <MudAlert Severity="Severity.Error" Dense="true" Variant="Variant.Outlined" Class="mt-3"
                                                Style="border-radius: 8px; font-size: 0.8125rem;">
                                                <strong>Last Error:</strong> @context.Item.LastError
                                            </MudAlert>
                                        }
                                    </div>
                                </td>
                            }
                        </ChildRowContent>
                    </MudDataGrid>
                }
            </MudTabPanel>
            @* ═══ Transfer Queue Tab ═══ *@
            <MudTabPanel Text="Transfer Queue" Icon="@Icons.Material.Outlined.SwapHoriz" BadgeData="@_queuedTransfers?.Count"
                BadgeColor="Color.Info">
                @if (_isLoading)
                {
                    <MudProgressLinear Indeterminate="true" Color="Color.Primary" Class="my-2" Style="border-radius: 4px;" />
                }
                else if (_queuedTransfers == null || !_queuedTransfers.Any())
                {
                    <div class="ops-empty">
    <i class="ph ph-tray" aria-hidden="true"></i>
    <h3>No queued transfers</h3>
    <p>Desktop inventory transfers will appear here</p>
</div>
                }
                else
                {
                    <MudDataGrid T="InventoryTransferQueueStatusDto" Items="@_queuedTransfers" SortMode="SortMode.Multiple"
                        Filterable="true" Hover="true" Dense="true" Bordered="false"
                        RowClick="@((DataGridRowClickEventArgs<InventoryTransferQueueStatusDto> args) => ToggleTransferExpand(args.Item))">
                        <Columns>
                            <TemplateColumn Title="" Sortable="false" Filterable="false" CellStyle="width: 40px; padding: 4px 8px;">
                                <CellTemplate>
                                    <MudIconButton Icon="@(_expandedTransferId == context.Item.QueueId ? Icons.Material.Filled.ExpandLess : Icons.Material.Filled.ExpandMore)"
                                        Size="Size.Small"
                                        OnClick="@(() => ToggleTransferExpand(context.Item))" />
                                </CellTemplate>
                            </TemplateColumn>
                            <PropertyColumn Property="x => x.ExternalReference" Title="Reference">
                                <CellTemplate>
                                    <MudText Typo="Typo.body2" Style="font-weight: 600;">@context.Item.ExternalReference</MudText>
                                </CellTemplate>
                            </PropertyColumn>
                            <PropertyColumn Property="x => x.FromWarehouse" Title="From" />
                            <PropertyColumn Property="x => x.ToWarehouse" Title="To" />
                            <PropertyColumn Property="x => x.Status" Title="Status">
                                <CellTemplate>
                                    <span class="ops-badge @GetStatusFamily(context.Item.Status)">@context.Item.Status</span>
