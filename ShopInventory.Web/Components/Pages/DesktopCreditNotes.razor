@page "/desktop-credit-notes"
@using System.Globalization
@using Microsoft.AspNetCore.Authorization
@using ShopInventory.Web.Features.DesktopCreditNotes
@using ShopInventory.Web.Features.DesktopSalesDay
@attribute [Authorize(Roles = "Admin,Cashier,Manager")]
@inject IDesktopIntegrationService DesktopIntegrationService
@rendermode InteractiveServer

<PageTitle>Desktop Credit Notes - Shop Inventory</PageTitle>

@* Laid out as /desktop-sales is: the same hero, summary cards, filter bar, list bar, table and
   drawer, so the credit list reads as the other half of that page rather than a page of its own.
   It wears `ops-ds` for that vocabulary, and `.ops-dcl` (at the foot of operations.css) for the
   few rules only this list needs. Not `ops-dcn` — that prefix is the credit dialog's. *@

<div class="ops ops-ds ops-dcl">

    <div class="ops-hero">
        <div class="ops-hero-text">
            <div class="ops-ds-kicker-row">
                <span class="ops-kicker">Tills &amp; Vending</span>
                <span class="ops-ds-kicker-rule"></span>
            </div>
            <h1>Desktop Credit Notes</h1>
            <p>
                Every credit raised against a till, vending or van sale, with where it stands at ZIMRA and in
                SAP. The SAP credit memo follows once the sale has posted.
            </p>
        </div>

        <div class="ops-ds-hero-side">
            <div class="ops-ds-poll">
                <div class="ops-ds-poll-now">
                    @(loadedAt.HasValue ? $"Loaded {loadedAt:HH:mm:ss}" : "Not loaded yet")
                </div>
                <div class="ops-ds-poll-then">@periodLabel</div>
            </div>
            <div class="ops-hero-actions">
                <a class="ops-btn ops-btn-ghost" href="/desktop-sales">
                    <i class="ph ph-receipt" aria-hidden="true"></i>
                    <span>Desktop sales</span>
                </a>
                <button type="button" class="ops-icon-btn" title="Refresh" aria-label="Refresh"
                        @onclick="LoadAsync" disabled="@loading">
                    @if (loading)
                    {
                        <span class="ops-spin"></span>
                    }
                    else
                    {
                        <i class="ph ph-arrows-clockwise" aria-hidden="true"></i>
                    }
                </button>
            </div>
        </div>
    </div>

    <div class="ops-rule-fade"></div>

    @if (response is not null)
    {
        @* Counted over every credit the other filters match, whatever the SAP filter says — so
           "Refused by SAP" keeps its number while the table shows only the posted ones. *@
        <div class="ops-ds-summary">
            <div class="ops-ds-card">
                <div class="ops-ds-card-head">
                    <span class="ops-ds-card-label">Where the SAP memo stands</span>
                    <span class="ops-ds-card-tally">
                        <b>@Fiscalised</b>
                        <span>with ZIMRA</span>
                    </span>
                </div>

                @if (laneTotal > 0)
                {
                    <div class="ops-ds-strip">
                        @foreach (var lane in lanes.Where(l => l.Count > 0))
                        {
                            <div class="ops-ds-strip-seg @lane.Family"
                                 style="width:@Percent(lane.Count, laneTotal)"></div>
                        }
                    </div>
                }

                <div class="ops-ds-lanes">
                    @foreach (var lane in lanes)
                    {
                        <div class="ops-ds-lane @lane.Family">
                            <div class="ops-ds-lane-num">@lane.Count</div>
                            <div class="ops-ds-lane-name">@lane.Name</div>
                        </div>
                    }
                </div>

                @* The two outcomes that owe SAP nothing, stated beside the four that do. *@
                <div class="ops-ds-aside ops-ds-aside-ruled">
                    <span>Nothing owed <b>@SapCount(DesktopCreditSapStatuses.NotRequired)</b></span>
                    <span>Fiscalised only <b>@SapCount(DesktopCreditSapStatuses.FiscalOnly)</b></span>
                </div>
            </div>

            <div class="ops-ds-card">
                <div class="ops-ds-card-head">
                    <i class="ph ph-receipt-x" aria-hidden="true"></i>
                    <span class="ops-ds-card-label">Credited</span>
                </div>

                <div class="ops-ds-value">
                    <b>@(headlineCurrency is { } top ? Money(top.Value, top.Key) : "Nothing")</b>
                </div>
                <div class="ops-ds-aside">
                    <span>filed with ZIMRA · @Fiscalised credit@(Fiscalised == 1 ? "" : "s")</span>
                </div>

                @* Currencies are not added together: a USD and a ZiG credit are two amounts. *@
                <div class="ops-ds-split"></div>
                <div class="ops-ds-breakdown">
                    @if (response.TotalsByCurrency.Count == 0)
                    {
                        <div class="ops-ds-empty">No credit in this view has reached ZIMRA.</div>
                    }
                    else
                    {
                        <div class="ops-ds-card-label">By currency</div>
                        @foreach (var total in response.TotalsByCurrency.OrderByDescending(t => t.Value))
                        {
                            <div class="ops-ds-break-row">
                                <span class="ops-ds-break-code">@total.Key</span>
                                <span class="ops-ds-break-track">
                                    <span class="ops-ds-break-fill"
                                          style="width:@Percent(total.Value, currencyMax)"></span>
                                </span>
                                <span class="ops-ds-break-val">@Money(total.Value, total.Key)</span>
                            </div>
                        }
                    }
                </div>
            </div>
        </div>
    }

    @if (notice is not null)
    {
        <div class="ops-msg @(noticeGood ? "ops-fam-good" : "ops-fam-bad")" role="status">
            <i class="ph @(noticeGood ? "ph-check-circle" : "ph-warning-octagon")" aria-hidden="true"></i>
            <div class="ops-msg-body">@notice</div>
            <button type="button" class="ops-msg-x" aria-label="Dismiss" @onclick="() => notice = null">
                <i class="ph ph-x" aria-hidden="true"></i>
            </button>
        </div>
    }

    <section class="ops-panel ops-ds-fbar">
        <div class="ops-ds-fbar-row">
            <div class="ops-search ops-ds-search">
                <i class="ph ph-magnifying-glass" aria-hidden="true"></i>
                <input type="search" class="ops-input" placeholder="INV or CN number, customer, SAP invoice"
                       aria-label="Search by sale or credit number, customer or SAP invoice"
                       @bind="search" @bind:after="ApplyFilters" />
            </div>

            <div class="ops-ds-seg" role="group" aria-label="Period">
                @foreach (var option in PeriodOptions)
                {
                    <button type="button" class="ops-ds-seg-opt @(period == option.Value ? "is-on" : "")"
                            aria-pressed="@(period == option.Value)"
                            @onclick="() => SetPeriod(option.Value)">@option.Label</button>
                }
            </div>

            @if (period == PeriodCustom)
            {
                <div class="ops-ds-dates">
                    <NocturneDateField Id="dcl-f-from" Date="fromDate" DateChanged="@(value => OnDateChanged(value, isFrom: true))"
                                       AriaLabel="From date" />
                    <span class="ops-ds-dates-to" aria-hidden="true">&rarr;</span>
                    <NocturneDateField Id="dcl-f-to" Date="toDate" DateChanged="@(value => OnDateChanged(value, isFrom: false))"
                                       AriaLabel="To date" />
                </div>
            }

            <button type="button" class="ops-ds-ftoggle @(filterCount > 0 ? "is-on" : "")"
                    aria-expanded="@filtersOpen" aria-controls="dcl-filter-panel"
                    @onclick="() => filtersOpen = !filtersOpen">
                <i class="ph ph-sliders-horizontal" aria-hidden="true"></i>
                <span>Filters</span>
                <span class="ops-ds-fcount">@filterCount</span>
                <i class="ph @(filtersOpen ? "ph-caret-up" : "ph-caret-down")" aria-hidden="true"></i>
            </button>

            @if (filterCount > 0)
            {
                <button type="button" class="ops-btn ops-btn-ghost ops-btn-sm" @onclick="ClearFilters">
                    <i class="ph ph-x" aria-hidden="true"></i>Clear all
                </button>
            }
        </div>

        @if (filtersOpen)
        {
            @* The API filters each of these on one value, so a chip here replaces the group's pick
               rather than adding to it. Only the SAP group is counted: those are the counts the list
               returns, taken with the SAP filter lifted. *@
            <div class="ops-ds-fpanel" id="dcl-filter-panel">
                <div class="ops-ds-fgrid">
                    @foreach (var group in ChipGroups)
                    {
                        <div class="ops-ds-fgroup">
                            <span class="ops-kicker">@group.Name</span>
                            @if (group.Chips.Count == 0)
                            {
                                <span class="ops-ds-fnone">Nothing in this period</span>
                            }
                            else
                            {
                                <div class="ops-ds-chips">
                                    @foreach (var chip in group.Chips)
                                    {
                                        <button type="button"
                                                class="ops-ds-chip @chip.Family @(chip.IsOn ? "is-on" : "")"
                                                aria-pressed="@chip.IsOn"
                                                @onclick="() => ToggleChip(group.Key, chip.Value)">
                                            @if (chip.Family is not null)
                                            {
                                                <span class="ops-dot"></span>
                                            }
                                            <span class="ops-ds-chip-label">@chip.Label</span>
                                            @if (chip.Count is { } count)
                                            {
                                                <span class="ops-ds-chip-count">@count</span>
                                            }
                                        </button>
                                    }
                                </div>
                            }
                        </div>
                    }
                </div>
            </div>
        }

        @if (activeFilters.Count > 0)
        {
            <div class="ops-ds-active">
                <span class="ops-kicker">Active</span>
                @foreach (var pill in activeFilters)
                {
                    <button type="button" class="ops-ds-pill" @onclick="pill.Remove"
                            aria-label="@($"Remove the {pill.Group} filter {pill.Label}")">
                        <span class="ops-ds-pill-group">@pill.Group</span>
                        <span>@pill.Label</span>
                        <i class="ph ph-x" aria-hidden="true"></i>
                    </button>
                }
            </div>
        }
    </section>

    <div class="ops-ds-listbar">
        <div class="ops-ds-listbar-count">
            <span class="ops-ds-shown">@shownText</span>
        </div>

        <div class="ops-ds-listbar-tools">
            <span class="ops-label">Rows</span>
            <NocturneSelect Class="nsel-sm nsel-auto nsel-end" TValue="int" Options="PageSizeOptions"
                            Value="pageSize" ValueChanged="@(size => SetPageSize(size))"
                            Caption="Rows per page" AriaLabel="Rows per page" />
        </div>
    </div>

    @if (loading && response is null)
    {
        <div class="ops-loading">
            <span class="ops-spin ops-spin-lg"></span>
            <p>Loading credit notes&hellip;</p>
        </div>
    }
    else if (error is not null)
    {
        <div class="ops-panel ops-ds-list">
            <div class="ops-empty">
                <i class="ph ph-warning-octagon" aria-hidden="true"></i>
                <h3>Could not load the credit notes</h3>
                <p>@error</p>
                <div class="ops-empty-actions">
                    <button type="button" class="ops-btn ops-btn-ghost" @onclick="LoadAsync">Try again</button>
                </div>
            </div>
        </div>
    }
    else if (response is null || response.Items.Count == 0)
    {
        <div class="ops-panel ops-ds-list">
            <div class="ops-empty">
                <i class="ph ph-receipt-x" aria-hidden="true"></i>
                @if (filterCount > 0)
                {
                    <h3>Nothing matches these filters</h3>
                    <p>Widen the period or drop a filter to see the rest.</p>
                    <div class="ops-empty-actions">
                        <button type="button" class="ops-btn ops-btn-primary" @onclick="ClearFilters">
                            <i class="ph ph-x-circle" aria-hidden="true"></i>Clear all filters
                        </button>
                    </div>
                }
                else
                {
                    <h3>No credit notes yet</h3>
                    <p>Credits are raised from a sale on Desktop Sales, Vending Sales or Van Sales Invoices.</p>
                }
            </div>
        </div>
    }
    else
    {
        <div class="ops-panel ops-ds-list">
            <div class="ops-scroll">
                <table class="ops-table mobile-card-table">
                    <thead>
                        <tr>
                            <th>Credit note</th>
                            <th>Sale</th>
                            <th>Customer</th>
                            <th class="ops-num">Credited</th>
                            <th>ZIMRA</th>
                            <th class="ops-dcl-memo">SAP credit note</th>
                            <th>SAP</th>
                            <th class="ops-ds-chev-cell"><span class="visually-hidden">Open</span></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var row in response.Items)
                        {
                            @* A press anywhere on the row opens the credit's drawer, as a row does on
                               /desktop-sales. The sale number and Retry SAP stop the click so they keep
                               their own actions. *@
                            <tr @onclick="() => OpenDetail(row)"
                                class="@(selected?.Id == row.Id ? "is-open" : null)">
                                <td data-label="Credit note">
                                    <span class="ops-ds-saleno">@row.DisplayNumber</span>
                                    <div class="ops-sub ops-ds-when">@Stamp(row.CreatedAtUtc)</div>
                                </td>
                                <td data-label="Sale">
                                    @* The sale number opens the sale's credits — the same dialog the sale
                                       pages use. *@
                                    <button type="button" class="ops-dcl-open ops-ds-saleno"
                                            @onclick="() => Open(row)" @onclick:stopPropagation="true"
                                            title="Open @row.SaleNumber's credit notes">@row.SaleNumber</button>
                                    <div class="ops-sub ops-dcl-nowrap">
                                        @DesktopCreditLabels.Source(row.SaleSourceSystem) · @row.SaleWarehouseCode
                                    </div>
                                    @if (row.SaleSapDocNum is { } invoice)
                                    {
                                        <div class="ops-sub">SAP #@invoice</div>
                                    }
                                </td>
                                <td data-label="Customer" class="ops-name">
                                    <span class="ops-dcl-customer" title="@Customer(row)">@Customer(row)</span>
                                    @if (!string.IsNullOrWhiteSpace(row.SaleCardCode))
                                    {
                                        <span class="ops-sub"> · @row.SaleCardCode</span>
                                    }
                                </td>
                                <td data-label="Credited" class="ops-num">
                                    <span class="ops-dcl-amount">@Money(row.Amount, row.Currency)</span>
                                    <div class="ops-sub ops-dcl-reason" title="@row.Reason">@row.Reason</div>
                                </td>
                                <td data-label="ZIMRA" class="ops-dcl-zimra">
                                    <span class="ops-ds-state @DesktopCreditLabels.Family(row.Status)">
                                        <span class="ops-dot"></span>@DesktopCreditLabels.Fiscal(row.Status)
                                    </span>
                                    @if (!string.IsNullOrWhiteSpace(row.ReceiptGlobalNo))
                                    {
                                        <div class="ops-sub">receipt @row.ReceiptGlobalNo</div>
                                    }
                                </td>
                                @* The memo number has a column of its own, so the SAP column is left to
                                   say how it went — and, when SAP refused it, why and the retry. *@
                                <td data-label="SAP credit note" class="ops-dcl-memo">
                                    @if (row.SapDocNum is { } memo)
                                    {
                                        <span class="ops-code">#@memo</span>
                                    }
                                    else
                                    {
                                        <span class="ops-sub">—</span>
                                    }
                                </td>
                                <td data-label="SAP" class="ops-dcl-sap">
                                    @if (row.Status == "Fiscalised")
                                    {
                                        <span class="ops-ds-state @DesktopCreditLabels.SapFamily(row.SapStatus)">
                                            <span class="ops-dot"></span>@SapResult(row.SapStatus)
                                        </span>
                                        @if (!string.IsNullOrWhiteSpace(row.SapError)
                                             && row.SapStatus is DesktopCreditSapStatuses.Failed or DesktopCreditSapStatuses.ManualInSap)
                                        {
                                            <div class="ops-sub ops-dcl-error" title="@row.SapError">
                                                @row.SapError
                                                @if (row.SapStatus == DesktopCreditSapStatuses.Failed)
                                                {
                                                    <text> (@row.SapAttempts attempt@(row.SapAttempts == 1 ? "" : "s"))</text>
                                                }
                                            </div>
                                        }
                                        @if (row.SapStatus == DesktopCreditSapStatuses.Failed)
                                        {
                                            <AuthorizeView Roles="Admin,Manager" Context="retryCtx">
                                                <Authorized>
                                                    <button type="button" class="ops-btn ops-btn-primary ops-btn-sm ops-dcl-retry"
                                                            disabled="@(retrying is not null)" @onclick="() => RetryAsync(row)"
                                                            @onclick:stopPropagation="true"
                                                            title="Send the SAP credit memo again now">
                                                        @if (retrying == row.Id)
                                                        {
                                                            <span class="ops-spin"></span>
                                                        }
                                                        else
                                                        {
                                                            <i class="ph ph-arrow-clockwise" aria-hidden="true"></i>
                                                        }
                                                        Retry SAP
                                                    </button>
                                                </Authorized>
                                            </AuthorizeView>
                                        }
                                    }
                                    else
                                    {
                                        @* ZIMRA has not accepted it, so SAP is owed nothing yet and may never be. *@
                                        <span class="ops-sub">not until ZIMRA has it</span>
                                    }
                                </td>
                                <td class="ops-ds-chev-cell">
                                    <i class="ph ph-arrow-right ops-ds-chev" aria-hidden="true"></i>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <div class="ops-ds-foot">
                <span class="ops-ds-foot-info">Credits appear as the tills file them with ZIMRA</span>
                @if (TotalPages > 1)
                {
                    <div class="ops-pages">
                        <button type="button" class="ops-step" disabled="@(currentPage <= 1 || loading)" @onclick="() => GoToPage(currentPage - 1)">
                            <i class="ph ph-caret-left" aria-hidden="true"></i>Previous
                        </button>
                        <span class="ops-page-now">@currentPage of @TotalPages</span>
                        <button type="button" class="ops-step" disabled="@(currentPage >= TotalPages || loading)" @onclick="() => GoToPage(currentPage + 1)">
                            Next<i class="ph ph-caret-right" aria-hidden="true"></i>
                        </button>
                    </div>
                }
            </div>
        </div>
    }
</div>

@if (selected is { } credit)
{
    var creditLines = credit.Lines ?? [];

    <div class="ops-overlay ops-overlay-right" @onclick="CloseDetail">
        <aside class="ops-drawer ops-ds-drawer" role="dialog" aria-modal="true"
               aria-label="Credit note @credit.DisplayNumber"
               @onclick:stopPropagation="true">

            @* Headed like the sale drawer on /desktop-sales: the short number, then the fiscal number
               in full. It is what ZIMRA holds the credit under, and a truncated one matches nothing. *@
            <div class="ops-drawer-head ops-ds-dhead">
                <div class="ops-ds-dhead-id">
                    <span class="ops-kicker">Credit note</span>
                    <span class="ops-ds-dhead-no">@credit.DisplayNumber</span>
                    <span class="ops-ds-dhead-ref">@credit.Number</span>
                </div>

                <div class="ops-ds-dnav">
                    <button type="button" class="ops-icon-btn" title="Previous credit"
                            aria-label="Previous credit" disabled="@((response?.Items.Count ?? 0) < 2)"
                            @onclick="() => StepDetail(-1)">
                        <i class="ph ph-caret-up" aria-hidden="true"></i>
                    </button>
                    <button type="button" class="ops-icon-btn" title="Next credit"
                            aria-label="Next credit" disabled="@((response?.Items.Count ?? 0) < 2)"
                            @onclick="() => StepDetail(1)">
                        <i class="ph ph-caret-down" aria-hidden="true"></i>
                    </button>
                    <button type="button" class="ops-icon-btn" title="Close"
                            aria-label="Close" @onclick="CloseDetail">
                        <i class="ph ph-x" aria-hidden="true"></i>
                    </button>
                </div>

                <div class="ops-ds-dtags">
                    <span class="ops-badge @DesktopCreditLabels.Family(credit.Status)">@DesktopCreditLabels.Fiscal(credit.Status)</span>
                    @if (credit.Status == "Fiscalised")
                    {
                        <span class="ops-badge @DesktopCreditLabels.SapFamily(credit.SapStatus)">
                            @DesktopCreditLabels.Sap(credit.SapStatus, credit.SapDocNum)
                        </span>
                    }
                    <span class="ops-ds-dwhen">@Stamp(credit.CreatedAtUtc)</span>
                </div>
            </div>

            <div class="ops-drawer-body">
                <div class="ops-ds-headline">
                    <b>@credit.Currency @credit.Amount.ToString("N2", CultureInfo.InvariantCulture)</b>
                    <span>@credit.Reason</span>
                </div>

                @if (credit.Status == "Fiscalised" && !string.IsNullOrWhiteSpace(credit.SapError)
                     && credit.SapStatus is DesktopCreditSapStatuses.Failed or DesktopCreditSapStatuses.ManualInSap)
                {
                    <div class="ops-msg ops-fam-bad" role="alert">
                        <i class="ph ph-warning-octagon" aria-hidden="true"></i>
                        <div class="ops-msg-body">
                            <strong>SAP has not taken this credit.</strong>
                            <div class="ops-ds-sapsaid">@credit.SapError</div>
                        </div>
                    </div>
                }

                <div class="ops-defs">
                    <div>
                        <div class="ops-def-k">Sale</div>
                        <div class="ops-def-v">
                            @credit.SaleNumber
                            @if (credit.SaleSapDocNum is { } invoice)
                            {
                                <div class="ops-sub">SAP invoice #@invoice</div>
                            }
                        </div>
                    </div>
                    <div>
                        <div class="ops-def-k">Customer</div>
                        <div class="ops-def-v">
                            @Customer(credit)
                            @if (!string.IsNullOrWhiteSpace(credit.SaleCardCode))
                            {
                                <div class="ops-sub ops-code">@credit.SaleCardCode</div>
                            }
                        </div>
                    </div>
                    <div>
                        <div class="ops-def-k">Raised in</div>
                        <div class="ops-def-v">@DesktopCreditLabels.Source(credit.SaleSourceSystem) · @credit.SaleWarehouseCode</div>
                    </div>
                    <div>
                        <div class="ops-def-k">ZIMRA receipt</div>
                        <div class="ops-def-v">@(string.IsNullOrWhiteSpace(credit.ReceiptGlobalNo) ? "—" : credit.ReceiptGlobalNo)</div>
                    </div>
                    @if (credit.SapDocNum is { } memo)
                    {
                        <div>
                            <div class="ops-def-k">SAP credit memo</div>
                            <div class="ops-def-v">#@memo</div>
                        </div>
                    }
                    @if (credit.FiscalisedAtUtc is { } fiscalisedAt)
                    {
                        <div>
                            <div class="ops-def-k">Fiscalised</div>
                            <div class="ops-def-v">@Stamp(fiscalisedAt)</div>
                        </div>
                    }
                </div>

                <div class="ops-ds-block">
                    <div class="ops-def-k">Lines</div>
                    @if (creditLines.Count == 0)
                    {
                        <p class="ops-sub">The saved lines of this credit could not be read.</p>
                    }
                    else
                    {
                        <table class="ops-table">
                            <thead>
                                <tr>
                                    <th>Item</th>
                                    <th class="ops-num">Qty</th>
                                    <th class="ops-num">Unit price</th>
                                    <th class="ops-num">Total</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var line in creditLines)
                                {
                                    <tr>
                                        <td>
                                            <span class="ops-code">@(line.ItemCode ?? $"Line {line.ReceiptLineNo}")</span>
                                            <div class="ops-sub">@line.Name</div>
                                        </td>
                                        <td class="ops-num">@QuantityDisplay.Format(line.Quantity)</td>
                                        <td class="ops-num">@line.UnitPrice.ToString("N2", CultureInfo.InvariantCulture)</td>
                                        <td class="ops-num">@line.LineTotal.ToString("N2", CultureInfo.InvariantCulture)</td>
                                    </tr>
                                }
                            </tbody>
                        </table>

                        @* Prices are the receipt's, VAT included. The amount is what ZIMRA filed, so it is
                           stated rather than re-added from rounded lines. *@
                        <div class="ops-ds-sum">
                            <div>
                                <span>Credited (VAT incl.)</span>
                                <span>@credit.Currency @credit.Amount.ToString("N2", CultureInfo.InvariantCulture)</span>
                            </div>
                        </div>
                    }
                </div>
            </div>

            <div class="ops-drawer-foot">
                <button type="button" class="ops-btn ops-btn-ghost" @onclick="CloseDetail">Close</button>
                <button type="button" class="ops-btn ops-btn-primary" @onclick="() => OpenFromDetail(credit)">
                    <i class="ph ph-arrow-u-up-left" aria-hidden="true"></i>
                    All credits on @credit.SaleNumber
                </button>
            </div>
        </aside>
    </div>
}

@* The same dialog the sale pages open, so everything they offer on a credit — reconcile, continue,
   credit more lines — is one click from here too. Closing it reloads, because it may have changed a row. *@
<DesktopCreditNoteDialog Reference="@openRow?.SaleReference"
                         SaleNumber="@openRow?.SaleNumber"
                         Currency="@openRow?.Currency"
                         IsConsolidated="@(openRow?.SaleIsConsolidated ?? false)"
                         OnClosed="CloseDialogAsync" />

@code {
    private DesktopCreditNoteListResponse? response;
    private bool loading = true;
    private string? error;
    private string? notice;
    private bool noticeGood;
    private Guid? retrying;
    private DesktopCreditNoteListRow? openRow;
    private DesktopCreditNoteListRow? selected;
    private DateTime? loadedAt;

    private string search = "";
    private DateTime? fromDate;
    private DateTime? toDate;
    private string sapStatus = "";
    private string fiscalStatus = "";
    private string source = "";
    private string warehouse = "";
    private int currentPage = 1;
    private int pageSize = 50;
    private bool filtersOpen;

    // Credits are few beside sales, so the page opens on all of them rather than on today, which
    // most days would be empty.
    private const string PeriodAll = "all";
    private const string PeriodToday = "today";
    private const string PeriodWeek = "week";
    private const string PeriodMonth = "month";
    private const string PeriodCustom = "custom";
    private string period = PeriodAll;

    private sealed record Choice(string Value, string Label);

    private static readonly Choice[] PeriodOptions =
    [
        new(PeriodAll, "All"),
        new(PeriodToday, "Today"),
        new(PeriodWeek, "Last 7 days"),
        new(PeriodMonth, "Last 30 days"),
        new(PeriodCustom, "Range")
    ];

    private static readonly NocturneSelectOption<int>[] PageSizeOptions =
    [
        new(10, "10"),
        new(25, "25"),
        new(50, "50") { IsUnset = true },
        new(100, "100"),
        new(200, "200")
    ];

    // Families match DesktopCreditLabels, which colours the row's state.
    private static readonly (string Value, string Label, string Family)[] SapChoices =
    [
        (DesktopCreditSapStatuses.Failed, "Refused by SAP", "ops-fam-bad"),
        (DesktopCreditSapStatuses.ManualInSap, "Raise by hand", "ops-fam-warn"),
        (DesktopCreditSapStatuses.Deferred, "Waiting for the sale", "ops-fam-accent"),
        (DesktopCreditSapStatuses.Posted, "In SAP", "ops-fam-good"),
        (DesktopCreditSapStatuses.NotRequired, "Nothing owed", "ops-fam-neutral"),
        (DesktopCreditSapStatuses.FiscalOnly, "Fiscalised only", "ops-fam-neutral")
    ];

    private static readonly string[] FiscalChoices =
        ["Fiscalised", "ReconciliationRequired", "Rejected", "Prepared", "Submitting"];

    private static readonly (string Value, string Label)[] SourceChoices =
    [
        ("KefalosShopTill", "Till"),
        ("KefalosVending", "Vending"),
        ("KefalosVanSales", "Van")
    ];

    private enum ChipGroupKey { Sap, Fiscal, Source, Warehouse }

    private sealed record Chip(string Value, string Label, int? Count, string? Family, bool IsOn);

    private sealed record ChipGroup(ChipGroupKey Key, string Name, List<Chip> Chips);

    private sealed record ActiveFilter(string Group, string Label, Func<Task> Remove);

    private List<ChipGroup> ChipGroups =>
    [
        new(ChipGroupKey.Sap, "SAP",
            SapChoices.Select(c => new Chip(c.Value, c.Label, SapCount(c.Value), c.Family, sapStatus == c.Value)).ToList()),
        new(ChipGroupKey.Fiscal, "ZIMRA",
            FiscalChoices.Select(v => new Chip(v, DesktopCreditLabels.Fiscal(v), null, DesktopCreditLabels.Family(v), fiscalStatus == v)).ToList()),
        new(ChipGroupKey.Source, "Sold by",
            SourceChoices.Select(c => new Chip(c.Value, c.Label, null, null, source == c.Value)).ToList()),
        new(ChipGroupKey.Warehouse, "Warehouse",
            WarehouseCodes.Select(code => new Chip(code, code, null, null, warehouse == code)).ToList())
    ];

    // A picked warehouse keeps its chip even if the list stops naming it, so it can be unpicked.
    private IEnumerable<string> WarehouseCodes =>
        (response?.Warehouses ?? [])
            .Concat(string.IsNullOrEmpty(warehouse) ? [] : [warehouse])
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .Order(StringComparer.OrdinalIgnoreCase);

    /// <summary>The SAP outcome in the lanes' and chips' words; the memo number is its own column.</summary>
    private static string SapResult(string? status) =>
        SapChoices.FirstOrDefault(c => c.Value == status).Label ?? DesktopCreditLabels.Sap(status, null);

    private List<ActiveFilter> activeFilters
    {
        get
        {
            var list = new List<ActiveFilter>();
            if (!string.IsNullOrWhiteSpace(search))
                list.Add(new("Search", search.Trim(), async () => { search = ""; await ApplyFilters(); }));
            if (period != PeriodAll)
                list.Add(new("Period", periodLabel, () => SetPeriod(PeriodAll)));
            if (sapStatus != "")
                list.Add(new("SAP", SapChoices.FirstOrDefault(c => c.Value == sapStatus).Label ?? sapStatus,
                    () => ToggleChip(ChipGroupKey.Sap, sapStatus)));
            if (fiscalStatus != "")
                list.Add(new("ZIMRA", DesktopCreditLabels.Fiscal(fiscalStatus), () => ToggleChip(ChipGroupKey.Fiscal, fiscalStatus)));
            if (source != "")
                list.Add(new("Sold by", DesktopCreditLabels.Source(source), () => ToggleChip(ChipGroupKey.Source, source)));
            if (warehouse != "")
                list.Add(new("Warehouse", warehouse, () => ToggleChip(ChipGroupKey.Warehouse, warehouse)));
            return list;
        }
    }

    private int filterCount => activeFilters.Count;

    private string periodLabel => period switch
    {
        PeriodToday => "Today",
        PeriodWeek => "Last 7 days",
        PeriodMonth => "Last 30 days",
        PeriodCustom => $"{fromDate?.ToString("dd MMM", CultureInfo.InvariantCulture) ?? "…"} – {toDate?.ToString("dd MMM", CultureInfo.InvariantCulture) ?? "…"}",
        _ => "Every credit"
    };

    private string shownText
    {
        get
        {
            if (response is null || response.TotalCount == 0) return "No credit notes";
            var first = ((currentPage - 1) * pageSize) + 1;
            return $"Showing {first}–{first + response.Items.Count - 1} of {response.TotalCount:N0} credit notes";
        }
    }

    private int TotalPages => response is null ? 0 : (int)Math.Ceiling(response.TotalCount / (double)pageSize);

    private int SapCount(string status) => response?.SapStatusCounts.GetValueOrDefault(status) ?? 0;

    private int Fiscalised => response?.SapStatusCounts.Values.Sum() ?? 0;

    private List<DesktopSalesDaySummary.Lane> lanes =>
    [
        new("In SAP", SapCount(DesktopCreditSapStatuses.Posted), "ops-fam-good"),
        new("Waiting for the sale", SapCount(DesktopCreditSapStatuses.Deferred), "ops-fam-accent"),
        new("Refused by SAP", SapCount(DesktopCreditSapStatuses.Failed), "ops-fam-bad"),
        new("Raise by hand", SapCount(DesktopCreditSapStatuses.ManualInSap), "ops-fam-warn")
    ];

    private int laneTotal => lanes.Sum(l => l.Count);

    // USD leads when there is any: amounts in different currencies are not comparable, so the
    // largest number would put 410 ZiG above 40 USD. The rest are listed under it.
    private KeyValuePair<string, decimal>? headlineCurrency =>
        response is null || response.TotalsByCurrency.Count == 0
            ? null
            : response.TotalsByCurrency.FirstOrDefault(t => t.Key.Equals("USD", StringComparison.OrdinalIgnoreCase)) is { Key: not null } usd
                ? usd
                : response.TotalsByCurrency.MaxBy(t => t.Value);

    private decimal currencyMax => response?.TotalsByCurrency.Values.DefaultIfEmpty(0).Max() ?? 0;

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        loading = true;
        error = null;

        try
        {
            response = await DesktopIntegrationService.ListCreditNotesAsync(new DesktopCreditNoteListQuery(
                fromDate, toDate, NullIfEmpty(warehouse), NullIfEmpty(source), NullIfEmpty(fiscalStatus),
                NullIfEmpty(sapStatus), NullIfEmpty(search), currentPage, pageSize));
            loadedAt = IAuditService.ToCAT(DateTime.UtcNow);

            // An open drawer follows its credit across a reload (a retry changes the row), and closes
            // when the credit is no longer on the page.
            selected = selected is null ? null : response.Items.FirstOrDefault(r => r.Id == selected.Id);
        }
        catch (Exception ex)
        {
            error = ex.Message;
        }
        finally
        {
            loading = false;
        }
    }

    private async Task ApplyFilters()
    {
        currentPage = 1;
        await LoadAsync();
    }

    private async Task SetPeriod(string value)
    {
        if (period == value) return;
        period = value;

        (fromDate, toDate) = value switch
        {
            PeriodToday => (DateTime.Today, DateTime.Today),
            PeriodWeek => (DateTime.Today.AddDays(-6), DateTime.Today),
            PeriodMonth => (DateTime.Today.AddDays(-29), DateTime.Today),
            // "Range" keeps whatever pair is already set and reveals the fields.
            PeriodCustom => (fromDate, toDate),
            _ => ((DateTime?)null, (DateTime?)null)
        };

        await ApplyFilters();
    }

    private async Task OnDateChanged(DateTime? value, bool isFrom)
    {
        if (isFrom) fromDate = value; else toDate = value;
        await ApplyFilters();
    }

    /// <summary>The API filters each group on one value, so a chip replaces its group's pick, and pressing it again lifts it.</summary>
    private async Task ToggleChip(ChipGroupKey key, string value)
    {
        static string Flip(string current, string pressed) => current == pressed ? "" : pressed;

        switch (key)
        {
            case ChipGroupKey.Sap: sapStatus = Flip(sapStatus, value); break;
            case ChipGroupKey.Fiscal: fiscalStatus = Flip(fiscalStatus, value); break;
            case ChipGroupKey.Source: source = Flip(source, value); break;
            case ChipGroupKey.Warehouse: warehouse = Flip(warehouse, value); break;
        }

        await ApplyFilters();
    }

    private async Task SetPageSize(int size)
    {
        if (size == pageSize) return;
        pageSize = size;
        await ApplyFilters();
    }

    private async Task ClearFilters()
    {
        search = "";
        period = PeriodAll;
        fromDate = toDate = null;
        sapStatus = fiscalStatus = source = warehouse = "";
        await ApplyFilters();
    }

    private async Task GoToPage(int target)
    {
        currentPage = Math.Clamp(target, 1, Math.Max(1, TotalPages));
        await LoadAsync();
    }

    private async Task RetryAsync(DesktopCreditNoteListRow row)
    {
        retrying = row.Id;
        notice = null;

        try
        {
            var result = await DesktopIntegrationService.RetryCreditNoteSapAsync(row.Id);

            noticeGood = result.SapStatus == DesktopCreditSapStatuses.Posted;
            notice = noticeGood
                ? $"{row.SaleNumber}: credit memo #{result.SapDocNum} raised in SAP."
                : $"{row.SaleNumber}: SAP did not take it — {result.SapError ?? DesktopCreditLabels.Sap(result.SapStatus, result.SapDocNum)}";
        }
        catch (Exception ex)
        {
            noticeGood = false;
            notice = $"{row.SaleNumber}: {ex.Message}";
        }
        finally
        {
            retrying = null;
        }

        await LoadAsync();
    }

    private void Open(DesktopCreditNoteListRow row) => openRow = row;

    private void OpenDetail(DesktopCreditNoteListRow row) => selected = row;

    private void CloseDetail() => selected = null;

    private void OpenFromDetail(DesktopCreditNoteListRow row)
    {
        selected = null;
        Open(row);
    }

    /// <summary>Walks the page that is loaded, as the sale drawer does; paging is the pager's job.</summary>
    private void StepDetail(int step)
    {
        var items = response?.Items ?? [];
        if (selected is null || items.Count == 0) return;
        var index = items.FindIndex(r => r.Id == selected.Id);
        selected = items[((index < 0 ? 0 : index) + step + items.Count) % items.Count];
    }

    private async Task CloseDialogAsync()
    {
        openRow = null;
        await LoadAsync();
    }

    private static string? NullIfEmpty(string? value) => string.IsNullOrWhiteSpace(value) ? null : value.Trim();

    private static string Customer(DesktopCreditNoteListRow row) =>
        !string.IsNullOrWhiteSpace(row.SaleCustomerName) ? row.SaleCustomerName!
        : !string.IsNullOrWhiteSpace(row.SaleCardName) ? row.SaleCardName!
        : "—";

    private static string Stamp(DateTime utc) => IAuditService.ToCAT(
            utc.Kind == DateTimeKind.Utc ? utc : DateTime.SpecifyKind(utc, DateTimeKind.Utc))
        .ToString("dd MMM yyyy HH:mm", CultureInfo.InvariantCulture);

    private static string Money(decimal value, string? code) =>
        string.IsNullOrEmpty(code) ? value.ToString("N2", CultureInfo.InvariantCulture)
            : $"{code} {value.ToString("N2", CultureInfo.InvariantCulture)}";

    private static string Percent(decimal part, decimal whole) =>
        whole <= 0 ? "0%" : (part / whole * 100).ToString("0.##", CultureInfo.InvariantCulture) + "%";
}
