@code {
    private const decimal DefaultVatPercent = 15.5m;

    /// <summary>
    /// How many quotation headers one page load pulls. The list is filtered, sorted and paged in the
    /// browser, so it wants the whole set; it is affordable because neither source returns line items
    /// here — the drawer fetches those for the one quotation being looked at.
    /// </summary>
    private const int ListFetchSize = 10000;

    private static readonly int[] PageSizeOptions = [10, 25, 50, 100, 200];

    private int _pageSize = 10;
    private List<QuotationDto>? quotations;
    private QuotationDto? selectedQuotation;
    private QuotationDto? convertQuotation;
    private QuotationDto? deleteQuotation;
    private QuotationDto? repriceQuotation;
    private bool isLoading = true;
    private bool isSaving = false;
    private bool isDeleting = false;
    private bool isPdfLoading = false;
    private bool isApplyingStandardVat = false;
    private bool showRepriceModal = false;
    private string? errorMessage;
    private int? convertingQuotationId;
    private int? editingQuotationId;

    // Line items arrive with the quotation the user opens, not with the list. These track that fetch.
    private readonly HashSet<int> quotationsWithLines = new();
    private int? detailLoadingId;
    private bool detailLoadFailed;

    private bool IsDetailLoading => selectedQuotation is not null && detailLoadingId == selectedQuotation.Id;

    private bool IsFirstLoad => isLoading && (quotations is null || quotations.Count == 0);

    private bool CanDownloadQuotationPdf => selectedQuotation is not null &&
        (dataSource == "local" || selectedQuotation.SAPDocEntry.HasValue);

    private bool CanRepriceSelectedQuotation => CanRepriceQuotation(selectedQuotation);

    private bool CanApplyStandardVat => dataSource == "local"
        && selectedQuotation is not null
        && CanRepriceQuotation(selectedQuotation)
        && selectedQuotation.Lines.Any(line => line.TaxPercent <= 0);

    // Data source toggle: "sap" or "local"
    private string dataSource = "sap";

    // Filters
    private string? customerFilter;
    private string? statusFilter;
    private DateTime? fromDate;
    private DateTime? toDate;

    // Fetch paging — one page pulls the whole set; the display pager below works over it.
    private int currentPage = 1;
    private int pageSize = ListFetchSize;
    private int totalPages = 1;
    private int totalCount = 0;

    // Display paging, in the browser, over the fetched set.
    private int displayPage = 1;

    // Reprice form
    private CreateQuotationRequest newQuotation = new();
    private DateTime? validUntilDate;

    private string RepriceCustomerLabel => string.IsNullOrWhiteSpace(newQuotation.CardName)
        ? newQuotation.CardCode
        : $"{newQuotation.CardCode} — {newQuotation.CardName}";

    private int LoadedCount => quotations?.Count ?? 0;

    private int DisplayPageCount => Math.Max(1, (LoadedCount + _pageSize - 1) / _pageSize);

    private IEnumerable<QuotationDto> PageRows => quotations is null
        ? []
        : quotations.Skip((displayPage - 1) * _pageSize).Take(_pageSize);

    private string RangeLabel
    {
        get
        {
            if (IsFirstLoad)
                return "Loading…";

            if (LoadedCount == 0)
                return "No quotations";

            var first = ((displayPage - 1) * _pageSize) + 1;
            var last = Math.Min(displayPage * _pageSize, LoadedCount);
            return $"{first:N0}–{last:N0} of {LoadedCount:N0} quotations";
        }
    }

    protected override async Task OnInitializedAsync()
    {
        _pageSize = AppSettings.PageSize;
        await LoadQuotations();
        await AuditService.LogAsync(AuditActions.ViewQuotations, "Quotation", null);
    }

    private void ResetToFirstPage() => displayPage = 1;

    private void GoToDisplayPage(int page)
    {
        if (page >= 1 && page <= DisplayPageCount)
        {
            displayPage = page;
        }
    }

    private async Task SwitchDataSource(string source)
    {
        if (dataSource == source)
            return;

        dataSource = source;
        currentPage = 1;
        await LoadQuotations();
    }

    private async Task LoadQuotations()
    {
        isLoading = true;
        errorMessage = null;
        // Ids are only unique within a source, and the rows about to arrive carry no lines yet.
        quotationsWithLines.Clear();

        try
        {
            if (dataSource == "sap")
            {
                var response = await QuotationService.GetQuotationsFromSAPAsync(currentPage, pageSize, customerFilter, fromDate, toDate);
                if (response != null)
                {
                    quotations = response.Quotations;
                    totalCount = response.TotalCount;
                    totalPages = response.TotalPages;

                    // Apply client-side status filter for SAP quotations
                    if (!string.IsNullOrEmpty(statusFilter) && int.TryParse(statusFilter, out var statusInt))
                    {
                        var status = (QuotationStatus)statusInt;
                        quotations = quotations?.Where(q => q.Status == status).ToList();
                    }
                }
                else
                {
                    quotations = new();
                    errorMessage = "Failed to load quotations from SAP. The API may be unavailable.";
                }
            }
            else
            {
                QuotationStatus? status = null;
                if (!string.IsNullOrEmpty(statusFilter) && int.TryParse(statusFilter, out var statusInt))
                {
                    status = (QuotationStatus)statusInt;
                }

                var response = await QuotationService.GetQuotationsAsync(currentPage, pageSize, status, customerFilter, fromDate, toDate);
                if (response != null)
                {
                    quotations = response.Quotations;
                    totalCount = response.TotalCount;
                    totalPages = response.TotalPages;
                }
                else
                {
                    quotations = new();
                    errorMessage = "Failed to load quotations. The API may be unavailable.";
                }
            }
        }
        catch (Exception ex)
        {
            quotations = new();
            errorMessage = $"Error loading quotations: {ex.Message}";
        }
        finally
        {
            isLoading = false;
            // The set changed underneath the display pager, so start it over.
            displayPage = 1;
        }
    }

    private async Task ApplyFilter()
    {
        currentPage = 1;
        await LoadQuotations();
    }

    private async Task ClearFilter()
    {
        customerFilter = null;
        statusFilter = null;
        fromDate = null;
        toDate = null;
        currentPage = 1;
        await LoadQuotations();
    }

    private async Task HandleFilterKeyDown(KeyboardEventArgs args)
    {
        if (args.Key == "Enter")
        {
            await ApplyFilter();
        }
    }

    private async Task ViewQuotation(QuotationDto quotation)
    {
        // The header is already in hand, so the drawer opens on the first frame; only the line items
        // have to be fetched, and they render into the section that shows a placeholder meanwhile.
        selectedQuotation = quotation;
        detailLoadFailed = false;

        var detailed = await EnsureLinesLoadedAsync(quotation);
        if (detailed is null && selectedQuotation?.Id == quotation.Id)
        {
            detailLoadFailed = true;
        }
    }

    private void CloseDrawer()
    {
        selectedQuotation = null;
        detailLoadFailed = false;
    }

    /// <summary>
    /// Returns the quotation with its line items, fetching the full document the first time it is
    /// asked for. Returns null when the fetch fails.
    /// </summary>
    private async Task<QuotationDto?> EnsureLinesLoadedAsync(QuotationDto quotation)
    {
        if (quotationsWithLines.Contains(quotation.Id))
        {
            return quotation;
        }

        detailLoadingId = quotation.Id;
        try
        {
            var detailed = dataSource == "sap"
                ? await QuotationService.GetQuotationFromSAPByDocEntryAsync(quotation.SAPDocEntry ?? quotation.Id)
                : await QuotationService.GetQuotationByIdAsync(quotation.Id);

            if (detailed is null)
            {
                Logger.LogWarning("Could not load line items for quotation {QuotationNumber}", quotation.QuotationNumber);
                return null;
            }

            quotationsWithLines.Add(detailed.Id);
            ReplaceQuotation(detailed);

            if (selectedQuotation?.Id == detailed.Id)
            {
                selectedQuotation = detailed;
            }

            return detailed;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error loading line items for quotation {QuotationNumber}", quotation.QuotationNumber);
            return null;
        }
        finally
        {
            if (detailLoadingId == quotation.Id)
            {
                detailLoadingId = null;
            }
        }
    }

    private async Task DownloadQuotationPdf()
    {
        if (selectedQuotation == null || isPdfLoading || !CanDownloadQuotationPdf)
        {
            return;
        }

        isPdfLoading = true;
        try
        {
            var pdfBytes = dataSource == "sap"
                ? await QuotationService.GetQuotationPdfFromSAPAsync(selectedQuotation.SAPDocEntry ?? selectedQuotation.Id)
                : await QuotationService.GetQuotationPdfAsync(selectedQuotation.Id);

            if (pdfBytes == null || pdfBytes.Length == 0)
            {
                errorMessage = "Failed to retrieve quotation PDF.";
                return;
            }

            var base64 = Convert.ToBase64String(pdfBytes);
            var fileName = $"Quotation_{selectedQuotation.QuotationNumber}.pdf";
            await JS.InvokeVoidAsync("downloadPdfFromBase64", base64, fileName);
            await AuditService.LogAsync(AuditActions.DownloadQuotationPdf, "Quotation", selectedQuotation.QuotationNumber);
        }
        catch (Exception ex)
        {
            errorMessage = $"Download failed: {ex.Message}";
        }
        finally
        {
            isPdfLoading = false;
        }
    }

    private async Task PrintQuotationPdf()
    {
        if (selectedQuotation == null || isPdfLoading || !CanDownloadQuotationPdf)
        {
            return;
        }

        isPdfLoading = true;
        try
        {
            var pdfBytes = dataSource == "sap"
                ? await QuotationService.GetQuotationPdfFromSAPAsync(selectedQuotation.SAPDocEntry ?? selectedQuotation.Id)
                : await QuotationService.GetQuotationPdfAsync(selectedQuotation.Id);

            if (pdfBytes == null || pdfBytes.Length == 0)
            {
                errorMessage = "Failed to retrieve quotation PDF for printing.";
                return;
            }

            var base64 = Convert.ToBase64String(pdfBytes);
            await JS.InvokeVoidAsync("printPdfFromBase64", base64);
            await AuditService.LogAsync(AuditActions.PrintQuotationPdf, "Quotation", selectedQuotation.QuotationNumber);
        }
        catch (Exception ex)
        {
            errorMessage = $"Print failed: {ex.Message}";
        }
        finally
        {
            isPdfLoading = false;
        }
    }

    private async Task ApplyStandardVat()
    {
        if (selectedQuotation == null || isApplyingStandardVat || !CanApplyStandardVat)
        {
            return;
        }

        isApplyingStandardVat = true;
        try
        {
            var updatedQuotation = await QuotationService.ApplyStandardVatAsync(selectedQuotation.Id);
            if (updatedQuotation == null)
            {
                errorMessage = "Failed to apply standard VAT to quotation.";
                return;
            }

            selectedQuotation = updatedQuotation;
            ReplaceQuotation(updatedQuotation);

            Snackbar.Add($"Applied {DefaultVatPercent}% VAT to quotation lines that were missing VAT.", Severity.Success);
            await AuditService.LogAsync(AuditActions.ApplyQuotationVat, "Quotation", updatedQuotation.QuotationNumber, $"Applied standard VAT of {DefaultVatPercent}% to zero-VAT lines.");
        }
        catch (Exception ex)
        {
            errorMessage = $"Failed to apply VAT: {ex.Message}";
        }
        finally
        {
            isApplyingStandardVat = false;
        }
    }

    private async Task ApproveQuotation(int id)
    {
        var result = await QuotationService.ApproveAsync(id);
        if (result != null)
        {
            Snackbar.Add("Quotation approved successfully!", Severity.Success);
            await AuditService.LogAsync(AuditActions.ApproveQuotation, "Quotation", id.ToString());
            await LoadQuotations();
        }
        else
        {
            Snackbar.Add("Failed to approve quotation.", Severity.Error);
        }
    }

    // ── Convert to sales order ──────────────────────────

    private void OpenConvertDialog(QuotationDto quotation)
    {
        if (convertingQuotationId != null)
            return;

        convertQuotation = quotation;
    }

    private void CloseConvertDialog()
    {
        if (convertingQuotationId != null)
            return;

        convertQuotation = null;
    }

    private async Task ConfirmConvertToSalesOrder()
    {
        if (convertQuotation == null)
            return;

        var quotation = convertQuotation;
        convertingQuotationId = quotation.Id;
        StateHasChanged();

        try
        {
            var salesOrder = await QuotationService.ConvertToSalesOrderAsync(quotation.Id);
            if (salesOrder != null)
            {
                Snackbar.Add($"Quotation converted to Sales Order {salesOrder.OrderNumber} successfully!", Severity.Success);
                await AuditService.LogAsync(AuditActions.ConvertQuotationToOrder, "Quotation", quotation.Id.ToString(), $"Converted to Sales Order {salesOrder.OrderNumber}", true);
                convertQuotation = null;
                CloseDrawer();
                await LoadQuotations();
            }
            else
            {
                Snackbar.Add("Failed to convert quotation to sales order. Please try again.", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error converting quotation: {ex.Message}", Severity.Error);
        }
        finally
        {
            convertingQuotationId = null;
            StateHasChanged();
        }
    }

    // ── Delete ──────────────────────────────────────────

    private void OpenDeleteDialog(QuotationDto quotation)
    {
        if (isDeleting)
            return;

        deleteQuotation = quotation;
    }

    private void CloseDeleteDialog()
    {
        if (isDeleting)
            return;

        deleteQuotation = null;
    }

    private async Task ConfirmDeleteQuotation()
    {
        if (deleteQuotation == null)
            return;

        var id = deleteQuotation.Id;
        isDeleting = true;
        StateHasChanged();

        try
        {
            var success = await QuotationService.DeleteQuotationAsync(id);
            if (success)
            {
                Snackbar.Add("Quotation deleted successfully.", Severity.Success);
                await AuditService.LogAsync(AuditActions.DeleteQuotation, "Quotation", id.ToString());
                deleteQuotation = null;

                if (selectedQuotation?.Id == id)
                {
                    CloseDrawer();
                }

                await LoadQuotations();
            }
            else
            {
                Snackbar.Add("Failed to delete quotation.", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error deleting quotation: {ex.Message}", Severity.Error);
        }
        finally
        {
            isDeleting = false;
            StateHasChanged();
        }
    }

    // ── Reprice dialog ──────────────────────────────────

    private async Task OpenRepriceModal(QuotationDto quotation)
    {
        if (!CanRepriceQuotation(quotation))
        {
            return;
        }

        // Repricing rewrites the whole document, so it needs the lines the list no longer carries.
        var detailed = await EnsureLinesLoadedAsync(quotation);
        if (detailed is null)
        {
            Snackbar.Add("Couldn't load this quotation for editing. Please try again.", Severity.Error);
            return;
        }

        quotation = detailed;

        repriceQuotation = quotation;
        editingQuotationId = quotation.Id;
        showRepriceModal = true;
        validUntilDate = quotation.ValidUntil;
        newQuotation = new CreateQuotationRequest
        {
            CardCode = quotation.CardCode,
            CardName = quotation.CardName,
            CustomerRefNo = quotation.CustomerRefNo,
            ContactPerson = quotation.ContactPerson,
            Comments = quotation.Comments,
            TermsAndConditions = quotation.TermsAndConditions,
            Currency = quotation.Currency,
            DiscountPercent = quotation.DiscountPercent,
            ShipToAddress = quotation.ShipToAddress,
            BillToAddress = quotation.BillToAddress,
            WarehouseCode = quotation.WarehouseCode,
            Lines = quotation.Lines
                .OrderBy(line => line.LineNum)
                .Select(line => new CreateQuotationLineRequest
                {
                    ItemCode = line.ItemCode,
                    ItemDescription = line.ItemDescription,
                    Quantity = line.Quantity,
                    UnitPrice = line.UnitPrice,
                    DiscountPercent = line.DiscountPercent,
                    TaxPercent = line.TaxPercent,
                    WarehouseCode = line.WarehouseCode,
                    UoMCode = line.UoMCode
                })
                .ToList()
        };
    }

    private void CloseRepriceModal()
    {
        if (isSaving)
            return;

        showRepriceModal = false;
        repriceQuotation = null;
        editingQuotationId = null;
    }

    private decimal CalculateSubTotal()
    {
        return newQuotation.Lines.Sum(l => l.Quantity * l.UnitPrice * (1 - l.DiscountPercent / 100));
    }

    private decimal CalculateHeaderDiscount()
    {
        return CalculateSubTotal() * newQuotation.DiscountPercent / 100;
    }

    private decimal CalculateTaxTotal()
    {
        return newQuotation.Lines.Sum(l => l.Quantity * l.UnitPrice * (1 - l.DiscountPercent / 100) * l.TaxPercent / 100);
    }

    private decimal CalculateTotal()
    {
        return CalculateSubTotal() - CalculateHeaderDiscount() + CalculateTaxTotal();
    }

    private async Task SaveReprice()
    {
        if (!editingQuotationId.HasValue)
        {
            Snackbar.Add("No quotation selected for repricing.", Severity.Error);
            return;
        }

        if (newQuotation.Lines.Count == 0)
        {
            Snackbar.Add("A quotation needs at least one line item.", Severity.Warning);
            return;
        }

        isSaving = true;
        try
        {
            newQuotation.ValidUntil = validUntilDate;

            var updated = await QuotationService.RepriceQuotationAsync(editingQuotationId.Value, newQuotation);
            if (updated != null)
            {
                ReplaceQuotation(updated);
                selectedQuotation = selectedQuotation?.Id == updated.Id ? updated : selectedQuotation;
                isSaving = false;
                CloseRepriceModal();
                Snackbar.Add($"Quotation {updated.QuotationNumber} updated locally. SAP review is still required.", Severity.Warning);
                await AuditService.LogAsync(AuditActions.UpdateQuotation, "Quotation", updated.QuotationNumber, "Repriced local quotation; SAP review pending.");
            }
            else
            {
                Snackbar.Add("Failed to update quotation.", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error: {ex.Message}", Severity.Error);
        }
        finally
        {
            isSaving = false;
        }
    }

    private void ReplaceQuotation(QuotationDto updatedQuotation)
    {
        if (quotations is null)
        {
            return;
        }

        var quotationIndex = quotations.FindIndex(quotation => quotation.Id == updatedQuotation.Id);
        if (quotationIndex >= 0)
        {
            quotations[quotationIndex] = updatedQuotation;
        }
    }

    private bool CanRepriceQuotation(QuotationDto? quotation)
    {
        return dataSource == "local"
            && quotation is not null
            && !quotation.SalesOrderId.HasValue
            && quotation.Status != QuotationStatus.Accepted
            && quotation.Status != QuotationStatus.Converted
            && quotation.Status != QuotationStatus.Cancelled;
    }

    private static bool CanConvert(QuotationDto quotation)
        => (quotation.Status == QuotationStatus.Approved || quotation.Status == QuotationStatus.Accepted)
            && quotation.SalesOrderId == null;

    /// <summary>
    /// True when the quotation's validity has run out and that still matters — a converted or
    /// cancelled quotation is settled, so its lapsed date is not worth flagging.
    /// </summary>
    private static bool HasLapsed(QuotationDto quotation)
        => quotation.ValidUntil.HasValue
            && quotation.ValidUntil.Value < DateTime.UtcNow
            && quotation.Status != QuotationStatus.Converted
            && quotation.Status != QuotationStatus.Cancelled;

    private static string ValidUntilClass(QuotationDto quotation)
    {
        if (!quotation.ValidUntil.HasValue)
            return "is-unset";

        return HasLapsed(quotation) ? "is-lapsed" : string.Empty;
    }

    /// <summary>
    /// The dot beside a status. Nocturne reserves a colour fill for the states that
    /// need acting on; everything settled reads in neutral ink.
    /// </summary>
    private static string GetStatusDotClass(QuotationStatus status) => status switch
    {
        QuotationStatus.Draft => "is-draft",
        QuotationStatus.Pending or QuotationStatus.Sent => "is-pending",
        QuotationStatus.Approved or QuotationStatus.Accepted => "is-live",
        QuotationStatus.Converted => "is-done",
        QuotationStatus.Rejected => "is-bad",
        QuotationStatus.Expired or QuotationStatus.Cancelled => "is-void",
        _ => "is-draft"
    };

    private static string GetStatusTextClass(QuotationStatus status) => status switch
    {
        QuotationStatus.Approved or QuotationStatus.Accepted => "is-live",
        QuotationStatus.Rejected => "is-bad",
        _ => string.Empty
    };
}
