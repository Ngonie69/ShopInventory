@page "/quotations"
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize(Roles = "Admin,Cashier")]
@inject IQuotationService QuotationService
@inject ISnackbar Snackbar
@inject IJSRuntime JS
@inject ILogger<Quotations> Logger
@inject IAppSettingsProvider AppSettings
@inject IAuditService AuditService
@rendermode InteractiveServer

<PageTitle>Quotations - Shop Inventory</PageTitle>

@* Nocturne, carried by wwwroot/css/quotations.css (linked from App.razor) in
   both schemes, following the app's theme toggle like every other page. The
   palette and density scale are credit-notes.css's, unchanged, so the list
   pages read as one system.

   Icon-only buttons draw their glyph inline rather than from the Phosphor font:
   the glyph is their whole label, so a font that fails to load would leave them
   reading as dead controls.

   New quotations are raised on /quotations/create. The dialog here only
   reprices an existing local quotation — the customer, currency and line items
   are locked, which is why those controls are read-only rather than absent. *@

<div class="qtx">

    <header class="qtx-head">
        <div class="qtx-shell">
            <div class="qtx-titles">
                <div class="qtx-titles-row">
                    <i class="ph ph-file-text" aria-hidden="true"></i>
                    <h1 class="qtx-title">Quotations</h1>
                </div>
                <p class="qtx-sub">Create and manage customer quotations</p>
            </div>
            <div class="qtx-head-actions">
                <span class="qtx-count">@totalCount.ToString("N0") quotations</span>
                <a class="qtx-btn qtx-btn-primary" href="/quotations/create">
                    <i class="ph ph-plus" aria-hidden="true"></i>New quotation
                </a>
            </div>
        </div>
        <div class="qtx-rule"></div>
    </header>

    <div class="qtx-body">

        @if (!string.IsNullOrEmpty(errorMessage))
        {
            <div class="qtx-alert" role="alert">
                <i class="ph ph-warning-octagon" aria-hidden="true"></i>
                <div class="qtx-alert-body">@errorMessage</div>
                <button type="button" class="qtx-btn qtx-btn-ghost qtx-btn-icon-sm" title="Dismiss"
                        aria-label="Dismiss error" @onclick="() => errorMessage = null">
                    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"></path></svg>
                </button>
            </div>
        }

        @if (IsFirstLoad)
        {
            <section class="qtx-stats" aria-hidden="true">
                @for (var skeletonTile = 0; skeletonTile < 5; skeletonTile++)
                {
                    <div class="qtx-stat">
                        <span class="qtx-stat-mark is-quiet"></span>
                        <div style="flex:1">
                            <div class="qtx-skel" style="width:52%;height:15px;margin-bottom:6px"></div>
                            <div class="qtx-skel" style="width:74%;height:9px"></div>
                        </div>
                    </div>
                }
            </section>
        }
        else if (quotations?.Any() == true)
        {
            @* Counted over the loaded set. The list is fetched whole and filtered in
               the browser, so these are counts of everything the filters matched. *@
            <section class="qtx-stats" aria-label="Quotation counts">
                <div class="qtx-stat">
                    <span class="qtx-stat-mark" aria-hidden="true"><i class="ph ph-file-text"></i></span>
                    <div>
                        <div class="qtx-stat-value">@totalCount.ToString("N0")</div>
                        <div class="qtx-stat-label">Total</div>
                    </div>
                </div>
                <div class="qtx-stat">
                    <span class="qtx-stat-mark is-quiet" aria-hidden="true"><i class="ph ph-pencil-simple"></i></span>
                    <div>
                        <div class="qtx-stat-value">@quotations.Count(q => q.Status == QuotationStatus.Draft)</div>
                        <div class="qtx-stat-label">Draft</div>
                    </div>
                </div>
                <div class="qtx-stat">
                    <span class="qtx-stat-mark" aria-hidden="true"><i class="ph ph-check-circle"></i></span>
                    <div>
                        <div class="qtx-stat-value">
                            @quotations.Count(q => q.Status == QuotationStatus.Approved || q.Status == QuotationStatus.Accepted)
                        </div>
                        <div class="qtx-stat-label">Approved</div>
                    </div>
                </div>
                <div class="qtx-stat">
                    <span class="qtx-stat-mark" aria-hidden="true"><i class="ph ph-arrows-clockwise"></i></span>
                    <div>
                        <div class="qtx-stat-value">@quotations.Count(q => q.Status == QuotationStatus.Converted)</div>
                        <div class="qtx-stat-label">Converted</div>
                    </div>
                </div>
                <div class="qtx-stat">
                    <span class="qtx-stat-mark is-quiet" aria-hidden="true"><i class="ph ph-clock-countdown"></i></span>
                    <div>
                        <div class="qtx-stat-value">
                            @quotations.Count(q => q.Status == QuotationStatus.Expired || q.IsExpired)
                        </div>
                        <div class="qtx-stat-label">Expired</div>
                    </div>
                </div>
            </section>
        }

        <section class="qtx-filters">
            <div class="qtx-field">
                <label id="qtx-src-label">Data source</label>
                <div class="qtx-seg" role="group" aria-labelledby="qtx-src-label">
                    <button type="button" class="qtx-seg-btn @(dataSource == "sap" ? "is-on" : null)"
                            aria-pressed="@(dataSource == "sap")" disabled="@isLoading"
                            @onclick='() => SwitchDataSource("sap")'>
                        <i class="ph ph-cloud-arrow-down" aria-hidden="true"></i>SAP
                    </button>
                    <button type="button" class="qtx-seg-btn @(dataSource == "local" ? "is-on" : null)"
                            aria-pressed="@(dataSource == "local")" disabled="@isLoading"
                            @onclick='() => SwitchDataSource("local")'>
                        <i class="ph ph-database" aria-hidden="true"></i>Local
                    </button>
                </div>
            </div>
            <div class="qtx-field" style="width:190px">
                <label for="qtx-f-customer">Customer</label>
                <input id="qtx-f-customer" class="qtx-input" type="text" placeholder="Customer code"
                       @bind="customerFilter" @bind:event="oninput" @onkeydown="HandleFilterKeyDown" />
            </div>
            <div class="qtx-field" style="width:160px">
                <label for="qtx-f-status">Status</label>
                <div class="qtx-select">
                    <select id="qtx-f-status" class="qtx-input" @bind="statusFilter">
                        <option value="">All statuses</option>
                        @foreach (QuotationStatus status in Enum.GetValues<QuotationStatus>())
                        {
                            <option value="@(((int)status).ToString())">@status</option>
                        }
                    </select>
                    <span class="qtx-caret" aria-hidden="true"></span>
                </div>
            </div>
            <div class="qtx-field" style="width:140px">
                <label for="qtx-f-from">From date</label>
                <input id="qtx-f-from" class="qtx-input qtx-input-num" type="date" @bind="fromDate" />
            </div>
            <div class="qtx-field" style="width:140px">
                <label for="qtx-f-to">To date</label>
                <input id="qtx-f-to" class="qtx-input qtx-input-num" type="date" @bind="toDate" />
            </div>
            <div class="qtx-filter-actions">
                <button type="button" class="qtx-btn qtx-btn-ghost" @onclick="ClearFilter" disabled="@isLoading">
                    Clear
                </button>
                <button type="button" class="qtx-btn qtx-btn-secondary" @onclick="ApplyFilter" disabled="@isLoading">
                    <i class="ph ph-magnifying-glass" aria-hidden="true"></i>@(isLoading ? "Searching…" : "Search")
                </button>
            </div>
        </section>

        <section class="qtx-card">

            @* A refresh keeps the rows on screen; only this strip moves. *@
            @if (isLoading && !IsFirstLoad)
            {
                <div class="qtx-refresh" role="status" aria-label="Refreshing quotations"></div>
            }

            <div class="qtx-toolbar">
                <span class="qtx-range">@RangeLabel</span>
                <span class="qtx-hint">
                    <i class="ph ph-cursor-click" aria-hidden="true"></i>
                    Reading from @(dataSource == "sap" ? "SAP" : "the local database")
                </span>
            </div>

            <div class="qtx-tablewrap">
                <table class="qtx-table">
                    <thead>
                        <tr>
                            <th>Quote #</th>
                            <th>Customer</th>
                            <th>Date</th>
                            <th>Valid until</th>
                            <th>Status</th>
                            <th>Currency</th>
                            <th class="qtx-num">Total</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (IsFirstLoad)
                        {
                            @for (var skeletonRow = 0; skeletonRow < 8; skeletonRow++)
                            {
                                <tr>
                                    @for (var skeletonCell = 0; skeletonCell < 8; skeletonCell++)
                                    {
                                        <td><div class="qtx-skel"></div></td>
                                    }
                                </tr>
                            }
                        }
                        else
                        {
                            @foreach (var quotation in PageRows)
                            {
                                <tr @key="quotation.Id">
                                    <td>
                                        <button type="button" class="qtx-link" @onclick="() => ViewQuotation(quotation)">
                                            @quotation.QuotationNumber
                                        </button>
                                    </td>
                                    <td>
                                        <span class="qtx-cust">
                                            <span class="qtx-cust-name">@quotation.CardName</span>
                                            <span class="qtx-cust-code">@quotation.CardCode</span>
                                        </span>
                                    </td>
                                    <td class="qtx-date">@quotation.QuotationDate.ToString("dd MMM yyyy")</td>
                                    <td class="qtx-date @ValidUntilClass(quotation)">
                                        @(quotation.ValidUntil?.ToString("dd MMM yyyy") ?? "—")
                                        @if (HasLapsed(quotation))
                                        {
                                            <i class="ph ph-warning" title="Expired" aria-label="Expired"></i>
                                        }
                                    </td>
                                    <td>
                                        <span class="qtx-status">
                                            <span class="qtx-dot @GetStatusDotClass(quotation.Status)" aria-hidden="true"></span>
                                            <span class="qtx-status-text @GetStatusTextClass(quotation.Status)">@quotation.StatusName</span>
                                        </span>
                                    </td>
                                    <td class="qtx-curr">@quotation.Currency</td>
                                    <td class="qtx-num">@quotation.DocTotal.ToString("N2")</td>
                                    <td>
                                        <span class="qtx-rowactions">
                                            <button type="button" class="qtx-btn qtx-btn-ghost qtx-btn-icon-sm"
                                                    title="View quotation" aria-label="View quotation @quotation.QuotationNumber"
                                                    @onclick="() => ViewQuotation(quotation)">
                                                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M2 12s3.6-6 10-6 10 6 10 6-3.6 6-10 6-10-6-10-6z"></path><circle cx="12" cy="12" r="2.6"></circle></svg>
                                            </button>
                                            @if (CanRepriceQuotation(quotation))
                                            {
                                                <button type="button" class="qtx-btn qtx-btn-ghost qtx-btn-icon-sm"
                                                        title="Edit or reprice" aria-label="Edit or reprice quotation @quotation.QuotationNumber"
                                                        @onclick="() => OpenRepriceModal(quotation)">
                                                    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 20h4L19 9a2.1 2.1 0 0 0-3-3L5 17z"></path></svg>
                                                </button>
                                            }
                                            @if (CanConvert(quotation))
                                            {
                                                <button type="button" class="qtx-btn qtx-btn-ghost qtx-btn-icon-sm"
                                                        title="Convert to sales order"
                                                        aria-label="Convert quotation @quotation.QuotationNumber to a sales order"
                                                        disabled="@(convertingQuotationId == quotation.Id)"
                                                        @onclick="() => OpenConvertDialog(quotation)">
                                                    @if (convertingQuotationId == quotation.Id)
                                                    {
                                                        <span class="qtx-spin" aria-hidden="true"></span>
                                                    }
                                                    else
                                                    {
                                                        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 7h11v9H3z"></path><path d="M14 10h4l3 3v3h-7"></path><path d="M7 19a2 2 0 1 0 0-.01M18 19a2 2 0 1 0 0-.01"></path></svg>
                                                    }
                                                </button>
                                            }
                                            @if (quotation.Status == QuotationStatus.Draft || quotation.Status == QuotationStatus.Pending)
                                            {
                                                <button type="button" class="qtx-btn qtx-btn-ghost qtx-btn-icon-sm"
                                                        title="Approve" aria-label="Approve quotation @quotation.QuotationNumber"
                                                        @onclick="() => ApproveQuotation(quotation.Id)">
                                                    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12.5l4.5 4.5L19 7"></path></svg>
                                                </button>
                                            }
                                            @if (quotation.Status == QuotationStatus.Draft || quotation.Status == QuotationStatus.Cancelled)
                                            {
                                                <button type="button" class="qtx-btn qtx-btn-ghost qtx-btn-icon-sm"
                                                        title="Delete" aria-label="Delete quotation @quotation.QuotationNumber"
                                                        @onclick="() => OpenDeleteDialog(quotation)">
                                                    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 7h16"></path><path d="M9 7V5h6v2"></path><path d="M6 7l1 13h10l1-13"></path></svg>
                                                </button>
                                            }
                                        </span>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>

            @if (!IsFirstLoad && quotations?.Any() != true)
            {
                <div class="qtx-empty">
                    <i class="ph ph-funnel-simple" aria-hidden="true"></i>
                    <span>No quotations found</span>
                    <span class="qtx-empty-sub">
                        Nothing in @(dataSource == "sap" ? "SAP" : "the local database") matches these filters.
                        Try the other source, or widen the dates.
                    </span>
                    <a class="qtx-btn qtx-btn-primary" href="/quotations/create">
                        <i class="ph ph-plus" aria-hidden="true"></i>New quotation
                    </a>
                </div>
            }

            <div class="qtx-foot">
                <span class="qtx-foot-range">@RangeLabel</span>
                <span class="qtx-pagesize">
                    <span>Rows</span>
                    <span class="qtx-select">
                        <select class="qtx-input" aria-label="Rows per page" @bind="_pageSize" @bind:after="ResetToFirstPage">
                            @foreach (var size in PageSizeOptions)
                            {
                                <option value="@size">@size</option>
                            }
                        </select>
                        <span class="qtx-caret" aria-hidden="true"></span>
                    </span>
                </span>
                <div class="qtx-pager">
                    <button type="button" class="qtx-btn qtx-btn-secondary qtx-btn-icon" title="Previous page"
                            aria-label="Previous page" disabled="@(displayPage <= 1)"
                            @onclick="() => GoToDisplayPage(displayPage - 1)">
                        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M15 6l-6 6 6 6"></path></svg>
                    </button>
                    <span class="qtx-page-label">Page @displayPage / @DisplayPageCount</span>
                    <button type="button" class="qtx-btn qtx-btn-secondary qtx-btn-icon" title="Next page"
                            aria-label="Next page" disabled="@(displayPage >= DisplayPageCount)"
                            @onclick="() => GoToDisplayPage(displayPage + 1)">
                        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 6l6 6-6 6"></path></svg>
                    </button>
                </div>
            </div>
        </section>
    </div>
</div>

@if (selectedQuotation != null)
{
    <div class="qtx-overlay">
        <div class="qtx-scrim" @onclick="CloseDrawer"></div>
        <aside class="qtx-drawer" aria-label="Quotation detail">
            <div class="qtx-drawer-head">
                <div class="qtx-drawer-titles">
                    <h2 class="qtx-drawer-title">
                        <i class="ph ph-file-text" aria-hidden="true"></i>
                        @selectedQuotation.QuotationNumber
                    </h2>
                    <p class="qtx-drawer-sub">
                        @(selectedQuotation.CardName ?? selectedQuotation.CardCode) ·
                        @selectedQuotation.Currency @selectedQuotation.DocTotal.ToString("N2")
                    </p>
                </div>
                <button type="button" class="qtx-btn qtx-btn-ghost qtx-btn-icon" title="Close"
                        aria-label="Close details" @onclick="CloseDrawer">
                    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"></path></svg>
                </button>
            </div>
            <div class="qtx-drawer-body">
                <div class="qtx-grid">
                    <div>
                        <div class="qtx-dt">Customer</div>
                        <div class="qtx-dd">@selectedQuotation.CardCode — @selectedQuotation.CardName</div>
                    </div>
                    <div>
                        <div class="qtx-dt">Status</div>
                        <div class="qtx-dd">
                            <span class="qtx-status">
                                <span class="qtx-dot @GetStatusDotClass(selectedQuotation.Status)" aria-hidden="true"></span>
                                <span class="qtx-status-text @GetStatusTextClass(selectedQuotation.Status)">@selectedQuotation.StatusName</span>
                            </span>
                        </div>
                    </div>
                    <div>
                        <div class="qtx-dt">Quotation date</div>
                        <div class="qtx-dd">@selectedQuotation.QuotationDate.ToString("dd MMM yyyy")</div>
                    </div>
                    <div>
                        <div class="qtx-dt">Valid until</div>
                        <div class="qtx-dd">@(selectedQuotation.ValidUntil?.ToString("dd MMM yyyy") ?? "—")</div>
                    </div>
                    <div>
                        <div class="qtx-dt">Contact person</div>
                        <div class="qtx-dd">@(selectedQuotation.ContactPerson ?? "—")</div>
                    </div>
                    <div>
                        <div class="qtx-dt">Salesperson</div>
                        <div class="qtx-dd">@(selectedQuotation.SalesPersonName ?? "—")</div>
                    </div>
                    <div>
                        <div class="qtx-dt">Currency</div>
                        <div class="qtx-dd">@selectedQuotation.Currency</div>
                    </div>
                    <div>
                        <div class="qtx-dt">Created by</div>
                        <div class="qtx-dd">@(selectedQuotation.CreatedByUserName ?? "—")</div>
                    </div>
                    @if (selectedQuotation.SalesOrderId.HasValue)
                    {
                        <div>
                            <div class="qtx-dt">Sales order</div>
                            <div class="qtx-dd">SO #@selectedQuotation.SalesOrderId</div>
                        </div>
                    }
                </div>

                @if (dataSource == "local" && !selectedQuotation.IsSynced)
                {
                    <div class="qtx-note is-warn">
                        This quotation has local changes that have not been pushed back to SAP.
                    </div>
                }

                @if (!string.IsNullOrEmpty(selectedQuotation.Comments))
                {
                    <div>
                        <div class="qtx-sect"><i class="ph ph-chat-text" aria-hidden="true"></i>Comments</div>
                        <div class="qtx-note is-prose">@selectedQuotation.Comments</div>
                    </div>
                }

                @if (!string.IsNullOrEmpty(selectedQuotation.TermsAndConditions))
                {
                    <div>
                        <div class="qtx-sect"><i class="ph ph-file-text" aria-hidden="true"></i>Terms &amp; conditions</div>
                        <div class="qtx-note is-prose">@selectedQuotation.TermsAndConditions</div>
                    </div>
                }

                <div>
                    <div class="qtx-sect">
                        <i class="ph ph-list-bullets" aria-hidden="true"></i>Line items
                        @if (!IsDetailLoading && !detailLoadFailed)
                        {
                            <span>(@selectedQuotation.Lines.Count)</span>
                        }
                    </div>
                    @if (IsDetailLoading)
                    {
                        <div class="qtx-note">Fetching the line items…</div>
                    }
                    else if (detailLoadFailed)
                    {
                        <div class="qtx-note is-warn">
                            Couldn't load the line items for this quotation. Close and reopen it to try again.
                        </div>
                    }
                    else
                    {
                        <div class="qtx-linescroll">
                            <table class="qtx-lines">
                                <thead>
                                    <tr>
                                        <th>#</th>
                                        <th>Item</th>
                                        <th>Description</th>
                                        <th class="qtx-num">Qty</th>
                                        <th class="qtx-num">Price</th>
                                        <th class="qtx-num">Disc %</th>
                                        <th class="qtx-num">VAT %</th>
                                        <th class="qtx-num">Total</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var line in selectedQuotation.Lines)
                                    {
                                        <tr>
                                            <td>@(line.LineNum + 1)</td>
                                            <td><span class="qtx-cust-name">@line.ItemCode</span></td>
                                            <td>@line.ItemDescription</td>
                                            <td class="qtx-num">@QuantityDisplay.Format(line.Quantity, line.UoMCode)</td>
                                            <td class="qtx-num">@line.UnitPrice.ToString("N2")</td>
                                            @* Up to six decimals so a special-price discount reads the same here as in
                                               SAP (5.714286%), while a typed 10% still shows as 10.0% *@
                                            <td class="qtx-num">@(line.DiscountPercent > 0 ? line.DiscountPercent.ToString("0.0####") + "%" : "—")</td>
                                            <td class="qtx-num">@(line.TaxPercent > 0 ? line.TaxPercent.ToString("N1") + "%" : "—")</td>
                                            <td class="qtx-num">@line.LineTotal.ToString("N2")</td>
                                        </tr>
                                    }
                                </tbody>
                                <tfoot>
                                    <tr>
                                        <td colspan="6"></td>
                                        <td class="qtx-num">Subtotal</td>
                                        <td class="qtx-num">@selectedQuotation.SubTotal.ToString("N2")</td>
                                    </tr>
                                    @if (selectedQuotation.DiscountAmount > 0)
                                    {
                                        <tr>
                                            <td colspan="6"></td>
                                            <td class="qtx-num qtx-neg">Discount</td>
                                            <td class="qtx-num qtx-neg">-@selectedQuotation.DiscountAmount.ToString("N2")</td>
                                        </tr>
                                    }
                                    <tr>
                                        <td colspan="6"></td>
                                        <td class="qtx-num">VAT</td>
                                        <td class="qtx-num">@selectedQuotation.TaxAmount.ToString("N2")</td>
                                    </tr>
                                </tfoot>
                            </table>
                        </div>

                        <div class="qtx-total">
                            <span class="qtx-total-label">Total</span>
                            <span class="qtx-total-value">@selectedQuotation.DocTotal.ToString("N2")</span>
                        </div>
                    }
                </div>
            </div>
            <div class="qtx-drawer-foot">
                @{
                    var isConverting = convertingQuotationId == selectedQuotation.Id;
                }
                @if (CanRepriceSelectedQuotation)
                {
                    <button type="button" class="qtx-btn qtx-btn-secondary"
                            disabled="@(IsDetailLoading || isConverting)"
                            @onclick="() => OpenRepriceModal(selectedQuotation)">
                        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 20h4L19 9a2.1 2.1 0 0 0-3-3L5 17z"></path></svg>Edit / reprice
                    </button>
                }
                @if (CanApplyStandardVat)
                {
                    <button type="button" class="qtx-btn qtx-btn-secondary"
                            disabled="@(isApplyingStandardVat || IsDetailLoading || isConverting)"
                            @onclick="ApplyStandardVat">
                        @if (isApplyingStandardVat)
                        {
                            <span class="qtx-spin" aria-hidden="true"></span>
                            <span>Applying…</span>
                        }
                        else
                        {
                            <span>Apply 15.5% VAT</span>
                        }
                    </button>
                }
                @if (CanDownloadQuotationPdf)
                {
                    <button type="button" class="qtx-btn qtx-btn-secondary" disabled="@(isPdfLoading || isConverting)"
                            @onclick="DownloadQuotationPdf">
                        @if (isPdfLoading)
                        {
                            <span class="qtx-spin" aria-hidden="true"></span>
                            <span>Preparing…</span>
                        }
                        else
                        {
                            <span>Download PDF</span>
                        }
                    </button>
                    <button type="button" class="qtx-btn qtx-btn-secondary" disabled="@(isPdfLoading || isConverting)"
                            @onclick="PrintQuotationPdf">
                        Print
                    </button>
                }
                <button type="button" class="qtx-btn qtx-btn-secondary" disabled="@isConverting" @onclick="CloseDrawer">
                    Close
                </button>
                @if (CanConvert(selectedQuotation))
                {
                    <button type="button" class="qtx-btn qtx-btn-primary" disabled="@(isConverting || IsDetailLoading)"
                            @onclick="() => OpenConvertDialog(selectedQuotation)">
                        @if (isConverting)
                        {
                            <span class="qtx-spin" aria-hidden="true"></span>
                            <span>Converting…</span>
                        }
                        else
                        {
                            <span>Convert to sales order</span>
                        }
                    </button>
                }
            </div>
        </aside>
    </div>
}

@if (showRepriceModal && repriceQuotation is not null)
{
    <div class="qtx-overlay">
        <div class="qtx-dialog-wrap" @onclick="CloseRepriceModal">
            <div class="qtx-dialog is-wide" role="dialog" aria-modal="true" aria-labelledby="qtx-reprice-title"
                 @onclick:stopPropagation="true">
                <div class="qtx-dialog-head">
                    <h2 class="qtx-dialog-title" id="qtx-reprice-title">
