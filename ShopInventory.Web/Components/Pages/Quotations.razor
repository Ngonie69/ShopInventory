@code {
    private const decimal DefaultVatPercent = 15.5m;

    /// <summary>
    /// How many quotation headers one page load pulls. The list is filtered, sorted and paged in the
    /// browser, so it wants the whole set; it is affordable because neither source returns line items
    /// here — the drawer fetches those for the one quotation being looked at.
    /// </summary>
    private const int ListFetchSize = 10000;

    /// <summary>How near its expiry a quotation has to be to count as expiring soon.</summary>
    private const int ExpiryWindowDays = 7;

    private static readonly int[] PageSizes = [10, 25, 50, 100, 200];

    private List<QuotationDto>? quotations;
    private QuotationDto? selectedQuotation;
    private bool isLoading = true;
    private bool isCreating = false;
    private bool isPdfLoading = false;
    private bool isExporting = false;
    private bool isApplyingStandardVat = false;
    private bool showCreateModal = false;
    private bool isEditMode = false;
    private string? errorMessage;
    private int? convertingQuotationId;
    private int? editingQuotationId;

    // Line items arrive with the quotation the user opens, not with the list. These track that fetch.
    private readonly HashSet<int> quotationsWithLines = new();
    private int? detailLoadingId;
    private bool detailLoadFailed;

    private bool IsDetailLoading => selectedQuotation is not null && detailLoadingId == selectedQuotation.Id;

    private bool IsFirstLoad => isLoading && (quotations is null || quotations.Count == 0);

    private string SourceName => dataSource == "sap" ? "SAP" : "the local database";

    private bool CanDownloadQuotationPdf => selectedQuotation is not null &&
        (dataSource == "local" || selectedQuotation.SAPDocEntry.HasValue);

    private bool CanRepriceSelectedQuotation => CanRepriceQuotation(selectedQuotation);

    private bool CanApplyStandardVat => dataSource == "local"
        && selectedQuotation is not null
        && CanRepriceQuotation(selectedQuotation)
        && selectedQuotation.Lines.Any(line => line.TaxPercent <= 0);

    // Data source toggle: "sap" or "local"
    private string dataSource = "sap";

    // Filters sent to the service on Search
    private string? customerFilter;
    private string? statusFilter;
    private DateTime? fromDate;
    private DateTime? toDate;

    // Filters applied to the rows already in hand: the status bucket the figures
    // press, the expiring-soon toggle, and the sort direction.
    private string bucket = "all";
    private bool expiringOnly;
    private bool newestFirst = true;

    // Paging. currentPage and fetchSize belong to the service call — it is asked
    // for the whole set in one go — and pageNumber/pageSize to the list itself.
    private int currentPage = 1;
    private int fetchSize = ListFetchSize;
    private int totalCount = 0;
    private int pageNumber = 1;
    private int pageSize = 25;

    // New quotation
    private CreateQuotationRequest newQuotation = new();
    private DateTime? validUntilDate;

    // Business Partner autocomplete state
    private List<BusinessPartnerDto> allBusinessPartners = new();
    private BusinessPartnerDto? selectedBusinessPartner;
    private string? bpSearchTerm;
    private bool showBPDropdown = false;
    private bool isLoadingMasterData = true;

    private IEnumerable<BusinessPartnerDto> filteredBusinessPartners
    {
        get
        {
            if (string.IsNullOrWhiteSpace(bpSearchTerm))
                return allBusinessPartners.Take(50);

            var search = bpSearchTerm.ToLowerInvariant();
            return allBusinessPartners.Where(bp =>
                (bp.CardCode?.ToLowerInvariant().Contains(search) ?? false) ||
                (bp.CardName?.ToLowerInvariant().Contains(search) ?? false));
        }
    }

    protected override async Task OnInitializedAsync()
    {
        pageSize = PageSizes.Contains(AppSettings.PageSize) ? AppSettings.PageSize : 25;
        await LoadQuotations();
        await AuditService.LogAsync(AuditActions.ViewQuotations, "Quotation", null);
    }

    // ── The list in hand ────────────────────────────────────────────────────

    /// <summary>The loaded quotations after the bucket, the expiry toggle and the sort.</summary>
    private List<QuotationDto> Filtered
    {
        get
        {
            IEnumerable<QuotationDto> rows = quotations ?? Enumerable.Empty<QuotationDto>();

            rows = bucket switch
            {
                "draft" => rows.Where(quotation => quotation.Status == QuotationStatus.Draft),
                "approved" => rows.Where(IsApproved),
                "converted" => rows.Where(quotation => quotation.Status == QuotationStatus.Converted),
                "expired" => rows.Where(IsExpired),
                _ => rows
            };

            if (expiringOnly)
            {
                rows = rows.Where(IsExpiringSoon);
            }

            rows = newestFirst
                ? rows.OrderByDescending(quotation => quotation.QuotationDate).ThenByDescending(quotation => quotation.Id)
                : rows.OrderBy(quotation => quotation.QuotationDate).ThenBy(quotation => quotation.Id);

            return rows.ToList();
        }
    }

    private static bool IsApproved(QuotationDto quotation) =>
        quotation.Status is QuotationStatus.Approved or QuotationStatus.Accepted;

    private static bool IsExpired(QuotationDto quotation) =>
        quotation.Status == QuotationStatus.Expired || quotation.IsExpired;

    /// <summary>Approved, not yet ordered and not lapsed — the quotes still worth chasing.</summary>
    private static bool IsOpen(QuotationDto quotation) =>
        IsApproved(quotation) && quotation.SalesOrderId is null && !IsExpired(quotation);

    private static bool IsExpiringSoon(QuotationDto quotation)
    {
        if (quotation.ValidUntil is not { } validUntil || IsExpired(quotation))
            return false;

        if (quotation.Status is QuotationStatus.Converted or QuotationStatus.Cancelled)
            return false;

        var days = (validUntil.Date - DateTime.Today).TotalDays;
        return days >= 0 && days <= ExpiryWindowDays;
    }

    private string LedeText
    {
        get
        {
            if (IsFirstLoad)
                return $"Loading quotations from {SourceName}…";

            if (quotations is null || quotations.Count == 0)
                return $"No quotations came back from {SourceName} for this search.";

            var open = quotations.Count(IsOpen);
            var soon = quotations.Count(IsExpiringSoon);

            if (open == 0)
                return $"No approved quotes are open — {quotations.Count:N0} quotations on file for this search.";

            return soon == 0
                ? $"{open:N0} approved quotes are still open — none expire inside {ExpiryWindowDays} days."
                : $"{open:N0} approved quotes are still open — {soon:N0} of them expire inside {ExpiryWindowDays} days.";
        }
    }

    private sealed record StatCard(string Key, string Label, string Icon, string Tone, string Value, string Share);

    private List<StatCard> StatCards()
    {
        var rows = quotations ?? new List<QuotationDto>();
        var loaded = rows.Count;

        // The share each status holds of what is loaded. Total carries the
        // service's own count instead, which can exceed the fetched page.
        string Share(int count) => loaded == 0 || count == 0
            ? "none"
            : $"{Math.Round(count * 100d / loaded)}%";

        var draft = rows.Count(quotation => quotation.Status == QuotationStatus.Draft);
        var approved = rows.Count(IsApproved);
        var converted = rows.Count(quotation => quotation.Status == QuotationStatus.Converted);
        var expired = rows.Count(IsExpired);

        return
        [
            new("all", "Total", "ph-files", "", (totalCount > 0 ? totalCount : loaded).ToString("N0"), "all time"),
            new("draft", "Draft", "ph-pencil-simple", "", draft.ToString("N0"), draft == 0 ? "none open" : Share(draft)),
            new("approved", "Approved", "ph-check-circle", "qtn-tone-ok", approved.ToString("N0"), Share(approved)),
            new("converted", "Converted", "ph-arrows-clockwise", "qtn-tone-accent", converted.ToString("N0"), Share(converted)),
            new("expired", "Expired", "ph-clock-countdown", "qtn-tone-warn", expired.ToString("N0"), Share(expired))
        ];
    }

    private string RangeLabel(int rowCount, int page)
    {
        if (rowCount == 0)
            return "No records";

        var first = ((page - 1) * pageSize) + 1;
        var last = Math.Min(page * pageSize, rowCount);
        return $"{rowCount:N0} records · showing {first:N0}–{last:N0}";
    }

    private static string StatusBadgeClass(QuotationDto quotation) => quotation.Status switch
    {
        QuotationStatus.Approved or QuotationStatus.Accepted => "qtn-badge-ok",
        QuotationStatus.Converted or QuotationStatus.Sent => "qtn-badge-accent",
        QuotationStatus.Expired or QuotationStatus.Rejected => "qtn-badge-warn",
        _ => quotation.IsExpired ? "qtn-badge-warn" : string.Empty
    };

    private static string ValidClass(QuotationDto quotation) =>
        IsExpired(quotation) ? "qtn-valid-gone" : IsExpiringSoon(quotation) ? "qtn-valid-soon" : string.Empty;

    private static bool CanConvert(QuotationDto quotation) =>
        IsApproved(quotation) && quotation.SalesOrderId is null;

    // ── List-side filters ───────────────────────────────────────────────────

    /// <summary>
    /// The figures and the status dropdown ask the same question, so pressing one
    /// releases the other rather than leaving two filters silently stacked.
    /// </summary>
    private void SelectBucket(string key)
    {
        bucket = bucket == key ? "all" : key;
        if (bucket != "all")
        {
            statusFilter = null;
        }

        ResetPage();
    }

    private async Task ApplyStatusFilter()
    {
        if (!string.IsNullOrEmpty(statusFilter))
        {
            bucket = "all";
        }

        ResetPage();
        await LoadQuotations();
    }

    private void ToggleExpiringOnly()
    {
        expiringOnly = !expiringOnly;
        ResetPage();
    }

    private void ToggleSort()
    {
        newestFirst = !newestFirst;
        ResetPage();
    }

    private void ClearListFilters()
    {
        bucket = "all";
        expiringOnly = false;
        ResetPage();
    }

    private async Task HandleFilterKeyDown(KeyboardEventArgs args)
    {
        if (args.Key == "Enter")
        {
            await ApplyFilter();
        }
    }

    // ── Paging ──────────────────────────────────────────────────────────────

    private int PageCount(int rowCount) => Math.Max(1, (rowCount + pageSize - 1) / pageSize);

    // Filtering can shrink the list under the page currently being read.
    private int ClampPage(int rowCount)
    {
        var pages = PageCount(rowCount);
        if (pageNumber > pages)
            pageNumber = pages;
        if (pageNumber < 1)
            pageNumber = 1;
        return pageNumber;
    }

    private void GoToPage(int page) => pageNumber = page;

    private void ResetPage() => pageNumber = 1;

    // The design's "1 2 3 4 5 … 62": the ends, the current page and its
    // neighbours, with a gap standing in for everything skipped.
    private static List<int?> PageSlots(int current, int pages)
    {
        var slots = new List<int?>();
        var last = 0;

        for (var page = 1; page <= pages; page++)
        {
            var keep = page == 1 || page == pages || Math.Abs(page - current) <= 1;
            if (!keep)
                continue;

            if (last > 0 && page - last > 1)
                slots.Add(null);

            slots.Add(page);
            last = page;
        }

        return slots;
    }

    // ── Loading ─────────────────────────────────────────────────────────────

    private async Task SwitchDataSource(string source)
    {
        if (dataSource == source)
            return;

        dataSource = source;
        currentPage = 1;
        ResetPage();
        await LoadQuotations();
    }

    private async Task LoadQuotations()
    {
        isLoading = true;
        errorMessage = null;
        // Ids are only unique within a source, and the rows about to arrive carry no lines yet.
        quotationsWithLines.Clear();

        try
        {
            if (dataSource == "sap")
            {
                var response = await QuotationService.GetQuotationsFromSAPAsync(currentPage, fetchSize, customerFilter, fromDate, toDate);
                if (response != null)
                {
                    quotations = response.Quotations;
                    totalCount = response.TotalCount;

                    // Apply client-side status filter for SAP quotations
                    if (!string.IsNullOrEmpty(statusFilter) && int.TryParse(statusFilter, out var statusInt))
                    {
                        var status = (QuotationStatus)statusInt;
                        quotations = quotations?.Where(q => q.Status == status).ToList();
                    }
                }
                else
                {
                    quotations = new();
                    errorMessage = "Failed to load quotations from SAP. The API may be unavailable.";
                }
            }
            else
            {
                QuotationStatus? status = null;
                if (!string.IsNullOrEmpty(statusFilter) && int.TryParse(statusFilter, out var statusInt))
                {
                    status = (QuotationStatus)statusInt;
                }

                var response = await QuotationService.GetQuotationsAsync(currentPage, fetchSize, status, customerFilter, fromDate, toDate);
                if (response != null)
                {
                    quotations = response.Quotations;
                    totalCount = response.TotalCount;
                }
                else
                {
                    quotations = new();
                    errorMessage = "Failed to load quotations. The API may be unavailable.";
                }
            }
        }
        catch (Exception ex)
        {
            quotations = new();
            errorMessage = $"Error loading quotations: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task ApplyFilter()
    {
        ResetPage();
        await LoadQuotations();
    }

    private async Task ClearFilter()
    {
        customerFilter = null;
        statusFilter = null;
        fromDate = null;
        toDate = null;
        currentPage = 1;
        bucket = "all";
        expiringOnly = false;
        ResetPage();
        await LoadQuotations();
    }

    // ── Export ──────────────────────────────────────────────────────────────

    /// <summary>Writes what the list currently shows — every filter applied, every page.</summary>
    private async Task ExportCsv()
    {
        isExporting = true;
        try
        {
            var rows = Filtered;
            var csv = new StringBuilder();
            csv.AppendLine("Quote,Customer Code,Customer,Issued,Valid Until,Status,Currency,Total");

            foreach (var quotation in rows)
            {
                csv.Append(Csv(quotation.QuotationNumber)).Append(',')
                   .Append(Csv(quotation.CardCode)).Append(',')
                   .Append(Csv(quotation.CardName)).Append(',')
                   .Append(quotation.QuotationDate.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture)).Append(',')
                   .Append(quotation.ValidUntil?.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture) ?? string.Empty).Append(',')
                   .Append(Csv(quotation.StatusName)).Append(',')
                   .Append(Csv(quotation.Currency ?? "USD")).Append(',')
                   .Append(quotation.DocTotal.ToString("0.00", CultureInfo.InvariantCulture))
                   .Append('\n');
            }

            // The BOM is what makes Excel read the file as UTF-8; without it,
            // customer names with accents arrive mangled.
            var bytes = new UTF8Encoding(true).GetBytes(csv.ToString());
            var fileName = $"Quotations_{DateTime.Now:yyyyMMdd_HHmmss}.csv";

            await JS.InvokeVoidAsync("downloadFile", fileName, Convert.ToBase64String(bytes));
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error exporting quotations");
            errorMessage = "We couldn't export the quotations right now. Please try again.";
        }
        finally
        {
            isExporting = false;
        }
    }

    private static string Csv(string? value)
    {
        if (string.IsNullOrEmpty(value))
            return string.Empty;

        return value.Contains(',') || value.Contains('"') || value.Contains('\n')
            ? $"\"{value.Replace("\"", "\"\"")}\""
            : value;
    }

    // ── Drawer ──────────────────────────────────────────────────────────────

    private async Task ViewQuotation(QuotationDto quotation)
    {
        // The header is already in hand, so the drawer opens on the first frame; only the line items
        // have to be fetched, and they render into the section that shows a placeholder meanwhile.
        selectedQuotation = quotation;
        detailLoadFailed = false;

        var detailed = await EnsureLinesLoadedAsync(quotation);
        if (detailed is null && selectedQuotation?.Id == quotation.Id)
        {
            detailLoadFailed = true;
        }
    }

    private void CloseDrawer()
    {
        selectedQuotation = null;
        detailLoadFailed = false;
    }

    /// <summary>
    /// Returns the quotation with its line items, fetching the full document the first time it is
    /// asked for. Returns null when the fetch fails.
    /// </summary>
    private async Task<QuotationDto?> EnsureLinesLoadedAsync(QuotationDto quotation)
    {
        if (quotationsWithLines.Contains(quotation.Id))
        {
            return quotation;
        }

        detailLoadingId = quotation.Id;
        try
        {
            var detailed = dataSource == "sap"
                ? await QuotationService.GetQuotationFromSAPByDocEntryAsync(quotation.SAPDocEntry ?? quotation.Id)
                : await QuotationService.GetQuotationByIdAsync(quotation.Id);

            if (detailed is null)
            {
                Logger.LogWarning("Could not load line items for quotation {QuotationNumber}", quotation.QuotationNumber);
                return null;
            }

            quotationsWithLines.Add(detailed.Id);
            ReplaceQuotation(detailed);

            if (selectedQuotation?.Id == detailed.Id)
            {
                selectedQuotation = detailed;
            }

            return detailed;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error loading line items for quotation {QuotationNumber}", quotation.QuotationNumber);
            return null;
        }
        finally
        {
            if (detailLoadingId == quotation.Id)
            {
                detailLoadingId = null;
            }
        }
    }

    private async Task DownloadQuotationPdf()
    {
        if (selectedQuotation == null || isPdfLoading || !CanDownloadQuotationPdf)
        {
            return;
        }

        isPdfLoading = true;
        try
        {
            var pdfBytes = dataSource == "sap"
                ? await QuotationService.GetQuotationPdfFromSAPAsync(selectedQuotation.SAPDocEntry ?? selectedQuotation.Id)
                : await QuotationService.GetQuotationPdfAsync(selectedQuotation.Id);

            if (pdfBytes == null || pdfBytes.Length == 0)
            {
                errorMessage = "Failed to retrieve quotation PDF.";
                return;
            }

            var base64 = Convert.ToBase64String(pdfBytes);
            var fileName = $"Quotation_{selectedQuotation.QuotationNumber}.pdf";
            await JS.InvokeVoidAsync("downloadPdfFromBase64", base64, fileName);
            await AuditService.LogAsync(AuditActions.DownloadQuotationPdf, "Quotation", selectedQuotation.QuotationNumber);
        }
        catch (Exception ex)
        {
            errorMessage = $"Download failed: {ex.Message}";
        }
        finally
        {
            isPdfLoading = false;
        }
    }

    private async Task PrintQuotationPdf()
    {
        if (selectedQuotation == null || isPdfLoading || !CanDownloadQuotationPdf)
        {
            return;
        }

        isPdfLoading = true;
        try
        {
            var pdfBytes = dataSource == "sap"
                ? await QuotationService.GetQuotationPdfFromSAPAsync(selectedQuotation.SAPDocEntry ?? selectedQuotation.Id)
                : await QuotationService.GetQuotationPdfAsync(selectedQuotation.Id);

            if (pdfBytes == null || pdfBytes.Length == 0)
            {
                errorMessage = "Failed to retrieve quotation PDF for printing.";
                return;
            }

            var base64 = Convert.ToBase64String(pdfBytes);
            await JS.InvokeVoidAsync("printPdfFromBase64", base64);
            await AuditService.LogAsync(AuditActions.PrintQuotationPdf, "Quotation", selectedQuotation.QuotationNumber);
        }
        catch (Exception ex)
        {
            errorMessage = $"Print failed: {ex.Message}";
        }
        finally
        {
            isPdfLoading = false;
        }
    }

    private async Task ApplyStandardVat()
    {
        if (selectedQuotation == null || isApplyingStandardVat || !CanApplyStandardVat)
        {
            return;
        }

        isApplyingStandardVat = true;
        try
        {
            var updatedQuotation = await QuotationService.ApplyStandardVatAsync(selectedQuotation.Id);
            if (updatedQuotation == null)
            {
                errorMessage = "Failed to apply standard VAT to quotation.";
                return;
            }

            selectedQuotation = updatedQuotation;

            if (quotations is not null)
            {
                var quotationIndex = quotations.FindIndex(quotation => quotation.Id == updatedQuotation.Id);
                if (quotationIndex >= 0)
                {
                    quotations[quotationIndex] = updatedQuotation;
                }
            }

            Snackbar.Add("Applied 15.5% VAT to quotation lines that were missing VAT.", Severity.Success);
            await AuditService.LogAsync(AuditActions.ApplyQuotationVat, "Quotation", updatedQuotation.QuotationNumber, "Applied standard VAT of 15.5% to zero-VAT lines.");
        }
        catch (Exception ex)
        {
            errorMessage = $"Failed to apply VAT: {ex.Message}";
        }
        finally
        {
            isApplyingStandardVat = false;
        }
    }

    private async Task ApproveQuotation(int id)
    {
        var result = await QuotationService.ApproveAsync(id);
        if (result != null)
        {
            Snackbar.Add("Quotation approved successfully!", Severity.Success);
            await AuditService.LogAsync(AuditActions.ApproveQuotation, "Quotation", id.ToString());
            await LoadQuotations();
        }
        else
        {
            Snackbar.Add("Failed to approve quotation.", Severity.Error);
        }
    }

    private async Task ConvertToSalesOrder(QuotationDto quotation)
    {
        var result = await DialogService.ShowMessageBoxAsync(
            "Convert to Sales Order",
            $"Are you sure you want to convert quotation {quotation.QuotationNumber} for {quotation.CardName ?? quotation.CardCode} (Total: {quotation.Currency} {quotation.DocTotal:N2}) into a sales order?",
            yesText: "Convert",
            cancelText: "Cancel");

        if (result != true) return;

        convertingQuotationId = quotation.Id;
        StateHasChanged();

        try
        {
            var salesOrder = await QuotationService.ConvertToSalesOrderAsync(quotation.Id);
            if (salesOrder != null)
            {
                Snackbar.Add($"Quotation converted to Sales Order {salesOrder.OrderNumber} successfully!", Severity.Success);
                await AuditService.LogAsync(AuditActions.ConvertQuotationToOrder, "Quotation", quotation.Id.ToString(), $"Converted to Sales Order {salesOrder.OrderNumber}", true);
                CloseDrawer();
                await LoadQuotations();
            }
            else
            {
                Snackbar.Add("Failed to convert quotation to sales order. Please try again.", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error converting quotation: {ex.Message}", Severity.Error);
        }
        finally
        {
            convertingQuotationId = null;
            StateHasChanged();
        }
    }

    private async Task DeleteQuotation(int id)
    {
        var result = await DialogService.ShowMessageBoxAsync(
            "Delete Quotation",
            "Are you sure you want to delete this quotation?",
            yesText: "Delete",
            cancelText: "Cancel");

        if (result != true) return;

        var success = await QuotationService.DeleteQuotationAsync(id);
