                        </div>
                        <div class="qtx-field">
                            <label for="qtx-r-currency">Currency</label>
                            <input id="qtx-r-currency" class="qtx-input" type="text" readonly
                                   value="@newQuotation.Currency" />
                        </div>
                        <div class="qtx-field">
                            <label for="qtx-r-ref">Customer reference</label>
                            <input id="qtx-r-ref" class="qtx-input" type="text" placeholder="Reference number"
                                   @bind="newQuotation.CustomerRefNo" />
                        </div>
                        <div class="qtx-field">
                            <label for="qtx-r-disc">Header discount %</label>
                            <input id="qtx-r-disc" class="qtx-input qtx-input-num" type="number" min="0" max="100"
                                   step="0.1" @bind="newQuotation.DiscountPercent" />
                        </div>
                        <div class="qtx-field is-wide">
                            <label for="qtx-r-comments">Comments</label>
                            <textarea id="qtx-r-comments" class="qtx-input qtx-textarea" rows="2"
                                      placeholder="Additional notes…" @bind="newQuotation.Comments"></textarea>
                        </div>
                        <div class="qtx-field is-wide">
                            <label for="qtx-r-terms">Terms &amp; conditions</label>
                            <textarea id="qtx-r-terms" class="qtx-input qtx-textarea" rows="2"
                                      placeholder="Payment terms, delivery terms…" @bind="newQuotation.TermsAndConditions"></textarea>
                        </div>
                    </div>

                    <div>
                        <div class="qtx-sect"><i class="ph ph-list-bullets" aria-hidden="true"></i>Line items</div>
                        <div class="qtx-linescroll">
                            <table class="qtx-editlines">
                                <thead>
                                    <tr>
                                        <th>Item</th>
                                        <th>Description</th>
                                        <th class="qtx-num">Qty</th>
                                        <th class="qtx-num">Price</th>
                                        <th class="qtx-num">Disc %</th>
                                        <th class="qtx-num">VAT %</th>
                                        <th class="qtx-num">Total</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @for (var lineIndex = 0; lineIndex < newQuotation.Lines.Count; lineIndex++)
                                    {
                                        var line = newQuotation.Lines[lineIndex];
                                        <tr>
                                            <td style="width:20%">
                                                <input class="qtx-input" type="text" readonly value="@line.ItemCode"
                                                       aria-label="Item code" />
                                            </td>
                                            <td style="width:28%">
                                                <input class="qtx-input" type="text" readonly value="@line.ItemDescription"
                                                       aria-label="Item description" />
                                            </td>
                                            <td style="width:10%">
                                                <input class="qtx-input" type="number" min="0.0001" step="1"
                                                       aria-label="Quantity" @bind="line.Quantity" />
                                            </td>
                                            <td style="width:13%">
                                                <input class="qtx-input" type="number" min="0" step="0.01"
                                                       aria-label="Unit price" @bind="line.UnitPrice" />
                                            </td>
                                            <td style="width:12%">
                                                @* step matches SAP's six-decimal discounts so editing a line priced from a
                                                   special price does not trip step validation *@
                                                <input class="qtx-input" type="number" min="0" max="100" step="0.000001"
                                                       aria-label="Discount percent" @bind="line.DiscountPercent" />
                                            </td>
                                            <td style="width:10%">
                                                <input class="qtx-input" type="number" min="0" max="100" step="0.1"
                                                       aria-label="VAT percent" @bind="line.TaxPercent" />
                                            </td>
                                            <td class="qtx-num qtx-linetotal">
                                                @((line.Quantity * line.UnitPrice * (1 - line.DiscountPercent / 100)).ToString("N2"))
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>

                        <div class="qtx-tally">
                            <div class="qtx-tally-inner">
                                <div class="qtx-tally-row">
                                    <span>Subtotal</span>
                                    <span>@CalculateSubTotal().ToString("N2")</span>
                                </div>
                                @if (newQuotation.DiscountPercent > 0)
                                {
                                    <div class="qtx-tally-row is-neg">
                                        <span>Header discount</span>
                                        <span>-@CalculateHeaderDiscount().ToString("N2")</span>
                                    </div>
                                }
                                <div class="qtx-tally-row">
                                    <span>VAT</span>
                                    <span>@CalculateTaxTotal().ToString("N2")</span>
                                </div>
                                <div class="qtx-tally-row is-total">
                                    <span>Total</span>
                                    <span>@CalculateTotal().ToString("N2")</span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="qtx-dialog-actions">
                    <button type="button" class="qtx-btn qtx-btn-secondary" disabled="@isSaving"
                            @onclick="CloseRepriceModal">Cancel</button>
                    <button type="button" class="qtx-btn qtx-btn-primary" @onclick="SaveReprice"
                            disabled="@(isSaving || newQuotation.Lines.Count == 0)">
                        @if (isSaving)
                        {
                            <span class="qtx-spin" aria-hidden="true"></span>
                        }
                        <span>Save changes</span>
                    </button>
                </div>
            </div>
        </div>
    </div>
}

