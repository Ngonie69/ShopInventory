@page "/quotations"
@using System.Globalization
@using System.Text
@using Microsoft.AspNetCore.Authorization
@using MudBlazor
@attribute [Authorize(Roles = "Admin,Cashier")]
@inject IQuotationService QuotationService
@inject IBusinessPartnerService BusinessPartnerService
@inject IMasterDataCacheService CacheService
@inject IPriceService PriceService
@inject NavigationManager NavigationManager
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject IJSRuntime JS
@inject ILogger<Quotations> Logger
@inject IAppSettingsProvider AppSettings
@inject IAuditService AuditService
@rendermode InteractiveServer

<PageTitle>Quotations - Shop Inventory</PageTitle>

@* The imported Nocturne design is dark; wwwroot/css/quotations.css (linked
   from App.razor) carries it and its light counterpart, and follows the app's
   theme toggle like every other page.

   Icon-only controls draw their glyph inline rather than from the Phosphor
   font: the glyph is their whole label, so a font that failed to load would
   leave them reading as dead controls. Icons that sit beside a word keep the
   font.

   The list is a plain CSS grid rather than MudTable. The design's row is seven
   columns with a per-column treatment MudTable's cells cannot carry, and below
   1000px the same markup re-lays as a labelled card — which a table element
   cannot do at all. *@

<div class="qtn">

    <header class="qtn-head">
        <div class="qtn-head-inner">
            <div class="qtn-titles">
                <div class="qtn-kicker">Sales workspace · Quotations</div>
                <h1>Quotations</h1>
                <p class="qtn-lede">@LedeText</p>
            </div>
            <div class="qtn-head-actions">
                <button type="button" class="qtn-btn" disabled="@(isExporting || IsFirstLoad)"
                        @onclick="ExportCsv">
                    @if (isExporting)
                    {
                        <span class="qtn-spin" aria-hidden="true"></span>
                        <span>Exporting…</span>
                    }
                    else
                    {
                        <i class="ph ph-download-simple" aria-hidden="true"></i>
                        <span>Export</span>
                    }
                </button>
                <a class="qtn-btn qtn-btn-primary" href="/quotations/create">
                    <i class="ph ph-plus" aria-hidden="true"></i>New quotation
                </a>
            </div>
        </div>
    </header>

    <div class="qtn-body">

        @if (!string.IsNullOrEmpty(errorMessage))
        {
            <div class="qtn-alert" role="alert">
                <i class="ph ph-warning-octagon" aria-hidden="true"></i>
                <div class="qtn-alert-body">@errorMessage</div>
                <button type="button" class="qtn-alert-x" aria-label="Dismiss" @onclick="() => errorMessage = null">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"
                         stroke-linecap="round" aria-hidden="true">
                        <path d="M6 6l12 12M18 6L6 18"></path>
                    </svg>
                </button>
            </div>
        }

        @* The five figures are the status filter as well as the count: the
           pressed one narrows the list below, and picking an exact status from
           the filter bar releases it. *@
        <section class="qtn-stats" aria-label="Quotations by status">
            @foreach (var card in StatCards())
            {
                <button type="button" class="qtn-stat @(bucket == card.Key ? "qtn-stat-on" : "")"
                        aria-pressed="@(bucket == card.Key)" @onclick="() => SelectBucket(card.Key)">
                    <span class="qtn-stat-head">
                        <i class="ph @card.Icon @card.Tone" aria-hidden="true"></i>
                        <span>@card.Label</span>
                    </span>
                    <span class="qtn-stat-figures">
                        <span class="qtn-stat-num">@card.Value</span>
                        <span class="qtn-stat-share">@card.Share</span>
                    </span>
                </button>
            }
        </section>

        <section class="qtn-filters" aria-label="Filters">
            <div class="qtn-field">
                <span class="qtn-label">Data source</span>
                <div class="qtn-seg" role="group" aria-label="Data source">
                    <button type="button" class="qtn-seg-opt @(dataSource == "sap" ? "qtn-seg-on" : "")"
                            aria-pressed="@(dataSource == "sap")" disabled="@isLoading"
                            @onclick='() => SwitchDataSource("sap")'>
                        <i class="ph ph-cloud" aria-hidden="true"></i>SAP
                    </button>
                    <button type="button" class="qtn-seg-opt @(dataSource == "local" ? "qtn-seg-on" : "")"
                            aria-pressed="@(dataSource == "local")" disabled="@isLoading"
                            @onclick='() => SwitchDataSource("local")'>
                        <i class="ph ph-database" aria-hidden="true"></i>Local
                    </button>
                </div>
            </div>

            <div class="qtn-filter-rule" aria-hidden="true"></div>

            <div class="qtn-field qtn-field-grow">
                <label class="qtn-label" for="qtn-f-customer">Customer</label>
                <span class="qtn-input-icon">
                    <i class="ph ph-buildings" aria-hidden="true"></i>
                    <input id="qtn-f-customer" class="qtn-input" type="text" placeholder="Code or name"
                           @bind="customerFilter" @bind:event="oninput" @onkeydown="HandleFilterKeyDown" />
                </span>
            </div>

            <div class="qtn-field" style="width:158px">
                <label class="qtn-label" for="qtn-f-status">Status</label>
                <span class="qtn-select">
                    <select id="qtn-f-status" class="qtn-input" @bind="statusFilter" @bind:after="ApplyStatusFilter">
                        <option value="">All statuses</option>
                        @foreach (QuotationStatus status in Enum.GetValues<QuotationStatus>())
                        {
                            <option value="@(((int)status).ToString())">@status</option>
                        }
                    </select>
                    <span class="qtn-caret" aria-hidden="true"></span>
                </span>
            </div>

            <div class="qtn-field" style="width:150px">
                <label class="qtn-label" for="qtn-f-from">Issued from</label>
                <NocturneDateField Id="qtn-f-from" @bind-Date="fromDate" />
            </div>

            <div class="qtn-field" style="width:150px">
                <label class="qtn-label" for="qtn-f-to">Issued to</label>
                <NocturneDateField Id="qtn-f-to" @bind-Date="toDate" />
            </div>

            <div class="qtn-filter-actions">
                <button type="button" class="qtn-btn qtn-btn-primary" disabled="@isLoading" @onclick="ApplyFilter">
                    @if (isLoading)
                    {
                        <span class="qtn-spin" aria-hidden="true"></span>
                        <span>Searching…</span>
                    }
                    else
                    {
                        <i class="ph ph-magnifying-glass" aria-hidden="true"></i>
                        <span>Search</span>
                    }
                </button>
                <button type="button" class="qtn-btn qtn-btn-ghost" disabled="@isLoading" @onclick="ClearFilter">
                    Clear
                </button>
            </div>
        </section>

        @{
            var rows = Filtered;
            var page = ClampPage(rows.Count);
            var pages = PageCount(rows.Count);
        }

        <section class="qtn-card">
            @if (isLoading && !IsFirstLoad)
            {
                @* A refresh keeps the rows readable and says so with the strip,
                   rather than blanking the list it is replacing. *@
                <div class="qtn-refresh" role="status" aria-label="Refreshing quotations"></div>
            }

            <div class="qtn-card-head">
                <h2>All quotations</h2>
                <span class="qtn-source-tag">@(dataSource == "sap" ? "SAP" : "LOCAL")</span>
                <span class="qtn-range">@RangeLabel(rows.Count, page)</span>
                <div class="qtn-card-tools">
                    <button type="button" class="qtn-tool @(expiringOnly ? "qtn-tool-on" : "")"
                            aria-pressed="@expiringOnly" @onclick="ToggleExpiringOnly">
                        <i class="ph ph-funnel" aria-hidden="true"></i>Expiring soon
                    </button>
                    <button type="button" class="qtn-tool" @onclick="ToggleSort">
                        <i class="ph ph-arrows-down-up" aria-hidden="true"></i>
                        @(newestFirst ? "Newest first" : "Oldest first")
                    </button>
                </div>
            </div>

            <div class="qtn-scroll">
                <div class="qtn-grid" role="table" aria-label="Quotations">
                    <div class="qtn-thead" role="row">
                        <span role="columnheader">Quote</span>
                        <span role="columnheader">Customer</span>
                        <span role="columnheader">Issued</span>
                        <span role="columnheader">Valid until</span>
                        <span role="columnheader">Status</span>
                        <span role="columnheader" class="qtn-num">Total</span>
                        <span role="columnheader" class="qtn-num">Actions</span>
                    </div>

                    @if (IsFirstLoad)
                    {
                        @for (var skeletonRow = 0; skeletonRow < 8; skeletonRow++)
                        {
                            <div class="qtn-row" role="row">
                                @for (var skeletonCell = 0; skeletonCell < 7; skeletonCell++)
                                {
                                    <span role="cell"><span class="qtn-skel"></span></span>
                                }
                            </div>
                        }
                    }
                    else
                    {
                        @foreach (var quotation in rows.Skip((page - 1) * pageSize).Take(pageSize))
                        {
                            <div class="qtn-row" role="row" @key="quotation.Id"
                                 @onclick="() => ViewQuotation(quotation)">
                                <span class="qtn-quote" role="cell">@quotation.QuotationNumber</span>
                                <span class="qtn-cust" role="cell">
                                    <span class="qtn-cust-name">@(quotation.CardName ?? quotation.CardCode)</span>
                                    <span class="qtn-cust-code">@quotation.CardCode</span>
                                </span>
                                <span class="qtn-date" role="cell">
                                    <span class="qtn-rl">Issued</span>@quotation.QuotationDate.ToString("dd MMM yyyy")
                                </span>
                                <span class="qtn-valid @ValidClass(quotation)" role="cell">
                                    <span class="qtn-rl">Valid until</span>
                                    @(quotation.ValidUntil?.ToString("dd MMM yyyy") ?? "—")
                                </span>
                                <span class="qtn-cell-status" role="cell">
                                    <span class="qtn-badge @StatusBadgeClass(quotation)">@quotation.StatusName</span>
                                </span>
                                <span class="qtn-total qtn-num" role="cell">
                                    <span class="qtn-rl">Total</span>@quotation.DocTotal.ToString("N2")<span
                                        class="qtn-ccy">@(quotation.Currency ?? "USD")</span>
                                </span>
                                <span class="qtn-rowactions" role="cell">
                                    <button type="button" class="qtn-icon-btn" title="View quotation"
                                            aria-label="View quotation @quotation.QuotationNumber"
                                            @onclick="() => ViewQuotation(quotation)" @onclick:stopPropagation>
                                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"
                                             stroke-linecap="round" aria-hidden="true">
                                            <path d="M2 12s3.6-6 10-6 10 6 10 6-3.6 6-10 6-10-6-10-6z"></path>
                                            <circle cx="12" cy="12" r="2.6"></circle>
                                        </svg>
                                    </button>
                                    @if (CanRepriceQuotation(quotation))
                                    {
                                        <button type="button" class="qtn-icon-btn" title="Edit or reprice"
                                                aria-label="Edit or reprice @quotation.QuotationNumber"
                                                @onclick="() => OpenRepriceModal(quotation)" @onclick:stopPropagation>
                                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"
                                                 stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                                <path d="M4 20h4L20 8l-4-4L4 16z"></path>
                                                <path d="M14.5 5.5l4 4"></path>
                                            </svg>
                                        </button>
                                    }
                                    @if (CanConvert(quotation))
                                    {
                                        <button type="button" class="qtn-icon-btn" title="Convert to sales order"
                                                aria-label="Convert @quotation.QuotationNumber to a sales order"
                                                disabled="@(convertingQuotationId == quotation.Id)"
                                                @onclick="() => ConvertToSalesOrder(quotation)" @onclick:stopPropagation>
                                            @if (convertingQuotationId == quotation.Id)
                                            {
                                                <span class="qtn-spin" aria-hidden="true"></span>
                                            }
                                            else
                                            {
                                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                                     stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"
                                                     aria-hidden="true">
                                                    <path d="M3 4h2.2l2.3 11.1a1.5 1.5 0 0 0 1.5 1.2h8.4a1.5 1.5 0 0 0 1.5-1.2L20.6 8H6"></path>
                                                    <circle cx="9.5" cy="20" r="1.3"></circle>
                                                    <circle cx="17.5" cy="20" r="1.3"></circle>
                                                </svg>
                                            }
                                        </button>
                                    }
                                    @if (quotation.Status == QuotationStatus.Draft || quotation.Status == QuotationStatus.Pending)
                                    {
                                        <button type="button" class="qtn-icon-btn" title="Approve"
                                                aria-label="Approve @quotation.QuotationNumber"
                                                @onclick="() => ApproveQuotation(quotation.Id)" @onclick:stopPropagation>
                                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"
                                                 stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                                <path d="M4.5 12.5l5 5 10-11"></path>
                                            </svg>
                                        </button>
                                    }
                                    @if (quotation.Status == QuotationStatus.Draft || quotation.Status == QuotationStatus.Cancelled)
                                    {
                                        <button type="button" class="qtn-icon-btn" title="Delete"
                                                aria-label="Delete @quotation.QuotationNumber"
                                                @onclick="() => DeleteQuotation(quotation.Id)" @onclick:stopPropagation>
                                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"
                                                 stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                                <path d="M4 7h16M9.5 7V5h5v2M6.8 7l.9 13h8.6l.9-13"></path>
                                                <path d="M10 11v6M14 11v6"></path>
                                            </svg>
                                        </button>
                                    }
                                </span>
                            </div>
                        }
                    }
                </div>
            </div>

            @if (IsFirstLoad)
            {
                <div class="qtn-loading">
                    <span class="qtn-spin" aria-hidden="true"></span>
                    <span>Loading quotations from @SourceName…</span>
                </div>
            }
            else if (rows.Count == 0)
            {
                <div class="qtn-empty">
                    <i class="ph ph-file-dashed" aria-hidden="true"></i>
                    @if (quotations is null || quotations.Count == 0)
                    {
                        <span>No quotations found in @SourceName for this search.</span>
                        <div class="qtn-empty-actions">
                            <a class="qtn-btn qtn-btn-primary" href="/quotations/create">
                                <i class="ph ph-plus" aria-hidden="true"></i>New quotation
                            </a>
                        </div>
                    }
                    else
                    {
                        <span>No quotations match the status and expiry filters in play.</span>
                        <div class="qtn-empty-actions">
                            <button type="button" class="qtn-btn qtn-btn-ghost" @onclick="ClearListFilters">
                                Show all @quotations.Count.ToString("N0")
                            </button>
                        </div>
                    }
                </div>
            }

            @if (rows.Count > 0)
            {
                <div class="qtn-foot">
                    <label class="qtn-per">
                        <span>Rows</span>
                        <span class="qtn-select">
                            <select class="qtn-input" @bind="pageSize" @bind:after="ResetPage"
                                    aria-label="Rows per page">
                                @foreach (var size in PageSizes)
                                {
                                    <option value="@size">@size</option>
                                }
                            </select>
                            <span class="qtn-caret" aria-hidden="true"></span>
                        </span>
                    </label>
                    <div class="qtn-pages">
                        <button type="button" class="qtn-step" title="Previous page" aria-label="Previous page"
                                disabled="@(page <= 1)" @onclick="() => GoToPage(page - 1)">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"
                                 stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                <path d="M14.5 5l-7 7 7 7"></path>
                            </svg>
                        </button>
                        @foreach (var slot in PageSlots(page, pages))
                        {
                            if (slot is null)
                            {
                                <span class="qtn-gap" aria-hidden="true">…</span>
                            }
                            else
                            {
                                var number = slot.Value;
                                <button type="button" class="qtn-page @(number == page ? "qtn-page-on" : "")"
                                        aria-current="@(number == page ? "page" : null)" aria-label="Page @number"
                                        @onclick="() => GoToPage(number)">
                                    @number
                                </button>
                            }
                        }
                        <button type="button" class="qtn-step" title="Next page" aria-label="Next page"
                                disabled="@(page >= pages)" @onclick="() => GoToPage(page + 1)">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"
                                 stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                <path d="M9.5 5l7 7-7 7"></path>
                            </svg>
                        </button>
                    </div>
                </div>
            }
        </section>
    </div>
</div>

@* ── Detail drawer ─────────────────────────────────────────────────────── *@
@if (selectedQuotation != null)
{
    var quotation = selectedQuotation;
    var isConverting = convertingQuotationId == quotation.Id;

    <div class="qtn-overlay">
        <div class="qtn-scrim" @onclick="CloseDrawer"></div>
        <aside class="qtn-drawer" aria-label="Quotation details">
            <div class="qtn-drawer-head">
                <div class="qtn-drawer-titles">
                    <div class="qtn-kicker">Quotation</div>
                    <h2>@quotation.QuotationNumber</h2>
                    <div class="qtn-drawer-sub">
                        @(quotation.CardName ?? quotation.CardCode) ·
                        @quotation.Currency @quotation.DocTotal.ToString("N2")
                    </div>
                </div>
                <button type="button" class="qtn-icon-btn" title="Close" aria-label="Close details"
                        @onclick="CloseDrawer">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                         stroke-linecap="round" aria-hidden="true">
                        <path d="M6 6l12 12M18 6L6 18"></path>
                    </svg>
                </button>
            </div>

            <div class="qtn-drawer-body">
                <div>
                    <div class="qtn-sect"><i class="ph ph-identification-card" aria-hidden="true"></i>Details</div>
                    <div class="qtn-dl">
                        <div>
                            <div class="qtn-dt">Customer</div>
                            <div class="qtn-dd">@quotation.CardName</div>
                            <div class="qtn-dd qtn-cust-code">@quotation.CardCode</div>
                        </div>
                        <div>
                            <div class="qtn-dt">Status</div>
                            <div class="qtn-dd">
                                <span class="qtn-badge @StatusBadgeClass(quotation)">@quotation.StatusName</span>
                            </div>
                        </div>
                        <div>
                            <div class="qtn-dt">Total</div>
                            <div class="qtn-dd qtn-dd-num">@quotation.Currency @quotation.DocTotal.ToString("N2")</div>
                        </div>
                        <div>
                            <div class="qtn-dt">Issued</div>
                            <div class="qtn-dd qtn-dd-num">@quotation.QuotationDate.ToString("dd MMM yyyy")</div>
                        </div>
                        <div>
                            <div class="qtn-dt">Valid until</div>
                            <div class="qtn-dd qtn-dd-num @ValidClass(quotation)">
                                @(quotation.ValidUntil?.ToString("dd MMM yyyy") ?? "—")
                            </div>
                        </div>
                        <div>
                            <div class="qtn-dt">Currency</div>
                            <div class="qtn-dd">@quotation.Currency</div>
                        </div>
                        <div>
                            <div class="qtn-dt">Contact person</div>
                            <div class="qtn-dd">@(quotation.ContactPerson ?? "—")</div>
                        </div>
                        <div>
                            <div class="qtn-dt">Salesperson</div>
                            <div class="qtn-dd">@(quotation.SalesPersonName ?? "—")</div>
                        </div>
                        <div>
                            <div class="qtn-dt">Created by</div>
                            <div class="qtn-dd">@(quotation.CreatedByUserName ?? "—")</div>
                        </div>
                        @if (quotation.SalesOrderId.HasValue)
                        {
                            <div>
                                <div class="qtn-dt">Sales order</div>
                                <div class="qtn-dd qtn-dd-num">SO #@quotation.SalesOrderId</div>
                            </div>
                        }
                    </div>
                </div>

                @if (dataSource == "local" && !quotation.IsSynced)
                {
                    <div class="qtn-alert" role="status">
                        <i class="ph ph-cloud-slash" aria-hidden="true"></i>
                        <div class="qtn-alert-body">
                            This quotation has local changes that have not been pushed back to SAP.
                        </div>
                    </div>
                }

                @if (!string.IsNullOrEmpty(quotation.Comments))
                {
                    <div>
                        <div class="qtn-sect"><i class="ph ph-chat-text" aria-hidden="true"></i>Comments</div>
                        <p class="qtn-prose">@quotation.Comments</p>
                    </div>
                }

                @if (!string.IsNullOrEmpty(quotation.TermsAndConditions))
                {
                    <div>
                        <div class="qtn-sect"><i class="ph ph-file-text" aria-hidden="true"></i>Terms &amp; conditions</div>
                        <p class="qtn-prose">@quotation.TermsAndConditions</p>
                    </div>
                }

                <div>
                    <div class="qtn-sect">
                        <i class="ph ph-list-bullets" aria-hidden="true"></i>Line items
                        @if (!IsDetailLoading && !detailLoadFailed)
                        {
                            <span>(@quotation.Lines.Count)</span>
                        }
                    </div>

                    @if (IsDetailLoading)
                    {
                        <div class="qtn-loading" style="padding-inline:0">
                            <span class="qtn-spin" aria-hidden="true"></span>
                            <span>Loading line items…</span>
                        </div>
                    }
                    else if (detailLoadFailed)
                    {
                        <div class="qtn-note">
                            Couldn't load the line items for this quotation. Close and reopen it to try again.
                        </div>
                    }
                    else
                    {
                        <div class="qtn-lines-wrap">
                            <table class="qtn-lines">
                                <thead>
                                    <tr>
                                        <th>#</th>
                                        <th>Item</th>
                                        <th>Description</th>
                                        <th class="qtn-num">Qty</th>
                                        <th class="qtn-num">Price</th>
                                        <th class="qtn-num">Disc %</th>
                                        <th class="qtn-num">VAT %</th>
                                        <th class="qtn-num">Total</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var line in quotation.Lines)
                                    {
                                        <tr>
                                            <td>@(line.LineNum + 1)</td>
                                            <td class="qtn-lines-item">@line.ItemCode</td>
                                            <td>@line.ItemDescription</td>
                                            <td class="qtn-num">@QuantityDisplay.Format(line.Quantity, line.UoMCode)</td>
                                            <td class="qtn-num">@line.UnitPrice.ToString("N2")</td>
                                            @* Up to six decimals so a special-price discount reads the same here as in SAP (5.714286%), while a typed 10% still shows as 10.0% *@
                                            <td class="qtn-num">@(line.DiscountPercent > 0 ? line.DiscountPercent.ToString("0.0####") + "%" : "—")</td>
                                            <td class="qtn-num">@(line.TaxPercent > 0 ? line.TaxPercent.ToString("N1") + "%" : "—")</td>
                                            <td class="qtn-num qtn-lines-total">@line.LineTotal.ToString("N2")</td>
                                        </tr>
                                    }
                                </tbody>
                                <tfoot>
                                    <tr>
                                        <td colspan="6"></td>
                                        <td class="qtn-tot-label">Subtotal</td>
                                        <td class="qtn-tot-value">@quotation.SubTotal.ToString("N2")</td>
                                    </tr>
                                    @if (quotation.DiscountAmount > 0)
                                    {
                                        <tr>
                                            <td colspan="6"></td>
                                            <td class="qtn-tot-label">Discount</td>
                                            <td class="qtn-tot-value">-@quotation.DiscountAmount.ToString("N2")</td>
                                        </tr>
                                    }
                                    <tr>
                                        <td colspan="6"></td>
                                        <td class="qtn-tot-label">VAT</td>
                                        <td class="qtn-tot-value">@quotation.TaxAmount.ToString("N2")</td>
                                    </tr>
                                    <tr class="qtn-tot-grand">
                                        <td colspan="6"></td>
                                        <td class="qtn-tot-label">Total</td>
                                        <td class="qtn-tot-value">@quotation.DocTotal.ToString("N2")</td>
                                    </tr>
                                </tfoot>
                            </table>
                        </div>
                    }
                </div>
            </div>

            <div class="qtn-drawer-foot">
                @if (CanRepriceSelectedQuotation)
                {
                    <button type="button" class="qtn-btn" disabled="@(IsDetailLoading || isConverting)"
                            @onclick="() => OpenRepriceModal(quotation)">
                        <i class="ph ph-pencil-simple" aria-hidden="true"></i>Edit / reprice
                    </button>
                }
                @if (CanApplyStandardVat)
                {
                    <button type="button" class="qtn-btn"
                            disabled="@(isApplyingStandardVat || IsDetailLoading || isConverting)"
                            @onclick="ApplyStandardVat">
                        @if (isApplyingStandardVat)
                        {
                            <span class="qtn-spin" aria-hidden="true"></span>
                            <span>Applying…</span>
                        }
                        else
                        {
                            <i class="ph ph-percent" aria-hidden="true"></i>
                            <span>Apply 15.5% VAT</span>
                        }
                    </button>
                }
                @if (CanDownloadQuotationPdf)
                {
                    <button type="button" class="qtn-btn" disabled="@(isPdfLoading || isConverting)"
                            @onclick="DownloadQuotationPdf">
                        @if (isPdfLoading)
                        {
                            <span class="qtn-spin" aria-hidden="true"></span>
                            <span>Preparing…</span>
                        }
                        else
                        {
                            <i class="ph ph-download-simple" aria-hidden="true"></i>
                            <span>Download PDF</span>
                        }
                    </button>
                    <button type="button" class="qtn-btn" disabled="@(isPdfLoading || isConverting)"
                            @onclick="PrintQuotationPdf">
                        <i class="ph ph-printer" aria-hidden="true"></i>Print
                    </button>
                }
                <div class="qtn-foot-primary">
                    <button type="button" class="qtn-btn qtn-btn-ghost" disabled="@isConverting" @onclick="CloseDrawer">
                        Close
                    </button>
                    @if (CanConvert(quotation))
                    {
                        <button type="button" class="qtn-btn qtn-btn-primary"
                                disabled="@(isConverting || IsDetailLoading)"
                                @onclick="() => ConvertToSalesOrder(quotation)">
                            @if (isConverting)
                            {
                                <span class="qtn-spin" aria-hidden="true"></span>
                                <span>Converting…</span>
                            }
                            else
                            {
                                <i class="ph ph-shopping-cart-simple" aria-hidden="true"></i>
                                <span>Convert to sales order</span>
                            }
                        </button>
                    }
                </div>
            </div>
        </aside>
    </div>
}

