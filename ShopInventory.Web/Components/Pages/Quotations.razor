                    </h2>
                    <button type="button" class="qtx-btn qtx-btn-ghost qtx-btn-icon" title="Close"
                            aria-label="Close" disabled="@isSaving" @onclick="CloseRepriceModal">
                        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"></path></svg>
                    </button>
                </div>
                <div class="qtx-dialog-body">
                    <div class="qtx-note is-warn">
                        Reprice keeps the customer, currency and line items locked. Only local quotation
                        pricing fields are updated here — SAP review is still required afterwards.
                    </div>

                    <div class="qtx-form">
                        <div class="qtx-field is-wide">
                            <label for="qtx-r-customer">Customer</label>
                            <input id="qtx-r-customer" class="qtx-input" type="text" readonly
                                   value="@RepriceCustomerLabel" />
                        </div>
                        <div class="qtx-field">
                            <label for="qtx-r-contact">Contact person</label>
