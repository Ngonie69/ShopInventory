@page "/products"
@using Microsoft.AspNetCore.Authorization
@using ShopInventory.Web.Data
@using ShopInventory.Web.Services
@attribute [Authorize(Roles = UserRoles.CatalogueRoles)]
@implements IDisposable
@rendermode InteractiveServer

<PageTitle>Products - Shop Inventory</PageTitle>

@* Nocturne. wwwroot/css/products.css (linked from App.razor) carries the design
   and its light counterpart, and follows the app's theme toggle.

   Icons are drawn inline rather than from the Phosphor font: they sit inside
   fields and icon-only buttons, so a font that failed to load would leave them
   reading as nothing.

   The catalogue is a plain CSS grid rather than MudTable. The design's row is
   eight columns wide with a per-column treatment MudTable's cells cannot carry,
   and below 900px the same markup re-lays as a labelled card — which a table
   element cannot do at all.

   Four quantity columns, not three. Availability is in stock − committed + on
   order; showing it without the on-order term made items read as available
   greater than in stock with nothing on the row to explain the difference. *@

<div class="pr">

    <header class="pr-head">
        <div class="pr-head-inner">
            <label class="pr-head-field pr-head-warehouse">
                <span class="pr-label">Warehouse <span class="pr-req">*</span></span>
                <span class="pr-select">
                    <select class="pr-input" disabled="@isLoadingWarehouses"
                            value="@selectedWarehouse?.WarehouseCode"
                            @onchange="OnWarehouseChanged">
                        <option value="">
                            @(isLoadingWarehouses ? "Loading warehouses…" : "Select a warehouse…")
                        </option>
                        @foreach (var warehouse in warehouses)
                        {
                            <option value="@warehouse.WarehouseCode">@warehouse.DisplayName</option>
                        }
                    </select>
                    <span class="pr-caret" aria-hidden="true"></span>
                </span>
            </label>

            <label class="pr-head-field pr-head-scan">
                <span class="pr-label">Barcode</span>
                <input class="pr-input pr-input-code" type="text" autocomplete="off" inputmode="text"
                       placeholder="Scan or type a code" disabled="@(selectedWarehouse is null)"
                       @bind="barcode" @bind:event="oninput" @onkeydown="OnBarcodeKeyDown" />
            </label>

            <div class="pr-head-actions">
                @if (isLoading)
                {
                    <button type="button" class="pr-btn pr-btn-quiet" @onclick="CancelSearch">
                        <span class="pr-spin" aria-hidden="true"></span>
                        <span>Cancel</span>
                    </button>
                }
                else if (!string.IsNullOrWhiteSpace(barcode))
                {
                    <button type="button" class="pr-btn pr-btn-primary" disabled="@(selectedWarehouse is null)"
                            @onclick="SearchByBarcode">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                             stroke-width="1.7" stroke-linecap="round" aria-hidden="true">
                            <path d="M4 6v12M8 6v12M12 6v12M16 6v12M20 6v12"></path>
                        </svg>
                        <span>Scan</span>
                    </button>
                }
                else
                {
                    <button type="button" class="pr-btn pr-btn-primary" disabled="@(selectedWarehouse is null)"
                            @onclick="SearchProducts">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                             stroke-width="1.7" stroke-linecap="round" aria-hidden="true">
                            <circle cx="11" cy="11" r="7"></circle>
                            <path d="M20 20l-3.5-3.5"></path>
                        </svg>
                        <span>Search</span>
                    </button>
                }
                @if (hasSearched)
                {
                    <button type="button" class="pr-btn pr-btn-quiet" @onclick="ClearSearch">Clear</button>
                }
            </div>

            <div class="pr-head-meta">
                @if (lastSyncedAt.HasValue)
                {
                    <span class="pr-synced">
                        Stock synced @lastSyncedAt.Value.ToLocalTime().ToString("d MMM, HH:mm")
                    </span>
                }
                <button type="button" class="pr-btn pr-btn-ghost"
                        disabled="@(selectedWarehouse is null || isLoading || isRefreshing)"
                        @onclick="RefreshStock">
                    @if (isRefreshing)
                    {
                        <span class="pr-spin" aria-hidden="true"></span>
                        <span>Syncing…</span>
                    }
                    else
                    {
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                             stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <path d="M20 11a8 8 0 0 0-13.7-5.3L4 8"></path>
                            <path d="M4 4v4h4"></path>
                            <path d="M4 13a8 8 0 0 0 13.7 5.3L20 16"></path>
                            <path d="M20 20v-4h-4"></path>
                        </svg>
                        <span>Refresh</span>
                    }
                </button>
            </div>
        </div>
    </header>

    <div class="pr-body">

        <section class="pr-hero">
            <div>
                <div class="pr-kicker">Inventory</div>
                <h1>Products</h1>
                <p>
                    What each item has on hand in one warehouse, what is already claimed against it,
                    and what is still on its way in.
                </p>
            </div>
            @if (selectedWarehouse is not null)
            {
                <div class="pr-hero-whs">
                    <span class="pr-hero-whs-code">@selectedWarehouse.WarehouseCode</span>
                    <span class="pr-hero-whs-name">@selectedWarehouse.WarehouseName</span>
                </div>
            }
        </section>

        @if (notice is not null)
        {
            <div class="pr-msg" role="@(noticeLevel == NoticeLevel.Error ? "alert" : "status")">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"
                     stroke-linecap="round" aria-hidden="true">
                    <circle cx="12" cy="12" r="9"></circle>
                    <path d="M12 7.5v5.5M12 16.2v.1"></path>
                </svg>
                <span>@notice</span>
                @if (noticeLevel != NoticeLevel.Info && selectedWarehouse is not null)
                {
                    <button type="button" class="pr-msg-act" @onclick="SearchProducts">Try again</button>
                }
                <button type="button" class="pr-msg-x" aria-label="Dismiss" @onclick="() => notice = null">
                    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"
                         stroke-linecap="round" aria-hidden="true">
                        <path d="M6 6l12 12M18 6L6 18"></path>
                    </svg>
                </button>
            </div>
        }

        @if (summary is not null && summary.TotalItems > 0)
        {
            @* Counted across every cached row for the warehouse, not just the page
               on screen — the figures name the warehouse, so they have to describe
               it. Counts rather than summed quantities: the warehouse mixes Each,
               KG and Case, and adding those together gives a number in no unit. *@
            <section class="pr-stats">
                <div class="pr-stat pr-stat-lead">
                    <div class="pr-stat-head"><span class="pr-stat-rule" aria-hidden="true"></span>Items</div>
                    <div class="pr-stat-num">@summary.TotalItems.ToString("N0")</div>
                    <div class="pr-stat-sub">Carried in @selectedWarehouse?.WarehouseCode</div>
                </div>
                <div class="pr-stat">
                    <div class="pr-stat-head"><span class="pr-stat-dot" aria-hidden="true"></span>In stock</div>
                    <div class="pr-stat-num">@summary.InStockItems.ToString("N0")</div>
                    <div class="pr-stat-sub">Something on hand</div>
                </div>
                <div class="pr-stat">
                    <div class="pr-stat-head"><span class="pr-stat-rule" aria-hidden="true"></span>Out of stock</div>
                    <div class="pr-stat-num">@summary.OutOfStockItems.ToString("N0")</div>
                    <div class="pr-stat-sub">Nothing on hand</div>
                </div>
                <div class="pr-stat">
                    <div class="pr-stat-head"><span class="pr-stat-rule" aria-hidden="true"></span>On order</div>
                    <div class="pr-stat-num">@summary.OnOrderItems.ToString("N0")</div>
                    <div class="pr-stat-sub">Incoming, counted as available</div>
                </div>
            </section>
        }

        @if (isLoading)
        {
            <div class="pr-loading">
                <span class="pr-loading-lead">
                    <span class="pr-spin" aria-hidden="true"></span>
                    <span>Reading stock for @selectedWarehouse?.WarehouseCode…</span>
                </span>
                @if (loadingSeconds > 5)
                {
                    <span class="pr-loading-note">
                        Still going after @loadingSeconds seconds — the warehouse may not be cached yet.
                    </span>
                }
                @if (loadingSeconds > 15)
                {
                    <button type="button" class="pr-btn pr-btn-quiet" @onclick="CancelSearch">Cancel</button>
                }
            </div>
        }
        else if (!hasSearched)
        {
            <div class="pr-panel">
                <div class="pr-empty">
                    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"
                         stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <path d="M12 3l8 4.2v9.6L12 21l-8-4.2V7.2z"></path>
                        <path d="M4 7.2l8 4.2 8-4.2M12 11.4V21"></path>
                    </svg>
                    <span>Pick a warehouse above, then search to browse what it holds.</span>
                    <div class="pr-empty-actions">
                        <button type="button" class="pr-btn pr-btn-primary" disabled="@(selectedWarehouse is null)"
                                @onclick="SearchProducts">
                            Search @selectedWarehouse?.WarehouseCode
                        </button>
                    </div>
                </div>
            </div>
        }
        else
        {
            <section class="pr-panel">
                <div class="pr-panel-head">
                    <h2>Catalogue</h2>
                    <span class="pr-count">@CountLabel</span>
                    <div class="pr-panel-tools">
                        <label class="pr-filter">
                            <span class="pr-vh">Filter by item code, name or barcode</span>
                            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                 stroke-width="1.7" stroke-linecap="round" aria-hidden="true">
                                <circle cx="11" cy="11" r="7"></circle>
                                <path d="M20 20l-3.5-3.5"></path>
                            </svg>
                            @* Searches the whole warehouse, not the page on screen. *@
                            <input class="pr-input pr-input-search" type="search" autocomplete="off"
                                   placeholder="Filter this warehouse…" value="@filterTerm"
                                   @oninput="OnFilterInput" />
                        </label>
                    </div>
                </div>

                @if (products is null || products.Count == 0)
                {
                    <div class="pr-empty">
                        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                             stroke-width="1.5" stroke-linecap="round" aria-hidden="true">
                            <circle cx="11" cy="11" r="7"></circle>
                            <path d="M20 20l-3.5-3.5"></path>
                        </svg>
                        @if (!string.IsNullOrWhiteSpace(filterTerm))
                        {
                            <span>
                                Nothing in @selectedWarehouse?.WarehouseCode matches
                                &ldquo;@filterTerm&rdquo;.
                            </span>
                            <div class="pr-empty-actions">
                                <button type="button" class="pr-btn pr-btn-quiet" @onclick="ClearFilter">
                                    Clear filter
                                </button>
                            </div>
                        }
                        else
                        {
                            <span>
                                No stock records for @selectedWarehouse?.WarehouseCode. The warehouse may be
                                empty, or it may not have synced from SAP yet.
                            </span>
                            <div class="pr-empty-actions">
                                <button type="button" class="pr-btn pr-btn-primary" disabled="@isRefreshing"
                                        @onclick="RefreshStock">
                                    Sync from SAP
                                </button>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <div class="pr-scroll">
                        <div class="pr-grid" role="table" aria-label="Products in @selectedWarehouse?.WarehouseCode">
                            @* Column order follows the arithmetic: in stock less committed
                               gives free to sell, plus on order gives SAP's availability. *@
                            <div class="pr-thead" role="row">
                                <span role="columnheader">Item code</span>
                                <span role="columnheader">Item name</span>
                                <span role="columnheader" class="pr-num">In stock</span>
                                <span role="columnheader" class="pr-num">Committed</span>
                                <span role="columnheader" class="pr-num" title="In stock less committed — what can leave the warehouse today">
                                    Free to sell
                                </span>
                                <span role="columnheader" class="pr-num">On order</span>
                                <span role="columnheader" class="pr-num" title="SAP's availability: free to sell plus stock still on purchase orders">
                                    Available
                                </span>
                                <span role="columnheader">UoM</span>
                                <span role="columnheader"><span class="pr-vh">Actions</span></span>
                            </div>

                            @foreach (var product in products)
                            {
                                var itemCode = product.ItemCode ?? string.Empty;
                                var freeToSell = FreeToSell(product);
                                <div class="pr-row" role="row" @onclick="() => ViewProduct(product)">
                                    <span class="pr-code" role="cell">@itemCode</span>
                                    <span class="pr-name-cell" role="cell">
                                        <span class="pr-name">@product.ItemName</span>
                                        @if (product.QuantityInStock <= 0)
                                        {
                                            <span class="pr-tag">Out of stock</span>
                                        }
                                        else if (freeToSell < 0)
                                        {
                                            @* Committed exceeds what is on the shelf. *@
                                            <span class="pr-tag">Oversold</span>
                                        }
                                        else if (freeToSell == 0)
                                        {
                                            @* On the shelf, but every unit of it is already spoken for. *@
                                            <span class="pr-tag">Fully committed</span>
                                        }
                                    </span>
                                    <span class="pr-qty pr-num pr-cell-stock @StockClass(product.QuantityInStock)" role="cell">
                                        <span class="pr-rl">In stock</span>@Qty(product.QuantityInStock, product.UoM)
                                    </span>
                                    <span class="pr-qty pr-num pr-cell-committed @ClaimClass(product.QuantityCommitted)"
                                          role="cell">
                                        <span class="pr-rl">Committed</span>@Qty(product.QuantityCommitted, product.UoM)
                                    </span>
                                    <span class="pr-qty pr-qty-lead pr-num pr-cell-free @StockClass(freeToSell)"
                                          role="cell">
                                        <span class="pr-rl">Free to sell</span>@Qty(freeToSell, product.UoM)
                                    </span>
                                    <span class="pr-qty pr-num pr-cell-ordered @ClaimClass(product.QuantityOrdered)"
                                          role="cell">
                                        <span class="pr-rl">On order</span>@Qty(product.QuantityOrdered, product.UoM)
                                    </span>
                                    <span class="pr-qty pr-num pr-cell-available @StockClass(product.QuantityAvailable)"
                                          role="cell">
                                        <span class="pr-rl">Available</span>@Qty(product.QuantityAvailable, product.UoM)
                                    </span>
                                    <span class="pr-cell-uom" role="cell">
                                        <span class="pr-uom">@(string.IsNullOrWhiteSpace(product.UoM) ? "—" : product.UoM)</span>
                                    </span>
                                    <span class="pr-actions" role="cell">
                                        @* The row's click is a pointer convenience; this button is the
                                           control keyboards and screen readers use. *@
                                        <button type="button" class="pr-icon-btn" title="Open @itemCode"
                                                aria-label="Open @itemCode" @onclick="() => ViewProduct(product)"
                                                @onclick:stopPropagation>
                                            <svg width="15" height="15" viewBox="0 0 24 24" fill="none"
                                                 stroke="currentColor" stroke-width="1.7" stroke-linecap="round"
                                                 stroke-linejoin="round" aria-hidden="true">
                                                <path d="M9 6l6 6-6 6"></path>
                                            </svg>
                                        </button>
                                    </span>
                                </div>
                            }
                        </div>
                    </div>

                    <div class="pr-foot">
                        <label class="pr-per">
                            <span>Show</span>
                            <span class="pr-select">
                                <select class="pr-input" value="@pageSize" @onchange="OnPageSizeChanged">
                                    @foreach (var size in PageSizes)
                                    {
                                        <option value="@size">@size</option>
                                    }
                                </select>
                                <span class="pr-caret" aria-hidden="true"></span>
                            </span>
                            <span>per page</span>
                        </label>
                        <div class="pr-pages">
                            <button type="button" class="pr-step" disabled="@(currentPage <= 1)"
                                    @onclick="() => GoToPage(currentPage - 1)">
                                Prev
                            </button>
                            @foreach (var slot in PageSlots(currentPage, PageCount))
                            {
                                if (slot is null)
                                {
                                    <span class="pr-gap" aria-hidden="true">…</span>
                                }
                                else
                                {
                                    var number = slot.Value;
                                    <button type="button" class="pr-page @(number == currentPage ? "pr-page-on" : "")"
                                            aria-current="@(number == currentPage ? "page" : null)"
                                            aria-label="Page @number" @onclick="() => GoToPage(number)">
                                        @number
                                    </button>
                                }
                            }
                            <button type="button" class="pr-step" disabled="@(!CanGoNext)"
                                    @onclick="() => GoToPage(currentPage + 1)">
                                Next
                            </button>
                        </div>
                    </div>
                }
            </section>
        }
    </div>
</div>

@if (selectedProduct is not null)
{
    var product = selectedProduct;
    var itemCode = product.ItemCode ?? string.Empty;
    var freeToSell = FreeToSell(product);

    @* The overlay renders outside the .pr root so the page cannot clip it, and
       carries .pr-overlay rather than .pr: the sheet pairs that class with .pr on
       the token block and on every scoped rule, so the drawer reaches the palette
       without also inheriting .pr's min-height: 100vh — which beats the drawer's
       own height and would hang it, and its footer, a topbar below the fold. *@
    <div class="pr-overlay">
        <div class="pr-scrim" @onclick="CloseDrawer"></div>
        <aside class="pr-drawer" role="dialog" aria-modal="true" aria-label="@product.ItemName">
            <div class="pr-drawer-head">
                <div>
                    <h2>@product.ItemName</h2>
                    <div class="pr-drawer-sub">
                        @itemCode
                        @if (!string.IsNullOrWhiteSpace(product.BarCode))
                        {
                            <text> · @product.BarCode</text>
                        }
                        <text> · </text>@selectedWarehouse?.WarehouseCode
                    </div>
                </div>
                <button type="button" class="pr-icon-btn" style="margin-left:auto" aria-label="Close"
                        @onclick="CloseDrawer">
                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                         stroke-linecap="round" aria-hidden="true">
                        <path d="M6 6l12 12M18 6L6 18"></path>
                    </svg>
                </button>
            </div>

            <div class="pr-drawer-body">

                <section class="pr-section">
                    <h3>Availability</h3>
                    @* Two statements, because the page reports two different answers to
                       "how much is there": what can leave today, and what SAP counts as
                       available (which includes stock still on a purchase order). Each
                       figure is shown deriving from the one before it. *@
                    <div class="pr-avail">
                        <div class="pr-avail-row">
                            <div class="pr-avail-term">
                                <div class="pr-avail-t">In stock</div>
                                <div class="pr-avail-v">@Qty(product.QuantityInStock, product.UoM)</div>
                            </div>
                            <div class="pr-avail-op" aria-hidden="true">−</div>
                            <div class="pr-avail-term">
                                <div class="pr-avail-t">Committed</div>
                                <div class="pr-avail-v">@Qty(product.QuantityCommitted, product.UoM)</div>
                            </div>
                            <div class="pr-avail-op" aria-hidden="true">=</div>
                            <div class="pr-avail-term pr-avail-term-result">
                                <div class="pr-avail-t">Free to sell</div>
                                <div class="pr-avail-v @StockClass(freeToSell)">@Qty(freeToSell, product.UoM)</div>
                            </div>
                        </div>
                        <div class="pr-avail-row">
                            <div class="pr-avail-term pr-avail-term-carried">
                                <div class="pr-avail-t">Free to sell</div>
                                <div class="pr-avail-v">@Qty(freeToSell, product.UoM)</div>
                            </div>
                            <div class="pr-avail-op" aria-hidden="true">+</div>
                            <div class="pr-avail-term">
                                <div class="pr-avail-t">On order</div>
                                <div class="pr-avail-v">@Qty(product.QuantityOrdered, product.UoM)</div>
                            </div>
                            <div class="pr-avail-op" aria-hidden="true">=</div>
                            <div class="pr-avail-term pr-avail-term-result">
                                <div class="pr-avail-t">Available</div>
                                <div class="pr-avail-v">@Qty(product.QuantityAvailable, product.UoM)</div>
                            </div>
                        </div>
                        <div class="pr-avail-note">
                            @if (freeToSell < 0)
                            {
                                <text>
                                    Oversold: customer orders claim @Qty(product.QuantityCommitted, product.UoM)
                                    against @Qty(product.QuantityInStock, product.UoM) on hand.
                                </text>
                            }
                            else if (product.QuantityOrdered > 0)
                            {
                                <text>
                                    @Qty(freeToSell, product.UoM) can leave @selectedWarehouse?.WarehouseCode today.
                                    SAP's availability is higher because it counts the
                                    @Qty(product.QuantityOrdered, product.UoM) still on a purchase order.
                                </text>
                            }
                            else
                            {
                                <text>
                                    Nothing is inbound, so what can leave today and what SAP reports as available
                                    are the same figure.
                                </text>
                            }
                        </div>
                    </div>
                </section>

                <section class="pr-section">
                    <h3>Item</h3>
                    <div class="pr-dl">
                        <div>
                            <div class="pr-dt">Item code</div>
                            <div class="pr-dd pr-dd-num">@itemCode</div>
                        </div>
                        <div>
                            <div class="pr-dt">Barcode</div>
                            <div class="pr-dd pr-dd-num">
                                @(string.IsNullOrWhiteSpace(product.BarCode) ? "—" : product.BarCode)
                            </div>
                        </div>
                        <div>
                            <div class="pr-dt">Unit of measure</div>
                            <div class="pr-dd">@(string.IsNullOrWhiteSpace(product.UoM) ? "—" : product.UoM)</div>
                        </div>
                        <div>
                            <div class="pr-dt">Warehouse</div>
                            <div class="pr-dd">@selectedWarehouse?.DisplayName</div>
                        </div>
                    </div>
                </section>

                <section class="pr-section">
                    <div class="pr-batch-head">
                        <h3>Batches</h3>
                        @if (batches is { Count: > 0 })
                        {
                            <span class="pr-batch-count">@batches.Count in @selectedWarehouse?.WarehouseCode</span>
                        }
                    </div>

                    @* Read from SAP when the drawer opens. The list itself comes from the
                       stock cache, which knows nothing about batches — so this is the only
                       place that can answer the question, and it must be asked per item. *@
                    @if (isLoadingBatches)
                    {
                        <div class="pr-inline-loading">
                            <span class="pr-spin" aria-hidden="true"></span>
                            <span>Reading batches from SAP…</span>
                        </div>
                    }
                    else if (batchError is not null)
                    {
                        <div class="pr-msg">
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                 stroke-width="1.7" stroke-linecap="round" aria-hidden="true">
                                <circle cx="12" cy="12" r="9"></circle>
                                <path d="M12 7.5v5.5M12 16.2v.1"></path>
                            </svg>
                            <span>@batchError</span>
                            <button type="button" class="pr-msg-act" @onclick="() => LoadBatchesAsync(product)">
                                Retry
                            </button>
                        </div>
                    }
                    else if (batches is { Count: > 0 })
                    {
                        <div class="pr-batches">
                            <div class="pr-batch-thead">
                                <span>Batch</span>
                                <span class="pr-num">Quantity</span>
                                <span>Status</span>
                                <span>Expires</span>
                            </div>
                            @foreach (var batch in batches)
                            {
                                <div class="pr-batch-row">
                                    <span class="pr-batch-no">@batch.BatchNumber</span>
                                    <span class="pr-num">@Qty(batch.Quantity, product.UoM)</span>
                                    <span class="pr-status @BatchStatusClass(batch.Status)">
                                        <span class="pr-dot" aria-hidden="true"></span>
                                        @(string.IsNullOrWhiteSpace(batch.Status) ? "—" : batch.Status)
                                    </span>
                                    <span class="pr-batch-date">@BatchDate(batch.ExpiryDate)</span>
                                </div>
                            }
                            <div class="pr-batch-foot">
                                <span>Total</span>
                                <span class="pr-num">@Qty(batches.Sum(b => b.Quantity), product.UoM)</span>
                                <span></span>
                                <span></span>
                            </div>
                        </div>
                        @if (batches.Sum(b => b.Quantity) != product.QuantityInStock)
                        {
                            @* Worth stating rather than hiding: batch quantities and the
                               warehouse on-hand figure are read from different SAP tables
                               and can legitimately disagree. *@
                            <div class="pr-avail-note">
                                Batch quantities total @Qty(batches.Sum(b => b.Quantity), product.UoM), against
                                @Qty(product.QuantityInStock, product.UoM) on hand.
                            </div>
                        }
                    }
                    else
                    {
                        <div class="pr-quiet">
                            No batch records for this item in @selectedWarehouse?.WarehouseCode — either it is not
                            batch-managed, or none of its batches carry stock here.
                        </div>
                    }
                </section>

            </div>

            <div class="pr-drawer-foot">
                <button type="button" class="pr-btn pr-btn-quiet" @onclick="CloseDrawer">Close</button>
            </div>
        </aside>
    </div>
}
