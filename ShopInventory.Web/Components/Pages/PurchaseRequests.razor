@page "/purchase-requests"
@attribute [Authorize(Roles = "Admin,Manager")]
@rendermode InteractiveServer

<PageTitle>Purchase Requests</PageTitle>

@* Nocturne. wwwroot/css/purchase-documents.css (linked from App.razor) carries
   the design and its light counterpart, and follows the app's theme toggle like
   every other page. The sheet is shared with the other three purchase registers
   — see its header for why one sheet rather than four, and PurchaseQuotations
   for the notes on the grid and the drawer, which this page repeats.

   `.is-request` is the one thing this page needs of its own: a request has no
   supplier and no money, so its five columns are weighted differently — it is
   dated twice, posted and required, and named by its requester. *@

<div class="pdx is-request">

    <header class="pdx-head">
        <div class="pdx-head-inner">
            <div class="pdx-head-doc">
                <span class="pdx-head-kind">Purchase requests</span>
                <span class="pdx-range">@DateRangeLabel</span>
            </div>
            <div class="pdx-head-meta">
                <button type="button" class="pdx-btn pdx-btn-ghost" disabled="@isLoading" @onclick="ReloadAsync">
                    @if (isLoading)
                    {
                        <span class="pdx-spin" aria-hidden="true"></span>
                        <span>Loading&#8230;</span>
                    }
                    else
                    {
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                             stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <path d="M20 11a8 8 0 0 0-13.7-5.3L4 8"></path>
                            <path d="M4 4v4h4"></path>
                            <path d="M4 13a8 8 0 0 0 13.7 5.3L20 16"></path>
                            <path d="M20 20v-4h-4"></path>
                        </svg>
                        <span>Refresh</span>
                    }
                </button>
                <button type="button" class="pdx-btn pdx-btn-primary" @onclick="NavigateToCreate">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                         stroke-width="1.8" stroke-linecap="round" aria-hidden="true">
                        <path d="M12 5v14M5 12h14"></path>
                    </svg>
                    <span>New request</span>
                </button>
            </div>
        </div>
    </header>

    <div class="pdx-body">

        <section class="pdx-hero">
            <div>
                <div class="pdx-kicker">Purchasing</div>
                <h1>Purchase requests</h1>
                <p>
                    Internal procurement requests raised in SAP &#8212; who asked, for what, and by
                    when, with the requested lines behind each row.
                </p>
            </div>
        </section>

        @if (!string.IsNullOrWhiteSpace(errorMessage))
        {
            <div class="pdx-msg" role="alert">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"
                     stroke-linecap="round" aria-hidden="true">
                    <circle cx="12" cy="12" r="9"></circle>
                    <path d="M12 7.5v5.5M12 16.2v.1"></path>
                </svg>
                <span>@errorMessage</span>
                <button type="button" class="pdx-msg-x" aria-label="Dismiss" @onclick="() => errorMessage = null">
                    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"
                         stroke-linecap="round" aria-hidden="true">
                        <path d="M6 6l12 12M18 6L6 18"></path>
                    </svg>
                </button>
            </div>
        }

        <section class="pdx-stats">
            <div class="pdx-stat pdx-stat-lead">
                <div class="pdx-stat-head"><span class="pdx-stat-rule" aria-hidden="true"></span>Total requests</div>
                <div class="pdx-stat-num">
                    @if (requestResponse is null)
                    {
                        <text>&#8212;</text>
                    }
                    else
                    {
                        @requestResponse.TotalCount.ToString("N0")
                    }
                </div>
                <div class="pdx-stat-sub">Matching the filters</div>
            </div>
            <div class="pdx-stat">
                <div class="pdx-stat-head"><span class="pdx-stat-rule" aria-hidden="true"></span>This page</div>
                <div class="pdx-stat-num">@CurrentPageCount.ToString("N0")</div>
                <div class="pdx-stat-sub">Rows below</div>
            </div>
            <div class="pdx-stat">
                <div class="pdx-stat-head"><span class="pdx-stat-rule" aria-hidden="true"></span>Open requests</div>
                <div class="pdx-stat-num">@OpenRequestCount.ToString("N0")</div>
                <div class="pdx-stat-sub">On this page</div>
            </div>
            @* A request is counted in lines rather than in money: nothing on it
               is priced until a supplier is sourced. *@
            <div class="pdx-stat">
                <div class="pdx-stat-head"><span class="pdx-stat-rule" aria-hidden="true"></span>Requested lines</div>
                <div class="pdx-stat-num">@CurrentPageLineCount.ToString("N0")</div>
                <div class="pdx-stat-sub">Across this page</div>
            </div>
        </section>

        <section class="pdx-panel">
            <div class="pdx-panel-head">
                <h2>Request register</h2>
                <span class="pdx-count">@RegisterCountText</span>
            </div>

            <div class="pdx-filters">
                <div class="pdx-field">
                    <span class="pdx-label">Raised from</span>
                    <NocturneDateField Id="preq-f-from" @bind-Date="fromDate" AriaLabel="Raised from" />
                </div>

                <div class="pdx-field">
                    <span class="pdx-label">Raised to</span>
                    <NocturneDateField Id="preq-f-to" @bind-Date="toDate" AriaLabel="Raised to" />
                </div>

                @* These go back to SAP, so they are applied on the button rather
                   than on change. *@
                <div class="pdx-filter-actions">
                    <button type="button" class="pdx-btn pdx-btn-primary" disabled="@isLoading" @onclick="SearchAsync">
                        Apply
                    </button>
                    <button type="button" class="pdx-btn pdx-btn-quiet" disabled="@isLoading" @onclick="ClearFiltersAsync">
                        Clear
                    </button>
                </div>
            </div>

            @if (isLoading)
            {
                <div class="pdx-loading">
                    <span class="pdx-spin" aria-hidden="true"></span>
                    <span>Loading purchase requests from SAP&#8230;</span>
                </div>
            }
            else if (Requests.Count == 0)
            {
                <div class="pdx-empty">
                    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                         stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <path d="M6 3h9l3 3v15H6z"></path>
                        <path d="M9 10h6M9 14h4"></path>
                    </svg>
                    <span>No purchase request matched these filters.</span>
                    <div class="pdx-empty-actions">
                        <button type="button" class="pdx-btn pdx-btn-quiet" @onclick="ClearFiltersAsync">
                            Reset to the last thirty days
                        </button>
                    </div>
                </div>
            }
            else
            {
                <div class="pdx-scroll">
                    <div class="pdx-grid" role="table" aria-label="Purchase requests">
                        <div class="pdx-thead" role="row">
                            <span role="columnheader">Document</span>
                            <span role="columnheader">Raised</span>
                            <span role="columnheader">Required</span>
                            <span role="columnheader">Requester</span>
                            <span role="columnheader">Status</span>
                        </div>

                        @foreach (var request in Requests)
                        {
                            <div class="pdx-row @(selectedRequest?.DocEntry == request.DocEntry ? "pdx-row-on" : "")"
                                 role="row" @key="request.DocEntry" @onclick="() => SelectRequest(request)">
                                <span class="pdx-doc" role="cell">
                                    <span class="pdx-docnum">#@request.DocNum</span>
                                    <span class="pdx-docsub">@request.Lines.Count line(s)</span>
                                </span>
                                <span class="pdx-date pdx-cell-date" role="cell">
                                    <span class="pdx-date-main">
                                        <span class="pdx-rl">Raised</span>@(request.DocDate?.ToString("dd MMM yyyy") ?? "Not set")
                                    </span>
                                </span>
                                <span class="pdx-date pdx-cell-date2" role="cell">
                                    <span class="pdx-date-main">
                                        <span class="pdx-rl">Required</span>@(request.RequriedDate?.ToString("dd MMM yyyy") ?? "Not set")
                                    </span>
                                </span>
                                <span class="pdx-party" role="cell">
                                    <span class="pdx-party-name">@RequesterOf(request)</span>
                                </span>
                                <span class="pdx-cell-status" role="cell">
                                    <span class="pdx-badge @GetStatusCssClass(request.DocStatus)">@request.DocStatus</span>
                                </span>
                            </div>
                        }
                    </div>
                </div>

                <div class="pdx-foot">
                    <span class="pdx-foot-info">@PageRangeText</span>
                    <div class="pdx-pages">
                        <button type="button" class="pdx-step" disabled="@(isLoading || currentPage <= 1)"
                                @onclick="PreviousPageAsync">
                            Previous
                        </button>
                        <span class="pdx-page-now">Page @currentPage</span>
                        <button type="button" class="pdx-step"
                                disabled="@(isLoading || !(requestResponse?.HasMore ?? false))"
                                @onclick="NextPageAsync">
                            Next
                        </button>
                    </div>
                </div>
            }
        </section>
    </div>
</div>

@* The scrim and the drawer carry `.pdx` themselves: they sit outside the page
   element so it cannot clip them, and the class is what puts the tokens in
   reach. *@
@if (selectedRequest is not null)
{
    var detail = selectedRequest;

    <div class="pdx pdx-scrim" @onclick="CloseDetail"></div>
    <aside class="pdx pdx-drawer" role="dialog" aria-modal="true" aria-label="Request details">
        <div class="pdx-drawer-head">
            <div>
                <h2>Request #@detail.DocNum</h2>
                <div class="pdx-drawer-sub">
                    <span class="pdx-badge @GetStatusCssClass(detail.DocStatus)">@detail.DocStatus</span>
                    <span>@RequesterOf(detail)</span>
                    <span>@detail.Lines.Count line(s)</span>
                </div>
            </div>
            <button type="button" class="pdx-icon-btn pdx-drawer-x" aria-label="Close" @onclick="CloseDetail">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                     stroke-linecap="round" aria-hidden="true">
                    <path d="M6 6l12 12M18 6L6 18"></path>
                </svg>
            </button>
        </div>

        <div class="pdx-drawer-body">
            <section class="pdx-section">
                <h3>Document</h3>
                <div class="pdx-dl">
                    <div>
                        <div class="pdx-dt">Requester</div>
                        <div class="pdx-dd">@RequesterOf(detail)</div>
                    </div>
                    <div>
                        <div class="pdx-dt">Status</div>
                        <div class="pdx-dd">@detail.DocStatus</div>
                    </div>
                    <div>
                        <div class="pdx-dt">Raised</div>
                        <div class="pdx-dd pdx-dd-num">@(detail.DocDate?.ToString("dd MMM yyyy") ?? "Not set")</div>
                    </div>
                    <div>
                        <div class="pdx-dt">Required</div>
                        <div class="pdx-dd pdx-dd-num">@(detail.RequriedDate?.ToString("dd MMM yyyy") ?? "Not set")</div>
                    </div>
                </div>
            </section>

            @if (!string.IsNullOrWhiteSpace(detail.Comments))
            {
                <section class="pdx-section">
                    <h3>Comments</h3>
                    <p class="pdx-pre">@detail.Comments</p>
                </section>
            }

            <section class="pdx-section">
                <h3>Requested lines</h3>
                @if (detail.Lines.Count == 0)
                {
                    <div class="pdx-lines-empty">This request has no lines.</div>
                }
                else
                {
                    <div class="pdx-lines">
                        @foreach (var line in detail.Lines)
                        {
                            <div class="pdx-line">
                                <div class="pdx-line-top">
                                    <div class="pdx-line-item">
                                        <div class="pdx-line-code">@line.ItemCode</div>
                                        <div class="pdx-line-desc">@line.ItemDescription</div>
                                    </div>
                                    @* Quantity stands where the money would on a priced
                                       document: it is what a request is measured in. *@
                                    <div class="pdx-money">
                                        <span class="pdx-money-num">@line.Quantity.ToString("N2")</span>
                                    </div>
                                </div>
                                <div class="pdx-line-meta">
                                    <span>Open @line.OpenQuantity.ToString("N2")</span>
                                    @if (!string.IsNullOrWhiteSpace(line.WarehouseCode))
                                    {
                                        <span class="pdx-tag">@line.WarehouseCode</span>
                                    }
                                    @if (!string.IsNullOrWhiteSpace(line.LineVendor))
                                    {
                                        <span class="pdx-tag">Vendor @line.LineVendor</span>
                                    }
                                </div>
                            </div>
                        }
                    </div>
                }
            </section>
        </div>
    </aside>
}
