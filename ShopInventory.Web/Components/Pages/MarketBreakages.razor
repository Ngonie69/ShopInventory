@page "/market-breakages"
@using Microsoft.AspNetCore.Authorization
@using ShopInventory.Web.Data
@using ShopInventory.Web.Models
@attribute [Authorize(Roles = UserRoles.MarketBreakageRoles)]
@rendermode InteractiveServer

<PageTitle>Market Breakages - Shop Inventory</PageTitle>

@* Nocturne, built from the "Market Breakages Redesign" canvas: a queue on the left and the open
   report on a counting bench beside it, so the office walks the queue without opening and closing a
   drawer. wwwroot/css/market-breakages.css (linked from App.razor) carries both schemes. Icon-only
   buttons draw their glyph inline so a font that fails to load cannot leave them reading as dead
   controls. *@

<div class="mbk">

    <header class="mbk-head">
        <div class="mbk-shell">
            <div class="mbk-titles">
                <div class="mbk-titles-row">
                    <i class="ph ph-package" aria-hidden="true"></i>
                    <h1 class="mbk-title">Market Breakages</h1>
                </div>
                <p class="mbk-sub">Broken and expired stock vans swapped out at shops. Count what came back, then move it from the van to returns in SAP.</p>
            </div>
            <div class="mbk-head-actions">
                <label class="mbk-search">
                    <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><circle cx="11" cy="11" r="7" /><path d="m20 20-3.5-3.5" /></svg>
                    <span class="mbk-sr">Search reports</span>
                    <input class="mbk-search-input" type="text" placeholder="Rep, van, shop or item"
                           value="@searchText" @oninput="OnSearchInputAsync" />
                    @if (!string.IsNullOrWhiteSpace(searchText))
                    {
                        <button type="button" class="mbk-search-clear" aria-label="Clear search" title="Clear search" @onclick="ClearSearchAsync">
                            <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M6 6l12 12M18 6 6 18" /></svg>
                        </button>
                    }
                </label>
                <button type="button" class="mbk-btn mbk-btn-secondary" @onclick="RefreshAsync" disabled="@isLoading">
                    @if (isLoading)
                    {
                        <span class="mbk-spin" aria-hidden="true"></span>
                    }
                    else
                    {
                        <i class="ph ph-arrows-clockwise" aria-hidden="true"></i>
                    }
                    <span>Refresh</span>
                </button>
            </div>
        </div>
        <div class="mbk-rule"></div>
    </header>

    <div class="mbk-body">

        @if (!string.IsNullOrEmpty(errorMessage))
        {
            <div class="mbk-alert" role="alert">
                <i class="ph ph-warning-octagon" aria-hidden="true"></i>
                <div class="mbk-alert-body">@errorMessage</div>
                <button type="button" class="mbk-btn mbk-btn-ghost mbk-btn-icon-sm" title="Dismiss"
                        aria-label="Dismiss error" @onclick="() => errorMessage = null">
                    <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M6 6l12 12M18 6 6 18" /></svg>
                </button>
            </div>
        }

        @* The four figures are the status filter: the number is what the office opens the page for. *@
        <nav class="mbk-figs" aria-label="Filter reports by status">
            @foreach (var figure in Figures)
            {
                <button type="button" class="mbk-fig @(statusFilter == figure.Value ? "is-on" : "")"
                        aria-pressed="@(statusFilter == figure.Value ? "true" : "false")"
                        @onclick="() => SetStatusFilterAsync(figure.Value)">
                    <span class="mbk-fig-label"><span class="mbk-fig-dot @figure.Family" aria-hidden="true"></span>@figure.Label</span>
                    <span class="mbk-fig-row">
                        <span class="mbk-fig-value">@(CountFor(figure.Value) is int count ? count.ToString("N0") : "—")</span>
                        <span class="mbk-fig-hint">@figure.Hint</span>
                    </span>
                </button>
            }
        </nav>

        <div class="mbk-bench @(sheetOpen ? "is-sheet" : "")">

            <section class="mbk-queue" aria-labelledby="mbk-queue-title">
                <div class="mbk-queue-head">
                    <h2 id="mbk-queue-title" class="mbk-queue-title">@QueueTitle</h2>
                    <button type="button" class="mbk-link @(statusFilter == string.Empty ? "is-on" : "")"
                            aria-pressed="@(statusFilter == string.Empty ? "true" : "false")"
                            @onclick="() => SetStatusFilterAsync(string.Empty)">
                        Show all@(CountFor(string.Empty) is int all ? $" · {all:N0}" : "")
                    </button>
                </div>

                <div class="mbk-rows">
                    @if (isLoading && reports.Count == 0)
                    {
                        @for (var skeleton = 0; skeleton < 6; skeleton++)
                        {
                            <div class="mbk-row-skel" aria-hidden="true">
                                <div class="mbk-skel" style="width:62%"></div>
                                <div class="mbk-skel" style="width:84%"></div>
                                <div class="mbk-skel" style="width:40%"></div>
                            </div>
                        }
                    }
                    else
                    {
                        @foreach (var report in reports)
                        {
                            var isCurrent = detailId == report.Id;
                            <button type="button" @key="report.Id" class="mbk-row @(isCurrent ? "is-on" : "")"
                                    aria-current="@(isCurrent ? "true" : null)" @onclick="() => PickAsync(report.Id)">
                                <span class="mbk-row-line">
                                    <span class="mbk-row-shop">@(report.CardName ?? report.CardCode ?? "No shop recorded")</span>
                                    <span class="mbk-row-units">@UnitsText(report.TotalConfirmedQuantity ?? report.TotalReportedQuantity)</span>
                                </span>
                                <span class="mbk-row-line mbk-row-meta">
                                    <span class="mbk-tag">@report.VanWarehouseCode</span>
                                    <span class="mbk-row-who">#@report.Id · @report.ReportedByName</span>
                                    <span class="mbk-status @StatusModifier(report.Status)">
                                        <span class="mbk-dot" aria-hidden="true"></span>@StatusLabel(report.Status)
                                    </span>
                                </span>
                                <span class="mbk-row-age @(IsStale(report) ? "is-stale" : "")">
                                    <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><circle cx="12" cy="12" r="9" /><path d="M12 7v5l3 2" /></svg>
                                    @RowAgeText(report)
                                </span>
                            </button>
                        }
                    }

                    @if (!isLoading && reports.Count == 0)
                    {
                        <div class="mbk-empty">
                            <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="m5 12 5 5L20 7" /></svg>
                            <span>@EmptyMessage</span>
                        </div>
                    }
                </div>

                @if (TotalPages > 1)
                {
                    <div class="mbk-foot">
                        <span class="mbk-foot-range">@RangeLabel</span>
                        <div class="mbk-pager">
                            <button type="button" class="mbk-btn mbk-btn-secondary mbk-btn-icon" title="Previous page"
                                    aria-label="Previous page" disabled="@(currentPage <= 1 || isLoading)" @onclick="PreviousPageAsync">
                                <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="m15 5-7 7 7 7" /></svg>
                            </button>
                            <span class="mbk-page-label">@currentPage / @TotalPages</span>
                            <button type="button" class="mbk-btn mbk-btn-secondary mbk-btn-icon" title="Next page"
                                    aria-label="Next page" disabled="@(currentPage >= TotalPages || isLoading)" @onclick="NextPageAsync">
                                <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="m9 5 7 7-7 7" /></svg>
                            </button>
                        </div>
                    </div>
                }
            </section>

            <section class="mbk-detail" aria-label="Open report">
                @if (detailId is null)
                {
                    <div class="mbk-detail-idle">
                        <i class="ph ph-package" aria-hidden="true"></i>
                        <span>@(reports.Count == 0 ? "No report to open in this view." : "Pick a report to count it.")</span>
                    </div>
                }
                else if (detail is null)
                {
                    <div class="mbk-detail-body">
                        @if (isLoadingDetail)
                        {
                            <div class="mbk-skel" style="width:48%;height:22px"></div>
                            <div class="mbk-skel" style="width:70%"></div>
                            <div class="mbk-skel" style="width:100%;height:120px"></div>
                        }
                        else
                        {
                            <div class="mbk-alert" role="alert">
                                <i class="ph ph-warning-octagon" aria-hidden="true"></i>
                                <div class="mbk-alert-body">@(detailError ?? "This report could not be loaded.")</div>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <div class="mbk-detail-head">
                        <button type="button" class="mbk-btn mbk-btn-ghost mbk-btn-icon mbk-sheet-back" title="Back to the list"
                                aria-label="Back to the list" @onclick="CloseSheet">
                            <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="m15 5-7 7 7 7" /></svg>
                        </button>
                        <div class="mbk-detail-titles">
                            <div class="mbk-detail-titlerow">
                                <h2 class="mbk-detail-title">@(detail.CardName ?? detail.CardCode ?? "No shop recorded")</h2>
                                <span class="mbk-pill @StatusModifier(detail.Status)">
                                    <span class="mbk-dot" aria-hidden="true"></span>@StatusLabel(detail.Status)
                                </span>
                            </div>
                            <span class="mbk-detail-sub">
                                Report #@detail.Id@(string.IsNullOrWhiteSpace(detail.CardCode) || detail.CardName is null ? "" : $" · {detail.CardCode}") · collected @FormatStamp(detail.CapturedAtUtc)
                            </span>
                        </div>
                        <dl class="mbk-who">
                            <div><dt>Rep</dt><dd>@detail.ReportedByName</dd></div>
                            <div><dt>Van</dt><dd>@detail.VanWarehouseCode</dd></div>
                        </dl>
                    </div>

                    <div class="mbk-detail-body">
                        @if (!string.IsNullOrEmpty(detailError))
                        {
                            <div class="mbk-alert" role="alert">
                                <i class="ph ph-warning-octagon" aria-hidden="true"></i>
                                <div class="mbk-alert-body">@detailError</div>
                            </div>
                        }

                        @if (detail.Status == MarketBreakageStatus.Transferred)
                        {
                            <div class="mbk-banner is-good">
                                <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="m5 12 5 5L20 7" /></svg>
                                <div>
                                    <strong>
                                        SAP transfer @(detail.SapDocNum is int transferNum ? $"#{transferNum}" : "") moved
                                        @QuantityDisplay.Format(ReportTotal(detail)) units from @detail.VanWarehouseCode to @ReturnsText
                                    </strong>
                                    <span>
                                        @(detail.DecidedByName ?? "The office")@(detail.TransferredAtUtc is DateTime transferredAt ? $", {FormatStamp(transferredAt)}" : "")
                                    </span>
                                    @if (!string.IsNullOrWhiteSpace(detail.DecisionRemarks))
                                    {
                                        <span class="mbk-banner-quote">“@detail.DecisionRemarks”</span>
                                    }
                                </div>
                            </div>
                        }
                        else if (detail.Status == MarketBreakageStatus.Rejected)
                        {
                            <div class="mbk-banner is-neutral">
                                <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><circle cx="12" cy="12" r="9" /><path d="m6 18 12-12" /></svg>
                                <div>
                                    <strong>
                                        Rejected by @(detail.DecidedByName ?? "the office")@(detail.DecidedAtUtc is DateTime decidedAt ? $" · {FormatStamp(decidedAt)}" : "")
                                    </strong>
                                    @if (!string.IsNullOrWhiteSpace(detail.DecisionRemarks))
                                    {
                                        <span>@detail.DecisionRemarks</span>
                                    }
                                </div>
                            </div>
                        }
                        else if (detail.Status == MarketBreakageStatus.Transferring)
                        {
                            <div class="mbk-banner is-info">
                                <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><circle cx="12" cy="12" r="9" /><path d="M12 11v5M12 8h.01" /></svg>
                                <div>
                                    <strong>A transfer started@(detail.LastAttemptedAtUtc is DateTime started ? $" {FormatStamp(started)}" : "") and has not finished</strong>
                                    <span>
                                        If it is still running, wait and refresh. If it was interrupted, look in SAP for a transfer out of
                                        @detail.VanWarehouseCode before you retry.
                                    </span>
                                </div>
                            </div>
                        }
                        else if (!string.IsNullOrWhiteSpace(detail.LastError) && MarketBreakageStatus.MayConfirm(detail.Status))
                        {
                            <div class="mbk-banner is-bad" role="alert">
                                <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M12 3 2 20h20z" /><path d="M12 10v4M12 17h.01" /></svg>
                                <div>
                                    <strong>The transfer did not post@(detail.LastAttemptedAtUtc is DateTime tried ? $" · {FormatStamp(tried)}" : "")</strong>
                                    <span>@detail.LastError</span>
                                    <span class="mbk-banner-hint">Adjust the counts if the van really is short, then retry. Nothing moved in SAP.</span>
                                </div>
                            </div>
                        }

                        @if (!string.IsNullOrWhiteSpace(detail.Remarks))
                        {
                            <figure class="mbk-quote">
                                <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M21 12a8 8 0 0 1-11.6 7.1L4 20l1-4.6A8 8 0 1 1 21 12z" /></svg>
                                <div>
                                    <figcaption>@detail.ReportedByName wrote</figcaption>
                                    <blockquote>@detail.Remarks</blockquote>
                                </div>
                            </figure>
                        }

                        <table class="mbk-lines">
                            <caption>@(CanConfirm ? "Count what came off the van" : "Products")</caption>
                            <thead>
                                <tr>
                                    <th scope="col">Product</th>
                                    <th scope="col">Reason</th>
                                    <th scope="col" class="mbk-num">Reported</th>
                                    <th scope="col" class="mbk-mid">Counted</th>
                                    <th scope="col" class="mbk-num">Diff</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var line in detail.Lines)
                                {
                                    var counted = CountedFor(line);
                                    var diff = counted - line.ReportedQuantity;
                                    <tr @key="line.Id">
                                        <td>
                                            <span class="mbk-item">
                                                <span class="mbk-item-name">@(string.IsNullOrWhiteSpace(line.ItemDescription) ? line.ItemCode : line.ItemDescription)</span>
                                                @if (!string.IsNullOrWhiteSpace(line.ItemDescription))
                                                {
                                                    <span class="mbk-item-code">@line.ItemCode</span>
                                                }
                                            </span>
                                        </td>
                                        <td>
                                            @if (!string.IsNullOrWhiteSpace(line.Reason))
                                            {
                                                <span class="mbk-chip">@line.Reason</span>
                                            }
                                            else
                                            {
                                                <span class="mbk-faint">—</span>
                                            }
                                        </td>
                                        <td class="mbk-num mbk-reported">@QuantityDisplay.Format(line.ReportedQuantity)</td>
                                        <td class="mbk-mid">
                                            @if (CanConfirm)
                                            {
                                                <span class="mbk-stepper">
                                                    <button type="button" class="mbk-step" aria-label="One fewer @line.ItemCode"
                                                            disabled="@(isSubmitting || counted <= 0)" @onclick="() => StepCount(line.Id, -1)">
                                                        <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M5 12h14" /></svg>
                                                    </button>
                                                    <input type="number" min="0" step="any" inputmode="decimal"
                                                           class="mbk-count-input @(diff != 0 ? "is-changed" : "")"
                                                           aria-label="Counted quantity of @line.ItemCode"
                                                           value="@CountText(line.Id)" disabled="@isSubmitting"
                                                           @onchange="args => SetCount(line.Id, args.Value)" />
                                                    <button type="button" class="mbk-step" aria-label="One more @line.ItemCode"
                                                            disabled="@isSubmitting" @onclick="() => StepCount(line.Id, 1)">
                                                        <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M5 12h14M12 5v14" /></svg>
                                                    </button>
                                                </span>
                                            }
                                            else if (line.ConfirmedQuantity is decimal confirmed)
                                            {
                                                <span class="mbk-counted @(diff != 0 ? "is-changed" : "")">@QuantityDisplay.Format(confirmed)</span>
                                            }
                                            else
                                            {
                                                <span class="mbk-faint">—</span>
                                            }
                                        </td>
                                        <td class="mbk-num mbk-diff @DiffModifier(diff)">
                                            @(CanConfirm || line.ConfirmedQuantity is not null ? DiffText(diff) : "—")
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>

                        <div class="mbk-sums">
                            <div class="mbk-sum"><span>Reported</span><strong class="is-quiet">@QuantityDisplay.Format(ReportedTotal)</strong></div>
                            <div class="mbk-sum"><span>Counted</span><strong>@QuantityDisplay.Format(CanConfirm ? CountedTotal : ReportTotal(detail))</strong></div>
                            <div class="mbk-sum"><span>Difference</span><strong class="mbk-diff @DiffModifier(TotalDiff)">@DiffText(TotalDiff)</strong></div>
                            <p class="mbk-sums-note">The rep's figures are kept as reported. Your count sits beside them and is what moves.</p>
                        </div>

                        @if (CanConfirm || CanReject)
                        {
                            <div class="mbk-field">
                                <label for="mbk-remarks">Remarks <span>· optional to confirm, required to reject. The rep sees this.</span></label>
                                <textarea id="mbk-remarks" class="mbk-textarea @(rejectNeedsReason ? "is-invalid" : "")" rows="2" maxlength="500"
                                          aria-invalid="@(rejectNeedsReason ? "true" : null)" aria-describedby="@(rejectNeedsReason ? "mbk-remarks-err" : null)"
                                          placeholder="e.g. Two sachets were resealable and went back to the van."
                                          @bind="decisionRemarks" @bind:event="oninput" @bind:after="ClearRejectHint"
                                          disabled="@isSubmitting"></textarea>
                                @if (rejectNeedsReason)
                                {
                                    <span id="mbk-remarks-err" class="mbk-field-err">Say why you are rejecting it — the rep needs the reason.</span>
                                }
                            </div>
                        }
                    </div>

                    @if (CanConfirm || CanReject)
                    {
                        <footer class="mbk-decide">
                            <span class="mbk-route">
                                <span class="mbk-route-wh">@detail.VanWarehouseCode</span>
                                <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M4 12h16M14 6l6 6-6 6" /></svg>
                                <span class="mbk-route-wh">@ReturnsText</span>
                                <span class="mbk-route-sum">@UnitsText(CountedTotal) · @ProductsText(CountedLineCount)</span>
                            </span>
                            @if (CanReject)
                            {
                                <button type="button" class="mbk-btn mbk-btn-bad mbk-btn-lg" @onclick="RejectAsync" disabled="@isSubmitting">
                                    @if (isSubmitting && submittingAction == "reject")
                                    {
                                        <span class="mbk-spin" aria-hidden="true"></span>
                                    }
                                    <span>Reject</span>
                                </button>
                            }
                            @if (CanConfirm)
                            {
                                <button type="button" class="mbk-btn mbk-btn-fill mbk-btn-lg" @onclick="OpenConfirmDialog" disabled="@(isSubmitting || CountedTotal <= 0)">
                                    <span>@(detail.Status == MarketBreakageStatus.Pending ? "Confirm & transfer" : "Retry transfer")</span>
                                    <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M4 12h16M14 6l6 6-6 6" /></svg>
                                </button>
                            }
                        </footer>
                    }
                }
            </section>
        </div>
    </div>

    @if (showConfirmDialog && detail is not null)
    {
        <div class="mbk-dialog-wrap" @onclick="CloseConfirmDialog">
            <div class="mbk-dialog" role="dialog" aria-modal="true" aria-labelledby="mbk-confirm-title"
                 @onclick:stopPropagation="true">
                <h2 id="mbk-confirm-title" class="mbk-dialog-title">Post the transfer to SAP?</h2>
                <div class="mbk-move">
                    <span class="mbk-move-end"><span>From</span><strong>@detail.VanWarehouseCode</strong></span>
                    <span class="mbk-move-mid">
                        <strong>@QuantityDisplay.Format(CountedTotal)</strong>
                        <svg viewBox="0 0 40 14" aria-hidden="true" focusable="false"><path d="M2 7h36M32 2l6 5-6 5" /></svg>
                        <span>units · @ProductsText(CountedLineCount)</span>
                    </span>
                    <span class="mbk-move-end is-to"><span>To</span><strong>@ReturnsText</strong></span>
                </div>
                <p class="mbk-dialog-copy">
                    @ConfirmNote A posted stock transfer cannot be undone from here.
                </p>
                <div class="mbk-dialog-actions">
                    <button type="button" class="mbk-btn mbk-btn-secondary mbk-btn-lg" @onclick="CloseConfirmDialog"
                            disabled="@isSubmitting">Back to counting</button>
                    <button type="button" class="mbk-btn mbk-btn-fill mbk-btn-lg" @onclick="ConfirmAsync" disabled="@isSubmitting">
                        @if (isSubmitting)
                        {
                            <span class="mbk-spin" aria-hidden="true"></span>
                        }
                        <span>Post transfer</span>
                    </button>
                </div>
            </div>
        </div>
    }
</div>
