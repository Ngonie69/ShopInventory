@page "/market-breakages"
@using Microsoft.AspNetCore.Authorization
@using ShopInventory.Web.Data
@using ShopInventory.Web.Features.MarketBreakages.Queries.ExportMarketBreakages
@using ShopInventory.Web.Models
@attribute [Authorize(Roles = UserRoles.MarketBreakageRoles)]
@rendermode InteractiveServer

<PageTitle>Market Breakages - Shop Inventory</PageTitle>

@* Nocturne, built from the "Market Breakages — counting" canvas: the queue across the full width
   under four status tabs, and the open report in a drawer where every line is counted before it can
   move. wwwroot/css/market-breakages.css (linked from App.razor) carries both schemes. Icon-only
   buttons draw their glyph inline so a font that fails to load cannot leave them reading as dead
   controls. *@

<div class="mbk">

    <header class="mbk-head">
        <div class="mbk-shell">
            <div class="mbk-titles">
                <span class="mbk-mark" aria-hidden="true">
                    <svg viewBox="0 0 24 24" focusable="false"><path d="M21 8l-9-5-9 5 9 5 9-5z" /><path d="M3 8v8l9 5 9-5V8" /><path d="M12 13v8" /></svg>
                </span>
                <div class="mbk-titles-text">
                    <h1 class="mbk-title">Market Breakages</h1>
                    <p class="mbk-sub">Count what came off the van, then move it to returns in SAP.</p>
                </div>
            </div>
            <div class="mbk-head-actions">
                <label class="mbk-search">
                    <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><circle cx="11" cy="11" r="7" /><path d="m20 20-3.5-3.5" /></svg>
                    <span class="mbk-sr">Search reports</span>
                    <input class="mbk-search-input" type="text" placeholder="Rep, van, report or item"
                           value="@searchText" @oninput="OnSearchInputAsync" />
                    @if (!string.IsNullOrWhiteSpace(searchText))
                    {
                        <button type="button" class="mbk-search-clear" aria-label="Clear search" title="Clear search" @onclick="ClearSearchAsync">
                            <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M6 6l12 12M18 6 6 18" /></svg>
                        </button>
                    }
                </label>
                @* Both export what the list is showing — this tab, this search — across every page. *@
                <button type="button" class="mbk-btn mbk-btn-secondary" @onclick="() => ExportAsync(MarketBreakageExportFormat.Excel)"
                        disabled="@(!CanExport)" title="Download these reports as an Excel workbook" aria-label="Export to Excel">
                    @if (exporting == MarketBreakageExportFormat.Excel)
                    {
                        <span class="mbk-spin" aria-hidden="true"></span>
                    }
                    else
                    {
                        <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M12 4v11" /><path d="M7 10l5 5 5-5" /><path d="M5 20h14" /></svg>
                    }
                    <span>Excel</span>
                </button>
                <button type="button" class="mbk-btn mbk-btn-secondary" @onclick="() => ExportAsync(MarketBreakageExportFormat.Pdf)"
                        disabled="@(!CanExport)" title="Download these reports as a PDF" aria-label="Export to PDF">
                    @if (exporting == MarketBreakageExportFormat.Pdf)
                    {
                        <span class="mbk-spin" aria-hidden="true"></span>
                    }
                    else
                    {
                        <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M12 4v11" /><path d="M7 10l5 5 5-5" /><path d="M5 20h14" /></svg>
                    }
                    <span>PDF</span>
                </button>
                <button type="button" class="mbk-btn mbk-btn-secondary mbk-btn-icon" @onclick="RefreshAsync" disabled="@isLoading"
                        title="Refresh" aria-label="Refresh">
                    @if (isLoading)
                    {
                        <span class="mbk-spin" aria-hidden="true"></span>
                    }
                    else
                    {
                        <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M20 11a8 8 0 1 0-2.3 5.7" /><path d="M20 4v7h-7" /></svg>
                    }
                </button>
            </div>
        </div>
    </header>

    <div class="mbk-body">

        @if (!string.IsNullOrEmpty(errorMessage))
        {
            <div class="mbk-alert" role="alert">
                <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><circle cx="12" cy="12" r="9" /><path d="M12 8v5M12 16.5v.01" /></svg>
                <div class="mbk-alert-body">@errorMessage</div>
                <button type="button" class="mbk-btn mbk-btn-ghost mbk-btn-icon-sm" title="Dismiss"
                        aria-label="Dismiss error" @onclick="() => errorMessage = null">
                    <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M6 6l12 12M18 6 6 18" /></svg>
                </button>
            </div>
        }

        <nav class="mbk-tabs" aria-label="Report status">
            <div class="mbk-tablist">
                @foreach (var tab in Tabs)
                {
                    var isOn = statusFilter == tab.Value;
                    <button type="button" class="mbk-tab @(isOn ? "is-on" : "")" aria-pressed="@(isOn ? "true" : "false")"
                            @onclick="() => SetStatusFilterAsync(tab.Value)">
                        <span>@tab.Label</span>
                        <span class="mbk-tab-count">@(CountFor(tab.Value) is int count ? count.ToString("N0") : "—")</span>
                    </button>
                }
            </div>
            <span class="mbk-tabs-note">@OrderNote</span>
        </nav>

        <section class="mbk-list" aria-label="@ListTitle">
            <div class="mbk-grid mbk-grid-head" aria-hidden="true">
                <span></span>
                <span>Report</span>
                <span>Van</span>
                <span>Rep</span>
                <span>Products</span>
                <span class="mbk-right">Units</span>
                <span>Reported</span>
                <span class="mbk-right">Waiting</span>
                <span></span>
            </div>

            <div class="mbk-rows">
                @if (isLoading && reports.Count == 0)
                {
                    @for (var skeleton = 0; skeleton < 6; skeleton++)
                    {
                        <div class="mbk-grid mbk-row-skel" aria-hidden="true">
                            <span></span>
                            <div class="mbk-skel" style="width:70%"></div>
                            <div class="mbk-skel" style="width:80%"></div>
                            <div class="mbk-skel" style="width:75%"></div>
                            <div class="mbk-skel" style="width:90%"></div>
                            <div class="mbk-skel" style="width:60%"></div>
                            <div class="mbk-skel" style="width:85%"></div>
                            <div class="mbk-skel" style="width:60%"></div>
                            <span></span>
                        </div>
                    }
                }
                else
                {
                    @foreach (var report in reports)
                    {
                        var isCurrent = drawerOpen && detailId == report.Id;
                        var overdue = IsOverdue(report);
                        <button type="button" @key="report.Id" class="mbk-grid mbk-row @(isCurrent ? "is-on" : "")"
                                aria-current="@(isCurrent ? "true" : null)"
                                aria-label="Open report @report.Id, @report.VanWarehouseCode, @report.ReportedByName"
                                @onclick="() => PickAsync(report.Id)">
                            <span class="mbk-dot @StatusModifier(report.Status)" aria-hidden="true"></span>
                            <span class="mbk-row-no">#@report.Id</span>
                            <span class="mbk-row-van"><span class="mbk-tag">@report.VanWarehouseCode</span></span>
                            <span class="mbk-row-rep">@report.ReportedByName</span>
                            <span class="mbk-row-products">
                                <span class="mbk-row-item">
                                    <span class="mbk-row-name">@(report.FirstItemName ?? "—")</span>
                                    @if (report.LineCount > 1)
                                    {
                                        <span class="mbk-row-more">+ @(report.LineCount - 1) more</span>
                                    }
                                </span>
                                <span class="mbk-row-summary @SummaryModifier(report.Status)">@RowSummary(report)</span>
                            </span>
                            <span class="mbk-row-units mbk-right">@QuantityDisplay.Format(report.TotalConfirmedQuantity ?? report.TotalReportedQuantity)</span>
                            <span class="mbk-row-when">@FormatStamp(report.CapturedAtUtc)</span>
                            <span class="mbk-row-age mbk-right @(overdue ? "is-overdue" : "")">@WaitingText(report)</span>
                            <span class="mbk-row-go" aria-hidden="true">
                                <svg viewBox="0 0 24 24" focusable="false"><path d="M9 6l6 6-6 6" /></svg>
                            </span>
                        </button>
                    }
                }

                @if (!isLoading && reports.Count == 0)
                {
                    <div class="mbk-empty">
                        <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="m5 12 5 5L20 7" /></svg>
                        <span>@EmptyMessage</span>
                    </div>
                }
            </div>

            @if (TotalPages > 1)
            {
                <div class="mbk-foot">
                    <span class="mbk-foot-range">@RangeLabel</span>
                    <div class="mbk-pager">
                        <button type="button" class="mbk-btn mbk-btn-secondary mbk-btn-icon" title="Previous page"
                                aria-label="Previous page" disabled="@(currentPage <= 1 || isLoading)" @onclick="PreviousPageAsync">
                            <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="m15 5-7 7 7 7" /></svg>
                        </button>
                        <span class="mbk-page-label">@currentPage / @TotalPages</span>
                        <button type="button" class="mbk-btn mbk-btn-secondary mbk-btn-icon" title="Next page"
                                aria-label="Next page" disabled="@(currentPage >= TotalPages || isLoading)" @onclick="NextPageAsync">
                            <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="m9 5 7 7-7 7" /></svg>
                        </button>
                    </div>
                </div>
            }
        </section>
    </div>

    @* The open report, in the /desktop-sales invoice drawer's vocabulary from operations.css: a kicker,
       the report's number, the move it makes, then its marks; the figure; the facts as a grid; the lines
       as a table with their sums; and the outlined buttons along the foot. market-breakages.css carries
       only what that drawer has no part for — the count stepper, the reason tag, glyph sizes — and the
       overlay's height, which stays under the snackbar that announces a decision. *@
    @if (drawerOpen && detailId is int openId)
    {
        <div class="ops-overlay ops-overlay-right mbk-overlay" @onclick="CloseDrawer">
            <aside class="ops-drawer ops-ds-drawer mbk-drawer" role="dialog" aria-modal="true" aria-label="Report @openId" tabindex="-1"
                   @ref="drawerElement" @onkeydown="OnDrawerKeyDown" @onclick:stopPropagation="true">

                <div class="ops-drawer-head ops-ds-dhead">
                    <div class="ops-ds-dhead-id">
                        <span class="ops-kicker">Market breakage</span>
                        <span class="ops-ds-dhead-no">Report #@openId</span>
                        @if (detail is not null)
                        {
                            <span class="ops-ds-dhead-ref">@(detail.Status == MarketBreakageStatus.Rejected ? detail.VanWarehouseCode : $"{detail.VanWarehouseCode} → {ReturnsText}")</span>
                        }
                    </div>

                    <div class="ops-ds-dnav">
                        <button type="button" class="ops-icon-btn" title="Previous report" aria-label="Previous report"
                                disabled="@(PreviousId is null || isSubmitting)" @onclick="() => PickAsync(PreviousId!.Value)">
                            <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M6 15l6-6 6 6" /></svg>
                        </button>
                        <button type="button" class="ops-icon-btn" title="Next report" aria-label="Next report"
                                disabled="@(NextId is null || isSubmitting)" @onclick="() => PickAsync(NextId!.Value)">
                            <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M6 9l6 6 6-6" /></svg>
                        </button>
                        <button type="button" class="ops-icon-btn" title="Close" aria-label="Close" @onclick="CloseDrawer">
                            <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M6 6l12 12M18 6 6 18" /></svg>
                        </button>
                    </div>

                    @if (detail is not null)
                    {
                        <div class="ops-ds-dtags">
                            <span class="ops-badge @StatusFamily(detail.Status)">@StatusLabel(detail.Status)</span>
                            <span class="ops-ds-state @ProgressFamily"><span class="ops-dot"></span>@ProgressLabel</span>
                            <span class="ops-ds-dwhen">@FormatStamp(detail.CapturedAtUtc)</span>
                        </div>
                    }
                </div>

                @if (detail is null)
                {
                    <div class="ops-drawer-body">
                        @if (isLoadingDetail)
                        {
                            <div class="mbk-skel" style="width:48%;height:22px"></div>
                            <div class="mbk-skel" style="width:70%"></div>
                            <div class="mbk-skel" style="width:100%;height:160px"></div>
                        }
                        else
                        {
                            <div class="ops-msg ops-fam-bad" role="alert">
                                <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><circle cx="12" cy="12" r="9" /><path d="M12 8v5M12 16.5v.01" /></svg>
                                <div class="ops-msg-body">@(detailError ?? "This report could not be loaded.")</div>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <div class="ops-drawer-body">

                        <div class="ops-ds-headline">
                            <b>@UnitsText(HeadlineUnits)</b>
                            <span>@HeadlineNote</span>
                        </div>

                        @if (!string.IsNullOrEmpty(detailError))
                        {
                            <div class="ops-msg ops-fam-bad" role="alert">
                                <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><circle cx="12" cy="12" r="9" /><path d="M12 8v5M12 16.5v.01" /></svg>
                                <div class="ops-msg-body">@detailError</div>
                            </div>
                        }

                        @if (detail.Status == MarketBreakageStatus.Transferring)
                        {
                            <div class="ops-msg ops-fam-info" role="status">
                                <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><circle cx="12" cy="12" r="9" /><path d="M12 11v5M12 8h.01" /></svg>
                                <div class="ops-msg-body">
                                    <strong>A transfer started@(detail.LastAttemptedAtUtc is DateTime started ? $" {FormatStamp(started)}" : "") and has not finished.</strong>
                                    <div class="ops-msg-said">
                                        If it is still running, wait and refresh. If it was interrupted, look in SAP for a transfer out of
                                        @detail.VanWarehouseCode before you retry.
                                    </div>
                                </div>
                            </div>
                        }
                        else if (detail.Status == MarketBreakageStatus.TransferFailed || (!string.IsNullOrWhiteSpace(detail.LastError) && CanConfirm))
                        {
                            <div class="ops-msg ops-fam-bad" role="alert">
                                <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><circle cx="12" cy="12" r="9" /><path d="M12 8v5M12 16.5v.01" /></svg>
                                <div class="ops-msg-body">
                                    <strong>The SAP transfer failed@(detail.LastAttemptedAtUtc is DateTime tried ? $" · {FormatStamp(tried)}" : "").</strong>
                                    @if (!string.IsNullOrWhiteSpace(detail.LastError))
                                    {
                                        <div class="ops-msg-said">@detail.LastError</div>
                                    }
                                    <div class="ops-sub">Nothing moved in SAP. Adjust the count and retry, or reject it back to the rep.</div>
                                </div>
                            </div>
                        }

                        <div class="ops-defs">
                            <div>
                                <div class="ops-def-k">Rep</div>
                                <div class="ops-def-v">@detail.ReportedByName</div>
                            </div>
                            <div>
                                <div class="ops-def-k">Van</div>
                                <div class="ops-def-v">@detail.VanWarehouseCode</div>
                            </div>
                            <div>
                                @* A rejected report's stock never moved, so it names the warehouse rather than a move. *@
                                <div class="ops-def-k">@(detail.Status switch
                                {
                                    MarketBreakageStatus.Transferred => "Moved to",
                                    MarketBreakageStatus.Rejected => "Returns warehouse",
                                    _ => "Moves to"
                                })</div>
                                <div class="ops-def-v">@ReturnsText</div>
                            </div>
                            @if (!string.IsNullOrWhiteSpace(detail.CardName ?? detail.CardCode))
                            {
                                <div>
                                    <div class="ops-def-k">Customer</div>
                                    <div class="ops-def-v">
                                        @(detail.CardName ?? detail.CardCode)
                                        @if (!string.IsNullOrWhiteSpace(detail.CardName) && !string.IsNullOrWhiteSpace(detail.CardCode))
                                        {
                                            <div class="ops-sub ops-code">@detail.CardCode</div>
                                        }
                                    </div>
                                </div>
                            }
                            <div>
                                <div class="ops-def-k">Captured</div>
                                <div class="ops-def-v">
                                    @FormatStamp(detail.CapturedAtUtc)
                                    <div class="ops-sub">@AgeLong(detail.CapturedAtUtc)</div>
                                </div>
                            </div>
                            <div>
                                <div class="ops-def-k">SAP transfer</div>
                                <div class="ops-def-v">
                                    @if (detail.SapDocNum is int transferNo)
                                    {
                                        @($"#{transferNo}")
                                        @if (detail.TransferredAtUtc is DateTime movedAt)
                                        {
                                            <div class="ops-sub">@FormatStamp(movedAt)</div>
                                        }
                                    }
                                    else if (CanConfirm)
                                    {
                                        <span class="ops-ds-state ops-fam-neutral"><span class="ops-dot"></span>Not made yet</span>
                                        <div class="ops-sub">made when you confirm</div>
                                    }
                                    else
                                    {
                                        <span>None</span>
                                    }
                                </div>
                            </div>
                            @if (!CanConfirm && detail.DecidedAtUtc is DateTime decidedAt)
                            {
                                <div>
                                    <div class="ops-def-k">@(detail.Status == MarketBreakageStatus.Rejected ? "Rejected by" : "Confirmed by")</div>
                                    <div class="ops-def-v">
                                        @(detail.DecidedByName ?? "The office")
                                        <div class="ops-sub">@FormatStamp(decidedAt)</div>
                                    </div>
                                </div>
                            }
                        </div>

                        @if (!string.IsNullOrWhiteSpace(detail.Remarks))
                        {
                            <div class="ops-ds-block">
                                <div class="ops-def-k">@detail.ReportedByName wrote</div>
                                <div class="mbk-dnote">@detail.Remarks</div>
                            </div>
                        }

                        <div class="ops-ds-block">
                            <div class="mbk-dblock-head">
                                <span class="ops-def-k">@(CanConfirm ? "Count" : "Lines")</span>
                                @if (CanConfirm && !AllCounted)
                                {
                                    <button type="button" class="ops-btn ops-btn-ghost ops-btn-sm" @onclick="FillRestWithReported" disabled="@isSubmitting">
                                        <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M5 12l4 4L19 6" /></svg>
                                        Fill the rest with reported
                                    </button>
                                }
                            </div>
                            @* Scrolls sideways on its own at phone width, so the drawer's body never does. *@
                            <div class="mbk-dscroll">
                            <table class="ops-table">
                                <thead>
                                    <tr>
                                        <th>Item</th>
                                        <th class="ops-num">Reported</th>
                                        <th class="@(CanConfirm ? "ops-mid" : "ops-num")">Counted</th>
                                        <th class="ops-num">Difference</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var line in detail.Lines)
                                    {
                                        var counted = CountedFor(line);
                                        var name = string.IsNullOrWhiteSpace(line.ItemDescription) ? line.ItemCode : line.ItemDescription;
                                        <tr @key="line.Id">
                                            <td>
                                                <span class="ops-code mbk-dcode">@line.ItemCode</span>
                                                @if (!string.IsNullOrWhiteSpace(line.Reason))
                                                {
                                                    <span class="mbk-reason">@line.Reason</span>
                                                }
                                                @if (!string.IsNullOrWhiteSpace(line.ItemDescription))
                                                {
                                                    <div class="ops-sub">@line.ItemDescription</div>
                                                }
                                            </td>
                                            <td class="ops-num">@QuantityDisplay.Format(line.ReportedQuantity)</td>
                                            @if (CanConfirm)
                                            {
                                                <td class="ops-mid">
                                                    <span class="mbk-stepper @(counted is null ? "is-uncounted" : "")">
                                                        <button type="button" class="mbk-step" aria-label="One fewer @name"
                                                                disabled="@(isSubmitting || counted <= 0)" @onclick="() => StepCount(line, -1)">
                                                            <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M5 12h14" /></svg>
                                                        </button>
                                                        <input type="text" inputmode="decimal" class="mbk-count-input" placeholder="Count"
                                                               aria-label="Counted, @name" value="@CountText(line.Id)" disabled="@isSubmitting"
                                                               @onchange="args => SetCount(line.Id, args.Value)" />
                                                        <button type="button" class="mbk-step" aria-label="One more @name"
                                                                disabled="@isSubmitting" @onclick="() => StepCount(line, 1)">
                                                            <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M5 12h14M12 5v14" /></svg>
                                                        </button>
                                                    </span>
                                                </td>
                                            }
                                            else
                                            {
                                                <td class="ops-num">@(counted is decimal value ? QuantityDisplay.Format(value) : "—")</td>
                                            }
                                            <td class="ops-num">
                                                <span class="ops-qty @DiffFamily(counted, line.ReportedQuantity)">@(counted is null && !CanConfirm ? "—" : DiffLabel(counted, line.ReportedQuantity))</span>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                            </div>

                            <div class="ops-ds-sum">
                                <div>
                                    <span>Reported</span>
                                    <span>@QuantityDisplay.Format(ReportedTotal)</span>
                                </div>
                                <div>
                                    <span>Counted</span>
                                    <span>@(CountedLines > 0 ? QuantityDisplay.Format(CountedTotal) : "—")</span>
                                </div>
                                <div class="ops-ds-sum-total">
                                    <span>Difference</span>
                                    <span class="ops-qty @(AllCounted ? TotalDiffFamily : "")">@(AllCounted ? TotalDiffLabel : "—")</span>
                                </div>
                            </div>
                        </div>

                        @if (CanConfirm || CanReject)
                        {
                            <div class="ops-ds-block">
                                <label class="mbk-dlabel" for="mbk-remarks">
                                    <span class="ops-def-k">Note to the rep</span>
                                    <span class="ops-sub @(RemarkMissing || rejectNeedsReason ? "mbk-needed" : "")">@RemarkHint</span>
                                </label>
                                <textarea id="mbk-remarks" class="ops-input @(rejectNeedsReason ? "mbk-input-bad" : "")" rows="3" maxlength="500"
                                          aria-invalid="@(rejectNeedsReason ? "true" : null)"
                                          placeholder="e.g. Two sachets were resealable and went back to the van."
                                          @bind="decisionRemarks" @bind:event="oninput" @bind:after="ClearRejectHint"
                                          disabled="@isSubmitting"></textarea>
                            </div>
                        }
                        else if (!string.IsNullOrWhiteSpace(detail.DecisionRemarks))
                        {
                            <div class="ops-ds-block">
                                <div class="mbk-dlabel">
                                    <span class="ops-def-k">Note to the rep</span>
                                    <span class="ops-sub">sent with the decision</span>
                                </div>
                                <div class="mbk-dnote">@detail.DecisionRemarks</div>
                            </div>
                        }
                    </div>

                    <div class="ops-drawer-foot">
                        <button type="button" class="ops-btn ops-btn-ghost" @onclick="CloseDrawer" disabled="@isSubmitting">Close</button>
                        @if (CanConfirm || CanReject)
                        {
                            @* Undecided, so it prints stamped DRAFT with the counts typed so far. *@
                            <button type="button" class="ops-btn ops-btn-ghost" @onclick="PrintAsync"
                                    disabled="@isSubmitting" title="Print or save as PDF, stamped DRAFT">
                                <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M7 9V3h10v6" /><rect x="3" y="9" width="18" height="8" rx="2" /><path d="M7 14h10v7H7z" /></svg>
                                Print draft
                            </button>
                            @if (CanReject)
                            {
                                <button type="button" class="ops-btn ops-btn-danger" @onclick="RejectAsync"
                                        disabled="@isSubmitting" title="Send it back to the rep with your note">
                                    @if (isSubmitting && submittingAction == "reject")
                                    {
                                        <span class="ops-spin" aria-hidden="true"></span>
                                    }
                                    Reject to rep
                                </button>
                            }
                            @if (CanConfirm)
                            {
                                <button type="button" class="ops-btn ops-btn-primary mbk-dconfirm" @onclick="ConfirmAsync"
                                        disabled="@(isSubmitting || !CanSubmitCount)">
                                    @if (isSubmitting && submittingAction == "confirm")
                                    {
                                        <span class="ops-spin" aria-hidden="true"></span>
                                    }
                                    @ConfirmLabel
                                    <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M5 12h14" /><path d="M13 6l6 6-6 6" /></svg>
                                </button>
                            }
                        }
                        else
                        {
                            @if (detail.Status == MarketBreakageStatus.Transferred)
                            {
                                @* The slip that goes with the stock into returns, signed on both sides. *@
                                <button type="button" class="ops-btn ops-btn-primary" @onclick="PrintAsync"
                                        title="Print the return slip for this transfer">
                                    <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M7 9V3h10v6" /><rect x="3" y="9" width="18" height="8" rx="2" /><path d="M7 14h10v7H7z" /></svg>
                                    Return slip
                                </button>
                            }
                            <span class="ops-ds-foot-why">@DoneLabel</span>
                        }
                    </div>
                }
            </aside>
        </div>
    }
</div>
