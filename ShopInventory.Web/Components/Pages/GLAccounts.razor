@page "/gl-accounts"
@using Microsoft.AspNetCore.Authorization
@using Microsoft.EntityFrameworkCore
@using ShopInventory.Web.Data
@using ShopInventory.Web.Models
@attribute [Authorize(Roles = UserRoles.CatalogueRoles)]
@inject IMasterDataCacheService MasterDataCacheService
@inject IDbContextFactory<WebAppDbContext> DbContextFactory
@inject IAppSettingsProvider AppSettings
@rendermode InteractiveServer

<PageTitle>G/L Accounts - Shop Inventory</PageTitle>

@* Styles live in wwwroot/css/operations.css (linked from App.razor), shared
   with the other four operational pages — see that file's header. `ops` is the
   scope; `ops-gl` is this page's own half of it. *@

<div class="ops ops-gl">

    <div class="ops-hero">
        <div class="ops-hero-text">
            <div class="ops-kicker">Master data</div>
            <h1>G/L Accounts</h1>
            <p>
                The chart of accounts as SAP holds it. Read-only here — accounts are created and
                edited in SAP, and this page shows what the last sync brought back.
            </p>
        </div>
        <div class="ops-hero-actions">
            @if (lastSyncTime.HasValue)
            {
                <span class="ops-count">Last synced @lastSyncTime.Value.ToString("dd MMM yyyy HH:mm")</span>
            }
            <button type="button" class="ops-btn ops-btn-primary" @onclick="SyncFromSAP" disabled="@isSyncing">
                @if (isSyncing)
                {
                    <span class="ops-spin"></span>
                    <span>Syncing&hellip;</span>
                }
                else
                {
                    <i class="ph ph-cloud-arrow-down" aria-hidden="true"></i>
                    <span>Sync from SAP</span>
                }
            </button>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(syncMessage))
    {
        <div class="ops-msg @(syncSuccess ? "ops-fam-good" : "ops-fam-bad")" role="status">
            <i class="ph @(syncSuccess ? "ph-check-circle" : "ph-warning-octagon")" aria-hidden="true"></i>
            <div class="ops-msg-body">@syncMessage</div>
            <button type="button" class="ops-msg-x" aria-label="Dismiss" @onclick="() => syncMessage = null">
                <i class="ph ph-x" aria-hidden="true"></i>
            </button>
        </div>
    }

    @if (accounts != null)
    {
        @* Revenue and expenses take good and bad because that is what they are on
           a ledger — neither is a problem, and neither figure is an alert. *@
        <div class="ops-figures">
            <div class="ops-figure ops-fam-accent">
                <div class="ops-figure-head"><span class="ops-figure-rule"></span>Total accounts</div>
                <div class="ops-figure-num">@accounts.Count</div>
            </div>
            <div class="ops-figure ops-fam-good">
                <div class="ops-figure-head"><span class="ops-figure-rule"></span>Revenue</div>
                <div class="ops-figure-num">@accounts.Count(a => a.AccountType == "at_Revenues")</div>
            </div>
            <div class="ops-figure ops-fam-bad">
                <div class="ops-figure-head"><span class="ops-figure-rule"></span>Expenses</div>
                <div class="ops-figure-num">@accounts.Count(a => a.AccountType == "at_Expenses")</div>
            </div>
            <div class="ops-figure ops-fam-info">
                <div class="ops-figure-head"><span class="ops-figure-rule"></span>Other</div>
                <div class="ops-figure-num">
                    @accounts.Count(a => a.AccountType != "at_Revenues" && a.AccountType != "at_Expenses")
                </div>
            </div>
        </div>
    }

    <section class="ops-panel">
        <div class="ops-panel-head">
            <h2><i class="ph ph-book-open" aria-hidden="true"></i>Accounts</h2>
            @if (accounts != null)
            {
                <span class="ops-count">@filteredAccounts.Count of @accounts.Count</span>
            }
        </div>

        <div class="ops-filters">
            <div class="ops-field">
                <label class="ops-label" for="gl-search">Search</label>
                <div class="ops-search">
                    <i class="ph ph-magnifying-glass" aria-hidden="true"></i>
                    <input id="gl-search" type="search" class="ops-input" placeholder="Code or name"
                           @bind="searchTerm" @bind:event="oninput" @onkeyup="OnSearchChanged" />
                </div>
            </div>
            <div class="ops-field">
                <label class="ops-label" for="gl-type">Account type</label>
                <NocturneSelect Id="gl-type" Class="nsel-block" TValue="string"
                                Options="AccountTypeFilterOptions" @bind-Value="selectedAccountType"
                                OnChanged="ApplyFilters" Caption="Filter by account type"
                                AriaLabel="Filter by account type" Placeholder="All types" />
            </div>
            <div class="ops-field">
                <label class="ops-label" for="gl-currency">Currency</label>
                <NocturneSelect Id="gl-currency" Class="nsel-block" Options="CurrencyFilterOptions"
                                @bind-Value="selectedCurrency" OnChanged="ApplyFilters"
                                Caption="Filter by currency" AriaLabel="Filter by currency"
                                Placeholder="All currencies" />
            </div>
            <div class="ops-filter-actions">
                <button type="button" class="ops-btn ops-btn-ghost" @onclick="ClearFilters">
                    <i class="ph ph-x-circle" aria-hidden="true"></i>Clear
                </button>
            </div>
        </div>

        @if (isLoading)
        {
            <div class="ops-loading">
                <span class="ops-spin ops-spin-lg"></span>
                <p>Loading G/L accounts&hellip;</p>
            </div>
        }
        else if (errorMessage != null)
        {
            <div class="ops-empty">
                <i class="ph ph-warning-octagon" aria-hidden="true"></i>
                <h3>Could not load the accounts</h3>
                <p>@errorMessage</p>
            </div>
        }
        else if (filteredAccounts.Count == 0)
        {
            <div class="ops-empty">
                <i class="ph ph-book-open" aria-hidden="true"></i>
                @if (accounts?.Any() == true)
                {
                    <h3>Nothing matches those filters</h3>
                    <p>Clear them to see the whole chart of accounts.</p>
                    <div class="ops-empty-actions">
                        <button type="button" class="ops-btn ops-btn-ghost" @onclick="ClearFilters">Clear filters</button>
                    </div>
                }
                else
                {
                    <h3>No accounts yet</h3>
                    <p>Sync from SAP to bring the chart of accounts across.</p>
                    <div class="ops-empty-actions">
                        <button type="button" class="ops-btn ops-btn-primary" @onclick="SyncFromSAP" disabled="@isSyncing">
                            Sync from SAP
                        </button>
                    </div>
                }
            </div>
        }
        else
        {
            <div class="ops-scroll">
                <table class="ops-table">
                    <thead>
                        <tr>
                            <th class="ops-th-sort" @onclick="@(() => SortBy(nameof(GLAccountDto.Code)))">
                                Code @SortMark(nameof(GLAccountDto.Code))
                            </th>
                            <th class="ops-th-sort" @onclick="@(() => SortBy(nameof(GLAccountDto.Name)))">
                                Name @SortMark(nameof(GLAccountDto.Name))
                            </th>
                            <th class="ops-th-sort" @onclick="@(() => SortBy(nameof(GLAccountDto.AccountType)))">
                                Type @SortMark(nameof(GLAccountDto.AccountType))
                            </th>
                            <th>Currency</th>
                            <th class="ops-num ops-th-sort" @onclick="@(() => SortBy(nameof(GLAccountDto.Balance)))">
                                Balance @SortMark(nameof(GLAccountDto.Balance))
                            </th>
                            <th class="ops-mid">Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var account in pagedAccounts)
                        {
                            <tr>
                                <td><span class="ops-code">@account.Code</span></td>
                                <td class="ops-name">@account.Name</td>
                                <td>
                                    <span class="ops-badge @GetAccountTypeFamily(account.AccountType)">
                                        @GetAccountTypeLabel(account.AccountType)
                                    </span>
                                </td>
                                <td><span class="ops-unit">@account.Currency</span></td>
                                @* A negative balance is a fact about the account, not an error —
                                   so it takes the family and nothing else about the row changes. *@
                                <td class="ops-num">
                                    <span class="ops-qty @(account.Balance < 0 ? "ops-fam-bad" : "")">
                                        @account.Balance.ToString("N2")
                                    </span>
                                </td>
                                <td class="ops-mid">
                                    <span class="ops-badge @(account.IsActive ? "ops-fam-good" : "ops-fam-neutral")">
                                        @(account.IsActive ? "Active" : "Inactive")
                                    </span>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            @if (totalPages > 1)
            {
                <div class="ops-foot">
                    <span class="ops-foot-info">Page @currentPage of @totalPages</span>
                    <div class="ops-pages">
                        <button type="button" class="ops-step" disabled="@(currentPage <= 1)" @onclick="PreviousPage">
                            <i class="ph ph-caret-left" aria-hidden="true"></i>Previous
                        </button>
                        <span class="ops-page-now">@currentPage</span>
                        <button type="button" class="ops-step" disabled="@(currentPage >= totalPages)" @onclick="NextPage">
                            Next<i class="ph ph-caret-right" aria-hidden="true"></i>
                        </button>
                    </div>
                </div>
            }
        }
    </section>
</div>

@code {
    private List<GLAccountDto>? accounts;
    private List<GLAccountDto> filteredAccounts = new();
    private bool isLoading = true;
    private bool isSyncing = false;
    private string? errorMessage;
    private string? syncMessage;
    private bool syncSuccess;
    private DateTime? lastSyncTime;

    // Filters
    private string searchTerm = "";
    private string selectedAccountType = "";
    private string selectedCurrency = "";
    private List<string> availableCurrencies = new();

    private static readonly NocturneSelectOption<string>[] AccountTypeFilterOptions =
    [
        new(string.Empty, "All types", "neutral") { IsUnset = true, RuleAfter = true },
        new("at_Revenues", "Revenue", "good"),
        new("at_Expenses", "Expenses", "warn"),
        new("at_Other", "Other", "neutral")
    ];

    private IEnumerable<NocturneSelectOption<string>> CurrencyFilterOptions =>
        availableCurrencies
            .Select(currency => new NocturneSelectOption<string>(currency, currency, "accent"))
            .Prepend(NocturneSelectOption.All("All currencies"));

    // Sorting
    private string sortColumn = nameof(GLAccountDto.Code);
    private bool sortAscending = true;

    // Pagination
    private int currentPage = 1;
    private const int PageSize = 50;
    private int totalPages => (int)Math.Ceiling((double)filteredAccounts.Count / PageSize);
    private List<GLAccountDto> pagedAccounts => filteredAccounts
        .Skip((currentPage - 1) * PageSize)
        .Take(PageSize)
        .ToList();

    protected override async Task OnInitializedAsync()
    {
        await LoadAccounts();
    }

    private async Task LoadAccounts()
    {
        isLoading = true;
        errorMessage = null;

        try
        {
            accounts = await MasterDataCacheService.GetGLAccountsAsync();

            // Get last sync time
            lastSyncTime = MasterDataCacheService.GetLastRefreshTime("GLAccounts");

            // Extract available currencies for filter
            availableCurrencies = accounts
                .Where(a => !string.IsNullOrEmpty(a.Currency))
                .Select(a => a.Currency!)
                .Distinct()
                .OrderBy(c => c)
                .ToList();

            ApplyFilters();
        }
        catch (Exception ex)
        {
            errorMessage = $"Failed to load G/L accounts: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task SyncFromSAP()
    {
        isSyncing = true;
        syncMessage = null;

        try
        {
            var count = await MasterDataCacheService.SyncGLAccountsFromApiAsync();
            syncSuccess = true;
            syncMessage = $"Successfully synced {count} G/L accounts from SAP.";
            await LoadAccounts();
        }
        catch (Exception ex)
        {
            syncSuccess = false;
            syncMessage = $"Sync failed: {ex.Message}";
        }
        finally
        {
            isSyncing = false;
        }
    }

    private void OnSearchChanged()
    {
        ApplyFilters();
    }

    private void ApplyFilters()
    {
        if (accounts == null)
        {
            filteredAccounts = new();
            return;
        }

        var query = accounts.AsEnumerable();

        if (!string.IsNullOrWhiteSpace(searchTerm))
        {
            var term = searchTerm.Trim();
            query = query.Where(a =>
                (a.Code?.Contains(term, StringComparison.OrdinalIgnoreCase) == true) ||
                (a.Name?.Contains(term, StringComparison.OrdinalIgnoreCase) == true));
        }

        if (!string.IsNullOrEmpty(selectedAccountType))
        {
            query = query.Where(a => a.AccountType == selectedAccountType);
        }

        if (!string.IsNullOrEmpty(selectedCurrency))
        {
            query = query.Where(a => a.Currency == selectedCurrency);
        }

        // Apply sorting
        query = sortColumn switch
        {
            nameof(GLAccountDto.Name) => sortAscending ? query.OrderBy(a => a.Name) : query.OrderByDescending(a => a.Name),
            nameof(GLAccountDto.AccountType) => sortAscending ? query.OrderBy(a => a.AccountType) : query.OrderByDescending(a => a.AccountType),
            nameof(GLAccountDto.Balance) => sortAscending ? query.OrderBy(a => a.Balance) : query.OrderByDescending(a => a.Balance),
            _ => sortAscending ? query.OrderBy(a => a.Code) : query.OrderByDescending(a => a.Code),
        };

        filteredAccounts = query.ToList();
        currentPage = 1;
    }

    private void SortBy(string column)
    {
        if (sortColumn == column)
        {
            sortAscending = !sortAscending;
        }
        else
        {
            sortColumn = column;
            sortAscending = true;
        }

        ApplyFilters();
    }

    private void ClearFilters()
    {
        searchTerm = "";
        selectedAccountType = "";
        selectedCurrency = "";
        ApplyFilters();
    }

    private void PreviousPage()
    {
        if (currentPage > 1)
        {
            currentPage--;
        }
    }

    private void NextPage()
    {
        if (currentPage < totalPages)
        {
            currentPage++;
        }
    }

    // The caret beside the column currently sorted on. A MarkupString rather than
    // a component so it can sit inline inside the <th> text.
    private MarkupString SortMark(string column) => sortColumn != column
        ? default
        : (MarkupString)$"<span class=\"ops-sort-mark\">{(sortAscending ? "&#9650;" : "&#9660;")}</span>";

    private static string GetAccountTypeFamily(string? accountType) => accountType switch
    {
        "at_Revenues" => "ops-fam-good",
        "at_Expenses" => "ops-fam-bad",
        "at_Other" => "ops-fam-info",
        _ => "ops-fam-neutral"
    };

    private static string GetAccountTypeLabel(string? accountType) => accountType switch
    {
        "at_Revenues" => "Revenue",
        "at_Expenses" => "Expenses",
        "at_Other" => "Other",
        _ => accountType ?? "Unknown"
    };
}
