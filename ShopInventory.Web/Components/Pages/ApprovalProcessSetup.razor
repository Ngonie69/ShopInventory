@page "/approval-process/setup"
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize(Roles = "Admin")]
@inject IApprovalProcessService ApprovalService
@inject IUserManagementService UserService
@inject IMasterDataCacheService CacheService
@rendermode InteractiveServer

<PageTitle>Approval Process - Shop Inventory</PageTitle>

@* The imported Nocturne design is dark; wwwroot/css/approval-process.css
   (linked from App.razor) carries it and its light counterpart, and follows
   the app's theme toggle like every other page.

   Icons are drawn inline rather than from the Phosphor font: the search glyph
   sits inside a field and the tick is the whole of a checkbox, so a font that
   failed to load would leave both reading as nothing.

   The design draws a role and a person as buttons. They are native checkboxes
   in labels here — identical to look at, but they keep the roving focus, the
   space key and the "checked" a screen reader announces, none of which a
   button gives for free. The Active switch is the same trick. *@

<div class="apr">

    <header class="apr-head">
        <div class="apr-head-inner">
            <nav class="apr-crumbs" aria-label="Breadcrumb">
                <span>Administration</span>
                <span class="apr-crumb-sep" aria-hidden="true">/</span>
                <span class="apr-crumb-now" aria-current="page">Approval process</span>
            </nav>
            <div class="apr-head-actions">
                <button type="button" class="apr-btn apr-btn-ghost" disabled="@(isLoading || isSaving)"
                        @onclick="LoadAsync">
                    @if (isLoading)
                    {
                        <span class="apr-spin" aria-hidden="true"></span>
                        <span>Refreshing&#8230;</span>
                    }
                    else
                    {
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                             stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <path d="M20 11a8 8 0 0 0-13.7-5.3L4 8"></path>
                            <path d="M4 4v4h4"></path>
                            <path d="M4 13a8 8 0 0 0 13.7 5.3L20 16"></path>
                            <path d="M20 20v-4h-4"></path>
                        </svg>
                        <span>Refresh</span>
                    }
                </button>
            </div>
        </div>
    </header>

    <div class="apr-body">

        <section class="apr-hero">
            <div class="apr-kicker">Workflow</div>
            <h1>Approval process</h1>
            <p>
                Stages define who signs off. Templates decide which documents route through which stages,
                and in what order.
            </p>
        </section>

        @if (!string.IsNullOrWhiteSpace(message))
        {
            <div class="apr-msg @(isError ? "apr-msg-error" : "")" role="@(isError ? "alert" : "status")">
                @if (isError)
                {
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                         stroke-width="1.7" stroke-linecap="round" aria-hidden="true">
                        <circle cx="12" cy="12" r="9"></circle>
                        <path d="M12 7.5v5.5M12 16.2v.1"></path>
                    </svg>
                }
                else
                {
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                         stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <circle cx="12" cy="12" r="9"></circle>
                        <path d="M8 12.5l2.7 2.7L16 9.8"></path>
                    </svg>
                }
                <span>@message</span>
                <button type="button" class="apr-msg-x" aria-label="Dismiss" @onclick="() => message = null">
                    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                         stroke-width="2.2" stroke-linecap="round" aria-hidden="true">
                        <path d="M6 6l12 12M18 6L6 18"></path>
                    </svg>
                </button>
            </div>
        }

        <div class="apr-tabs" role="tablist">
            <button type="button" role="tab" class="apr-tab @(OnStages ? "apr-tab-on" : "")"
                    aria-selected="@OnStages" @onclick="() => SwitchTab(StagesTab)">
                Approval stages
            </button>
            <button type="button" role="tab" class="apr-tab @(OnStages ? "" : "apr-tab-on")"
                    aria-selected="@(!OnStages)" @onclick="() => SwitchTab(TemplatesTab)">
                Approval templates
            </button>
        </div>

        @if (isLoading)
        {
            <div class="apr-loading">
                <span class="apr-spin" aria-hidden="true"></span>
                <span>Loading the approval process&#8230;</span>
            </div>
        }
        else if (OnStages)
        {
            <section class="apr-grid">

                <!-- ── The stages ─────────────────────────────────────────── -->
                <div class="apr-rail">
                    <button type="button" class="apr-btn apr-btn-primary apr-btn-block" @onclick="NewStage">
                        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                             stroke-width="1.8" stroke-linecap="round" aria-hidden="true">
                            <path d="M12 5v14M5 12h14"></path>
                        </svg>
                        <span>New stage</span>
                    </button>
                    @if (stages.Count == 0)
                    {
                        <p class="apr-rail-empty">
                            No approval stages yet — create one, then point a template at it.
                        </p>
                    }
                    @foreach (var stage in stages)
                    {
                        <button type="button" class="apr-card @(editingStage.Id == stage.Id ? "apr-card-on" : "")"
                                @onclick="() => EditStage(stage)">
                            <span class="apr-card-top">
                                <span class="apr-card-name">@stage.Name</span>
                                <span class="apr-pill @(stage.IsActive ? "apr-pill-on" : "")">
                                    @(stage.IsActive ? "Active" : "Inactive")
                                </span>
                            </span>
                            <span class="apr-card-meta">@StageMeta(stage)</span>
                        </button>
                    }
                </div>

                <!-- ── The stage editor ───────────────────────────────────── -->
                <div class="apr-panel">

                    <div class="apr-panel-head">
                        <h2>@(editingStage.Id == Guid.Empty ? "Create approval stage" : "Edit approval stage")</h2>
                        <p>Who signs off, and how many approvals or rejections settle the request.</p>
                    </div>

                    <div class="apr-fields">
                        <label class="apr-field apr-field-wide">
                            <span class="apr-label">Name</span>
                            <input class="apr-input" @bind="editingStage.Name" placeholder="Stock officer approval" />
                        </label>
                        <label class="apr-field apr-field-wide">
                            <span class="apr-label">Description</span>
                            <textarea class="apr-input" rows="2" @bind="editingStage.Description"
                                      placeholder="What this stage is for."></textarea>
                        </label>
                        <label class="apr-field">
                            <span class="apr-label">Approvals required</span>
                            <input type="number" min="1" class="apr-input apr-input-num"
                                   @bind="editingStage.ApprovalsRequired" />
                        </label>
                        <label class="apr-field">
                            <span class="apr-label">Rejections required</span>
                            <input type="number" min="1" class="apr-input apr-input-num"
                                   @bind="editingStage.RejectionsRequired" />
                        </label>
                    </div>

                    <div>
                        <div class="apr-block-head">
                            <span class="apr-label">Authorizer roles</span>
                            <span class="apr-block-count">
                                @editingStage.AuthorizerRoles.Count of @availableRoles.Count
                            </span>
                        </div>
                        <div class="apr-choices">
                            @foreach (var role in availableRoles)
                            {
                                var picked = editingStage.AuthorizerRoles.Contains(role);
                                <label class="apr-choice @(picked ? "apr-choice-on" : "")">
                                    <input type="checkbox" class="apr-choice-check" checked="@picked"
                                           @onchange="e => Toggle(editingStage.AuthorizerRoles, role, e.Value as bool? == true)" />
                                    <span class="apr-box @(picked ? "apr-box-on" : "")" aria-hidden="true">@Tick</span>
                                    <span class="apr-choice-name">@FriendlyRole(role)</span>
                                </label>
                            }
                        </div>
                    </div>

                    <div>
                        <div class="apr-block-head">
                            <span class="apr-label">Specific authorizers</span>
                            <span class="apr-block-count">@editingStage.AuthorizerUserIds.Count picked</span>
                            <label class="apr-block-search">
                                <span class="visually-hidden">Find an authorizer</span>
                                @SearchGlyph
                                <input class="apr-input apr-input-search" type="search" autocomplete="off"
                                       placeholder="Find a person…" @bind="peopleQuery" @bind:event="oninput" />
                            </label>
                        </div>
                        <div class="apr-choices apr-choices-scroll">
                            @foreach (var user in MatchingUsers)
                            {
                                var picked = editingStage.AuthorizerUserIds.Contains(user.Id);
                                <label class="apr-choice @(picked ? "apr-choice-on" : "")">
                                    <input type="checkbox" class="apr-choice-check" checked="@picked"
                                           @onchange="e => Toggle(editingStage.AuthorizerUserIds, user.Id, e.Value as bool? == true)" />
                                    <span class="apr-box @(picked ? "apr-box-on" : "")" aria-hidden="true">@Tick</span>
                                    <span class="apr-choice-text">
                                        <span class="apr-choice-name">@user.Username</span>
                                        <span class="apr-choice-role">@FriendlyRole(user.Role)</span>
                                    </span>
                                </label>
                            }
                            @if (MatchingUsers.Count == 0)
                            {
                                <p class="apr-choices-empty">@NoPeopleMessage</p>
                            }
                        </div>
                    </div>

                    @if (IsEditingStageLinked)
                    {
                        <div class="apr-note" role="status">
                            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                 stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                <path d="M6 10.5h12v9H6z"></path>
                                <path d="M8.5 10.5V7a3.5 3.5 0 1 1 7 0v3.5"></path>
                            </svg>
                            <span>
                                <strong>
                                    Used by @LinkedTemplateNames.Count approval
                                    template@(LinkedTemplateNames.Count == 1 ? "" : "s").
                                </strong>
                                @string.Join(", ", LinkedTemplateNames). Remove the stage from these templates
                                before deleting it.
                            </span>
                        </div>
                    }

                    <div class="apr-foot">
                        <label class="apr-switch">
                            <input type="checkbox" class="apr-switch-check" @bind="editingStage.IsActive" />
                            <span class="apr-track @(editingStage.IsActive ? "apr-track-on" : "")" aria-hidden="true">
                                <span class="apr-knob"></span>
                            </span>
                            <span class="apr-switch-label">@(editingStage.IsActive ? "Active" : "Inactive")</span>
                        </label>
                        <div class="apr-foot-actions">
                            @if (editingStage.Id != Guid.Empty)
                            {
                                <button type="button" class="apr-btn apr-btn-danger"
                                        disabled="@(isSaving || IsEditingStageLinked)"
                                        title="@(IsEditingStageLinked ? "Remove this stage from its approval templates before deleting it." : "Delete this approval stage")"
                                        @onclick="DeleteStageAsync">
                                    Delete
                                </button>
                            }
                            <button type="button" class="apr-btn apr-btn-quiet" disabled="@isSaving"
                                    @onclick="CancelStage">
                                Cancel
                            </button>
                            <button type="button" class="apr-btn apr-btn-primary apr-btn-lg" disabled="@isSaving"
                                    @onclick="SaveStageAsync">
                                @if (isSaving)
                                {
                                    <span class="apr-spin" aria-hidden="true"></span>
                                    <span>Saving&#8230;</span>
                                }
                                else
                                {
                                    <span>Save stage</span>
                                }
                            </button>
                        </div>
                    </div>

                </div>
            </section>
        }
        else
        {
            <section class="apr-grid">

                <!-- ── The templates ──────────────────────────────────────── -->
                <div class="apr-rail">
                    <button type="button" class="apr-btn apr-btn-primary apr-btn-block" @onclick="NewTemplate">
                        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                             stroke-width="1.8" stroke-linecap="round" aria-hidden="true">
                            <path d="M12 5v14M5 12h14"></path>
                        </svg>
                        <span>New template</span>
                    </button>
                    @if (templates.Count == 0)
                    {
                        <p class="apr-rail-empty">
                            No approval templates yet — until one exists, no document routes for approval.
                        </p>
                    }
                    @foreach (var template in templates)
                    {
                        <button type="button" class="apr-card @(editingTemplate.Id == template.Id ? "apr-card-on" : "")"
                                @onclick="() => EditTemplate(template)">
                            <span class="apr-card-top">
                                <span class="apr-card-name">@template.Name</span>
                                <span class="apr-pill @(template.IsActive ? "apr-pill-on" : "")">
                                    @(template.IsActive ? "Active" : "Inactive")
                                </span>
                            </span>
                            <span class="apr-card-meta">@TemplateMeta(template)</span>
                        </button>
                    }
                </div>

                <!-- ── The template editor ────────────────────────────────── -->
                <div class="apr-panel">

                    <div class="apr-panel-head">
                        <h2>@(editingTemplate.Id == Guid.Empty ? "Create approval template" : "Edit approval template")</h2>
                        <p>Which documents route here, in what order, and who may raise them.</p>
                    </div>

                    <div class="apr-fields">
                        <label class="apr-field apr-field-wide">
                            <span class="apr-label">Name</span>
                            <input class="apr-input" @bind="editingTemplate.Name" placeholder="Dispatch transfers" />
                        </label>
                        <label class="apr-field apr-field-wide">
                            <span class="apr-label">Description</span>
                            <textarea class="apr-input" rows="2" @bind="editingTemplate.Description"
                                      placeholder="What this template is for."></textarea>
                        </label>
                        <label class="apr-field">
                            <span class="apr-label">Document type</span>
                            <span class="apr-select">
                                <select class="apr-input" @bind="editingTemplate.DocumentType">
                                    @foreach (var documentType in documentTypes)
                                    {
                                        <option value="@documentType">@FriendlyDocumentType(documentType)</option>
                                    }
                                </select>
                                <span class="apr-caret" aria-hidden="true"></span>
                            </span>
                        </label>
                        <label class="apr-field">
                            <span class="apr-label">Priority</span>
                            <input type="number" class="apr-input apr-input-num" @bind="editingTemplate.Priority" />
                        </label>
                        <label class="apr-field">
                            <span class="apr-label">From warehouse</span>
                            <span class="apr-select">
                                <select class="apr-input" @bind="editingTemplate.FromWarehouse">
                                    <option value="">Any</option>
                                    @foreach (var warehouse in warehouses)
                                    {
                                        <option value="@warehouse.WarehouseCode">
                                            @warehouse.WarehouseCode &#8212; @warehouse.WarehouseName
                                        </option>
                                    }
                                </select>
                                <span class="apr-caret" aria-hidden="true"></span>
                            </span>
                        </label>
                        <label class="apr-field">
                            <span class="apr-label">To warehouse</span>
                            <span class="apr-select">
                                <select class="apr-input" @bind="editingTemplate.ToWarehouse">
                                    <option value="">Any</option>
                                    @foreach (var warehouse in warehouses)
                                    {
                                        <option value="@warehouse.WarehouseCode">
                                            @warehouse.WarehouseCode &#8212; @warehouse.WarehouseName
                                        </option>
                                    }
                                </select>
                                <span class="apr-caret" aria-hidden="true"></span>
                            </span>
                        </label>
                    </div>

                    <div>
                        <div class="apr-block-head">
                            <span class="apr-label">
                                Approval stages <span class="apr-label-note">(in the order they run)</span>
                            </span>
                            <span class="apr-block-count">
                                @editingTemplate.StageIds.Count of @SelectableStages.Count
                            </span>
                        </div>
                        <div class="apr-choices">
                            @foreach (var stage in SelectableStages)
                            {
                                var picked = editingTemplate.StageIds.Contains(stage.Id);
                                <label class="apr-choice @(picked ? "apr-choice-on" : "")">
                                    <input type="checkbox" class="apr-choice-check" checked="@picked"
                                           @onchange="e => Toggle(editingTemplate.StageIds, stage.Id, e.Value as bool? == true)" />
                                    <span class="apr-box @(picked ? "apr-box-on" : "")" aria-hidden="true">@Tick</span>
                                    <span class="apr-choice-text">
                                        <span class="apr-choice-name">@stage.Name</span>
                                        @if (!stage.IsActive)
                                        {
                                            <span class="apr-choice-role">Inactive</span>
                                        }
                                    </span>
                                </label>
                            }
                            @if (SelectableStages.Count == 0)
                            {
                                <p class="apr-choices-empty">
                                    No active approval stages — create one on the Approval stages tab first.
                                </p>
                            }
                        </div>
                    </div>

                    <div>
                        <div class="apr-block-head">
                            <span class="apr-label">
                                Originator roles <span class="apr-label-note">(none means everyone)</span>
                            </span>
                            <span class="apr-block-count">
                                @editingTemplate.OriginatorRoles.Count of @availableRoles.Count
                            </span>
                        </div>
                        <div class="apr-choices">
                            @foreach (var role in availableRoles)
                            {
                                var picked = editingTemplate.OriginatorRoles.Contains(role);
                                <label class="apr-choice @(picked ? "apr-choice-on" : "")">
                                    <input type="checkbox" class="apr-choice-check" checked="@picked"
                                           @onchange="e => Toggle(editingTemplate.OriginatorRoles, role, e.Value as bool? == true)" />
                                    <span class="apr-box @(picked ? "apr-box-on" : "")" aria-hidden="true">@Tick</span>
                                    <span class="apr-choice-name">@FriendlyRole(role)</span>
                                </label>
                            }
                        </div>
                    </div>

                    <div>
                        <div class="apr-block-head">
                            <span class="apr-label">Specific originators</span>
                            <span class="apr-block-count">@editingTemplate.OriginatorUserIds.Count picked</span>
                            <label class="apr-block-search">
                                <span class="visually-hidden">Find an originator</span>
                                @SearchGlyph
                                <input class="apr-input apr-input-search" type="search" autocomplete="off"
                                       placeholder="Find a person…" @bind="peopleQuery" @bind:event="oninput" />
                            </label>
                        </div>
                        <div class="apr-choices apr-choices-scroll">
                            @foreach (var user in MatchingUsers)
                            {
                                var picked = editingTemplate.OriginatorUserIds.Contains(user.Id);
                                <label class="apr-choice @(picked ? "apr-choice-on" : "")">
                                    <input type="checkbox" class="apr-choice-check" checked="@picked"
                                           @onchange="e => Toggle(editingTemplate.OriginatorUserIds, user.Id, e.Value as bool? == true)" />
                                    <span class="apr-box @(picked ? "apr-box-on" : "")" aria-hidden="true">@Tick</span>
                                    <span class="apr-choice-text">
                                        <span class="apr-choice-name">@user.Username</span>
                                        <span class="apr-choice-role">@FriendlyRole(user.Role)</span>
                                    </span>
                                </label>
                            }
                            @if (MatchingUsers.Count == 0)
                            {
                                <p class="apr-choices-empty">@NoPeopleMessage</p>
                            }
                        </div>
                    </div>

                    <div class="apr-foot">
                        <label class="apr-switch">
                            <input type="checkbox" class="apr-switch-check" @bind="editingTemplate.IsActive" />
                            <span class="apr-track @(editingTemplate.IsActive ? "apr-track-on" : "")" aria-hidden="true">
                                <span class="apr-knob"></span>
                            </span>
                            <span class="apr-switch-label">@(editingTemplate.IsActive ? "Active" : "Inactive")</span>
                        </label>
                        <div class="apr-foot-actions">
                            @if (editingTemplate.Id != Guid.Empty)
                            {
                                <button type="button" class="apr-btn apr-btn-danger" disabled="@isSaving"
                                        title="Delete this approval template" @onclick="DeleteTemplateAsync">
                                    Delete
                                </button>
                            }
                            <button type="button" class="apr-btn apr-btn-quiet" disabled="@isSaving"
                                    @onclick="CancelTemplate">
                                Cancel
                            </button>
                            <button type="button" class="apr-btn apr-btn-primary apr-btn-lg" disabled="@isSaving"
                                    @onclick="SaveTemplateAsync">
                                @if (isSaving)
                                {
                                    <span class="apr-spin" aria-hidden="true"></span>
                                    <span>Saving&#8230;</span>
                                }
                                else
                                {
                                    <span>Save template</span>
                                }
                            </button>
                        </div>
                    </div>

                </div>
            </section>
        }
    </div>
</div>

@code {
    private const string StagesTab = "Stages";
    private const string TemplatesTab = "Templates";

    private List<string> availableRoles = [];
    private List<ApprovalStageDefinitionModel> stages = [];
    private List<ApprovalTemplateDefinitionModel> templates = [];
    private List<UserModel> users = [];
    private List<WarehouseDto> warehouses = [];

    // Document types the approval engine can drive. Must match ApprovalDocumentTypes on the API.
    private readonly List<string> documentTypes = ["InventoryTransferRequest", "InventoryTransfer"];

    private ApprovalStageDefinitionModel editingStage = new();
    private ApprovalTemplateDefinitionModel editingTemplate = new();
    private string tab = StagesTab;
    private string peopleQuery = string.Empty;
    private bool isLoading = true, isSaving, isError;
    private string? message;

    private bool OnStages => tab == StagesTab;

    private List<string> LinkedTemplateNames => editingStage.Id == Guid.Empty
        ? []
        : templates.Where(template => template.StageIds.Contains(editingStage.Id))
            .Select(template => template.Name)
            .OrderBy(name => name)
            .ToList();
    private bool IsEditingStageLinked => LinkedTemplateNames.Count > 0;

    private List<UserModel> MatchingUsers
    {
        get
        {
            var query = peopleQuery.Trim();
            return users
                .Where(user => user.IsActive)
                .Where(user => query.Length == 0
                    || user.Username.Contains(query, StringComparison.OrdinalIgnoreCase)
                    || FriendlyRole(user.Role).Contains(query, StringComparison.OrdinalIgnoreCase))
                .ToList();
        }
    }

    private string NoPeopleMessage => peopleQuery.Trim().Length == 0
        ? "No active users to choose from."
        : $"No one matches “{peopleQuery.Trim()}”.";

    // An inactive stage a template already points at stays listed, marked — the
    // picker only offering active stages would hide it while the save kept it.
    private List<ApprovalStageDefinitionModel> SelectableStages =>
        stages.Where(stage => stage.IsActive || editingTemplate.StageIds.Contains(stage.Id)).ToList();

    // Nothing here needs a rendered DOM, so the load starts with the component
    // rather than waiting for a full render to reach the browser first.
    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        isLoading = true; message = null;
        try
        {
            stages = await ApprovalService.GetStagesAsync();
            templates = await ApprovalService.GetTemplatesAsync();
            users = (await UserService.GetUsersAsync(1, 1000)).Items;
            availableRoles = await UserService.GetRolesAsync();
            warehouses = await CacheService.GetWarehousesAsync();
        }
        catch (Exception ex) { message = ex.Message; isError = true; }
        finally { isLoading = false; }
    }

    private void SwitchTab(string value)
    {
        tab = value;
        peopleQuery = string.Empty;
    }

    private void NewStage() => editingStage = new();
    private void NewTemplate() => editingTemplate = new();
    private void EditStage(ApprovalStageDefinitionModel value) => editingStage = Clone(value);
    private void EditTemplate(ApprovalTemplateDefinitionModel value) => editingTemplate = Clone(value);

    // Cancel drops unsaved edits: back to the stored definition, or to a blank
    // form when the edit was a new one.
    private void CancelStage()
    {
        var stored = stages.FirstOrDefault(stage => stage.Id == editingStage.Id);
        editingStage = stored is null ? new() : Clone(stored);
        message = null;
    }

    private void CancelTemplate()
    {
        var stored = templates.FirstOrDefault(template => template.Id == editingTemplate.Id);
        editingTemplate = stored is null ? new() : Clone(stored);
        message = null;
    }

    private async Task SaveStageAsync() { if(!ValidateStage())return; isSaving=true; var result=await ApprovalService.SaveStageAsync(editingStage); if(result.Success){await LoadAsync(); if(result.Value is not null) EditStage(result.Value);} SetMessage(result.Success,result.Message); isSaving=false; }
    private async Task SaveTemplateAsync() { if(!ValidateTemplate())return; isSaving=true; var result=await ApprovalService.SaveTemplateAsync(editingTemplate); if(result.Success){await LoadAsync(); if(result.Value is not null) EditTemplate(result.Value);} SetMessage(result.Success,result.Message); isSaving=false; }
    private async Task DeleteStageAsync() { if(IsEditingStageLinked){SetMessage(false,LinkedStageMessage());return;} var result=await ApprovalService.DeleteStageAsync(editingStage.Id); if(result.Success){NewStage();await LoadAsync();} SetMessage(result.Success,result.Message); }
    private async Task DeleteTemplateAsync() { var result=await ApprovalService.DeleteTemplateAsync(editingTemplate.Id); if(result.Success){NewTemplate();await LoadAsync();} SetMessage(result.Success,result.Message); }
    private void SetMessage(bool success,string text){isError=!success;message=FriendlyMessage(text);}
    private bool ValidateStage(){if(string.IsNullOrWhiteSpace(editingStage.Name)){SetMessage(false,"Enter a stage name.");return false;}if(editingStage.ApprovalsRequired<1||editingStage.RejectionsRequired<1){SetMessage(false,"Approval and rejection requirements must be at least one.");return false;}if(editingStage.AuthorizerRoles.Count==0&&editingStage.AuthorizerUserIds.Count==0){SetMessage(false,"Select at least one authorizer role or specific authorizer.");return false;}return true;}
    private bool ValidateTemplate(){if(string.IsNullOrWhiteSpace(editingTemplate.Name)){SetMessage(false,"Enter a template name.");return false;}if(editingTemplate.StageIds.Count==0){SetMessage(false,"Select at least one approval stage.");return false;}return true;}

    // The design writes a card's second line as "1 approval · 1 rejection ·
    // used by 3 templates".
    private string StageMeta(ApprovalStageDefinitionModel stage)
    {
        var approvals = $"{stage.ApprovalsRequired} approval{(stage.ApprovalsRequired == 1 ? "" : "s")}";
        var rejections = $"{stage.RejectionsRequired} rejection{(stage.RejectionsRequired == 1 ? "" : "s")}";
        return $"{approvals} · {rejections} · {StageUsageLabel(stage.Id)}";
    }

    private string TemplateMeta(ApprovalTemplateDefinitionModel template)
    {
        var count = template.StageIds.Count;
        return $"{FriendlyDocumentType(template.DocumentType)} · {count} stage{(count == 1 ? "" : "s")}"
            + $" · priority {template.Priority}";
    }

    private string StageUsageLabel(Guid stageId){var count=templates.Count(template=>template.StageIds.Contains(stageId));return count==0?"not used by a template":$"used by {count} template{(count==1?"":"s")}";}
    private string LinkedStageMessage()=>$"This approval stage is used by {string.Join(", ", LinkedTemplateNames)}. Remove it from those templates before deleting it.";
    private static string FriendlyMessage(string text)
    {
        if(text.Contains("linked to a template",StringComparison.OrdinalIgnoreCase)) return "This approval stage is still used by an approval template. Remove it from the template before deleting it.";
        if(text.Contains("template name and at least one approval stage",StringComparison.OrdinalIgnoreCase)) return "Enter a template name and select at least one approval stage.";
        if(text.Contains("approval stage used by an approval request",StringComparison.OrdinalIgnoreCase)) return "This approval stage has approval history and cannot be deleted. Deactivate it instead.";
        if(text.Contains("approval template used by an approval request",StringComparison.OrdinalIgnoreCase)) return "This approval template has already been used and cannot be deleted. Deactivate it instead.";
        return ApiErrorResponse.NormalizeUserMessage(text) ?? text;
    }
    private static void Toggle<T>(List<T> list,T value,bool selected){if(selected){if(!list.Contains(value))list.Add(value);}else list.Remove(value);}
    private static ApprovalStageDefinitionModel Clone(ApprovalStageDefinitionModel x)=>new(){Id=x.Id,Name=x.Name,Description=x.Description,ApprovalsRequired=x.ApprovalsRequired,RejectionsRequired=x.RejectionsRequired,AuthorizerUserIds=[..x.AuthorizerUserIds],AuthorizerRoles=[..x.AuthorizerRoles],IsActive=x.IsActive};
    private static ApprovalTemplateDefinitionModel Clone(ApprovalTemplateDefinitionModel x)=>new(){Id=x.Id,Name=x.Name,Description=x.Description,DocumentType=x.DocumentType,OriginatorUserIds=[..x.OriginatorUserIds],OriginatorRoles=[..x.OriginatorRoles],StageIds=[..x.StageIds],FromWarehouse=x.FromWarehouse,ToWarehouse=x.ToWarehouse,Priority=x.Priority,IsActive=x.IsActive};
    private static string FriendlyRole(string role)=>role switch{"StockController"=>"Stock Officer","DepotController"=>"Depot Controller",_=>role};
    private static string FriendlyDocumentType(string? documentType)=>documentType switch{"InventoryTransferRequest"=>"Transfer requests","InventoryTransfer"=>"Direct transfers",_=>documentType ?? "Unknown"};

