@page "/payments/create"
@using Microsoft.AspNetCore.Authorization
@using ShopInventory.Web.Data
@using Microsoft.EntityFrameworkCore
@attribute [Authorize(Roles = "Admin,Cashier")]
@inject IPaymentService PaymentService
@inject IBusinessPartnerService BusinessPartnerService
@inject IAppSettingsService AppSettingsService
@inject IDbContextFactory<WebAppDbContext> DbContextFactory
@inject NavigationManager NavigationManager
@inject ILogger<CreateIncomingPayment> Logger
@inject IAppSettingsProvider AppSettings
@inject IAuditService AuditService
@rendermode InteractiveServer

<PageTitle>Create Incoming Payment - Shop Inventory</PageTitle>

@* Styles live in wwwroot/css/sales-forms.css (linked from App.razor), shared
   with the other four sales document forms — see that file's header. The sheet
   carries a light and a dark palette and follows the app's theme toggle.

   `is-receipt` selects this form's row columns from the sheet. It is the one
   form of the five that does not edit lines: its rows are the invoices the
   money is applied to, and the four payment means above them are the branch
   the whole form turns on.

   Icon-only controls draw their glyph inline rather than from the Phosphor
   font: the glyph is their whole label, so a font that failed to load would
   leave them reading as dead controls. Icons beside a word keep the font. *@

<div class="sfm is-receipt">
    <div class="sfm-accentbar"></div>
    <div class="sfm-shell">

        <!-- ── Breadcrumb strip ───────────────────────────────────────── -->
        <div class="sfm-crumbs">
            <a href="/payments">Incoming payments</a>
            <span class="sfm-crumb-sep">/</span>
            <span class="sfm-crumb-now">Create new</span>
            <span class="sfm-spacer"></span>
            <a href="/payments" class="sfm-btn"><i class="ph ph-arrow-left"></i>Back</a>
        </div>

        <!-- ── Head ───────────────────────────────────────────────────── -->
        <div class="sfm-head">
            <div class="sfm-head-main">
                <h1>Create incoming payment</h1>
                <p>Records a receipt from a customer &middot; posts directly to SAP Business One</p>
            </div>
            <div class="sfm-stats">
                <div class="sfm-stat">
                    <div class="sfm-stat-k">Method</div>
                    <div class="sfm-stat-v">@PaymentMethodLabel</div>
                </div>
                <div class="sfm-stat">
                    <div class="sfm-stat-k">Applied</div>
                    <div class="sfm-stat-v">@AppliedTotal.ToString("N2")</div>
                </div>
                <div class="sfm-stat">
                    <div class="sfm-stat-k">Total payment</div>
                    <div class="sfm-stat-v is-total">@TotalPayment.ToString("N2")</div>
                </div>
            </div>
        </div>

        <!-- ── Alerts ─────────────────────────────────────────────────── -->
        @if (!string.IsNullOrEmpty(successMessage))
        {
            <div class="sfm-alert is-ok">
                <i class="ph-fill ph-check-circle"></i>
                <div class="sfm-alert-bd">@successMessage</div>
                <button type="button" class="sfm-alert-x" @onclick="() => successMessage = null" aria-label="Dismiss">
                    <i class="ph ph-x"></i>
                </button>
            </div>
        }
        @if (!string.IsNullOrEmpty(errorMessage))
        {
            <div class="sfm-alert is-err">
                <i class="ph-fill ph-warning-octagon"></i>
                <div class="sfm-alert-bd">@errorMessage</div>
                <button type="button" class="sfm-alert-x" @onclick="() => errorMessage = null" aria-label="Dismiss">
                    <i class="ph ph-x"></i>
                </button>
            </div>
        }

        <div class="sfm-grid">
            <div class="sfm-main">

                <!-- ── Customer ───────────────────────────────────────── -->
                <section class="sfm-card">
                    <div class="sfm-card-hd">
                        <i class="ph ph-user-circle"></i>
                        <h2>Customer</h2>
                        <span class="sfm-spacer"></span>
                        <span class="sfm-note">@allBusinessPartners.Count.ToString("N0") cached</span>
                    </div>
                    <div class="sfm-card-bd sfm-fields">
                        @* Not a <label>: the field carries a result list, and a label would
                           forward stray clicks on it back to the input. *@
                        <div class="sfm-lab sfm-span2">
                            <span class="sfm-lab-t">Customer <span class="sfm-req">*</span></span>
                            <div class="sfm-combo">
                                <input class="sfm-input @(validationErrors.ContainsKey("CardCode") ? "is-bad" : "")"
                                       value="@bpSearchTerm" @oninput="OnBpSearchInput"
                                       @onfocus="() => showBpDropdown = true" @onblur="HandleBpBlur"
                                       placeholder="Search by code or name&hellip;" autocomplete="off" />
                                @if (isBpLoading)
                                {
                                    <span class="sfm-combo-clear"><span class="sfm-spin"></span></span>
                                }
                                @if (showBpDropdown && filteredBusinessPartners?.Any() == true)
                                {
                                    <div class="sfm-drop is-wide">
                                        @foreach (var bp in filteredBusinessPartners.Take(20))
                                        {
                                            <button type="button" class="sfm-drop-i"
                                                    @onmousedown:preventDefault="true"
                                                    @onmousedown="() => SelectBusinessPartner(bp)">
                                                <span>
                                                    <span class="sfm-drop-code">@bp.CardCode</span>
                                                    <span class="sfm-drop-sub">@bp.CardName</span>
                                                </span>
                                                @if (bp.Balance > 0)
                                                {
                                                    <span class="sfm-drop-price">
                                                        @bp.Balance?.ToString("N2")
                                                        <small>balance</small>
                                                    </span>
                                                }
                                            </button>
                                        }
                                    </div>
                                }
                            </div>
                            @if (validationErrors.ContainsKey("CardCode"))
                            {
                                <div class="sfm-field-err">@validationErrors["CardCode"]</div>
                            }
                            @if (selectedBusinessPartner != null)
                            {
                                <div class="sfm-field-meta">
                                    <i class="ph-fill ph-check-circle"></i>@selectedBusinessPartner.CardCode
                                    &mdash; @selectedBusinessPartner.CardName
                                    @if (!string.IsNullOrEmpty(selectedBusinessPartner.Currency))
                                    {
                                        <span> &middot; @selectedBusinessPartner.Currency</span>
                                    }
                                </div>
                            }
                        </div>
                        <label class="sfm-lab">
                            @* A native date input rather than MudDatePicker: it themes from this
                               sheet, and opens the platform picker. It shows the operator's own
                               locale format, not AppSettings.DateFormat — the browser owns that. *@
                            <span class="sfm-lab-t">Document date</span>
                            <input type="date" class="sfm-input" @bind="docDate" />
                        </label>
                        <label class="sfm-lab sfm-span3">
                            <span class="sfm-lab-t">Remarks</span>
                            <input class="sfm-input" @bind="remarks" placeholder="Optional payment remarks&hellip;" />
                        </label>
                    </div>
                </section>

                <!-- ── Payment method ─────────────────────────────────── -->
                <section class="sfm-card">
                    <div class="sfm-card-hd">
                        <i class="ph ph-wallet"></i>
                        <h2>Payment method</h2>
                        <span class="sfm-spacer"></span>
                        <span class="sfm-note">@PaymentMethodLabel</span>
                    </div>
                    <div class="sfm-card-bd">
                        @if (validationErrors.ContainsKey("PaymentAmount"))
                        {
                            <div class="sfm-alert is-err">
                                <i class="ph-fill ph-warning-octagon"></i>
                                <div class="sfm-alert-bd">@validationErrors["PaymentAmount"]</div>
                            </div>
                        }

                        @* A segmented control rather than a select: there are four, they are the
                           form's main branch, and which one is chosen decides the fields below. *@
                        <div class="sfm-seg">
                            @foreach (var methodKey in AvailablePaymentMethods)
                            {
                                if (AllPaymentMethods.TryGetValue(methodKey, out var info))
                                {
                                    <button type="button" class="sfm-seg-i @(activePaymentMethod == methodKey ? "is-on" : "")"
                                            @onclick="() => SetPaymentMethod(info.Type)">
                                        <i class="@info.Icon"></i>@info.Label
                                    </button>
                                }
                            }
                        </div>

                        <div class="sfm-fields sfm-gap-md">
                            @if (activePaymentMethod == "cash")
                            {
                                <label class="sfm-lab sfm-span2">
                                    <span class="sfm-lab-t">Cash amount</span>
                                    <input type="number" step="0.01" min="0" class="sfm-input"
                                           placeholder="0.00" @bind="cashSum" />
                                </label>
                            }
                            else if (activePaymentMethod == "transfer")
                            {
                                <label class="sfm-lab">
                                    <span class="sfm-lab-t">Transfer amount</span>
                                    <input type="number" step="0.01" min="0" class="sfm-input"
                                           placeholder="0.00" @bind="transferSum" />
                                </label>
                                <label class="sfm-lab">
                                    <span class="sfm-lab-t">Reference number</span>
                                    <input class="sfm-input" placeholder="Transfer reference" @bind="transferReference" />
                                </label>
                                <label class="sfm-lab">
                                    <span class="sfm-lab-t">Transfer date</span>
                                    <input type="date" class="sfm-input" @bind="transferDate" />
                                </label>
                            }
                            else if (activePaymentMethod == "check")
                            {
                                <label class="sfm-lab">
                                    <span class="sfm-lab-t">Check amount</span>
                                    <input type="number" step="0.01" min="0" class="sfm-input"
                                           placeholder="0.00" @bind="checkSum" />
                                </label>
                                <label class="sfm-lab">
                                    <span class="sfm-lab-t">Check number</span>
                                    <input type="number" class="sfm-input" placeholder="Check #" @bind="checkNumber" />
                                </label>
                                <label class="sfm-lab">
                                    <span class="sfm-lab-t">Due date</span>
                                    <input type="date" class="sfm-input" @bind="checkDueDate" />
                                </label>
                                <label class="sfm-lab">
                                    <span class="sfm-lab-t">Bank code</span>
                                    <input class="sfm-input" placeholder="Bank code" @bind="checkBankCode" />
                                </label>
                                <label class="sfm-lab">
                                    <span class="sfm-lab-t">Branch</span>
                                    <input class="sfm-input" placeholder="Branch" @bind="checkBranch" />
                                </label>
                                <label class="sfm-lab">
                                    <span class="sfm-lab-t">Account number</span>
                                    <input class="sfm-input" placeholder="Account #" @bind="checkAccountNum" />
                                </label>
                            }
                            else if (activePaymentMethod == "credit")
                            {
                                <label class="sfm-lab">
                                    <span class="sfm-lab-t">Credit amount</span>
                                    <input type="number" step="0.01" min="0" class="sfm-input"
                                           placeholder="0.00" @bind="creditSum" />
                                </label>
                                <label class="sfm-lab">
                                    <span class="sfm-lab-t">Card number (last 4)</span>
                                    <input class="sfm-input" maxlength="4" placeholder="XXXX" @bind="creditCardNumber" />
                                </label>
                                <label class="sfm-lab">
                                    <span class="sfm-lab-t">Valid until</span>
                                    <input class="sfm-input" placeholder="MM/YY" @bind="creditCardValidUntil" />
                                </label>
                                <label class="sfm-lab">
                                    <span class="sfm-lab-t">Voucher number</span>
                                    <input class="sfm-input" placeholder="Voucher #" @bind="creditVoucherNum" />
                                </label>
                            }
                        </div>
                    </div>
                </section>

                <!-- ── Applied invoices ───────────────────────────────── -->
                <section class="sfm-card">
                    <div class="sfm-card-hd">
                        <i class="ph ph-receipt"></i>
                        <h2>Apply to invoices</h2>
                        <span class="sfm-spacer"></span>
                        <span class="sfm-note">Optional</span>
                        <span class="sfm-count">@invoiceLines.Count</span>
                    </div>
                    <div class="sfm-lines">
                        <div class="sfm-lines-inner">
                            @if (invoiceLines.Count == 0)
                            {
                                <div class="sfm-info-note">
                                    <i class="ph ph-info"></i>
                                    <div>
                                        Nothing applied yet. A payment with no invoices named is recorded
                                        on account, which is a valid outcome &mdash; add rows only to settle
                                        specific documents.
                                    </div>
                                </div>
                                <button type="button" class="sfm-addline" @onclick="AddInvoiceLine">
                                    <i class="ph ph-plus"></i>Apply to an invoice
                                </button>
                            }
                            else
                            {
                                <div class="sfm-row is-head">
                                    <div>#</div>
                                    <div>Doc entry</div>
                                    <div class="sfm-r">Amount applied</div>
                                    <div>Invoice type</div>
                                    <div></div>
                                </div>

                                @for (int i = 0; i < invoiceLines.Count; i++)
                                {
                                    var index = i;
                                    var lineErrors = GetInvoiceLineErrors(index);

                                    <div class="sfm-row">
                                        <div class="sfm-n">@(index + 1)</div>
                                        <input type="number"
                                               class="sfm-input sfm-cell @(lineErrors.ContainsKey("DocEntry") ? "is-bad" : "")"
                                               placeholder="DocEntry" @bind="invoiceLines[index].DocEntry" />
                                        <input type="number" step="0.01" min="0"
                                               class="sfm-input sfm-num @(lineErrors.ContainsKey("SumApplied") ? "is-bad" : "")"
                                               placeholder="0.00" @bind="invoiceLines[index].SumApplied" />
                                        <select class="sfm-select sfm-cell" @bind="invoiceLines[index].InvoiceType">
                                            <option value="it_Invoice">Invoice</option>
                                            <option value="it_DownPayment">Down payment</option>
                                        </select>
                                        @* The glyph is drawn inline, not set in the icon font: it is this
                                           button's only label, so a font that fails to load would leave an
                                           empty square that reads as a broken control. *@
                                        <button type="button" class="sfm-btn-x" title="Remove invoice"
                                                aria-label="Remove invoice @(index + 1)"
                                                @onclick="() => RemoveInvoiceLine(index)">
                                            <svg viewBox="0 0 256 256" aria-hidden="true" focusable="false">
                                                <path d="M205.66,194.34a8,8,0,0,1-11.32,11.32L128,139.31,61.66,205.66a8,8,0,0,1-11.32-11.32L116.69,128,50.34,61.66A8,8,0,0,1,61.66,50.34L128,116.69l66.34-66.35a8,8,0,0,1,11.32,11.32L139.31,128Z" />
                                            </svg>
                                        </button>
                                        @if (lineErrors.Any())
                                        {
                                            <div class="sfm-row-err">@string.Join(" · ", lineErrors.Values)</div>
                                        }
                                    </div>
                                }

                                <button type="button" class="sfm-addline" @onclick="AddInvoiceLine">
                                    <i class="ph ph-plus"></i>Apply to another invoice
                                </button>
                            }
                        </div>
                    </div>
                </section>

                <!-- ── Attachment ─────────────────────────────────────── -->
                <section class="sfm-card">
                    <div class="sfm-card-hd">
                        <i class="ph ph-paperclip"></i>
                        <h2>Attachment <span class="sfm-req">*</span></h2>
                        <span class="sfm-spacer"></span>
                        @if (paymentAttachment != null)
                        {
                            <span class="sfm-tag">Uploaded</span>
                        }
                    </div>
                    <div class="sfm-card-bd">
                        @if (validationErrors.ContainsKey("Attachment"))
                        {
                            <div class="sfm-alert is-err">
                                <i class="ph-fill ph-warning-octagon"></i>
                                <div class="sfm-alert-bd">@validationErrors["Attachment"]</div>
                            </div>
                        }

                        <label class="sfm-upload @(paymentAttachment != null ? "has-file" : "")">
                            @* The label is the drop zone; the input is hidden visually but
                               stays in the tab order, and .sfm-upload:focus-within draws its
                               focus ring. See the sheet. *@
                            <InputFile OnChange="OnAttachmentSelected" accept=".pdf,.jpg,.jpeg,.png,.webp" />
                            <span class="sfm-upload-i">
                                <i class="ph @(paymentAttachment != null ? "ph-file-text" : "ph-cloud-arrow-up")"></i>
                            </span>
                            <span class="sfm-upload-t">
                                @(paymentAttachment != null ? "Click to replace file" : "Click to upload proof of payment")
                            </span>
                            <span class="sfm-upload-x">PDF, JPEG, PNG or WebP &mdash; max 20 MB</span>
                        </label>

                        @if (paymentAttachment != null)
                        {
                            <div class="sfm-file">
                                <i class="ph @(paymentAttachment.ContentType.Contains("pdf") ? "ph-file-pdf" : "ph-file-image") sfm-file-i"></i>
                                <div class="sfm-file-bd">
                                    <div class="sfm-file-n">@paymentAttachment.Name</div>
                                    <div class="sfm-file-s">@FormatFileSize(paymentAttachment.Size)</div>
                                </div>
                                <button type="button" class="sfm-btn-x" title="Remove attachment"
                                        aria-label="Remove attachment" @onclick="RemoveAttachment">
                                    <svg viewBox="0 0 256 256" aria-hidden="true" focusable="false">
                                        <path d="M205.66,194.34a8,8,0,0,1-11.32,11.32L128,139.31,61.66,205.66a8,8,0,0,1-11.32-11.32L116.69,128,50.34,61.66A8,8,0,0,1,61.66,50.34L128,116.69l66.34-66.35a8,8,0,0,1,11.32,11.32L139.31,128Z" />
                                    </svg>
                                </button>
                            </div>
                        }
                    </div>
                </section>
            </div>

            <!-- ── Aside ──────────────────────────────────────────────── -->
            <aside class="sfm-aside">
                <div class="sfm-card sfm-total-card">
                    <div class="sfm-total-hd">
                        <span class="sfm-total-k">Total payment</span>
                        <span class="sfm-total-cur">@(selectedBusinessPartner?.Currency ?? "")</span>
                    </div>
                    <div class="sfm-total-v @(IsOverApplied ? "is-over" : "")">@TotalPayment.ToString("N2")</div>

                    <div class="sfm-sum-rule"></div>
                    <div class="sfm-sum @(cashSum > 0 ? "" : "is-zero")">
                        <span class="sfm-sum-k"><i class="ph ph-money"></i>Cash</span>
                        <span class="sfm-sum-v">@cashSum.ToString("N2")</span>
                    </div>
                    <div class="sfm-sum @(transferSum > 0 ? "" : "is-zero")">
                        <span class="sfm-sum-k"><i class="ph ph-bank"></i>Transfer</span>
                        <span class="sfm-sum-v">@transferSum.ToString("N2")</span>
                    </div>
                    <div class="sfm-sum @(checkSum > 0 ? "" : "is-zero")">
                        <span class="sfm-sum-k"><i class="ph ph-check-square"></i>Check</span>
                        <span class="sfm-sum-v">@checkSum.ToString("N2")</span>
                    </div>
                    <div class="sfm-sum @(creditSum > 0 ? "" : "is-zero")">
                        <span class="sfm-sum-k"><i class="ph ph-credit-card"></i>Credit</span>
                        <span class="sfm-sum-v">@creditSum.ToString("N2")</span>
                    </div>

                    @if (AppliedTotal > 0)
                    {
                        <div class="sfm-sum-rule"></div>
                        <div class="sfm-sum">
                            <span class="sfm-sum-k">Applied to invoices</span>
                            <span class="sfm-sum-v">@AppliedTotal.ToString("N2")</span>
                        </div>
                        <div class="sfm-total-sub">
                            @invoiceLines.Count(l => l.DocEntry > 0) invoice(s)
                            @if (IsOverApplied)
                            {
                                <span> &middot; more than the payment covers</span>
                            }
                        </div>
                    }

                    <button type="button" class="sfm-btn-solid sfm-gap-md" @onclick="SubmitPayment"
                            disabled="@isSubmitting">
                        @if (isSubmitting)
                        {
                            <span class="sfm-spin on-solid"></span>
                            <span>Creating&hellip;</span>
                        }
                        else
                        {
                            <i class="ph-fill ph-check-circle"></i>
                            <span>Create payment</span>
                        }
                    </button>
                    <button type="button" class="sfm-btn sfm-btn-wide sfm-btn-danger sfm-gap-sm"
                            @onclick="ClearForm" disabled="@isSubmitting">
                        <i class="ph ph-arrow-counter-clockwise"></i>Clear form
                    </button>
                </div>

                <div class="sfm-card sfm-panel">
                    <div class="sfm-card-hd">
                        <i class="ph ph-shield-check"></i>
                        <span class="sfm-panel-t">Pre-flight checks</span>
                        <span class="sfm-spacer"></span>
                        <span class="sfm-note">@PassedCheckCount/4</span>
                    </div>
                    <div class="sfm-checks">
                        <div class="sfm-checks-i @(HasCustomer ? "" : "is-no")">
                            <span class="sfm-checks-ic"><i class="ph-fill @(HasCustomer ? "ph-check" : "ph-x")"></i></span>
                            <span>Customer selected</span>
                        </div>
                        <div class="sfm-checks-i @(HasAmount ? "" : "is-no")">
                            <span class="sfm-checks-ic"><i class="ph-fill @(HasAmount ? "ph-check" : "ph-x")"></i></span>
                            <span>Payment amount entered</span>
                        </div>
                        <div class="sfm-checks-i @(HasMethodDetails ? "" : "is-no")">
                            <span class="sfm-checks-ic"><i class="ph-fill @(HasMethodDetails ? "ph-check" : "ph-x")"></i></span>
                            <span>Method details filled</span>
                        </div>
                        <div class="sfm-checks-i @(HasAttachment ? "" : "is-no")">
                            <span class="sfm-checks-ic"><i class="ph-fill @(HasAttachment ? "ph-check" : "ph-x")"></i></span>
                            <span>Attachment uploaded</span>
                        </div>
                    </div>
                </div>

                <div class="sfm-card sfm-panel">
                    <div class="sfm-info-note">
                        <i class="ph ph-info"></i>
                        <div>
                            Payments post directly to SAP Business One. Check the details before
                            submitting &mdash; a posted receipt is reversed there, not here.
                        </div>
                    </div>
                </div>
            </aside>
        </div>
    </div>
</div>

@code {
    // State
    private bool isSubmitting = false;
    // Stable idempotency key for the current payment entry. Reused across failure retries so a
    // lost-response retry is deduplicated; regenerated in ClearForm() once a payment succeeds.
    private string clientRequestId = Guid.NewGuid().ToString("N");
    private string? successMessage;
    private string? errorMessage;

    // Business partner
    private List<BusinessPartnerDto> allBusinessPartners = new();
    private string defaultGLAccount = "";
    private BusinessPartnerDto? selectedBusinessPartner;
    private string bpSearchTerm = "";
    private bool showBpDropdown = false;
    private bool isBpLoading = false;
#pragma warning disable CS0414 // assigned but never read
    private bool bpLoadedFromCache = false;
#pragma warning restore CS0414
    private CancellationTokenSource? _searchCts;

    // Payment fields
    private DateTime? docDate = DateTime.Today;
    private string? remarks;
    private string activePaymentMethod = "cash";

    private static readonly Dictionary<string, (string Label, string Icon, PaymentMethodType Type)> AllPaymentMethods =
new()
    {
        // Phosphor classes, not Bootstrap's: the page renders these straight into
        // class= and the rest of the module is on Phosphor.
        { "cash", ("Cash", "ph ph-money", PaymentMethodType.Cash) },
        { "transfer", ("Transfer", "ph ph-bank", PaymentMethodType.Transfer) },
        { "check", ("Check", "ph ph-check-square", PaymentMethodType.Check) },
        { "credit", ("Credit Card", "ph ph-credit-card", PaymentMethodType.Credit) }
    };

    private List<string> AvailablePaymentMethods => AllPaymentMethods.Keys.ToList();

    private string PaymentMethodLabel => activePaymentMethod switch
    {
        "cash" => "Cash",
        "transfer" => "Transfer",
        "check" => "Check",
        "credit" => "Credit Card",
        _ => "Cash"
    };

    private enum PaymentMethodType { Cash, Transfer, Check, Credit }

    private void SetPaymentMethod(PaymentMethodType method) => activePaymentMethod = method switch
    {
        PaymentMethodType.Cash => "cash",
        PaymentMethodType.Transfer => "transfer",
        PaymentMethodType.Check => "check",
        PaymentMethodType.Credit => "credit",
        _ => "cash"
    };

    private Dictionary<string, string> GetInvoiceLineErrors(int index)
        => invoiceValidationErrors.TryGetValue(index, out var errors)
            ? errors
            : new Dictionary<string, string>();

    // ── Pre-flight checks ───────────────────────────────
    // Stated in the aside so the operator sees what is still missing before
    // pressing Create, rather than after the round trip. The method-details
    // check mirrors the server's own rule: only a transfer requires a
    // reference, so the other three methods pass it by having nothing to fill.

    private bool HasCustomer => selectedBusinessPartner != null
        || !string.IsNullOrWhiteSpace(bpSearchTerm);

    private bool HasAmount => TotalPayment > 0;

    private bool HasMethodDetails =>
        activePaymentMethod != "transfer" || !string.IsNullOrWhiteSpace(transferReference);

    private bool HasAttachment => paymentAttachment != null;

    private int PassedCheckCount =>
        (HasCustomer ? 1 : 0) + (HasAmount ? 1 : 0)
        + (HasMethodDetails ? 1 : 0) + (HasAttachment ? 1 : 0);

    private decimal AppliedTotal => invoiceLines.Sum(l => l.SumApplied);

    // Not blocked, and not an error: SAP puts the difference on account. It is
    // stated because it is never what the operator meant to do.
    private bool IsOverApplied => AppliedTotal > TotalPayment;

    // Cash
    private decimal cashSum;
    private string? cashAccount;

    // Transfer
    private decimal transferSum;
    private string? transferReference;
    private DateTime? transferDate;
    private string? transferAccount;

    // Check
    private decimal checkSum;
    private int checkNumber;
    private DateTime? checkDueDate;
    private string? checkBankCode;
    private string? checkBranch;
    private string? checkAccountNum;

    // Credit card
    private decimal creditSum;
    private string? creditCardNumber;
    private string? creditCardValidUntil;
    private string? creditVoucherNum;

    // Invoice lines
    private List<InvoiceLineModel> invoiceLines = new();

    // Attachment (mandatory)
    private IBrowserFile? paymentAttachment;

    // Validation
    private Dictionary<string, string> validationErrors = new();
    private Dictionary<int, Dictionary<string, string>> invoiceValidationErrors = new();

    private decimal TotalPayment => cashSum + transferSum + checkSum + creditSum;

    private IEnumerable<BusinessPartnerDto>? filteredBusinessPartners =>
    string.IsNullOrWhiteSpace(bpSearchTerm) ? allBusinessPartners :
    allBusinessPartners.Where(bp =>
    (bp.CardCode?.Contains(bpSearchTerm, StringComparison.OrdinalIgnoreCase) ?? false) ||
    (bp.CardName?.Contains(bpSearchTerm, StringComparison.OrdinalIgnoreCase) ?? false));

    protected override void OnInitialized()
    {
        // Load payment settings (G/L account + default method)
        _ = LoadPaymentSettings();
        // Load cached business partners in the background (non-blocking)
        _ = LoadBusinessPartnersInBackground();
    }

    private async Task LoadPaymentSettings()
    {
        try
        {
            // The G/L account to post against comes from Settings and is the same for everyone
            var glAccount = await AppSettingsService.GetValueAsync(SettingKeys.IncomingPaymentGLAccount);
            defaultGLAccount = glAccount ?? "";

            // Pre-fill GL account fields
            if (!string.IsNullOrEmpty(defaultGLAccount))
            {
                cashAccount = defaultGLAccount;
                transferAccount = defaultGLAccount;
            }

            // Load default payment method
            var method = await AppSettingsService.GetValueAsync(SettingKeys.DefaultPaymentMethod);
            if (!string.IsNullOrEmpty(method))
            {
                activePaymentMethod = method;
            }

            // Ensure active method is within user's allowed methods
            var avail = AvailablePaymentMethods;
            if (avail.Count > 0 && !avail.Contains(activePaymentMethod))
            {
                activePaymentMethod = avail[0];
            }

            await InvokeAsync(StateHasChanged);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error loading payment settings");
        }
    }

    private async Task LoadBusinessPartnersInBackground()
    {
        try
        {
            isBpLoading = true;

            // Try cached (local DB) first — fast
            var cached = await BusinessPartnerService.GetCachedBusinessPartnersAsync();
            if (cached?.BusinessPartners?.Any() == true)
            {
                allBusinessPartners = cached.BusinessPartners
                .Where(bp => bp.CardType == "cCustomer" || bp.CardType == "C")
                .ToList();

                if (!allBusinessPartners.Any())
                    allBusinessPartners = cached.BusinessPartners;

                bpLoadedFromCache = true;
                isBpLoading = false;
                await InvokeAsync(StateHasChanged);
                return;
            }

            // Fall back to API if cache is empty
            var response = await BusinessPartnerService.GetBusinessPartnersAsync();
            if (response?.BusinessPartners != null)
            {
                allBusinessPartners = response.BusinessPartners
                .Where(bp => bp.CardType == "cCustomer" || bp.CardType == "C")
                .ToList();

                if (!allBusinessPartners.Any() && response.BusinessPartners.Any())
                    allBusinessPartners = response.BusinessPartners;
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error loading business partners");
            // Non-fatal: the user can still type customer codes manually
        }
        finally
        {
            isBpLoading = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task OnBpSearchInput(ChangeEventArgs e)
    {
        bpSearchTerm = e.Value?.ToString() ?? "";
        showBpDropdown = true;

        // If partners not yet loaded, do a debounced search
        if (!allBusinessPartners.Any() && bpSearchTerm.Length >= 2)
        {
            _searchCts?.Cancel();
            _searchCts = new CancellationTokenSource();
            var token = _searchCts.Token;

            try
            {
                isBpLoading = true;
                StateHasChanged();

                await Task.Delay(300, token); // debounce
                if (token.IsCancellationRequested) return;

                var result = await BusinessPartnerService.SearchCachedBusinessPartnersAsync(bpSearchTerm);
                if (result?.BusinessPartners?.Any() != true)
                    result = await BusinessPartnerService.SearchBusinessPartnersAsync(bpSearchTerm);

                if (!token.IsCancellationRequested && result?.BusinessPartners != null)
                {
                    allBusinessPartners = result.BusinessPartners;
                }
            }
            catch (TaskCanceledException) { /* expected on re-type */ }
            catch (Exception ex)
            {
                Logger.LogError(ex, "Error searching business partners");
            }
            finally
            {
                isBpLoading = false;
                await InvokeAsync(StateHasChanged);
            }
        }
    }

    private void SelectBusinessPartner(BusinessPartnerDto bp)
    {
        selectedBusinessPartner = bp;
        bpSearchTerm = bp.DisplayName;
        showBpDropdown = false;
    }

    private async Task HandleBpBlur()
    {
        // Small delay to allow click events on dropdown items
        await Task.Delay(200);
        showBpDropdown = false;
    }

    private void AddInvoiceLine()
    {
        invoiceLines.Add(new InvoiceLineModel());
    }

    private void RemoveInvoiceLine(int index)
    {
        if (index >= 0 && index < invoiceLines.Count)
        {
            invoiceLines.RemoveAt(index);
            invoiceValidationErrors.Remove(index);
        }
    }

    private bool ValidateForm()
    {
        validationErrors.Clear();
        invoiceValidationErrors.Clear();

        // Customer validation
        if (selectedBusinessPartner == null && string.IsNullOrWhiteSpace(bpSearchTerm))
        {
            validationErrors["CardCode"] = "Please select a customer";
        }

        // Payment amount validation
        if (TotalPayment <= 0)
        {
            validationErrors["PaymentAmount"] = "At least one payment amount must be greater than zero";
        }

        // Validate negative amounts
        if (cashSum < 0) validationErrors["PaymentAmount"] = "Cash amount cannot be negative";
        if (transferSum < 0) validationErrors["PaymentAmount"] = "Transfer amount cannot be negative";
        if (checkSum < 0) validationErrors["PaymentAmount"] = "Check amount cannot be negative";
        if (creditSum < 0) validationErrors["PaymentAmount"] = "Credit card amount cannot be negative";

        // Attachment validation - mandatory
        if (paymentAttachment == null)
        {
            validationErrors["Attachment"] = "An attachment is required to create a payment";
        }
        else if (paymentAttachment.Size > 20 * 1024 * 1024)
        {
            validationErrors["Attachment"] = "Attachment is too large. Maximum size is 20MB";
        }

        // Validate invoice lines
        for (int i = 0; i < invoiceLines.Count; i++)
        {
            var errors = new Dictionary<string, string>();
            if (invoiceLines[i].DocEntry <= 0)
            {
                errors["DocEntry"] = "Invoice DocEntry is required";
            }
            if (invoiceLines[i].SumApplied <= 0)
            {
                errors["SumApplied"] = "Amount applied must be greater than zero";
            }
            if (errors.Count > 0)
            {
                invoiceValidationErrors[i] = errors;
            }
        }

        StateHasChanged();
        return validationErrors.Count == 0 && invoiceValidationErrors.Count == 0;
    }

    private async Task SubmitPayment()
    {
        errorMessage = null;
        successMessage = null;

        if (!ValidateForm())
        {
            errorMessage = "Please fix the validation errors before submitting.";
            return;
        }

        isSubmitting = true;

        try
        {
            var cardCode = selectedBusinessPartner?.CardCode ?? bpSearchTerm?.Trim();

            var request = new CreateIncomingPaymentRequest
            {
                CardCode = cardCode,
                DocDate = docDate?.ToString("yyyy-MM-dd"),
                Remarks = remarks,
                CashSum = cashSum,
                CashAccount = cashAccount,
                TransferSum = transferSum,
                TransferReference = transferReference,
                TransferDate = transferDate?.ToString("yyyy-MM-dd"),
                TransferAccount = transferAccount,
                CheckSum = checkSum,
                CreditSum = creditSum,
                ClientRequestId = clientRequestId
            };

            // Add invoice lines if any
            if (invoiceLines.Any(l => l.DocEntry > 0))
            {
                request.PaymentInvoices = invoiceLines
                .Where(l => l.DocEntry > 0)
                .Select(l => new PaymentInvoiceRequest
                {
                    DocEntry = l.DocEntry,
                    SumApplied = l.SumApplied,
                    InvoiceType = l.InvoiceType
                }).ToList();
            }

            // Add check details if paying by check
            if (checkSum > 0 && checkNumber > 0)
            {
                request.PaymentChecks = new List<PaymentCheckRequest>
{
new PaymentCheckRequest
{
CheckNumber = checkNumber,
CheckSum = checkSum,
DueDate = checkDueDate?.ToString("yyyy-MM-dd"),
BankCode = checkBankCode,
Branch = checkBranch,
AccountNum = checkAccountNum
}
};
            }

            // Add credit card details if paying by credit card
            if (creditSum > 0)
            {
                request.PaymentCreditCards = new List<PaymentCreditCardRequest>
{
new PaymentCreditCardRequest
{
CreditSum = creditSum,
CreditCardNumber = creditCardNumber,
CardValidUntil = creditCardValidUntil,
VoucherNum = creditVoucherNum
}
};
            }

            Logger.LogInformation("Creating incoming payment for customer {CardCode}, Total: {Total}",
            cardCode, TotalPayment);

            var (success, message, payment) = await PaymentService.CreatePaymentAsync(request);

            if (success)
            {
                // Upload the mandatory attachment
                if (paymentAttachment != null && payment?.DocEntry > 0)
                {
                    try
                    {
                        using var attachStream = paymentAttachment.OpenReadStream(maxAllowedSize: 20 * 1024 * 1024);
                        var (attachSuccess, attachMsg) = await PaymentService.UploadPaymentAttachmentAsync(
                            payment.DocEntry, attachStream, paymentAttachment.Name, paymentAttachment.ContentType,
                            $"Payment #{payment.DocNum} attachment");

                        if (!attachSuccess)
                        {
                            Logger.LogWarning("Payment created but attachment upload failed: {Message}", attachMsg);
                        }
                    }
                    catch (Exception attachEx)
                    {
                        Logger.LogError(attachEx, "Error uploading attachment for payment #{DocNum}", payment.DocNum);
                    }
                }

                Logger.LogInformation("Incoming payment #{DocNum} (DocEntry: {DocEntry}) created successfully",
                payment?.DocNum, payment?.DocEntry);
                successMessage = $"Payment #{payment?.DocNum} created successfully! Total: {payment?.DocTotal:N2}";
                // Audit log: payment created
                await AuditService.LogAsync(AuditActions.CreatePayment, "Payment", payment?.DocNum.ToString());
                ClearForm();
            }
            else
            {
                Logger.LogError("Failed to create incoming payment. Error: {Error}", message);
                if (message != null && message.Contains("controlling type account", StringComparison.OrdinalIgnoreCase))
                {
                    errorMessage = "The configured G/L account is a controlling account and cannot be used for payments. Please ask an admin to select a cash or bank account in Settings.";
                }
                else
                {
                    errorMessage = message;
                }
                // Audit log: payment creation failed
                await AuditService.LogAsync(AuditActions.CreatePayment, "Payment", cardCode, null, false, errorMessage);
            }
        }
        catch (HttpRequestException httpEx)
        {
            Logger.LogError(httpEx, "HTTP error creating incoming payment");
            errorMessage = ShopInventory.Web.Services.ApiErrorResponse.GetFriendlyMessage(
                httpEx,
                "We couldn't create this incoming payment right now. Please try again.");
        }
        catch (TaskCanceledException tcEx) when (tcEx.InnerException is TimeoutException)
        {
            Logger.LogError(tcEx, "Timeout creating incoming payment");
            errorMessage = "Request timed out. The server may be busy, please try again.";
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Unexpected error creating incoming payment");
            errorMessage = ShopInventory.Web.Services.ApiErrorResponse.GetFriendlyMessage(
                ex,
                "We couldn't create this incoming payment right now. Please try again.");
        }
        finally
        {
            isSubmitting = false;
        }
    }

    private void ClearForm()
    {
        // New payment entry gets a fresh idempotency key so it is not treated as a retry of the last one.
        clientRequestId = Guid.NewGuid().ToString("N");
        selectedBusinessPartner = null;
        bpSearchTerm = "";
        docDate = DateTime.Today;
        remarks = null;

        cashSum = 0;
        cashAccount = defaultGLAccount;
        transferSum = 0;
        transferReference = null;
        transferDate = null;
        transferAccount = defaultGLAccount;

        checkSum = 0;
        checkNumber = 0;
        checkDueDate = null;
        checkBankCode = null;
        checkBranch = null;
        checkAccountNum = null;

        creditSum = 0;
        creditCardNumber = null;
        creditCardValidUntil = null;
        creditVoucherNum = null;

        invoiceLines.Clear();
        validationErrors.Clear();
        invoiceValidationErrors.Clear();
        paymentAttachment = null;
    }

    private void OnAttachmentSelected(InputFileChangeEventArgs e)
    {
        paymentAttachment = e.File;
        validationErrors.Remove("Attachment");
    }

    private void RemoveAttachment()
    {
        paymentAttachment = null;
    }

    private static string FormatFileSize(long bytes)
    {
        if (bytes < 1024) return $"{bytes} B";
        if (bytes < 1024 * 1024) return $"{bytes / 1024.0:N1} KB";
        return $"{bytes / (1024.0 * 1024.0):N1} MB";
    }

    private class InvoiceLineModel
    {
        public int DocEntry { get; set; }
        public decimal SumApplied { get; set; }
        public string InvoiceType { get; set; } = "it_Invoice";
    }
}