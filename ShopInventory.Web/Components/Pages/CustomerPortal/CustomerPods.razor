@page "/customer-portal/pods"
@using ShopInventory.Web.Models
@using ShopInventory.Web.Services
@using System.Net.Http.Json
@inject HttpClient Http
@inject ICustomerPortalSessionService CustomerSession
@inject IJSRuntime JSRuntime
@inject ILogger<CustomerPods> Logger
@attribute [AllowAnonymous]
@rendermode InteractiveServer
@layout CustomerPortalLayout

<PageTitle>Proof of delivery - Customer Portal</PageTitle>

@* On the portal's page vocabulary — the `cpd` blocks the dashboard was built
   from; see the Page vocabulary section of customer-portal.css. `cpx` comes
   down from the shell.

   This page used to carry its own teal hero and a 630-line inline stylesheet,
   including a hand-built second copy of the list for phones. Both are gone:
   the hero, the filter panel, the figures and the ledger are the same blocks
   the invoice and payment pages are made of, and `mobile-card-table` turns the
   one table into cards below 992px without a second markup path. *@
<div class="cpd fade-in">
    @if (isLoading && customerInfo == null)
    {
        <div class="cpd-panel">
            <div class="cpd-empty">
                <div class="spinner-border" role="status" style="width: 2.25rem; height: 2.25rem;">
                    <span class="visually-hidden">Loading...</span>
                </div>
                <p class="mt-3 mb-0">Loading proof of delivery records...</p>
            </div>
        </div>
    }
    else if (customerInfo == null)
    {
        <div class="cpd-panel">
            <div class="cpd-empty">
                <i class="ph ph-lock-key"></i>
                <h5>Authentication required</h5>
                <p>Please sign in to see your proof of delivery records.</p>
                <a href="/customer-portal/login" class="btn btn-primary">Sign in to the portal</a>
            </div>
        </div>
    }
    else
    {
        <div class="cpd-hero">
            <div class="cpd-hero-text">
                <h2>Proof of delivery</h2>
                <div class="cpd-hero-meta">
                    <span>@customerInfo.CardName</span>
                    <span>Account @customerInfo.CardCode</span>
                    @if (isMultiAccount)
                    {
                        <span>@AccountScopeCaption()</span>
                    }
                    <span>
                        @(lastUpdated.HasValue
                            ? $"Updated {lastUpdated.Value:MMM dd, yyyy 'at' HH:mm} UTC"
                            : "Not loaded yet")
                    </span>
                </div>
            </div>
            <div class="cpd-hero-actions">
                <a href="/customer-portal/dashboard" class="btn btn-outline-primary">
                    <i class="ph ph-arrow-left"></i> Dashboard
                </a>
                <a href="/customer-portal/invoices" class="btn btn-primary">View invoices</a>
            </div>
        </div>

        @* A failed load is stated in the page's own alert voice and offers the
           retry, rather than being left as a bare sentence where the list would
           have been. *@
        @if (!string.IsNullOrWhiteSpace(loadErrorMessage))
        {
            <div class="cpd-banner" role="alert">
                <i class="ph ph-warning-circle"></i>
                <div class="cpd-banner-text">@loadErrorMessage</div>
                <button type="button" class="btn cpd-banner-action" @onclick="LoadData" disabled="@isLoading">
                    Try again
                </button>
            </div>
        }

        <section class="cpd-panel">
            <div class="cpd-panel-head">
                <h5>Period</h5>
                @if (hasLoaded)
                {
                    <span class="cpd-tag">@TotalCount @Plural(TotalCount, "document")</span>
                }
            </div>
            @* Every control here is one of the portal's own. NocturneDateField keeps the
               shorthand entry FlexibleDatePicker was written for and draws the portal's
               calendar; NocturneSelect draws its menu in page DOM, so the row is one
               height and one palette. See .claude/skills/nocturne-dropdowns-and-dates. *@
            <div class="cpd-filters">
                <div class="cpd-field">
                    <label class="cpd-field-label" for="cpod-f-from">From</label>
                    <NocturneDateField Id="cpod-f-from" @bind-Date="fromDate" AriaLabel="From date" />
                </div>
                <div class="cpd-field">
                    <label class="cpd-field-label" for="cpod-f-to">To</label>
                    <NocturneDateField Id="cpod-f-to" @bind-Date="toDate" AriaLabel="To date" />
                </div>
                @if (isMultiAccount && linkedAccounts.Any())
                {
                    <div class="cpd-field">
                        <label class="cpd-field-label" for="cpod-f-account">Account</label>
                        @* The lambda is not a style choice: passing the method group makes
                           TValue inference fail on an error that names EventCallback. *@
                        <NocturneSelect Id="cpod-f-account" Class="nsel-block" TValue="string"
                                        Options="AccountFilterOptions" Value="@selectedAccountFilter"
                                        ValueChanged="@(code => OnAccountFilterChanged(code ?? string.Empty))"
                                        Caption="Filter by account" AriaLabel="Filter by account"
                                        Placeholder="All accounts" />
                    </div>
                }
                <div class="cpd-field cpd-field-action">
                    <button type="button" class="btn btn-primary" @onclick="LoadData" disabled="@isLoading">
                        @if (isLoading)
                        {
                            <span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>
                            <span>Loading</span>
                        }
                        else
                        {
                            <span>@(hasLoaded ? "Reload PODs" : "Load PODs")</span>
                        }
                    </button>
                </div>
            </div>
        </section>

        @if (hasLoaded)
        {
            @* The list is paged on the server, so only the first figure counts the
               whole period. The three that are read off the page in hand say so in
               their caption, the way the activity log's do. *@
            <section class="cpd-kpis">
                <div class="cpd-kpi">
                    <div class="cpd-kpi-top">
                        <span class="cpd-kpi-label">Documents</span>
                        <i class="ph ph-files"></i>
                    </div>
                    <div class="cpd-kpi-num">@TotalCount</div>
                    <div class="cpd-kpi-sub">@PeriodCaption()</div>
                </div>

                <div class="cpd-kpi">
                    <div class="cpd-kpi-top">
                        <span class="cpd-kpi-label">Invoices covered</span>
                        <i class="ph ph-receipt"></i>
                    </div>
                    <div class="cpd-kpi-num">@PageInvoiceCount</div>
                    <div class="cpd-kpi-sub">@PageScopeCaption()</div>
                </div>

                <div class="cpd-kpi">
                    <div class="cpd-kpi-top">
                        <span class="cpd-kpi-label">Most recent</span>
                        <i class="ph ph-clock-counter-clockwise"></i>
                    </div>
                    <div class="cpd-kpi-num">@(latestUploadedAt?.ToString("MMM dd") ?? "—")</div>
                    <div class="cpd-kpi-sub">@LatestCaption()</div>
                </div>

                <div class="cpd-kpi">
                    <div class="cpd-kpi-top">
                        <span class="cpd-kpi-label">Open in portal</span>
                        <i class="ph ph-eye"></i>
                    </div>
                    <div class="cpd-kpi-num">@PageViewableCount</div>
                    <div class="cpd-kpi-sub">@ViewableCaption()</div>
                </div>
            </section>

            <section class="cpd-panel cpd-ledger">
                <div class="cpd-panel-head">
                    <h5>Delivery confirmations</h5>
                    <span class="cpd-tag">Newest first</span>
                </div>

                @if (PageItems.Any())
                {
                    <div class="table-responsive">
                        <table class="cpd-table mobile-card-table">
                            <thead>
                                <tr>
                                    <th>Invoice</th>
                                    @if (isMultiAccount)
                                    {
                                        <th>Account</th>
                                    }
                                    <th>Document</th>
                                    <th>Description</th>
                                    <th class="cpd-num">Size</th>
                                    <th>Uploaded</th>
                                    <th class="cpd-num">Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var pod in PageItems)
                                {
                                    <tr>
                                        @* One element per cell, not two: below 992px each cell
                                           becomes a labelled grid row, and a second child would
                                           be placed into the label track. *@
                                        <td data-label="Invoice" class="cpd-strong">
                                            @(pod.InvoiceDocNum > 0 ? pod.InvoiceDocNum.ToString() : "—")
                                        </td>
                                        @if (isMultiAccount)
                                        {
                                            <td data-label="Account">
                                                <span class="cpd-doc">
                                                    <span class="cpd-doc-id">@(pod.CardName ?? "—")</span>
                                                    <span class="cpd-doc-sub">@(pod.CardCode ?? "")</span>
                                                </span>
                                            </td>
                                        }
                                        <td data-label="Document">
                                            <span class="cpd-doc">
                                                <span class="cpd-doc-id">@pod.FileName</span>
                                                <span class="cpd-doc-sub">@FileKind(pod.MimeType)</span>
                                            </span>
                                        </td>
                                        <td data-label="Description">
                                            @(string.IsNullOrWhiteSpace(pod.Description) ? "—" : pod.Description)
                                        </td>
                                        <td data-label="Size" class="cpd-num cpd-quiet">@pod.FileSizeFormatted</td>
                                        <td data-label="Uploaded">
                                            <span class="cpd-doc">
                                                <span class="cpd-doc-id">@pod.UploadedAt.ToString("MMM dd, yyyy")</span>
                                                <span class="cpd-doc-sub">@pod.UploadedAt.ToString("HH:mm")</span>
                                            </span>
                                        </td>
                                        <td data-label="Actions" class="cpd-num">
                                            <span class="cpd-rowacts">
                                                @if (IsViewable(pod.MimeType))
                                                {
                                                    <button type="button" class="btn btn-outline-primary btn-sm"
                                                            @onclick="() => ViewPod(pod)">
                                                        <i class="ph ph-eye"></i> View
                                                    </button>
                                                }
                                                <button type="button" class="btn btn-outline-primary btn-sm"
                                                        @onclick="() => DownloadPod(pod)">
                                                    <i class="ph ph-download-simple"></i> Download
                                                </button>
                                            </span>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>

                    @if (TotalPages > 1)
                    {
                        <div class="cpd-pager">
                            <div class="cpd-pager-info">
                                Showing @(((currentPage - 1) * pageSize) + 1)&ndash;@(((currentPage - 1) * pageSize) + PageItems.Count)
                                of @TotalCount @Plural(TotalCount, "document")
                            </div>
                            <nav aria-label="Proof of delivery pages">
                                <ul class="pagination pagination-sm mb-0">
                                    <li class="page-item @(currentPage == 1 ? "disabled" : "")">
                                        <button class="page-link" @onclick="() => GoToPage(currentPage - 1)"
                                                disabled="@(currentPage == 1 || isPaging)" aria-label="Previous page">
                                            <i class="ph ph-caret-left"></i>
                                        </button>
                                    </li>
                                    @foreach (var pg in GetVisiblePages())
                                    {
                                        @if (pg == -1)
                                        {
                                            <li class="page-item disabled"><span class="page-link">&hellip;</span></li>
                                        }
                                        else
                                        {
                                            <li class="page-item @(pg == currentPage ? "active" : "")">
                                                <button class="page-link" @onclick="() => GoToPage(pg)"
                                                        disabled="@isPaging">@pg</button>
                                            </li>
                                        }
                                    }
                                    <li class="page-item @(currentPage == TotalPages ? "disabled" : "")">
                                        <button class="page-link" @onclick="() => GoToPage(currentPage + 1)"
                                                disabled="@(currentPage == TotalPages || isPaging)" aria-label="Next page">
                                            <i class="ph ph-caret-right"></i>
                                        </button>
                                    </li>
                                </ul>
                            </nav>
                        </div>
                    }
                }
                else if (string.IsNullOrWhiteSpace(loadErrorMessage))
                {
                    <div class="cpd-empty">
                        <i class="ph ph-clipboard-text"></i>
                        <h5>No proof of delivery records found</h5>
                        <p>PODs appear here once our team uploads them against your invoices for this period.</p>
                    </div>
                }
            </section>
        }
        else if (string.IsNullOrWhiteSpace(loadErrorMessage))
        {
            <div class="cpd-panel">
                <div class="cpd-empty">
                    <i class="ph ph-truck"></i>
                    <h5>Choose a period</h5>
                    <p>Set the dates above and load the delivery confirmations for your account.</p>
                </div>
            </div>
        }
    }
</div>

@* The document viewer. It renders inside CustomerPortalLayout, so `.cpx` is
   above it and it needs no peer scope class of its own — but it does need `cpd`
   for the page vocabulary, which is what `.cpd-overlay` is scoped under. *@
@if (showViewer)
{
    <div class="cpd cpd-overlay" role="dialog" aria-modal="true" aria-label="Proof of delivery document"
         @onclick="CloseViewer">
        <div class="cpd-sheet cpd-sheet-doc" @onclick:stopPropagation>
            <div class="cpd-sheet-head">
                <i class="ph ph-file-text"></i>
                <h5>@viewerFileName</h5>
                <button type="button" class="cpd-sheet-close" @onclick="CloseViewer" aria-label="Close">
                    <i class="ph ph-x"></i>
                </button>
            </div>

            <div class="cpd-sheet-body">
                @if (isLoadingViewer)
                {
                    <div class="cpd-empty">
                        <div class="spinner-border" role="status" style="width: 2rem; height: 2rem;">
                            <span class="visually-hidden">Loading...</span>
                        </div>
                        <p class="mt-3 mb-0">Opening the document...</p>
                    </div>
                }
                else if (viewerMimeType?.StartsWith("image/") == true)
                {
                    <div class="cpd-stage">
                        <img src="@viewerDataUri" alt="@viewerFileName" />
                    </div>
                }
                else if (viewerMimeType == "application/pdf")
                {
                    <div class="cpd-stage">
                        <iframe src="@viewerDataUri" title="@viewerFileName"></iframe>
                    </div>
                }
                else
                {
                    <div class="cpd-empty">
                        <i class="ph ph-file-dashed"></i>
                        <h5>This document can't be shown here</h5>
                        <p>Download it to open the file on your device.</p>
                    </div>
                }
            </div>

            <div class="cpd-sheet-foot">
                <button type="button" class="btn btn-outline-primary" @onclick="CloseViewer">Close</button>
                <button type="button" class="btn btn-primary" @onclick="() => DownloadPod(viewerPod!)"
                        disabled="@(viewerPod is null)">
                    Download
                </button>
            </div>
        </div>
    </div>
}

@code {
    private CustomerPortalSession? portalSession;
    private CustomerInfo? customerInfo;
    private PodAttachmentListResponse? podResponse;
    private bool isLoading = true;
    private bool isPaging;
    private bool hasLoaded = false;
    private int currentPage = 1;
    private const int pageSize = 20;
    private DateTime? fromDate = DateTime.Today.AddMonths(-3);
    private DateTime? toDate = DateTime.Today;
    private bool isMultiAccount;
    private string selectedAccountFilter = "";
    private List<LinkedAccountInfo> linkedAccounts = new();
    private string? loadErrorMessage;
    private DateTime? lastUpdated;

    // Computed rather than static: the list arrives with the session.
    private IEnumerable<NocturneSelectOption<string>> AccountFilterOptions =>
        PortalFilterOptions.Accounts(linkedAccounts);

    // The newest upload in the whole period, not merely on the page in hand: the
    // API orders newest first, so page one carries it, and paging never changes
    // the filter that produced it.
    private DateTime? latestUploadedAt;
    private int latestInvoiceDocNum;

    // Viewer state
    private bool showViewer;
    private bool isLoadingViewer;
    private string? viewerDataUri;
    private string? viewerFileName;
    private string? viewerMimeType;
    private PodAttachmentItemDto? viewerPod;

    private List<PodAttachmentItemDto> PageItems => podResponse?.Items ?? new List<PodAttachmentItemDto>();

    private int TotalCount => podResponse?.TotalCount ?? 0;

    private int TotalPages => TotalCount <= 0 ? 1 : (int)Math.Ceiling(TotalCount / (double)pageSize);

    private int PageInvoiceCount => PageItems.Select(p => p.InvoiceDocEntry).Distinct().Count();

    private int PageViewableCount => PageItems.Count(p => IsViewable(p.MimeType));

    protected override async Task OnInitializedAsync()
    {
        // Loading here rather than in OnAfterRender starts the fetch before the first render
        // instead of after it. The guard keeps the session read off any non-interactive pass;
        // see CustomerPortalLayout for why it is here even though prerendering is off.
        if (!RendererInfo.IsInteractive)
        {
            return;
        }

        await LoadCustomerInfo();

        if (customerInfo != null)
        {
            await LoadData();
        }
        else
        {
            isLoading = false;
        }
    }

    private async Task LoadCustomerInfo()
    {
        try
        {
            portalSession = await CustomerSession.GetCurrentSessionAsync();
            customerInfo = portalSession?.Customer;

            if (customerInfo != null)
            {
                isMultiAccount = customerInfo.AccountStructure == "Multi";
                linkedAccounts = portalSession?.LinkedAccounts.ToList() ?? new List<LinkedAccountInfo>();
                selectedAccountFilter = CustomerSession.CanAccessCardCode(portalSession, selectedAccountFilter)
                    ? selectedAccountFilter
                    : string.Empty;
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error loading customer info");
        }
    }

    private async Task<List<string>> ResolveCardCodesAsync()
    {
        var cardCodes = CustomerSession.ResolveAccessibleCardCodes(portalSession, selectedAccountFilter).ToList();
        if (cardCodes.Count > 0)
        {
            return cardCodes;
        }

        if (!string.IsNullOrEmpty(selectedAccountFilter))
        {
            Logger.LogWarning("Rejected unauthorized customer POD account access {CardCode}", selectedAccountFilter);
            selectedAccountFilter = string.Empty;
        }

        await Task.CompletedTask;
        return new List<string>();
    }

    private static PodAttachmentListResponse CreateEmptyPodResponse(int page, int pageSize)
    {
        return new PodAttachmentListResponse
        {
            Items = new List<PodAttachmentItemDto>(),
            TotalCount = 0,
            Page = page,
            PageSize = pageSize,
            HasMore = false
        };
    }

    private async Task<PodAttachmentListResponse> GetPodsForCurrentScopeAsync(int page)
    {
        var cardCodes = await ResolveCardCodesAsync();
        if (cardCodes.Count == 0)
        {
            loadErrorMessage = "We couldn't determine which account to load PODs for.";
            return CreateEmptyPodResponse(page, pageSize);
        }

        var queryParams = new List<string>
        {
            $"page={page}",
            $"pageSize={pageSize}",
            $"cardCode={Uri.EscapeDataString(string.Join(",", cardCodes))}"
        };

        if (fromDate.HasValue)
        {
            queryParams.Add($"fromDate={fromDate.Value:yyyy-MM-dd}");
        }

        if (toDate.HasValue)
        {
            queryParams.Add($"toDate={toDate.Value:yyyy-MM-dd}");
        }

        var url = $"api/invoice/pods?{string.Join("&", queryParams)}";
        using var response = await Http.GetAsync(url);
        if (!response.IsSuccessStatusCode)
        {
            var errorBody = await response.Content.ReadAsStringAsync();
            Logger.LogWarning(
                "Customer POD API GET {Url} failed with status {StatusCode}. Response: {ResponseBody}",
                url,
                (int)response.StatusCode,
                errorBody);
            loadErrorMessage = "We couldn't load proof of delivery records right now. Please try again.";
            return CreateEmptyPodResponse(page, pageSize);
        }

        var responseModel = await response.Content.ReadFromJsonAsync<PodAttachmentListResponse>();
        if (responseModel == null)
        {
            Logger.LogWarning("Customer POD API GET {Url} returned an empty response body", url);
            loadErrorMessage = "We couldn't read the proof of delivery response. Please try again.";
            return CreateEmptyPodResponse(page, pageSize);
        }

        loadErrorMessage = null;
        return responseModel;
    }

    private async Task<byte[]?> DownloadPodContentAsync(int docEntry, int attachmentId)
    {
        var url = $"api/invoice/{docEntry}/attachments/{attachmentId}/download";
        using var response = await Http.GetAsync(url);
        if (!response.IsSuccessStatusCode)
        {
            var errorBody = await response.Content.ReadAsStringAsync();
            Logger.LogWarning(
                "Customer POD download {Url} failed with status {StatusCode}. Response: {ResponseBody}",
                url,
                (int)response.StatusCode,
                errorBody);
            return null;
        }

        return await response.Content.ReadAsByteArrayAsync();
    }

    private async Task LoadData()
    {
        if (customerInfo == null) return;

        isLoading = true;

        try
        {
            currentPage = 1;
            podResponse = await GetPodsForCurrentScopeAsync(currentPage);
            hasLoaded = true;
            lastUpdated = DateTime.UtcNow;

            // Page one holds the newest row, so this is the period's figure and
            // stays put while the customer pages through the rest.
            var newest = podResponse.Items.FirstOrDefault();
            latestUploadedAt = newest?.UploadedAt;
            latestInvoiceDocNum = newest?.InvoiceDocNum ?? 0;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error loading POD data");
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task LoadPage(int page)
    {
        if (customerInfo == null) return;
        currentPage = page;
        isPaging = true;

        try
        {
            podResponse = await GetPodsForCurrentScopeAsync(currentPage);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error loading POD page {Page}", page);
        }
        finally
        {
            isPaging = false;
        }
    }

    private async Task GoToPage(int page)
    {
        if (page < 1 || page > TotalPages || page == currentPage || isPaging)
        {
            return;
        }

        await LoadPage(page);
    }

    private List<int> GetVisiblePages()
    {
        var pages = new List<int>();
        if (TotalPages <= 7)
        {
            for (int i = 1; i <= TotalPages; i++) pages.Add(i);
            return pages;
        }

        pages.Add(1);
        if (currentPage > 3) pages.Add(-1); // ellipsis

        int start = Math.Max(2, currentPage - 1);
        int end = Math.Min(TotalPages - 1, currentPage + 1);
        for (int i = start; i <= end; i++) pages.Add(i);

        if (currentPage < TotalPages - 2) pages.Add(-1); // ellipsis
        pages.Add(TotalPages);
        return pages;
    }

    private async Task OnAccountFilterChanged(string value)
    {
        if (!CustomerSession.CanAccessCardCode(portalSession, value))
        {
            Logger.LogWarning("Rejected unauthorized customer POD account filter {CardCode}", value);
            selectedAccountFilter = string.Empty;
            return;
        }

        selectedAccountFilter = value;
        await LoadData();
    }

    private static string Plural(int count, string noun) => count == 1 ? noun : noun + "s";

    /// <summary>The period the figures cover, as the filter currently states it.</summary>
    private string PeriodCaption()
    {
        if (fromDate is null && toDate is null) return "Every POD on record";
        if (fromDate is null) return $"Up to {toDate:MMM dd, yyyy}";
        if (toDate is null) return $"Since {fromDate:MMM dd, yyyy}";
        return $"{fromDate:MMM dd, yyyy} – {toDate:MMM dd, yyyy}";
    }

    /// <summary>
    /// Which accounts the list is showing, for a customer whose portal login
    /// reaches more than one.
    /// </summary>
    private string AccountScopeCaption()
    {
        if (string.IsNullOrEmpty(selectedAccountFilter))
        {
            return "All main accounts";
        }

        return linkedAccounts.FirstOrDefault(a => a.CardCode == selectedAccountFilter)?.CardName
            ?? selectedAccountFilter;
    }

    /// <summary>Says outright that a figure counts this page rather than the period.</summary>
    private string PageScopeCaption() =>
        TotalPages > 1 ? $"On page {currentPage} of {TotalPages}" : "In the selected period";

    private string LatestCaption()
    {
        if (latestUploadedAt is not { } uploadedAt)
        {
            return "Nothing in range";
        }

        return latestInvoiceDocNum > 0
            ? $"Invoice {latestInvoiceDocNum} · {uploadedAt:HH:mm}"
            : uploadedAt.ToString("yyyy 'at' HH:mm");
    }

    private string ViewableCaption()
    {
        var pageCount = PageItems.Count;
        if (pageCount == 0)
        {
            return "Nothing to open";
        }

        var downloadOnly = pageCount - PageViewableCount;
        if (downloadOnly == 0)
        {
            return TotalPages > 1 ? "All of this page opens here" : "All of them open here";
        }

        return $"{downloadOnly} {Plural(downloadOnly, "file")} to download instead";
    }

    /// <summary>What the document is, in words, rather than as a MIME type.</summary>
    private static string FileKind(string? mimeType) => mimeType switch
    {
        null or "" => "File",
        "application/pdf" => "PDF document",
        var m when m.StartsWith("image/") => $"{m["image/".Length..].ToUpperInvariant()} image",
        _ => mimeType
    };

    private async Task DownloadPod(PodAttachmentItemDto pod)
    {
        try
        {
            if (!CustomerSession.CanAccessCardCode(portalSession, pod.CardCode))
            {
                Logger.LogWarning("Rejected unauthorized customer POD download {PodId} for {CardCode}", pod.Id, pod.CardCode);
                return;
            }

            var content = await DownloadPodContentAsync(pod.InvoiceDocEntry, pod.Id);
            if (content == null || content.Length == 0)
            {
                return;
            }

            var contentType = pod.MimeType ?? "application/octet-stream";
            await JSRuntime.InvokeVoidAsync("downloadFile", pod.FileName, contentType, Convert.ToBase64String(content));
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error downloading POD {PodId}", pod.Id);
        }
    }

    private static bool IsViewable(string? mimeType) =>
        mimeType != null && (mimeType.StartsWith("image/") || mimeType == "application/pdf");

    private async Task ViewPod(PodAttachmentItemDto pod)
    {
        try
        {
            if (!CustomerSession.CanAccessCardCode(portalSession, pod.CardCode))
            {
                Logger.LogWarning("Rejected unauthorized customer POD view {PodId} for {CardCode}", pod.Id, pod.CardCode);
                return;
            }

            await RevokeViewerDataUriAsync();

            viewerPod = pod;
            viewerFileName = pod.FileName;
            viewerMimeType = pod.MimeType;
            viewerDataUri = null;
            showViewer = true;
            isLoadingViewer = true;
            StateHasChanged();

            var content = await DownloadPodContentAsync(pod.InvoiceDocEntry, pod.Id);
            if (content == null || content.Length == 0)
            {
                showViewer = false;
                return;
            }

            viewerDataUri = await JSRuntime.InvokeAsync<string>(
                "createObjectUrlFromBase64",
                viewerMimeType ?? "application/octet-stream",
                Convert.ToBase64String(content));
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error viewing POD {PodId}", pod.Id);
            showViewer = false;
        }
        finally
        {
            isLoadingViewer = false;
            StateHasChanged();
        }
    }

    private async Task CloseViewer()
    {
        showViewer = false;
        await RevokeViewerDataUriAsync();
        viewerPod = null;
    }

    private async Task RevokeViewerDataUriAsync()
    {
        if (!string.IsNullOrWhiteSpace(viewerDataUri))
        {
            await JSRuntime.InvokeVoidAsync("revokeObjectUrl", viewerDataUri);
            viewerDataUri = null;
        }
    }
}
