@page "/customer-portal/item-summary"
@using ShopInventory.Web.Models
@using ShopInventory.Web.Services
@inject ICustomerStatementService StatementService
@inject ICustomerPortalSessionService CustomerSession
@inject ILogger<CustomerItemSummary> Logger
@attribute [AllowAnonymous]
@rendermode InteractiveServer
@layout CustomerPortalLayout

<PageTitle>Item Summary - Customer Portal</PageTitle>

@* On the portal's page vocabulary — the `cpd` blocks the dashboard was built
   from; see the Page vocabulary section of customer-portal.css. `cpx` comes
   down from the shell. *@
<div class="cpd fade-in">
    @if (isLoading && customerInfo == null)
    {
        <div class="cpd-panel">
            <div class="cpd-empty">
                <div class="spinner-border" role="status" style="width: 2.25rem; height: 2.25rem;">
                    <span class="visually-hidden">Loading...</span>
                </div>
                <p class="mt-3 mb-0">Loading item summary...</p>
            </div>
        </div>
    }
    else if (customerInfo == null)
    {
        <div class="cpd-panel">
            <div class="cpd-empty">
                <i class="ph ph-lock-key"></i>
                <h5>Authentication required</h5>
                <p>Please sign in to see your purchase history.</p>
                <a href="/customer-portal/login" class="btn btn-primary">Sign in to the portal</a>
            </div>
        </div>
    }
    else
    {
        <div class="cpd-hero">
            <div class="cpd-hero-text">
                <h2>Item purchases</h2>
                <div class="cpd-hero-meta">
                    <span>@customerInfo.CardName</span>
                    <span>Account @customerInfo.CardCode</span>
                    @if (isMultiAccount)
                    {
                        <span>@AccountScopeCaption()</span>
                    }
                    <span>Invoiced quantities net of credit notes</span>
                </div>
            </div>
            <div class="cpd-hero-actions">
                <a href="/customer-portal/dashboard" class="btn btn-outline-primary">
                    <i class="ph ph-arrow-left"></i> Dashboard
                </a>
                <a href="/customer-portal/invoices" class="btn btn-primary">View invoices</a>
            </div>
        </div>

        <section class="cpd-panel">
            <div class="cpd-panel-head">
                <h5>Period and filters</h5>
                @if (hasLoadedData)
                {
                    <span class="cpd-tag">@filteredItems.Count() @Plural(filteredItems.Count(), "item")</span>
                }
            </div>
            <div class="cpd-filters">
                @* NocturneDateField rather than MudDatePicker: it draws the same calendar
                   as the rest of the portal instead of MudBlazor's own. *@
                <div class="cpd-field">
                    <label class="cpd-field-label" for="cis-f-from">From</label>
                    <NocturneDateField Id="cis-f-from" Class="ndf-bs" @bind-Date="fromDate" />
                </div>
                <div class="cpd-field">
                    <label class="cpd-field-label" for="cis-f-to">To</label>
                    <NocturneDateField Id="cis-f-to" Class="ndf-bs" @bind-Date="toDate" />
                </div>
                @if (isMultiAccount && linkedAccounts.Any())
                {
                    <div class="cpd-field">
                        <MudSelect T="string" Label="Account" Value="@selectedAccountFilter"
                                   ValueChanged="OnAccountFilterChanged" Variant="Variant.Outlined" Dense="true"
                                   AnchorOrigin="Origin.BottomCenter">
                            <MudSelectItem T="string" Value="@("")">All accounts</MudSelectItem>
                            @foreach (var account in linkedAccounts)
                            {
                                <MudSelectItem T="string" Value="@account.CardCode">
                                    @account.CardName @(!string.IsNullOrEmpty(account.Currency) ? $"({account.Currency})" : "")
                                    — @account.CardCode
                                </MudSelectItem>
                            }
                        </MudSelect>
                    </div>
                }
                <div class="cpd-field">
                    <MudSelect T="string" @bind-Value="selectedCategory" Label="Category" Variant="Variant.Outlined"
                               Dense="true" AnchorOrigin="Origin.BottomCenter" Clearable="true">
                        <MudSelectItem T="string" Value="@((string)null!)">All categories</MudSelectItem>
                        @foreach (var cat in availableCategories)
                        {
                            <MudSelectItem T="string" Value="@cat">@cat</MudSelectItem>
                        }
                    </MudSelect>
                </div>
                <div class="cpd-field">
                    <label class="cpd-field-label" for="cis-f-search">Search</label>
                    <input id="cis-f-search" class="cpd-input" type="search" @bind="searchText" @bind:event="oninput"
                           placeholder="Item code or description" />
                </div>
                <div class="cpd-field cpd-field-action">
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="ApplyFilters"
                               Disabled="@(isLoading || !fromDate.HasValue || !toDate.HasValue)">
                        @if (isLoading)
                        {
                            <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="me-1" />
                            <span>Loading...</span>
                        }
                        else
                        {
                            <span>@(hasLoadedData ? "Reload items" : "Load items")</span>
                        }
                    </MudButton>
                </div>
            </div>
        </section>

        @if (hasLoadedData)
        {
            @* Materialised once per render. The figures, the rows and the totals
               row read it a dozen times between them, and `filteredItems` is a
               deferred query that re-runs the whole filter and sort on each
               enumeration. *@
            var shown = filteredItems.ToList();
            var topItem = shown.OrderByDescending(i => i.NetAmount).FirstOrDefault();
            var returnedLines = shown.Count(i => i.CreditedQuantity > 0);

            <section class="cpd-kpis">
                <div class="cpd-kpi">
                    <div class="cpd-kpi-top">
                        <span class="cpd-kpi-label">Purchased</span>
                        <i class="ph ph-shopping-cart"></i>
                    </div>
                    <div class="cpd-kpi-num">@FormatCurrency(shown.Sum(i => i.InvoicedAmount))</div>
                    <div class="cpd-kpi-sub">@PeriodCaption()</div>
                </div>

                <div class="cpd-kpi">
                    <div class="cpd-kpi-top">
                        <span class="cpd-kpi-label">Returned</span>
                        <i class="ph ph-arrow-u-up-left"></i>
                    </div>
                    <div class="cpd-kpi-num">@FormatCurrency(shown.Sum(i => i.CreditedAmount))</div>
                    <div class="cpd-kpi-sub">
                        @(returnedLines > 0
                            ? $"{returnedLines} {Plural(returnedLines, "item")} credited"
                            : "Nothing credited back")
                    </div>
                </div>

                <div class="cpd-kpi">
                    <div class="cpd-kpi-top">
                        <span class="cpd-kpi-label">Net spend</span>
                        <i class="ph ph-wallet"></i>
                    </div>
                    <div class="cpd-kpi-num">@FormatCurrency(shown.Sum(i => i.NetAmount))</div>
                    <div class="cpd-kpi-sub">Purchases less returns</div>
                </div>

                <div class="cpd-kpi">
                    <div class="cpd-kpi-top">
                        <span class="cpd-kpi-label">Top item</span>
                        <i class="ph ph-package"></i>
                    </div>
                    <div class="cpd-kpi-num">@FormatCurrency(topItem?.NetAmount ?? 0)</div>
                    <div class="cpd-kpi-sub">@(topItem?.ItemDescription ?? topItem?.ItemCode ?? "No items in range")</div>
                </div>
            </section>

            <section class="cpd-panel cpd-ledger">
                <div class="cpd-panel-head">
                    <h5>Items</h5>
                    @* The breakdown is four more columns, not a different table, so it is
                       a state of this panel rather than a filter above it. *@
                    <button type="button" class="btn btn-outline-primary btn-sm" @onclick="ToggleBreakdown"
                            aria-pressed="@showBreakdown">
                        <i class="ph @(showBreakdown ? "ph-eye-slash" : "ph-eye")"></i>
                        @(showBreakdown ? "Hide breakdown" : "Show breakdown")
                    </button>
                    <span class="cpd-panel-total">
                        Net <strong>@FormatCurrency(shown.Sum(i => i.NetAmount))</strong>
                    </span>
                </div>

                @if (shown.Any())
                {
                    <div class="table-responsive">
                        <table class="cpd-table mobile-card-table">
                            <thead>
                                <tr>
                                    <th>@SortButton("ItemCode", "Item")</th>
                                    <th>@SortButton("Description", "Description")</th>
                                    @if (showBreakdown)
                                    {
                                        <th class="cpd-num">@SortButton("InvoicedQty", "Purchased qty")</th>
                                        <th class="cpd-num">@SortButton("InvoicedAmt", "Purchased")</th>
                                        <th class="cpd-num">@SortButton("CreditedQty", "Returned qty")</th>
                                        <th class="cpd-num">@SortButton("CreditedAmt", "Returned")</th>
                                    }
                                    <th class="cpd-num">@SortButton("NetQty", "Qty")</th>
                                    <th class="cpd-num">@SortButton("NetAmt", "Amount")</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in shown)
                                {
                                    <tr>
                                        <td data-label="Item"><span class="cpd-code">@item.ItemCode</span></td>
                                        <td data-label="Description">@(item.ItemDescription ?? "—")</td>
                                        @if (showBreakdown)
                                        {
                                            <td data-label="Purchased qty" class="cpd-num cpd-quiet">
                                                @QuantityDisplay.Format(item.InvoicedQuantity)
                                            </td>
                                            <td data-label="Purchased" class="cpd-num cpd-quiet">
                                                @FormatCurrency(item.InvoicedAmount)
                                            </td>
                                            <td data-label="Returned qty" class="cpd-num @(item.CreditedQuantity > 0 ? "cpd-minus" : "cpd-quiet")">
                                                @(item.CreditedQuantity > 0 ? $"-{QuantityDisplay.Format(item.CreditedQuantity)}" : "0")
                                            </td>
                                            <td data-label="Returned" class="cpd-num @(item.CreditedAmount > 0 ? "cpd-minus" : "cpd-quiet")">
                                                @(item.CreditedAmount > 0 ? $"-{FormatCurrency(item.CreditedAmount)}" : FormatCurrency(0))
                                            </td>
                                        }
                                        <td data-label="Qty" class="cpd-num cpd-strong">@QuantityDisplay.Format(item.NetQuantity)</td>
                                        <td data-label="Amount" class="cpd-num cpd-strong">@FormatCurrency(item.NetAmount)</td>
                                    </tr>
                                }
                            </tbody>
                            <tfoot>
                                <tr>
                                    <td data-label="Total">Total</td>
                                    <td class="cpd-quiet">@shown.Count() @Plural(shown.Count(), "item")</td>
                                    @if (showBreakdown)
                                    {
                                        <td data-label="Purchased qty" class="cpd-num">
                                            @QuantityDisplay.Format(shown.Sum(i => i.InvoicedQuantity))
                                        </td>
                                        <td data-label="Purchased" class="cpd-num">
                                            @FormatCurrency(shown.Sum(i => i.InvoicedAmount))
                                        </td>
                                        <td data-label="Returned qty" class="cpd-num cpd-minus">
                                            -@QuantityDisplay.Format(shown.Sum(i => i.CreditedQuantity))
                                        </td>
                                        <td data-label="Returned" class="cpd-num cpd-minus">
                                            -@FormatCurrency(shown.Sum(i => i.CreditedAmount))
                                        </td>
                                    }
                                    <td data-label="Qty" class="cpd-num">@QuantityDisplay.Format(shown.Sum(i => i.NetQuantity))</td>
                                    <td data-label="Amount" class="cpd-num">@FormatCurrency(shown.Sum(i => i.NetAmount))</td>
                                </tr>
                            </tfoot>
                        </table>
                    </div>
                }
                else
                {
                    <div class="cpd-empty">
                        @if (!string.IsNullOrEmpty(searchText))
                        {
                            <text>No items matching &ldquo;@searchText&rdquo;.</text>
                        }
                        else
                        {
                            <text>No invoiced items in the selected period.</text>
                        }
                    </div>
                }
            </section>
        }
        else
        {
            <div class="cpd-panel">
                <div class="cpd-empty">
                    <i class="ph ph-package"></i>
                    <h5>Choose a period</h5>
                    <p>Set the dates above and load what you bought over that range.</p>
                </div>
            </div>
        }
    }
</div>

@code {
    private CustomerPortalSession? portalSession;
    private CustomerInfo? customerInfo;
    private List<ItemCodeSummary>? items;
    private bool isLoading = true;
    private bool hasLoadedData;
    private bool showBreakdown;
    private string searchText = string.Empty;
    private string sortColumn = "NetAmt";
    private bool sortAscending = false;
    private DateTime? fromDate = DateTime.Today.AddMonths(-3);
    private DateTime? toDate = DateTime.Today;
    private string? selectedCategory;
    private List<string> availableCategories = new();
    private bool isMultiAccount;
    private string selectedAccountFilter = "";
    private List<LinkedAccountInfo> linkedAccounts = new();

    private IEnumerable<ItemCodeSummary> filteredItems =>
        ApplySort(ApplyFilter(items ?? Enumerable.Empty<ItemCodeSummary>()));

    protected override async Task OnInitializedAsync()
    {
        // Loading here rather than in OnAfterRender starts the fetch before the first render
        // instead of after it. The guard keeps the session read off any non-interactive pass;
        // see CustomerPortalLayout for why it is here even though prerendering is off.
        if (!RendererInfo.IsInteractive)
        {
            return;
        }

        await LoadCustomerInfo();
    }

    private async Task LoadCustomerInfo()
    {
        try
        {
            portalSession = await CustomerSession.GetCurrentSessionAsync();
            customerInfo = portalSession?.Customer;

            if (customerInfo != null)
            {
                isMultiAccount = customerInfo.AccountStructure == "Multi";
                linkedAccounts = portalSession?.LinkedAccounts.ToList() ?? new List<LinkedAccountInfo>();
                selectedAccountFilter = CustomerSession.CanAccessCardCode(portalSession, selectedAccountFilter)
                    ? selectedAccountFilter
                    : string.Empty;
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error loading customer info");
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task LoadData()
    {
        isLoading = true;

        try
        {
            if (customerInfo != null)
            {
                var cardCode = string.IsNullOrEmpty(selectedAccountFilter) ? customerInfo.CardCode : selectedAccountFilter;
                if (!CustomerSession.CanAccessCardCode(portalSession, cardCode))
                {
                    Logger.LogWarning("Rejected unauthorized customer item summary account access {CardCode}", cardCode);
                    selectedAccountFilter = string.Empty;
                    return;
                }

                items = await StatementService.GetItemCodeSummaryAsync(cardCode, fromDate, toDate);
                availableCategories = items
                    .Select(i => i.ItemGroup)
                    .Where(g => !string.IsNullOrEmpty(g))
                    .Distinct(StringComparer.OrdinalIgnoreCase)
                    .OrderBy(g => g)
                    .ToList();
                hasLoadedData = true;
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error loading item summary data");
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task ApplyFilters()
    {
        if (!fromDate.HasValue || !toDate.HasValue) return;
        await LoadData();
    }

    private async Task OnAccountFilterChanged(string value)
    {
        if (!CustomerSession.CanAccessCardCode(portalSession, value))
        {
            Logger.LogWarning("Rejected unauthorized customer item summary account filter {CardCode}", value);
            selectedAccountFilter = string.Empty;
            return;
        }

        selectedAccountFilter = value;
        if (hasLoadedData)
        {
            await LoadData();
        }
    }

    private void ToggleBreakdown()
    {
        showBreakdown = !showBreakdown;
    }

    private IEnumerable<ItemCodeSummary> ApplyFilter(IEnumerable<ItemCodeSummary> source)
    {
        if (!string.IsNullOrWhiteSpace(selectedCategory))
        {
            source = source.Where(i => string.Equals(i.ItemGroup, selectedCategory, StringComparison.OrdinalIgnoreCase));
        }

        if (string.IsNullOrWhiteSpace(searchText))
            return source;

        var term = searchText.Trim();
        return source.Where(i =>
            (i.ItemCode?.Contains(term, StringComparison.OrdinalIgnoreCase) == true) ||
            (i.ItemDescription?.Contains(term, StringComparison.OrdinalIgnoreCase) == true));
    }

    private IEnumerable<ItemCodeSummary> ApplySort(IEnumerable<ItemCodeSummary> source)
    {
        return sortColumn switch
        {
            "ItemCode" => sortAscending ? source.OrderBy(i => i.ItemCode) : source.OrderByDescending(i => i.ItemCode),
            "Description" => sortAscending ? source.OrderBy(i => i.ItemDescription) : source.OrderByDescending(i => i.ItemDescription),
            "InvoicedQty" => sortAscending ? source.OrderBy(i => i.InvoicedQuantity) : source.OrderByDescending(i => i.InvoicedQuantity),
            "InvoicedAmt" => sortAscending ? source.OrderBy(i => i.InvoicedAmount) : source.OrderByDescending(i => i.InvoicedAmount),
            "CreditedQty" => sortAscending ? source.OrderBy(i => i.CreditedQuantity) : source.OrderByDescending(i => i.CreditedQuantity),
            "CreditedAmt" => sortAscending ? source.OrderBy(i => i.CreditedAmount) : source.OrderByDescending(i => i.CreditedAmount),
            "NetQty" => sortAscending ? source.OrderBy(i => i.NetQuantity) : source.OrderByDescending(i => i.NetQuantity),
            "NetAmt" => sortAscending ? source.OrderBy(i => i.NetAmount) : source.OrderByDescending(i => i.NetAmount),
            _ => source
        };
    }

    private void SetSort(string column)
    {
        if (sortColumn == column)
            sortAscending = !sortAscending;
        else
        {
            sortColumn = column;
            sortAscending = column is "ItemCode" or "Description";
        }
    }

    /// <summary>
    /// The column heading as the control that sorts it. A `th` with a click
    /// handler is not reachable from a keyboard and announces nothing, so the
    /// heading carries a real button that inherits its type.
    /// </summary>
    private RenderFragment SortButton(string column, string label) => builder =>
    {
        var isSorted = sortColumn == column;

        builder.OpenElement(0, "button");
        builder.AddAttribute(1, "type", "button");
        builder.AddAttribute(2, "class", isSorted ? "cpd-sort is-sorted" : "cpd-sort");
        builder.AddAttribute(3, "aria-sort", isSorted ? (sortAscending ? "ascending" : "descending") : "none");
        builder.AddAttribute(4, "onclick", EventCallback.Factory.Create(this, () => SetSort(column)));
        builder.AddContent(5, label);
        builder.OpenElement(6, "i");
        builder.AddAttribute(7, "class", $"ph {(isSorted && sortAscending ? "ph-caret-up" : "ph-caret-down")}");
        builder.CloseElement();
        builder.CloseElement();
    };

    private string FormatCurrency(decimal amount)
    {
        return $"${amount:N2}";
    }

    private static string Plural(int count, string noun) => count == 1 ? noun : noun + "s";

    /// <summary>The period the figures cover, as the filter currently states it.</summary>
    private string PeriodCaption()
    {
        if (fromDate is null && toDate is null) return "All purchases on record";
        if (fromDate is null) return $"Up to {toDate:MMM dd, yyyy}";
        if (toDate is null) return $"Since {fromDate:MMM dd, yyyy}";
        return $"{fromDate:MMM dd, yyyy} – {toDate:MMM dd, yyyy}";
    }

    /// <summary>
    /// Which accounts the list is showing, for a customer whose portal login
    /// reaches more than one.
    /// </summary>
    private string AccountScopeCaption()
    {
        if (string.IsNullOrEmpty(selectedAccountFilter))
        {
            return "All main accounts";
        }

        return linkedAccounts.FirstOrDefault(a => a.CardCode == selectedAccountFilter)?.CardName
            ?? selectedAccountFilter;
    }
}
