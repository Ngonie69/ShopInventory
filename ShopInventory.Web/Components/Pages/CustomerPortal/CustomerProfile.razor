@page "/customer-portal/profile"
@using ShopInventory.Web.Models
@inject ICustomerAuthService CustomerAuthService
@inject ICustomerPortalSessionService CustomerSession
@inject NavigationManager NavigationManager
@inject ILogger<CustomerProfile> Logger
@inject WebClientAuditContext ClientAuditContext
@attribute [AllowAnonymous]
@rendermode InteractiveServer
@layout CustomerPortalLayout

<PageTitle>Profile - Customer Portal</PageTitle>

@* On the portal's page vocabulary — the `cpd` blocks the dashboard was built
   from; see the Page vocabulary section of customer-portal.css. `cpx` comes
   down from the shell. *@
<div class="cpd fade-in">
    @if (isLoading)
    {
        <div class="cpd-panel">
            <div class="cpd-empty">
                <div class="spinner-border" role="status" style="width: 2.25rem; height: 2.25rem;">
                    <span class="visually-hidden">Loading...</span>
                </div>
                <p class="mt-3 mb-0">Loading profile...</p>
            </div>
        </div>
    }
    else if (customerInfo == null)
    {
        <div class="cpd-panel">
            <div class="cpd-empty">
                <i class="ph ph-lock-key"></i>
                <h5>Authentication required</h5>
                <p>Please sign in to see your profile.</p>
                <a href="/customer-portal/login" class="btn btn-primary">Sign in to the portal</a>
            </div>
        </div>
    }
    else
    {
        <div class="cpd-hero">
            <div class="cpd-hero-text">
                <h2>@customerInfo.CardName</h2>
                <div class="cpd-hero-meta">
                    <span>Account @customerInfo.CardCode</span>
                    @if (customerInfo.AccountStructure == "Multi")
                    {
                        <span>@(customerInfo.LinkedAccounts?.Count ?? 0) linked accounts</span>
                    }
                    <span>
                        @(customerInfo.LastLoginAt.HasValue
                            ? $"Last signed in {customerInfo.LastLoginAt.Value:MMM dd, yyyy 'at' HH:mm}"
                            : "No sign-in recorded")
                    </span>
                </div>
            </div>
            <div class="cpd-hero-actions">
                <a href="/customer-portal/activity-log" class="btn btn-outline-primary">
                    <i class="ph ph-clock-counter-clockwise"></i> Activity log
                </a>
                <a href="/customer-portal/statements" class="btn btn-primary">View statement</a>
            </div>
        </div>

        <section class="cpd-panel">
            <div class="cpd-panel-head">
                <h5>Customer details</h5>
                <span class="cpd-tag">Held in SAP</span>
            </div>
            @* Read-only, and stated as such: these fields come from the business
               partner master, so the portal has nowhere to write a change back to.
               A customer who needs one asks support. *@
            <div class="cpd-defs">
                <div class="cpd-def">
                    <span class="cpd-def-k">Customer name</span>
                    <span class="cpd-def-v">@customerInfo.CardName</span>
                </div>
                <div class="cpd-def">
                    <span class="cpd-def-k">Customer code</span>
                    <span class="cpd-def-v">@customerInfo.CardCode</span>
                </div>
                <div class="cpd-def">
                    <span class="cpd-def-k">Email</span>
                    <span class="cpd-def-v">@(string.IsNullOrWhiteSpace(customerInfo.Email) ? "Not provided" : customerInfo.Email)</span>
                </div>
                <div class="cpd-def">
                    <span class="cpd-def-k">Phone</span>
                    <span class="cpd-def-v">@(string.IsNullOrWhiteSpace(customerInfo.Phone) ? "Not provided" : customerInfo.Phone)</span>
                </div>
                <div class="cpd-def">
                    <span class="cpd-def-k">Account balance</span>
                    <span class="cpd-def-v is-lg">@FormatCurrency(customerInfo.Balance)</span>
                </div>
                <div class="cpd-def">
                    <span class="cpd-def-k">Last sign-in</span>
                    <span class="cpd-def-v">
                        @(customerInfo.LastLoginAt?.ToString("MMM dd, yyyy 'at' HH:mm") ?? "Not available")
                    </span>
                </div>
            </div>
            <p class="cpd-help mt-3 mb-0">
                These details come from your account in our finance system. To change any of them,
                <a href="/customer-portal/support">contact support</a>.
            </p>
        </section>

        <section class="cpd-panel">
            <div class="cpd-panel-head">
                <h5>Change password</h5>
            </div>

            @if (!string.IsNullOrEmpty(passwordError))
            {
                <div class="alert alert-danger">@passwordError</div>
            }
            @if (!string.IsNullOrEmpty(passwordSuccess))
            {
                <div class="alert alert-success">@passwordSuccess</div>
            }

            <EditForm Model="passwordRequest" OnValidSubmit="HandlePasswordChange" class="cpd-form">
                <DataAnnotationsValidator />
                <div class="cpd-form-grid">
                    <div class="cpd-field">
                        <label class="cpd-field-label" for="cpf-current">Current password</label>
                        <InputText id="cpf-current" type="password" class="cpd-input"
                                   autocomplete="current-password" @bind-Value="passwordRequest.CurrentPassword" />
                        <ValidationMessage For="@(() => passwordRequest.CurrentPassword)" />
                    </div>
                    <div class="cpd-field">
                        <label class="cpd-field-label" for="cpf-new">New password</label>
                        <InputText id="cpf-new" type="password" class="cpd-input"
                                   autocomplete="new-password" @bind-Value="passwordRequest.NewPassword" />
                        <ValidationMessage For="@(() => passwordRequest.NewPassword)" />
                    </div>
                    <div class="cpd-field">
                        <label class="cpd-field-label" for="cpf-confirm">Confirm password</label>
                        <InputText id="cpf-confirm" type="password" class="cpd-input"
                                   autocomplete="new-password" @bind-Value="passwordRequest.ConfirmPassword" />
                        <ValidationMessage For="@(() => passwordRequest.ConfirmPassword)" />
                    </div>
                </div>
                <p class="cpd-help mb-0">
                    At least 8 characters, with an upper case letter, a lower case letter, a number and a symbol.
                    Changing it signs you out of the portal.
                </p>
                <div class="cpd-form-actions">
                    <button type="submit" class="btn btn-primary" disabled="@isSavingPassword">
                        @if (isSavingPassword)
                        {
                            <span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>
                            <span>Updating</span>
                        }
                        else
                        {
                            <span>Update password</span>
                        }
                    </button>
                </div>
            </EditForm>
        </section>
    }
</div>

@code {
    private CustomerPortalSession? portalSession;
    private CustomerInfo? customerInfo;
    private bool isLoading = true;
    private CustomerPasswordChangeRequest passwordRequest = new();
    private bool isSavingPassword;
    private string? passwordError;
    private string? passwordSuccess;

    protected override async Task OnInitializedAsync()
    {
        // Loading here rather than in OnAfterRender starts the fetch before the first render
        // instead of after it. The guard keeps the session read off any non-interactive pass;
        // see CustomerPortalLayout for why it is here even though prerendering is off.
        if (!RendererInfo.IsInteractive)
        {
            return;
        }

        await LoadCustomerInfo();
    }

    private async Task LoadCustomerInfo()
    {
        isLoading = true;

        try
        {
            portalSession = await CustomerSession.GetCurrentSessionAsync();
            customerInfo = portalSession?.Customer;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error loading customer profile");
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task HandlePasswordChange()
    {
        if (customerInfo == null)
        {
            passwordError = "Please login to change your password.";
            return;
        }

        isSavingPassword = true;
        passwordError = null;
        passwordSuccess = null;

        try
        {
            var ipAddress = GetClientIpAddress();
            var result = await CustomerAuthService.ChangePasswordAsync(customerInfo.CardCode, passwordRequest, ipAddress);

            if (!result.Success)
            {
                passwordError = result.Message;
                return;
            }

            passwordSuccess = result.Message;

            await CustomerSession.ClearSessionAsync();

            NavigationManager.NavigateTo("/customer-portal/login", forceLoad: true);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error changing customer password");
            passwordError = "Unable to update password right now.";
        }
        finally
        {
            isSavingPassword = false;
        }
    }

    private string FormatCurrency(decimal amount)
    {
        return $"${amount:N2}";
    }

    private string GetClientIpAddress() => string.IsNullOrWhiteSpace(ClientAuditContext.IpAddress)
        ? "unknown"
        : ClientAuditContext.IpAddress;
}
