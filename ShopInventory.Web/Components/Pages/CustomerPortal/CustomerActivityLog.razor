@page "/customer-portal/activity-log"
@using ShopInventory.Web.Models
@inject ICustomerAuthService CustomerAuthService
@inject ICustomerPortalSessionService CustomerSession
@inject NavigationManager NavigationManager
@inject ILogger<CustomerActivityLog> Logger
@attribute [AllowAnonymous]
@rendermode InteractiveServer
@layout CustomerPortalLayout

<PageTitle>Activity Log - Customer Portal</PageTitle>

@* On the portal's page vocabulary — the `cpd` blocks the dashboard was built
   from; see the Page vocabulary section of customer-portal.css. `cpx` comes
   down from the shell. *@
<div class="cpd fade-in">
    @if (isLoading)
    {
        <div class="cpd-panel">
            <div class="cpd-empty">
                <div class="spinner-border" role="status" style="width: 2.25rem; height: 2.25rem;">
                    <span class="visually-hidden">Loading...</span>
                </div>
                <p class="mt-3 mb-0">Loading activity log...</p>
            </div>
        </div>
    }
    else if (customerInfo == null)
    {
        <div class="cpd-panel">
            <div class="cpd-empty">
                <i class="ph ph-lock-key"></i>
                <h5>Authentication required</h5>
                <p>Please sign in to see your account activity.</p>
                <a href="/customer-portal/login" class="btn btn-primary">Sign in to the portal</a>
            </div>
        </div>
    }
    else
    {
        <div class="cpd-hero">
            <div class="cpd-hero-text">
                <h2>Account activity</h2>
                <div class="cpd-hero-meta">
                    <span>@customerInfo.CardName</span>
                    <span>Account @customerInfo.CardCode</span>
                    <span>Security events and account actions</span>
                </div>
            </div>
            <div class="cpd-hero-actions">
                <a href="/customer-portal/profile" class="btn btn-outline-primary">
                    <i class="ph ph-user"></i> Profile
                </a>
                <button type="button" class="btn btn-primary" @onclick="RefreshData" disabled="@isLoadingLogs">
                    <i class="ph ph-arrows-clockwise"></i> Refresh
                </button>
            </div>
        </div>

        @* A failed sign-in is the one thing on this page a customer needs to act
           on, so it is stated rather than left to be counted out of the table.
           The strip is absent when there is nothing to say. *@
        @if (FailedCount > 0)
        {
            <div class="cpd-banner" role="status">
                <i class="ph ph-warning-circle"></i>
                <div class="cpd-banner-text">
                    <span class="cpd-banner-num">@FailedCount</span>
                    failed @Plural(FailedCount, "attempt") in the @logs.Count events shown@(LastFailure.HasValue
                        ? $" — most recent {LastFailure.Value.ToLocalTime():MMM dd, yyyy 'at' HH:mm}."
                        : ".")
                    If you don't recognise them, change your password.
                </div>
                <a href="/customer-portal/profile" class="btn cpd-banner-action">Change password</a>
            </div>
        }

        <section class="cpd-kpis">
            <div class="cpd-kpi">
                <div class="cpd-kpi-top">
                    <span class="cpd-kpi-label">Events shown</span>
                    <i class="ph ph-list-bullets"></i>
                </div>
                <div class="cpd-kpi-num">@logs.Count</div>
                <div class="cpd-kpi-sub">
                    @(hasMorePages ? "More available — load below" : "Everything on record")
                </div>
            </div>

            <div class="cpd-kpi">
                <div class="cpd-kpi-top">
                    <span class="cpd-kpi-label">Sign-ins</span>
                    <i class="ph ph-sign-in"></i>
                </div>
                <div class="cpd-kpi-num">@SignInCount</div>
                <div class="cpd-kpi-sub">Successful sessions</div>
            </div>

            <div class="cpd-kpi @(FailedCount > 0 ? "is-alert" : "")">
                <div class="cpd-kpi-top">
                    <span class="cpd-kpi-label">Failed attempts</span>
                    <i class="ph ph-shield-warning"></i>
                </div>
                <div class="cpd-kpi-num">@FailedCount</div>
                <div class="cpd-kpi-sub">@(FailedCount > 0 ? "Review the rows below" : "Nothing rejected")</div>
            </div>

            <div class="cpd-kpi">
                <div class="cpd-kpi-top">
                    <span class="cpd-kpi-label">Last sign-in</span>
                    <i class="ph ph-clock-counter-clockwise"></i>
                </div>
                <div class="cpd-kpi-num">@(LastSignIn?.ToLocalTime().ToString("HH:mm") ?? "—")</div>
                <div class="cpd-kpi-sub">
                    @(LastSignIn.HasValue
                        ? LastSignIn.Value.ToLocalTime().ToString("MMM dd, yyyy")
                        : "No sign-in recorded")
                </div>
            </div>
        </section>

        <section class="cpd-panel cpd-ledger">
            <div class="cpd-panel-head">
                <h5>Event history</h5>
                <span class="cpd-tag">Newest first</span>
            </div>

            @if (isLoadingLogs && !logs.Any())
            {
                <div class="cpd-empty">
                    <div class="spinner-border spinner-border-sm" role="status">
                        <span class="visually-hidden">Loading...</span>
                    </div>
                </div>
            }
            else if (!logs.Any())
            {
                <div class="cpd-empty">
                    <i class="ph ph-list-magnifying-glass"></i>
                    <h5>No activity recorded yet</h5>
                    <p>Sign-ins and account changes will appear here.</p>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="cpd-table mobile-card-table">
                        <thead>
                            <tr>
                                <th>Event</th>
                                <th>When</th>
                                <th>Detail</th>
                                <th>Address</th>
                                <th class="cpd-num">Result</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var log in logs)
                            {
                                <tr>
                                    <td data-label="Event">
                                        @* One element, not two: below 992px each cell becomes a
                                           labelled grid row, and a second child would be placed
                                           into the label track. *@
                                        <span class="cpd-doc">
                                            <span class="cpd-doc-id">@FormatAction(log.Action)</span>
                                            <span class="cpd-doc-sub">@log.Timestamp.ToLocalTime().ToString("HH:mm:ss")</span>
                                        </span>
                                    </td>
                                    <td data-label="When" class="cpd-quiet">
                                        @log.Timestamp.ToLocalTime().ToString("MMM dd, yyyy")
                                    </td>
                                    <td data-label="Detail" class="@(string.IsNullOrEmpty(log.Details) && !string.IsNullOrEmpty(log.FailureReason) ? "cpd-minus" : "cpd-quiet")">
                                        @DetailText(log)
                                    </td>
                                    <td data-label="Address">
                                        <span class="cpd-code">@(log.IpAddress ?? "unknown")</span>
                                    </td>
                                    <td data-label="Result" class="cpd-num">
                                        <span class="cpd-status @(log.Success ? "is-paid" : "is-over")">
                                            @(log.Success ? "Success" : "Failed")
                                        </span>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                @if (hasMorePages)
                {
                    <div class="cpd-pager">
                        <div class="cpd-pager-info">Showing the @logs.Count most recent events</div>
                        <button type="button" class="btn btn-outline-primary btn-sm" @onclick="LoadMore"
                                disabled="@isLoadingLogs">
                            @if (isLoadingLogs)
                            {
                                <span class="spinner-border spinner-border-sm me-1" role="status"></span>
                            }
                            Load more
                        </button>
                    </div>
                }
            }
        </section>
    }
</div>

@code {
    private CustomerPortalSession? portalSession;
    private CustomerInfo? customerInfo;
    private List<CustomerSecurityAuditLog> logs = new();
    private bool isLoading = true;
    private bool isLoadingLogs;
    private int currentPage = 1;
    private const int PageSize = 20;
    private bool hasMorePages = true;

    private int SignInCount => logs.Count(l => l.Success && l.Action == "Login");

    private int FailedCount => logs.Count(l => !l.Success);

    // Ordered rather than taken off the head of the list: the rows arrive newest
    // first today, but "the most recent sign-in" should not silently become "the
    // first row" if that ever changes.
    private DateTime? LastSignIn => logs
        .Where(l => l.Success && l.Action == "Login")
        .OrderByDescending(l => l.Timestamp)
        .Select(l => (DateTime?)l.Timestamp)
        .FirstOrDefault();

    private DateTime? LastFailure => logs
        .Where(l => !l.Success)
        .OrderByDescending(l => l.Timestamp)
        .Select(l => (DateTime?)l.Timestamp)
        .FirstOrDefault();

    protected override async Task OnInitializedAsync()
    {
        // Loading here rather than in OnAfterRender starts the fetch before the first render
        // instead of after it. The guard keeps the session read off any non-interactive pass;
        // see CustomerPortalLayout for why it is here even though prerendering is off.
        if (!RendererInfo.IsInteractive)
        {
            return;
        }

        try
        {
            portalSession = await CustomerSession.GetCurrentSessionAsync();
            customerInfo = portalSession?.Customer;

            if (customerInfo != null)
            {
                await LoadLogs();
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error loading activity log");
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task LoadLogs()
    {
        isLoadingLogs = true;
        try
        {
            var page = await CustomerAuthService.GetSecurityLogsAsync(customerInfo!.CardCode, currentPage, PageSize);
            if (currentPage == 1)
                logs = page;
            else
                logs.AddRange(page);

            hasMorePages = page.Count == PageSize;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error loading security logs");
        }
        finally
        {
            isLoadingLogs = false;
        }
    }

    private async Task LoadMore()
    {
        currentPage++;
        await LoadLogs();
    }

    private async Task RefreshData()
    {
        currentPage = 1;
        await LoadLogs();
    }

    private static string Plural(int count, string noun) => count == 1 ? noun : noun + "s";

    private static string DetailText(CustomerSecurityAuditLog log)
    {
        if (!string.IsNullOrEmpty(log.Details)) return log.Details;
        if (!string.IsNullOrEmpty(log.FailureReason)) return log.FailureReason;
        return "—";
    }

    private string FormatAction(string action)
    {
        return action switch
        {
            "Login" => "Sign In",
            "LoginFailed" => "Sign In Attempt",
            "Logout" => "Sign Out",
            "PasswordChange" => "Password Changed",
            "PasswordReset" => "Password Reset",
            "TwoFactorEnabled" => "2FA Enabled",
            "TwoFactorDisabled" => "2FA Disabled",
            "TwoFactorVerified" => "2FA Verified",
            "TokenRefresh" => "Session Renewed",
            "AccountLocked" => "Account Locked",
            "AccountUnlocked" => "Account Unlocked",
            _ => action.Replace("_", " ")
        };
    }
}
