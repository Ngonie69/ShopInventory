@page "/customer-portal"
@inject ICustomerPortalSessionService CustomerSession
@inject NavigationManager NavigationManager
@attribute [AllowAnonymous]
@rendermode InteractiveServer
@layout EmptyLayout

<PageTitle>Customer Portal</PageTitle>

@* Whatever this page shows is on screen for one render before it redirects, so
   the only thing that matters is that it is the same colour as both places it
   can land. `cpx` on EmptyLayout does that — see CustomerLogin.razor. *@
<div class="cpx cpx-boot">
    <div class="cpx-boot-inner">
        <img src="images/kefalos-logo.jpg" alt="Kefalos Quality Dairy Produce" class="signin-mark"
             onerror="this.style.display='none'" />
        <span class="cpx-boot-spinner" aria-hidden="true"></span>
        <p role="status">Opening the customer portal&hellip;</p>
    </div>
</div>

@code {
    protected override async Task OnInitializedAsync()
    {
        // This page exists only to decide where to send the visitor, and that decision needs the
        // session; see CustomerPortalLayout for why the non-interactive pass is skipped.
        if (!RendererInfo.IsInteractive)
        {
            return;
        }

        var session = await CustomerSession.GetCurrentSessionAsync();
        var destination = session == null
            ? "/customer-portal/login"
            : "/customer-portal/dashboard";

        NavigationManager.NavigateTo(destination, forceLoad: true, replace: true);
    }
}
