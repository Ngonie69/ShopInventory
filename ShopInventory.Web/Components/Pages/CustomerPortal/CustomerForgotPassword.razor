@page "/customer-portal/forgot-password"
@inject ICustomerAuthService CustomerAuthService
@inject WebClientAuditContext ClientAuditContext
@inject ILogger<CustomerForgotPassword> Logger
@attribute [AllowAnonymous]
@rendermode InteractiveServer
@layout EmptyLayout

<PageTitle>Forgot Password - Customer Portal</PageTitle>

@* The front-door composition from customer-portal.css's Sign-in section, the
   same as /customer-portal/login and /customer-portal/register wear — see the
   note at the top of CustomerRegister.razor. *@
<div class="cpx signin">

    <section class="signin-hero">
        <div class="signin-brand">
            <img src="images/kefalos-logo.jpg" alt="Kefalos Quality Dairy Produce" class="signin-mark"
                 onerror="this.style.display='none'" />
            <div class="signin-brand-rule"></div>
            <div class="signin-brand-text">
                <span class="signin-brand-name">Customer Portal</span>
            </div>
        </div>

        <div class="signin-pitch">
            <div class="signin-eyebrow">Account recovery</div>
            <h1>Locked out? This takes a minute.</h1>
            <p>
                We email a reset link to the address registered on the account. The link is
                single-use and expires, so request a fresh one if it has been sitting a while.
            </p>
        </div>

        <div class="signin-hero-foot">
            <span>Remembered it?</span>
            <a href="/customer-portal/login">
                Back to sign in
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                     stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M5 12h13" />
                    <path d="M12 6l6 6-6 6" />
                </svg>
            </a>
        </div>
    </section>

    <section class="signin-panel">
        <div class="signin-form">
            <span class="signin-tag">Customer portal</span>
            <h2>Reset your password</h2>
            <p class="signin-sub">
                @(requestSubmitted
                    ? "Check the inbox for that address."
                    : "Enter the customer code and email registered on your account.")
            </p>

            @if (requestSubmitted)
            {
                <div class="signin-note signin-note-ok" role="status">
                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                         stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <circle cx="12" cy="12" r="9" />
                        <path d="M8.4 12.2l2.5 2.5 4.7-5" />
                    </svg>
                    <span>@resultMessage</span>
                </div>

                <a href="/customer-portal/login" class="signin-submit">
                    <span>Back to sign in</span>
                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                         stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <path d="M5 12h12" />
                        <path d="M11.5 6.5L18 12l-6.5 5.5" />
                    </svg>
                </a>
            }
            else
            {
                <EditForm Model="model" OnValidSubmit="RequestReset" FormName="customer-forgot-password">
                    <DataAnnotationsValidator />

                    <div class="signin-field">
                        <label for="reset-card-code">Customer code</label>
                        <div class="signin-control">
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                 stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                <rect x="3" y="5" width="18" height="14" rx="2.5" />
                                <path d="M7 10h4" />
                                <path d="M7 14h8" />
                            </svg>
                            <InputText id="reset-card-code" class="signin-input" @bind-Value="model.CardCode"
                                       placeholder="C00123" autocomplete="username" />
                        </div>
                        <ValidationMessage For="@(() => model.CardCode)" class="validation-msg" />
                    </div>

                    <div class="signin-field">
                        <label for="reset-email">Email address</label>
                        <div class="signin-control">
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                 stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                <rect x="3" y="5.5" width="18" height="13" rx="2.5" />
                                <path d="M4 7l8 6 8-6" />
                            </svg>
                            <InputText id="reset-email" class="signin-input" type="email" @bind-Value="model.Email"
                                       placeholder="@("orders@yourbusiness.com")" autocomplete="email" />
                        </div>
                        <ValidationMessage For="@(() => model.Email)" class="validation-msg" />
                    </div>

                    @if (!string.IsNullOrWhiteSpace(resultMessage))
                    {
                        <div class="signin-note signin-note-error" role="alert">
                            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                 stroke-width="1.8" stroke-linecap="round" aria-hidden="true">
                                <circle cx="12" cy="12" r="9" />
                                <path d="M12 7.5v5.5" />
                                <path d="M12 16.4v.1" />
                            </svg>
                            <span>@resultMessage</span>
                        </div>
                    }

                    <button type="submit" class="signin-submit" disabled="@isSubmitting">
                        @if (isSubmitting)
                        {
                            <span class="signin-spinner"></span>
                            <span>Sending&hellip;</span>
                        }
                        else
                        {
                            <span>Send reset link</span>
                            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                 stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                <path d="M5 12h12" />
                                <path d="M11.5 6.5L18 12l-6.5 5.5" />
                            </svg>
                        }
                    </button>

                    <a href="/customer-portal/login" class="signin-back">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                             stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <path d="M19 12H7" />
                            <path d="M12.5 6.5L6 12l6.5 5.5" />
                        </svg>
                        Back to sign in
                    </a>
                </EditForm>
            }

            <div class="signin-secure">
                <svg width="13" height="13" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
                    <path
                    d="M8 0c-.69 0-1.843.265-2.928.56-1.11.3-2.229.655-2.887.87a1.54 1.54 0 0 0-1.044 1.262c-.596 4.477.787 7.795 2.465 9.99a11.777 11.777 0 0 0 2.517 2.453c.386.273.744.482 1.048.625.28.132.581.24.829.24s.548-.108.829-.24a7.159 7.159 0 0 0 1.048-.625 11.775 11.775 0 0 0 2.517-2.453c1.678-2.195 3.061-5.513 2.465-9.99a1.541 1.541 0 0 0-1.044-1.263 62.467 62.467 0 0 0-2.887-.87C9.843.266 8.69 0 8 0zm-.5 5a.5.5 0 0 1 1 0v1.5H10a.5.5 0 0 1 0 1H8.5V9a.5.5 0 0 1-1 0V7.5H6a.5.5 0 0 1 0-1h1.5V5z" />
                </svg>
                <span>Secured with 256-bit encryption</span>
            </div>
        </div>

        <div class="signin-copyright">&copy; 2026 Kefalos Cheese</div>
    </section>
</div>

@code {
    private readonly CustomerPasswordResetRequest model = new();
    private bool isSubmitting;
    private bool requestSubmitted;
    private string? resultMessage;

    private async Task RequestReset()
    {
        if (isSubmitting)
        {
            return;
        }

        isSubmitting = true;
        resultMessage = null;

        try
        {
            model.CardCode = model.CardCode.Trim();
            model.Email = model.Email.Trim();
            var result = await CustomerAuthService.RequestPasswordResetAsync(
                model,
                ClientAuditContext.IpAddress ?? "unknown");

            resultMessage = result.Message;
            requestSubmitted = result.Success;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Customer password reset request failed");
            resultMessage = "We couldn't process the request right now. Please try again.";
        }
        finally
        {
            isSubmitting = false;
        }
    }
}
