@page "/customer-portal/invoices"
@using ShopInventory.Web.Models
@inject ICustomerStatementService StatementService
@inject IInvoiceService InvoiceService
@inject ICustomerPortalSessionService CustomerSession
@inject HttpClient Http
@inject IJSRuntime JSRuntime
@inject ILogger<CustomerInvoices> Logger
@attribute [AllowAnonymous]
@rendermode InteractiveServer
@layout CustomerPortalLayout

<PageTitle>Invoices - Customer Portal</PageTitle>

@* On the portal's page vocabulary — the `cpd` blocks the dashboard was built
   from; see the Page vocabulary section of customer-portal.css. `cpx` comes
   down from the shell. *@
<div class="cpd fade-in">
    @if (isLoading && customerInfo == null)
    {
        <div class="cpd-panel">
            <div class="cpd-empty">
                <div class="spinner-border" role="status" style="width: 2.25rem; height: 2.25rem;">
                    <span class="visually-hidden">Loading...</span>
                </div>
                <p class="mt-3 mb-0">Loading invoices...</p>
            </div>
        </div>
    }
    else if (customerInfo == null)
    {
        <div class="cpd-panel">
            <div class="cpd-empty">
                <i class="ph ph-lock-key"></i>
                <h5>Authentication required</h5>
                <p>Please sign in to see your invoices.</p>
                <a href="/customer-portal/login" class="btn btn-primary">Sign in to the portal</a>
            </div>
        </div>
    }
    else
    {
        <div class="cpd-hero">
            <div class="cpd-hero-text">
                <h2>Invoices</h2>
                <div class="cpd-hero-meta">
                    <span>@customerInfo.CardName</span>
                    <span>Account @customerInfo.CardCode</span>
                    @if (isMultiAccount)
                    {
                        <span>@AccountScopeCaption()</span>
                    }
                    <span>
                        @(lastUpdated.HasValue
                            ? $"Updated {lastUpdated.Value:MMM dd, yyyy 'at' HH:mm} UTC"
                            : "Not loaded yet")
                    </span>
                </div>
            </div>
            <div class="cpd-hero-actions">
                <a href="/customer-portal/dashboard" class="btn btn-outline-primary">
                    <i class="ph ph-arrow-left"></i> Dashboard
                </a>
                <a href="/customer-portal/statements" class="btn btn-primary">View statement</a>
            </div>
        </div>

        @* The strip states the overdue position in one sentence, exactly as the
           dashboard does. Absent on an account with nothing past due, rather
           than merely empty. *@
        @if (hasLoaded && OverdueAmount > 0)
        {
            <div class="cpd-banner" role="status">
                <i class="ph ph-warning-circle"></i>
                <div class="cpd-banner-text">
                    <span class="cpd-banner-num">@FormatCurrency(OverdueAmount)</span>
                    past due across @OverdueCount @Plural(OverdueCount, "invoice")@(OldestOverdueDays > 0
                        ? $" — oldest {OldestOverdueDays} {Plural(OldestOverdueDays, "day")} over terms."
                        : ".")
                </div>
            </div>
        }

        <section class="cpd-panel">
            <div class="cpd-panel-head">
                <h5>Period</h5>
                @if (hasLoaded)
                {
                    <span class="cpd-tag">@filteredInvoices.Count @Plural(filteredInvoices.Count, "invoice")</span>
                }
            </div>
            <div class="cpd-filters">
                @* NocturneDateField rather than FlexibleDatePicker: it keeps the shorthand
                   entry that component was written for and draws the same calendar as the
                   rest of the portal, instead of MudBlazor's. *@
                <div class="cpd-field">
                    <label class="cpd-field-label" for="cinv-f-from">From</label>
                    <NocturneDateField Id="cinv-f-from" Class="ndf-bs" @bind-Date="fromDate" />
                </div>
                <div class="cpd-field">
                    <label class="cpd-field-label" for="cinv-f-to">To</label>
                    <NocturneDateField Id="cinv-f-to" Class="ndf-bs" @bind-Date="toDate" />
                </div>
                @if (isMultiAccount && linkedAccounts.Any())
                {
                    <div class="cpd-field">
                        <MudSelect T="string" Label="Account" Value="@selectedAccountFilter"
                                   ValueChanged="OnAccountFilterChanged" Variant="Variant.Outlined" Dense="true"
                                   AnchorOrigin="Origin.BottomCenter">
                            <MudSelectItem T="string" Value="@("")">All accounts</MudSelectItem>
                            @foreach (var account in linkedAccounts)
                            {
                                <MudSelectItem T="string" Value="@account.CardCode">
                                    @account.CardName @(!string.IsNullOrEmpty(account.Currency) ? $"({account.Currency})" : "")
                                    — @account.CardCode
                                </MudSelectItem>
                            }
                        </MudSelect>
                    </div>
                }
                <div class="cpd-field cpd-field-action">
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="LoadInvoices"
                               Disabled="@isLoading">
                        @if (isLoading)
                        {
                            <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="me-1" />
                            <span>Loading...</span>
                        }
                        else
                        {
                            <span>@(hasLoaded ? "Reload invoices" : "Load invoices")</span>
                        }
                    </MudButton>
                </div>
            </div>
        </section>

        @if (hasLoaded)
        {
            <section class="cpd-kpis">
                <div class="cpd-kpi">
                    <div class="cpd-kpi-top">
                        <span class="cpd-kpi-label">Outstanding</span>
                        <i class="ph ph-receipt"></i>
                    </div>
                    <div class="cpd-kpi-num">@FormatCurrency(filteredOutstanding)</div>
                    <div class="cpd-kpi-sub">@PeriodCaption()</div>
                </div>

                <div class="cpd-kpi">
                    <div class="cpd-kpi-top">
                        <span class="cpd-kpi-label">Open invoices</span>
                        <i class="ph ph-files"></i>
                    </div>
                    <div class="cpd-kpi-num">@OpenCount</div>
                    <div class="cpd-kpi-sub">
                        @(PaidCount > 0 ? $"{PaidCount} settled in range" : "None settled in range")
                    </div>
                </div>

                <div class="cpd-kpi @(OverdueAmount > 0 ? "is-alert" : "")">
                    <div class="cpd-kpi-top">
                        <span class="cpd-kpi-label">Overdue</span>
                        <i class="ph ph-clock"></i>
                    </div>
                    <div class="cpd-kpi-num">@FormatCurrency(OverdueAmount)</div>
                    <div class="cpd-kpi-sub">
                        @if (OverdueCount > 0)
                        {
                            <text>@OverdueCount @Plural(OverdueCount, "invoice")@(OldestOverdueDays > 0
                                ? $", oldest {OldestOverdueDays} {Plural(OldestOverdueDays, "day")} over"
                                : "")</text>
                        }
                        else
                        {
                            <text>Nothing past due</text>
                        }
                    </div>
                </div>

                <div class="cpd-kpi">
                    <div class="cpd-kpi-top">
                        <span class="cpd-kpi-label">Next due</span>
                        <i class="ph ph-calendar-check"></i>
                    </div>
                    <div class="cpd-kpi-num">@FormatCurrency(NextDue?.Balance ?? 0)</div>
                    <div class="cpd-kpi-sub">@NextDueCaption()</div>
                </div>
            </section>

            <section class="cpd-panel cpd-ledger">
                <div class="cpd-panel-head">
                    <h5>Open invoices</h5>
                    <span class="cpd-panel-total">
                        Balance <strong>@FormatCurrency(filteredOutstanding)</strong>
                    </span>
                </div>

                @if (pagedInvoices.Any())
                {
                    <div class="table-responsive">
                        <table class="cpd-table mobile-card-table">
                            <thead>
                                <tr>
                                    <th>Invoice</th>
                                    @if (isMultiAccount)
                                    {
                                        <th>Account</th>
                                    }
                                    <th>Due</th>
                                    <th class="cpd-num">Amount</th>
                                    <th class="cpd-num">Paid</th>
                                    <th class="cpd-num">Balance</th>
                                    <th class="cpd-num">Status</th>
                                    <th class="cpd-num">Detail</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var invoice in pagedInvoices)
                                {
                                    var status = InvoiceStatus(invoice);
                                    <tr>
                                        <td data-label="Invoice">
                                            @* One element, not two: below 992px each cell becomes a
                                               labelled grid row, and a second child would be placed
                                               into the label track. *@
                                            <span class="cpd-doc">
                                                <span class="cpd-doc-id">@invoice.DocNum</span>
                                                <span class="cpd-doc-sub">Issued @invoice.DocDate.ToString("MMM dd, yyyy")</span>
                                            </span>
                                        </td>
                                        @if (isMultiAccount)
                                        {
                                            <td data-label="Account" class="cpd-quiet">
                                                <span class="cpd-doc">
                                                    <span class="cpd-doc-id">@(invoice.CardCode ?? "—")</span>
                                                    <span class="cpd-doc-sub">@(invoice.Currency ?? "")</span>
                                                </span>
                                            </td>
                                        }
                                        <td data-label="Due" class="cpd-quiet">
                                            @(invoice.DueDate?.ToString("MMM dd, yyyy") ?? "—")
                                        </td>
                                        <td data-label="Amount" class="cpd-num">@FormatCurrency(invoice.DocTotal)</td>
                                        <td data-label="Paid" class="cpd-num cpd-quiet">@FormatCurrency(invoice.PaidToDate)</td>
                                        <td data-label="Balance" class="cpd-num cpd-strong">@FormatCurrency(invoice.Balance)</td>
                                        <td data-label="Status" class="cpd-num">
                                            <span class="cpd-status @status.Cls">@status.Text</span>
                                        </td>
                                        <td data-label="Detail" class="cpd-num">
                                            <button type="button" class="btn btn-outline-primary btn-sm"
                                                    @onclick="() => ViewInvoiceDetails(invoice)">
                                                View
                                            </button>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>

                    @if (totalPages > 1)
                    {
                        <div class="cpd-pager">
                            <div class="cpd-pager-info">
                                Showing @(((currentPage - 1) * pageSize) + 1)&ndash;@(Math.Min(currentPage * pageSize, filteredInvoices.Count))
                                of @filteredInvoices.Count invoices
                            </div>
                            <nav aria-label="Invoice pages">
                                <ul class="pagination pagination-sm mb-0">
                                    <li class="page-item @(currentPage == 1 ? "disabled" : "")">
                                        <button class="page-link" @onclick="() => GoToPage(currentPage - 1)"
                                                disabled="@(currentPage == 1)" aria-label="Previous page">
                                            <i class="ph ph-caret-left"></i>
                                        </button>
                                    </li>
                                    @foreach (var pg in GetVisiblePages())
                                    {
                                        @if (pg == -1)
                                        {
                                            <li class="page-item disabled"><span class="page-link">&hellip;</span></li>
                                        }
                                        else
                                        {
                                            <li class="page-item @(pg == currentPage ? "active" : "")">
                                                <button class="page-link" @onclick="() => GoToPage(pg)">@pg</button>
                                            </li>
                                        }
                                    }
                                    <li class="page-item @(currentPage == totalPages ? "disabled" : "")">
                                        <button class="page-link" @onclick="() => GoToPage(currentPage + 1)"
                                                disabled="@(currentPage == totalPages)" aria-label="Next page">
                                            <i class="ph ph-caret-right"></i>
                                        </button>
                                    </li>
                                </ul>
                            </nav>
                        </div>
                    }
                }
                else
                {
                    <div class="cpd-empty">No open invoices found for the selected period.</div>
                }
            </section>
        }
        else
        {
            <div class="cpd-panel">
                <div class="cpd-empty">
                    <i class="ph ph-receipt"></i>
                    <h5>Choose a period</h5>
                    <p>Set the dates above and load your open invoices.</p>
                </div>
            </div>
        }
    }
</div>

@* The detail sheet. It renders inside CustomerPortalLayout, so `.cpx` is above
   it and it needs no peer scope class of its own. *@
@if (showInvoiceModal)
{
    <div class="cpd cpd-overlay" role="dialog" aria-modal="true" aria-label="Invoice detail">
        <div class="cpd-sheet">
            <div class="cpd-sheet-head">
                <i class="ph ph-receipt"></i>
                <h5>Invoice @(selectedInvoice?.DocNum ?? selectedInvoiceSummary?.DocNum)</h5>
                <button type="button" class="cpd-sheet-close" @onclick="CloseInvoiceModal" aria-label="Close">
                    <i class="ph ph-x"></i>
                </button>
            </div>

            <div class="cpd-sheet-body">
                @if (isDetailLoading)
                {
                    <div class="cpd-empty">
                        <div class="spinner-border" role="status" style="width: 2rem; height: 2rem;">
                            <span class="visually-hidden">Loading...</span>
                        </div>
                        <p class="mt-3 mb-0">Loading invoice details...</p>
                    </div>
                }
                else if (!string.IsNullOrEmpty(detailError))
                {
                    <div class="alert alert-danger mb-0">@detailError</div>
                }
                else if (selectedInvoice == null)
                {
                    <div class="alert alert-warning mb-0">Invoice details are not available.</div>
                }
                else
                {
                    <div class="cpd-defs">
                        <div class="cpd-def">
                            <span class="cpd-def-k">Invoice date</span>
                            <span class="cpd-def-v">@FormatDate(selectedInvoice.DocDate)</span>
                        </div>
                        <div class="cpd-def">
                            <span class="cpd-def-k">Due date</span>
                            <span class="cpd-def-v">@FormatDate(selectedInvoice.DocDueDate)</span>
                        </div>
                        <div class="cpd-def">
                            <span class="cpd-def-k">Amount</span>
                            <span class="cpd-def-v is-lg">
                                @FormatCurrencyWithCode(selectedInvoice.DocTotal, selectedInvoice.DocCurrency)
                            </span>
                        </div>
                        <div class="cpd-def">
                            <span class="cpd-def-k">VAT</span>
                            <span class="cpd-def-v">
                                @FormatCurrencyWithCode(selectedInvoice.VatSum, selectedInvoice.DocCurrency)
                            </span>
                        </div>
                        <div class="cpd-def">
                            <span class="cpd-def-k">Reference</span>
                            <span class="cpd-def-v">@(string.IsNullOrWhiteSpace(selectedInvoice.NumAtCard) ? "—" : selectedInvoice.NumAtCard)</span>
                        </div>
                        <div class="cpd-def">
                            <span class="cpd-def-k">Status</span>
                            <span class="cpd-def-v">
                                @if (selectedInvoiceSummary is not null)
                                {
                                    var status = InvoiceStatus(selectedInvoiceSummary);
                                    <span class="cpd-status @status.Cls">@status.Text</span>
                                }
                                else
                                {
                                    <text>—</text>
                                }
                            </span>
                        </div>
                    </div>

                    <div>
                        <div class="cpd-sub-head">
                            <i class="ph ph-list-bullets"></i> Items invoiced
                        </div>
                        @if (selectedInvoice.Lines?.Any() == true)
                        {
                            <div class="table-responsive">
                                <table class="cpd-table mobile-card-table">
                                    <thead>
                                        <tr>
                                            <th>Item</th>
                                            <th class="cpd-num">Qty</th>
                                            <th>UoM</th>
                                            <th class="cpd-num">Gross price</th>
                                            <th class="cpd-num">Total</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var line in selectedInvoice.Lines)
                                        {
                                            <tr>
                                                <td data-label="Item">
                                                    <span class="cpd-doc">
                                                        <span class="cpd-doc-id">@line.ItemDescription</span>
                                                        <span class="cpd-doc-sub">@line.ItemCode</span>
                                                    </span>
                                                </td>
                                                <td data-label="Qty" class="cpd-num">
                                                    @QuantityDisplay.Format(line.Quantity, line.UoMCode)
                                                </td>
                                                <td data-label="UoM" class="cpd-quiet">@(line.UoMCode ?? "—")</td>
                                                <td data-label="Gross price" class="cpd-num cpd-quiet">
                                                    @FormatCurrencyWithCode(line.GrossPrice, selectedInvoice.DocCurrency)
                                                </td>
                                                <td data-label="Total" class="cpd-num cpd-strong">
                                                    @FormatCurrencyWithCode(line.LineTotal, selectedInvoice.DocCurrency)
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                        else
                        {
                            <div class="cpd-empty">No line items available for this invoice.</div>
                        }
                    </div>

                    <div>
                        <div class="cpd-sub-head">
                            <i class="ph ph-file-arrow-down"></i> Proof of delivery
                        </div>
                        @if (podAttachments.Any())
                        {
                            @foreach (var attachment in podAttachments)
                            {
                                <div class="cpd-media">
                                    <span class="cpd-media-icon"><i class="ph ph-paperclip"></i></span>
                                    <div class="cpd-media-text">
                                        <div class="cpd-media-title">@attachment.FileName</div>
                                        <div class="cpd-media-sub">
                                            @attachment.FileSizeFormatted &middot; @attachment.UploadedAt.ToString("MMM dd, yyyy")
                                            @if (!string.IsNullOrWhiteSpace(attachment.Description))
                                            {
                                                <span>&middot; @attachment.Description</span>
                                            }
                                        </div>
                                    </div>
                                    <div class="cpd-media-action">
                                        <button type="button" class="btn btn-outline-primary btn-sm"
                                                @onclick="() => DownloadAttachment(attachment)">
                                            View POD
                                        </button>
                                    </div>
                                </div>
                            }
                        }
                        else
                        {
                            <div class="cpd-empty">No POD is attached to this invoice yet.</div>
                        }
                    </div>
                }
            </div>

            <div class="cpd-sheet-foot">
                <button type="button" class="btn btn-outline-primary" @onclick="CloseInvoiceModal">Close</button>
                <MudButton ButtonType="ButtonType.Button" Variant="Variant.Filled" Color="Color.Primary"
                           OnClick="DownloadInvoicePdf" Disabled="@(isPdfLoading || selectedInvoice == null)">
                    @if (isPdfLoading)
                    {
                        <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="me-2" />
                        <span>Generating...</span>
                    }
                    else
                    {
                        <span>Download PDF</span>
                    }
                </MudButton>
            </div>
        </div>
    </div>
}

@code {
    private CustomerPortalSession? portalSession;
    private CustomerInfo? customerInfo;
    private List<CustomerInvoiceSummary> invoices = new();
    private bool isLoading = true;
    private bool hasLoaded = false;
    private int currentPage = 1;
    private int pageSize = 15;
    private int totalPages => (int)Math.Ceiling((double)filteredInvoices.Count / pageSize);
    private List<CustomerInvoiceSummary> pagedInvoices => filteredInvoices
        .Skip((currentPage - 1) * pageSize)
        .Take(pageSize)
        .ToList();
    private DateTime? lastUpdated;
    private decimal totalOutstanding;
    private decimal filteredOutstanding => filteredInvoices.Sum(i => i.Balance);
    private bool isMultiAccount;
    private DateTime? fromDate = DateTime.Today.AddMonths(-3);
    private DateTime? toDate = DateTime.Today;
    private CustomerInvoiceSummary? selectedInvoiceSummary;
    private InvoiceDto? selectedInvoice;
    private List<DocumentAttachmentDto> podAttachments = new();
    private bool showInvoiceModal;
    private bool isDetailLoading;
    private string? detailError;
    private bool isPdfLoading;
    private string selectedAccountFilter = "";
    private List<LinkedAccountInfo> linkedAccounts = new();
    private List<CustomerInvoiceSummary> filteredInvoices => string.IsNullOrEmpty(selectedAccountFilter)
        ? invoices
        : invoices.Where(i => i.CardCode == selectedAccountFilter).ToList();

    private List<CustomerInvoiceSummary> OpenInvoices => filteredInvoices.Where(i => i.Balance > 0).ToList();

    private int OpenCount => OpenInvoices.Count;

    private int PaidCount => filteredInvoices.Count - OpenCount;

    private decimal OverdueAmount => OpenInvoices.Where(i => i.DaysOverdue > 0).Sum(i => i.Balance);

    private int OverdueCount => OpenInvoices.Count(i => i.DaysOverdue > 0);

    private int OldestOverdueDays => OpenInvoices.Any(i => i.DaysOverdue > 0)
        ? OpenInvoices.Max(i => i.DaysOverdue)
        : 0;

    /// <summary>
    /// The soonest invoice not yet over terms. Deliberately not "the oldest open
    /// invoice": one already past due is stated by the overdue figure beside it,
    /// and counting it twice would make the row read as more debt than there is.
    /// </summary>
    private CustomerInvoiceSummary? NextDue => OpenInvoices
        .Where(i => i.DaysOverdue <= 0 && i.DueDate.HasValue)
        .OrderBy(i => i.DueDate)
        .FirstOrDefault();

    protected override async Task OnInitializedAsync()
    {
        // Loading here rather than in OnAfterRender starts the fetch before the first render
        // instead of after it. The guard keeps the session read off any non-interactive pass;
        // see CustomerPortalLayout for why it is here even though prerendering is off.
        if (!RendererInfo.IsInteractive)
        {
            return;
        }

        await LoadCustomerInfo();
        isLoading = false;
    }

    private async Task LoadCustomerInfo()
    {
        try
        {
            portalSession = await CustomerSession.GetCurrentSessionAsync();
            customerInfo = portalSession?.Customer;

            if (customerInfo != null)
            {
                isMultiAccount = customerInfo.AccountStructure == "Multi";
                linkedAccounts = portalSession?.LinkedAccounts.ToList() ?? new List<LinkedAccountInfo>();
                selectedAccountFilter = CustomerSession.CanAccessCardCode(portalSession, selectedAccountFilter)
                    ? selectedAccountFilter
                    : string.Empty;
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error loading customer info");
        }
    }

    private async Task LoadInvoices()
    {
        if (customerInfo == null) return;

        isLoading = true;

        try
        {
            invoices = await StatementService.GetOpenInvoicesAsync(customerInfo.CardCode, fromDate, toDate);
            totalOutstanding = invoices.Sum(i => i.Balance);
            lastUpdated = DateTime.UtcNow;
            hasLoaded = true;
            currentPage = 1;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error loading invoices");
        }
        finally
        {
            isLoading = false;
        }
    }

    private void OnAccountFilterChanged(string value)
    {
        if (!CustomerSession.CanAccessCardCode(portalSession, value))
        {
            Logger.LogWarning("Rejected unauthorized customer invoice account filter {CardCode}", value);
            selectedAccountFilter = string.Empty;
            currentPage = 1;
            return;
        }

        selectedAccountFilter = value;
        currentPage = 1;
    }

    private async Task ViewInvoiceDetails(CustomerInvoiceSummary invoice)
    {
        showInvoiceModal = true;
        isDetailLoading = true;
        detailError = null;
        selectedInvoiceSummary = invoice;
        selectedInvoice = null;
        podAttachments = new List<DocumentAttachmentDto>();

        try
        {
            selectedInvoice = await InvoiceService.GetInvoiceByDocEntryAsync(invoice.DocEntry);
            var attachmentsResponse = await Http.GetFromJsonAsync<DocumentAttachmentListResponse>(
                $"api/invoice/{invoice.DocEntry}/attachments");
            var attachments = attachmentsResponse?.Attachments ?? new List<DocumentAttachmentDto>();
            podAttachments = attachments.Where(IsPodAttachment).ToList();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error loading invoice details for {DocEntry}", invoice.DocEntry);
            detailError = "Unable to load invoice details. Please try again.";
        }
        finally
        {
            isDetailLoading = false;
        }
    }

    private void CloseInvoiceModal()
    {
        showInvoiceModal = false;
        selectedInvoiceSummary = null;
        selectedInvoice = null;
        podAttachments = new List<DocumentAttachmentDto>();
        detailError = null;
    }

    private async Task DownloadInvoicePdf()
    {
        if (selectedInvoice == null || isPdfLoading) return;
        isPdfLoading = true;
        try
        {
            var pdfBytes = await InvoiceService.GetInvoicePdfAsync(selectedInvoice.DocEntry);
            if (pdfBytes == null || pdfBytes.Length == 0)
            {
                detailError = "Failed to retrieve invoice PDF.";
                return;
            }
            var base64 = Convert.ToBase64String(pdfBytes);
            var fileName = $"Invoice_{selectedInvoice.DocNum}.pdf";
            await JSRuntime.InvokeVoidAsync("downloadPdfFromBase64", base64, fileName);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error downloading invoice PDF for DocEntry {DocEntry}", selectedInvoice.DocEntry);
            detailError = "Failed to download invoice PDF.";
        }
        finally
        {
            isPdfLoading = false;
        }
    }

    private async Task DownloadAttachment(DocumentAttachmentDto attachment)
    {
        if (selectedInvoiceSummary == null)
        {
            detailError = "Invoice details are missing. Please try again.";
            return;
        }

        try
        {
            var response = await Http.GetAsync(
                $"api/invoice/{selectedInvoiceSummary.DocEntry}/attachments/{attachment.Id}/download");

            if (!response.IsSuccessStatusCode)
            {
                detailError = "Unable to download the POD. Please try again.";
                return;
            }

            var content = await response.Content.ReadAsByteArrayAsync();
            var base64 = Convert.ToBase64String(content);
            var contentType = attachment.MimeType ?? "application/octet-stream";
            await JSRuntime.InvokeVoidAsync("downloadFile", attachment.FileName, contentType, base64);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error downloading attachment {AttachmentId}", attachment.Id);
            detailError = "Unable to download the POD. Please try again.";
        }
    }

    private string FormatCurrency(decimal amount)
    {
        return $"${amount:N2}";
    }

    private string FormatCurrencyWithCode(decimal amount, string? currency)
    {
        if (string.IsNullOrWhiteSpace(currency))
        {
            return FormatCurrency(amount);
        }

        return $"{currency} {amount:N2}";
    }

    private static string Plural(int count, string noun) => count == 1 ? noun : noun + "s";

    /// <summary>The period the figures cover, as the filter currently states it.</summary>
    private string PeriodCaption()
    {
        if (fromDate is null && toDate is null) return "All invoices on record";
        if (fromDate is null) return $"Up to {toDate:MMM dd, yyyy}";
        if (toDate is null) return $"Since {fromDate:MMM dd, yyyy}";
        return $"{fromDate:MMM dd, yyyy} – {toDate:MMM dd, yyyy}";
    }

    /// <summary>
    /// Which accounts the list is showing, for a customer whose portal login
    /// reaches more than one.
    /// </summary>
    private string AccountScopeCaption()
    {
        if (string.IsNullOrEmpty(selectedAccountFilter))
        {
            return "All main accounts";
        }

        return linkedAccounts.FirstOrDefault(a => a.CardCode == selectedAccountFilter)?.CardName
            ?? selectedAccountFilter;
    }

    private string NextDueCaption()
    {
        if (NextDue?.DueDate is not { } dueOn)
        {
            return OpenCount > 0 ? "Everything open is past due" : "Nothing outstanding";
        }

        var days = (dueOn.Date - DateTime.Today).Days;
        var when = days switch
        {
            <= 0 => "due today",
            1 => "due tomorrow",
            _ => $"due in {days} days"
        };

        return $"Invoice {NextDue.DocNum} — {when}";
    }

    private static bool IsPodAttachment(DocumentAttachmentDto attachment)
    {
        var label = $"{attachment.FileName} {attachment.Description}";
        return label.Contains("pod", StringComparison.OrdinalIgnoreCase)
            || label.Contains("proof of delivery", StringComparison.OrdinalIgnoreCase);
    }

    private void GoToPage(int page)
    {
        if (page >= 1 && page <= totalPages)
        {
            currentPage = page;
        }
    }

    private List<int> GetVisiblePages()
    {
        var pages = new List<int>();
        if (totalPages <= 7)
        {
            for (int i = 1; i <= totalPages; i++) pages.Add(i);
            return pages;
        }

        pages.Add(1);
        if (currentPage > 3) pages.Add(-1); // ellipsis

        int start = Math.Max(2, currentPage - 1);
        int end = Math.Min(totalPages - 1, currentPage + 1);
        for (int i = start; i <= end; i++) pages.Add(i);

        if (currentPage < totalPages - 2) pages.Add(-1); // ellipsis
        pages.Add(totalPages);
        return pages;
    }

    /// <summary>The same three states the dashboard's ledger states, said the same way.</summary>
    private static (string Cls, string Text) InvoiceStatus(CustomerInvoiceSummary invoice)
    {
        if (invoice.Balance <= 0) return ("is-paid", "Paid");
        if (invoice.DaysOverdue > 0) return ("is-over", $"{invoice.DaysOverdue} {Plural(invoice.DaysOverdue, "day")} over");
        return (string.Empty, "Current");
    }

    private string FormatDate(string? dateStr)
    {
        if (string.IsNullOrWhiteSpace(dateStr))
        {
            return "—";
        }

        return DateTime.TryParse(dateStr, out var date)
            ? date.ToString("MMM dd, yyyy")
            : dateStr;
    }
}
