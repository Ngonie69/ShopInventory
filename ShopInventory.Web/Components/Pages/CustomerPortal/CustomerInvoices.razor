@page "/customer-portal/invoices"
@using System.Globalization
@using ShopInventory.Web.Models
@inject ICustomerStatementService StatementService
@inject IInvoiceService InvoiceService
@inject ICustomerPortalSessionService CustomerSession
@inject HttpClient Http
@inject IJSRuntime JSRuntime
@inject ILogger<CustomerInvoices> Logger
@attribute [AllowAnonymous]
@rendermode InteractiveServer
@layout CustomerPortalLayout

<PageTitle>Invoices - Customer Portal</PageTitle>

@* On the portal's page vocabulary (`cpd`, see customer-portal.css) plus this page's
   own `cpi` block, from the "Customer Portal Invoices Redesign" design: one-click
   periods instead of a date form, a balance summary whose age bands filter the
   list, and a side drawer for the detail. `cpx` comes down from the shell. *@
<div class="cpd cpi fade-in">
    @if (isLoading && customerInfo == null)
    {
        <div class="cpd-panel">
            <div class="cpd-empty">
                <div class="spinner-border" role="status" style="width: 2.25rem; height: 2.25rem;">
                    <span class="visually-hidden">Loading...</span>
                </div>
                <p class="mt-3 mb-0">Loading invoices...</p>
            </div>
        </div>
    }
    else if (customerInfo == null)
    {
        <div class="cpd-panel">
            <div class="cpd-empty">
                <i class="ph ph-lock-key"></i>
                <h5>Authentication required</h5>
                <p>Please sign in to see your invoices.</p>
                <a href="/customer-portal/login" class="btn btn-primary">Sign in to the portal</a>
            </div>
        </div>
    }
    else
    {
        <div class="cpd-hero">
            <div class="cpd-hero-text">
                <h2>Invoices</h2>
                <div class="cpd-hero-meta">
                    <span>@customerInfo.CardName</span>
                    <span>Account @customerInfo.CardCode</span>
                    @if (isMultiAccount)
                    {
                        <span>@AccountScopeCaption()</span>
                    }
                </div>
            </div>
            <div class="cpd-hero-actions">
                <a href="/customer-portal/statements" class="btn btn-outline-primary">
                    <i class="ph ph-file-text"></i> View statement
                </a>
            </div>
        </div>

        @if (!hasLoaded)
        {
            @if (isLoading)
            {
                <div class="cpd-panel">
                    <div class="cpd-empty">
                        <div class="spinner-border" role="status" style="width: 2.25rem; height: 2.25rem;">
                            <span class="visually-hidden">Loading...</span>
                        </div>
                        <p class="mt-3 mb-0">Loading your invoices...</p>
                    </div>
                </div>
            }
            else
            {
                @* First visit. Nothing has been read yet: the customer says which invoices
                   they want, and one click both chooses and loads. *@
                <section class="cpd-panel cpi-start" aria-labelledby="cpi-start-title">
                    <span class="cpi-start-icon"><i class="ph ph-receipt"></i></span>
                    <h3 id="cpi-start-title">Which invoices would you like to see?</h3>
                    <p class="cpi-start-lede">Pick a period and your open invoices load straight from our accounts.</p>
                    <div class="cpi-choices">
                        @foreach (var preset in Presets)
                        {
                            <button type="button"
                                    class="cpi-choice @(showCustom && preset.Key == CustomKey ? "is-on" : "")"
                                    @onclick="() => ChoosePreset(preset.Key)">
                                <span class="cpi-choice-icon"><i class="ph @preset.Icon"></i></span>
                                <span class="cpi-choice-title">@preset.Choice</span>
                                <span class="cpi-choice-sub">@ChoiceCaption(preset)</span>
                            </button>
                        }
                    </div>
                    @if (!string.IsNullOrEmpty(loadError))
                    {
                        <p class="cpd-filter-note" role="alert">@loadError</p>
                    }
                    <p class="cpi-start-foot">
                        Need every transaction on the account, payments included?
                        <a href="/customer-portal/statements">Open your statement</a>
                    </p>
                </section>
            }
        }
        else
        {
            @* The period bar: what is loaded, and the one click that changes it. *@
            <div class="cpi-bar">
                <div class="cpi-seg" role="group" aria-label="Period">
                    @foreach (var preset in Presets)
                    {
                        var on = IsPresetOn(preset.Key);
                        <button type="button" class="@(on ? "is-on" : "")" aria-pressed="@(on ? "true" : "false")"
                                disabled="@isLoading" @onclick="() => ChoosePreset(preset.Key)">
                            @preset.Label
                        </button>
                    }
                </div>
                <span class="cpi-range">@LoadedRangeCaption()</span>
                @if (isMultiAccount && linkedAccounts.Any())
                {
                    <div class="cpi-account">
                        @* The lambda is not a style choice: passing the method group makes
                           TValue inference fail on an error that names EventCallback. *@
                        <NocturneSelect Id="cinv-f-account" Class="nsel-block" TValue="string"
                                        Options="AccountFilterOptions" Value="@selectedAccountFilter"
                                        ValueChanged="@(code => OnAccountFilterChanged(code ?? string.Empty))"
                                        Caption="Filter by account" AriaLabel="Filter by account"
                                        Placeholder="All accounts" />
                    </div>
                }
                <span class="cpi-updated">
                    @(lastUpdated.HasValue ? $"Updated {lastUpdated.Value:HH:mm} UTC" : "")
                </span>
                <button type="button" class="btn btn-outline-primary cpi-icon-btn" aria-label="Reload invoices"
                        disabled="@isLoading" @onclick="LoadInvoices">
                    <i class="ph ph-arrow-clockwise @(isLoading ? "cpi-spin" : "")"></i>
                </button>
            </div>
            @if (!string.IsNullOrEmpty(loadError))
            {
                <p class="cpd-filter-note cpi-bar-note" role="alert">@loadError</p>
            }
        }

        @if (showCustom)
        {
            @* Every control here is one of the portal's own. NocturneDateField keeps the
               shorthand entry FlexibleDatePicker was written for and draws the portal's
               calendar. See .claude/skills/nocturne-dropdowns-and-dates. *@
            <section class="cpd-panel cpi-custom" aria-label="Custom period">
                <div class="cpd-filters">
                    <div class="cpd-field">
                        <label class="cpd-field-label" for="cinv-f-from">From</label>
                        <NocturneDateField Id="cinv-f-from" @bind-Date="fromDate" AriaLabel="From date" />
                    </div>
                    <div class="cpd-field">
                        <label class="cpd-field-label" for="cinv-f-to">To</label>
                        <NocturneDateField Id="cinv-f-to" @bind-Date="toDate" AriaLabel="To date" />
                    </div>
                    <div class="cpd-field cpd-field-action">
                        <button type="button" class="btn btn-primary" @onclick="ApplyCustom"
                                disabled="@(isLoading || !HasPeriod || PeriodIsInverted)">
                            @if (isLoading)
                            {
                                <span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>
                                <span>Loading</span>
                            }
                            else
                            {
                                <span>Load invoices</span>
                            }
                        </button>
                    </div>
                </div>
                @if (PeriodIsInverted)
                {
                    <p class="cpd-filter-note" role="alert">
                        The From date falls after the To date. Swap them to load invoices.
                    </p>
                }
            </section>
        }

        @if (hasLoaded)
        {
            var open = OpenInvoices;
            var bands = AgeBands(open);

            <section class="cpd-panel cpi-summary" aria-label="Balance summary">
                <div class="cpi-figs">
                    <div class="cpi-fig">
                        <span class="cpd-kpi-label">Outstanding</span>
                        <span class="cpi-fig-num is-lead">@FormatCurrency(open.Sum(i => i.Balance))</span>
                        <span class="cpd-kpi-sub">across @open.Count open @Plural(open.Count, "invoice")</span>
                    </div>
                    <div class="cpi-fig @(OverdueAmount(open) > 0 ? "is-alert" : "")">
                        <span class="cpd-kpi-label">Overdue</span>
                        <span class="cpi-fig-num">@FormatCurrency(OverdueAmount(open))</span>
                        <span class="cpd-kpi-sub">@OverdueCaption(open)</span>
                    </div>
                    <div class="cpi-fig">
                        <span class="cpd-kpi-label">Next due</span>
                        <span class="cpi-fig-num">@(NextDue(open) is { } next ? FormatCurrency(next.Balance) : "—")</span>
                        <span class="cpd-kpi-sub">@NextDueCaption(open)</span>
                    </div>
                </div>

                <div class="cpi-age">
                    <div class="cpi-age-head">
                        <span class="cpd-kpi-label">Balance by age</span>
                        <span class="cpi-age-hint">Select a band to list its invoices</span>
                    </div>
                    @* Bands grown by their share, as on the dashboard — and an invariant
                       format, because a comma decimal separator is not a CSS number. *@
                    <div class="cpd-aging-bar" role="img" aria-label="@AgeBarLabel(bands)">
                        @foreach (var band in bands.Where(b => b.Amount > 0))
                        {
                            <div class="cpd-aging-seg @band.Key"
                                 style="flex: @(band.Amount.ToString("F2", CultureInfo.InvariantCulture))"></div>
                        }
                    </div>
                    <div class="cpd-aging-legend cpi-bands">
                        @foreach (var band in bands)
                        {
                            var empty = band.Amount <= 0;
                            var on = bandFilter == band.Index;
                            <button type="button"
                                    class="cpd-aging-item cpi-band @band.Key @(empty ? "is-empty" : "") @(on ? "is-on" : "")"
                                    aria-pressed="@(on ? "true" : "false")" disabled="@empty"
                                    @onclick="() => SelectBand(band.Index)">
                                <span class="cpd-aging-key"><span class="cpd-dot"></span>@band.Label</span>
                                <span class="cpd-aging-val">@(empty ? "—" : FormatCurrency(band.Amount))</span>
                                @if (!empty)
                                {
                                    <span class="cpd-aging-sub">@band.Count @Plural(band.Count, "invoice")</span>
                                }
                            </button>
                        }
                    </div>
                </div>
            </section>

            var listed = ListedInvoices(open);
            var totalPages = Math.Max(1, (int)Math.Ceiling(listed.Count / (double)PageSize));
            var page = Math.Clamp(currentPage, 1, totalPages);
            var paged = listed.Skip((page - 1) * PageSize).Take(PageSize).ToList();

            <section class="cpd-panel cpd-ledger cpi-list" aria-label="Invoice list">
                <div class="cpi-list-head">
                    <div class="cpi-tabs" role="group" aria-label="Show invoices">
                        @foreach (var tab in Tabs(open))
                        {
                            var on = bandFilter is null && listTab == tab.Tab;
                            <button type="button" class="cpi-tab @(on ? "is-on" : "")"
                                    aria-pressed="@(on ? "true" : "false")" @onclick="() => SelectTab(tab.Tab)">
                                @tab.Label <span class="cpi-tab-count">@tab.Count</span>
                            </button>
                        }
                    </div>
                    <div class="cpi-search">
                        <i class="ph ph-magnifying-glass" aria-hidden="true"></i>
                        <input type="search" class="cpd-input" placeholder="Search invoice number"
                               aria-label="Search invoice number" inputmode="numeric"
                               @bind="searchText" @bind:event="oninput" @bind:after="ResetPage" />
                    </div>
                </div>

                @if (bandFilter is int shownBand)
                {
                    <div class="cpi-filtered" role="status">
                        <span class="cpi-filtered-key @bands[shownBand].Key"><span class="cpd-dot"></span>@BandFilterCaption(bands[shownBand])</span>
                        <button type="button" class="btn btn-sm btn-outline-primary" @onclick="ClearBand">Show all open</button>
                    </div>
                }

                @if (!string.IsNullOrEmpty(listNotice))
                {
                    <p class="cpd-filter-note cpi-list-note" role="alert">@listNotice</p>
                }

                @if (paged.Any())
                {
                    @* Two renderings of the same rows: a ledger where it fits, and cards where
                       it does not. A container query on `.cpd` picks one, so a laptop with the
                       portal drawer open gets cards for the same reason a phone does. *@
                    <div class="table-responsive cpi-table-wrap">
                        <table class="cpd-table cpi-table">
                            <thead>
                                <tr>
                                    <th>Invoice</th>
                                    @if (isMultiAccount)
                                    {
                                        <th>Account</th>
                                    }
                                    <th>Status</th>
                                    <th>Due date</th>
                                    <th class="cpd-num">Amount</th>
                                    <th class="cpd-num">Paid</th>
                                    <th class="cpd-num">Balance</th>
                                    <th class="cpd-num"><span class="visually-hidden">Actions</span></th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var invoice in paged)
                                {
                                    var status = InvoiceStatus(invoice);
                                    <tr>
                                        <td>
                                            <span class="cpd-doc">
                                                @* Stretched across the row, so the whole row opens
                                                   the drawer while only this button is in the tab
                                                   order for it. *@
                                                <button type="button" class="cpi-doc-btn cpd-doc-id"
                                                        aria-label="Open invoice @invoice.DocNum"
                                                        @onclick="() => ViewInvoiceDetails(invoice)">
                                                    @invoice.DocNum
                                                </button>
                                                <span class="cpd-doc-sub">Issued @invoice.DocDate.ToString("MMM dd, yyyy")</span>
                                            </span>
                                        </td>
                                        @if (isMultiAccount)
                                        {
                                            <td class="cpd-quiet">
                                                <span class="cpd-doc">
                                                    <span>@(invoice.CardCode ?? "—")</span>
                                                    <span class="cpd-doc-sub">@(invoice.Currency ?? "")</span>
                                                </span>
                                            </td>
                                        }
                                        <td><span class="cpd-status @status.Cls">@status.Text</span></td>
                                        <td class="cpd-quiet">@(invoice.DueDate?.ToString("MMM dd, yyyy") ?? "—")</td>
                                        <td class="cpd-num">@FormatCurrency(invoice.DocTotal)</td>
                                        <td class="cpd-num cpd-quiet">@(invoice.PaidToDate > 0 ? FormatCurrency(invoice.PaidToDate) : "—")</td>
                                        <td class="cpd-num cpd-strong">@FormatCurrency(invoice.Balance)</td>
                                        <td class="cpd-num">
                                            <span class="cpi-acts">
                                                <button type="button" class="btn btn-sm cpi-icon-btn cpi-row-pdf"
                                                        aria-label="Download invoice @invoice.DocNum as PDF"
                                                        disabled="@(rowPdfDocEntry == invoice.DocEntry)"
                                                        @onclick="() => DownloadRowPdf(invoice)">
                                                    @if (rowPdfDocEntry == invoice.DocEntry)
                                                    {
                                                        <span class="spinner-border spinner-border-sm" aria-hidden="true"></span>
                                                    }
                                                    else
                                                    {
                                                        <i class="ph ph-download-simple"></i>
                                                    }
                                                </button>
                                                <i class="ph ph-caret-right cpi-row-caret" aria-hidden="true"></i>
                                            </span>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                            <tfoot>
                                <tr>
                                    <td colspan="@(isMultiAccount ? 4 : 3)" class="cpd-quiet">
                                        @listed.Count @Plural(listed.Count, "invoice")
                                    </td>
                                    <td class="cpd-num">@FormatCurrency(listed.Sum(i => i.DocTotal))</td>
                                    <td class="cpd-num cpd-quiet">@FormatCurrency(listed.Sum(i => i.PaidToDate))</td>
                                    <td class="cpd-num">@FormatCurrency(listed.Sum(i => i.Balance))</td>
                                    <td></td>
                                </tr>
                            </tfoot>
                        </table>
                    </div>

                    <ul class="cpi-cards">
                        @foreach (var invoice in paged)
                        {
                            var status = InvoiceStatus(invoice);
                            <li>
                                <button type="button" class="cpi-card" @onclick="() => ViewInvoiceDetails(invoice)">
                                    <span class="cpi-card-row">
                                        <span class="cpi-card-num">@invoice.DocNum</span>
                                        <span class="cpd-status @status.Cls">@status.Text</span>
                                    </span>
                                    <span class="cpi-card-row">
                                        <span class="cpi-card-sub">
                                            @CardCaption(invoice)
                                            @if (isMultiAccount && !string.IsNullOrEmpty(invoice.CardCode))
                                            {
                                                <span class="cpi-card-acct">@invoice.CardCode</span>
                                            }
                                        </span>
                                        <span class="cpi-card-amt">@FormatCurrency(invoice.Balance)</span>
                                    </span>
                                </button>
                            </li>
                        }
                    </ul>
                    <div class="cpi-cards-total">
                        <span>@listed.Count @Plural(listed.Count, "invoice")</span>
                        <span>Balance <strong>@FormatCurrency(listed.Sum(i => i.Balance))</strong></span>
                    </div>

                    @if (totalPages > 1)
                    {
                        <div class="cpd-pager">
                            <div class="cpd-pager-info">
                                Showing @(((page - 1) * PageSize) + 1)&ndash;@(Math.Min(page * PageSize, listed.Count))
                                of @listed.Count invoices
                            </div>
                            <nav aria-label="Invoice pages">
                                <ul class="pagination pagination-sm mb-0">
                                    <li class="page-item @(page == 1 ? "disabled" : "")">
                                        <button class="page-link" @onclick="() => GoToPage(page - 1, totalPages)"
                                                disabled="@(page == 1)" aria-label="Previous page">
                                            <i class="ph ph-caret-left"></i>
                                        </button>
                                    </li>
                                    @foreach (var pg in GetVisiblePages(page, totalPages))
                                    {
                                        @if (pg == -1)
                                        {
                                            <li class="page-item disabled"><span class="page-link">&hellip;</span></li>
                                        }
                                        else
                                        {
                                            <li class="page-item @(pg == page ? "active" : "")">
                                                <button class="page-link" @onclick="() => GoToPage(pg, totalPages)">@pg</button>
                                            </li>
                                        }
                                    }
                                    <li class="page-item @(page == totalPages ? "disabled" : "")">
                                        <button class="page-link" @onclick="() => GoToPage(page + 1, totalPages)"
                                                disabled="@(page == totalPages)" aria-label="Next page">
                                            <i class="ph ph-caret-right"></i>
                                        </button>
                                    </li>
                                </ul>
                            </nav>
                        </div>
                    }
                }
                else
                {
                    <div class="cpd-empty">
                        <i class="ph ph-receipt"></i>
                        <h5>Nothing to show</h5>
                        <p>@EmptyCaption()</p>
                    </div>
                }
            </section>
        }
    }
</div>

@* The detail drawer. It renders inside CustomerPortalLayout, so `.cpx` is above it
   and it needs no peer scope class of its own. *@
@if (showInvoiceModal)
{
    <div class="cpd cpd-overlay cpi-overlay" @onkeydown="OnDrawerKeyDown">
        <button type="button" class="cpi-scrim" aria-label="Close invoice detail" tabindex="-1"
                @onclick="CloseInvoiceModal"></button>
        <aside class="cpd-sheet cpi-drawer" role="dialog" aria-modal="true" aria-labelledby="cpi-drawer-title"
               tabindex="-1" @ref="drawerRef">
            <div class="cpd-sheet-head">
                <div class="cpi-drawer-title">
                    <span class="cpd-kpi-label">Invoice</span>
                    <span class="cpi-drawer-name">
                        <h5 id="cpi-drawer-title">@(selectedInvoice?.DocNum ?? selectedInvoiceSummary?.DocNum)</h5>
                        @if (selectedInvoiceSummary is not null)
                        {
                            var status = InvoiceStatus(selectedInvoiceSummary);
                            <span class="cpd-status @status.Cls">@status.Text</span>
                        }
                    </span>
                </div>
                <button type="button" class="cpd-sheet-close" @onclick="CloseInvoiceModal" aria-label="Close">
                    <i class="ph ph-x"></i>
                </button>
            </div>

            <div class="cpd-sheet-body">
                @if (selectedInvoiceSummary is { } summary)
                {
                    @* From the list row, so it shows before the document itself arrives. *@
                    <div class="cpi-balance">
                        <span class="cpd-kpi-label">@(summary.Balance > 0 ? "Balance due" : "Paid in full")</span>
                        <span class="cpi-balance-num">@FormatCurrency(summary.Balance)</span>
                        <span class="cpd-kpi-sub">
                            of @FormatCurrency(summary.DocTotal) &middot;
                            @(summary.PaidToDate > 0 ? $"{FormatCurrency(summary.PaidToDate)} paid" : "nothing paid yet")
                        </span>
                        <span class="cpi-paid-bar" aria-hidden="true">
                            <span class="cpi-paid-fill" style="width: @(PaidShare(summary).ToString("F1", CultureInfo.InvariantCulture))%"></span>
                        </span>
                    </div>
                }

                @if (isDetailLoading)
                {
                    <div class="cpd-empty">
                        <div class="spinner-border" role="status" style="width: 2rem; height: 2rem;">
                            <span class="visually-hidden">Loading...</span>
                        </div>
                        <p class="mt-3 mb-0">Loading invoice details...</p>
                    </div>
                }
                else if (!string.IsNullOrEmpty(detailError))
                {
                    <div class="alert alert-danger mb-0">@detailError</div>
                }
                else if (selectedInvoice == null)
                {
                    <div class="alert alert-warning mb-0">Invoice details are not available.</div>
                }
                else
                {
                    <div class="cpd-defs">
                        <div class="cpd-def">
                            <span class="cpd-def-k">Issued</span>
                            <span class="cpd-def-v">@FormatDate(selectedInvoice.DocDate)</span>
                        </div>
                        <div class="cpd-def">
                            <span class="cpd-def-k">Due</span>
                            <span class="cpd-def-v">
                                @FormatDate(selectedInvoice.DocDueDate)
                                @if (selectedInvoiceSummary is not null)
                                {
                                    <span class="cpi-def-sub">@DueRelative(selectedInvoiceSummary)</span>
                                }
                            </span>
                        </div>
                        <div class="cpd-def">
                            <span class="cpd-def-k">Your reference</span>
                            <span class="cpd-def-v">@(string.IsNullOrWhiteSpace(selectedInvoice.NumAtCard) ? "—" : selectedInvoice.NumAtCard)</span>
                        </div>
                        <div class="cpd-def">
                            <span class="cpd-def-k">VAT</span>
                            <span class="cpd-def-v">
                                @FormatCurrencyWithCode(selectedInvoice.VatSum, selectedInvoice.DocCurrency)
                            </span>
                        </div>
                    </div>

                    <div>
                        <div class="cpd-sub-head">
                            <i class="ph ph-list-bullets"></i> Items invoiced
                            @if (selectedInvoice.Lines?.Any() == true)
                            {
                                <span class="cpi-sub-count">@selectedInvoice.Lines.Count @Plural(selectedInvoice.Lines.Count, "line")</span>
                            }
                        </div>
                        @if (selectedInvoice.Lines?.Any() == true)
                        {
                            @* Line totals are before VAT and the gross price may not be, so the
                               two are stated side by side rather than as a multiplication that
                               would not add up. *@
                            <ul class="cpi-lines">
                                @foreach (var line in selectedInvoice.Lines)
                                {
                                    <li class="cpi-line">
                                        <span class="cpi-line-main">
                                            <span class="cpi-line-name">@line.ItemDescription</span>
                                            <span class="cpi-line-meta">
                                                @line.ItemCode &middot; @QuantityDisplay.Format(line.Quantity, line.UoMCode)
                                            </span>
                                        </span>
                                        <span class="cpi-line-money">
                                            <span class="cpi-line-total">@FormatCurrencyWithCode(line.LineTotal, selectedInvoice.DocCurrency)</span>
                                            <span class="cpi-line-meta">Gross price @FormatCurrencyWithCode(line.GrossPrice, selectedInvoice.DocCurrency)</span>
                                        </span>
                                    </li>
                                }
                            </ul>
                        }
                        else
                        {
                            <div class="cpd-empty">No line items available for this invoice.</div>
                        }
                    </div>

                    <div>
                        <div class="cpd-sub-head">
                            <i class="ph ph-file-arrow-down"></i> Proof of delivery
                        </div>
                        @if (podAttachments.Any())
                        {
                            @foreach (var attachment in podAttachments)
                            {
                                <div class="cpd-media">
                                    <span class="cpd-media-icon"><i class="ph ph-paperclip"></i></span>
                                    <div class="cpd-media-text">
                                        <div class="cpd-media-title">@attachment.FileName</div>
                                        <div class="cpd-media-sub">
                                            @attachment.FileSizeFormatted &middot; @attachment.UploadedAt.ToString("MMM dd, yyyy")
                                            @if (!string.IsNullOrWhiteSpace(attachment.Description))
                                            {
                                                <span>&middot; @attachment.Description</span>
                                            }
                                        </div>
                                    </div>
                                    <div class="cpd-media-action">
                                        <button type="button" class="btn btn-outline-primary btn-sm"
                                                @onclick="() => DownloadAttachment(attachment)">
                                            View POD
                                        </button>
                                    </div>
                                </div>
                            }
                        }
                        else
                        {
                            <div class="cpi-none">No signed delivery note is attached to this invoice yet.</div>
                        }
                    </div>
                }
            </div>

            <div class="cpd-sheet-foot">
                <button type="button" class="btn btn-primary cpi-drawer-pdf" @onclick="DownloadInvoicePdf"
                        disabled="@(isPdfLoading || selectedInvoice == null)">
                    @if (isPdfLoading)
                    {
                        <span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>
                        <span>Generating</span>
                    }
                    else
                    {
                        <i class="ph ph-download-simple"></i>
                        <span>Download PDF</span>
                    }
                </button>
                <button type="button" class="btn btn-outline-primary" @onclick="CloseInvoiceModal">Close</button>
            </div>
        </aside>
    </div>
}

@code {
    private const string AllKey = "all";
    private const string CustomKey = "custom";
    private const int PageSize = 15;

    private sealed record PeriodPreset(string Key, string Label, string Choice, string Icon);

    /// <summary>
    /// The periods a customer can ask for. "All open" comes first because it answers the
    /// question most people open this page with — what do I owe — and it costs the same to
    /// read as any other: the service fetches every open invoice for the account and applies
    /// the dates afterwards.
    /// </summary>
    private static readonly PeriodPreset[] Presets =
    {
        new(AllKey, "All open", "Everything open", "ph-stack"),
        new("30", "30 days", "Last 30 days", "ph-calendar-blank"),
        new("90", "90 days", "Last 90 days", "ph-calendar-blank"),
        new("year", "This year", "This year", "ph-calendar"),
        new(CustomKey, "Custom", "Custom dates", "ph-calendar-dots")
    };

    private enum ListTab { Open, Overdue, NotDue }

    private sealed record TabInfo(ListTab Tab, string Label, int Count);

    private sealed record AgeBand(int Index, string Key, string Label, decimal Amount, int Count);

    private CustomerPortalSession? portalSession;
    private CustomerInfo? customerInfo;
    private List<CustomerInvoiceSummary> invoices = new();
    private bool isLoading = true;
    private bool hasLoaded;
    private string? loadError;
    private DateTime? lastUpdated;
    private bool isMultiAccount;
    private string selectedAccountFilter = "";
    private List<LinkedAccountInfo> linkedAccounts = new();

    // Nothing is read until the customer picks a period: this is a live read of their
    // ledger. The first visit therefore opens on the choice, and a choice both picks
    // and loads. The custom fields start blank for the same reason.
    private DateTime? fromDate;
    private DateTime? toDate;
    private bool showCustom;
    private string? loadedPreset;
    private DateTime? loadedFrom;
    private DateTime? loadedTo;

    private ListTab listTab = ListTab.Open;
    private int? bandFilter;
    private string searchText = "";
    private int currentPage = 1;
    private int? rowPdfDocEntry;
    private string? listNotice;

    private CustomerInvoiceSummary? selectedInvoiceSummary;
    private InvoiceDto? selectedInvoice;
    private List<DocumentAttachmentDto> podAttachments = new();
    private bool showInvoiceModal;
    private bool isDetailLoading;
    private string? detailError;
    private bool isPdfLoading;
    private ElementReference drawerRef;
    private bool focusDrawer;

    private bool HasPeriod => fromDate.HasValue && toDate.HasValue;

    // Refused at the button rather than sent: an inverted range is not a query.
    private bool PeriodIsInverted => HasPeriod && fromDate > toDate;

    // Computed rather than static: the list arrives with the session.
    private IEnumerable<NocturneSelectOption<string>> AccountFilterOptions =>
        PortalFilterOptions.Accounts(linkedAccounts);

    /// <summary>Open invoices on the account the filter names, or on every account.</summary>
    private List<CustomerInvoiceSummary> OpenInvoices => invoices
        .Where(i => i.Balance > 0)
        .Where(i => string.IsNullOrEmpty(selectedAccountFilter) || i.CardCode == selectedAccountFilter)
        .ToList();

    /// <summary>
    /// The width of one age band: the customer's payment terms when they are known, else
    /// 30 days — the same rule the dashboard's aging panel uses, so the bands agree.
    /// </summary>
    private int BandWidth => customerInfo?.PaymentTermsDays is > 0 and var days ? days : 30;

    protected override async Task OnInitializedAsync()
    {
        // Loading here rather than in OnAfterRender starts the fetch before the first render
        // instead of after it. The guard keeps the session read off any non-interactive pass;
        // see CustomerPortalLayout for why it is here even though prerendering is off.
        if (!RendererInfo.IsInteractive)
        {
            return;
        }

        await LoadCustomerInfo();
        isLoading = false;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (focusDrawer)
        {
            focusDrawer = false;
            try
            {
                await drawerRef.FocusAsync();
            }
            catch (Exception ex) when (ex is JSException or InvalidOperationException)
            {
                // The drawer closed before it could take focus.
            }
        }
    }

    private async Task LoadCustomerInfo()
    {
        try
        {
            portalSession = await CustomerSession.GetCurrentSessionAsync();
            customerInfo = portalSession?.Customer;

            if (customerInfo != null)
            {
                isMultiAccount = customerInfo.AccountStructure == "Multi";
                linkedAccounts = portalSession?.LinkedAccounts.ToList() ?? new List<LinkedAccountInfo>();
                selectedAccountFilter = CustomerSession.CanAccessCardCode(portalSession, selectedAccountFilter)
                    ? selectedAccountFilter
                    : string.Empty;
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error loading customer info");
        }
    }

    private bool IsPresetOn(string key) => showCustom ? key == CustomKey : key == loadedPreset;

    private async Task ChoosePreset(string key)
    {
        if (key == CustomKey)
        {
            showCustom = true;
            return;
        }

        var today = DateTime.Today;
        (fromDate, toDate) = key switch
        {
            "30" => (today.AddDays(-30), today),
            "90" => (today.AddDays(-90), today),
            "year" => (new DateTime(today.Year, 1, 1), today),
            _ => ((DateTime?)null, (DateTime?)null)
        };

        showCustom = false;
        await LoadPeriod(key);
    }

    private async Task ApplyCustom()
    {
        if (!HasPeriod || PeriodIsInverted)
        {
            return;
        }

        await LoadPeriod(CustomKey);
    }

    /// <summary>Reload the period already on screen.</summary>
    private async Task LoadInvoices()
    {
        if (loadedPreset is null)
        {
            return;
        }

        fromDate = loadedFrom;
        toDate = loadedTo;
        await LoadPeriod(loadedPreset);
    }

    private async Task LoadPeriod(string preset)
    {
        if (customerInfo == null || PeriodIsInverted)
        {
            return;
        }

        isLoading = true;
        loadError = null;
        listNotice = null;

        try
        {
            invoices = await StatementService.GetOpenInvoicesAsync(customerInfo.CardCode, fromDate, toDate);
            lastUpdated = DateTime.UtcNow;
            loadedPreset = preset;
            loadedFrom = fromDate;
            loadedTo = toDate;
            hasLoaded = true;
            showCustom = preset == CustomKey;
            bandFilter = null;
            currentPage = 1;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error loading invoices");
            loadError = "We could not load your invoices just now. Please try again.";
        }
        finally
        {
            isLoading = false;
        }
    }

    private void OnAccountFilterChanged(string value)
    {
        bandFilter = null;
        currentPage = 1;

        if (!CustomerSession.CanAccessCardCode(portalSession, value))
        {
            Logger.LogWarning("Rejected unauthorized customer invoice account filter {CardCode}", value);
            selectedAccountFilter = string.Empty;
            return;
        }

        selectedAccountFilter = value;
    }

    private void SelectTab(ListTab tab)
    {
        listTab = tab;
        bandFilter = null;
        currentPage = 1;
    }

    private void SelectBand(int band)
    {
        bandFilter = bandFilter == band ? null : band;
        currentPage = 1;
    }

    private void ClearBand()
    {
        bandFilter = null;
        currentPage = 1;
    }

    private void ResetPage() => currentPage = 1;

    private List<CustomerInvoiceSummary> ListedInvoices(List<CustomerInvoiceSummary> open)
    {
        IEnumerable<CustomerInvoiceSummary> rows = bandFilter is int band
            ? open.Where(i => BandOf(i) == band)
            : listTab switch
            {
                ListTab.Overdue => open.Where(i => i.DaysOverdue > 0),
                ListTab.NotDue => open.Where(i => i.DaysOverdue <= 0),
                _ => open
            };

        var needle = searchText.Trim();
        if (needle.Length > 0)
        {
            rows = rows.Where(i => i.DocNum.ToString(CultureInfo.InvariantCulture)
                .Contains(needle, StringComparison.Ordinal));
        }

        return rows.ToList();
    }

    private static IEnumerable<TabInfo> Tabs(List<CustomerInvoiceSummary> open) => new[]
    {
        new TabInfo(ListTab.Open, "All open", open.Count),
        new TabInfo(ListTab.Overdue, "Overdue", open.Count(i => i.DaysOverdue > 0)),
        new TabInfo(ListTab.NotDue, "Not yet due", open.Count(i => i.DaysOverdue <= 0))
    };

    private int BandOf(CustomerInvoiceSummary invoice)
    {
        var days = invoice.DaysOverdue;
        var width = BandWidth;

        if (days <= 0) return 0;
        if (days <= width) return 1;
        if (days <= width * 2) return 2;
        if (days <= width * 3) return 3;
        return 4;
    }

    /// <summary>The five bands, worded and keyed exactly as the dashboard's aging panel.</summary>
    private List<AgeBand> AgeBands(List<CustomerInvoiceSummary> open)
    {
        var width = BandWidth;
        string[] keys = { "cpd-b-current", "cpd-b-1", "cpd-b-2", "cpd-b-3", "cpd-b-4" };
        string[] labels =
        {
            "Current",
            $"1-{width} Days",
            $"{width + 1}-{width * 2} Days",
            $"{width * 2 + 1}-{width * 3} Days",
            $"Over {width * 3} Days"
        };

        return Enumerable.Range(0, 5)
            .Select(index =>
            {
                var inBand = open.Where(i => BandOf(i) == index).ToList();
                return new AgeBand(index, keys[index], labels[index], inBand.Sum(i => i.Balance), inBand.Count);
            })
            .ToList();
    }

    private string AgeBarLabel(List<AgeBand> bands) =>
        "Balance by age: " + string.Join(", ", bands.Select(b => $"{b.Label} {FormatCurrency(b.Amount)}"));

    private static string BandFilterCaption(AgeBand band) => band.Index == 0
        ? "Showing invoices not yet due"
        : $"Showing invoices {band.Label.ToLowerInvariant()} over terms";

    private static decimal OverdueAmount(List<CustomerInvoiceSummary> open) =>
        open.Where(i => i.DaysOverdue > 0).Sum(i => i.Balance);

    private static string OverdueCaption(List<CustomerInvoiceSummary> open)
    {
        var overdue = open.Where(i => i.DaysOverdue > 0).ToList();
        if (overdue.Count == 0)
        {
            return "Nothing past due";
        }

        var oldest = overdue.Max(i => i.DaysOverdue);
        return $"{overdue.Count} {Plural(overdue.Count, "invoice")} · oldest {oldest} {Plural(oldest, "day")} over";
    }

    /// <summary>
    /// The soonest invoice not yet over terms. Deliberately not "the oldest open
    /// invoice": one already past due is stated by the overdue figure beside it,
    /// and counting it twice would make the row read as more debt than there is.
    /// </summary>
    private static CustomerInvoiceSummary? NextDue(List<CustomerInvoiceSummary> open) => open
        .Where(i => i.DaysOverdue <= 0 && i.DueDate.HasValue)
        .OrderBy(i => i.DueDate)
        .FirstOrDefault();

    private static string NextDueCaption(List<CustomerInvoiceSummary> open)
    {
        if (NextDue(open) is not { DueDate: { } dueOn } next)
        {
            return open.Count > 0 ? "Everything open is past due" : "Nothing outstanding";
        }

        return $"Invoice {next.DocNum} · {DueIn((dueOn.Date - DateTime.Today).Days)}";
    }

    private static string DueIn(int days) => days switch
    {
        <= 0 => "due today",
        1 => "due tomorrow",
        _ => $"due in {days} days"
    };

    private static string DueRelative(CustomerInvoiceSummary invoice)
    {
        if (invoice.Balance <= 0) return "Settled";
        if (invoice.DaysOverdue > 0) return $"{invoice.DaysOverdue} {Plural(invoice.DaysOverdue, "day")} over terms";
        if (invoice.DueDate is not { } due) return string.Empty;

        var text = DueIn((due.Date - DateTime.Today).Days);
        return char.ToUpperInvariant(text[0]) + text[1..];
    }

    /// <summary>
    /// The same three states the dashboard's ledger states, said the same way, plus a
    /// fourth for an invoice falling due within the week.
    /// </summary>
    private static (string Cls, string Text) InvoiceStatus(CustomerInvoiceSummary invoice)
    {
        if (invoice.Balance <= 0) return ("is-paid", "Paid");
        if (invoice.DaysOverdue > 0) return ("is-over", $"{invoice.DaysOverdue} {Plural(invoice.DaysOverdue, "day")} over");

        if (invoice.DueDate is { } due)
        {
            var days = (due.Date - DateTime.Today).Days;
            if (days <= 7)
            {
                return ("is-soon", days switch
                {
                    <= 0 => "Due today",
                    1 => "Due tomorrow",
                    _ => $"Due in {days} days"
                });
            }
        }

        return (string.Empty, "Current");
    }

    private string CardCaption(CustomerInvoiceSummary invoice) => invoice.PaidToDate > 0
        ? $"Paid {FormatCurrency(invoice.PaidToDate)} of {FormatCurrency(invoice.DocTotal)}"
        : invoice.DueDate is { } due ? $"Due {due:MMM dd, yyyy}" : $"Issued {invoice.DocDate:MMM dd, yyyy}";

    private static decimal PaidShare(CustomerInvoiceSummary invoice) => invoice.DocTotal > 0
        ? Math.Clamp(invoice.PaidToDate / invoice.DocTotal * 100m, 0m, 100m)
        : 0m;

    private string EmptyCaption()
    {
        if (searchText.Trim().Length > 0) return $"No open invoice number contains \"{searchText.Trim()}\".";
        if (bandFilter is not null) return "No open invoices fall in that age band.";

        return listTab switch
        {
            ListTab.Overdue => "Nothing is past due in this period.",
            ListTab.NotDue => "Everything open in this period is past due.",
            _ => "You have no open invoices in this period."
        };
    }

    private static string ChoiceCaption(PeriodPreset preset)
    {
        var today = DateTime.Today;
        return preset.Key switch
        {
            AllKey => "Every invoice with a balance",
            "30" => $"{today.AddDays(-30):MMM d} – {today:MMM d, yyyy}",
            "90" => $"{today.AddDays(-90):MMM d} – {today:MMM d, yyyy}",
            "year" => $"Jan 1 – {today:MMM d, yyyy}",
            _ => "Choose a from and to date"
        };
    }

    /// <summary>The period the figures on screen cover.</summary>
    private string LoadedRangeCaption()
    {
        if (loadedFrom is null && loadedTo is null) return "Every open invoice, any date";
        if (loadedFrom is null) return $"Up to {loadedTo:MMM d, yyyy}";
        if (loadedTo is null) return $"Since {loadedFrom:MMM d, yyyy}";

        return loadedFrom.Value.Year == loadedTo.Value.Year
            ? $"{loadedFrom:MMM d} – {loadedTo:MMM d, yyyy}"
            : $"{loadedFrom:MMM d, yyyy} – {loadedTo:MMM d, yyyy}";
    }

    /// <summary>
    /// Which accounts the list is showing, for a customer whose portal login
    /// reaches more than one.
    /// </summary>
    private string AccountScopeCaption()
    {
        if (string.IsNullOrEmpty(selectedAccountFilter))
        {
            return "All main accounts";
        }

        return linkedAccounts.FirstOrDefault(a => a.CardCode == selectedAccountFilter)?.CardName
            ?? selectedAccountFilter;
    }

    private async Task ViewInvoiceDetails(CustomerInvoiceSummary invoice)
    {
        showInvoiceModal = true;
        focusDrawer = true;
        isDetailLoading = true;
        detailError = null;
        selectedInvoiceSummary = invoice;
        selectedInvoice = null;
        podAttachments = new List<DocumentAttachmentDto>();

        try
        {
            selectedInvoice = await InvoiceService.GetInvoiceByDocEntryAsync(invoice.DocEntry);
            var attachmentsResponse = await Http.GetFromJsonAsync<DocumentAttachmentListResponse>(
                $"api/invoice/{invoice.DocEntry}/attachments");
            var attachments = attachmentsResponse?.Attachments ?? new List<DocumentAttachmentDto>();
            podAttachments = attachments.Where(IsPodAttachment).ToList();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error loading invoice details for {DocEntry}", invoice.DocEntry);
            detailError = "Unable to load invoice details. Please try again.";
        }
        finally
        {
            isDetailLoading = false;
        }
    }

    private void CloseInvoiceModal()
    {
        showInvoiceModal = false;
        selectedInvoiceSummary = null;
        selectedInvoice = null;
        podAttachments = new List<DocumentAttachmentDto>();
        detailError = null;
    }

    private void OnDrawerKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Escape")
        {
            CloseInvoiceModal();
        }
    }

    private async Task DownloadInvoicePdf()
    {
        if (selectedInvoice == null || isPdfLoading) return;
        isPdfLoading = true;
        try
        {
            if (!await SavePdf(selectedInvoice.DocEntry, selectedInvoice.DocNum))
            {
                detailError = "Failed to retrieve invoice PDF.";
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error downloading invoice PDF for DocEntry {DocEntry}", selectedInvoice.DocEntry);
            detailError = "Failed to download invoice PDF.";
        }
        finally
        {
            isPdfLoading = false;
        }
    }

    /// <summary>The download button on a list row, which saves the PDF without opening the drawer.</summary>
    private async Task DownloadRowPdf(CustomerInvoiceSummary invoice)
    {
        if (rowPdfDocEntry is not null) return;

        rowPdfDocEntry = invoice.DocEntry;
        listNotice = null;
        try
        {
            if (!await SavePdf(invoice.DocEntry, invoice.DocNum))
            {
                listNotice = $"We could not get the PDF for invoice {invoice.DocNum}. Please try again.";
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error downloading invoice PDF for DocEntry {DocEntry}", invoice.DocEntry);
            listNotice = $"We could not get the PDF for invoice {invoice.DocNum}. Please try again.";
        }
        finally
        {
            rowPdfDocEntry = null;
        }
    }

    private async Task<bool> SavePdf(int docEntry, int docNum)
    {
        var pdfBytes = await InvoiceService.GetInvoicePdfAsync(docEntry);
        if (pdfBytes == null || pdfBytes.Length == 0)
        {
            return false;
        }

        await JSRuntime.InvokeVoidAsync("downloadPdfFromBase64", Convert.ToBase64String(pdfBytes), $"Invoice_{docNum}.pdf");
        return true;
    }

    private async Task DownloadAttachment(DocumentAttachmentDto attachment)
    {
        if (selectedInvoiceSummary == null)
        {
            detailError = "Invoice details are missing. Please try again.";
            return;
        }

        try
        {
            var response = await Http.GetAsync(
                $"api/invoice/{selectedInvoiceSummary.DocEntry}/attachments/{attachment.Id}/download");

            if (!response.IsSuccessStatusCode)
            {
                detailError = "Unable to download the POD. Please try again.";
                return;
            }

            var content = await response.Content.ReadAsByteArrayAsync();
            var base64 = Convert.ToBase64String(content);
            var contentType = attachment.MimeType ?? "application/octet-stream";
            await JSRuntime.InvokeVoidAsync("downloadFile", attachment.FileName, contentType, base64);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error downloading attachment {AttachmentId}", attachment.Id);
            detailError = "Unable to download the POD. Please try again.";
        }
    }

    private static string FormatCurrency(decimal amount)
    {
        return $"${amount:N2}";
    }

    private static string FormatCurrencyWithCode(decimal amount, string? currency)
    {
        if (string.IsNullOrWhiteSpace(currency))
        {
            return FormatCurrency(amount);
        }

        return $"{currency} {amount:N2}";
    }

    private static string Plural(int count, string noun) => count == 1 ? noun : noun + "s";

    private static bool IsPodAttachment(DocumentAttachmentDto attachment)
    {
        var label = $"{attachment.FileName} {attachment.Description}";
        return label.Contains("pod", StringComparison.OrdinalIgnoreCase)
            || label.Contains("proof of delivery", StringComparison.OrdinalIgnoreCase);
    }

    private void GoToPage(int page, int totalPages)
    {
        if (page >= 1 && page <= totalPages)
        {
            currentPage = page;
        }
    }

    private static List<int> GetVisiblePages(int currentPage, int totalPages)
    {
        var pages = new List<int>();
        if (totalPages <= 7)
        {
            for (int i = 1; i <= totalPages; i++) pages.Add(i);
            return pages;
        }

        pages.Add(1);
        if (currentPage > 3) pages.Add(-1); // ellipsis

        int start = Math.Max(2, currentPage - 1);
        int end = Math.Min(totalPages - 1, currentPage + 1);
        for (int i = start; i <= end; i++) pages.Add(i);

        if (currentPage < totalPages - 2) pages.Add(-1); // ellipsis
        pages.Add(totalPages);
        return pages;
    }

    private static string FormatDate(string? dateStr)
    {
        if (string.IsNullOrWhiteSpace(dateStr))
        {
            return "—";
        }

        return DateTime.TryParse(dateStr, out var date)
            ? date.ToString("MMM dd, yyyy")
            : dateStr;
    }
}
