@page "/customer-portal/support"
@attribute [AllowAnonymous]
@rendermode InteractiveServer
@layout CustomerPortalLayout

<PageTitle>Support - Customer Portal</PageTitle>

@* On the portal's page vocabulary — the `cpd` blocks the dashboard was built
   from; see the Page vocabulary section of customer-portal.css. `cpx` comes
   down from the shell. *@
<div class="cpd fade-in">
    <div class="cpd-hero">
        <div class="cpd-hero-text">
            <h2>Support</h2>
            <div class="cpd-hero-meta">
                <span>Account questions, invoices and access</span>
                <span>Mon–Fri, 08:00–17:00 CAT</span>
            </div>
        </div>
        <div class="cpd-hero-actions">
            <a href="/customer-portal/dashboard" class="btn btn-outline-primary">
                <i class="ph ph-arrow-left"></i> Dashboard
            </a>
            <a href="/customer-portal/statements" class="btn btn-primary">View statement</a>
        </div>
    </div>

    <section class="cpd-row">
        <div class="cpd-col-wide">
            <div class="cpd-panel">
                <div class="cpd-panel-head">
                    <h5>Contact us</h5>
                </div>
                <div>
                    <div class="cpd-media">
                        <span class="cpd-media-icon"><i class="ph ph-phone"></i></span>
                        <div class="cpd-media-text">
                            <div class="cpd-media-title">Phone</div>
                            <div class="cpd-media-sub">
                                Call your account manager, or the service desk if you don't have their number.
                            </div>
                        </div>
                    </div>
                    <div class="cpd-media">
                        <span class="cpd-media-icon"><i class="ph ph-envelope-simple"></i></span>
                        <div class="cpd-media-text">
                            <div class="cpd-media-title">Email</div>
                            <div class="cpd-media-sub">
                                <a href="mailto:support@shopinventory.local">support@shopinventory.local</a>
                                — quote your account code so we can find you.
                            </div>
                        </div>
                    </div>
                    <div class="cpd-media">
                        <span class="cpd-media-icon"><i class="ph ph-file-text"></i></span>
                        <div class="cpd-media-text">
                            <div class="cpd-media-title">Self-service</div>
                            <div class="cpd-media-sub">
                                Statements download every document on your account and reconcile the balance for you.
                            </div>
                        </div>
                        <div class="cpd-media-action">
                            <a href="/customer-portal/statements" class="btn btn-outline-primary btn-sm">Open</a>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="cpd-col">
            <div class="cpd-panel">
                <div class="cpd-panel-head">
                    <h5>Before you call</h5>
                </div>
                @* Each tip is the page that answers the question, so the panel is a
                   set of links rather than a list of advice. *@
                <div class="cpd-facts">
                    <div class="cpd-fact">
                        <span class="cpd-fact-k">Which invoices are overdue?</span>
                        <a class="cpd-fact-v" href="/customer-portal/invoices">Invoices</a>
                    </div>
                    <div class="cpd-fact">
                        <span class="cpd-fact-k">Has my payment landed?</span>
                        <a class="cpd-fact-v" href="/customer-portal/payments">Payments</a>
                    </div>
                    <div class="cpd-fact">
                        <span class="cpd-fact-k">Where is my delivery note?</span>
                        <a class="cpd-fact-v" href="/customer-portal/pods">PODs</a>
                    </div>
                    <div class="cpd-fact">
                        <span class="cpd-fact-k">Does my balance reconcile?</span>
                        <a class="cpd-fact-v" href="/customer-portal/statements">Statement</a>
                    </div>
                    <div class="cpd-fact">
                        <span class="cpd-fact-k">Who signed in to my account?</span>
                        <a class="cpd-fact-v" href="/customer-portal/activity-log">Activity</a>
                    </div>
                </div>
                <a class="cpd-link" href="/customer-portal/terms">
                    Terms and privacy <i class="ph ph-arrow-right"></i>
                </a>
            </div>
        </div>
    </section>
</div>
