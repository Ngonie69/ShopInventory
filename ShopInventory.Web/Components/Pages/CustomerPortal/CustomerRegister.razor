@page "/customer-portal/register"
@using System.ComponentModel.DataAnnotations
@using ShopInventory.Web.Models
@inject ICustomerAuthService CustomerAuthService
@inject NavigationManager NavigationManager
@inject IJSRuntime JSRuntime
@inject ILogger<CustomerRegister> Logger
@inject WebClientAuditContext ClientAuditContext
@attribute [AllowAnonymous]
@rendermode InteractiveServer
@layout EmptyLayout

<PageTitle>Request Access - Customer Portal</PageTitle>

@* `cpx` is the customer-portal.css scope, and `signin` is the front-door
   composition sign-in was built on — see that file's Sign-in section. This page
   and the two password-recovery pages are the same door, so they wear the same
   thing; only the hero copy and the fields differ. Registration runs on
   EmptyLayout like sign-in does, so the scope sits on the page's own root. *@
<div class="cpx signin">

    <section class="signin-hero">
        <div class="signin-brand">
            <img src="images/kefalos-logo.jpg" alt="Kefalos Quality Dairy Produce" class="signin-mark"
                 onerror="this.style.display='none'" />
            <div class="signin-brand-rule"></div>
            <div class="signin-brand-text">
                <span class="signin-brand-name">Customer Portal</span>
            </div>
        </div>

        <div class="signin-pitch">
            <div class="signin-eyebrow">Request access</div>
            <h1>Register once, and the account is open.</h1>
            <p>
                You need the customer code from your invoice or statement. Everything on the
                account is available the moment the registration goes through.
            </p>
            <ul class="signin-points">
                <li>Statements and invoices, downloadable any time</li>
                <li>Payments and account activity as they post</li>
                <li>Proof of delivery for every drop</li>
            </ul>
        </div>

        <div class="signin-hero-foot">
            <span>Already registered?</span>
            <a href="/customer-portal/login">
                Sign in
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                     stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M5 12h13" />
                    <path d="M12 6l6 6-6 6" />
                </svg>
            </a>
        </div>
    </section>

    <section class="signin-panel">
        <div class="signin-form">
            <span class="signin-tag">Customer portal</span>
            <h2>@(isRegistered ? "You're registered" : "Request access")</h2>
            <p class="signin-sub">
                @(isRegistered
                    ? "The account is ready to sign in to."
                    : "Enter your customer code and choose a password.")
            </p>

            @if (isRegistered)
            {
                <div class="signin-note signin-note-ok" role="status">
                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                         stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <circle cx="12" cy="12" r="9" />
                        <path d="M8.4 12.2l2.5 2.5 4.7-5" />
                    </svg>
                    <span>Registration successful. You can now sign in.</span>
                </div>

                <a href="/customer-portal/login" class="signin-submit">
                    <span>Go to sign in</span>
                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                         stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <path d="M5 12h12" />
                        <path d="M11.5 6.5L18 12l-6.5 5.5" />
                    </svg>
                </a>
            }
            else
            {
                <EditForm Model="registerModel" OnValidSubmit="HandleRegister" FormName="CustomerRegisterForm">
                    <DataAnnotationsValidator />

                    <div class="signin-field">
                        <label for="cardCode">Customer code</label>
                        <div class="signin-control">
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                 stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                <rect x="3" y="5" width="18" height="14" rx="2.5" />
                                <path d="M7 10h4" />
                                <path d="M7 14h8" />
                            </svg>
                            <InputText id="cardCode" class="signin-input" @bind-Value="registerModel.CardCode"
                                       placeholder="e.g. C00001" autocomplete="off" />
                        </div>
                        <ValidationMessage For="@(() => registerModel.CardCode)" class="validation-msg" />
                        <p class="signin-hint">The code printed on your invoice or statement.</p>
                    </div>

                    <div class="signin-field">
                        <label for="email">Email address</label>
                        <div class="signin-control">
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                 stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                <rect x="3" y="5.5" width="18" height="13" rx="2.5" />
                                <path d="M4 7l8 6 8-6" />
                            </svg>
                            <InputText id="email" class="signin-input" @bind-Value="registerModel.Email"
                                       placeholder="@("orders@yourbusiness.com")" autocomplete="email" />
                        </div>
                        <ValidationMessage For="@(() => registerModel.Email)" class="validation-msg" />
                    </div>

                    <div class="signin-field">
                        <label for="password">Password</label>
                        <div class="signin-control">
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                 stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                <rect x="4.5" y="10" width="15" height="10" rx="2.5" />
                                <path d="M8.2 10V7.4a3.8 3.8 0 0 1 7.6 0V10" />
                            </svg>
                            <input id="password" type="@(showPassword ? "text" : "password")"
                                   class="signin-input has-reveal" @bind="registerModel.Password"
                                   placeholder="Min 8 characters" autocomplete="new-password" />
                            <button type="button" class="signin-reveal" @onclick="TogglePassword" tabindex="-1"
                                    aria-label="@(showPassword ? "Hide password" : "Show password")">
                                @if (showPassword)
                                {
                                    <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                         stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"
                                         aria-hidden="true">
                                        <path d="M2.5 12S6 6.2 12 6.2 21.5 12 21.5 12 18 17.8 12 17.8 2.5 12 2.5 12z" />
                                        <circle cx="12" cy="12" r="2.8" />
                                        <path d="M4 20L20 4" />
                                    </svg>
                                }
                                else
                                {
                                    <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                         stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"
                                         aria-hidden="true">
                                        <path d="M2.5 12S6 6.2 12 6.2 21.5 12 21.5 12 18 17.8 12 17.8 2.5 12 2.5 12z" />
                                        <circle cx="12" cy="12" r="2.8" />
                                    </svg>
                                }
                            </button>
                        </div>
                        <ValidationMessage For="@(() => registerModel.Password)" class="validation-msg" />
                    </div>

                    <div class="signin-field">
                        <label for="confirmPassword">Confirm password</label>
                        <div class="signin-control">
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                 stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                <rect x="4.5" y="10" width="15" height="10" rx="2.5" />
                                <path d="M8.2 10V7.4a3.8 3.8 0 0 1 7.6 0V10" />
                                <path d="M9.8 15l1.5 1.5 3-3" />
                            </svg>
                            <input id="confirmPassword" type="@(showPassword ? "text" : "password")"
                                   class="signin-input" @bind="registerModel.ConfirmPassword"
                                   placeholder="Re-enter password" autocomplete="new-password" />
                        </div>
                        <ValidationMessage For="@(() => registerModel.ConfirmPassword)" class="validation-msg" />
                    </div>

                    @if (!string.IsNullOrEmpty(errorMessage))
                    {
                        <div class="signin-note signin-note-error" role="alert">
                            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                 stroke-width="1.8" stroke-linecap="round" aria-hidden="true">
                                <circle cx="12" cy="12" r="9" />
                                <path d="M12 7.5v5.5" />
                                <path d="M12 16.4v.1" />
                            </svg>
                            <span>@errorMessage</span>
                        </div>
                    }

                    <button type="submit" class="signin-submit" disabled="@isLoading">
                        @if (isLoading)
                        {
                            <span class="signin-spinner"></span>
                            <span>Creating account&hellip;</span>
                        }
                        else
                        {
                            <span>Create account</span>
                            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                 stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                <path d="M5 12h12" />
                                <path d="M11.5 6.5L18 12l-6.5 5.5" />
                            </svg>
                        }
                    </button>
                </EditForm>

                <div class="signin-foot">
                    Already have an account? <a href="/customer-portal/login">Sign in</a>
                </div>
            }

            <div class="signin-secure">
                <svg width="13" height="13" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
                    <path
                    d="M8 0c-.69 0-1.843.265-2.928.56-1.11.3-2.229.655-2.887.87a1.54 1.54 0 0 0-1.044 1.262c-.596 4.477.787 7.795 2.465 9.99a11.777 11.777 0 0 0 2.517 2.453c.386.273.744.482 1.048.625.28.132.581.24.829.24s.548-.108.829-.24a7.159 7.159 0 0 0 1.048-.625 11.775 11.775 0 0 0 2.517-2.453c1.678-2.195 3.061-5.513 2.465-9.99a1.541 1.541 0 0 0-1.044-1.263 62.467 62.467 0 0 0-2.887-.87C9.843.266 8.69 0 8 0zm-.5 5a.5.5 0 0 1 1 0v1.5H10a.5.5 0 0 1 0 1H8.5V9a.5.5 0 0 1-1 0V7.5H6a.5.5 0 0 1 0-1h1.5V5z" />
                </svg>
                <span>Secured with 256-bit encryption</span>
            </div>
        </div>

        <div class="signin-copyright">&copy; 2026 Kefalos Cheese</div>
    </section>
</div>

@code {
    private CustomerRegistrationFormModel registerModel = new();
    private bool isLoading;
    private bool isRegistered;
    private bool showPassword;
    private string? errorMessage;

    private void TogglePassword()
    {
        showPassword = !showPassword;
    }

    private async Task HandleRegister()
    {
        errorMessage = null;
        isLoading = true;

        try
        {
            var success = await CustomerAuthService.RegisterCustomerAsync(
                registerModel.CardCode.Trim(),
                registerModel.Email.Trim(),
                registerModel.Password,
                GetClientIpAddress()
            );

            if (success)
            {
                isRegistered = true;
            }
            else
            {
                errorMessage = "Registration failed. Please check your customer code is valid and not already registered.";
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Registration error for {CardCode}", registerModel.CardCode);
            errorMessage = "An error occurred. Please try again later.";
        }
        finally
        {
            isLoading = false;
        }
    }

    private string GetClientIpAddress() => string.IsNullOrWhiteSpace(ClientAuditContext.IpAddress)
        ? "unknown"
        : ClientAuditContext.IpAddress;
}
