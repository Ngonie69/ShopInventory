@page "/customer-portal/reset-password"
@inject ICustomerAuthService CustomerAuthService
@inject WebClientAuditContext ClientAuditContext
@inject ILogger<CustomerResetPassword> Logger
@attribute [AllowAnonymous]
@rendermode InteractiveServer
@layout EmptyLayout

<PageTitle>Choose New Password - Customer Portal</PageTitle>

@* The front-door composition from customer-portal.css's Sign-in section, the
   same as /customer-portal/login and its two siblings wear — see the note at
   the top of CustomerRegister.razor. *@
<div class="cpx signin">

    <section class="signin-hero">
        <div class="signin-brand">
            <img src="images/kefalos-logo.jpg" alt="Kefalos Quality Dairy Produce" class="signin-mark"
                 onerror="this.style.display='none'" />
            <div class="signin-brand-rule"></div>
            <div class="signin-brand-text">
                <span class="signin-brand-name">Customer Portal</span>
            </div>
        </div>

        <div class="signin-pitch">
            <div class="signin-eyebrow">Account recovery</div>
            <h1>Choose a new password.</h1>
            <p>
                Once it is set, the reset link stops working and every other session on the
                account is left as it was.
            </p>
            <ul class="signin-points">
                <li>At least eight characters</li>
                <li>An uppercase and a lowercase letter</li>
                <li>A number and one of @@ $ ! % * ? &amp;</li>
            </ul>
        </div>

        <div class="signin-hero-foot">
            <span>Not you?</span>
            <a href="/customer-portal/login">
                Back to sign in
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                     stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M5 12h13" />
                    <path d="M12 6l6 6-6 6" />
                </svg>
            </a>
        </div>
    </section>

    <section class="signin-panel">
        <div class="signin-form">
            <span class="signin-tag">Customer portal</span>
            <h2>New password</h2>
            <p class="signin-sub">
                @(resetComplete
                    ? "That's done — the new password is live."
                    : "Set the password you'll sign in with from now on.")
            </p>

            @if (resetComplete)
            {
                <div class="signin-note signin-note-ok" role="status">
                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                         stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <circle cx="12" cy="12" r="9" />
                        <path d="M8.4 12.2l2.5 2.5 4.7-5" />
                    </svg>
                    <span>@resultMessage</span>
                </div>

                <a href="/customer-portal/login" class="signin-submit">
                    <span>Sign in</span>
                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                         stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <path d="M5 12h12" />
                        <path d="M11.5 6.5L18 12l-6.5 5.5" />
                    </svg>
                </a>
            }
            else if (string.IsNullOrWhiteSpace(Token))
            {
                <div class="signin-note signin-note-error" role="alert">
                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                         stroke-width="1.8" stroke-linecap="round" aria-hidden="true">
                        <circle cx="12" cy="12" r="9" />
                        <path d="M12 7.5v5.5" />
                        <path d="M12 16.4v.1" />
                    </svg>
                    <span>This password reset link is invalid or incomplete.</span>
                </div>

                <a href="/customer-portal/forgot-password" class="signin-submit">
                    <span>Request a new link</span>
                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                         stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <path d="M5 12h12" />
                        <path d="M11.5 6.5L18 12l-6.5 5.5" />
                    </svg>
                </a>
            }
            else
            {
                <EditForm Model="model" OnValidSubmit="ResetPassword" FormName="customer-reset-password">
                    <DataAnnotationsValidator />

                    <div class="signin-field">
                        <label for="new-password">New password</label>
                        <div class="signin-control">
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                 stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                <rect x="4.5" y="10" width="15" height="10" rx="2.5" />
                                <path d="M8.2 10V7.4a3.8 3.8 0 0 1 7.6 0V10" />
                            </svg>
                            <InputText id="new-password" class="signin-input" type="password"
                                       @bind-Value="model.NewPassword" autocomplete="new-password" />
                        </div>
                        <ValidationMessage For="@(() => model.NewPassword)" class="validation-msg" />
                    </div>

                    <div class="signin-field">
                        <label for="confirm-password">Confirm password</label>
                        <div class="signin-control">
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                 stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                <rect x="4.5" y="10" width="15" height="10" rx="2.5" />
                                <path d="M8.2 10V7.4a3.8 3.8 0 0 1 7.6 0V10" />
                                <path d="M9.8 15l1.5 1.5 3-3" />
                            </svg>
                            <InputText id="confirm-password" class="signin-input" type="password"
                                       @bind-Value="model.ConfirmPassword" autocomplete="new-password" />
                        </div>
                        <ValidationMessage For="@(() => model.ConfirmPassword)" class="validation-msg" />
                    </div>

                    @if (!string.IsNullOrWhiteSpace(resultMessage))
                    {
                        <div class="signin-note signin-note-error" role="alert">
                            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                 stroke-width="1.8" stroke-linecap="round" aria-hidden="true">
                                <circle cx="12" cy="12" r="9" />
                                <path d="M12 7.5v5.5" />
                                <path d="M12 16.4v.1" />
                            </svg>
                            <span>@resultMessage</span>
                        </div>
                    }

                    <button type="submit" class="signin-submit" disabled="@isSubmitting">
                        @if (isSubmitting)
                        {
                            <span class="signin-spinner"></span>
                            <span>Updating&hellip;</span>
                        }
                        else
                        {
                            <span>Update password</span>
                            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                 stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                <path d="M5 12h12" />
                                <path d="M11.5 6.5L18 12l-6.5 5.5" />
                            </svg>
                        }
                    </button>
                </EditForm>
            }

            <div class="signin-secure">
                <svg width="13" height="13" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
                    <path
                    d="M8 0c-.69 0-1.843.265-2.928.56-1.11.3-2.229.655-2.887.87a1.54 1.54 0 0 0-1.044 1.262c-.596 4.477.787 7.795 2.465 9.99a11.777 11.777 0 0 0 2.517 2.453c.386.273.744.482 1.048.625.28.132.581.24.829.24s.548-.108.829-.24a7.159 7.159 0 0 0 1.048-.625 11.775 11.775 0 0 0 2.517-2.453c1.678-2.195 3.061-5.513 2.465-9.99a1.541 1.541 0 0 0-1.044-1.263 62.467 62.467 0 0 0-2.887-.87C9.843.266 8.69 0 8 0zm-.5 5a.5.5 0 0 1 1 0v1.5H10a.5.5 0 0 1 0 1H8.5V9a.5.5 0 0 1-1 0V7.5H6a.5.5 0 0 1 0-1h1.5V5z" />
                </svg>
                <span>Secured with 256-bit encryption</span>
            </div>
        </div>

        <div class="signin-copyright">&copy; 2026 Kefalos Cheese</div>
    </section>
</div>

@code {
    [SupplyParameterFromQuery(Name = "token")]
    public string? Token { get; set; }

    private readonly ResetPasswordForm model = new();
    private bool isSubmitting;
    private bool resetComplete;
    private string? resultMessage;

    private async Task ResetPassword()
    {
        if (isSubmitting || string.IsNullOrWhiteSpace(Token))
        {
            return;
        }

        isSubmitting = true;
        resultMessage = null;

        try
        {
            var result = await CustomerAuthService.ResetPasswordAsync(
                Token.Trim(),
                model.NewPassword,
                ClientAuditContext.IpAddress ?? "unknown");

            resultMessage = result.Message;
            resetComplete = result.Success;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Customer password reset failed");
            resultMessage = "We couldn't update the password right now. Please try again.";
        }
        finally
        {
            isSubmitting = false;
        }
    }

    private sealed class ResetPasswordForm
    {
        [Required(ErrorMessage = "New password is required")]
        [RegularExpression(@"^(?=.*[a-z])(?=.*[A-Z])(?=.*\d)(?=.*[@$!%*?&])[A-Za-z\d@$!%*?&]{8,}$",
            ErrorMessage = "Use 8+ characters with uppercase, lowercase, a number, and a special character")]
        public string NewPassword { get; set; } = string.Empty;

        [Required(ErrorMessage = "Please confirm the new password")]
        [Compare(nameof(NewPassword), ErrorMessage = "Passwords do not match")]
        public string ConfirmPassword { get; set; } = string.Empty;
    }
}
