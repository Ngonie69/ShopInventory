@page "/customer-portal/payments"
@using ShopInventory.Web.Models
@using ShopInventory.Web.Services
@inject ICustomerStatementService StatementService
@inject ICustomerPortalSessionService CustomerSession
@inject ILogger<CustomerPayments> Logger
@attribute [AllowAnonymous]
@rendermode InteractiveServer
@layout CustomerPortalLayout

<PageTitle>Payments - Customer Portal</PageTitle>

@* On the portal's page vocabulary — the `cpd` blocks the dashboard was built
   from; see the Page vocabulary section of customer-portal.css. `cpx` comes
   down from the shell. *@
<div class="cpd fade-in">
    @if (isLoading && customerInfo == null)
    {
        <div class="cpd-panel">
            <div class="cpd-empty">
                <div class="spinner-border" role="status" style="width: 2.25rem; height: 2.25rem;">
                    <span class="visually-hidden">Loading...</span>
                </div>
                <p class="mt-3 mb-0">Loading payments...</p>
            </div>
        </div>
    }
    else if (customerInfo == null)
    {
        <div class="cpd-panel">
            <div class="cpd-empty">
                <i class="ph ph-lock-key"></i>
                <h5>Authentication required</h5>
                <p>Please sign in to see your payments.</p>
                <a href="/customer-portal/login" class="btn btn-primary">Sign in to the portal</a>
            </div>
        </div>
    }
    else
    {
        <div class="cpd-hero">
            <div class="cpd-hero-text">
                <h2>Payments</h2>
                <div class="cpd-hero-meta">
                    <span>@customerInfo.CardName</span>
                    <span>Account @customerInfo.CardCode</span>
                    @if (isMultiAccount)
                    {
                        <span>@AccountScopeCaption()</span>
                    }
                    <span>
                        @(lastUpdated.HasValue
                            ? $"Updated {lastUpdated.Value:MMM dd, yyyy 'at' HH:mm} UTC"
                            : "Not loaded yet")
                    </span>
                </div>
            </div>
            <div class="cpd-hero-actions">
                <a href="/customer-portal/dashboard" class="btn btn-outline-primary">
                    <i class="ph ph-arrow-left"></i> Dashboard
                </a>
                <a href="/customer-portal/statements" class="btn btn-primary">View statement</a>
            </div>
        </div>

        <section class="cpd-panel">
            <div class="cpd-panel-head">
                <h5>Period</h5>
                @if (hasLoaded)
                {
                    <span class="cpd-tag">@filteredPayments.Count @Plural(filteredPayments.Count, "payment")</span>
                }
            </div>
            @* Every control here is one of the portal's own. NocturneDateField keeps the
               shorthand entry FlexibleDatePicker was written for and draws the portal's
               calendar; NocturneSelect draws its menu in page DOM, so the row is one
               height and one palette. See .claude/skills/nocturne-dropdowns-and-dates. *@
            <div class="cpd-filters">
                <div class="cpd-field">
                    <label class="cpd-field-label" for="cpay-f-from">From</label>
                    <NocturneDateField Id="cpay-f-from" @bind-Date="fromDate" AriaLabel="From date" />
                </div>
                <div class="cpd-field">
                    <label class="cpd-field-label" for="cpay-f-to">To</label>
                    <NocturneDateField Id="cpay-f-to" @bind-Date="toDate" AriaLabel="To date" />
                </div>
                @if (isMultiAccount && linkedAccounts.Any())
                {
                    <div class="cpd-field">
                        <label class="cpd-field-label" for="cpay-f-account">Account</label>
                        @* The lambda is not a style choice: passing the method group makes
                           TValue inference fail on an error that names EventCallback. *@
                        <NocturneSelect Id="cpay-f-account" Class="nsel-block" TValue="string"
                                        Options="AccountFilterOptions" Value="@selectedAccountFilter"
                                        ValueChanged="@(code => OnAccountFilterChanged(code ?? string.Empty))"
                                        Caption="Filter by account" AriaLabel="Filter by account"
                                        Placeholder="All accounts" />
                    </div>
                }
                <div class="cpd-field cpd-field-action">
                    <button type="button" class="btn btn-primary" @onclick="ApplyFilters"
                            disabled="@(isLoading || !HasPeriod || PeriodIsInverted)">
                        @if (isLoading)
                        {
                            <span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>
                            <span>Loading</span>
                        }
                        else
                        {
                            <span>@(hasLoaded ? "Reload payments" : "Load payments")</span>
                        }
                    </button>
                </div>
            </div>
            @if (PeriodIsInverted)
            {
                <p class="cpd-filter-note" role="alert">
                    The From date falls after the To date. Swap them to load payments.
                </p>
            }
        </section>

        @if (hasLoaded)
        {
            <section class="cpd-kpis">
                <div class="cpd-kpi">
                    <div class="cpd-kpi-top">
                        <span class="cpd-kpi-label">Received</span>
                        <i class="ph ph-arrow-circle-down"></i>
                    </div>
                    <div class="cpd-kpi-num">@FormatCurrency(filteredTotalPaid)</div>
                    <div class="cpd-kpi-sub">@PeriodCaption()</div>
                </div>

                <div class="cpd-kpi">
                    <div class="cpd-kpi-top">
                        <span class="cpd-kpi-label">Payments</span>
                        <i class="ph ph-list-numbers"></i>
                    </div>
                    <div class="cpd-kpi-num">@filteredPayments.Count</div>
                    <div class="cpd-kpi-sub">@MethodCaption()</div>
                </div>

                <div class="cpd-kpi">
                    <div class="cpd-kpi-top">
                        <span class="cpd-kpi-label">Average payment</span>
                        <i class="ph ph-chart-bar"></i>
                    </div>
                    <div class="cpd-kpi-num">@FormatCurrency(AveragePayment)</div>
                    <div class="cpd-kpi-sub">
                        @(LargestPayment > 0 ? $"Largest {FormatCurrency(LargestPayment)}" : "No payments in range")
                    </div>
                </div>

                <div class="cpd-kpi">
                    <div class="cpd-kpi-top">
                        <span class="cpd-kpi-label">Latest payment</span>
                        <i class="ph ph-clock-counter-clockwise"></i>
                    </div>
                    <div class="cpd-kpi-num">@FormatCurrency(LatestPayment?.DocTotal ?? 0)</div>
                    <div class="cpd-kpi-sub">
                        @(LatestPayment is null
                            ? "Nothing received in range"
                            : $"{LatestPayment.PaymentMethod} · {LatestPayment.DocDate:MMM dd, yyyy}")
                    </div>
                </div>
            </section>

            <section class="cpd-panel cpd-ledger">
                <div class="cpd-panel-head">
                    <h5>Payment history</h5>
                    <span class="cpd-panel-total">
                        Total <strong>@FormatCurrency(filteredTotalPaid)</strong>
                    </span>
                </div>

                @if (pagedPayments.Any())
                {
                    <div class="table-responsive">
                        <table class="cpd-table mobile-card-table">
                            <thead>
                                <tr>
                                    <th>Payment</th>
                                    @if (isMultiAccount)
                                    {
                                        <th>Account</th>
                                    }
                                    <th>Date</th>
                                    <th>Method</th>
                                    <th class="cpd-num">Amount</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var payment in pagedPayments)
                                {
                                    <tr>
                                        <td data-label="Payment">
                                            @* One element, not two: below 992px each cell becomes a
                                               labelled grid row, and a second child would be placed
                                               into the label track. *@
                                            <span class="cpd-doc">
                                                <span class="cpd-doc-id">@payment.DocNum</span>
                                                <span class="cpd-doc-sub">
                                                    @(string.IsNullOrWhiteSpace(payment.Reference) ? "No reference" : payment.Reference)
                                                </span>
                                            </span>
                                        </td>
                                        @if (isMultiAccount)
                                        {
                                            <td data-label="Account" class="cpd-quiet">
                                                <span class="cpd-doc">
                                                    <span class="cpd-doc-id">@(payment.CardCode ?? "—")</span>
                                                    <span class="cpd-doc-sub">@(payment.Currency ?? "")</span>
                                                </span>
                                            </td>
                                        }
                                        <td data-label="Date" class="cpd-quiet">@payment.DocDate.ToString("MMM dd, yyyy")</td>
                                        <td data-label="Method" class="cpd-quiet">@payment.PaymentMethod</td>
                                        <td data-label="Amount" class="cpd-num cpd-strong">@FormatCurrency(payment.DocTotal)</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>

                    @if (totalPages > 1)
                    {
                        <div class="cpd-pager">
                            <div class="cpd-pager-info">
                                Showing @(((currentPage - 1) * pageSize) + 1)&ndash;@(Math.Min(currentPage * pageSize, filteredPayments.Count))
                                of @filteredPayments.Count payments
                            </div>
                            <nav aria-label="Payment pages">
                                <ul class="pagination pagination-sm mb-0">
                                    <li class="page-item @(currentPage == 1 ? "disabled" : "")">
                                        <button class="page-link" @onclick="() => GoToPage(currentPage - 1)"
                                                disabled="@(currentPage == 1)" aria-label="Previous page">
                                            <i class="ph ph-caret-left"></i>
                                        </button>
                                    </li>
                                    @foreach (var pg in GetVisiblePages())
                                    {
                                        @if (pg == -1)
                                        {
                                            <li class="page-item disabled"><span class="page-link">&hellip;</span></li>
                                        }
                                        else
                                        {
                                            <li class="page-item @(pg == currentPage ? "active" : "")">
                                                <button class="page-link" @onclick="() => GoToPage(pg)">@pg</button>
                                            </li>
                                        }
                                    }
                                    <li class="page-item @(currentPage == totalPages ? "disabled" : "")">
                                        <button class="page-link" @onclick="() => GoToPage(currentPage + 1)"
                                                disabled="@(currentPage == totalPages)" aria-label="Next page">
                                            <i class="ph ph-caret-right"></i>
                                        </button>
                                    </li>
                                </ul>
                            </nav>
                        </div>
                    }
                }
                else
                {
                    <div class="cpd-empty">No payments found for the selected period.</div>
                }
            </section>
        }
        else
        {
            <div class="cpd-panel">
                <div class="cpd-empty">
                    <i class="ph ph-hand-coins"></i>
                    <h5>Choose a period</h5>
                    <p>Set the dates above and load your payment history.</p>
                </div>
            </div>
        }
    }
</div>

@code {
    private CustomerPortalSession? portalSession;
    private CustomerInfo? customerInfo;
    private List<CustomerPaymentSummary> payments = new();
    private bool isLoading = true;
    private bool hasLoaded = false;
    private int currentPage = 1;
    private int pageSize = 15;
    private int totalPages => (int)Math.Ceiling((double)filteredPayments.Count / pageSize);
    private List<CustomerPaymentSummary> pagedPayments => filteredPayments
        .Skip((currentPage - 1) * pageSize)
        .Take(pageSize)
        .ToList();
    private DateTime? lastUpdated;
    private decimal totalPaid;
    private decimal filteredTotalPaid => filteredPayments.Sum(p => p.DocTotal);
    // Deliberately empty. This is a live read of the customer's payment history, and the
    // reader who opened the page has not said which period they want yet — so both
    // fields start blank and the button stays out of reach until they do.
    private DateTime? fromDate;
    private DateTime? toDate;

    private bool HasPeriod => fromDate.HasValue && toDate.HasValue;

    // Refused at the button rather than sent: an inverted range is not a query.
    private bool PeriodIsInverted => HasPeriod && fromDate > toDate;
    private bool isMultiAccount;
    private string selectedAccountFilter = "";
    private List<LinkedAccountInfo> linkedAccounts = new();

    // Computed rather than static: the list arrives with the session.
    private IEnumerable<NocturneSelectOption<string>> AccountFilterOptions =>
        PortalFilterOptions.Accounts(linkedAccounts);

    private List<CustomerPaymentSummary> filteredPayments => string.IsNullOrEmpty(selectedAccountFilter)
        ? payments
        : payments.Where(p => p.CardCode == selectedAccountFilter).ToList();

    private decimal AveragePayment => filteredPayments.Count == 0
        ? 0
        : filteredTotalPaid / filteredPayments.Count;

    private decimal LargestPayment => filteredPayments.Count == 0
        ? 0
        : filteredPayments.Max(p => p.DocTotal);

    private CustomerPaymentSummary? LatestPayment => filteredPayments
        .OrderByDescending(p => p.DocDate)
        .FirstOrDefault();

    protected override async Task OnInitializedAsync()
    {
        // Loading here rather than in OnAfterRender starts the fetch before the first render
        // instead of after it. The guard keeps the session read off any non-interactive pass;
        // see CustomerPortalLayout for why it is here even though prerendering is off.
        if (!RendererInfo.IsInteractive)
        {
            return;
        }

        await LoadCustomerInfo();
        isLoading = false;
    }

    private async Task LoadCustomerInfo()
    {
        try
        {
            portalSession = await CustomerSession.GetCurrentSessionAsync();
            customerInfo = portalSession?.Customer;

            if (customerInfo != null)
            {
                isMultiAccount = customerInfo.AccountStructure == "Multi";
                linkedAccounts = portalSession?.LinkedAccounts.ToList() ?? new List<LinkedAccountInfo>();
                selectedAccountFilter = CustomerSession.CanAccessCardCode(portalSession, selectedAccountFilter)
                    ? selectedAccountFilter
                    : string.Empty;
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error loading customer info");
        }
    }

    private void OnAccountFilterChanged(string value)
    {
        if (!CustomerSession.CanAccessCardCode(portalSession, value))
        {
            Logger.LogWarning("Rejected unauthorized customer payment account filter {CardCode}", value);
            selectedAccountFilter = string.Empty;
            currentPage = 1;
            return;
        }

        selectedAccountFilter = value;
        currentPage = 1;
    }

    private async Task ApplyFilters()
    {
        await LoadPayments();
    }

    private async Task LoadPayments()
    {
        if (customerInfo == null || !HasPeriod || PeriodIsInverted) return;

        isLoading = true;

        try
        {
            payments = await StatementService.GetPaymentHistoryAsync(customerInfo.CardCode, fromDate, toDate);
            totalPaid = payments.Sum(p => p.DocTotal);
            lastUpdated = DateTime.UtcNow;
            hasLoaded = true;
            currentPage = 1;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error loading payments");
        }
        finally
        {
            isLoading = false;
        }
    }

    private string FormatCurrency(decimal amount)
    {
        return $"${amount:N2}";
    }

    private static string Plural(int count, string noun) => count == 1 ? noun : noun + "s";

    /// <summary>The period the figures cover, as the filter currently states it.</summary>
    private string PeriodCaption()
    {
        if (fromDate is null && toDate is null) return "All payments on record";
        if (fromDate is null) return $"Up to {toDate:MMM dd, yyyy}";
        if (toDate is null) return $"Since {fromDate:MMM dd, yyyy}";
        return $"{fromDate:MMM dd, yyyy} – {toDate:MMM dd, yyyy}";
    }

    /// <summary>
    /// Which accounts the list is showing, for a customer whose portal login
    /// reaches more than one.
    /// </summary>
    private string AccountScopeCaption()
    {
        if (string.IsNullOrEmpty(selectedAccountFilter))
        {
            return "All main accounts";
        }

        return linkedAccounts.FirstOrDefault(a => a.CardCode == selectedAccountFilter)?.CardName
            ?? selectedAccountFilter;
    }

    /// <summary>
    /// "Mostly transfers" only when one method genuinely dominates; otherwise it
    /// counts them, because naming the top of an even split misdescribes the set.
    /// </summary>
    private string MethodCaption()
    {
        if (filteredPayments.Count == 0) return "Nothing in range";

        var byMethod = filteredPayments
            .GroupBy(p => string.IsNullOrWhiteSpace(p.PaymentMethod) ? "Unspecified" : p.PaymentMethod)
            .OrderByDescending(g => g.Count())
            .ToList();

        if (byMethod.Count == 1)
        {
            return $"All by {byMethod[0].Key.ToLowerInvariant()}";
        }

        var top = byMethod[0];
        return top.Count() * 2 > filteredPayments.Count
            ? $"Mostly {top.Key.ToLowerInvariant()}, {byMethod.Count} methods"
            : $"{byMethod.Count} payment methods";
    }

    private void GoToPage(int pg)
    {
        if (pg >= 1 && pg <= totalPages)
        {
            currentPage = pg;
        }
    }

    private List<int> GetVisiblePages()
    {
        var pages = new List<int>();
        if (totalPages <= 7)
        {
            for (int i = 1; i <= totalPages; i++) pages.Add(i);
            return pages;
        }

        pages.Add(1);
        if (currentPage > 3) pages.Add(-1);

        int start = Math.Max(2, currentPage - 1);
        int end = Math.Min(totalPages - 1, currentPage + 1);
        for (int i = start; i <= end; i++) pages.Add(i);

        if (currentPage < totalPages - 2) pages.Add(-1);
        pages.Add(totalPages);
        return pages;
    }
}
