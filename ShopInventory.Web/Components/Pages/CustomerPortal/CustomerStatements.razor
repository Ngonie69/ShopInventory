@using System.Globalization
@using ShopInventory.Web.Services

@page "/customer-portal/statements"
@using ShopInventory.Web.Models
@inject ICustomerStatementService StatementService
@inject ICustomerPortalSessionService CustomerSession
@inject IAppSettingsProvider AppSettings
@inject IJSRuntime JSRuntime
@inject ILogger<CustomerStatements> Logger
@attribute [AllowAnonymous]
@rendermode InteractiveServer
@layout CustomerPortalLayout

<PageTitle>My Statements - Customer Portal</PageTitle>

@* Nocturne. wwwroot/css/account-statement.css (linked from App.razor) carries
   the design, built from "Account Statement.dc.html" in the design project.

   The page is flat by design: no cards, no panels. Sections are separated by
   rules that fade out at both ends, and the four headline figures share one
   rule-divided row rather than sitting in four tinted tiles. That is the whole
   point of the redesign — the old page put every group of numbers inside its
   own bordered box, and on a statement, where nearly everything is a number,
   the boxes were doing the reading instead of the figures.

   Two departures from the .dc.html, both deliberate and both about not shipping
   fiction: the design's aging buckets are steps of the accent, and are here the
   portal's own severity ramp, because "how overdue" is the only thing that row
   exists to say; and the design's footer names a contact address
   (accounts@kefalos.co.zw) that appears nowhere in this codebase — the real
   domain is kefaloscheese.com — so the footer points at the portal's own
   Support page instead of inventing a mailbox for customers to write into.

   The ledger folds its middle. A three-month statement runs to seventy-odd
   rows, of which the ones anybody opens the page for are at the two ends, so
   the first eight and last four stay and the rest collapse to one line that
   still carries their count, their span and their totals. Nothing is hidden
   without being counted, and Expand puts it all back.

   The date fields are NocturneDateField for the reasons AuditTrail.razor gives:
   it takes the shorthand people type here (`030826`) and draws a calendar a
   stylesheet can actually reach. It carries the staff palette, which the sheet
   repoints to the portal's teal — see its `.cst .ndf` block. *@

<div class="cst fade-in">
    @if (isLoading && statement == null)
    {
        <div class="cst-loading">
            <span class="cst-spin" aria-hidden="true"></span>
            <span>Loading your statement&#8230;</span>
        </div>
    }
    else if (customerInfo == null)
    {
        <div class="cst-gate">
            <svg width="44" height="44" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"
                 stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <rect x="4.5" y="10.5" width="15" height="10" rx="2.5"></rect>
                <path d="M8 10.5V7a4 4 0 0 1 8 0v3.5"></path>
            </svg>
            <h1>Authentication required</h1>
            <p>Please sign in to view your statements.</p>
            <a href="/customer-portal/login" class="cst-btn cst-btn-primary">Sign in to the portal</a>
        </div>
    }
    else
    {
        <div class="cst-hero">
            <div>
                <div class="cst-hero-kicker">
                    <span class="cst-tag">Statement</span>
                    <span class="cst-period">@PeriodLabel</span>
                    @if (isMultiAccount)
                    {
                        <span class="cst-tag cst-tag-neutral">@AccountScopeLabel</span>
                    }
                </div>
                <h1 class="cst-title">Account statement</h1>
                <p class="cst-lede">
                    @customerInfo.CardName &middot; account @customerInfo.CardCode &middot; all figures in @CurrencyCode
                </p>
            </div>
            <div class="cst-hero-actions">
                <a href="/customer-portal/dashboard" class="cst-btn cst-btn-secondary">Back to dashboard</a>
                <button type="button" class="cst-btn cst-btn-primary" @onclick="DownloadPdf"
                        disabled="@(isDownloading || statement == null)">
                    @if (isDownloading)
                    {
                        <span class="cst-spin" aria-hidden="true"></span>
                        <span>Preparing&#8230;</span>
                    }
                    else
                    {
                        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                             stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <path d="M12 4v11M7.5 10.5L12 15l4.5-4.5M5 19.5h14"></path>
                        </svg>
                        <span>Download PDF</span>
                    }
                </button>
            </div>
        </div>

        <div class="cst-filters">
            @* Not a <label>: the field carries a button and a popup, and a label
               would swallow the clicks of both. *@
            <div class="cst-field">
                <span class="cst-label">From</span>
                <NocturneDateField @bind-Date="fromDate" AriaLabel="Statement period start" />
            </div>
            <div class="cst-field">
                <span class="cst-label">To</span>
                <NocturneDateField @bind-Date="toDate" AriaLabel="Statement period end" />
            </div>
            @if (isMultiAccount && linkedAccounts.Any())
            {
                <label class="cst-field cst-field-wide">
                    <span class="cst-label">Account</span>
                    <NocturneSelect TValue="string" Class="nsel-block" Options="AccountFilterOptions"
                                    Value="@selectedAccountFilter"
                                    ValueChanged="@(code => OnAccountFilterChanged(code))"
                                    Caption="Filter by account" AriaLabel="Filter by account"
                                    Placeholder="All accounts" />
                </label>
            }
            <button type="button" class="cst-btn cst-btn-primary" @onclick="GenerateStatement" disabled="@isLoading">
                @if (isLoading)
                {
                    <span class="cst-spin" aria-hidden="true"></span>
                    <span>Generating&#8230;</span>
                }
                else
                {
                    <span>Generate statement</span>
                }
            </button>
            <div class="cst-quick">
                @foreach (var range in QuickRanges)
                {
                    <button type="button" class="cst-btn cst-btn-ghost" disabled="@isLoading"
                            aria-pressed="@(ActiveQuickRange == range ? "true" : "false")"
                            @onclick="() => ApplyQuickRange(range)">
                        @QuickRangeLabel(range)
                    </button>
                }
            </div>
        </div>

        @if (!string.IsNullOrWhiteSpace(errorMessage))
        {
            <div class="cst-msg" role="alert">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"
                     stroke-linecap="round" aria-hidden="true">
                    <circle cx="12" cy="12" r="9"></circle>
                    <path d="M12 7.5v5.5M12 16.2v.1"></path>
                </svg>
                <span>@errorMessage</span>
            </div>
        }

        @if (statement != null)
        {
            <section class="cst-figures">
                <div class="cst-figure">
                    <div class="cst-figure-label">Opening balance</div>
                    <div class="cst-figure-num">@FormatCurrency(statement.OpeningBalance)</div>
                    <div class="cst-figure-sub">as at @FormatDate(statement.FromDate)</div>
                </div>
                <div class="cst-figure">
                    <div class="cst-figure-label">Total debits</div>
                    <div class="cst-figure-num">@FormatCurrency(statement.TotalDebits)</div>
                    <div class="cst-figure-sub">@Pluralise(DebitCount, "entry", "entries") charged</div>
                </div>
                <div class="cst-figure">
                    <div class="cst-figure-label">Total credits</div>
                    <div class="cst-figure-num">@FormatCurrency(statement.TotalCredits)</div>
                    <div class="cst-figure-sub">receipts &amp; adjustments</div>
                </div>
                <div class="cst-figure cst-figure-close">
                    <div class="cst-figure-label">Closing balance</div>
                    <div class="cst-figure-num">@FormatCurrency(statement.ClosingBalance)</div>
                    <div class="cst-figure-delta">
                        <span class="cst-figure-mark" aria-hidden="true"></span>
                        <span>@MovementLabel</span>
                    </div>
                </div>
            </section>

            <section class="cst-section">
                <div class="cst-section-head">
                    <h2>Transaction detail</h2>
                    <span class="cst-section-note">
                        @Pluralise(statement.Lines.Count, "entry", "entries") &middot; balance carried forward
                    </span>
                    <span class="cst-section-aside">@PeriodLabel</span>
                </div>

                @if (statement.Lines.Any())
                {
                    <div class="cst-ledger-wrap">
                        <table class="cst-ledger">
                            <caption class="visually-hidden-cst">
                                Ledger entries for @customerInfo.CardName between @PeriodLabel, with a running balance.
                            </caption>
                            <colgroup>
                                <col /><col /><col /><col /><col /><col /><col /><col />
                            </colgroup>
                            <thead>
                                <tr>
                                    <th scope="col">Date</th>
                                    <th scope="col">Type</th>
                                    <th scope="col">Ref</th>
                                    <th scope="col">Offset</th>
                                    <th scope="col">Details</th>
                                    <th scope="col" class="cst-num">Debit</th>
                                    <th scope="col" class="cst-num">Credit</th>
                                    <th scope="col" class="cst-num">Balance</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr class="cst-row-open">
                                    <td data-label="Date" class="cst-date">@FormatDate(statement.FromDate)</td>
                                    <td data-label="Summary" colspan="4" class="cst-row-label">Opening balance</td>
                                    <td data-label="Debit" class="cst-num cst-nil">&#8212;</td>
                                    <td data-label="Credit" class="cst-num cst-nil">&#8212;</td>
                                    <td data-label="Balance" class="cst-num cst-row-label">
                                        @FormatCurrency(statement.OpeningBalance)
                                    </td>
                                </tr>

                                @foreach (var line in HeadLines)
                                {
                                    @LedgerRow(line)
                                }

                                @if (IsFolded)
                                {
                                    var folded = FoldedLines;
                                    <tr class="cst-row-fold">
                                        <td colspan="8">
                                            <div class="cst-fold">
                                                <span class="cst-fold-span">
                                                    @Pluralise(folded.Count, "entry", "entries") between
                                                    @FormatDate(folded[0].Date) and
                                                    @FormatDate(folded[^1].Date)
                                                </span>
                                                <span class="cst-fold-rule" aria-hidden="true"></span>
                                                <span class="cst-fold-span">
                                                    debits @FormatCurrency(folded.Sum(l => l.Debit))
                                                </span>
                                                <span class="cst-fold-span">
                                                    credits @FormatCurrency(folded.Sum(l => l.Credit))
                                                </span>
                                                <button type="button" class="cst-btn cst-btn-ghost cst-fold-span"
                                                        @onclick="() => ledgerExpanded = true">
                                                    Expand
                                                </button>
                                            </div>
                                        </td>
                                    </tr>

                                    @foreach (var line in TailLines)
                                    {
                                        @LedgerRow(line)
                                    }
                                }

                                <tr class="cst-row-close">
                                    <td data-label="Date" class="cst-date">@FormatDate(statement.ToDate)</td>
                                    <td data-label="Summary" colspan="4" class="cst-row-label">Closing balance</td>
                                    <td data-label="Debit" class="cst-num cst-total">
                                        @FormatCurrency(statement.TotalDebits)
                                    </td>
                                    <td data-label="Credit" class="cst-num cst-total">
                                        @FormatCurrency(statement.TotalCredits)
                                    </td>
                                    <td data-label="Balance" class="cst-num cst-closing">
                                        @FormatCurrency(statement.ClosingBalance)
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <p class="cst-empty">No transactions were posted to this account in the selected period.</p>
                }
            </section>

            <section class="cst-section cst-section-ruled">
                <div class="cst-section-head">
                    <h2>Aging</h2>
                    <span class="cst-section-note">across all open invoices, not only this period</span>
                    <span class="cst-aging-total">
                        @FormatCurrency(statement.Aging.Total) <span>outstanding</span>
                    </span>
                </div>

                @{
                    var buckets = AgingBuckets;
                }

                <div class="cst-aging-bar" role="img" aria-label="@AgingBarLabel">
                    @foreach (var bucket in buckets.Where(b => b.Share > 0))
                    {
                        <span class="cst-aging-seg cst-age-@bucket.Rank"
                              style="flex-basis: @FormatPercent(bucket.Share)"></span>
                    }
                </div>

                <div class="cst-buckets">
                    @foreach (var bucket in buckets)
                    {
                        <div class="cst-bucket @(bucket.Amount > 0 ? "" : "cst-bucket-nil")">
                            <div class="cst-bucket-head">
                                <span class="cst-dot @(bucket.Amount > 0 ? $"cst-age-{bucket.Rank}" : "cst-age-nil")"
                                      aria-hidden="true"></span>
                                <span class="cst-bucket-label">@bucket.Label</span>
                            </div>
                            <div class="cst-bucket-num">@FormatCurrency(bucket.Amount)</div>
                        </div>
                    }
                </div>
            </section>
        }

        <footer class="cst-foot">
            <div>
                Generated @IAuditService.ToCAT(DateTime.UtcNow).ToString("dd MMMM yyyy, HH:mm", CultureInfo.InvariantCulture) CAT
                &middot; @AppSettings.CompanyName
            </div>
            <div style="margin-top: 2px">
                Queries on this statement go to <a href="/customer-portal/support">our accounts team</a>.
            </div>
        </footer>
    }
</div>

@code {
    private CustomerPortalSession? portalSession;
    private CustomerInfo? customerInfo;
    private CustomerStatementResponse? statement;
    private DateTime? fromDate = IAuditService.ToCAT(DateTime.UtcNow).AddMonths(-3);
    private DateTime? toDate = IAuditService.ToCAT(DateTime.UtcNow);
    private bool isLoading = true;
    private bool isDownloading = false;
    private bool isMultiAccount;
    private string? errorMessage;
    private string selectedAccountFilter = "";
    private List<LinkedAccountInfo> linkedAccounts = new();

    // How much of the ledger survives the fold. The two ends are what a
    // statement is read for — what has just happened, and what it opened at —
    // so they stay whole and the middle collapses to a line that still counts
    // and totals itself. The threshold is deliberately above head + tail: there
    // is no point folding four rows into a row that says it folded four rows.
    private const int FoldHead = 8;
    private const int FoldTail = 4;
    private const int FoldFloor = FoldHead + FoldTail + 4;

    private bool ledgerExpanded;

    private CustomerStatementRequest BuildRequest() => new()
    {
        FromDate = fromDate ?? IAuditService.ToCAT(DateTime.UtcNow).AddMonths(-3),
        ToDate = toDate ?? IAuditService.ToCAT(DateTime.UtcNow),
        IncludeClosedInvoices = true,
        CardCodes = ResolveRequestedCardCodes()
    };

    protected override async Task OnInitializedAsync()
    {
        // Loading here rather than in OnAfterRender starts the fetch before the first render
        // instead of after it. The guard keeps the session read off any non-interactive pass;
        // see CustomerPortalLayout for why it is here even though prerendering is off.
        if (!RendererInfo.IsInteractive)
        {
            return;
        }

        await LoadCustomerInfo();

        if (customerInfo != null)
        {
            await GenerateStatement();
        }
        else
        {
            isLoading = false;
        }
    }

    private async Task LoadCustomerInfo()
    {
        try
        {
            portalSession = await CustomerSession.GetCurrentSessionAsync();
            customerInfo = portalSession?.Customer;

            if (customerInfo != null)
            {
                isMultiAccount = customerInfo.AccountStructure == "Multi";
                linkedAccounts = portalSession?.LinkedAccounts.ToList() ?? new List<LinkedAccountInfo>();
                selectedAccountFilter = CustomerSession.CanAccessCardCode(portalSession, selectedAccountFilter)
                    ? selectedAccountFilter
                    : string.Empty;
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error loading customer info");
        }
        finally
        {
            if (customerInfo == null)
            {
                isLoading = false;
            }
        }
    }

    private IEnumerable<NocturneSelectOption<string>> AccountFilterOptions =>
        linkedAccounts
            .Select(account => new NocturneSelectOption<string>(
                account.CardCode,
                string.IsNullOrEmpty(account.Currency)
                    ? account.CardName
                    : $"{account.CardName} ({account.Currency})",
                "info")
            {
                Hint = account.CardCode
            })
            .Prepend(NocturneSelectOption.All("All accounts"));

    private async Task OnAccountFilterChanged(string? code)
    {
        var value = code ?? string.Empty;

        if (!CustomerSession.CanAccessCardCode(portalSession, value))
        {
            Logger.LogWarning("Rejected unauthorized customer statement account filter {CardCode}", value);
            selectedAccountFilter = string.Empty;
            return;
        }

        selectedAccountFilter = value;
        await GenerateStatement();
    }

    private async Task GenerateStatement()
    {
        if (customerInfo == null) return;

        isLoading = true;
        errorMessage = null;
        // A new period is a new ledger; carrying the previous one's expansion
        // over would silently un-fold a statement the reader never opened.
        ledgerExpanded = false;

        try
        {
            var request = BuildRequest();
            var cardCode = ResolvePrimaryCardCode();
            if (cardCode == null || request.CardCodes.Count == 0)
            {
                statement = null;
                errorMessage = "We couldn't determine which account statement to load for this portal user.";
                return;
            }

            statement = await StatementService.GetStatementAsync(cardCode, request);
        }
        catch (Exception ex)
        {
            statement = null;
            errorMessage = ex.Message;
            Logger.LogError(ex, "Error generating statement");
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task DownloadPdf()
    {
        if (customerInfo == null) return;

        isDownloading = true;
        StateHasChanged();

        try
        {
            var request = BuildRequest();
            var cardCode = ResolvePrimaryCardCode();
            if (cardCode == null || request.CardCodes.Count == 0) return;

            var pdfBytes = await StatementService.GenerateStatementPdfAsync(cardCode, request);

            if (pdfBytes == null || pdfBytes.Length == 0)
            {
                Logger.LogError("PDF generation returned empty byte array");
                await JSRuntime.InvokeVoidAsync("alert", "Failed to generate PDF. Please try again.");
                return;
            }

            // Validate PDF magic bytes (%PDF-)
            if (pdfBytes.Length >= 5)
            {
                var header = System.Text.Encoding.ASCII.GetString(pdfBytes, 0, 5);
                if (!header.StartsWith("%PDF-"))
                {
                    var preview = System.Text.Encoding.UTF8.GetString(pdfBytes, 0, Math.Min(100, pdfBytes.Length));
                    Logger.LogError("Invalid PDF response. First bytes: {Preview}", preview);
                    await JSRuntime.InvokeVoidAsync("alert", "Failed to generate PDF. The server returned an invalid response.");
                    return;
                }
            }

            var base64 = Convert.ToBase64String(pdfBytes);
            var fileCardCode = string.IsNullOrWhiteSpace(selectedAccountFilter) ? cardCode : selectedAccountFilter;
            var fileName = $"Statement_{fileCardCode}_{IAuditService.ToCAT(DateTime.UtcNow):yyyyMMdd}.pdf";

            await JSRuntime.InvokeVoidAsync("downloadFile", fileName, base64);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error downloading PDF");
            await JSRuntime.InvokeVoidAsync("alert", $"Error downloading PDF: {ex.Message}");
        }
        finally
        {
            isDownloading = false;
            StateHasChanged();
        }
    }

    private string? ResolvePrimaryCardCode()
    {
        if (customerInfo == null)
        {
            return null;
        }

        if (!string.IsNullOrWhiteSpace(customerInfo.CardCode)
            && CustomerSession.CanAccessCardCode(portalSession, customerInfo.CardCode))
        {
            return customerInfo.CardCode;
        }

        Logger.LogWarning("Rejected unauthorized customer statement primary account access {CardCode}", customerInfo.CardCode);
        return null;
    }

    private List<string> ResolveRequestedCardCodes()
    {
        if (portalSession == null)
        {
            return new List<string>();
        }

        if (!string.IsNullOrWhiteSpace(selectedAccountFilter))
        {
            if (CustomerSession.CanAccessCardCode(portalSession, selectedAccountFilter))
            {
                return new List<string> { selectedAccountFilter };
            }

            Logger.LogWarning("Rejected unauthorized customer statement account filter {CardCode}", selectedAccountFilter);
            selectedAccountFilter = string.Empty;
        }

        return CustomerSession.ResolveAccessibleCardCodes(portalSession, selectedAccountFilter)
            .Where(cardCode => !string.IsNullOrWhiteSpace(cardCode))
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .ToList();
    }

    // — The quick ranges —————————————————————————————————————————————————————

    private enum QuickRange
    {
        None,
        Last30Days,
        Quarter,
        YearToDate
    }

    private static readonly QuickRange[] QuickRanges =
    {
        QuickRange.Last30Days, QuickRange.Quarter, QuickRange.YearToDate
    };

    private static string QuickRangeLabel(QuickRange range) => range switch
    {
        QuickRange.Last30Days => "Last 30 days",
        QuickRange.Quarter => "Quarter",
        QuickRange.YearToDate => "Year to date",
        _ => string.Empty
    };

    private static (DateTime From, DateTime To) QuickRangeDates(QuickRange range)
    {
        var today = IAuditService.ToCAT(DateTime.UtcNow).Date;

        return range switch
        {
            QuickRange.Last30Days => (today.AddDays(-30), today),
            QuickRange.Quarter => (today.AddMonths(-3), today),
            QuickRange.YearToDate => (new DateTime(today.Year, 1, 1), today),
            _ => (today, today)
        };
    }

    /// <summary>
    /// Which preset the fields are currently sitting on, or None once they have been
    /// edited by hand. Derived rather than remembered so that typing a date into the
    /// field clears the pressed state without the field having to know about presets.
    /// </summary>
    private QuickRange ActiveQuickRange
    {
        get
        {
            foreach (var range in QuickRanges)
            {
                var (from, to) = QuickRangeDates(range);
                if (fromDate?.Date == from && toDate?.Date == to)
                {
                    return range;
                }
            }

            return QuickRange.None;
        }
    }

    private async Task ApplyQuickRange(QuickRange range)
    {
        var (from, to) = QuickRangeDates(range);
        fromDate = from;
        toDate = to;
        await GenerateStatement();
    }

    // — The ledger fold ——————————————————————————————————————————————————————

    private List<StatementLine> AllLines => statement?.Lines ?? new List<StatementLine>();

    private bool IsFolded => !ledgerExpanded && AllLines.Count >= FoldFloor;

    private IEnumerable<StatementLine> HeadLines => IsFolded ? AllLines.Take(FoldHead) : AllLines;

    private IEnumerable<StatementLine> TailLines =>
        IsFolded ? AllLines.Skip(AllLines.Count - FoldTail) : Enumerable.Empty<StatementLine>();

    private List<StatementLine> FoldedLines =>
        IsFolded
            ? AllLines.GetRange(FoldHead, AllLines.Count - FoldHead - FoldTail)
            : new List<StatementLine>();

    private RenderFragment LedgerRow(StatementLine line) =>
    @<tr class="cst-row">
        <td data-label="Date" class="cst-date">@FormatDate(line.Date)</td>
        <td data-label="Type">
            <span class="cst-tag cst-tag-neutral">
                @(string.IsNullOrWhiteSpace(line.OriginCode) ? line.DocumentType : line.OriginCode)
            </span>
        </td>
        <td data-label="Ref" class="cst-ref">@(line.OriginNumber ?? line.DocumentNumber)</td>
        <td data-label="Offset" class="cst-offset">@(line.OffsetAccount ?? "—")</td>
        @* One element between the cell and its contents, not two. On a phone the
           cell is a subgrid of [label | value], and a second child would be laid
           into the next row's label track — which put the Txn line in the
           gutter, under the label rather than under the description. *@
        <td data-label="Details">
            <div class="cst-detail">
                <div>@(line.Description ?? line.DocumentType)</div>
                @if (line.TransactionNumber > 0)
                {
                    <div class="cst-txn">Txn @line.TransactionNumber</div>
                }
            </div>
        </td>
        <td data-label="Debit" class="cst-num @(line.Debit > 0 ? "" : "cst-nil")">
            @(line.Debit > 0 ? FormatCurrency(line.Debit) : "—")
        </td>
        <td data-label="Credit" class="cst-num @(line.Credit > 0 ? "cst-credit" : "cst-nil")">
            @(line.Credit > 0 ? FormatCurrency(line.Credit) : "—")
        </td>
        <td data-label="Balance" class="cst-num">@FormatCurrency(line.Balance)</td>
    </tr>;

    // — The aging row ————————————————————————————————————————————————————————

    /// <param name="Rank">
    /// 1-5, settled through seriously overdue. It picks the colour class rather than
    /// the sheet naming five buckets, so the labels stay SAP's and only the position
    /// in the ramp is ours.
    /// </param>
    private sealed record AgingBucket(int Rank, string Label, decimal Amount, decimal Share);

    private List<AgingBucket> AgingBuckets
    {
        get
        {
            var aging = statement?.Aging ?? new AgingSummary();

            var amounts = new (string Label, decimal Amount)[]
            {
                ("Current", aging.Current),
                (aging.Bucket1Label, aging.Days1To30),
                (aging.Bucket2Label, aging.Days31To60),
                (aging.Bucket3Label, aging.Days61To90),
                (aging.Bucket4Label, aging.Over90Days)
            };

            // Off the buckets, not off Aging.Total: the two are computed separately
            // and a total that disagreed with its parts would give the bar segments
            // that did not add up to the bar.
            var span = amounts.Sum(a => Math.Max(a.Amount, 0m));

            return amounts
                .Select((a, i) => new AgingBucket(
                    i + 1,
                    a.Label,
                    a.Amount,
                    span > 0 ? Math.Max(a.Amount, 0m) / span * 100m : 0m))
                .ToList();
        }
    }

    private string AgingBarLabel =>
        string.Join(", ", AgingBuckets
            .Where(b => b.Amount > 0)
            .Select(b => $"{b.Label} {FormatCurrency(b.Amount)}"))
        is { Length: > 0 } parts
            ? $"Outstanding by age: {parts}"
            : "Nothing outstanding";

    // — Labels ———————————————————————————————————————————————————————————————

    private string PeriodLabel => statement != null
        ? $"{FormatDate(statement.FromDate)} — {FormatDate(statement.ToDate)}"
        : $"{FormatDate(fromDate)} — {FormatDate(toDate)}";

    private string AccountScopeLabel => string.IsNullOrEmpty(selectedAccountFilter)
        ? "All main accounts"
        : linkedAccounts.FirstOrDefault(a => a.CardCode == selectedAccountFilter)?.CardName ?? selectedAccountFilter;

    private int DebitCount => AllLines.Count(l => l.Debit > 0);

    private string MovementLabel
    {
        get
        {
            if (statement == null)
            {
                return string.Empty;
            }

            var movement = statement.ClosingBalance - statement.OpeningBalance;

            if (movement == 0)
            {
                return "unchanged over the period";
            }

            return $"{(movement > 0 ? "up" : "down")} {FormatCurrency(Math.Abs(movement))} over the period";
        }
    }

    /// <summary>
    /// The currency the lines are actually denominated in, which is not always the one
    /// on the customer record — a linked account can be held in another.
    /// </summary>
    private string CurrencyCode =>
        AllLines.Select(l => l.Currency).FirstOrDefault(c => !string.IsNullOrWhiteSpace(c))
        ?? (string.IsNullOrWhiteSpace(customerInfo?.Currency) ? "USD" : customerInfo!.Currency!);

    private static string Pluralise(int count, string one, string many) =>
        $"{count:N0} {(count == 1 ? one : many)}";

    private static string FormatDate(DateTime date) =>
        date.ToString("dd MMM yyyy", CultureInfo.InvariantCulture);

    private static string FormatDate(DateTime? date) =>
        date.HasValue ? FormatDate(date.Value) : "—";

    // Invariant, not current: a comma decimal separator in a flex-basis is not a
    // length, and the bar would silently lay out with every segment at auto.
    private static string FormatPercent(decimal share) =>
        Math.Round(share, 3).ToString("0.###", CultureInfo.InvariantCulture) + "%";

    private string FormatCurrency(decimal amount)
    {
        return $"${amount:N2}";
    }
}
