@page "/customer-portal/dashboard"
@using System.Globalization
@using ShopInventory.Web.Models
@inject ICustomerStatementService StatementService
@inject ICustomerPortalSessionService CustomerSession
@inject ILogger<CustomerDashboard> Logger
@attribute [AllowAnonymous]
@rendermode InteractiveServer
@layout CustomerPortalLayout

<PageTitle>Dashboard - Customer Portal</PageTitle>

@* Built from the `Customer Portal Dashboard.dc.html` design. The sidebar, top
   bar and account chip it also draws are CustomerPortalLayout's, so only the
   content region is here; `cpd` is this page's section of customer-portal.css,
   and `cpx` comes down from the shell. *@
<div class="cpd fade-in">
    @if (isLoading)
    {
        <div class="cpd-panel">
            <div class="cpd-empty">
                <div class="spinner-border" role="status" style="width: 2.25rem; height: 2.25rem;">
                    <span class="visually-hidden">Loading...</span>
                </div>
                <p class="mt-3 mb-0">Loading your account...</p>
            </div>
        </div>
    }
    else if (customerInfo == null)
    {
        <div class="cpd-panel">
            <div class="cpd-empty">
                <i class="ph ph-lock-key" style="font-size: 34px;"></i>
                <h5 class="mt-3 mb-2">Authentication required</h5>
                <p class="mb-4">Please sign in to see your account.</p>
                <a href="/customer-portal/login" class="btn btn-primary">Sign in to the portal</a>
            </div>
        </div>
    }
    else
    {
        var accountBalance = dashboard?.AccountBalance ?? 0;
        var totalOutstanding = dashboard?.TotalOutstanding ?? 0;
        var overdueAmount = dashboard?.OverdueAmount ?? 0;
        var overdueCount = dashboard?.OverdueInvoicesCount ?? 0;
        var openCount = dashboard?.OpenInvoicesCount ?? 0;
        var oldestOverdue = dashboard?.OldestOverdueDays ?? 0;
        var lastPaymentAmount = dashboard?.LastPaymentAmount ?? 0;
        var terms = dashboard?.Customer?.PaymentTermsName;
        var mainAccounts = dashboard?.AccountBreakdown?.Count(a => a.AccountType == "Main") ?? 0;

        @if (!string.IsNullOrWhiteSpace(errorMessage))
        {
            <div class="alert alert-danger d-flex flex-wrap align-items-center justify-content-between gap-3" role="alert">
                <span>@errorMessage</span>
                <button type="button" class="btn btn-outline-primary" @onclick="RefreshData">Try again</button>
            </div>
        }

        <div class="cpd-hero">
            <div class="cpd-hero-text">
                <h2>@customerInfo.CardName</h2>
                <div class="cpd-hero-meta">
                    <span>Account @customerInfo.CardCode</span>
                    @if (!string.IsNullOrWhiteSpace(terms))
                    {
                        <span>Terms @terms</span>
                    }
                    @if (customerInfo.AccountStructure == "Multi")
                    {
                        <span>@(customerInfo.LinkedAccounts?.Count ?? 0) linked accounts</span>
                    }
                    <span>
                        @(lastUpdated.HasValue
                            ? $"Updated {lastUpdated.Value:MMM dd, yyyy 'at' HH:mm} UTC"
                            : "Updated on refresh")
                    </span>
                </div>
            </div>
            <div class="cpd-hero-actions">
                <button type="button" class="btn btn-outline-primary" @onclick="RefreshData">
                    <i class="ph ph-arrows-clockwise"></i> Refresh
                </button>
                <a href="/customer-portal/statements" class="btn btn-primary">View statement</a>
            </div>
        </div>

        @* The strip states the overdue position in one sentence and hands over a
           single action. It is the design's one piece of markup that is absent
           on a healthy account rather than merely empty. *@
        @if (overdueAmount > 0)
        {
            <div class="cpd-banner" role="status">
                <i class="ph ph-warning-circle"></i>
                <div class="cpd-banner-text">
                    <span class="cpd-banner-num">@FormatCurrency(overdueAmount)</span>
                    past due across @overdueCount @Plural(overdueCount, "invoice")@(oldestOverdue > 0
                        ? $" — oldest {oldestOverdue} {Plural(oldestOverdue, "day")} over terms."
                        : ".")
                </div>
                <a href="/customer-portal/invoices" class="btn cpd-banner-action">Review overdue</a>
            </div>
        }

        <section class="cpd-kpis">
            <div class="cpd-kpi">
                <div class="cpd-kpi-top">
                    <span class="cpd-kpi-label">Account balance</span>
                    <i class="ph ph-wallet"></i>
                </div>
                <div class="cpd-kpi-num">@FormatCurrency(Math.Abs(accountBalance))</div>
                <div class="cpd-kpi-sub">
                    @if (customerInfo.AccountStructure == "Multi")
                    {
                        <text>Combined across @mainAccounts main @Plural(mainAccounts, "account")</text>
                    }
                    else
                    {
                        @(accountBalance > 0 ? "Outstanding balance" : "In credit")
                    }
                </div>
                <a class="cpd-link" href="/customer-portal/statements">
                    View statement <i class="ph ph-arrow-right"></i>
                </a>
            </div>

            <div class="cpd-kpi">
                <div class="cpd-kpi-top">
                    <span class="cpd-kpi-label">Total outstanding</span>
                    <i class="ph ph-receipt"></i>
                </div>
                <div class="cpd-kpi-num">@FormatCurrency(totalOutstanding)</div>
                <div class="cpd-kpi-sub">@openCount open @Plural(openCount, "invoice")</div>
                <a class="cpd-link" href="/customer-portal/invoices">
                    Review invoices <i class="ph ph-arrow-right"></i>
                </a>
            </div>

            <div class="cpd-kpi @(overdueAmount > 0 ? "is-alert" : "")">
                <div class="cpd-kpi-top">
                    <span class="cpd-kpi-label">Overdue amount</span>
                    <i class="ph ph-clock"></i>
                </div>
                <div class="cpd-kpi-num">@FormatCurrency(overdueAmount)</div>
                <div class="cpd-kpi-sub">
                    @if (overdueCount > 0)
                    {
                        <text>@overdueCount @Plural(overdueCount, "invoice")@(oldestOverdue > 0
                            ? $", oldest {oldestOverdue} {Plural(oldestOverdue, "day")} over"
                            : "")</text>
                    }
                    else
                    {
                        <text>Nothing past due</text>
                    }
                </div>
                <a class="cpd-link" href="/customer-portal/invoices">
                    View overdue <i class="ph ph-arrow-right"></i>
                </a>
            </div>

            <div class="cpd-kpi">
                <div class="cpd-kpi-top">
                    <span class="cpd-kpi-label">Last payment</span>
                    <i class="ph ph-arrow-circle-down"></i>
                </div>
                <div class="cpd-kpi-num">@FormatCurrency(lastPaymentAmount)</div>
                <div class="cpd-kpi-sub">@LastPaymentCaption()</div>
                <a class="cpd-link" href="/customer-portal/payments">
                    View payments <i class="ph ph-arrow-right"></i>
                </a>
            </div>
        </section>

        @if (dashboard?.AccountBreakdown?.Any() == true)
        {
            <section class="cpd-panel">
                <div class="cpd-panel-head">
                    <h5>Account breakdown</h5>
                    <span class="cpd-tag">@dashboard.AccountBreakdown.Count accounts</span>
                </div>
                <div class="cpd-accounts">
                    @foreach (var account in dashboard.AccountBreakdown)
                    {
                        <div class="cpd-account @(account.AccountType == "Main" ? "is-main" : "")">
                            <div class="cpd-account-top">
                                <span class="cpd-account-name" title="@account.CardName">@account.CardName</span>
                                <span class="cpd-account-code">@account.CardCode</span>
                            </div>
                            <div class="cpd-facts">
                                <div class="cpd-fact">
                                    <span class="cpd-fact-k">@account.AccountType account</span>
                                    <span class="cpd-fact-v">
                                        @(account.AllowedTransactions.Any()
                                            ? string.Join(", ", account.AllowedTransactions.Select(FriendlyTransaction))
                                            : "—")
                                    </span>
                                </div>
                                <div class="cpd-fact">
                                    <span class="cpd-fact-k">Balance</span>
                                    <span class="cpd-fact-v">
                                        @FormatCurrencyWithCode(account.Balance, account.Currency)
                                    </span>
                                </div>
                                <div class="cpd-fact">
                                    <span class="cpd-fact-k">Outstanding</span>
                                    <span class="cpd-fact-v">
                                        @FormatCurrencyWithCode(account.TotalOutstanding, account.Currency)
                                    </span>
                                </div>
                                <div class="cpd-fact">
                                    <span class="cpd-fact-k">Open invoices</span>
                                    <span class="cpd-fact-v">@account.OpenInvoicesCount</span>
                                </div>
                                @if (account.AccountType == "Sub")
                                {
                                    <div class="cpd-fact">
                                        <span class="cpd-fact-k">Open sales orders</span>
                                        <span class="cpd-fact-v">@account.OpenSalesOrdersCount</span>
                                    </div>
                                }
                            </div>
                        </div>
                    }
                </div>
            </section>
        }

        <section class="cpd-row">
            <div class="cpd-col-wide">
                <div class="cpd-panel">
                    <div class="cpd-panel-head">
                        <h5>Aging summary</h5>
                        @if (!string.IsNullOrWhiteSpace(terms))
                        {
                            <span class="cpd-tag">Terms @terms</span>
                        }
                        <span class="cpd-panel-total">
                            Total <strong>@FormatCurrency(AgingTotal)</strong>
                        </span>
                    </div>

                    @* The bar is the buckets grown by their share of the total, so it
                       needs no percentage arithmetic of its own — and an invariant
                       format, because a comma decimal separator is not a CSS number. *@
                    <div class="cpd-aging-bar">
                        @foreach (var bucket in AgingBuckets.Where(b => b.Amount > 0))
                        {
                            <div class="cpd-aging-seg @bucket.Key"
                                 style="flex: @(bucket.Amount.ToString("F2", CultureInfo.InvariantCulture))"></div>
                        }
                    </div>

                    <div class="cpd-aging-legend">
                        @foreach (var bucket in AgingBuckets)
                        {
                            <div class="cpd-aging-item @bucket.Key @(bucket.Amount > 0 ? "" : "is-empty")">
                                <div class="cpd-aging-key">
                                    <span class="cpd-dot"></span>@bucket.Label
                                </div>
                                <div class="cpd-aging-val">@FormatCurrency(bucket.Amount)</div>
                                @if (bucket.Amount > 0)
                                {
                                    <div class="cpd-aging-sub">
                                        @if (bucket.Count > 0)
                                        {
                                            <text>@bucket.Count @Plural(bucket.Count, "invoice")</text>
                                        }
                                        else
                                        {
                                            <text>@ShareOfTotal(bucket.Amount)% of balance</text>
                                        }
                                    </div>
                                }
                            </div>
                        }
                    </div>
                </div>
            </div>

            <div class="cpd-col">
                <div class="cpd-panel cpd-month">
                    <div class="cpd-panel-head">
                        <h5>This month</h5>
                    </div>
                    @if (CurrentMonth is not null)
                    {
                        <div>
                            <div class="cpd-month-label">Billed &mdash; @CurrentMonth.Month</div>
                            <div class="cpd-month-num">@FormatCurrency(CurrentMonth.Invoiced)</div>
                        </div>
                    }
                    <div class="cpd-facts">
                        <div class="cpd-fact">
                            <span class="cpd-fact-k">Open invoices</span>
                            <span class="cpd-fact-v">@openCount</span>
                        </div>
                        <div class="cpd-fact">
                            <span class="cpd-fact-k">Overdue invoices</span>
                            <span class="cpd-fact-v @(overdueCount > 0 ? "is-alert" : "")">@overdueCount</span>
                        </div>
                        <div class="cpd-fact">
                            <span class="cpd-fact-k">Payments received</span>
                            <span class="cpd-fact-v">@FormatCurrency(dashboard?.PaymentsReceived ?? 0)</span>
                        </div>
                        <div class="cpd-fact">
                            <span class="cpd-fact-k">Oldest overdue</span>
                            <span class="cpd-fact-v @(oldestOverdue > 0 ? "is-alert" : "")">
                                @(oldestOverdue > 0 ? $"{oldestOverdue} {Plural(oldestOverdue, "day")}" : "None")
                            </span>
                        </div>
                    </div>
                    <a class="cpd-link" href="/customer-portal/activity-log">
                        Full activity log <i class="ph ph-arrow-right"></i>
                    </a>
                </div>
            </div>
        </section>

        <section class="cpd-row">
            <div class="cpd-col-wide">
                <div class="cpd-panel cpd-ledger">
                    <div class="cpd-panel-head">
                        <h5>Recent invoices</h5>
                        <a class="cpd-link" href="/customer-portal/invoices">
                            View all <i class="ph ph-arrow-right"></i>
                        </a>
                    </div>
                    @if (dashboard?.RecentInvoices?.Any() == true)
                    {
                        <div class="table-responsive">
                            <table class="cpd-table mobile-card-table">
                                <thead>
                                    <tr>
                                        <th>Invoice</th>
                                        <th>Due</th>
                                        <th class="cpd-num">Amount</th>
                                        <th class="cpd-num">Balance</th>
                                        <th class="cpd-num">Status</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var invoice in dashboard.RecentInvoices)
                                    {
                                        var status = InvoiceStatus(invoice);
                                        <tr>
                                            <td data-label="Invoice">
                                                @* One element, not two: below 992px each cell becomes a
                                                   labelled grid row, and a second child would be placed
                                                   into the label track. *@
                                                <span class="cpd-doc">
                                                    <span class="cpd-doc-id">@invoice.DocNum</span>
                                                    <span class="cpd-doc-sub">Issued @invoice.DocDate.ToString("MMM dd")</span>
                                                </span>
                                            </td>
                                            <td data-label="Due" class="cpd-quiet">
                                                @(invoice.DueDate?.ToString("MMM dd, yyyy") ?? "—")
                                            </td>
                                            <td data-label="Amount" class="cpd-num">@FormatCurrency(invoice.DocTotal)</td>
                                            <td data-label="Balance" class="cpd-num cpd-strong">@FormatCurrency(invoice.Balance)</td>
                                            <td data-label="Status" class="cpd-num">
                                                <span class="cpd-status @status.Cls">@status.Text</span>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <div class="cpd-empty">No open invoices</div>
                    }
                </div>
            </div>

            <div class="cpd-col">
                <div class="cpd-panel cpd-ledger">
                    <div class="cpd-panel-head">
                        <h5>Recent payments</h5>
                        <a class="cpd-link" href="/customer-portal/payments">
                            View all <i class="ph ph-arrow-right"></i>
                        </a>
                    </div>
                    @if (dashboard?.RecentPayments?.Any() == true)
                    {
                        <div class="table-responsive">
                            <table class="cpd-table mobile-card-table">
                                <thead>
                                    <tr>
                                        <th>Payment</th>
                                        <th>Date</th>
                                        <th>Method</th>
                                        <th class="cpd-num">Amount</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var payment in dashboard.RecentPayments)
                                    {
                                        <tr>
                                            <td data-label="Payment">
                                                <span class="cpd-doc">
                                                    <span class="cpd-doc-id">@payment.DocNum</span>
                                                    <span class="cpd-doc-sub">
                                                        @(string.IsNullOrWhiteSpace(payment.Reference) ? "No reference" : payment.Reference)
                                                    </span>
                                                </span>
                                            </td>
                                            <td data-label="Date" class="cpd-quiet">@payment.DocDate.ToString("MMM dd, yyyy")</td>
                                            <td data-label="Method" class="cpd-quiet">@payment.PaymentMethod</td>
                                            <td data-label="Amount" class="cpd-num cpd-strong">@FormatCurrency(payment.DocTotal)</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <div class="cpd-empty">No payments recorded</div>
                    }
                </div>
            </div>
        </section>
    }
</div>

@code {
    private CustomerPortalSession? portalSession;
    private CustomerInfo? customerInfo;
    private CustomerDashboardSummary? dashboard;
    private bool isLoading = true;
    private string? errorMessage;
    private DateTime? lastUpdated;
#pragma warning disable CS0414
    private bool _hasLoadedData;
#pragma warning restore CS0414

    /// <summary>One aging bucket as the legend and the bar both want it.</summary>
    private sealed record AgingBucket(string Key, string Label, decimal Amount, int Count);

    private AgingSummary Aging => dashboard?.Aging ?? new AgingSummary();

    private decimal AgingTotal => Aging.Total;

    private List<AgingBucket> AgingBuckets => new()
    {
        new("cpd-b-current", "Current", Aging.Current, Aging.CurrentCount),
        new("cpd-b-1", Aging.Bucket1Label, Aging.Days1To30, Aging.Bucket1Count),
        new("cpd-b-2", Aging.Bucket2Label, Aging.Days31To60, Aging.Bucket2Count),
        new("cpd-b-3", Aging.Bucket3Label, Aging.Days61To90, Aging.Bucket3Count),
        new("cpd-b-4", Aging.Bucket4Label, Aging.Over90Days, Aging.Bucket4Count)
    };

    private MonthlySpend? CurrentMonth => dashboard?.MonthlySpend?.LastOrDefault();

    protected override async Task OnInitializedAsync()
    {
        // Loading here rather than in OnAfterRender starts the fetch before the first render
        // instead of after it. The guard keeps the session read off any non-interactive pass;
        // see CustomerPortalLayout for why it is here even though prerendering is off.
        if (!RendererInfo.IsInteractive)
        {
            return;
        }

        await LoadCustomerData();
        _hasLoadedData = true;
    }

    private async Task LoadCustomerData()
    {
        isLoading = true;
        errorMessage = null;

        try
        {
            portalSession = await CustomerSession.GetCurrentSessionAsync();
            customerInfo = portalSession?.Customer;

            if (customerInfo == null)
            {
                dashboard = null;
                return;
            }

            dashboard = await StatementService.GetDashboardSummaryAsync(customerInfo.CardCode);
            lastUpdated = DateTime.UtcNow;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error loading customer data");
            dashboard = null;
            errorMessage = "We couldn't load your account data right now. Please try again or contact support if the problem continues.";
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task RefreshData()
    {
        await LoadCustomerData();
    }

    private string FormatCurrency(decimal amount)
    {
        return $"${amount:N2}";
    }

    private string FormatCurrencyWithCode(decimal amount, string? currency)
    {
        if (string.IsNullOrEmpty(currency) || currency == "##")
            return FormatCurrency(amount);

        return currency.ToUpperInvariant() switch
        {
            "USD" => $"${amount:N2}",
            "ZIG" => $"ZiG {amount:N2}",
            _ => $"{currency} {amount:N2}"
        };
    }

    private static string Plural(int count, string noun) => count == 1 ? noun : noun + "s";

    /// <summary>
    /// The bucket's share of the balance, to the whole percent the design labels it with.
    /// </summary>
    private string ShareOfTotal(decimal amount)
    {
        if (AgingTotal <= 0) return "0";
        return Math.Round(amount / AgingTotal * 100, 0).ToString("0", CultureInfo.InvariantCulture);
    }

    private static (string Cls, string Text) InvoiceStatus(CustomerInvoiceSummary invoice)
    {
        if (invoice.Balance <= 0) return ("is-paid", "Paid");
        if (invoice.DaysOverdue > 0) return ("is-over", $"{invoice.DaysOverdue} {Plural(invoice.DaysOverdue, "day")} over");
        return (string.Empty, "Current");
    }

    /// <summary>
    /// "Transfer · Aug 01, 2026" when the tile's amount and the listed payment are
    /// certainly the same document, and the date alone when they might not be:
    /// the amount comes from every payment fetched, the list from the first five,
    /// so naming a method off the list could caption the figure with another
    /// payment's method.
    /// </summary>
    private string LastPaymentCaption()
    {
        if (dashboard?.LastPaymentDate is not { } paidOn)
        {
            return "No payments recorded";
        }

        var date = paidOn.ToString("MMM dd, yyyy");
        var method = dashboard.RecentPayments
            .FirstOrDefault(p => p.DocDate == paidOn && p.DocTotal == dashboard.LastPaymentAmount)?
            .PaymentMethod;

        return string.IsNullOrWhiteSpace(method) ? date : $"{method} · {date}";
    }

    private static string FriendlyTransaction(string transaction) => transaction switch
    {
        "Invoice" => "Invoicing",
        "Payment" => "Payments",
        "SalesOrder" => "Sales orders",
        _ => transaction
    };
}
