@page "/lab/batch-status/history"
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize(Roles = "Admin,Lab")]
@rendermode InteractiveServer

<PageTitle>Batch Status History - Shop Inventory</PageTitle>

@* Same design, same stylesheet as /lab/batch-status — see the header comment in
   wwwroot/css/batch-status.css (linked from App.razor). *@

<div class="bsc">

    <!-- ── Header ─────────────────────────────────────────────────────── -->
    <header class="bsc-header">
        <div class="bsc-header-inner">
            <div class="bsc-header-title">
                <div class="bsc-kicker"><i class="ph ph-flask"></i><span>Lab operations</span></div>
                <h1>Batch Status History</h1>
            </div>
            <div class="bsc-header-actions">
                <button type="button" class="bsc-btn bsc-btn-secondary" disabled="@isLoading"
                        @onclick="RefreshAsync">
                    @if (isLoading)
                    {
                        <span class="bsc-spin"></span>
                    }
                    else
                    {
                        <i class="ph ph-arrows-clockwise"></i>
                    }
                    Refresh
                </button>
                <a class="bsc-btn bsc-btn-ghost" href="/lab/batch-status">
                    <i class="ph ph-sliders-horizontal"></i>Batch control
                </a>
            </div>
        </div>
        <div class="bsc-rule"></div>
    </header>

    <div class="bsc-body">

        <!-- ── What the page shows, and the query it runs on ───────────── -->
        <section class="bsc-intro">
            <p>
                Every batch status change this system attempted, newest first — who initiated it, which SAP row
                it touched, and whether SAP accepted it. Leave the search blank to load the most recent changes.
            </p>
            <div class="bsc-search">
                <div class="bsc-field bsc-field-wide">
                    <label for="bsc-history-search">Search history</label>
                    <div class="bsc-field-control">
                        <i class="ph ph-magnifying-glass"></i>
                        <input id="bsc-history-search" class="bsc-input has-icon" @bind="searchTerm"
                               @bind:event="oninput" @onkeydown="HandleSearchKeyDown"
                               placeholder="Batch, item, warehouse or user" />
                    </div>
                </div>
                <button type="button" class="bsc-btn bsc-btn-primary" disabled="@isLoading"
                        @onclick="SearchAsync">
                    @if (isLoading)
                    {
                        <span class="bsc-spin"></span>
                    }
                    @(isLoading ? "Loading" : "Search")
                </button>
            </div>
        </section>

        <!-- ── Recorded changes ───────────────────────────────────────── -->
        <section class="bsc-card">

            <div class="bsc-card-head">
                <div class="bsc-card-head-text">
                    <h2>Recorded changes</h2>
                    <p>One row per attempt — a rejected change is kept alongside the ones SAP accepted.</p>
                </div>
                @if (historyItems.Count > 0)
                {
                    <div class="bsc-card-head-meta">
                        <span class="bsc-count">@CountLabel</span>
                    </div>
                }
            </div>

            @if (isLoading && historyItems.Count == 0)
            {
                <div class="bsc-loading">
                    <span class="bsc-spin bsc-spin-lg"></span>
                    <span>Loading batch history…</span>
                </div>
            }
            else if (historyItems.Count == 0)
            {
                <div class="bsc-empty">
                    <i class="ph ph-clock-counter-clockwise"></i>
                    @if (string.IsNullOrWhiteSpace(lastSearchTerm))
                    {
                        <span class="bsc-empty-title">No batch status changes recorded yet</span>
                        <span class="bsc-empty-hint">Changes made from batch control land here as they happen.</span>
                    }
                    else
                    {
                        <span class="bsc-empty-title">No recorded changes matched that search</span>
                        <span class="bsc-empty-hint">Nothing in the audit detail matched <strong>@lastSearchTerm</strong> — try a batch number, item code, warehouse or username.</span>
                    }
                </div>
            }
            else
            {
                <div class="bsc-table-wrap">
                    <table class="bsc-table bsc-table-wide">
                        <thead>
                            <tr>
                                <th class="bsc-col-first">Changed</th>
                                <th>Batch</th>
                                <th>Item</th>
                                <th>Warehouse</th>
                                <th class="bsc-col-nowrap">Status change</th>
                                <th>Outcome</th>
                                <th class="bsc-col-last">Actor</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in historyItems)
                            {
                                <tr>
                                    <td class="bsc-col-first">
                                        <div class="bsc-stack bsc-stack-batch">
                                            <span class="bsc-strong-mono">@FormatTimestamp(item.Timestamp)</span>
                                            <span class="bsc-sub">Audit #@item.AuditLogId</span>
                                        </div>
                                    </td>
                                    <td>
                                        <div class="bsc-stack">
                                            <span class="bsc-strong-mono">@item.BatchNumber</span>
                                            <span class="bsc-sub">Entry @item.BatchEntryId</span>
                                        </div>
                                    </td>
                                    <td><span class="bsc-strong">@item.ItemCode</span></td>
                                    <td class="bsc-warehouse">
                                        @(string.IsNullOrWhiteSpace(item.WarehouseCode) ? "Unknown" : item.WarehouseCode)
                                    </td>
                                    <td>
                                        <span class="bsc-flow">
                                            <span class="bsc-status @GetStatusToneClass(item.FromStatus)">@GetStatusLabel(item.FromStatus)</span>
                                            <i class="ph ph-arrow-right"></i>
                                            <span class="bsc-status @GetStatusToneClass(item.ToStatus)">@GetStatusLabel(item.ToStatus)</span>
                                        </span>
                                    </td>
                                    <td>
                                        <span class="bsc-outcome @(item.IsSuccess ? "is-ok" : "is-bad")">
                                            <i class="@(item.IsSuccess ? "ph ph-check-circle" : "ph ph-x-circle")"></i>
                                            @(item.IsSuccess ? "Applied" : "Failed")
                                        </span>
                                        @if (!string.IsNullOrWhiteSpace(item.ErrorMessage))
                                        {
                                            <span class="bsc-error">@item.ErrorMessage</span>
                                        }
                                    </td>
                                    <td class="bsc-col-last">
                                        <div class="bsc-stack">
                                            <span class="bsc-strong">@item.Username</span>
                                            <span class="bsc-sub">@item.UserRole</span>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <div class="bsc-foot">
                    <span class="bsc-range">@RangeLabel</span>
                    <div class="bsc-pager">
                        @if (hasMore)
                        {
                            <button type="button" class="bsc-btn bsc-btn-secondary bsc-btn-sm"
                                    disabled="@isLoading" @onclick="LoadMoreAsync">
                                @if (isLoading)
                                {
                                    <span class="bsc-spin"></span>
                                }
                                else
                                {
                                    <i class="ph ph-caret-down"></i>
                                }
                                Load @PageSize more
                            </button>
                        }
                        else
                        {
                            <span class="bsc-page-label">End of history</span>
                        }
                    </div>
                </div>
            }
        </section>
    </div>
</div>
