@page "/inventory-transfer/create"
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using ShopInventory.Web.Data
@attribute [Authorize(Roles = UserRoles.InventoryTransferRoles)]
@inject IInventoryTransferService TransferService
@inject IMasterDataCacheService CacheService
@inject IWarehouseStockCacheService StockCacheService
@inject IApprovalProcessService ApprovalService
@inject NavigationManager NavigationManager
@inject ILogger<CreateInventoryTransfer> Logger
@inject IJSRuntime JS
@inject AuthenticationStateProvider AuthStateProvider
@inject IAuditService AuditService
@implements IDisposable
@rendermode InteractiveServer

<PageTitle>Create Inventory Transfer - Shop Inventory</PageTitle>

@* Styles live in wwwroot/css/transfer-forms.css (linked from App.razor), shared with
   /transfer-request/create — the two forms are the same document in two moods, so they
   are dressed from one sheet. Every control is native HTML: the MudBlazor autocompletes
   and date pickers this page was built from are gone.

   One transfer can draw from several warehouses into one (Dispatch's four into the factory
   shop) or from one out to several (the shop's returns). SAP takes each line's own
   FromWarehouseCode and WarehouseCode, so either still posts as one document. *@

<div class="tfm">
    <div class="tfm-shell">

        <!-- ── Breadcrumb strip ───────────────────────────────────────── -->
        <div class="tfm-crumbs">
            <a href="/inventory-transfers">Inventory transfers</a>
            <span class="tfm-crumb-sep">/</span>
            <span class="tfm-crumb-now">New transfer</span>
            <span class="tfm-spacer"></span>
            @if (isLoadingMasterData)
            {
                <span class="tfm-pill is-loading">
                    <span class="tfm-spin"></span>Loading master data&hellip;
                </span>
            }
            else if (IsLoadingStock)
            {
                <span class="tfm-pill is-loading">
                    <span class="tfm-spin"></span>Updating stock for @string.Join(", ", loadingStockFor)&hellip;
                </span>
            }
            else
            {
                <span class="tfm-pill is-ready">
                    <span class="tfm-dot"></span>@cachedProducts.Count.ToString("N0") items &middot;
                    @cachedWarehouses.Count warehouses
                </span>
            }
            <a href="/inventory-transfers" class="tfm-btn"><i class="ph ph-arrow-left"></i>Back</a>
        </div>

        <!-- ── Head ───────────────────────────────────────────────────── -->
        <div class="tfm-head">
            <div class="tfm-head-main">
                <div class="tfm-kicker">Warehousing</div>
                <h1>New inventory transfer</h1>
                <p>
                    Moves stock between warehouses &middot;
                    @(isAdministrator ? "posts to SAP as you submit it" : "held for approval, then posts to SAP")
                </p>
            </div>
            <div class="tfm-stats">
                <div class="tfm-stat">
                    <div class="tfm-stat-k">Items</div>
                    <div class="tfm-stat-v">@CompletedLineCount</div>
                </div>
                <div class="tfm-stat">
                    <div class="tfm-stat-k">Total quantity</div>
                    <div class="tfm-stat-v is-accent">@TotalQuantity.ToString("N2")</div>
                </div>
                <div class="tfm-stat">
                    <div class="tfm-stat-k">Route</div>
                    <div class="tfm-stat-v">
                        @RouteEndLabel(sources, "sources") &rarr; @RouteEndLabel(destinations, "warehouses")
                    </div>
                </div>
            </div>
        </div>

        <!-- ── Steps ──────────────────────────────────────────────────── -->
        <div class="tfm-steps">
            @foreach (var step in Steps)
            {
                <div class="tfm-step @StepClass(step.Number)">
                    <span class="tfm-step-n">
                        @if (IsStepCompleted(step.Number))
                        {
                            <i class="ph ph-check"></i>
                        }
                        else
                        {
                            @step.Number
                        }
                    </span>
                    <span>@step.Label</span>
                </div>
                @if (step.Number < Steps.Length)
                {
                    <span class="tfm-step-sep"></span>
                }
            }
        </div>

        <!-- ── Alerts ─────────────────────────────────────────────────── -->
        @if (!string.IsNullOrEmpty(successMessage))
        {
            <div class="tfm-alert is-ok" role="status">
                <i class="ph-fill ph-check-circle"></i>
                <div class="tfm-alert-bd">@successMessage</div>
            </div>
        }
        @if (!string.IsNullOrEmpty(errorMessage))
        {
            <div class="tfm-alert is-err" role="alert">
                <i class="ph-fill ph-warning-octagon"></i>
                <div class="tfm-alert-bd">@errorMessage</div>
                <button type="button" class="tfm-alert-x" @onclick="() => errorMessage = null"
                        aria-label="Dismiss">
                    <i class="ph ph-x"></i>
                </button>
            </div>
        }

        <div class="tfm-grid">
            <div class="tfm-main">

                <!-- ── Warehouses ─────────────────────────────────────── -->
                <section class="tfm-card">
                    <div class="tfm-card-hd">
                        <i class="ph ph-buildings"></i>
                        <h2>Warehouses</h2>
                        <span class="tfm-note">Several on one end: sources into one, or one out to several</span>
                    </div>
                    <div class="tfm-card-bd tfm-fields">
                        <div class="tfm-lab tfm-span2">
                            <label class="tfm-lab-t" for="tfm-from-wh">From warehouse@(MultiSource ? "s" : "") <span class="tfm-req">*</span></label>
                            @if (sources.Count > 0)
                            {
                                <ul class="tfm-chips" aria-label="Source warehouses">
                                    @foreach (var warehouse in sources)
                                    {
                                        <li class="tfm-chip">
                                            <span class="tfm-chip-code">@warehouse.WarehouseCode</span>
                                            @if (!string.IsNullOrWhiteSpace(warehouse.WarehouseName))
                                            {
                                                <span class="tfm-chip-name" title="@warehouse.WarehouseName">@warehouse.WarehouseName</span>
                                            }
                                            <button type="button" class="tfm-chip-x" aria-label="Remove @warehouse.WarehouseCode"
                                                    @onclick="() => RemoveSourceAsync(warehouse)">@RemoveGlyph</button>
                                        </li>
                                    }
                                </ul>
                            }
                            <NocturnePicker Class="npick-block" Id="tfm-from-wh" Options="AvailableSourceOptions"
                                            Value="@null" AllowClear="false"
                                            ValueChanged="@(code => AddSourceAsync(code))"
                                            Loading="isLoadingMasterData" LoadingText="Loading warehouses…"
                                            Invalid="@(FromWarehouseError is not null)"
                                            Placeholder="@(sources.Count == 0 ? "Select source warehouse…" : "Add another source warehouse…")"
                                            EmptyText="No more warehouses"
                                            AriaLabel="@(sources.Count == 0 ? "From warehouse" : "Add another source warehouse")" />
                            @if (FromWarehouseError is not null)
                            {
                                <div class="tfm-field-err">@FromWarehouseError</div>
                            }
                            else if (MultiSource)
                            {
                                <div class="tfm-field-hint">Each line names the warehouse it comes from.</div>
                            }
                        </div>

                        <div class="tfm-lab tfm-span2">
                            <label class="tfm-lab-t" for="tfm-to-wh">To warehouse@(MultiDestination ? "s" : "") <span class="tfm-req">*</span></label>
                            @if (destinations.Count > 0)
                            {
                                <ul class="tfm-chips" aria-label="Destination warehouses">
                                    @foreach (var warehouse in destinations)
                                    {
                                        <li class="tfm-chip">
                                            <span class="tfm-chip-code">@warehouse.WarehouseCode</span>
                                            @if (!string.IsNullOrWhiteSpace(warehouse.WarehouseName))
                                            {
                                                <span class="tfm-chip-name" title="@warehouse.WarehouseName">@warehouse.WarehouseName</span>
                                            }
                                            <button type="button" class="tfm-chip-x" aria-label="Remove @warehouse.WarehouseCode"
                                                    @onclick="() => RemoveDestinationAsync(warehouse)">@RemoveGlyph</button>
                                        </li>
                                    }
                                </ul>
                            }
                            <NocturnePicker Class="npick-block npick-end" Id="tfm-to-wh" Options="AvailableDestinationOptions"
                                            Value="@null" AllowClear="false"
                                            ValueChanged="@(code => AddDestinationAsync(code))"
                                            Loading="isLoadingMasterData" LoadingText="Loading warehouses…"
                                            Invalid="@(ToWarehouseError is not null)"
                                            Placeholder="@(destinations.Count == 0 ? "Select destination warehouse…" : "Add another destination warehouse…")"
                                            EmptyText="No more warehouses"
                                            AriaLabel="@(destinations.Count == 0 ? "To warehouse" : "Add another destination warehouse")" />
                            @if (ToWarehouseError is not null)
                            {
                                <div class="tfm-field-err">@ToWarehouseError</div>
                            }
                            else if (MultiDestination)
                            {
                                <div class="tfm-field-hint">Each line names the warehouse it goes to.</div>
                            }
                        </div>

                        <label class="tfm-lab tfm-span4">
                            <span class="tfm-lab-t">Reason for transfer <span class="tfm-req">*</span></span>
                            <textarea class="tfm-area @(ReasonError is not null ? "is-bad" : "")" rows="2"
                                      @bind="transferReason" @bind:event="oninput"
                                      placeholder="e.g. Stock replenishment, customer order fulfilment, warehouse rebalancing…"></textarea>
                            @if (ReasonError is not null)
                            {
                                <div class="tfm-field-err">@ReasonError</div>
                            }
                        </label>
                    </div>

                    <div class="tfm-route">
                        @RouteEnd("From", sources)
                        <i class="ph ph-arrow-right tfm-route-arrow"></i>
                        @RouteEnd("To", destinations)
                        <span class="tfm-spacer"></span>
                        <span class="tfm-note">
                            @(MultiSource || MultiDestination
                                ? "Posts as one SAP transfer · each line moves between its own warehouses"
                                : "Stock is shown for the source warehouse")
                        </span>
                    </div>
                </section>

                <!-- ── Document details ───────────────────────────────── -->
                <section class="tfm-card">
                    <button type="button"
                            class="tfm-card-hd is-toggle @(showDocDetails ? "" : "is-collapsed")"
                            @onclick="() => showDocDetails = !showDocDetails"
                            aria-expanded="@showDocDetails">
                        <i class="ph ph-calendar-blank"></i>
                        <h2>Document details</h2>
                        <span class="tfm-note">Dates and notes &middot; optional</span>
                        <span class="tfm-spacer"></span>
                        <i class="ph @(showDocDetails ? "ph-caret-up" : "ph-caret-down")"></i>
                    </button>
                    @if (showDocDetails)
                    {
                        <div class="tfm-card-bd tfm-fields">
                            @* Divs rather than wrapping labels: the date field carries its own
                               calendar button, and a label would forward a click on that button
                               to the text input as well. *@
                            <div class="tfm-lab tfm-span2">
                                <label class="tfm-lab-t" for="tfm-doc-date">Document date</label>
                                <NocturneDateField Id="tfm-doc-date" @bind-Date="docDate" />
                            </div>
                            <div class="tfm-lab tfm-span2">
                                <label class="tfm-lab-t" for="tfm-due-date">Due date</label>
                                <NocturneDateField Id="tfm-due-date" @bind-Date="dueDate" />
                            </div>
                            <label class="tfm-lab tfm-span4">
                                <span class="tfm-lab-t">Comments</span>
                                <textarea class="tfm-area" rows="2" @bind="comments"
                                          placeholder="Optional notes for this transfer…"></textarea>
                            </label>
                        </div>
                    }
                </section>

                <!-- ── Transfer items ─────────────────────────────────── -->
                <section class="tfm-card">
                    <div class="tfm-card-hd">
                        <i class="ph ph-list-dashes"></i>
                        <h2>Transfer items</h2>
                        <span class="tfm-count">@lines.Count</span>
                        <span class="tfm-spacer"></span>
                        <button type="button" class="tfm-btn tfm-btn-accent" @onclick="AddLine">
                            <i class="ph ph-plus"></i>Add line
                        </button>
                    </div>

                    @if (sources.Count == 0 && !isLoadingMasterData)
                    {
                        <div class="tfm-card-bd">
                            <div class="tfm-alert is-warn is-inline">
                                <i class="ph ph-info"></i>
                                <div class="tfm-alert-bd">
                                    Choose a source warehouse first — item stock is read from it, and picking
                                    items before then would show figures from nowhere.
                                </div>
                            </div>
                        </div>
                    }

                    <div class="tfm-lines @(lines.Any(l => l.ShowDropdown) ? "is-picking" : "") @(MultiSource ? "has-from" : "") @(MultiDestination ? "has-to" : "")">
                        <div class="tfm-lines-inner">
                            <div class="tfm-row is-head">
                                <div></div>
                                @if (MultiSource)
                                {
                                    <div>From <span class="tfm-req">*</span></div>
                                }
                                <div>Item <span class="tfm-req">*</span></div>
                                <div>Description</div>
                                <div>Unit</div>
                                <div class="tfm-r">Quantity <span class="tfm-req">*</span></div>
                                <div class="tfm-r">In stock</div>
                                @if (MultiDestination)
                                {
                                    <div>To <span class="tfm-req">*</span></div>
                                }
                                <div></div>
                            </div>

                            @if (isLoadingMasterData)
                            {
                                <div class="tfm-loading">
                                    <span class="tfm-spin"></span>Loading products and warehouses&hellip;
                                </div>
                            }
                            else
                            {
                                @for (var i = 0; i < lines.Count; i++)
                                {
                                    var index = i;
                                    var line = lines[index];
                                    var lineError = hasAttemptedSubmit
                                        ? DescribeLineProblem(line)
                                        : DescribeQuantityProblem(line);

                                    <div class="tfm-row" @key="line.Id">
                                        <div class="tfm-n">@(index + 1)</div>

                                        @if (MultiSource)
                                        {
                                            <NocturneSelect TValue="string" Class="nsel-block" Fixed="true"
                                                            Options="SourceOptionsFor(line)" Value="@line.FromWarehouseCode"
                                                            ValueChanged="@(code => OnLineSourceChangedAsync(line, code))"
                                                            Placeholder="Source…"
                                                            AriaLabel="@($"Source warehouse for line {index + 1}")" />
                                        }

                                        <div class="tfm-combo">
                                            <input class="tfm-input tfm-cell @(lineError is not null && line.SelectedProduct is null ? "is-bad" : "")"
                                                   value="@line.ItemCode"
                                                   @oninput="e => OnItemInput(line, e.Value?.ToString())"
                                                   @onfocus="() => OnItemFocus(line)"
                                                   @onblur="() => line.ShowDropdown = false"
                                                   placeholder="Search item…" autocomplete="off"
                                                   aria-label="@($"Item for line {index + 1}")"
                                                   disabled="@(sources.Count == 0)" />
                                            @if (line.ShowDropdown)
                                            {
                                                <div class="tfm-drop is-wide">
                                                    @if (!line.Matches.Any())
                                                    {
                                                        <div class="tfm-drop-empty">No items match that search.</div>
                                                    }
                                                    else
                                                    {
                                                        @foreach (var product in line.Matches)
                                                        {
                                                            var best = MultiSource && !IsLoadingStock ? BestStockFor(product.ItemCode) : null;
                                                            <button type="button" class="tfm-drop-i"
                                                                    @onmousedown:preventDefault="true"
                                                                    @onclick="() => SelectProductAsync(line, product)">
                                                                <span>
                                                                    <span class="tfm-drop-code">@product.ItemCode</span>
                                                                    <span class="tfm-drop-sub">@Truncate(product.ItemName, 40)</span>
                                                                </span>
                                                                @if (MultiSource && !IsLoadingStock)
                                                                {
                                                                    if (best is { } found)
                                                                    {
                                                                        <span class="tfm-drop-src">@found.Code &middot; @found.Quantity.ToString("N0")</span>
                                                                    }
                                                                    else
                                                                    {
                                                                        <span class="tfm-drop-src is-none">None in stock</span>
                                                                    }
                                                                }
                                                                @if (!string.IsNullOrWhiteSpace(product.UoM))
                                                                {
                                                                    <span class="tfm-drop-uom">@product.UoM</span>
                                                                }
                                                            </button>
                                                        }
                                                    }
                                                </div>
                                            }
                                        </div>

                                        <div class="tfm-desc @(line.SelectedProduct is null ? "is-empty" : "")"
                                             title="@line.SelectedProduct?.ItemName">
                                            @(line.SelectedProduct?.ItemName ?? "—")
                                        </div>

                                        <div>
                                            @if (!string.IsNullOrWhiteSpace(line.UoMCode))
                                            {
                                                <span class="tfm-uom @(AllowsDecimalQuantity(line.UoMCode) ? "is-decimal" : "")"
                                                      title="@(AllowsDecimalQuantity(line.UoMCode) ? "Fractional quantities allowed" : "Whole numbers only")">
                                                    @line.UoMCode
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="tfm-uom">—</span>
                                            }
                                        </div>

                                        @* step follows the item's unit: whole numbers for everything except KG,
                                           the only unit SAP accepts a fraction of. *@
                                        <input type="number" min="0" step="@QuantityStep(line)"
                                               class="tfm-input tfm-num @(lineError is not null && line.SelectedProduct is not null ? "is-bad" : "")"
                                               value="@line.QuantityText"
                                               @oninput="e => OnQuantityInputAsync(line, e.Value?.ToString())"
                                               aria-label="@($"Quantity for line {index + 1}")"
                                               placeholder="0" />

                                        <div class="tfm-stock @StockClass(line)">
                                            @if (line.SelectedProduct is null || line.FromWarehouseCode is null)
                                            {
                                                <span>—</span>
                                            }
                                            else if (line.IsLoadingStock)
                                            {
                                                <span class="tfm-spin"></span>
                                            }
                                            else
                                            {
                                                @line.StockInSource.ToString("N2")
                                                <small>@line.FromWarehouseCode</small>
                                            }
                                        </div>

                                        @if (MultiDestination)
                                        {
                                            <NocturneSelect TValue="string" Class="nsel-block" Fixed="true"
                                                            Options="DestinationOptions" Value="@line.ToWarehouseCode"
                                                            ValueChanged="@(code => OnLineDestinationChangedAsync(line, code))"
                                                            Placeholder="Destination…"
                                                            AriaLabel="@($"Destination warehouse for line {index + 1}")" />
                                        }

                                        <button type="button" class="tfm-btn-x" title="Remove line"
                                                aria-label="Remove line @(index + 1)"
                                                disabled="@(lines.Count <= 1)"
                                                @onclick="() => RemoveLineAsync(line)">
                                            <svg viewBox="0 0 256 256" aria-hidden="true" focusable="false">
                                                <path d="M205.66,194.34a8,8,0,0,1-11.32,11.32L128,139.31,61.66,205.66a8,8,0,0,1-11.32-11.32L116.69,128,50.34,61.66A8,8,0,0,1,61.66,50.34L128,116.69l66.34-66.35a8,8,0,0,1,11.32,11.32L139.31,128Z" />
                                            </svg>
                                        </button>

                                        @if (lineError is not null)
                                        {
                                            <div class="tfm-row-err">@lineError</div>
                                        }
                                        else if (ExceedsStock(line))
                                        {
                                            <div class="tfm-row-err" style="color:var(--tfm-warn);">
                                                Only @line.StockInSource.ToString("N2") in
                                                @line.FromWarehouseCode — the transfer will be short.
                                            </div>
                                        }
                                    </div>
                                }

                                <button type="button" class="tfm-addline" @onclick="AddLine">
                                    <i class="ph ph-plus"></i>Add another line
                                </button>
                            }
                        </div>
                    </div>
                </section>
            </div>

            <!-- ── Aside ──────────────────────────────────────────────── -->
            <aside class="tfm-aside">

                <div class="tfm-card tfm-total-card">
                    <div class="tfm-total-hd">
                        <span class="tfm-total-k">Total quantity</span>
                    </div>
                    <div class="tfm-total-v">@TotalQuantity.ToString("N2")</div>
                    <div class="tfm-total-sub">
                        @CompletedLineCount line(s) &middot;
                        @RouteEndLabel(sources, "sources") &rarr; @RouteEndLabel(destinations, "warehouses")
                        &middot; @((docDate ?? DateTime.Today).ToString("dd MMM yyyy"))
                    </div>

                    @if ((MultiSource || MultiDestination) && WarehouseSplit.Count > 0)
                    {
                        <ul class="tfm-split" aria-label="@(MultiSource ? "Quantity by source warehouse" : "Quantity by destination warehouse")">
                            @foreach (var split in WarehouseSplit)
                            {
                                <li>
                                    <span class="tfm-split-code">@split.Code</span>
                                    <span class="tfm-split-n">@split.Lines line@(split.Lines == 1 ? "" : "s")</span>
                                    <span class="tfm-split-q">@split.Quantity.ToString("N2")</span>
                                </li>
                            }
                        </ul>
                    }

                    @* Listed rather than enforced by disabling the button: a disabled submit gives
                       the operator nothing to act on, and the reasons below are the whole answer. *@
                    @if (hasAttemptedSubmit && ValidationSummary.Any())
                    {
                        <div class="tfm-err-panel">
                            <div class="tfm-err-panel-t">
                                <i class="ph ph-warning"></i>Please fix the following
                            </div>
                            <ul>
                                @foreach (var problem in ValidationSummary)
                                {
                                    <li>@problem</li>
                                }
                            </ul>
                        </div>
                    }

                    <button type="button" class="tfm-btn-solid" @onclick="SubmitTransfer"
                            disabled="@isSubmitting">
                        @if (isSubmitting)
                        {
                            <span class="tfm-spin on-solid"></span>
                            <span>Submitting&hellip;</span>
                        }
                        else
                        {
                            <i class="ph-fill ph-paper-plane-tilt"></i>
                            <span>@(isAdministrator ? "Post to SAP" : "Submit for approval")</span>
                        }
                    </button>
                    <button type="button" class="tfm-btn tfm-btn-wide tfm-btn-danger tfm-gap-sm"
                            @onclick="ClearForm" disabled="@isSubmitting">
                        <i class="ph ph-arrow-counter-clockwise"></i>Reset form
                    </button>
                </div>

                <!-- ── Who will approve it ─────────────────────────────── -->
                <div class="tfm-card tfm-panel">
                    <div class="tfm-panel-hd">
                        <i class="ph ph-seal-check"></i>
                        <span class="tfm-panel-t">Approval</span>
                        <span class="tfm-spacer"></span>
                        @if (isLoadingRoute)
                        {
                            <span class="tfm-spin" aria-label="Checking who will approve"></span>
                        }
                    </div>
                    <div class="tfm-approval" aria-live="polite">
                        @if (routePreviewKey is null)
                        {
                            <p class="tfm-approval-note">Choose the warehouses to see who will approve this transfer.</p>
                        }
                        else if (isLoadingRoute && routePreview is null)
                        {
                            <p class="tfm-approval-note">Checking who will approve this route&hellip;</p>
                        }
                        else if (routePreview is null)
                        {
                            <p class="tfm-approval-note">
                                Couldn't check who will approve this route. Submitting still routes it as usual.
                            </p>
                        }
                        else if (!routePreview.Matched)
                        {
                            <div class="tfm-approval-warn">
                                No approval template covers this route, so the transfer can't be submitted.
                                Ask an administrator to add one under Approval process.
                            </div>
                        }
                        else if (routePreview.ApprovedOnRaising)
                        {
                            <p class="tfm-approval-note">
                                You're an administrator, so nobody else needs to approve this transfer. It
                                posts to SAP as soon as you submit it.
                            </p>
                        }
                        else
                        {
                            <div>
                                <div class="tfm-approval-k">Template</div>
                                <div class="tfm-approval-v">@routePreview.TemplateName</div>
                            </div>
                            @foreach (var stage in routePreview.Stages)
                            {
                                <div class="tfm-approval-stage">
                                    <div class="tfm-approval-name">@stage.StageName</div>
                                    <div class="tfm-approval-sub">@StageWho(stage)</div>
                                    @if (StageWarning(stage) is { } warning)
                                    {
                                        <div class="tfm-approval-warn">@warning</div>
                                    }
                                </div>
                            }
                            <p class="tfm-approval-note">
                                Stock stays where it is until every stage approves. Then the transfer posts to
                                SAP by itself.
                            </p>
                        }
                    </div>
                </div>

                <div class="tfm-card tfm-panel">
                    <div class="tfm-panel-hd">
                        <i class="ph ph-shield-check"></i>
                        <span class="tfm-panel-t">Pre-flight checks</span>
                        <span class="tfm-spacer"></span>
                        <span class="tfm-note">@Checks.Count(c => c.Passed)/@Checks.Length</span>
                    </div>
                    <div class="tfm-checks">
                        @foreach (var check in Checks)
                        {
                            <div class="tfm-checks-i @(check.Passed ? "" : "is-no")">
                                <span class="tfm-checks-ic">
                                    <i class="ph @(check.Passed ? "ph-check" : "ph-minus")"></i>
                                </span>
                                <span>@check.Label</span>
                            </div>
                        }
                    </div>
                </div>

                <div class="tfm-info-note">
                    <i class="ph ph-info"></i>
                    @if (isAdministrator)
                    {
                        <span>
                            As an administrator, your transfer is approved as you submit it and posts to
                            SAP straight away. Stock is checked again just before it posts.
                        </span>
                    }
                    else
                    {
                        <span>
                            This transfer is held for approval and cannot post to SAP until every required
                            stage has approved it. Stock does not move when you submit.
                        </span>
                    }
                </div>

                @* An administrator's request is approved as it is raised too, so it is no way to wait. *@
                @if (!isAdministrator)
                {
                    <div class="tfm-aside-foot">
                        Need approval before the stock moves?
                        <a href="/transfer-request/create">Create a transfer request</a>
                    </div>
                }
            </aside>
        </div>
    </div>
</div>

@code {
    // SAP rejects fractional quantities for every unit except KG, and the API enforces that in
    // ShopInventory.Common.Validation.UomQuantityValidation — against the line quantity and against
    // each FEFO-allocated batch — before the document is built. Mirrored here so the operator is
    // told at the field instead of by a failed round trip.
    private const string DecimalUnit = "KG";

    // ── State ───────────────────────────────────────────
    private bool isLoadingMasterData = true;
    private bool isSubmitting;

    /// <summary>
    /// What an administrator raises is approved as they raise it and posts at once, so the page
    /// says so instead of promising an approval nobody will be asked for. The API decides; this
    /// only words the page before the first route preview arrives.
    /// </summary>
    private bool isAdministrator;
    private bool showDocDetails;
    private string? errorMessage;
    private string? successMessage;

    // Stable idempotency key for this transfer entry; reused across retries so a lost-response
    // retry is deduplicated. The page navigates away on success, so each new transfer gets a fresh key.
    private readonly string clientRequestId = Guid.NewGuid().ToString("N");

    private List<WarehouseDto> cachedWarehouses = new();
    private List<NocturnePickerOption> warehouseOptions = new();
    private List<ProductDto> cachedProducts = new();
    private HashSet<string> assignedWarehouseCodes = new(StringComparer.OrdinalIgnoreCase);

    /// <summary>
    /// The warehouses picked on each end, in the order they were added. One transfer can name several
    /// on one end — never on both, since then no line's route could be read off the form.
    /// </summary>
    private readonly List<WarehouseDto> sources = new();
    private readonly List<WarehouseDto> destinations = new();

    private bool MultiSource => sources.Count > 1;
    private bool MultiDestination => destinations.Count > 1;

    private DateTime? docDate = DateTime.Today;
    private DateTime? dueDate;
    private string? comments;
    private string? transferReason;

    private List<TransferLineItem> lines = new() { new TransferLineItem() };

    /// <summary>
    /// Each source warehouse's stock, by warehouse then item code. Held here rather than written onto
    /// the cached ProductDto objects: that cache is shared across every circuit, so merging one user's
    /// warehouse figures into it would show them to everyone else.
    /// </summary>
    private readonly Dictionary<string, Dictionary<string, ProductDto>> stockByWarehouse = new(StringComparer.OrdinalIgnoreCase);

    /// <summary>Source warehouses whose warehouse-wide stock is being read right now.</summary>
    private readonly HashSet<string> loadingStockFor = new(StringComparer.OrdinalIgnoreCase);

    /// <summary>
    /// Both cache reads go through the same EF Core DbContext, which cannot serve two queries at once,
    /// so a second source picked while the first is still loading waits its turn.
    /// </summary>
    private readonly SemaphoreSlim stockLoadGate = new(1, 1);

    private bool IsLoadingStock => loadingStockFor.Count > 0;

    /// <summary>
    /// The per-line stock confirmations, coalesced into one call at a time. Each one becomes a SAP
    /// round trip holding one of six process-wide slots, so a form firing one per line could starve
    /// every other user of the app. Built for several warehouses: lines from different sources are
    /// read in turn rather than cancelling one another, and still hold one slot between them.
    /// </summary>
    private StockRefreshBatcher? stockRefresh;

    // Who the transfer would wait on, for the warehouses it uses now. The key is those warehouses, so a
    // change that does not move the route asks nothing.
    private ApprovalRoutePreviewModel? routePreview;
    private string? routePreviewKey;
    private bool isLoadingRoute;
    private CancellationTokenSource? routePreviewCancellation;

    /// <summary>
    /// Validation is shown from the first submit attempt onwards, never before: the form opens
    /// empty, and a panel headed "please fix the following" on an untouched form is noise. After
    /// an attempt it tracks live, so entries disappear as they are fixed. The fractional-quantity
    /// message is the exception — it is shown as soon as the value is typed, because it is about
    /// one field the operator is looking at rather than about the form being incomplete.
    /// </summary>
    private bool hasAttemptedSubmit;

    private bool _hasLoadedData;

    private static readonly (int Number, string Label)[] Steps =
    [
        (1, "Warehouses"),
        (2, "Items"),
        (3, "Review")
    ];

    private static readonly RenderFragment RemoveGlyph = @<svg viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                                               stroke-width="2.4" stroke-linecap="round" aria-hidden="true">
        <path d="M6 6l12 12M18 6L6 18"></path>
    </svg>;

    // ── Derived ─────────────────────────────────────────
    private IEnumerable<TransferLineItem> CompletedLines =>
        lines.Where(l => !string.IsNullOrWhiteSpace(l.ItemCode) && l.Quantity > 0);

    private int CompletedLineCount => CompletedLines.Count();

    private decimal TotalQuantity => CompletedLines.Sum(l => l.Quantity);

    /// <summary>
    /// The warehouses the transfer will actually use on each end: those its lines name, or every pick
    /// before any line is filled in. This, not the picks, is what the API routes the approval on.
    /// </summary>
    private List<string> UsedSources => UsedCodes(CompletedLines.Select(line => line.FromWarehouseCode), sources);

    private List<string> UsedDestinations => UsedCodes(CompletedLines.Select(line => line.ToWarehouseCode), destinations);

    private static List<string> UsedCodes(IEnumerable<string?> lineCodes, List<WarehouseDto> picked)
    {
        var codes = lineCodes
            .Where(code => !string.IsNullOrWhiteSpace(code))
            .Select(code => code!)
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .ToList();
        return codes.Count > 0 ? codes : picked.Select(warehouse => warehouse.WarehouseCode!).ToList();
    }

    /// <summary>Why the warehouses chosen cannot make one transfer, or null when they can.</summary>
    private string? RouteProblem
    {
        get
        {
            if (sources.Count == 0 || destinations.Count == 0)
                return null;
            if (MultiSource && MultiDestination)
                return "Pick several warehouses on one end only: several sources into one destination, or one source out to several.";
            if (sources.Count == 1 && destinations.Count == 1 &&
                string.Equals(sources[0].WarehouseCode, destinations[0].WarehouseCode, StringComparison.OrdinalIgnoreCase))
                return "Source and destination must be different warehouses.";

            var index = lines.FindIndex(line => line.SelectedProduct is not null && line.FromWarehouseCode is not null &&
                string.Equals(line.FromWarehouseCode, line.ToWarehouseCode, StringComparison.OrdinalIgnoreCase));
            return index < 0
                ? null
                : $"Line {index + 1} moves stock from {lines[index].FromWarehouseCode} to itself — pick a different warehouse for one end.";
        }
    }

    private bool HasRoute => sources.Count > 0 && destinations.Count > 0 && RouteProblem is null;

    private bool HasReason => !string.IsNullOrWhiteSpace(transferReason);

    private bool HasCompletedLine => CompletedLineCount > 0;

    private bool LinesValid => lines.All(line => DescribeLineProblem(line) is null);

    private (string Label, bool Passed)[] Checks =>
    [
        ("Source and destination chosen", HasRoute),
        ("Reason for transfer given", HasReason),
        ("At least one item with a quantity", HasCompletedLine),
        ("Quantities valid for their units", LinesValid)
    ];

    private string? FromWarehouseError =>
        hasAttemptedSubmit && sources.Count == 0 ? "Choose a source warehouse." : null;

    private string? ToWarehouseError
    {
        get
        {
            if (!hasAttemptedSubmit)
                return null;
            if (destinations.Count == 0)
                return "Choose a destination warehouse.";
            return RouteProblem;
        }
    }

    private string? ReasonError =>
        hasAttemptedSubmit && !HasReason ? "Say why the stock is moving — approvers rely on this." : null;

    /// <summary>Everything standing between the form and a submit, in the order it appears.</summary>
    private List<string> ValidationSummary
    {
        get
        {
            var problems = new List<string>();

            if (sources.Count == 0)
                problems.Add("Choose a source warehouse.");
            if (destinations.Count == 0)
                problems.Add("Choose a destination warehouse.");
            if (RouteProblem is { } routeProblem)
                problems.Add(routeProblem);
            if (!HasReason)
                problems.Add("Give a reason for the transfer.");
            if (!HasCompletedLine)
                problems.Add("Add at least one item with a quantity.");
            if (routePreview is { Matched: false } && routePreviewKey == RoutePreviewKey(UsedSources, UsedDestinations))
                problems.Add("No approval template covers this route. Ask an administrator to add one.");

            for (var i = 0; i < lines.Count; i++)
            {
                var problem = DescribeLineProblem(lines[i]);
                if (problem is not null)
                    problems.Add($"Line {i + 1}: {problem}");
            }

            return problems;
        }
    }

    private List<NocturnePickerOption> AvailableSourceOptions => warehouseOptions
        .Where(option => !sources.Any(warehouse => string.Equals(warehouse.WarehouseCode, option.Value, StringComparison.OrdinalIgnoreCase)))
        .ToList();

    private List<NocturnePickerOption> AvailableDestinationOptions => warehouseOptions
        .Where(option => !destinations.Any(warehouse => string.Equals(warehouse.WarehouseCode, option.Value, StringComparison.OrdinalIgnoreCase)))
        .ToList();

    private NocturneSelectOption<string>[] DestinationOptions => destinations
        .Select(warehouse => new NocturneSelectOption<string>(warehouse.WarehouseCode!, warehouse.WarehouseCode!)
        {
            Hint = warehouse.WarehouseName
        })
        .ToArray();

    /// <summary>The line's source choices, each carrying that warehouse's stock of the line's item.</summary>
    private NocturneSelectOption<string>[] SourceOptionsFor(TransferLineItem line) => sources
        .Select(warehouse => new NocturneSelectOption<string>(warehouse.WarehouseCode!, warehouse.WarehouseCode!)
        {
            Hint = StockIn(warehouse.WarehouseCode, line.SelectedProduct?.ItemCode)?.QuantityInStock.ToString("N0")
        })
        .ToArray();

    /// <summary>Quantity per warehouse on the many end, for the totals card.</summary>
    private List<(string Code, int Lines, decimal Quantity)> WarehouseSplit => CompletedLines
        .GroupBy(line => (MultiSource ? line.FromWarehouseCode : line.ToWarehouseCode) ?? "—", StringComparer.OrdinalIgnoreCase)
        .Select(group => (group.Key, group.Count(), group.Sum(line => line.Quantity)))
        .ToList();

    private static string RouteEndLabel(List<WarehouseDto> picked, string plural) => picked.Count switch
    {
        0 => "—",
        1 => picked[0].WarehouseCode ?? "—",
        _ => $"{picked.Count} {plural}"
    };

    private static RenderFragment RouteEnd(string label, List<WarehouseDto> picked) => @<div class="tfm-route-end">
        <div class="tfm-route-k">@label@(picked.Count > 1 ? $" · {picked.Count} warehouses" : "")</div>
        @if (picked.Count == 0)
        {
            <div class="tfm-route-v is-empty">Not selected</div>
        }
        else if (picked.Count == 1)
        {
            <div class="tfm-route-v">@picked[0].WarehouseCode</div>
            <div class="tfm-route-sub">@picked[0].WarehouseName</div>
        }
        else
        {
            <div class="tfm-route-codes">
                @foreach (var warehouse in picked)
                {
                    <span class="tfm-split-code">@warehouse.WarehouseCode</span>
                }
            </div>
        }
    </div>;

    // ── Steps ───────────────────────────────────────────
    private bool IsStepCompleted(int step) => step switch
    {
        1 => HasRoute && HasReason,
        2 => HasCompletedLine && LinesValid,
        3 => false,
        _ => false
    };

    private string StepClass(int step)
    {
        if (IsStepCompleted(step))
            return "is-done";

        // The first unfinished step is the one being worked on.
        for (var i = 1; i <= Steps.Length; i++)
        {
            if (!IsStepCompleted(i))
                return i == step ? "is-active" : string.Empty;
        }

        return string.Empty;
    }

    // ── Lifecycle ───────────────────────────────────────
    protected override void OnInitialized() =>
        stockRefresh = new StockRefreshBatcher(StockCacheService, Logger, ApplyStockBatchAsync, multipleWarehouses: true);

    public void Dispose()
    {
        stockRefresh?.Dispose();
        routePreviewCancellation?.Cancel();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && !_hasLoadedData)
        {
            _hasLoadedData = true;
            await LoadInitialDataAsync();
            StateHasChanged();
        }
    }

    private async Task LoadInitialDataAsync()
    {
        // Sequentially: both cache reads go through the same EF Core DbContext, which cannot
        // serve two queries at once.
        try
        {
            cachedWarehouses = await CacheService.GetWarehousesAsync();
            warehouseOptions = WarehouseOptions.From(cachedWarehouses);
            cachedProducts = await CacheService.GetProductsAsync();
            Logger.LogInformation("Loaded {Warehouses} warehouses and {Products} products",
                cachedWarehouses.Count, cachedProducts.Count);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to load master data for the inventory transfer form");
            errorMessage = "We couldn't load warehouses and products. Reload the page to try again.";
        }
        finally
        {
            isLoadingMasterData = false;
        }

        await PreselectAssignedWarehouseAsync();
    }

    /// <summary>
    /// A stock or depot controller works out of one warehouse, so the source is chosen for them
    /// from their `warehouse` claim. They can add more, or swap it, from the picker.
    /// </summary>
    private async Task PreselectAssignedWarehouseAsync()
    {
        try
        {
            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            var user = authState.User;
            isAdministrator = user.IsInRole(UserRoles.Admin);

            assignedWarehouseCodes = user.FindAll("warehouse")
                .Select(claim => claim.Value)
                .Where(code => !string.IsNullOrWhiteSpace(code))
                .ToHashSet(StringComparer.OrdinalIgnoreCase);

            var role = user.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value;
            var assignedWarehouse = assignedWarehouseCodes.FirstOrDefault();

            if (string.IsNullOrEmpty(assignedWarehouse)
                || (role != "StockController" && role != "DepotController" && role != "ShopStock"))
                return;

            await AddSourceAsync(assignedWarehouse);
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Failed to preselect the assigned warehouse");
        }
    }

    // ── Warehouses ──────────────────────────────────────
    private bool IsSource(string? code) =>
        code is not null && sources.Any(warehouse => string.Equals(warehouse.WarehouseCode, code, StringComparison.OrdinalIgnoreCase));

    private bool IsDestination(string? code) =>
        code is not null && destinations.Any(warehouse => string.Equals(warehouse.WarehouseCode, code, StringComparison.OrdinalIgnoreCase));

    private async Task AddSourceAsync(string? warehouseCode)
    {
        var warehouse = FindWarehouse(warehouseCode);
        if (warehouse?.WarehouseCode is null || IsSource(warehouse.WarehouseCode))
            return;

        sources.Add(warehouse);
        NormalizeLineWarehouses();
        await LoadStockForWarehouseAsync(warehouse.WarehouseCode);
        await RefreshRoutePreviewAsync();
    }

    private async Task RemoveSourceAsync(WarehouseDto warehouse)
    {
        sources.Remove(warehouse);
        var code = warehouse.WarehouseCode!;

        // A confirmation still in flight for it is holding a SAP slot to answer for a warehouse the
        // transfer no longer uses; the other sources' work carries on.
        stockRefresh?.Cancel(code);
        stockByWarehouse.Remove(code);

        // The lines themselves are kept — the operator picked those items on purpose — and move to
        // a source still on the transfer, whose figures are read for them.
        NormalizeLineWarehouses();
        await RefreshRoutePreviewAsync();
    }

    private async Task AddDestinationAsync(string? warehouseCode)
    {
        var warehouse = FindWarehouse(warehouseCode);
        if (warehouse?.WarehouseCode is null || IsDestination(warehouse.WarehouseCode))
            return;

        destinations.Add(warehouse);
        NormalizeLineWarehouses();
        await RefreshRoutePreviewAsync();
    }

    private async Task RemoveDestinationAsync(WarehouseDto warehouse)
    {
        destinations.Remove(warehouse);
        NormalizeLineWarehouses();
        await RefreshRoutePreviewAsync();
    }

    /// <summary>
    /// Points every line at warehouses still on the transfer: the only one when an end has one, the
    /// line's own pick when it is still listed, otherwise the best remaining choice. A line whose
    /// source moves has its stock figure re-read.
    /// </summary>
    private void NormalizeLineWarehouses()
    {
        foreach (var line in lines)
        {
            var previousSource = line.FromWarehouseCode;
            line.FromWarehouseCode = sources.Count switch
            {
                0 => null,
                1 => sources[0].WarehouseCode,
                _ => IsSource(line.FromWarehouseCode) ? line.FromWarehouseCode : BestSourceFor(line.SelectedProduct?.ItemCode)
            };
            if (!string.Equals(previousSource, line.FromWarehouseCode, StringComparison.OrdinalIgnoreCase))
            {
                line.SourcePickedByHand = false;
                ResetStock(line);
                ApplyStockFromCache(line);
                QueueStockRefresh(line);
            }

            line.ToWarehouseCode = destinations.Count switch
            {
                0 => null,
                1 => destinations[0].WarehouseCode,
                _ => IsDestination(line.ToWarehouseCode) ? line.ToWarehouseCode : destinations[0].WarehouseCode
            };
        }
    }

    private async Task OnLineSourceChangedAsync(TransferLineItem line, string? warehouseCode)
    {
        if (!IsSource(warehouseCode))
            return;

        line.FromWarehouseCode = warehouseCode;
        line.SourcePickedByHand = true;
        ResetStock(line);
        ApplyStockFromCache(line);
        QueueStockRefresh(line);
        await RefreshRoutePreviewAsync();
    }

    private async Task OnLineDestinationChangedAsync(TransferLineItem line, string? warehouseCode)
    {
        if (!IsDestination(warehouseCode))
            return;

        line.ToWarehouseCode = warehouseCode;
        await RefreshRoutePreviewAsync();
    }

    private WarehouseDto? FindWarehouse(string? warehouseCode) =>
        string.IsNullOrWhiteSpace(warehouseCode)
            ? null
            : cachedWarehouses.FirstOrDefault(w =>
                string.Equals(w.WarehouseCode, warehouseCode, StringComparison.OrdinalIgnoreCase));

    /// <summary>Pulls one source warehouse's stock into <see cref="stockByWarehouse"/>.</summary>
    private async Task LoadStockForWarehouseAsync(string warehouseCode)
    {
        loadingStockFor.Add(warehouseCode);
        StateHasChanged();

        await stockLoadGate.WaitAsync();
        try
        {
            // Taken off the transfer while it waited for the previous load.
            if (!IsSource(warehouseCode))
                return;

            var stockResponse = await StockCacheService.GetAllCachedStockAsync(warehouseCode);
            if (stockResponse?.Products is null || !IsSource(warehouseCode))
                return;

            // A per-line confirmation that landed first is fresher than this cache read, so it is kept.
            var stock = StockMap(warehouseCode);
            foreach (var product in stockResponse.Products.Where(p => !string.IsNullOrEmpty(p.ItemCode)))
            {
                stock.TryAdd(product.ItemCode!, product);
            }

            foreach (var line in lines.Where(l => l.SelectedProduct is not null &&
                         string.Equals(l.FromWarehouseCode, warehouseCode, StringComparison.OrdinalIgnoreCase)))
            {
                ApplyStockFromCache(line);
            }

            Logger.LogInformation("Loaded stock for {Count} items in warehouse {Warehouse}",
                stock.Count, warehouseCode);
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Failed to load stock for warehouse {Warehouse}; the item list is still usable",
                warehouseCode);
        }
        finally
        {
            stockLoadGate.Release();
            loadingStockFor.Remove(warehouseCode);
            await InvokeAsync(StateHasChanged);
        }
    }

    private Dictionary<string, ProductDto> StockMap(string warehouseCode)
    {
        if (!stockByWarehouse.TryGetValue(warehouseCode, out var stock))
        {
            stock = new Dictionary<string, ProductDto>(StringComparer.OrdinalIgnoreCase);
            stockByWarehouse[warehouseCode] = stock;
        }

        return stock;
    }

    private ProductDto? StockIn(string? warehouseCode, string? itemCode) =>
        warehouseCode is not null && itemCode is not null &&
        stockByWarehouse.TryGetValue(warehouseCode, out var stock) && stock.TryGetValue(itemCode, out var product)
            ? product
            : null;

    /// <summary>The source holding most of the item, or null when none of them holds any.</summary>
    private (string Code, decimal Quantity)? BestStockFor(string? itemCode)
    {
        (string Code, decimal Quantity)? best = null;
        foreach (var warehouse in sources)
        {
            var quantity = StockIn(warehouse.WarehouseCode, itemCode)?.QuantityInStock ?? 0m;
            if (quantity > 0 && (best is null || quantity > best.Value.Quantity))
                best = (warehouse.WarehouseCode!, quantity);
        }

        return best;
    }

    private string? BestSourceFor(string? itemCode) =>
        BestStockFor(itemCode)?.Code ?? sources.FirstOrDefault()?.WarehouseCode;

    // ── Who will approve it ─────────────────────────────
    private static string RoutePreviewKey(List<string> from, List<string> to) =>
        $"{string.Join(",", from).ToUpperInvariant()}>{string.Join(",", to).ToUpperInvariant()}";

    /// <summary>
    /// Asks the API which template and stages the transfer would get, whenever the warehouses it uses
    /// change. Advisory: a failed preview leaves the submit exactly as it was.
    /// </summary>
    private async Task RefreshRoutePreviewAsync()
    {
        var from = UsedSources;
        var to = UsedDestinations;
        if (from.Count == 0 || to.Count == 0 || (from.Count > 1 && to.Count > 1))
        {
            routePreviewCancellation?.Cancel();
            routePreview = null;
            routePreviewKey = null;
            isLoadingRoute = false;
            return;
        }

        var key = RoutePreviewKey(from, to);
        if (key == routePreviewKey)
            return;

        routePreviewKey = key;
        routePreviewCancellation?.Cancel();
        var cancellation = routePreviewCancellation = new CancellationTokenSource();
        routePreview = null;
        isLoadingRoute = true;
        StateHasChanged();

        var preview = await ApprovalService.PreviewTransferRouteAsync(from, to, cancellation.Token);
        if (cancellation.IsCancellationRequested || key != routePreviewKey)
            return;

        routePreview = preview;
        isLoadingRoute = false;
        StateHasChanged();
    }

    private static string FriendlyRole(string role) => role switch
    {
        "StockController" => "Stock Officer",
        "DepotController" => "Depot Controller",
        "WashBay" => "Wash Bay",
        "ShopStock" => "Shop Stock",
        "Admin" => "Administrator",
        _ => role
    };

    private static string StageWho(ApprovalRoutePreviewStageModel stage)
    {
        var who = stage.AuthorizerRoles.Count == 0
            ? "Named approvers"
            : string.Join(" or ", stage.AuthorizerRoles.Select(FriendlyRole));
        var scoped = stage.WarehouseScope != ApprovalWarehouseScopes.Any && stage.ScopeWarehouses.Count > 0;
        var where = scoped ? $" assigned to {string.Join(", ", stage.ScopeWarehouses)}" : "";
        var each = scoped && stage.ApprovalPerWarehouse && stage.ScopeWarehouses.Count > 1 ? ", one from each" : "";
        var count = stage.ApprovalsRequired > 1 ? $" · {stage.ApprovalsRequired} approvals" : "";
        return $"{who}{where}{each}{count}";
    }

    private static string? StageWarning(ApprovalRoutePreviewStageModel stage)
    {
        if (stage.WarehousesWithoutAuthorizer.Count > 0)
        {
            var codes = string.Join(", ", stage.WarehousesWithoutAuthorizer);
            return $"Nobody else who could approve is assigned to {codes}, so only an administrator can approve for " +
                   (stage.WarehousesWithoutAuthorizer.Count == 1 ? "it." : "them.");
        }

        return stage.AuthorizerCount == 0 ? "Nobody else can approve this stage yet, so only an administrator can." : null;
    }

    // ── Item picker ─────────────────────────────────────
    private void OnItemFocus(TransferLineItem line)
    {
        line.Matches = SearchProducts(line.ItemCode);
        line.ShowDropdown = true;
    }

    private void OnItemInput(TransferLineItem line, string? searchText)
    {
        line.ItemCode = searchText;
        line.Matches = SearchProducts(searchText);
        line.ShowDropdown = true;

        // Typing past a chosen item drops the selection: the code in the box is no longer the
        // product whose unit and stock are on the row.
        if (line.SelectedProduct is not null
            && !string.Equals(line.SelectedProduct.ItemCode, searchText, StringComparison.OrdinalIgnoreCase))
        {
            line.SelectedProduct = null;
            line.UoMCode = null;
            line.HasStockFigure = false;
            line.StockInSource = 0;
        }
    }

    private List<ProductDto> SearchProducts(string? searchText)
    {
        if (string.IsNullOrWhiteSpace(searchText))
            return cachedProducts.Take(20).ToList();

        return cachedProducts
            .Where(p =>
                (p.ItemCode?.Contains(searchText, StringComparison.OrdinalIgnoreCase) ?? false) ||
                (p.ItemName?.Contains(searchText, StringComparison.OrdinalIgnoreCase) ?? false))
            .Take(20)
            .ToList();
    }

    private async Task SelectProductAsync(TransferLineItem line, ProductDto product)
    {
        line.SelectedProduct = product;
        line.ItemCode = product.ItemCode;
        line.UoMCode = string.IsNullOrWhiteSpace(product.UoM) ? null : product.UoM.Trim();
        line.ShowDropdown = false;

        // With several sources the line takes the one holding most of the item, unless the operator
        // already chose its source by hand.
        if (MultiSource && !line.SourcePickedByHand)
            line.FromWarehouseCode = BestSourceFor(product.ItemCode);

        ResetStock(line);
        ApplyStockFromCache(line);

        // The warehouse-wide load is a cache read and can be stale for an item that just moved,
        // so confirm this one against the service.
        QueueStockRefresh(line);
        await RefreshRoutePreviewAsync();
    }

    // ── Stock ───────────────────────────────────────────
    private static void ResetStock(TransferLineItem line)
    {
        line.StockInSource = 0;
        line.HasStockFigure = false;
        line.IsLoadingStock = false;
    }

    private void ApplyStockFromCache(TransferLineItem line)
    {
        if (StockIn(line.FromWarehouseCode, line.SelectedProduct?.ItemCode) is not { } stock)
            return;

        line.StockInSource = stock.QuantityInStock;
        line.HasStockFigure = true;
        if (string.IsNullOrWhiteSpace(line.UoMCode) && !string.IsNullOrWhiteSpace(stock.UoM))
            line.UoMCode = stock.UoM.Trim();
    }

    /// <summary>
    /// Asks for the line's stock in its source warehouse. Queued rather than read here: the batcher
    /// folds every line's request into one call per warehouse, one call at a time, so a form of any
    /// length holds one SAP slot.
    /// </summary>
    private void QueueStockRefresh(TransferLineItem line)
    {
        var warehouseCode = line.FromWarehouseCode;
        var itemCode = line.SelectedProduct?.ItemCode;
        if (string.IsNullOrWhiteSpace(warehouseCode) || string.IsNullOrWhiteSpace(itemCode))
            return;

        line.IsLoadingStock = true;
        stockRefresh?.Request(warehouseCode, itemCode);
    }

    /// <summary>
    /// Writes one batch's figures onto the lines waiting for them, taking the unit of measure from
    /// the same rows when the product cache has none — the API rejects a fractional quantity it
    /// cannot match to a unit, so this is the second chance to find one.
    /// </summary>
    /// <remarks>
    /// Runs off the circuit's synchronisation context, so every touch of component state goes
    /// through InvokeAsync. Lines are matched by the code and source they currently hold rather than
    /// by the product object queued: a line the operator has since typed past, or moved to another
    /// source, does not match this batch.
    /// </remarks>
    private Task ApplyStockBatchAsync(StockRefreshBatch batch) => InvokeAsync(() =>
    {
        // Drop a late batch for a warehouse taken off the transfer while it was in flight.
        if (!IsSource(batch.WarehouseCode))
            return;

        var stockMap = StockMap(batch.WarehouseCode);
        foreach (var (itemCode, stock) in batch.Stock)
            stockMap[itemCode] = stock;

        foreach (var line in lines)
        {
            var itemCode = line.SelectedProduct?.ItemCode;
            if (string.IsNullOrWhiteSpace(itemCode) || !batch.RequestedItemCodes.Contains(itemCode) ||
                !string.Equals(line.FromWarehouseCode, batch.WarehouseCode, StringComparison.OrdinalIgnoreCase))
                continue;

            // Cleared for every code that was asked about, so a line for an item the warehouse
            // holds no row for stops spinning too.
            line.IsLoadingStock = false;

            if (!batch.Stock.TryGetValue(itemCode, out var stock))
                continue;

            line.StockInSource = stock.QuantityInStock;
            line.HasStockFigure = true;
            if (string.IsNullOrWhiteSpace(line.UoMCode) && !string.IsNullOrWhiteSpace(stock.UoM))
                line.UoMCode = stock.UoM.Trim();
        }

        StateHasChanged();
    });

    private bool ExceedsStock(TransferLineItem line) =>
        line.SelectedProduct is not null
        && line.FromWarehouseCode is not null
        && line.HasStockFigure
        && line.Quantity > line.StockInSource;

    private string StockClass(TransferLineItem line)
    {
        if (line.SelectedProduct is null || line.FromWarehouseCode is null || !line.HasStockFigure)
            return "is-idle";

        return ExceedsStock(line) ? "is-short" : string.Empty;
    }

    // ── Lines ───────────────────────────────────────────
    private void AddLine()
    {
        var line = new TransferLineItem
        {
            FromWarehouseCode = sources.FirstOrDefault()?.WarehouseCode,
            ToWarehouseCode = destinations.FirstOrDefault()?.WarehouseCode
        };
        lines.Add(line);
    }

    private async Task RemoveLineAsync(TransferLineItem line)
    {
        if (lines.Count <= 1)
            return;

        lines.Remove(line);
        await RefreshRoutePreviewAsync();
    }

    private async Task OnQuantityInputAsync(TransferLineItem line, string? value)
    {
        line.QuantityText = value;
        line.Quantity = decimal.TryParse(value, out var quantity) ? quantity : 0m;

        // A line becomes part of the route once it has a quantity, which can bring in a warehouse.
        await RefreshRoutePreviewAsync();
    }

    // ── Validation ──────────────────────────────────────
    private static bool AllowsDecimalQuantity(string? uomCode) =>
        string.Equals(uomCode?.Trim(), DecimalUnit, StringComparison.OrdinalIgnoreCase);

    private string QuantityStep(TransferLineItem line) =>
        AllowsDecimalQuantity(line.UoMCode) ? "0.001" : "1";

    /// <summary>
    /// Why a fractional quantity on this line would be rejected, or null. Split out from
    /// <see cref="DescribeLineProblem"/> because it is shown before the first submit attempt: it is
    /// about a value the operator just typed, not about the form being unfinished.
    /// </summary>
    private string? DescribeQuantityProblem(TransferLineItem line)
    {
        if (line.Quantity <= 0 || line.Quantity == decimal.Truncate(line.Quantity))
            return null;

        // The API resolves the unit from a Products table that nothing in the API populates, so a
        // fractional quantity sent without a unit is always rejected.
        if (string.IsNullOrWhiteSpace(line.UoMCode))
            return $"{line.Quantity} needs a unit of measure and this item has none cached — enter a whole number instead.";

        if (!AllowsDecimalQuantity(line.UoMCode))
            return $"{line.Quantity} isn't valid for {line.UoMCode} — only {DecimalUnit} items transfer in fractions.";

        return null;
    }

    /// <summary>
    /// What is wrong with a line, phrased for the operator, or null when it is fine. A line nobody
    /// has touched is fine — it is the spare row at the bottom of the table, not a mistake.
    /// </summary>
    private string? DescribeLineProblem(TransferLineItem line)
    {
        var hasItem = !string.IsNullOrWhiteSpace(line.ItemCode);

        if (!hasItem && line.Quantity <= 0)
            return null;

        if (!hasItem)
            return "choose an item, or clear the quantity.";

        if (line.SelectedProduct is null)
            return $"\"{line.ItemCode}\" isn't a known item — pick one from the list.";

        if (line.Quantity <= 0)
            return "enter a quantity greater than zero.";

        if (sources.Count > 0 && !IsSource(line.FromWarehouseCode))
            return "choose the warehouse it comes from.";

        if (destinations.Count > 0 && !IsDestination(line.ToWarehouseCode))
            return "choose the warehouse it goes to.";

        return DescribeQuantityProblem(line);
    }

    private static string Truncate(string? value, int maxLength)
    {
        if (string.IsNullOrEmpty(value))
            return string.Empty;

        return value.Length <= maxLength ? value : value[..maxLength] + "…";
    }

    private async Task ScrollToTopAsync()
    {
        try { await JS.InvokeVoidAsync("window.scrollTo", 0, 0); } catch { }
    }

    // ── Submit ──────────────────────────────────────────
    private async Task SubmitTransfer()
    {
        errorMessage = null;
        successMessage = null;
        hasAttemptedSubmit = true;

        var problems = ValidationSummary;
        if (problems.Any())
        {
            errorMessage = problems.Count == 1
                ? problems[0]
                : $"{problems.Count} things need fixing before this transfer can be submitted.";
            return;
        }

        isSubmitting = true;

        try
        {
            var completed = CompletedLines.ToList();
            var request = new CreateInventoryTransferDto
            {
                // SAP's header takes one of each; every line carries its own pair, which is what SAP
                // and the approval engine actually go by.
                FromWarehouse = UsedSources[0],
                ToWarehouse = UsedDestinations[0],
                DocDate = (docDate ?? DateTime.Today).ToString("yyyy-MM-dd"),
                DueDate = dueDate?.ToString("yyyy-MM-dd"),
                Comments = BuildComments(),
                ClientRequestId = clientRequestId,

                Lines = completed
                    .Select(l => new CreateInventoryTransferLineDto
                    {
                        ItemCode = l.ItemCode,
                        Quantity = l.Quantity,
                        // Without this the API falls back to its own Products table, which is never
                        // populated, and rejects every fractional quantity it sees — the line's own
                        // and every batch it allocates.
                        UoMCode = l.UoMCode,
                        FromWarehouseCode = l.FromWarehouseCode,
                        ToWarehouseCode = l.ToWarehouseCode
                    })
                    .ToList()
            };

            Logger.LogInformation("Submitting inventory transfer: From={From}, To={To}, Lines={Lines}",
                string.Join(",", UsedSources), string.Join(",", UsedDestinations), request.Lines.Count);

            var (success, message, transfer, pendingTransfer) = await TransferService.CreateInventoryTransferAsync(request);

            if (success)
            {
                if (transfer is null && pendingTransfer is not null
                    && pendingTransfer.Status is "Approved" or "PostFailed")
                {
                    // Approved as raised, but SAP turned the post away. It is saved and retryable
                    // from the transfer list, so this is not a failed submission; the page says
                    // what SAP said and stays put rather than redirecting past it.
                    errorMessage = message;
                    Logger.LogWarning("Administrator transfer {PendingId} approved but not posted: {Message}",
                        pendingTransfer.Id, message);
                    await AuditService.LogAsync(AuditActions.CreateTransfer, "InventoryTransfer",
                        pendingTransfer.Id.ToString(), null, false, message);
                    StateHasChanged();
                    await ScrollToTopAsync();
                    return;
                }

                if (transfer is null && pendingTransfer is not null)
                {
                    var pendingStage = pendingTransfer.ApprovalStages.FirstOrDefault(stage => stage.Status == "Pending");
                    successMessage = pendingStage is null
                        ? "Transfer submitted for approval. It will post to SAP once approved. Redirecting…"
                        : $"Transfer submitted for approval — waiting on {pendingStage.StageName}. Redirecting…";
                    Logger.LogInformation("Inventory transfer submitted for approval: PendingId={PendingId}", pendingTransfer.Id);
                }
                else
                {
                    successMessage = $"Transfer #{transfer?.DocNum} created successfully! Redirecting…";
                    Logger.LogInformation("Inventory transfer created: DocNum={DocNum}, DocEntry={DocEntry}",
                        transfer?.DocNum, transfer?.DocEntry);
                }

                await AuditService.LogAsync(AuditActions.CreateTransfer, "InventoryTransfer",
                    transfer?.DocNum.ToString() ?? pendingTransfer?.Id.ToString());

                StateHasChanged();
                await Task.Delay(1500);
                NavigationManager.NavigateTo("/inventory-transfers");
            }
            else
            {
                errorMessage = string.IsNullOrWhiteSpace(message)
                    ? "We couldn't submit this transfer. Please try again."
                    : message;
                Logger.LogWarning("Failed to create inventory transfer: {Message}", message);
                await AuditService.LogAsync(AuditActions.CreateTransfer, "InventoryTransfer", null, null, false, message);
                StateHasChanged();
                await ScrollToTopAsync();
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error submitting inventory transfer");
            errorMessage = $"An unexpected error occurred: {ex.Message}";
            StateHasChanged();
            await ScrollToTopAsync();
        }
        finally
        {
            isSubmitting = false;
        }
    }

    private string BuildComments()
    {
        var parts = new List<string>();
        if (!string.IsNullOrWhiteSpace(transferReason))
            parts.Add($"Reason: {transferReason.Trim()}");
        if (!string.IsNullOrWhiteSpace(comments))
            parts.Add(comments.Trim());
        return string.Join(" | ", parts);
    }

    private void ClearForm()
    {
        stockRefresh?.Cancel();
        routePreviewCancellation?.Cancel();
        sources.Clear();
        destinations.Clear();
        docDate = DateTime.Today;
        dueDate = null;
        comments = null;
        transferReason = null;
        hasAttemptedSubmit = false;
        showDocDetails = false;
        errorMessage = null;
        successMessage = null;
        stockByWarehouse.Clear();
        routePreview = null;
        routePreviewKey = null;
        isLoadingRoute = false;
        lines = new List<TransferLineItem> { new TransferLineItem() };
    }

    private class TransferLineItem
    {
        public Guid Id { get; } = Guid.NewGuid();
        public ProductDto? SelectedProduct { get; set; }
        public string? ItemCode { get; set; }
        public decimal Quantity { get; set; }

        /// <summary>
        /// What is in the box, kept apart from <see cref="Quantity"/> so a half-typed "0." or a
        /// cleared field is not rewritten under the cursor on the next render.
        /// </summary>
        public string? QuantityText { get; set; }

        public string? UoMCode { get; set; }

        /// <summary>The warehouse this line draws from: always one of the transfer's sources.</summary>
        public string? FromWarehouseCode { get; set; }

        /// <summary>The warehouse this line delivers to: always one of the transfer's destinations.</summary>
        public string? ToWarehouseCode { get; set; }

        /// <summary>
        /// Set when the operator chose the line's source themselves, so picking an item does not
        /// move it to the warehouse holding the most.
        /// </summary>
        public bool SourcePickedByHand { get; set; }

        /// <summary>The line's item in its own source warehouse.</summary>
        public decimal StockInSource { get; set; }
        public bool HasStockFigure { get; set; }
        public bool IsLoadingStock { get; set; }

        public bool ShowDropdown { get; set; }
        public List<ProductDto> Matches { get; set; } = new();
    }
}
