@page "/inventory-transfer/create"
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using ShopInventory.Web.Data
@attribute [Authorize(Roles = UserRoles.InventoryTransferRoles)]
@inject IInventoryTransferService TransferService
@inject IMasterDataCacheService CacheService
@inject IWarehouseStockCacheService StockCacheService
@inject NavigationManager NavigationManager
@inject ILogger<CreateInventoryTransfer> Logger
@inject IJSRuntime JS
@inject AuthenticationStateProvider AuthStateProvider
@inject IAuditService AuditService
@implements IDisposable
@rendermode InteractiveServer

<PageTitle>Create Inventory Transfer - Shop Inventory</PageTitle>

@* Styles live in wwwroot/css/transfer-forms.css (linked from App.razor), shared with
   /transfer-request/create — the two forms are the same document in two moods, so they
   are dressed from one sheet. Every control is native HTML: the MudBlazor autocompletes
   and date pickers this page was built from are gone. *@

<div class="tfm">
    <div class="tfm-shell">

        <!-- ── Breadcrumb strip ───────────────────────────────────────── -->
        <div class="tfm-crumbs">
            <a href="/inventory-transfers">Inventory transfers</a>
            <span class="tfm-crumb-sep">/</span>
            <span class="tfm-crumb-now">New transfer</span>
            <span class="tfm-spacer"></span>
            @if (isLoadingMasterData)
            {
                <span class="tfm-pill is-loading">
                    <span class="tfm-spin"></span>Loading master data&hellip;
                </span>
            }
            else if (isLoadingStock)
            {
                <span class="tfm-pill is-loading">
                    <span class="tfm-spin"></span>Updating stock for @selectedFromWarehouse?.WarehouseCode&hellip;
                </span>
            }
            else
            {
                <span class="tfm-pill is-ready">
                    <span class="tfm-dot"></span>@cachedProducts.Count.ToString("N0") items &middot;
                    @cachedWarehouses.Count warehouses
                </span>
            }
            <a href="/inventory-transfers" class="tfm-btn"><i class="ph ph-arrow-left"></i>Back</a>
        </div>

        <!-- ── Head ───────────────────────────────────────────────────── -->
        <div class="tfm-head">
            <div class="tfm-head-main">
                <div class="tfm-kicker">Warehousing</div>
                <h1>New inventory transfer</h1>
                <p>Moves stock between warehouses &middot; held for approval, then posts to SAP</p>
            </div>
            <div class="tfm-stats">
                <div class="tfm-stat">
                    <div class="tfm-stat-k">Items</div>
                    <div class="tfm-stat-v">@CompletedLineCount</div>
                </div>
                <div class="tfm-stat">
                    <div class="tfm-stat-k">Total quantity</div>
                    <div class="tfm-stat-v is-accent">@TotalQuantity.ToString("N2")</div>
                </div>
                <div class="tfm-stat">
                    <div class="tfm-stat-k">Route</div>
                    <div class="tfm-stat-v">
                        @(selectedFromWarehouse?.WarehouseCode ?? "—") &rarr;
                        @(selectedToWarehouse?.WarehouseCode ?? "—")
                    </div>
                </div>
            </div>
        </div>

        <!-- ── Steps ──────────────────────────────────────────────────── -->
        <div class="tfm-steps">
            @foreach (var step in Steps)
            {
                <div class="tfm-step @StepClass(step.Number)">
                    <span class="tfm-step-n">
                        @if (IsStepCompleted(step.Number))
                        {
                            <i class="ph ph-check"></i>
                        }
                        else
                        {
                            @step.Number
                        }
                    </span>
                    <span>@step.Label</span>
                </div>
                @if (step.Number < Steps.Length)
                {
                    <span class="tfm-step-sep"></span>
                }
            }
        </div>

        <!-- ── Alerts ─────────────────────────────────────────────────── -->
        @if (!string.IsNullOrEmpty(successMessage))
        {
            <div class="tfm-alert is-ok" role="status">
                <i class="ph-fill ph-check-circle"></i>
                <div class="tfm-alert-bd">@successMessage</div>
            </div>
        }
        @if (!string.IsNullOrEmpty(errorMessage))
        {
            <div class="tfm-alert is-err" role="alert">
                <i class="ph-fill ph-warning-octagon"></i>
                <div class="tfm-alert-bd">@errorMessage</div>
                <button type="button" class="tfm-alert-x" @onclick="() => errorMessage = null"
                        aria-label="Dismiss">
                    <i class="ph ph-x"></i>
                </button>
            </div>
        }

        <div class="tfm-grid">
            <div class="tfm-main">

                <!-- ── Warehouses ─────────────────────────────────────── -->
                <section class="tfm-card">
                    <div class="tfm-card-hd">
                        <i class="ph ph-buildings"></i>
                        <h2>Warehouses</h2>
                    </div>
                    <div class="tfm-card-bd tfm-fields">
                        <label class="tfm-lab tfm-span2">
                            <span class="tfm-lab-t">From warehouse <span class="tfm-req">*</span></span>
                            <select class="tfm-select @(FromWarehouseError is not null ? "is-bad" : "")"
                                    value="@selectedFromWarehouse?.WarehouseCode"
                                    @onchange="e => OnFromWarehouseChangedAsync(e.Value?.ToString())"
                                    disabled="@isLoadingMasterData">
                                <option value="">@(isLoadingMasterData ? "Loading warehouses…" : "Select source warehouse…")</option>
                                @foreach (var warehouse in cachedWarehouses)
                                {
                                    <option value="@warehouse.WarehouseCode">@warehouse.DisplayName</option>
                                }
                            </select>
                            @if (FromWarehouseError is not null)
                            {
                                <div class="tfm-field-err">@FromWarehouseError</div>
                            }
                        </label>

                        <label class="tfm-lab tfm-span2">
                            <span class="tfm-lab-t">To warehouse <span class="tfm-req">*</span></span>
                            <select class="tfm-select @(ToWarehouseError is not null ? "is-bad" : "")"
                                    value="@selectedToWarehouse?.WarehouseCode"
                                    @onchange="e => OnToWarehouseChanged(e.Value?.ToString())"
                                    disabled="@isLoadingMasterData">
                                <option value="">@(isLoadingMasterData ? "Loading warehouses…" : "Select destination warehouse…")</option>
                                @foreach (var warehouse in cachedWarehouses)
                                {
                                    <option value="@warehouse.WarehouseCode">@warehouse.DisplayName</option>
                                }
                            </select>
                            @if (ToWarehouseError is not null)
                            {
                                <div class="tfm-field-err">@ToWarehouseError</div>
                            }
                        </label>

                        <label class="tfm-lab tfm-span4">
                            <span class="tfm-lab-t">Reason for transfer <span class="tfm-req">*</span></span>
                            <textarea class="tfm-area @(ReasonError is not null ? "is-bad" : "")" rows="2"
                                      @bind="transferReason" @bind:event="oninput"
                                      placeholder="e.g. Stock replenishment, customer order fulfilment, warehouse rebalancing…"></textarea>
                            @if (ReasonError is not null)
                            {
                                <div class="tfm-field-err">@ReasonError</div>
                            }
                        </label>
                    </div>

                    <div class="tfm-route">
                        <div class="tfm-route-end">
                            <div class="tfm-route-k">From</div>
                            <div class="tfm-route-v @(selectedFromWarehouse is null ? "is-empty" : "")">
                                @(selectedFromWarehouse?.WarehouseCode ?? "Not selected")
                            </div>
                            @if (selectedFromWarehouse is not null)
                            {
                                <div class="tfm-route-sub">@selectedFromWarehouse.WarehouseName</div>
                            }
                        </div>
                        <i class="ph ph-arrow-right tfm-route-arrow"></i>
                        <div class="tfm-route-end">
                            <div class="tfm-route-k">To</div>
                            <div class="tfm-route-v @(selectedToWarehouse is null ? "is-empty" : "")">
                                @(selectedToWarehouse?.WarehouseCode ?? "Not selected")
                            </div>
                            @if (selectedToWarehouse is not null)
                            {
                                <div class="tfm-route-sub">@selectedToWarehouse.WarehouseName</div>
                            }
                        </div>
                        <span class="tfm-spacer"></span>
                        <span class="tfm-note">Stock is shown for the source warehouse</span>
                    </div>
                </section>

                <!-- ── Document details ───────────────────────────────── -->
                <section class="tfm-card">
                    <button type="button"
                            class="tfm-card-hd is-toggle @(showDocDetails ? "" : "is-collapsed")"
                            @onclick="() => showDocDetails = !showDocDetails"
                            aria-expanded="@showDocDetails">
                        <i class="ph ph-calendar-blank"></i>
                        <h2>Document details</h2>
                        <span class="tfm-note">Dates and notes &middot; optional</span>
                        <span class="tfm-spacer"></span>
                        <i class="ph @(showDocDetails ? "ph-caret-up" : "ph-caret-down")"></i>
                    </button>
                    @if (showDocDetails)
                    {
                        <div class="tfm-card-bd tfm-fields">
                            @* Divs rather than wrapping labels: the date field carries its own
                               calendar button, and a label would forward a click on that button
                               to the text input as well. *@
                            <div class="tfm-lab tfm-span2">
                                <label class="tfm-lab-t" for="tfm-doc-date">Document date</label>
                                <NocturneDateField Id="tfm-doc-date" @bind-Date="docDate" />
                            </div>
                            <div class="tfm-lab tfm-span2">
                                <label class="tfm-lab-t" for="tfm-due-date">Due date</label>
                                <NocturneDateField Id="tfm-due-date" @bind-Date="dueDate" />
                            </div>
                            <label class="tfm-lab tfm-span4">
                                <span class="tfm-lab-t">Comments</span>
                                <textarea class="tfm-area" rows="2" @bind="comments"
                                          placeholder="Optional notes for this transfer…"></textarea>
                            </label>
                        </div>
                    }
                </section>

                <!-- ── Transfer items ─────────────────────────────────── -->
                <section class="tfm-card">
                    <div class="tfm-card-hd">
                        <i class="ph ph-list-dashes"></i>
                        <h2>Transfer items</h2>
                        <span class="tfm-count">@lines.Count</span>
                        <span class="tfm-spacer"></span>
                        <button type="button" class="tfm-btn tfm-btn-accent" @onclick="AddLine">
                            <i class="ph ph-plus"></i>Add line
                        </button>
                    </div>

                    @if (selectedFromWarehouse is null && !isLoadingMasterData)
                    {
                        <div class="tfm-card-bd">
                            <div class="tfm-alert is-warn is-inline">
                                <i class="ph ph-info"></i>
                                <div class="tfm-alert-bd">
                                    Choose a source warehouse first — item stock is read from it, and picking
                                    items before then would show figures from nowhere.
                                </div>
                            </div>
                        </div>
                    }

                    <div class="tfm-lines @(lines.Any(l => l.ShowDropdown) ? "is-picking" : "")">
                        <div class="tfm-lines-inner">
                            <div class="tfm-row is-head">
                                <div></div>
                                <div>Item <span class="tfm-req">*</span></div>
                                <div>Description</div>
                                <div>Unit</div>
                                <div class="tfm-r">Quantity <span class="tfm-req">*</span></div>
                                <div class="tfm-r">In stock</div>
                                <div></div>
                            </div>

                            @if (isLoadingMasterData)
                            {
                                <div class="tfm-loading">
                                    <span class="tfm-spin"></span>Loading products and warehouses&hellip;
                                </div>
                            }
                            else
                            {
                                @for (var i = 0; i < lines.Count; i++)
                                {
                                    var index = i;
                                    var line = lines[index];
                                    var lineError = hasAttemptedSubmit
                                        ? DescribeLineProblem(line)
                                        : DescribeQuantityProblem(line);

                                    <div class="tfm-row" @key="line.Id">
                                        <div class="tfm-n">@(index + 1)</div>

                                        <div class="tfm-combo">
                                            <input class="tfm-input tfm-cell @(lineError is not null && line.SelectedProduct is null ? "is-bad" : "")"
                                                   value="@line.ItemCode"
                                                   @oninput="e => OnItemInput(line, e.Value?.ToString())"
                                                   @onfocus="() => OnItemFocus(line)"
                                                   @onblur="() => line.ShowDropdown = false"
                                                   placeholder="Search item…" autocomplete="off"
                                                   disabled="@(selectedFromWarehouse is null)" />
                                            @if (line.ShowDropdown)
                                            {
                                                <div class="tfm-drop is-wide">
                                                    @if (!line.Matches.Any())
                                                    {
                                                        <div class="tfm-drop-empty">No items match that search.</div>
                                                    }
                                                    else
                                                    {
                                                        @foreach (var product in line.Matches)
                                                        {
                                                            <button type="button" class="tfm-drop-i"
                                                                    @onmousedown:preventDefault="true"
                                                                    @onclick="() => SelectProduct(line, product)">
                                                                <span>
                                                                    <span class="tfm-drop-code">@product.ItemCode</span>
                                                                    <span class="tfm-drop-sub">@Truncate(product.ItemName, 40)</span>
                                                                </span>
                                                                @if (!string.IsNullOrWhiteSpace(product.UoM))
                                                                {
                                                                    <span class="tfm-drop-uom">@product.UoM</span>
                                                                }
                                                            </button>
                                                        }
                                                    }
                                                </div>
                                            }
                                        </div>

                                        <div class="tfm-desc @(line.SelectedProduct is null ? "is-empty" : "")"
                                             title="@line.SelectedProduct?.ItemName">
                                            @(line.SelectedProduct?.ItemName ?? "—")
                                        </div>

                                        <div>
                                            @if (!string.IsNullOrWhiteSpace(line.UoMCode))
                                            {
                                                <span class="tfm-uom @(AllowsDecimalQuantity(line.UoMCode) ? "is-decimal" : "")"
                                                      title="@(AllowsDecimalQuantity(line.UoMCode) ? "Fractional quantities allowed" : "Whole numbers only")">
                                                    @line.UoMCode
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="tfm-uom">—</span>
                                            }
                                        </div>

                                        @* step follows the item's unit: whole numbers for everything except KG,
                                           the only unit SAP accepts a fraction of. *@
                                        <input type="number" min="0" step="@QuantityStep(line)"
                                               class="tfm-input tfm-num @(lineError is not null && line.SelectedProduct is not null ? "is-bad" : "")"
                                               value="@line.QuantityText"
                                               @oninput="e => OnQuantityInput(line, e.Value?.ToString())"
                                               placeholder="0" />

                                        <div class="tfm-stock @StockClass(line)">
                                            @if (line.SelectedProduct is null || selectedFromWarehouse is null)
                                            {
                                                <span>—</span>
                                            }
                                            else if (line.IsLoadingStock)
                                            {
                                                <span class="tfm-spin"></span>
                                            }
                                            else
                                            {
                                                @line.StockInSource.ToString("N2")
                                                <small>@selectedFromWarehouse.WarehouseCode</small>
                                            }
                                        </div>

                                        <button type="button" class="tfm-btn-x" title="Remove line"
                                                aria-label="Remove line @(index + 1)"
                                                disabled="@(lines.Count <= 1)"
                                                @onclick="() => RemoveLine(line)">
                                            <svg viewBox="0 0 256 256" aria-hidden="true" focusable="false">
                                                <path d="M205.66,194.34a8,8,0,0,1-11.32,11.32L128,139.31,61.66,205.66a8,8,0,0,1-11.32-11.32L116.69,128,50.34,61.66A8,8,0,0,1,61.66,50.34L128,116.69l66.34-66.35a8,8,0,0,1,11.32,11.32L139.31,128Z" />
                                            </svg>
                                        </button>

                                        @if (lineError is not null)
                                        {
                                            <div class="tfm-row-err">@lineError</div>
                                        }
                                        else if (ExceedsStock(line))
                                        {
                                            <div class="tfm-row-err" style="color:var(--tfm-warn);">
                                                Only @line.StockInSource.ToString("N2") in
                                                @selectedFromWarehouse?.WarehouseCode — the transfer will be short.
                                            </div>
                                        }
                                    </div>
                                }

                                <button type="button" class="tfm-addline" @onclick="AddLine">
                                    <i class="ph ph-plus"></i>Add another line
                                </button>
                            }
                        </div>
                    </div>
                </section>
            </div>

            <!-- ── Aside ──────────────────────────────────────────────── -->
            <aside class="tfm-aside">

                <div class="tfm-card tfm-total-card">
                    <div class="tfm-total-hd">
                        <span class="tfm-total-k">Total quantity</span>
                    </div>
                    <div class="tfm-total-v">@TotalQuantity.ToString("N2")</div>
                    <div class="tfm-total-sub">
                        @CompletedLineCount line(s) &middot;
                        @(selectedFromWarehouse?.WarehouseCode ?? "—") &rarr; @(selectedToWarehouse?.WarehouseCode ?? "—")
                        &middot; @((docDate ?? DateTime.Today).ToString("dd MMM yyyy"))
                    </div>

                    @* Listed rather than enforced by disabling the button: a disabled submit gives
                       the operator nothing to act on, and the reasons below are the whole answer. *@
                    @if (hasAttemptedSubmit && ValidationSummary.Any())
                    {
                        <div class="tfm-err-panel">
                            <div class="tfm-err-panel-t">
                                <i class="ph ph-warning"></i>Please fix the following
                            </div>
                            <ul>
                                @foreach (var problem in ValidationSummary)
                                {
                                    <li>@problem</li>
                                }
                            </ul>
                        </div>
                    }

                    <button type="button" class="tfm-btn-solid" @onclick="SubmitTransfer"
                            disabled="@isSubmitting">
                        @if (isSubmitting)
                        {
                            <span class="tfm-spin on-solid"></span>
                            <span>Submitting&hellip;</span>
                        }
                        else
                        {
                            <i class="ph-fill ph-paper-plane-tilt"></i>
                            <span>Submit for approval</span>
                        }
                    </button>
                    <button type="button" class="tfm-btn tfm-btn-wide tfm-btn-danger tfm-gap-sm"
                            @onclick="ClearForm" disabled="@isSubmitting">
                        <i class="ph ph-arrow-counter-clockwise"></i>Reset form
                    </button>
                </div>

                <div class="tfm-card tfm-panel">
                    <div class="tfm-panel-hd">
                        <i class="ph ph-shield-check"></i>
                        <span class="tfm-panel-t">Pre-flight checks</span>
                        <span class="tfm-spacer"></span>
                        <span class="tfm-note">@Checks.Count(c => c.Passed)/@Checks.Length</span>
                    </div>
                    <div class="tfm-checks">
                        @foreach (var check in Checks)
                        {
                            <div class="tfm-checks-i @(check.Passed ? "" : "is-no")">
                                <span class="tfm-checks-ic">
                                    <i class="ph @(check.Passed ? "ph-check" : "ph-minus")"></i>
                                </span>
                                <span>@check.Label</span>
                            </div>
                        }
                    </div>
                </div>

                <div class="tfm-info-note">
                    <i class="ph ph-info"></i>
                    <span>
                        This transfer is held for approval and cannot post to SAP until every required
                        stage has approved it. Stock does not move when you submit.
                    </span>
                </div>

                <div class="tfm-aside-foot">
                    Need approval before the stock moves?
                    <a href="/transfer-request/create">Create a transfer request</a>
                </div>
            </aside>
        </div>
    </div>
</div>

@code {
    // SAP rejects fractional quantities for every unit except KG, and the API enforces that in
    // ShopInventory.Common.Validation.UomQuantityValidation — against the line quantity and against
    // each FEFO-allocated batch — before the document is built. Mirrored here so the operator is
    // told at the field instead of by a failed round trip.
    private const string DecimalUnit = "KG";

    // ── State ───────────────────────────────────────────
    private bool isLoadingMasterData = true;
    private bool isLoadingStock;
    private bool isSubmitting;
    private bool showDocDetails;
    private string? errorMessage;
    private string? successMessage;

    // Stable idempotency key for this transfer entry; reused across retries so a lost-response
    // retry is deduplicated. The page navigates away on success, so each new transfer gets a fresh key.
    private readonly string clientRequestId = Guid.NewGuid().ToString("N");

    private List<WarehouseDto> cachedWarehouses = new();
    private List<ProductDto> cachedProducts = new();
    private HashSet<string> assignedWarehouseCodes = new(StringComparer.OrdinalIgnoreCase);

    private WarehouseDto? selectedFromWarehouse;
    private WarehouseDto? selectedToWarehouse;

    private DateTime? docDate = DateTime.Today;
    private DateTime? dueDate;
    private string? comments;
    private string? transferReason;

    private List<TransferLineItem> lines = new() { new TransferLineItem() };

    /// <summary>
    /// The source warehouse's stock, by item code. Held here rather than written onto the cached
    /// ProductDto objects: that cache is shared across every circuit, so merging one user's
    /// warehouse figures into it would show them to everyone else.
    /// </summary>
    private readonly Dictionary<string, ProductDto> stockBySource = new(StringComparer.OrdinalIgnoreCase);

    /// <summary>
    /// The per-line stock confirmations, coalesced into one call at a time. Each one becomes a SAP
    /// round trip holding one of six process-wide slots, so a form firing one per line could starve
    /// every other user of the app.
    /// </summary>
    private StockRefreshBatcher? stockRefresh;

    /// <summary>
    /// Validation is shown from the first submit attempt onwards, never before: the form opens
    /// empty, and a panel headed "please fix the following" on an untouched form is noise. After
    /// an attempt it tracks live, so entries disappear as they are fixed. The fractional-quantity
    /// message is the exception — it is shown as soon as the value is typed, because it is about
    /// one field the operator is looking at rather than about the form being incomplete.
    /// </summary>
    private bool hasAttemptedSubmit;

    private bool _hasLoadedData;

    private static readonly (int Number, string Label)[] Steps =
    [
        (1, "Warehouses"),
        (2, "Items"),
        (3, "Review")
    ];

    // ── Derived ─────────────────────────────────────────
    private IEnumerable<TransferLineItem> CompletedLines =>
        lines.Where(l => !string.IsNullOrWhiteSpace(l.ItemCode) && l.Quantity > 0);

    private int CompletedLineCount => CompletedLines.Count();

    private decimal TotalQuantity => CompletedLines.Sum(l => l.Quantity);

    private bool HasRoute => selectedFromWarehouse is not null
        && selectedToWarehouse is not null
        && !string.Equals(selectedFromWarehouse.WarehouseCode, selectedToWarehouse.WarehouseCode,
            StringComparison.OrdinalIgnoreCase);

    private bool HasReason => !string.IsNullOrWhiteSpace(transferReason);

    private bool HasCompletedLine => CompletedLineCount > 0;

    private bool LinesValid => lines.All(line => DescribeLineProblem(line) is null);

    private (string Label, bool Passed)[] Checks =>
    [
        ("Source and destination chosen", HasRoute),
        ("Reason for transfer given", HasReason),
        ("At least one item with a quantity", HasCompletedLine),
        ("Quantities valid for their units", LinesValid)
    ];

    private string? FromWarehouseError =>
        hasAttemptedSubmit && selectedFromWarehouse is null ? "Choose a source warehouse." : null;

    private string? ToWarehouseError
    {
        get
        {
            if (!hasAttemptedSubmit)
                return null;
            if (selectedToWarehouse is null)
                return "Choose a destination warehouse.";
            if (selectedFromWarehouse is not null && !HasRoute)
                return "Must be different from the source warehouse.";
            return null;
        }
    }

    private string? ReasonError =>
        hasAttemptedSubmit && !HasReason ? "Say why the stock is moving — approvers rely on this." : null;

    /// <summary>Everything standing between the form and a submit, in the order it appears.</summary>
    private List<string> ValidationSummary
    {
        get
        {
            var problems = new List<string>();

            if (selectedFromWarehouse is null)
                problems.Add("Choose a source warehouse.");
            if (selectedToWarehouse is null)
                problems.Add("Choose a destination warehouse.");
            if (selectedFromWarehouse is not null && selectedToWarehouse is not null && !HasRoute)
                problems.Add("Source and destination must be different warehouses.");
            if (!HasReason)
                problems.Add("Give a reason for the transfer.");
            if (!HasCompletedLine)
                problems.Add("Add at least one item with a quantity.");

            for (var i = 0; i < lines.Count; i++)
            {
                var problem = DescribeLineProblem(lines[i]);
                if (problem is not null)
                    problems.Add($"Line {i + 1}: {problem}");
            }

            return problems;
        }
    }

    // ── Steps ───────────────────────────────────────────
    private bool IsStepCompleted(int step) => step switch
    {
        1 => HasRoute && HasReason,
        2 => HasCompletedLine && LinesValid,
        3 => false,
        _ => false
    };

    private string StepClass(int step)
    {
        if (IsStepCompleted(step))
            return "is-done";

        // The first unfinished step is the one being worked on.
        for (var i = 1; i <= Steps.Length; i++)
        {
            if (!IsStepCompleted(i))
                return i == step ? "is-active" : string.Empty;
        }

        return string.Empty;
    }

    // ── Lifecycle ───────────────────────────────────────
    protected override void OnInitialized() =>
        stockRefresh = new StockRefreshBatcher(StockCacheService, Logger, ApplyStockBatchAsync);

    public void Dispose() => stockRefresh?.Dispose();

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && !_hasLoadedData)
        {
            _hasLoadedData = true;
            await LoadInitialDataAsync();
            StateHasChanged();
        }
    }

    private async Task LoadInitialDataAsync()
    {
        // Sequentially: both cache reads go through the same EF Core DbContext, which cannot
        // serve two queries at once.
        try
        {
            cachedWarehouses = await CacheService.GetWarehousesAsync();
            cachedProducts = await CacheService.GetProductsAsync();
            Logger.LogInformation("Loaded {Warehouses} warehouses and {Products} products",
                cachedWarehouses.Count, cachedProducts.Count);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to load master data for the inventory transfer form");
            errorMessage = "We couldn't load warehouses and products. Reload the page to try again.";
        }
        finally
        {
            isLoadingMasterData = false;
        }

        await PreselectAssignedWarehouseAsync();
    }

    /// <summary>
    /// A stock or depot controller works out of one warehouse, so the source is chosen for them
    /// from their `warehouse` claim.
    /// </summary>
    private async Task PreselectAssignedWarehouseAsync()
    {
        try
        {
            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            var user = authState.User;

            assignedWarehouseCodes = user.FindAll("warehouse")
                .Select(claim => claim.Value)
                .Where(code => !string.IsNullOrWhiteSpace(code))
                .ToHashSet(StringComparer.OrdinalIgnoreCase);

            var role = user.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value;
            var assignedWarehouse = assignedWarehouseCodes.FirstOrDefault();

            if (string.IsNullOrEmpty(assignedWarehouse)
                || (role != "StockController" && role != "DepotController"))
                return;

            selectedFromWarehouse = FindWarehouse(assignedWarehouse);
            if (selectedFromWarehouse is not null)
                await LoadStockForSourceAsync();
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Failed to preselect the assigned warehouse");
        }
    }

    // ── Warehouses ──────────────────────────────────────
    private async Task OnFromWarehouseChangedAsync(string? warehouseCode)
    {
        selectedFromWarehouse = FindWarehouse(warehouseCode);

        // A per-line confirmation still in flight is reading the warehouse the operator just left,
        // and holding a SAP slot to do it.
        stockRefresh?.Cancel();

        // Stock is a property of the source, so every figure on screen is stale the moment it
        // changes. The lines themselves are kept — the operator picked those items on purpose, and
        // the new figures are re-read below rather than making them start over.
        foreach (var line in lines)
        {
            line.StockInSource = 0;
            line.HasStockFigure = false;
            line.IsLoadingStock = false;
        }

        await LoadStockForSourceAsync();

        foreach (var line in lines.Where(l => l.SelectedProduct is not null))
        {
            ApplyStockFromCache(line);
        }
    }

    private void OnToWarehouseChanged(string? warehouseCode) =>
        selectedToWarehouse = FindWarehouse(warehouseCode);

    private WarehouseDto? FindWarehouse(string? warehouseCode) =>
        string.IsNullOrWhiteSpace(warehouseCode)
            ? null
            : cachedWarehouses.FirstOrDefault(w =>
                string.Equals(w.WarehouseCode, warehouseCode, StringComparison.OrdinalIgnoreCase));

    /// <summary>Pulls the source warehouse's stock into <see cref="stockBySource"/>.</summary>
    private async Task LoadStockForSourceAsync()
    {
        stockBySource.Clear();

        var warehouseCode = selectedFromWarehouse?.WarehouseCode;
        if (string.IsNullOrWhiteSpace(warehouseCode))
            return;

        try
        {
            isLoadingStock = true;
            StateHasChanged();

            var stockResponse = await StockCacheService.GetAllCachedStockAsync(warehouseCode);
            if (stockResponse?.Products is null)
                return;

            // Ignore a late response if the source moved on while it was in flight.
            if (!string.Equals(selectedFromWarehouse?.WarehouseCode, warehouseCode, StringComparison.OrdinalIgnoreCase))
                return;

            foreach (var product in stockResponse.Products.Where(p => !string.IsNullOrEmpty(p.ItemCode)))
            {
                stockBySource[product.ItemCode!] = product;
            }

            Logger.LogInformation("Loaded stock for {Count} items in warehouse {Warehouse}",
                stockBySource.Count, warehouseCode);
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Failed to load stock for warehouse {Warehouse}; the item list is still usable",
                warehouseCode);
        }
        finally
        {
            isLoadingStock = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    // ── Item picker ─────────────────────────────────────
    private void OnItemFocus(TransferLineItem line)
    {
        line.Matches = SearchProducts(line.ItemCode);
        line.ShowDropdown = true;
    }

    private void OnItemInput(TransferLineItem line, string? searchText)
    {
        line.ItemCode = searchText;
        line.Matches = SearchProducts(searchText);
        line.ShowDropdown = true;

        // Typing past a chosen item drops the selection: the code in the box is no longer the
        // product whose unit and stock are on the row.
        if (line.SelectedProduct is not null
            && !string.Equals(line.SelectedProduct.ItemCode, searchText, StringComparison.OrdinalIgnoreCase))
        {
            line.SelectedProduct = null;
            line.UoMCode = null;
            line.HasStockFigure = false;
            line.StockInSource = 0;
        }
    }

    private List<ProductDto> SearchProducts(string? searchText)
    {
        if (string.IsNullOrWhiteSpace(searchText))
            return cachedProducts.Take(20).ToList();

        return cachedProducts
            .Where(p =>
                (p.ItemCode?.Contains(searchText, StringComparison.OrdinalIgnoreCase) ?? false) ||
                (p.ItemName?.Contains(searchText, StringComparison.OrdinalIgnoreCase) ?? false))
            .Take(20)
            .ToList();
    }

    private void SelectProduct(TransferLineItem line, ProductDto product)
    {
        line.SelectedProduct = product;
        line.ItemCode = product.ItemCode;
        line.UoMCode = string.IsNullOrWhiteSpace(product.UoM) ? null : product.UoM.Trim();
        line.ShowDropdown = false;

        ApplyStockFromCache(line);

        // The warehouse-wide load is a cache read and can be stale for an item that just moved,
        // so confirm this one against the service.
        QueueStockRefresh(line);
    }

    // ── Stock ───────────────────────────────────────────
    private void ApplyStockFromCache(TransferLineItem line)
    {
        var itemCode = line.SelectedProduct?.ItemCode;
        if (string.IsNullOrWhiteSpace(itemCode) || !stockBySource.TryGetValue(itemCode, out var stock))
            return;

        line.StockInSource = stock.QuantityInStock;
        line.HasStockFigure = true;
        if (string.IsNullOrWhiteSpace(line.UoMCode) && !string.IsNullOrWhiteSpace(stock.UoM))
            line.UoMCode = stock.UoM.Trim();
    }

    /// <summary>
    /// Asks for the line's stock in the source warehouse. Queued rather than read here: the batcher
    /// folds every line's request into one call, so a form of any length holds one SAP slot.
    /// </summary>
    private void QueueStockRefresh(TransferLineItem line)
    {
        var warehouseCode = selectedFromWarehouse?.WarehouseCode;
        var itemCode = line.SelectedProduct?.ItemCode;
        if (string.IsNullOrWhiteSpace(warehouseCode) || string.IsNullOrWhiteSpace(itemCode))
            return;

        line.IsLoadingStock = true;
        stockRefresh?.Request(warehouseCode, itemCode);
    }

    /// <summary>
    /// Writes one batch's figures onto the lines waiting for them, taking the unit of measure from
    /// the same rows when the product cache has none — the API rejects a fractional quantity it
    /// cannot match to a unit, so this is the second chance to find one.
    /// </summary>
    /// <remarks>
    /// Runs off the circuit's synchronisation context, so every touch of component state goes
    /// through InvokeAsync. Lines are matched by the code they currently hold rather than by the
    /// product object queued: a line the operator has since typed past no longer has a selection and
    /// is skipped, and one they have pointed at a different item does not match this batch.
    /// </remarks>
    private Task ApplyStockBatchAsync(StockRefreshBatch batch) => InvokeAsync(() =>
    {
        // Drop a late batch if the source warehouse moved on while it was in flight.
        if (!string.Equals(selectedFromWarehouse?.WarehouseCode, batch.WarehouseCode, StringComparison.OrdinalIgnoreCase))
            return;

        foreach (var (itemCode, stock) in batch.Stock)
            stockBySource[itemCode] = stock;

        foreach (var line in lines)
        {
            var itemCode = line.SelectedProduct?.ItemCode;
            if (string.IsNullOrWhiteSpace(itemCode) || !batch.RequestedItemCodes.Contains(itemCode))
                continue;

            // Cleared for every code that was asked about, so a line for an item the warehouse
            // holds no row for stops spinning too.
            line.IsLoadingStock = false;

            if (!batch.Stock.TryGetValue(itemCode, out var stock))
                continue;

            line.StockInSource = stock.QuantityInStock;
            line.HasStockFigure = true;
            if (string.IsNullOrWhiteSpace(line.UoMCode) && !string.IsNullOrWhiteSpace(stock.UoM))
                line.UoMCode = stock.UoM.Trim();
        }

        StateHasChanged();
    });

    private bool ExceedsStock(TransferLineItem line) =>
        line.SelectedProduct is not null
        && selectedFromWarehouse is not null
        && line.HasStockFigure
        && line.Quantity > line.StockInSource;

    private string StockClass(TransferLineItem line)
    {
        if (line.SelectedProduct is null || selectedFromWarehouse is null || !line.HasStockFigure)
            return "is-idle";

        return ExceedsStock(line) ? "is-short" : string.Empty;
    }

    // ── Lines ───────────────────────────────────────────
    private void AddLine() => lines.Add(new TransferLineItem());

    private void RemoveLine(TransferLineItem line)
    {
        if (lines.Count <= 1)
            return;

        lines.Remove(line);
    }

    private void OnQuantityInput(TransferLineItem line, string? value)
    {
        line.QuantityText = value;
        line.Quantity = decimal.TryParse(value, out var quantity) ? quantity : 0m;
    }

    // ── Validation ──────────────────────────────────────
    private static bool AllowsDecimalQuantity(string? uomCode) =>
        string.Equals(uomCode?.Trim(), DecimalUnit, StringComparison.OrdinalIgnoreCase);

    private string QuantityStep(TransferLineItem line) =>
        AllowsDecimalQuantity(line.UoMCode) ? "0.001" : "1";

    /// <summary>
    /// Why a fractional quantity on this line would be rejected, or null. Split out from
    /// <see cref="DescribeLineProblem"/> because it is shown before the first submit attempt: it is
    /// about a value the operator just typed, not about the form being unfinished.
    /// </summary>
    private string? DescribeQuantityProblem(TransferLineItem line)
    {
        if (line.Quantity <= 0 || line.Quantity == decimal.Truncate(line.Quantity))
            return null;

        // The API resolves the unit from a Products table that nothing in the API populates, so a
        // fractional quantity sent without a unit is always rejected.
        if (string.IsNullOrWhiteSpace(line.UoMCode))
            return $"{line.Quantity} needs a unit of measure and this item has none cached — enter a whole number instead.";

        if (!AllowsDecimalQuantity(line.UoMCode))
            return $"{line.Quantity} isn't valid for {line.UoMCode} — only {DecimalUnit} items transfer in fractions.";

        return null;
    }

    /// <summary>
    /// What is wrong with a line, phrased for the operator, or null when it is fine. A line nobody
    /// has touched is fine — it is the spare row at the bottom of the table, not a mistake.
    /// </summary>
    private string? DescribeLineProblem(TransferLineItem line)
    {
        var hasItem = !string.IsNullOrWhiteSpace(line.ItemCode);

        if (!hasItem && line.Quantity <= 0)
            return null;

        if (!hasItem)
            return "choose an item, or clear the quantity.";

        if (line.SelectedProduct is null)
            return $"\"{line.ItemCode}\" isn't a known item — pick one from the list.";

        if (line.Quantity <= 0)
            return "enter a quantity greater than zero.";

        return DescribeQuantityProblem(line);
    }

    private static string Truncate(string? value, int maxLength)
    {
        if (string.IsNullOrEmpty(value))
            return string.Empty;

        return value.Length <= maxLength ? value : value[..maxLength] + "…";
    }

    private async Task ScrollToTopAsync()
    {
        try { await JS.InvokeVoidAsync("window.scrollTo", 0, 0); } catch { }
    }

    // ── Submit ──────────────────────────────────────────
    private async Task SubmitTransfer()
    {
        errorMessage = null;
        successMessage = null;
        hasAttemptedSubmit = true;

        var problems = ValidationSummary;
        if (problems.Any())
        {
            errorMessage = problems.Count == 1
                ? problems[0]
                : $"{problems.Count} things need fixing before this transfer can be submitted.";
            return;
        }

        isSubmitting = true;

        try
        {
            var request = new CreateInventoryTransferDto
            {
                FromWarehouse = selectedFromWarehouse!.WarehouseCode,
                ToWarehouse = selectedToWarehouse!.WarehouseCode,
                DocDate = (docDate ?? DateTime.Today).ToString("yyyy-MM-dd"),
                DueDate = dueDate?.ToString("yyyy-MM-dd"),
                Comments = BuildComments(),
                ClientRequestId = clientRequestId,

                Lines = CompletedLines
                    .Select(l => new CreateInventoryTransferLineDto
                    {
                        ItemCode = l.ItemCode,
                        Quantity = l.Quantity,
                        // Without this the API falls back to its own Products table, which is never
                        // populated, and rejects every fractional quantity it sees — the line's own
                        // and every batch it allocates.
                        UoMCode = l.UoMCode,
                        FromWarehouseCode = selectedFromWarehouse!.WarehouseCode,
                        ToWarehouseCode = selectedToWarehouse!.WarehouseCode
                    })
                    .ToList()
            };

            Logger.LogInformation("Submitting inventory transfer: From={From}, To={To}, Lines={Lines}",
                request.FromWarehouse, request.ToWarehouse, request.Lines.Count);

            var (success, message, transfer, pendingTransfer) = await TransferService.CreateInventoryTransferAsync(request);

            if (success)
            {
                if (pendingTransfer is not null)
                {
                    var pendingStage = pendingTransfer.ApprovalStages.FirstOrDefault(stage => stage.Status == "Pending");
                    successMessage = pendingStage is null
                        ? "Transfer submitted for approval. It will post to SAP once approved. Redirecting…"
                        : $"Transfer submitted for approval — waiting on {pendingStage.StageName}. Redirecting…";
                    Logger.LogInformation("Inventory transfer submitted for approval: PendingId={PendingId}", pendingTransfer.Id);
                }
                else
                {
                    successMessage = $"Transfer #{transfer?.DocNum} created successfully! Redirecting…";
                    Logger.LogInformation("Inventory transfer created: DocNum={DocNum}, DocEntry={DocEntry}",
                        transfer?.DocNum, transfer?.DocEntry);
                }

                await AuditService.LogAsync(AuditActions.CreateTransfer, "InventoryTransfer",
                    transfer?.DocNum.ToString() ?? pendingTransfer?.Id.ToString());

                StateHasChanged();
                await Task.Delay(1500);
                NavigationManager.NavigateTo("/inventory-transfers");
            }
            else
            {
                errorMessage = string.IsNullOrWhiteSpace(message)
                    ? "We couldn't submit this transfer. Please try again."
                    : message;
                Logger.LogWarning("Failed to create inventory transfer: {Message}", message);
                await AuditService.LogAsync(AuditActions.CreateTransfer, "InventoryTransfer", null, null, false, message);
                StateHasChanged();
                await ScrollToTopAsync();
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error submitting inventory transfer");
            errorMessage = $"An unexpected error occurred: {ex.Message}";
            StateHasChanged();
            await ScrollToTopAsync();
        }
        finally
        {
            isSubmitting = false;
        }
    }

    private string BuildComments()
    {
        var parts = new List<string>();
        if (!string.IsNullOrWhiteSpace(transferReason))
            parts.Add($"Reason: {transferReason.Trim()}");
        if (!string.IsNullOrWhiteSpace(comments))
            parts.Add(comments.Trim());
        return string.Join(" | ", parts);
    }

    private void ClearForm()
    {
        stockRefresh?.Cancel();
        selectedFromWarehouse = null;
        selectedToWarehouse = null;
        docDate = DateTime.Today;
        dueDate = null;
        comments = null;
        transferReason = null;
        hasAttemptedSubmit = false;
        showDocDetails = false;
        errorMessage = null;
        successMessage = null;
        stockBySource.Clear();
        lines = new List<TransferLineItem> { new TransferLineItem() };
    }

    private class TransferLineItem
    {
        public Guid Id { get; } = Guid.NewGuid();
        public ProductDto? SelectedProduct { get; set; }
        public string? ItemCode { get; set; }
        public decimal Quantity { get; set; }

        /// <summary>
        /// What is in the box, kept apart from <see cref="Quantity"/> so a half-typed "0." or a
        /// cleared field is not rewritten under the cursor on the next render.
        /// </summary>
        public string? QuantityText { get; set; }

        public string? UoMCode { get; set; }
        public decimal StockInSource { get; set; }
        public bool HasStockFigure { get; set; }
        public bool IsLoadingStock { get; set; }

        public bool ShowDropdown { get; set; }
        public List<ProductDto> Matches { get; set; } = new();
    }
}
