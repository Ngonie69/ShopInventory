@page "/reports/order-fulfillment"
@using System.Globalization
@attribute [Authorize(Roles = UserRoles.OrderFulfillmentReportRoles)]
@inject IReportService ReportService
@inject IReportExportService ExportService
@inject IMasterDataCacheService CacheService
@inject AuthenticationStateProvider AuthStateProvider
@inject ILogger<OrderFulfillment> Logger
@inject IJSRuntime JS
@rendermode InteractiveServer

@{
    var filteredOrders = GetFilteredOrders().ToList();
    var displayedOrders = filteredOrders.Take(MaxDisplayedOrders).ToList();
    var filteredTotals = CalculateLineTotals(GetFilteredLines().ToList());
    // Narrowed once per render rather than once per read: the group runs over the whole partner
    // cache, and the picker needs the list it is offering as well as the size of it.
    var availablePartners = AvailablePartners;
}

<PageTitle>Sales Order vs Invoice - Shop Inventory</PageTitle>

@* Nocturne, carried by wwwroot/css/order-fulfillment.css (linked from App.razor)
   in both schemes, following the app's theme toggle like every other page. The
   palette and density scale are sales-orders.css's, unchanged, so the report
   reads as part of the same system as the list pages it is read alongside.

   The disclosure twist draws its glyph inline rather than from the Phosphor
   font: it is the control's whole label, so a font that fails to load would
   leave every order looking like a dead row.

   The partner scope is two controls rather than one, the pair SAP's own report
   selection asks for: a group, and the partners inside it — named one by one or
   as a Code from / to range. Neither reaches the statement SAP runs. The four
   report statements are constant text with the date range bound, so one query
   object serves every range; a partner set is a different length every time it
   is asked for, and pushing it into the text would leave a permanent OUQR row
   behind per distinct selection. So the window is read once and narrowed here,
   figures and all — see Components/OrderFulfillmentScope.cs.

   A sales rep is the exception and stays scoped at the API: they cannot read
   across customers, so their one partner binds as :cardCode and SAP never
   returns anybody else's orders to this circuit in the first place. *@

<div class="ofx">

    <header class="ofx-head">
        <div class="ofx-shell">
            <div class="ofx-titles">
                <span class="ofx-kicker">Sales operations</span>
                <div class="ofx-titles-row">
                    <i class="ph ph-scales" aria-hidden="true"></i>
                    <h1 class="ofx-title">Sales order vs invoice</h1>
                </div>
                <p class="ofx-sub">@Standfirst</p>
            </div>
            <div class="ofx-head-actions">
                @if (scoped is not null)
                {
                    <span class="ofx-count">
                        @if (ScopeLabel is { } who)
                        {
                            <span class="ofx-count-who">@who</span>
                            <span aria-hidden="true"> &middot; </span>
                        }
                        @scoped.TotalOrders.ToString("N0") orders
                    </span>
                }
                <button type="button" class="ofx-btn ofx-btn-secondary" @onclick="ExportToExcelAsync"
                        disabled="@(isLoading || isExporting || scoped is null)">
                    <i class="ph ph-file-xls" aria-hidden="true"></i>@(isExporting ? "Exporting…" : "Export Excel")
                </button>
            </div>
        </div>
        <div class="ofx-rule"></div>
    </header>

    <div class="ofx-body">

        @if (!string.IsNullOrWhiteSpace(errorMessage))
        {
            <div class="ofx-alert" role="alert">
                <i class="ph ph-warning-octagon" aria-hidden="true"></i>
                <div class="ofx-alert-body">@errorMessage</div>
            </div>
        }

        <section class="ofx-filters">
            @* The group is a criterion in its own right, not only a way of finding one partner:
               chosen alone it means the whole group, which is the reading SAP's selection has. *@
            <div class="ofx-field ofx-field-group">
                <label for="ofx-f-group">Partner group</label>
                <NocturneSelect TValue="string" Id="ofx-f-group" Class="nsel-block" Options="groupSelectOptions"
                                Value="selectedGroup" ValueChanged="@(code => OnGroupChanged(code))"
                                Disabled="@(isLoading || isLoadingCustomers)"
                                Caption="Narrow to one SAP business partner group"
                                AriaLabel="Business partner group" />
            </div>
            @* Not a <label>: the picker carries a menu with its own search and range inputs, and a
               label would forward stray clicks on any of them back to the control. *@
            <div class="ofx-field ofx-field-partners">
                <span class="ofx-field-label">
                    @(requiresCustomer ? "Customer" : "Business partners")
                    @if (requiresCustomer)
                    {
                        <span class="ofx-req" aria-hidden="true">*</span>
                    }
                    else
                    {
                        <span class="ofx-field-hint">optional</span>
                    }
                </span>
                <OrderFulfillmentPartnerPicker Options="availablePartners"
                                               Selected="selectedPartners"
                                               SelectedChanged="OnPartnersChanged"
                                               SingleSelect="requiresCustomer"
                                               HasGroup="@(selectedGroup.Length > 0)"
                                               Placeholder="@PartnerPlaceholder"
                                               EmptyText="@(isLoadingCustomers ? "Loading customers…" : "No customers cached")"
                                               AriaLabel="@(requiresCustomer ? "Customer" : "Business partners")"
                                               Invalid="customerError"
                                               Disabled="@(isLoading || isLoadingCustomers)" />
            </div>
            @* The labels stay siblings rather than wrappers: NocturneDateField carries a calendar
               button and a popup, and a label around them would swallow their clicks. The Id lands
               on the field's text input, so `for` still focuses it. *@
            <div class="ofx-field" style="width:150px">
                <label for="ofx-f-from">From</label>
                <NocturneDateField Id="ofx-f-from" @bind-Date="fromDate" @bind-Date:after="OnDateRangeChanged"
                                   AriaLabel="From date" Disabled="isLoading" />
            </div>
            <div class="ofx-field" style="width:150px">
                <label for="ofx-f-to">To</label>
                <NocturneDateField Id="ofx-f-to" @bind-Date="toDate" @bind-Date:after="OnDateRangeChanged"
                                   AriaLabel="To date" Disabled="isLoading" />
            </div>
            <div class="ofx-field" style="width:170px">
                <label for="ofx-f-range">Quick range</label>
                <NocturneSelect TValue="int" Id="ofx-f-range" Class="nsel-block" Options="QuickRangeOptions"
                                Value="quickRangeDays" ValueChanged="@(days => OnQuickRangeChanged(days))"
                                Disabled="isLoading" Caption="Quick range" AriaLabel="Quick range" />
            </div>
            <div class="ofx-field" style="width:260px">
                <label for="ofx-f-search">Search</label>
                <input id="ofx-f-search" class="ofx-input" type="search" placeholder="Order, customer, item, warehouse"
                       @bind="searchText" @bind:event="oninput" disabled="@isLoading" />
            </div>
            <div class="ofx-field" style="width:150px">
                <label for="ofx-f-status">Line status</label>
                <NocturneSelect Id="ofx-f-status" Class="nsel-block" TValue="string"
                                Options="LineStatusFilterOptions" @bind-Value="lineStatusFilter"
                                Disabled="isLoading" Caption="Filter by line status"
                                AriaLabel="Filter by line status" />
            </div>
            <div class="ofx-filter-actions">
                <button type="button" class="ofx-btn ofx-btn-ghost" @onclick="ResetFiltersAsync" disabled="@isLoading">
                    Reset
                </button>
                <button type="button" class="ofx-btn ofx-btn-primary" @onclick="LoadReportAsync"
                        disabled="@(isLoading || !CanLoad)">
                    <i class="ph ph-arrow-clockwise" aria-hidden="true"></i>@(isLoading ? "Loading…" : PrimaryActionLabel)
                </button>
            </div>
        </section>

        @if (isLoading)
        {
            <section class="ofx-card">
                <div class="ofx-empty">
                    <div class="ofx-spinner" aria-hidden="true"></div>
                    <strong>Loading sales order vs invoice</strong>
                    <span class="ofx-empty-sub">Reading sales order and invoice quantities from SAP. A wide date range can take a minute.</span>
                </div>
            </section>
        }
        else if (!hasLoaded)
        {
            <section class="ofx-card">
                <div class="ofx-empty">
                    @if (requiresCustomer && selectedPartners.Count == 0)
                    {
                        <i class="ph ph-user-focus" aria-hidden="true"></i>
                        <strong>Choose a customer</strong>
                        <span class="ofx-empty-sub">Search for the customer you are reporting on, pick a date range, and load the report.</span>
                    }
                    else
                    {
                        <i class="ph ph-calendar-blank" aria-hidden="true"></i>
                        <strong>Ready to load</strong>
                        <span class="ofx-empty-sub">Choose a date range and load the report.</span>
                    }
                </div>
            </section>
        }
        else if (scoped is null || scoped.TotalOrders == 0)
        {
            <section class="ofx-card">
                <div class="ofx-empty">
                    <i class="ph ph-tray" aria-hidden="true"></i>
                    <strong>@(ScopeLabel is { } who ? $"No orders for {who} in this period" : "No orders in this period")</strong>
                    <span class="ofx-empty-sub">
                        @(ScopeLabel is null
                            ? "Try a wider date range or clear the filters."
                            : "Try a wider date range, another group, or clear the partner selection.")
                    </span>
                </div>
            </section>
        }
        else
        {
            <section class="ofx-figures" aria-label="Report totals">
                <div class="ofx-figure">
                    <span class="ofx-figure-mark" aria-hidden="true"><i class="ph ph-receipt"></i></span>
                    <div class="ofx-figure-text">
                        <div class="ofx-figure-value">@scoped.TotalOrders.ToString("N0")</div>
                        <div class="ofx-figure-label">Total orders</div>
                        <div class="ofx-figure-note">@scoped.OpenOrders.ToString("N0") open, @scoped.ClosedOrders.ToString("N0") closed</div>
                    </div>
                </div>
                <div class="ofx-figure">
                    <span class="ofx-figure-mark" aria-hidden="true"><i class="ph ph-check-circle"></i></span>
                    <div class="ofx-figure-text">
                        <div class="ofx-figure-value">@scoped.FulfillmentRatePercent.ToString("N1")%</div>
                        <div class="ofx-figure-label">Invoice rate</div>
                        <div class="ofx-figure-note">@scoped.FullyDeliveredLines.ToString("N0") invoiced lines</div>
                    </div>
                </div>
                <div class="ofx-figure">
                    <span class="ofx-figure-mark is-quiet" aria-hidden="true"><i class="ph ph-stack"></i></span>
                    <div class="ofx-figure-text">
                        <div class="ofx-figure-value">@scoped.Orders.Sum(order => order.TotalQuantityOrdered).ToString("N2")</div>
                        <div class="ofx-figure-label">Quantity ordered</div>
                        <div class="ofx-figure-note">@scoped.Orders.Sum(order => order.TotalQuantityDelivered).ToString("N2") invoiced</div>
                    </div>
                </div>
                <div class="ofx-figure">
                    <span class="ofx-figure-mark is-warn" aria-hidden="true"><i class="ph ph-hourglass-medium"></i></span>
                    <div class="ofx-figure-text">
                        <div class="ofx-figure-value is-warn">@scoped.Orders.Sum(order => order.TotalQuantityPending).ToString("N2")</div>
                        <div class="ofx-figure-label">Quantity pending</div>
                        <div class="ofx-figure-note">@scoped.UndeliveredLines.ToString("N0") pending lines</div>
                    </div>
                </div>
                <div class="ofx-figure">
                    <span class="ofx-figure-mark is-quiet" aria-hidden="true"><i class="ph ph-currency-circle-dollar"></i></span>
                    <div class="ofx-figure-text">
                        <div class="ofx-figure-value is-money">@FormatMoneyPair(scoped.TotalOrderValueUSD, scoped.TotalOrderValueZIG)</div>
                        <div class="ofx-figure-label">Total order value</div>
                        <div class="ofx-figure-note">Invoiced @FormatMoneyPair(scoped.TotalDeliveredValueUSD, scoped.TotalDeliveredValueZIG)</div>
                    </div>
                </div>
                <div class="ofx-figure">
                    <span class="ofx-figure-mark is-warn" aria-hidden="true"><i class="ph ph-clock-countdown"></i></span>
                    <div class="ofx-figure-text">
                        <div class="ofx-figure-value is-money is-warn">@FormatMoneyPair(scoped.TotalPendingValueUSD, scoped.TotalPendingValueZIG)</div>
                        <div class="ofx-figure-label">Pending value</div>
                        <div class="ofx-figure-note">Based on pending line quantities</div>
                    </div>
                </div>
            </section>

            <section class="ofx-card">
                <div class="ofx-toolbar">
                    <div class="ofx-toolbar-titles">
                        <h2 class="ofx-toolbar-title">Orders &amp; item lines</h2>
                        <p class="ofx-toolbar-sub">@filteredOrders.Count.ToString("N0") matching orders. Open one for its item lines, unit prices and pending values.</p>
                    </div>
                    @if (filteredOrders.Any())
                    {
                        <div class="ofx-toolbar-actions">
                            <button type="button" class="ofx-btn ofx-btn-secondary ofx-btn-sm" @onclick="ExpandAll">Expand all</button>
                            <button type="button" class="ofx-btn ofx-btn-secondary ofx-btn-sm" @onclick="CollapseAll">Collapse all</button>
                        </div>
                    }
                </div>

                @if (filteredOrders.Any())
                {
                    <div class="ofx-totals">
                        <div class="ofx-total">
                            <span class="ofx-total-label">Ordered</span>
                            <span class="ofx-total-value">@filteredTotals.Ordered.ToString("N2")</span>
                        </div>
                        <div class="ofx-total">
                            <span class="ofx-total-label">Invoiced</span>
                            <span class="ofx-total-value">@filteredTotals.Delivered.ToString("N2")</span>
                        </div>
                        <div class="ofx-total">
                            <span class="ofx-total-label">Pending</span>
                            <span class="ofx-total-value is-warn">@filteredTotals.Pending.ToString("N2")</span>
                        </div>
                        <div class="ofx-total">
                            <span class="ofx-total-label">Value</span>
                            <span class="ofx-total-value">@FormatMoneyPair(filteredTotals.ValueUsd, filteredTotals.ValueZig)</span>
                        </div>
                        <div class="ofx-total">
                            <span class="ofx-total-label">Pending value</span>
                            <span class="ofx-total-value is-warn">@FormatMoneyPair(filteredTotals.PendingUsd, filteredTotals.PendingZig)</span>
                        </div>
                    </div>
                }

                @if (!filteredOrders.Any())
                {
                    <div class="ofx-empty">
                        <i class="ph ph-magnifying-glass" aria-hidden="true"></i>
                        <strong>No matching orders</strong>
                        <span class="ofx-empty-sub">Clear the search or choose a different line status.</span>
                    </div>
                }
                else
                {
                    <div class="ofx-groups">
                        @foreach (var order in displayedOrders)
                        {
                            var lines = GetVisibleLines(order).ToList();
                            var isOpen = IsExpanded(order.DocEntry);
                            <div class="ofx-group @(isOpen ? "is-open" : null)" @key="order.DocEntry">
                                <button type="button" class="ofx-grouphead" @onclick="() => ToggleOrder(order.DocEntry)"
                                        aria-expanded="@(isOpen ? "true" : "false")">
                                    <span class="ofx-twist" aria-hidden="true">
                                        <svg viewBox="0 0 24 24"><path d="M9 5l7 7-7 7"></path></svg>
                                    </span>
                                    <span class="ofx-group-id">
                                        <span class="ofx-group-doc">SO @order.DocNum</span>
                                        <span class="ofx-group-date @(order.OrderDate == default ? "is-unset" : null)">@FormatDate(order.OrderDate)</span>
                                    </span>
                                    <span class="ofx-group-cust">
                                        <span class="ofx-group-name">@order.CardName</span>
                                        <span class="ofx-group-code">@order.CardCode</span>
                                    </span>
                                    <span class="ofx-status">
                                        <span class="ofx-dot @GetOrderDotClass(order.Status)"></span>
                                        <span class="ofx-status-text">@order.Status</span>
                                    </span>
                                    <span class="ofx-group-figs">
                                        <span class="ofx-kv">
                                            <span class="ofx-kv-label">Order value</span>
                                            <span class="ofx-kv-value">@FormatMoney(order.OrderTotal, order.DocCurrency)</span>
                                        </span>
                                        <span class="ofx-kv">
                                            <span class="ofx-kv-label">Ordered</span>
                                            <span class="ofx-kv-value">@order.TotalQuantityOrdered.ToString("N2")</span>
                                        </span>
                                        <span class="ofx-kv">
                                            <span class="ofx-kv-label">Invoiced</span>
                                            <span class="ofx-kv-value">@order.TotalQuantityDelivered.ToString("N2")</span>
                                        </span>
                                        <span class="ofx-kv">
                                            <span class="ofx-kv-label">Pending</span>
                                            <span class="ofx-kv-value @(order.TotalQuantityPending > 0 ? "is-pending" : null)">@order.TotalQuantityPending.ToString("N2")</span>
                                        </span>
                                        <span class="ofx-kv">
                                            <span class="ofx-kv-label">Invoiced @order.FulfillmentPercent.ToString("N0")%</span>
                                            <span class="ofx-prog"><span style="@GetProgressStyle(order.FulfillmentPercent)"></span></span>
                                        </span>
                                        @if (order.IsOverdue)
                                        {
                                            <span class="ofx-kv">
                                                <span class="ofx-kv-label">Due</span>
                                                <span class="ofx-kv-value is-bad">@order.DaysOverdue.ToString("N0")d overdue</span>
                                            </span>
                                        }
                                    </span>
                                </button>

                                @if (isOpen)
                                {
                                    <div class="ofx-group-body">
                                        <div class="ofx-tablewrap">
                                            <table class="ofx-table">
                                                <thead>
                                                    <tr>
                                                        <th>Item</th>
                                                        <th>Warehouse</th>
                                                        <th>Status</th>
                                                        <th>Invoice(s)</th>
                                                        <th class="ofx-num">Unit price</th>
                                                        <th class="ofx-num">Qty ordered</th>
                                                        <th class="ofx-num">Qty invoiced</th>
                                                        <th class="ofx-num">Qty pending</th>
                                                        <th class="ofx-num">Invoiced %</th>
                                                        <th class="ofx-num">Ordered value</th>
                                                        <th class="ofx-num">Invoiced value</th>
                                                        <th class="ofx-num">Pending value</th>
                                                    </tr>
                                                </thead>
                                                <tbody>
                                                    @foreach (var line in lines)
                                                    {
                                                        <tr>
                                                            <td>
                                                                <span class="ofx-item">
                                                                    <span class="ofx-item-name">@line.ItemDescription</span>
                                                                    <span class="ofx-item-code">@line.ItemCode</span>
                                                                </span>
                                                            </td>
                                                            <td class="ofx-whs">@line.WarehouseCode</td>
                                                            <td>
                                                                <span class="ofx-status">
                                                                    <span class="ofx-dot @GetLineDotClass(line.LineStatus)"></span>
                                                                    <span class="ofx-status-text">@line.LineStatus</span>
                                                                </span>
                                                            </td>
                                                            <td>
                                                                @if (!string.IsNullOrWhiteSpace(line.InvoiceNumbers))
                                                                {
                                                                    <span class="ofx-invoices">@line.InvoiceNumbers</span>
                                                                }
                                                                else
                                                                {
                                                                    <span class="ofx-none">&mdash;</span>
                                                                }
                                                            </td>
                                                            <td class="ofx-num ofx-money">@FormatMoney(line.UnitPrice, order.DocCurrency)</td>
                                                            <td class="ofx-num">@line.QuantityOrdered.ToString("N2")</td>
                                                            <td class="ofx-num">@line.QuantityDelivered.ToString("N2")</td>
                                                            <td class="ofx-num ofx-pending @(line.QuantityPending > 0 ? null : "is-zero")">@line.QuantityPending.ToString("N2")</td>
                                                            <td class="ofx-num">@LineFulfilmentPercent(line).ToString("N1")%</td>
                                                            <td class="ofx-num ofx-money is-strong">@FormatMoney(line.LineTotal, order.DocCurrency)</td>
                                                            <td class="ofx-num ofx-money is-strong">@FormatMoney(line.InvoicedValue, order.DocCurrency)</td>
                                                            <td class="ofx-num ofx-money is-strong">@FormatMoney(CalculatePendingLineValue(line), order.DocCurrency)</td>
                                                        </tr>
                                                    }
                                                </tbody>
                                            </table>
                                        </div>
                                    </div>
                                }
                            </div>
                        }
                    </div>
                }
            </section>

            @if (filteredOrders.Count > displayedOrders.Count)
            {
                <div class="ofx-alert is-info">
                    <i class="ph ph-info" aria-hidden="true"></i>
                    <div class="ofx-alert-body">
                        Showing the first @displayedOrders.Count.ToString("N0") of @filteredOrders.Count.ToString("N0") orders.
                        Refine the search or date range to narrow the result.
                    </div>
                </div>
            }
        }
    </div>
</div>

@code {
    private const int MaxDisplayedOrders = 200;

    private readonly HashSet<int> expandedOrders = new();

    private DateTime? fromDate;
    private DateTime? toDate;
    private int quickRangeDays;
    private string searchText = string.Empty;
    private string lineStatusFilter = "All";
    private string? errorMessage;
    private bool isLoading;
    private bool isExporting;
    private bool hasLoaded;

    /// <summary>The report as the API sent it. Nothing on the page reads this directly.</summary>
    private OrderFulfillmentReport? report;

    /// <summary>
    /// The same report narrowed to the chosen partners, which is what the page renders and what the
    /// export writes. Held rather than recomputed per render: narrowing rebuilds every total over
    /// every line, which is work per selection, not work per frame.
    /// </summary>
    private OrderFulfillmentReport? scoped;

    /// <summary>
    /// The partner <see cref="report"/> was scoped to at the API, or null when it was read for
    /// every customer. A selection the load does not cover cannot be narrowed to — it has to be
    /// read again.
    /// </summary>
    private string? loadedCardCode;

    private List<OrderFulfillmentPartnerPicker.Option> partnerOptions = new();
    private List<NocturneSelectOption<string>> groupSelectOptions = new();
    private string selectedGroup = string.Empty;
    private IReadOnlyList<string> selectedPartners = Array.Empty<string>();
    private bool isLoadingCustomers = true;
    private bool customerError;

    /// <summary>
    /// True for a sales rep: their report is always one business partner's. The insights roles
    /// leave it unset to report across every customer, which is what this page has always done.
    /// </summary>
    private bool requiresCustomer;

    private bool HasSelectedRange => fromDate.HasValue && toDate.HasValue;

    private bool CanLoad => HasSelectedRange && (!requiresCustomer || selectedPartners.Count == 1);

    private string PrimaryActionLabel => hasLoaded ? "Refresh report" : "Load report";

    private string PartnerPlaceholder => requiresCustomer ? "Choose a customer" : "All customers";

    /// <summary>What the picker offers: every cached partner, or only the chosen group's.</summary>
    private List<OrderFulfillmentPartnerPicker.Option> AvailablePartners =>
        selectedGroup.Length == 0
            ? partnerOptions
            : partnerOptions
                .Where(partner => string.Equals(partner.Group, selectedGroup, StringComparison.OrdinalIgnoreCase))
                .ToList();

    /// <summary>The partners the report is for, or null for every one of them.</summary>
    private IReadOnlyCollection<string>? ScopeCardCodes =>
        OrderFulfillmentScope.Resolve(partnerOptions, selectedGroup, selectedPartners);

    /// <summary>
    /// Names the selection beside the order count and in the empty state, or null where the report
    /// covers every customer and there is nothing to name.
    /// </summary>
    private string? ScopeLabel
    {
        get
        {
            if (selectedPartners.Count == 1)
            {
                var one = partnerOptions.FirstOrDefault(partner =>
                    string.Equals(partner.Value, selectedPartners[0], StringComparison.OrdinalIgnoreCase));

                return one?.Name ?? selectedPartners[0];
            }

            if (selectedPartners.Count > 1)
            {
                return $"{selectedPartners.Count:N0} partners";
            }

            return selectedGroup.Length == 0 ? null : GroupName(selectedGroup);
        }
    }

    private string GroupName(string code) =>
        groupSelectOptions.FirstOrDefault(option => option.Value == code)?.Label ?? $"Group {code}";

    private string Standfirst => requiresCustomer
        ? "Ordered, invoiced and pending quantities for one customer's orders over the selected period."
        : "Ordered, invoiced and pending quantities with line values for the selected period.";

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        requiresCustomer = !UserRoles.CanReadReportsAcrossCustomers(authState.User);

        try
        {
            var customers = await CacheService.GetBusinessPartnersAsync();

            partnerOptions = customers
                .Where(partner => !string.IsNullOrWhiteSpace(partner.CardCode))
                .Select(partner => new OrderFulfillmentPartnerPicker.Option(
                    partner.CardCode!,
                    string.IsNullOrWhiteSpace(partner.CardName) ? partner.CardCode! : partner.CardName!,
                    partner.Currency,
                    SalesAnalysisGroups.Normalise(partner.GroupCode)))
                .OrderBy(option => option.Value, StringComparer.OrdinalIgnoreCase)
                .ToList();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error loading customers for the sales order vs invoice report");
            errorMessage = "Could not load the customer list. Reload the page to try again.";
        }
        finally
        {
            isLoadingCustomers = false;
        }

        await LoadGroupOptionsAsync();
    }

    /// <summary>
    /// Fills the Partner group dropdown, dropping any group no cached partner belongs to.
    /// </summary>
    /// <remarks>
    /// A group with no member here would be a criterion that can only ever empty the report, and
    /// SAP has plenty of them — groups kept for purchasing, or for partner types this report never
    /// sees. The rule is <see cref="SalesAnalysisGroups"/>'s, shared with /reports/item-volume.
    /// A missing lookup costs the dropdown and nothing else: the picker still lists every partner.
    /// </remarks>
    private async Task LoadGroupOptionsAsync()
    {
        var options = new List<NocturneSelectOption<string>> { NocturneSelectOption.All("All groups") };

        try
        {
            var groups = await CacheService.GetBusinessPartnerGroupsAsync();

            options.AddRange(SalesAnalysisGroups
                .BuildOptions(
                    partnerOptions.Select(option => option.Group),
                    groups.Select(group => (
                        Code: group.Code.ToString(CultureInfo.InvariantCulture),
                        Name: group.Name)))
                .Select(group => new NocturneSelectOption<string>(group.Value, group.Label)));
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to load the business partner groups for the sales order vs invoice report");
        }

        groupSelectOptions = options;
    }

    private void OnGroupChanged(string? code)
    {
        selectedGroup = code ?? string.Empty;
        OnScopeChanged();
    }

    private void OnPartnersChanged(IReadOnlyList<string> next)
    {
        selectedPartners = next;
        customerError = false;
        OnScopeChanged();
    }

    /// <summary>
    /// Re-narrows the loaded report to the new selection, or throws it away when the load cannot
    /// cover it.
    /// </summary>
    /// <remarks>
    /// A report read for every customer covers any selection, so the usual case is a re-narrowing
    /// with no SAP read at all — which is the point of narrowing here rather than in the statement.
    /// One read for a single partner covers only that partner, and showing it under a wider
    /// selection would report that partner's orders as everybody's.
    /// </remarks>
    private void OnScopeChanged()
    {
        var stillCovered = loadedCardCode is null
            || (selectedPartners.Count == 1
                && string.Equals(selectedPartners[0], loadedCardCode, StringComparison.OrdinalIgnoreCase));

        if (report is not null && !stillCovered)
        {
            ClearLoadedReport();
            return;
        }

        ApplyScope();
    }

    private void ApplyScope()
    {
        scoped = report is null ? null : OrderFulfillmentScope.Narrow(report, ScopeCardCodes);
        expandedOrders.Clear();
    }

    private async Task LoadReportAsync()
    {
        if (requiresCustomer && selectedPartners.Count != 1)
        {
            customerError = true;
            errorMessage = "Choose the customer to report on.";
            return;
        }

        if (!fromDate.HasValue || !toDate.HasValue)
        {
            errorMessage = "Select both From and To dates.";
            return;
        }

        if (fromDate.Value.Date > toDate.Value.Date)
        {
            errorMessage = "From date cannot be after To date.";
            return;
        }

        isLoading = true;
        errorMessage = null;
        customerError = false;
        report = null;
        scoped = null;
        hasLoaded = false;
        expandedOrders.Clear();

        // One partner is asked of SAP directly — the statement takes a bound :cardCode and reads
        // nobody else's orders. That is what keeps a rep's report both fast and inside what they
        // are allowed to see. Anything wider is read for the window and narrowed on the page.
        var scopeCodes = ScopeCardCodes;
        var cardCode = scopeCodes is { Count: 1 } ? scopeCodes.First() : null;

        try
        {
            report = await ReportService.GetOrderFulfillmentAsync(
                fromDate.Value.Date, toDate.Value.Date, cardCode);
            loadedCardCode = cardCode;
            ApplyScope();
            hasLoaded = true;
        }
        catch (Exception ex)
        {
            errorMessage = $"Failed to load sales order vs invoice: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }

    private static readonly NocturneSelectOption<int>[] QuickRangeOptions =
    [
        new(0, "Select range", "neutral") { IsUnset = true, RuleAfter = true },
        new(7, "Last 7 days"),
        new(30, "Last 30 days"),
        new(90, "Last 90 days"),
        new(180, "Last 6 months"),
        new(365, "Last year")
    ];

    // "All" rather than an empty string is this page's no-filter sentinel.
    private static readonly NocturneSelectOption<string>[] LineStatusFilterOptions =
    [
        new("All", "All lines", "neutral") { IsUnset = true, RuleAfter = true },
        new("Pending", "Pending", "warn"),
        new("Partial", "Partial", "info"),
        new("Invoiced", "Invoiced", "good")
    ];

    private void OnQuickRangeChanged(int days)
    {
        quickRangeDays = days;
        if (quickRangeDays <= 0)
        {
            fromDate = null;
            toDate = null;
            ClearLoadedReport();
            return;
        }

        toDate = DateTime.UtcNow.Date;
        fromDate = toDate.Value.AddDays(-days);
        ClearLoadedReport();
    }

    private Task ResetFiltersAsync()
    {
        quickRangeDays = 0;
        toDate = null;
        fromDate = null;
        searchText = string.Empty;
        lineStatusFilter = "All";
        selectedGroup = string.Empty;
        selectedPartners = Array.Empty<string>();
        customerError = false;
        ClearLoadedReport();
        return Task.CompletedTask;
    }

    private void OnDateRangeChanged()
    {
        quickRangeDays = 0;
        ClearLoadedReport();
    }

    private void ClearLoadedReport()
    {
        report = null;
        scoped = null;
        loadedCardCode = null;
        hasLoaded = false;
        errorMessage = null;
        expandedOrders.Clear();
    }

    /// <summary>
    /// Exports what is on screen, not what was loaded: the workbook's own KPI cards are the six
    /// figures across the top of the page, and a workbook that answered for every customer while
    /// the page it was taken from showed one group would be read as the group's.
    /// </summary>
    private async Task ExportToExcelAsync()
    {
        if (scoped is null)
            return;

        isExporting = true;
        errorMessage = null;

        try
        {
            var bytes = ExportService.ExportOrderFulfillmentToExcel(scoped);
            await JS.InvokeVoidAsync(
                "downloadFile",
                $"Sales_Order_vs_Invoice_{ScopeFileNameSegment}{DateTime.UtcNow:yyyyMMdd_HHmm}.xlsx",
                Convert.ToBase64String(bytes));
        }
        catch (Exception ex)
        {
            errorMessage = $"Export failed: {ex.Message}";
        }
        finally
        {
            isExporting = false;
        }
    }

    /// <summary>Names the selection in the download, where there is one short enough to name.</summary>
    private string ScopeFileNameSegment
    {
        get
        {
            if (selectedPartners.Count == 1)
                return $"{SanitiseForFileName(selectedPartners[0])}_";

            if (selectedPartners.Count > 1)
                return $"{selectedPartners.Count}_partners_";

            return selectedGroup.Length == 0
                ? string.Empty
                : $"{SanitiseForFileName(GroupName(selectedGroup))}_";
        }
    }

    private IEnumerable<FulfillmentLineRow> GetFilteredLines()
    {
        var rows = scoped?.Orders
            .SelectMany(order => order.Lines.Select(line => new FulfillmentLineRow(order, line)))
            ?? Enumerable.Empty<FulfillmentLineRow>();

        if (lineStatusFilter != "All")
        {
            rows = rows.Where(row => string.Equals(row.Line.LineStatus, lineStatusFilter, StringComparison.OrdinalIgnoreCase));
        }

        if (!string.IsNullOrWhiteSpace(searchText))
        {
            rows = rows.Where(row => MatchesSearch(row, searchText));
        }

        return rows
            .OrderByDescending(row => row.Line.QuantityPending > 0)
            .ThenBy(row => row.Line.LineStatus == "Invoiced")
            .ThenByDescending(row => row.Order.OrderDate)
            .ThenBy(row => row.Order.DocNum)
            .ThenBy(row => row.Line.ItemDescription);
    }

    private IEnumerable<OrderFulfillmentItem> GetFilteredOrders()
    {
        var orders = scoped?.Orders.AsEnumerable() ?? Enumerable.Empty<OrderFulfillmentItem>();

        if (lineStatusFilter != "All")
        {
            orders = orders.Where(order => order.Lines.Any(line =>
                string.Equals(line.LineStatus, lineStatusFilter, StringComparison.OrdinalIgnoreCase)));
        }

        if (!string.IsNullOrWhiteSpace(searchText))
        {
            orders = orders.Where(order =>
                Matches(order.DocNum.ToString(), searchText)
                || Matches(order.CardCode, searchText)
                || Matches(order.CardName, searchText)
                || order.Lines.Any(line => Matches(line.ItemCode, searchText)
                    || Matches(line.ItemDescription, searchText)
                    || Matches(line.WarehouseCode, searchText)));
        }

        return orders
            .OrderByDescending(order => order.TotalQuantityPending > 0)
            .ThenByDescending(order => order.OrderDate)
            .ThenBy(order => order.DocNum);
    }

    private IEnumerable<OrderLineDetail> GetVisibleLines(OrderFulfillmentItem order)
    {
        var lines = order.Lines.AsEnumerable();

        if (lineStatusFilter != "All")
        {
            lines = lines.Where(line => string.Equals(line.LineStatus, lineStatusFilter, StringComparison.OrdinalIgnoreCase));
        }

        return lines
            .OrderByDescending(line => line.QuantityPending > 0)
            .ThenBy(line => line.LineStatus == "Invoiced")
            .ThenBy(line => line.ItemDescription);
    }

    private bool IsExpanded(int docEntry) => expandedOrders.Contains(docEntry);

    private void ToggleOrder(int docEntry)
    {
        if (!expandedOrders.Remove(docEntry))
            expandedOrders.Add(docEntry);
    }

    private void ExpandAll()
    {
        foreach (var order in GetFilteredOrders().Take(MaxDisplayedOrders))
            expandedOrders.Add(order.DocEntry);
    }

    private void CollapseAll() => expandedOrders.Clear();

    private static bool MatchesSearch(FulfillmentLineRow row, string search) =>
        Matches(row.Order.DocNum.ToString(), search)
        || Matches(row.Order.CardCode, search)
        || Matches(row.Order.CardName, search)
        || Matches(row.Line.ItemCode, search)
        || Matches(row.Line.ItemDescription, search)
        || Matches(row.Line.WarehouseCode, search);

    /// <summary>Keeps a card code like <c>C/2001</c> from splitting the download's path.</summary>
    private static string SanitiseForFileName(string? value) =>
        string.IsNullOrWhiteSpace(value)
            ? string.Empty
            : string.Concat(value.Select(c => Path.GetInvalidFileNameChars().Contains(c) ? '-' : c));

    private static bool Matches(string? value, string search) =>
        !string.IsNullOrWhiteSpace(value)
        && value.Contains(search, StringComparison.OrdinalIgnoreCase);

    private static (decimal Ordered, decimal Delivered, decimal Pending, decimal ValueUsd, decimal ValueZig, decimal PendingUsd, decimal PendingZig)
        CalculateLineTotals(IReadOnlyCollection<FulfillmentLineRow> rows)
    {
        decimal ordered = 0;
        decimal delivered = 0;
        decimal pending = 0;
        decimal valueUsd = 0;
        decimal valueZig = 0;
        decimal pendingUsd = 0;
        decimal pendingZig = 0;

        foreach (var row in rows)
        {
            ordered += row.Line.QuantityOrdered;
            delivered += row.Line.QuantityDelivered;
            pending += row.Line.QuantityPending;

            if (IsZigCurrency(row.Order.DocCurrency))
            {
                valueZig += row.Line.LineTotal;
                pendingZig += CalculatePendingLineValue(row.Line);
            }
            else
            {
                valueUsd += row.Line.LineTotal;
                pendingUsd += CalculatePendingLineValue(row.Line);
            }
        }

        return (ordered, delivered, pending, valueUsd, valueZig, pendingUsd, pendingZig);
    }

    private static decimal CalculatePendingLineValue(OrderLineDetail line) =>
        line.QuantityOrdered > 0
            ? Math.Round(line.LineTotal * line.QuantityPending / line.QuantityOrdered, 2)
            : 0;

    private static decimal LineFulfilmentPercent(OrderLineDetail line) =>
        line.QuantityOrdered > 0
            ? Math.Round(line.QuantityDelivered / line.QuantityOrdered * 100, 1)
            : 0;

    private static string FormatDate(DateTime value) =>
        value == default || value == DateTime.MinValue ? "-" : value.ToString("dd MMM yyyy");

    private static string FormatMoney(decimal value, string? currency) =>
        IsZigCurrency(currency) ? $"ZIG {value:N2}" : $"${value:N2}";

    private static string FormatMoneyPair(decimal usd, decimal zig)
    {
        if (zig > 0 && usd > 0)
            return $"${usd:N2} / ZIG {zig:N2}";

        return zig > 0 ? $"ZIG {zig:N2}" : $"${usd:N2}";
    }

    private static bool IsZigCurrency(string? currency) =>
        string.Equals(currency, "ZIG", StringComparison.OrdinalIgnoreCase)
        || string.Equals(currency, "ZiG", StringComparison.OrdinalIgnoreCase);

    private static string GetLineDotClass(string status) =>
        status switch
        {
            "Invoiced" => "is-invoiced",
            "Fulfilled" => "is-invoiced",
            "Partial" => "is-partial",
            "Cancelled" => "is-cancelled",
            _ => "is-pending"
        };

    private static string GetOrderDotClass(string status) =>
        status switch
        {
            "Closed" => "is-invoiced",
            "Cancelled" => "is-cancelled",
            _ => "is-pending"
        };

    private static string GetProgressStyle(decimal value)
    {
        var width = Math.Clamp(value, 0, 100);
        return $"width: {width:N0}%;";
    }

    private sealed record FulfillmentLineRow(OrderFulfillmentItem Order, OrderLineDetail Line);
}
