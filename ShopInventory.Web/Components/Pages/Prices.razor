@page "/prices"
@using System.Globalization
@using Microsoft.AspNetCore.Authorization
@using Microsoft.EntityFrameworkCore
@using ShopInventory.Web.Data
@attribute [Authorize(Roles = UserRoles.CatalogueRoles)]
@inject IPriceService PriceService
@inject IMasterDataCacheService CacheService
@inject IDbContextFactory<WebAppDbContext> DbContextFactory
@inject AuthenticationStateProvider AuthStateProvider
@inject ILogger<Prices> Logger
@inject IAuditService AuditService
@rendermode InteractiveServer

<PageTitle>Price List - Shop Inventory</PageTitle>

@* Styles live in wwwroot/css/operations.css (linked from App.razor): the hero,
   buttons, notice and states are the `.ops` vocabulary, and the rail and price
   sheet from `Price List.dc.html` are `.ops-prc`, this page's own half. *@

<div class="ops ops-prc">

    <div class="ops-hero">
        <div class="ops-hero-text">
            <div class="ops-kicker">Master data</div>
            <h1>Price List</h1>
            <p>
                Item prices as they stand on each SAP price list — or, for one customer, the price
                its tills charge with special prices applied.
            </p>
        </div>
        <div class="ops-hero-actions">
            @if (LastSapSync is { } lastSync)
            {
                <div class="ops-prc-synced" title="@lastSync.ToLocalTime().ToString("d MMM yyyy, HH:mm")">
                    SAP sync <span>@SyncAge(lastSync)</span>
                </div>
            }
            @* Admin only, like the Settings tile that runs the same sync. The page
               itself is open to every catalogue role, and the API cannot tell them
               apart: Web calls carry the API key. *@
            <AuthorizeView Roles="@UserRoles.Admin" Context="sapSyncAccess">
                <button type="button" class="ops-btn ops-btn-ghost" @onclick="SyncFromSap"
                        disabled="@(isSyncingFromSap || isLoadingPriceLists)"
                        title="Read every price list, business partner price and special price from SAP now, instead of waiting for the next scheduled sync">
                    @if (isSyncingFromSap)
                    {
                        <span class="ops-spin"></span>
                        <span>@(sapSyncPhase ?? "Syncing from SAP")&hellip;</span>
                    }
                    else
                    {
                        <i class="ph ph-cloud-arrow-down" aria-hidden="true"></i>
                        <span>Sync from SAP</span>
                    }
                </button>
            </AuthorizeView>
            <button type="button" class="ops-btn ops-btn-primary" @onclick="RefreshPriceLists"
                    disabled="@(isLoadingPriceLists || isSyncingFromSap)">
                @if (isLoadingPriceLists)
                {
                    <span class="ops-spin"></span>
                    <span>Refreshing&hellip;</span>
                }
                else
                {
                    <i class="ph ph-arrows-clockwise" aria-hidden="true"></i>
                    <span>Refresh</span>
                }
            </button>
        </div>
    </div>

    @if (sapSyncNotice != null)
    {
        <div class="ops-msg @sapSyncNoticeFamily" role="alert">
            <i class="ph @(sapSyncNoticeFamily == "ops-fam-bad" ? "ph-warning-octagon" : "ph-check-circle")" aria-hidden="true"></i>
            <div class="ops-msg-body">@sapSyncNotice</div>
            <button type="button" class="ops-msg-x" aria-label="Dismiss" @onclick="() => sapSyncNotice = null">
                <i class="ph ph-x" aria-hidden="true"></i>
            </button>
        </div>
    }

    <div class="ops-prc-body">

        <div class="ops-prc-scope">
            <div class="ops-prc-mode" role="tablist" aria-label="Price view">
                <button type="button" role="tab" class="ops-prc-mode-opt @(IsListView ? "is-on" : "")"
                        aria-selected="@IsListView" @onclick="ShowListView">
                    <i class="ph ph-list" aria-hidden="true"></i>
                    <span>By price list</span>
                </button>
                <button type="button" role="tab" class="ops-prc-mode-opt @(IsListView ? "" : "is-on")"
                        aria-selected="@(!IsListView)" @onclick="ShowCustomerView">
                    <i class="ph ph-storefront" aria-hidden="true"></i>
                    <span>By customer</span>
                </button>
            </div>
            <div class="ops-prc-scope-meta">@ScopeMeta</div>
        </div>

        <div class="ops-prc-split">

            @* ── The rail: what to price ─────────────────────────────────── *@
            <aside class="ops-prc-rail" aria-label="@(IsListView ? "Price lists" : "Customers")">
                <div class="ops-prc-rail-head">
                    <span class="ops-prc-dash" aria-hidden="true"></span>
                    <span class="ops-prc-rail-title">@(IsListView ? "Price lists" : "Customers")</span>
                    <span class="ops-prc-rail-count">@RailCount</span>
                </div>
                <div class="ops-prc-find ops-prc-find-rail">
                    <i class="ph ph-magnifying-glass" aria-hidden="true"></i>
                    <input type="search" class="ops-input" aria-label="@(IsListView ? "Filter price lists" : "Filter customers")"
                           placeholder="@(IsListView ? "Filter price lists" : "Code or name")"
                           @bind="railSearchTerm" @bind:event="oninput" @bind:after="FilterRail" />
                </div>
                <div class="ops-prc-rail-list">
                    @if (IsListView)
                    {
                        @if (isLoadingPriceLists && priceLists == null)
                        {
                            <div class="ops-prc-rail-note"><span class="ops-spin"></span>Loading price lists&hellip;</div>
                        }
                        else if (filteredPriceLists.Count == 0)
                        {
                            <div class="ops-prc-rail-note">
                                @(ActivePriceLists.Count == 0 ? "No price lists have been synced from SAP." : "Nothing matches that.")
                            </div>
                        }
                        else
                        {
                            @foreach (var list in filteredPriceLists)
                            {
                                <button type="button" @key="list.ListNum"
                                        class="ops-prc-pick @(list.ListNum == selectedPriceListNum ? "is-on" : "")"
                                        aria-pressed="@(list.ListNum == selectedPriceListNum)"
                                        @onclick="() => SelectPriceList(list.ListNum)">
                                    <span class="ops-prc-pick-text">
                                        <span class="ops-prc-pick-name">@(list.ListName ?? $"List {list.ListNum}")</span>
                                        <span class="ops-prc-pick-sub">List @list.ListNum</span>
                                    </span>
                                    <span class="ops-prc-pick-cur">@CurrencyLabel(list.Currency)</span>
                                </button>
                            }
                        }
                    }
                    else if (isLoadingCustomers)
                    {
                        <div class="ops-prc-rail-note"><span class="ops-spin"></span>Loading customers&hellip;</div>
                    }
                    else if (filteredCustomers.Count == 0)
                    {
                        <div class="ops-prc-rail-note">
                            @(customers.Count == 0 ? "No customers have been synced." : "Nothing matches that.")
                        </div>
                    }
                    else
                    {
                        @* A couple of thousand partners: only the rows in view are drawn. *@
                        <Virtualize Items="filteredCustomers" ItemSize="52" OverscanCount="8" Context="customer">
                            <button type="button" @key="customer.CardCode"
                                    class="ops-prc-pick @(customer.CardCode == selectedCardCode ? "is-on" : "")"
                                    aria-pressed="@(customer.CardCode == selectedCardCode)"
                                    @onclick="() => OnCustomerChanged(customer.CardCode)">
                                <span class="ops-prc-pick-text">
                                    <span class="ops-prc-pick-name">@customer.Name</span>
                                    <span class="ops-prc-pick-sub">@customer.CardCode</span>
                                </span>
                                <span class="ops-prc-pick-cur">@CurrencyLabel(customer.Currency)</span>
                            </button>
                        </Virtualize>
                    }
                </div>
            </aside>

            @* ── The sheet: the chosen list's or customer's prices ──────────── *@
            <section class="ops-prc-sheet" aria-live="polite">
                <div class="ops-prc-sheet-head">
                    <div class="ops-prc-title">
                        <div class="ops-prc-title-row">
                            <h2>@SheetName</h2>
                            @if (SheetCurrency is { } currency)
                            {
                                <span class="ops-prc-cur">@currency</span>
                            }
                        </div>
                        <div class="ops-prc-title-sub">@SheetSub</div>
                    </div>
                    <div class="ops-prc-find ops-prc-find-items">
                        <i class="ph ph-magnifying-glass" aria-hidden="true"></i>
                        <input type="search" class="ops-input" aria-label="Search items" placeholder="Item code or description"
                               disabled="@(SheetPrices == null)"
                               @bind="itemSearchTerm" @bind:event="oninput" @bind:after="BuildRows" />
                    </div>
                </div>

                @if (IsSheetLoading)
                {
                    <div class="ops-loading">
                        <span class="ops-spin ops-spin-lg"></span>
                        <p>Loading prices for @SheetName&hellip;</p>
                    </div>
                }
                else if (SheetError is { } error)
                {
                    <div class="ops-empty">
                        <i class="ph ph-warning-octagon" aria-hidden="true"></i>
                        <h3>Could not load prices</h3>
                        <p>@error</p>
                        <div class="ops-empty-actions">
                            <button type="button" class="ops-btn ops-btn-ghost" @onclick="RetrySheet">Retry</button>
                        </div>
                    </div>
                }
                else if (IsListView && selectedPriceListNum == 0)
                {
                    <div class="ops-empty">
                        <i class="ph ph-tag" aria-hidden="true"></i>
                        <h3>Pick a price list</h3>
                        <p>Choose a list on the left to see every item at the price SAP holds on it.</p>
                    </div>
                }
                else if (!IsListView && string.IsNullOrEmpty(selectedCardCode))
                {
                    <div class="ops-empty">
                        <i class="ph ph-storefront" aria-hidden="true"></i>
                        <h3>Pick a customer</h3>
                        <p>
                            Choose a shop's business partner to see every item at the price its tills charge:
                            the partner's price list, with its special prices applied.
                        </p>
                    </div>
                }
                else if (!IsListView && customerPricing?.Prices is not { Count: > 0 })
                {
                    <div class="ops-empty">
                        <i class="ph ph-tag" aria-hidden="true"></i>
                        <h3>No prices for @selectedCardCode</h3>
                        <p>
                            The price catalogue holds no price list for this customer, so its tills would
                            price every item at zero. Check the partner's price list in SAP, then sync.
                        </p>
                    </div>
                }
                else if (IsListView && allPricesForList == null)
                {
                    <div class="ops-empty">
                        <i class="ph ph-warning-octagon" aria-hidden="true"></i>
                        <h3>Could not reach the server</h3>
                        <p>Check the connection and try again.</p>
                        <div class="ops-empty-actions">
                            <button type="button" class="ops-btn ops-btn-ghost" @onclick="ForceRefreshPrices">
                                <i class="ph ph-arrows-clockwise" aria-hidden="true"></i>Retry
                            </button>
                        </div>
                    </div>
                }
                else if (IsListView && allPricesForList!.Count == 0)
                {
                    <div class="ops-empty">
                        <i class="ph ph-tag" aria-hidden="true"></i>
                        <h3>This list is empty</h3>
                        <p>It may not have been synced yet, or the list has no items in SAP.</p>
                        <div class="ops-empty-actions">
                            <button type="button" class="ops-btn ops-btn-warn" @onclick="ForceRefreshPrices">
                                <i class="ph ph-arrows-clockwise" aria-hidden="true"></i>Retry from SAP
                            </button>
                        </div>
                    </div>
                }
                else
                {
                    <div class="ops-prc-cols">
                        <button type="button" class="ops-prc-sort" @onclick="() => SortBy(PriceSheetSort.Code)">
                            Item code @SortArrow(PriceSheetSort.Code)
                        </button>
                        <button type="button" class="ops-prc-sort" @onclick="() => SortBy(PriceSheetSort.Name)">
                            Item name @SortArrow(PriceSheetSort.Name)
                        </button>
                        <button type="button" class="ops-prc-sort ops-prc-sort-num" @onclick="() => SortBy(PriceSheetSort.Price)">
                            @SortArrow(PriceSheetSort.Price) Price
                        </button>
                    </div>

                    <div class="ops-prc-rows">
                        @if (rows.Count == 0)
                        {
                            <div class="ops-empty">
                                <h3>No items match “@itemSearchTerm”</h3>
                                <p>Try a shorter term, or a code rather than a description.</p>
                            </div>
                        }
                        @foreach (var row in rows)
                        {
                            if (row.Group is { } group)
                            {
                                <div class="ops-prc-group" @key="row.Key">
                                    <span class="ops-prc-dash" aria-hidden="true"></span>
                                    <span class="ops-prc-group-name">@group</span>
                                    <span class="ops-prc-group-count">@row.GroupCount.ToString("N0") @(row.GroupCount == 1 ? "item" : "items")</span>
                                </div>
                            }
                            else if (row.Price is { } price)
                            {
                                <div class="ops-prc-row" @key="row.Key">
                                    <span class="ops-prc-code">@HighlightMatch(price.ItemCode, itemSearchTerm)</span>
                                    <span class="ops-prc-name">
                                        <span class="ops-prc-name-text">@HighlightMatch(price.ItemName, itemSearchTerm)</span>
                                        @if (IsSpecial(price))
                                        {
                                            <span class="ops-prc-special"
                                                  title="@(price.DiscountPercent is { } discount ? $"{discount:0.##}% off the list price" : "Special price")">Special</span>
                                        }
                                    </span>
                                    <span class="ops-prc-price">
                                        @if (!IsListView && price.Price <= 0)
                                        {
                                            @* A till refuses to sell at zero, so this is the row to act on. *@
                                            <span class="ops-prc-unpriced" title="Tills refuse to sell an item priced at zero">Not priced</span>
                                        }
                                        else
                                        {
                                            <span class="ops-prc-amount">@Money(price.Price)</span>
                                        }
                                        @if (IsSpecial(price))
                                        {
                                            <span class="ops-prc-was">@Money(price.PriceBeforeDiscount!.Value)</span>
                                        }
                                    </span>
                                </div>
                            }
                        }
                    </div>
                }

                <div class="ops-prc-sheet-foot">
                    <span class="ops-prc-foot-count">@FooterCount</span>
                    <span class="ops-prc-foot-note">@(IsListView ? "Catalogue price · as synced from SAP" : "Till price · special prices applied")</span>
                </div>
            </section>
        </div>
    </div>
</div>

@code {
    private enum PriceView { PriceList, Customer }

    /// <summary>A partner as the rail lists it.</summary>
    private sealed record CustomerRow(string CardCode, string Name, string? Currency);

    private PriceView activeView = PriceView.PriceList;
    private bool IsListView => activeView == PriceView.PriceList;

    // Price lists
    private List<PriceListDto>? priceLists;
    private List<PriceListDto> filteredPriceLists = [];
    private List<ItemPriceByListDto>? allPricesForList;
    private PriceListDto? selectedPriceList;
    private int selectedPriceListNum;
    private bool isLoading;
    private bool isLoadingPriceLists;
    private string? errorMessage;

    // Customers
    private List<CustomerRow> customers = [];
    private List<CustomerRow> filteredCustomers = [];
    private bool customersLoaded;
    private bool isLoadingCustomers;
    private string? selectedCardCode;
    private ItemPricesByListResponse? customerPricing;
    private bool isLoadingCustomerPrices;
    private string? customerErrorMessage;

    // The sheet
    private string? railSearchTerm;
    private string? itemSearchTerm;
    private PriceSheetSort sortBy = PriceSheetSort.Code;
    private bool sortAscending = true;
    // Flattened once per change, so a render only walks the list.
    private List<PriceSheetRow> rows = [];
    private int shownItemCount;

    /// <summary>
    /// SAP item group name by item code, from the Web's product cache. Empty when either lookup is
    /// unavailable, in which case the sheet is drawn ungrouped rather than failing.
    /// </summary>
    private Dictionary<string, string> itemGroupByCode = new(StringComparer.OrdinalIgnoreCase);
    private bool itemGroupsLoaded;

    // Sync from SAP
    private bool isSyncingFromSap;
    private string? sapSyncPhase;
    private string? sapSyncNotice;
    private string sapSyncNoticeFamily = "ops-fam-good";

    private List<PriceListDto> ActivePriceLists => priceLists?.Where(list => list.IsActive).ToList() ?? [];

    /// <summary>
    /// The newest catalogue read across the lists. The API stores UTC, and a timestamp column
    /// read back through Npgsql can arrive with no kind at all, so both are pinned to UTC here.
    /// </summary>
    private DateTime? LastSapSync =>
        priceLists?
            .Where(list => list.IsActive && list.LastSyncedAt.HasValue)
            .Select(list => (DateTime?)(list.LastSyncedAt!.Value.Kind switch
            {
                DateTimeKind.Utc => list.LastSyncedAt.Value,
                DateTimeKind.Local => list.LastSyncedAt.Value.ToUniversalTime(),
                _ => DateTime.SpecifyKind(list.LastSyncedAt.Value, DateTimeKind.Utc)
            }))
            .Max();

    private string ScopeMeta => IsListView
        ? $"{ActivePriceLists.Count} price {(ActivePriceLists.Count == 1 ? "list" : "lists")} synced from SAP"
        : customersLoaded
            ? $"{customers.Count:N0} business partners · price list resolved per partner"
            : "Price list resolved per partner";

    private string RailCount
    {
        get
        {
            var (shown, total) = IsListView
                ? (filteredPriceLists.Count, ActivePriceLists.Count)
                : (filteredCustomers.Count, customers.Count);
            return string.IsNullOrWhiteSpace(railSearchTerm) ? total.ToString("N0") : $"{shown:N0} of {total:N0}";
        }
    }

    private CustomerRow? SelectedCustomer => customers.FirstOrDefault(customer => customer.CardCode == selectedCardCode);

    private string SheetName => IsListView
        ? selectedPriceList?.ListName ?? (selectedPriceListNum > 0 ? $"List {selectedPriceListNum}" : "Select a price list")
        : SelectedCustomer?.Name ?? selectedCardCode ?? "Select a customer";

    private string? SheetCurrency
    {
        get
        {
            if (IsListView)
            {
                return selectedPriceList == null ? null : CurrencyLabel(selectedPriceList.Currency) ?? "No currency";
            }

            return customerPricing is { PriceListNum: > 0 } ? CurrencyLabel(customerPricing.Currency) ?? "No currency" : null;
        }
    }

    private string SheetSub
    {
        get
        {
            if (IsListView)
            {
                if (selectedPriceList == null)
                {
                    return "Pick a list to see its items.";
                }

                var factor = selectedPriceList.Factor is { } value && value != 1 ? $" · factor {value:N2}" : "";
                return $"List {selectedPriceList.ListNum} · prices as posted in SAP{factor}";
            }

            if (string.IsNullOrEmpty(selectedCardCode))
            {
                return "Pick a customer to see what its tills charge.";
            }

            if (customerPricing == null)
            {
                return selectedCardCode;
            }

            if (customerPricing.PriceListNum <= 0)
            {
                return $"{selectedCardCode} · no price list";
            }

            var listName = customerPricing.PriceListName ?? $"List {customerPricing.PriceListNum}";
            var specials = SpecialPriceCount switch
            {
                0 => "no special prices",
                1 => "1 special price applied",
                var count => $"{count:N0} special prices applied"
            };
            return $"{selectedCardCode} · {listName} · {specials}";
        }
    }

    private List<ItemPriceByListDto>? SheetPrices => IsListView ? allPricesForList : customerPricing?.Prices;

    private bool IsSheetLoading => IsListView ? isLoading : isLoadingCustomerPrices;

    private string? SheetError => IsListView ? errorMessage : customerErrorMessage;

    private string FooterCount => SheetPrices is { } prices
        ? $"{shownItemCount:N0} of {prices.Count:N0} items"
        : "No items";

    private string? SheetCurrencyCode => IsListView ? selectedPriceList?.Currency : customerPricing?.Currency;

    private int SpecialPriceCount => customerPricing?.Prices?.Count(IsSpecial) ?? 0;

    /// <summary>A price the partner's special price moved off its list price.</summary>
    private bool IsSpecial(ItemPriceByListDto price) => !IsListView && price.PriceBeforeDiscount.HasValue;

    protected override async Task OnInitializedAsync()
    {
        await LoadPriceLists();
        await AuditService.LogAsync(AuditActions.ViewPrices, "PriceList", null);
    }

    private async Task EnsureAuthenticatedAsync()
    {
        await AuthStateProvider.GetAuthenticationStateAsync();
    }

    private async Task LoadPriceLists()
    {
        isLoadingPriceLists = true;
        errorMessage = null;
        StateHasChanged();

        try
        {
            await EnsureAuthenticatedAsync();
            var response = await PriceService.GetPriceListsAsync();

            if (response?.PriceLists != null)
            {
                priceLists = response.PriceLists;
                selectedPriceList = priceLists.FirstOrDefault(list => list.ListNum == selectedPriceListNum);
                Logger.LogInformation("Loaded {Count} price lists", priceLists.Count);
            }
            else
            {
                errorMessage = "Failed to load price lists.";
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error loading price lists");
            errorMessage = $"Error: {ex.Message}";
        }
        finally
        {
            isLoadingPriceLists = false;
            FilterRail();
        }
    }

    private async Task RefreshPriceLists()
    {
        await LoadPriceLists();
        if (selectedPriceListNum > 0)
        {
            await LoadPricesForList();
        }

        if (!string.IsNullOrEmpty(selectedCardCode))
        {
            await LoadCustomerPrices();
        }
    }

    private void ShowListView()
    {
        if (IsListView)
        {
            return;
        }

        activeView = PriceView.PriceList;
        railSearchTerm = null;
        itemSearchTerm = null;
        FilterRail();
        BuildRows();
    }

    /// <summary>
    /// Opens the customer view, loading the partner list the first time it is asked for.
    /// </summary>
    /// <remarks>
    /// Loaded on first use rather than with the page: most visits only read a price list, and
    /// the partner cache is a couple of thousand rows.
    /// </remarks>
    private async Task ShowCustomerView()
    {
        if (!IsListView)
        {
            return;
        }

        activeView = PriceView.Customer;
        railSearchTerm = null;
        itemSearchTerm = null;
        FilterRail();
        BuildRows();

        await LoadCustomersAsync();
    }

    private async Task LoadCustomersAsync()
    {
        if (customersLoaded || isLoadingCustomers)
        {
            return;
        }

        isLoadingCustomers = true;
        StateHasChanged();

        try
        {
            customers = (await CacheService.GetBusinessPartnersAsync())
                .Where(partner => !string.IsNullOrWhiteSpace(partner.CardCode))
                .Select(partner => new CustomerRow(
                    partner.CardCode!,
                    string.IsNullOrWhiteSpace(partner.CardName) ? partner.CardCode! : partner.CardName,
                    partner.Currency))
                .OrderBy(customer => customer.Name, StringComparer.OrdinalIgnoreCase)
                .ThenBy(customer => customer.CardCode, StringComparer.OrdinalIgnoreCase)
                .ToList();
            customersLoaded = true;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error loading customers for the Price List page");
            customerErrorMessage = "The customer list could not be loaded.";
        }
        finally
        {
            isLoadingCustomers = false;
            FilterRail();
        }
    }

    private void FilterRail()
    {
        var term = railSearchTerm?.Trim();

        filteredPriceLists = ActivePriceLists
            .Where(list => string.IsNullOrEmpty(term) ||
                (list.ListName?.Contains(term, StringComparison.OrdinalIgnoreCase) ?? false) ||
                $"list {list.ListNum}".Contains(term, StringComparison.OrdinalIgnoreCase))
            .OrderBy(list => list.ListNum)
            .ToList();

        filteredCustomers = string.IsNullOrEmpty(term)
            ? customers
            : customers
                .Where(customer =>
                    customer.CardCode.Contains(term, StringComparison.OrdinalIgnoreCase) ||
                    customer.Name.Contains(term, StringComparison.OrdinalIgnoreCase))
                .ToList();
    }

    private async Task RetrySheet()
    {
        if (IsListView)
        {
            await ForceRefreshPrices();
            return;
        }

        customerErrorMessage = null;
        await LoadCustomersAsync();

        await LoadCustomerPrices();
    }

    private async Task OnCustomerChanged(string? cardCode)
    {
        if (cardCode == selectedCardCode && customerPricing != null)
        {
            return;
        }

        selectedCardCode = cardCode;
        customerPricing = null;
        itemSearchTerm = null;
        customerErrorMessage = null;
        BuildRows();

        if (!string.IsNullOrEmpty(cardCode))
        {
            await LoadCustomerPrices();
        }
    }

    /// <summary>
    /// Reads a customer's prices the way its tills do.
    /// </summary>
    /// <remarks>
    /// <c>useLivePricing=false</c> is the point of this view. The tills' route,
    /// <c>DesktopIntegration/prices/business-partner</c>, answers only from the API's price
    /// catalogue, and so does this. Live pricing would show SAP's figure before the catalogue has
    /// synced it, which is exactly the price a till is not yet charging.
    /// </remarks>
    private async Task LoadCustomerPrices()
    {
        if (string.IsNullOrEmpty(selectedCardCode))
        {
            return;
        }

        isLoadingCustomerPrices = true;
        customerErrorMessage = null;
        StateHasChanged();

        try
        {
            await EnsureAuthenticatedAsync();
            await EnsureItemGroupsAsync();
            var response = await PriceService.GetPricesByBusinessPartnerAsync(selectedCardCode, useLivePricing: false);

            if (response == null)
            {
                customerPricing = null;
                customerErrorMessage = "The server did not answer with prices for this customer.";
            }
            else
            {
                customerPricing = response;
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error loading prices for customer {CardCode}", selectedCardCode);
            customerErrorMessage = $"Error: {ex.Message}";
        }
        finally
        {
            isLoadingCustomerPrices = false;
            BuildRows();
            StateHasChanged();
        }
    }

    /// <summary>
    /// Pulls SAP's prices into the API's catalogue now rather than at the next scheduled sync.
    /// </summary>
    /// <remarks>
    /// The API answers every price read from that catalogue: this page, the invoicing guard and the
    /// shop tills' <c>prices/business-partner</c> route alike. So a price changed in SAP reaches none
    /// of them until the catalogue is synced, and the schedule (<c>SAP:SyncIntervalHours</c>) is
    /// four hours by default. This runs the same sync the Settings "Prices" tile does, the Web's own
    /// price cache included, so the two cannot disagree about what a sync from here did.
    /// </remarks>
    private async Task SyncFromSap()
    {
        var auth = await AuthStateProvider.GetAuthenticationStateAsync();
        if (!auth.User.IsInRole(UserRoles.Admin))
        {
            return;
        }

        isSyncingFromSap = true;
        sapSyncPhase = null;
        sapSyncNotice = null;
        StateHasChanged();

        var progress = new Progress<SyncProgress>(step =>
        {
            sapSyncPhase = step.Phase;
            _ = InvokeAsync(StateHasChanged);
        });

        try
        {
            var cachedCount = await CacheService.SyncPricesFromApiAsync(progress);

            // Tills hold a business partner's price list for 30 minutes and re-read on a ten-minute
            // timer, so 40 minutes is the longest an unattended till can go on charging the old price.
            sapSyncNotice = $"Prices synced from SAP at {DateTime.Now:HH:mm} ({cachedCount:N0} item prices). " +
                "Shop tills pick them up within 40 minutes, or straight away when Refresh is pressed on the till.";
            sapSyncNoticeFamily = "ops-fam-good";

            await AuditService.LogAsync(AuditActions.SyncPrices, "PriceList", null,
                $"Synced from SAP on the Price List page; {cachedCount} item prices cached", true);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "SAP price sync from the Price List page failed");
            sapSyncNotice = ApiErrorResponse.GetFriendlyMessage(ex, "We couldn't sync prices from SAP right now.");
            sapSyncNoticeFamily = "ops-fam-bad";

            await AuditService.LogAsync(AuditActions.SyncPrices, "PriceList", null,
                "Sync from SAP on the Price List page", false, sapSyncNotice);
        }
        finally
        {
            isSyncingFromSap = false;
            sapSyncPhase = null;
        }

        await RefreshPriceLists();
    }

    private async Task SelectPriceList(int listNum)
    {
        if (listNum == selectedPriceListNum && allPricesForList != null)
        {
            return;
        }

        selectedPriceListNum = listNum;
        selectedPriceList = priceLists?.FirstOrDefault(list => list.ListNum == listNum);
        allPricesForList = null;
        itemSearchTerm = null;
        errorMessage = null;
        BuildRows();

        await LoadPricesForList();
    }

    private async Task LoadPricesForList(bool forceRefresh = false)
    {
        if (selectedPriceListNum == 0) return;

        isLoading = true;
        errorMessage = null;
        StateHasChanged();

        try
        {
            await EnsureAuthenticatedAsync();
            await EnsureItemGroupsAsync();
            var response = forceRefresh
                ? await PriceService.GetPricesByPriceListForceRefreshAsync(selectedPriceListNum)
                : await PriceService.GetPricesByPriceListAsync(selectedPriceListNum);

            allPricesForList = response?.Prices;
            if (allPricesForList != null)
            {
                Logger.LogInformation("Loaded {Count} prices for list {ListNum}", allPricesForList.Count, selectedPriceListNum);
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error loading prices for list {ListNum}", selectedPriceListNum);
            errorMessage = $"Error: {ex.Message}";
        }
        finally
        {
            isLoading = false;
            BuildRows();
            StateHasChanged();
        }
    }

    private async Task ForceRefreshPrices()
    {
        await LoadPricesForList(forceRefresh: true);
    }

    /// <summary>
    /// Reads each item's SAP item group once, for the sheet's group headings.
    /// </summary>
    /// <remarks>
    /// The price rows carry no group, so it comes from the Web's product cache (item code → group
    /// number) and its item group lookup (number → name) — the same pair the sales analysis
    /// reports group by. A failure costs the headings and nothing else.
    /// </remarks>
    private async Task EnsureItemGroupsAsync()
    {
        if (itemGroupsLoaded)
        {
            return;
        }

        itemGroupsLoaded = true;

        try
        {
            var groupNames = (await CacheService.GetItemGroupsAsync())
                .ToDictionary(group => group.Number, group => string.IsNullOrWhiteSpace(group.GroupName)
                    ? $"Group {group.Number}"
                    : group.GroupName.Trim());

            await using var db = await DbContextFactory.CreateDbContextAsync();
            var products = await db.CachedProducts
                .AsNoTracking()
                .Where(product => product.ItemsGroupCode != null)
                .Select(product => new { product.ItemCode, product.ItemsGroupCode })
                .ToListAsync();

            itemGroupByCode = new Dictionary<string, string>(StringComparer.OrdinalIgnoreCase);
            foreach (var product in products)
            {
                if (!string.IsNullOrEmpty(product.ItemCode) &&
                    groupNames.TryGetValue(product.ItemsGroupCode!.Value, out var name))
                {
                    itemGroupByCode[product.ItemCode] = name;
                }
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Could not load item groups for the Price List page; the sheet is drawn ungrouped");
            itemGroupByCode = new Dictionary<string, string>(StringComparer.OrdinalIgnoreCase);
        }
    }

    private void SortBy(PriceSheetSort column)
    {
        sortAscending = sortBy != column || !sortAscending;
        sortBy = column;
        BuildRows();
    }

    private string SortArrow(PriceSheetSort column) =>
        sortBy == column ? (sortAscending ? "↑" : "↓") : "";

    /// <summary>Filters, sorts and flattens the sheet into <see cref="rows"/>.</summary>
    private void BuildRows()
    {
        var prices = SheetPrices;
        rows = prices == null ? [] : PriceSheetRows.Build(prices, itemGroupByCode, itemSearchTerm, sortBy, sortAscending);
        shownItemCount = rows.Count(row => row.Price != null);
    }

    // The match is marked with a bare <mark>, which operations.css dresses as an
    // underline. Bootstrap's `.bg-warning` used to fill it, which on a page of
    // matches was louder than the rows themselves.
    private MarkupString HighlightMatch(string? text, string? search)
    {
        var term = search?.Trim();
        if (string.IsNullOrEmpty(text) || string.IsNullOrEmpty(term))
            return new MarkupString(System.Web.HttpUtility.HtmlEncode(text ?? ""));

        var index = text.IndexOf(term, StringComparison.OrdinalIgnoreCase);
        if (index < 0)
            return new MarkupString(System.Web.HttpUtility.HtmlEncode(text));

        var before = System.Web.HttpUtility.HtmlEncode(text[..index]);
        var match = System.Web.HttpUtility.HtmlEncode(text.Substring(index, term.Length));
        var after = System.Web.HttpUtility.HtmlEncode(text[(index + term.Length)..]);

        return new MarkupString($"{before}<mark>{match}</mark>{after}");
    }

    private string Money(decimal amount) =>
        GetCurrencySymbol(SheetCurrencyCode) + amount.ToString("N2", CultureInfo.InvariantCulture);

    private static string GetCurrencySymbol(string? currency)
    {
        return currency?.Trim().ToUpperInvariant() switch
        {
            "ZIG" => "ZiG ",
            "EUR" => "€",
            "GBP" => "£",
            "ZAR" => "R ",
            _ => "$"
        };
    }

    /// <summary>
    /// A currency as the rail and the sheet's chip show it. SAP's "##" (any currency) is not a
    /// code, so it is left blank rather than drawn beside USD and ZiG.
    /// </summary>
    private static string? CurrencyLabel(string? currency)
    {
        var code = currency?.Trim();
        if (string.IsNullOrEmpty(code) || code == "##")
        {
            return null;
        }

        return code.Equals("ZIG", StringComparison.OrdinalIgnoreCase) ? "ZiG" : code;
    }

    private static string SyncAge(DateTime utc)
    {
        var age = DateTime.UtcNow - utc;
        if (age < TimeSpan.FromMinutes(1)) return "just now";
        if (age < TimeSpan.FromHours(1)) return $"{(int)age.TotalMinutes} min ago";
        if (age < TimeSpan.FromDays(1)) return $"{(int)age.TotalHours} h ago";
        return utc.ToLocalTime().ToString("d MMM, HH:mm");
    }
}
