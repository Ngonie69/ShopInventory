@page "/prices"
@using Microsoft.AspNetCore.Authorization
@using ShopInventory.Web.Data
@attribute [Authorize(Roles = UserRoles.CatalogueRoles)]
@inject IPriceService PriceService
@inject IMasterDataCacheService CacheService
@inject AuthenticationStateProvider AuthStateProvider
@inject ILogger<Prices> Logger
@inject IAuditService AuditService
@rendermode InteractiveServer

<PageTitle>Price List - Shop Inventory</PageTitle>

@* Styles live in wwwroot/css/operations.css (linked from App.razor), shared
   with the other four operational pages — see that file's header. `ops` is the
   scope; `ops-prc` is this page's own half of it. *@

<div class="ops ops-prc">

    <div class="ops-hero">
        <div class="ops-hero-text">
            <div class="ops-kicker">Master data</div>
            <h1>Price List</h1>
            <p>
                Item prices as they stand on each SAP price list. Pick a list to see what it
                charges, or search a code to read one price straight off.
            </p>
        </div>
        <div class="ops-hero-actions">
            <button type="button" class="ops-btn ops-btn-primary" @onclick="RefreshPriceLists"
                    disabled="@isLoadingPriceLists">
                @if (isLoadingPriceLists)
                {
                    <span class="ops-spin"></span>
                    <span>Refreshing&hellip;</span>
                }
                else
                {
                    <i class="ph ph-arrows-clockwise" aria-hidden="true"></i>
                    <span>Refresh</span>
                }
            </button>
        </div>
    </div>

    <section class="ops-panel">
        <div class="ops-panel-head">
            <h2><i class="ph ph-tag" aria-hidden="true"></i>@(selectedPriceList?.ListName ?? "Select a price list")</h2>
            @if (selectedPriceList != null)
            {
                <span class="ops-badge ops-fam-accent">@(string.IsNullOrEmpty(selectedPriceList.Currency)
                    ? "No currency" : selectedPriceList.Currency)</span>
                @if (selectedPriceList.Factor.HasValue && selectedPriceList.Factor != 1)
                {
                    <span class="ops-badge ops-fam-neutral">Factor @selectedPriceList.Factor.Value.ToString("N2")</span>
                }
            }
            @if (filteredPrices != null)
            {
                <span class="ops-count">
                    @filteredPrices.Count@(allPricesForList != null ? $" of {allPricesForList.Count}" : "") items
                </span>
            }
        </div>

        <div class="ops-filters">
            <div class="ops-field">
                <label class="ops-label" for="prc-list">Price list</label>
                <NocturneSelect Id="prc-list" Class="nsel-block" Options="PriceListSelectOptions"
                                @bind-Value="selectedPriceListNum" OnChanged="OnPriceListChanged"
                                Caption="Price list" AriaLabel="Price list"
                                Placeholder="Select a price list" />
            </div>
            <div class="ops-field">
                <label class="ops-label" for="prc-search">Search items</label>
                <div class="ops-search">
                    <i class="ph ph-magnifying-glass" aria-hidden="true"></i>
                    <input id="prc-search" type="search" class="ops-input" placeholder="Item code or description"
                           disabled="@(selectedPriceListNum == 0)"
                           @bind="searchTerm" @bind:event="oninput" @bind:after="FilterPrices" />
                </div>
            </div>
            <div class="ops-filter-actions">
                @if (!string.IsNullOrWhiteSpace(searchTerm))
                {
                    <button type="button" class="ops-btn ops-btn-ghost" @onclick="ClearSearch">
                        <i class="ph ph-x-circle" aria-hidden="true"></i>Clear
                    </button>
                }
            </div>
        </div>

        @if (isLoading)
        {
            <div class="ops-loading">
                <span class="ops-spin ops-spin-lg"></span>
                <p>Loading prices for @(selectedPriceList?.ListName ?? "the selected list")&hellip;</p>
            </div>
        }
        else if (errorMessage != null)
        {
            <div class="ops-empty">
                <i class="ph ph-warning-octagon" aria-hidden="true"></i>
                <h3>Could not load prices</h3>
                <p>@errorMessage</p>
                <div class="ops-empty-actions">
                    <button type="button" class="ops-btn ops-btn-ghost" @onclick="ForceRefreshPrices">Retry</button>
                </div>
            </div>
        }
        else if (selectedPriceListNum == 0)
        {
            @* No list chosen, so the page offers the lists themselves. Cards
               rather than a table: it is a choice, not something to compare
               column-wise. *@
            @if (priceLists?.Any(p => p.IsActive) == true)
            {
                <div class="ops-prc-lists">
                    @foreach (var priceList in priceLists.Where(p => p.IsActive).OrderBy(p => p.ListNum))
                    {
                        <button type="button" class="ops-prc-list" @onclick="() => SelectPriceList(priceList.ListNum)">
                            <span class="ops-prc-list-name">@priceList.ListName</span>
                            <span class="ops-prc-list-meta">
                                @if (!string.IsNullOrEmpty(priceList.Currency))
                                {
                                    <span class="ops-badge ops-fam-good">@priceList.Currency</span>
                                }
                                <span class="ops-badge ops-fam-neutral">List @priceList.ListNum</span>
                            </span>
                        </button>
                    }
                </div>
            }
            else
            {
                <div class="ops-empty">
                    <i class="ph ph-tag" aria-hidden="true"></i>
                    <h3>No price lists</h3>
                    <p>Nothing has been synced from SAP yet.</p>
                </div>
            }
        }
        else if (searchedPrice != null)
        {
            @* One exact match, so the price is the page. *@
            <div class="ops-prc-hit">
                <div>
                    <div class="ops-code">@searchedPrice.ItemCode</div>
                    <h3>@searchedPrice.ItemName</h3>
                    <div class="ops-sub">@(selectedPriceList?.ListName ?? "Price")</div>
                </div>
                <div>
                    <div class="ops-prc-hit-price">
                        @GetCurrencySymbol(selectedPriceList?.Currency)@searchedPrice.Price.ToString("N2")
                    </div>
                    @if (!string.IsNullOrEmpty(selectedPriceList?.Currency))
                    {
                        <div class="ops-sub">@selectedPriceList.Currency</div>
                    }
                </div>
            </div>
        }
        else if (filteredPrices?.Any() == true)
        {
            <div class="ops-scroll ops-tall">
                <table class="ops-table">
                    <thead>
                        <tr>
                            <th>Item code</th>
                            <th>Item name</th>
                            <th class="ops-num">Price @(string.IsNullOrEmpty(selectedPriceList?.Currency)
                                ? "" : $"({selectedPriceList.Currency})")</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in filteredPrices)
                        {
                            <tr>
                                <td><span class="ops-code">@HighlightMatch(item.ItemCode, searchTerm)</span></td>
                                <td class="ops-name">@HighlightMatch(item.ItemName, searchTerm)</td>
                                <td class="ops-num">
                                    <span class="ops-qty">
                                        @GetCurrencySymbol(selectedPriceList?.Currency)@item.Price.ToString("N2")
                                    </span>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else if (allPricesForList != null && !string.IsNullOrWhiteSpace(searchTerm))
        {
            <div class="ops-empty">
                <i class="ph ph-magnifying-glass" aria-hidden="true"></i>
                <h3>Nothing matches "@searchTerm"</h3>
                <p>Try a shorter term, or a code rather than a description.</p>
                <div class="ops-empty-actions">
                    <button type="button" class="ops-btn ops-btn-ghost" @onclick="ClearSearch">Clear search</button>
                </div>
            </div>
        }
        else if (allPricesForList?.Count == 0)
        {
            <div class="ops-empty">
                <i class="ph ph-tag" aria-hidden="true"></i>
                <h3>This list is empty</h3>
                <p>It may not have been synced yet, or the list has no items in SAP.</p>
                <div class="ops-empty-actions">
                    <button type="button" class="ops-btn ops-btn-warn" @onclick="ForceRefreshPrices" disabled="@isLoading">
                        <i class="ph ph-arrows-clockwise" aria-hidden="true"></i>Retry from SAP
                    </button>
                </div>
            </div>
        }
        else
        {
            <div class="ops-empty">
                <i class="ph ph-warning-octagon" aria-hidden="true"></i>
                <h3>Could not reach the server</h3>
                <p>Check the connection and try again.</p>
                <div class="ops-empty-actions">
                    <button type="button" class="ops-btn ops-btn-ghost" @onclick="ForceRefreshPrices" disabled="@isLoading">
                        <i class="ph ph-arrows-clockwise" aria-hidden="true"></i>Retry
                    </button>
                </div>
            </div>
        }
    </section>
</div>

@code {
    private List<PriceListDto>? priceLists;

    // 0 is this page's "nothing chosen" value, so that row carries IsUnset.
    private IEnumerable<NocturneSelectOption<int>> PriceListSelectOptions =>
        (priceLists ?? [])
            .Where(list => list.IsActive)
            .Select(list => new NocturneSelectOption<int>(list.ListNum, list.ListName ?? $"List {list.ListNum}")
            {
                Hint = string.IsNullOrEmpty(list.Currency) ? null : list.Currency
            })
            .Prepend(new NocturneSelectOption<int>(0, "Select a price list", "neutral")
            {
                IsUnset = true,
                RuleAfter = true
            });
    private List<ItemPriceByListDto>? allPricesForList;
    private List<ItemPriceByListDto>? filteredPrices;
    private ItemPriceByListDto? searchedPrice;
    private PriceListDto? selectedPriceList;
    private int selectedPriceListNum = 0;
    private bool isLoading = false;
    private bool isLoadingPriceLists = false;
    private string? errorMessage;
    private string? searchTerm;

    protected override async Task OnInitializedAsync()
    {
        await LoadPriceLists();
        await AuditService.LogAsync(AuditActions.ViewPrices, "PriceList", null);
    }

    private async Task EnsureAuthenticatedAsync()
    {
        await AuthStateProvider.GetAuthenticationStateAsync();
    }

    private async Task LoadPriceLists()
    {
        isLoadingPriceLists = true;
        errorMessage = null;
        StateHasChanged();

        try
        {
            await EnsureAuthenticatedAsync();
            var response = await PriceService.GetPriceListsAsync();

            if (response?.PriceLists != null)
            {
                priceLists = response.PriceLists;
                Logger.LogInformation("Loaded {Count} price lists", priceLists.Count);
            }
            else
            {
                errorMessage = "Failed to load price lists.";
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error loading price lists");
            errorMessage = $"Error: {ex.Message}";
        }
        finally
        {
            isLoadingPriceLists = false;
        }
    }

    private async Task RefreshPriceLists()
    {
        await LoadPriceLists();
        if (selectedPriceListNum > 0)
        {
            await LoadPricesForList();
        }
    }

    private void SelectPriceList(int listNum)
    {
        selectedPriceListNum = listNum;
        _ = OnPriceListChanged();
    }

    private async Task OnPriceListChanged()
    {
        selectedPriceList = priceLists?.FirstOrDefault(p => p.ListNum == selectedPriceListNum);
        allPricesForList = null;
        filteredPrices = null;
        searchedPrice = null;
        searchTerm = null;
        errorMessage = null;

        if (selectedPriceListNum > 0)
        {
            await LoadPricesForList();
        }
    }

    private async Task LoadPricesForList(bool forceRefresh = false)
    {
        if (selectedPriceListNum == 0) return;

        isLoading = true;
        errorMessage = null;
        StateHasChanged();

        try
        {
            await EnsureAuthenticatedAsync();
            var response = forceRefresh
                ? await PriceService.GetPricesByPriceListForceRefreshAsync(selectedPriceListNum)
                : await PriceService.GetPricesByPriceListAsync(selectedPriceListNum);

            if (response?.Prices != null)
            {
                allPricesForList = response.Prices;
                filteredPrices = allPricesForList.OrderBy(p => p.ItemCode).ToList();
                Logger.LogInformation("Loaded {Count} prices for list {ListNum}", allPricesForList.Count, selectedPriceListNum);
            }
            else
            {
                allPricesForList = null;
                filteredPrices = null;
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error loading prices for list {ListNum}", selectedPriceListNum);
            errorMessage = $"Error: {ex.Message}";
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    private async Task ForceRefreshPrices()
    {
        await LoadPricesForList(forceRefresh: true);
    }

    private void FilterPrices()
    {
        if (allPricesForList == null)
        {
            filteredPrices = null;
            return;
        }

        if (string.IsNullOrWhiteSpace(searchTerm))
        {
            filteredPrices = allPricesForList.OrderBy(p => p.ItemCode).ToList();
            searchedPrice = null;
            return;
        }

        var term = searchTerm.Trim();

        filteredPrices = allPricesForList
        .Where(p =>
        (p.ItemCode != null && p.ItemCode.Contains(term, StringComparison.OrdinalIgnoreCase)) ||
        (p.ItemName != null && p.ItemName.Contains(term, StringComparison.OrdinalIgnoreCase)))
        .OrderBy(p => p.ItemCode)
        .ToList();

        // If exactly one result, show it as the featured search result
        if (filteredPrices.Count == 1)
        {
            searchedPrice = filteredPrices.First();
            filteredPrices = null;
        }
        else
        {
            searchedPrice = null;
        }
    }

    // The match is marked with a bare <mark>, which operations.css dresses as an
    // underline. Bootstrap's `.bg-warning` used to fill it, which on a page of
    // matches was louder than the rows themselves.
    private MarkupString HighlightMatch(string? text, string? search)
    {
        if (string.IsNullOrEmpty(text) || string.IsNullOrWhiteSpace(search))
            return new MarkupString(System.Web.HttpUtility.HtmlEncode(text ?? ""));

        var index = text.IndexOf(search, StringComparison.OrdinalIgnoreCase);
        if (index < 0)
            return new MarkupString(System.Web.HttpUtility.HtmlEncode(text));

        var before = System.Web.HttpUtility.HtmlEncode(text[..index]);
        var match = System.Web.HttpUtility.HtmlEncode(text.Substring(index, search.Length));
        var after = System.Web.HttpUtility.HtmlEncode(text[(index + search.Length)..]);

        return new MarkupString($"{before}<mark>{match}</mark>{after}");
    }

    private string GetCurrencySymbol(string? currency)
    {
        return currency?.ToUpperInvariant() switch
        {
            "USD" => "$",
            "ZIG" => "ZIG ",
            "EUR" => "€",
            "GBP" => "£",
            "ZAR" => "R",
            null or "" or "##" => "$",
            _ => "$"
        };
    }

    private void ClearSearch()
    {
        searchTerm = null;
        searchedPrice = null;
        filteredPrices = allPricesForList?.OrderBy(p => p.ItemCode).ToList();
        errorMessage = null;
    }
}
