@page "/exchange-rates"
@using Microsoft.AspNetCore.Authorization
@using ShopInventory.Web.Data
@attribute [Authorize(Roles = UserRoles.SystemSetupRoles)]
@inject IExchangeRateService ExchangeRateService
@inject IAppSettingsProvider AppSettings
@inject IAuditService AuditService
@rendermode InteractiveServer

<PageTitle>Exchange Rates - Shop Inventory</PageTitle>

<div class="container-fluid">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2><i class="bi bi-currency-exchange me-2"></i>Exchange Rates</h2>
        <div>
            <MudButton Variant="Variant.Outlined" Color="Color.Primary" Class="me-2" OnClick="FetchExternalRates"
                       Disabled="@isFetchingExternal">
                @if (isFetchingExternal)
                {
                    <span class="spinner-border spinner-border-sm me-1"></span>
                }
                <i class="bi bi-cloud-download me-1"></i>Fetch External Rates
            </MudButton>
            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="() => showAddModal = true">
                <i class="bi bi-plus-circle me-2"></i>Add Rate
            </MudButton>
        </div>
    </div>

    <!-- SAP rate monitor -->
    @if (monitorStatuses is null)
    {
        @if (!isLoadingMonitor)
        {
            <div class="alert alert-warning">
                <i class="bi bi-exclamation-triangle me-2"></i>The SAP rate monitor could not be read.
            </div>
        }
    }
    else
    {
        @foreach (var monitor in monitorStatuses)
        {
            <div class="card mb-4" data-testid="rate-monitor-@monitor.Currency">
                <div class="card-header d-flex flex-wrap justify-content-between align-items-center gap-2">
                    <h5 class="mb-0">
                        <i class="bi bi-activity me-2"></i>@monitor.Currency rate in SAP
                        <span class="fxm-health @HealthClass(monitor.Health) ms-2">@HealthLabel(monitor.Health)</span>
                    </h5>
                    <MudButton Variant="Variant.Outlined" Color="Color.Primary" Size="Size.Small"
                               OnClick="RunMonitorCheck" Disabled="@isCheckingRate">
                        @if (isCheckingRate)
                        {
                            <span class="spinner-border spinner-border-sm me-1"></span>
                        }
                        <i class="bi bi-arrow-repeat me-1"></i>Check SAP now
                    </MudButton>
                </div>
                <div class="card-body">
                    <div class="row g-4 align-items-start">
                        <div class="col-md-4">
                            <div class="text-muted small">Today, @monitor.Today.ToString("ddd d MMM yyyy")</div>
                            @if (monitor.TodayRate is not null)
                            {
                                <h3 class="mb-1">@monitor.TodayRateText</h3>
                                @if (monitor.LocalPerForeign is { } localPer && monitor.LocalCurrency is { } local)
                                {
                                    <div class="text-muted small">1 @monitor.Currency = @localPer.ToString("0.######") @local</div>
                                }
                            }
                            else
                            {
                                <h3 class="mb-1 text-danger">No rate keyed</h3>
                            }
                        </div>
                        <div class="col-md-4">
                            <div class="text-muted small">Keyed in SAP through</div>
                            <div class="fs-5">
                                @if (monitor.KeyedThrough is { } through)
                                {
                                    @through.ToString("ddd d MMM yyyy")
                                    @if (monitor.KeyedBeyondWindow)
                                    {
                                        <span class="text-muted small"> or later</span>
                                    }
                                }
                                else
                                {
                                    <span class="text-danger">Not keyed for today</span>
                                }
                            </div>
                            @if (monitor.DaysKeyedAhead is { } ahead)
                            {
                                <div class="text-muted small">@ahead day@(ahead == 1 ? "" : "s") ahead@(monitor.KeyedBeyondWindow ? " at least" : "")</div>
                            }
                        </div>
                        <div class="col-md-4">
                            <div class="text-muted small">Last checked</div>
                            <div class="fs-5">@(monitor.LastCheckedAtUtc is { } checkedAt ? Cat(checkedAt) : "Never")</div>
                            <div class="text-muted small">Every @monitor.CheckIntervalMinutes minutes</div>
                        </div>
                    </div>

                    <div class="fxm-banner @HealthClass(monitor.Health) mt-3">
                        @monitor.HealthReason
                        @if (!string.IsNullOrWhiteSpace(monitor.LastError))
                        {
                            <div class="small mt-1">Last error: @monitor.LastError</div>
                        }
                    </div>

                    @if (!string.IsNullOrEmpty(monitorMessage))
                    {
                        <div class="small text-muted mt-2">@monitorMessage</div>
                    }

                    @if (monitor.PriceListFactors.Count > 0)
                    {
                        <h6 class="mt-4">@monitor.Currency price lists worked out from another list</h6>
                        <p class="text-muted small mb-2">
                            These lists are a fixed multiple of another list. They do not follow the rate above:
                            when the rate changes in SAP, their prices stay where they are until the factor is changed.
                            Where the base list holds USD prices, the factor is the rate those prices are converted at,
                            so it is compared with today's rate below.
                        </p>
                        <div class="table-responsive">
                            <table class="table table-sm align-middle mb-0">
                                <thead>
                                    <tr>
                                        <th>Price list</th>
                                        <th>Worked out from</th>
                                        <th class="text-end">Factor</th>
                                        <th class="text-end">Against today's rate</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var list in monitor.PriceListFactors)
                                    {
                                        <tr>
                                            <td>@list.PriceListNo · @list.Name</td>
                                            <td>@list.BasePriceList · @(list.BasePriceListName ?? "")</td>
                                            <td class="text-end">@list.Factor.ToString("0.####")</td>
                                            <td class="text-end">@FactorAgainstRate(list.Factor, monitor)</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }

                    <div class="row g-4 mt-1">
                        <div class="col-lg-6">
                            <h6 class="mt-3">Rate changes</h6>
                            @if (monitor.Changes.Count == 0)
                            {
                                <p class="text-muted small mb-0">No change in the recorded history.</p>
                            }
                            else
                            {
                                <div class="table-responsive">
                                    <table class="table table-sm mb-0">
                                        <thead>
                                            <tr>
                                                <th>From</th>
                                                <th class="text-end">Was</th>
                                                <th class="text-end">Became</th>
                                                <th class="text-end">Change</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var change in monitor.Changes.Take(12))
                                            {
                                                <tr>
                                                    <td>@change.RateDate.ToString("ddd d MMM yyyy")</td>
                                                    <td class="text-end">@change.PreviousRate.ToString("0.######")</td>
                                                    <td class="text-end">@change.Rate.ToString("0.######")</td>
                                                    <td class="text-end">@change.PercentChange.ToString("+0.##;-0.##;0")%</td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            }
                        </div>
                        <div class="col-lg-6">
                            <h6 class="mt-3">Recent alerts</h6>
                            @if (monitor.RecentAlerts.Count == 0)
                            {
                                <p class="text-muted small mb-0">None raised.</p>
                            }
                            else
                            {
                                <ul class="list-unstyled small mb-0">
                                    @foreach (var alert in monitor.RecentAlerts.Take(8))
                                    {
                                        <li class="mb-2">
                                            <span class="fxm-health @HealthClass(alert.Severity) me-1">@alert.Kind</span>
                                            <span class="text-muted">@Cat(alert.RaisedAtUtc)</span>
                                            <div>@alert.Message</div>
                                        </li>
                                    }
                                </ul>
                            }
                        </div>
                    </div>
                </div>
            </div>
        }
    }

    <!-- Quick Converter -->
    <div class="card mb-4">
        <div class="card-header">
            <h5 class="mb-0"><i class="bi bi-calculator me-2"></i>Currency Converter</h5>
        </div>
        <div class="card-body">
            <div class="row g-3 align-items-end">
                <div class="col-md-3">
                    <label class="form-label">Amount</label>
                    <input type="number" class="form-control" @bind="convertAmount" step="0.01" />
                </div>
                <div class="col-md-2">
                    <label class="form-label">From</label>
                    <NocturneSelect TValue="string" Class="nsel-bs" Options="ConvertFromOptions"
                                    @bind-Value="convertFrom" Caption="Convert from"
                                    AriaLabel="Convert from currency" />
                </div>
                <div class="col-md-1 text-center">
                    <MudButton Variant="Variant.Outlined" Color="Color.Default" OnClick="SwapCurrencies">
                        <i class="bi bi-arrow-left-right"></i>
                    </MudButton>
                </div>
                <div class="col-md-2">
                    <label class="form-label">To</label>
                    <NocturneSelect TValue="string" Class="nsel-bs" Options="ConvertToOptions"
                                    @bind-Value="convertTo" Caption="Convert to"
                                    AriaLabel="Convert to currency" />
                </div>
                <div class="col-md-2">
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" FullWidth="true" OnClick="ConvertCurrency"
                               Disabled="@isConverting">
                        Convert
                    </MudButton>
                </div>
                <div class="col-md-2">
                    @if (convertedAmount.HasValue)
                    {
                        <div class="alert alert-success mb-0 py-2 text-center">
                            <strong>@convertedAmount.Value.ToString("N2") @convertTo</strong>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>

    @if (isLoading)
    {
        <div class="text-center py-5">
            <div class="spinner-border text-primary" role="status">
                <span class="visually-hidden">Loading...</span>
            </div>
            <p class="mt-2">Loading exchange rates...</p>
        </div>
    }
    else if (errorMessage != null)
    {
        <div class="alert alert-danger">
            <i class="bi bi-exclamation-triangle me-2"></i>@errorMessage
        </div>
    }
    else if (rates?.Any() == true)
    {
        <div class="row">
            @foreach (var rate in rates.Where(r => r.IsActive))
            {
                <div class="col-md-4 mb-4">
                    <div class="card h-100">
                        <div class="card-header d-flex justify-content-between align-items-center">
                            <span>
                                <strong>@rate.FromCurrency</strong> → <strong>@rate.ToCurrency</strong>
                            </span>
                            @if (rate.IsActive)
                            {
                                <span class="badge bg-success">Active</span>
                            }
                        </div>
                        <div class="card-body">
                            <div class="d-flex justify-content-between align-items-center mb-3">
                                <div>
                                    <h3 class="mb-0">@rate.Rate.ToString("N4")</h3>
                                    <small class="text-muted">1 @rate.FromCurrency = @rate.Rate.ToString("N4")
                                        @rate.ToCurrency</small>
                                    </div>
                                    <div class="text-end">
                                        <small class="text-muted d-block">Inverse</small>
                                        <span>@rate.InverseRate.ToString("N6")</span>
                                    </div>
                                </div>
                                <hr />
                                <div class="d-flex justify-content-between text-muted small">
                                    <span>
                                        <i class="bi bi-calendar me-1"></i>
                                        @rate.EffectiveDate.ToString("dd MMM yyyy")
                                    </span>
                                    <span>
                                        <i class="bi bi-info-circle me-1"></i>
                                        @(rate.Source ?? "Manual")
                                    </span>
                                </div>
                            </div>
                            <div class="card-footer">
                                <div class="btn-group btn-group-sm w-100">
                                    <MudButton Variant="Variant.Outlined" Color="Color.Primary"
                                               OnClick="() => ShowHistory(rate.FromCurrency, rate.ToCurrency)">
                                        <i class="bi bi-graph-up me-1"></i>History
                                    </MudButton>
                                    <MudButton Variant="Variant.Outlined" Color="Color.Default" OnClick="() => EditRate(rate)">
                                        <i class="bi bi-pencil me-1"></i>Edit
                                    </MudButton>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>

            <!-- Inactive Rates -->
            @if (rates.Any(r => !r.IsActive))
            {
                <div class="card mt-4">
                    <div class="card-header">
                        <h5 class="mb-0"><i class="bi bi-archive me-2"></i>Inactive Rates</h5>
                    </div>
                    <div class="card-body">
                        <table class="table table-sm">
                            <thead>
                                <tr>
                                    <th>Currency Pair</th>
                                    <th>Rate</th>
                                    <th>Effective Date</th>
                                    <th>Source</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var rate in rates.Where(r => !r.IsActive))
                                {
                                    <tr class="text-muted">
                                        <td>@rate.FromCurrency → @rate.ToCurrency</td>
                                        <td>@rate.Rate.ToString("N4")</td>
                                        <td>@rate.EffectiveDate.ToString("dd MMM yyyy")</td>
                                        <td>@(rate.Source ?? "Manual")</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            }
        }
    else
        {
            <div class="alert alert-info">
                <i class="bi bi-info-circle me-2"></i>No exchange rates configured. Add a new rate to get started.
            </div>
        }
    </div>

    <!-- Add/Edit Rate Modal -->
    @if (showAddModal)
    {
        <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
            <div class="modal-dialog">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title">
                            <i class="bi bi-currency-exchange me-2"></i>@(editingRate != null ? "Edit" : "Add") Exchange Rate
                        </h5>
                        <MudIconButton Icon="@Icons.Material.Filled.Close" OnClick="CloseAddModal" Size="Size.Small" />
                    </div>
                    <div class="modal-body">
                        <div class="row g-3">
                            <div class="col-md-6">
                                <label class="form-label">From Currency *</label>
                                <select class="form-select" @bind="newRate.FromCurrency">
                                    <option value="">Select...</option>
                                    <option value="USD">USD - US Dollar</option>
                                    <option value="ZIG">ZIG - Zimbabwe Gold</option>
                                    <option value="EUR">EUR - Euro</option>
                                    <option value="GBP">GBP - British Pound</option>
                                    <option value="ZAR">ZAR - South African Rand</option>
                                    <option value="BWP">BWP - Botswana Pula</option>
                                </select>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">To Currency *</label>
                                <select class="form-select" @bind="newRate.ToCurrency">
                                    <option value="">Select...</option>
                                    <option value="USD">USD - US Dollar</option>
                                    <option value="ZIG">ZIG - Zimbabwe Gold</option>
                                    <option value="EUR">EUR - Euro</option>
                                    <option value="GBP">GBP - British Pound</option>
                                    <option value="ZAR">ZAR - South African Rand</option>
                                    <option value="BWP">BWP - Botswana Pula</option>
                                </select>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">Rate *</label>
                                <input type="number" class="form-control" @bind="newRate.Rate" step="0.000001"
                                       placeholder="e.g., 25.5" />
                                <small class="text-muted">1 @(newRate.FromCurrency ?? "FROM") = ? @(newRate.ToCurrency ??
                                                                "TO")</small>
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label" for="fx-effective-date">Effective Date</label>
                                    <NocturneDateField Id="fx-effective-date" Class="ndf-bs" @bind-Date="newRate.EffectiveDate" />
                                </div>
                                <div class="col-12">
                                    <label class="form-label">Source</label>
                                    <select class="form-select" @bind="newRate.Source">
                                        <option value="Manual">Manual Entry</option>
                                        <option value="RBZ">Reserve Bank of Zimbabwe</option>
                                        <option value="API">External API</option>
                                        <option value="Bank">Commercial Bank</option>
                                    </select>
                                </div>
                            </div>
                        </div>
                        <div class="modal-footer">
                            <MudButton ButtonType="ButtonType.Button" Variant="Variant.Filled" Color="Color.Default"
                                       OnClick="CloseAddModal">Cancel</MudButton>
                            <MudButton ButtonType="ButtonType.Button" Variant="Variant.Filled" Color="Color.Primary"
                                       OnClick="SaveRate" Disabled="@isSaving">
                                @if (isSaving)
                                {
                                    <span class="spinner-border spinner-border-sm me-1"></span>
                                }
                                Save Rate
                            </MudButton>
                        </div>
                    </div>
                </div>
            </div>
        }

        <!-- History Modal -->
        @if (showHistoryModal && historyData != null)
        {
            <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
                <div class="modal-dialog modal-lg">
                    <div class="modal-content">
                        <div class="modal-header">
                            <h5 class="modal-title">
                                <i class="bi bi-graph-up me-2"></i>Rate History: @historyData.FromCurrency → @historyData.ToCurrency
                            </h5>
                            <MudIconButton Icon="@Icons.Material.Filled.Close" OnClick="() => showHistoryModal = false"
                                           Size="Size.Small" />
                        </div>
                        <div class="modal-body">
                            @if (historyData.History?.Any() == true)
                            {
                                <table class="table table-striped">
                                    <thead>
                                        <tr>
                                            <th>Effective Date</th>
                                            <th class="text-end">Rate</th>
                                            <th class="text-end">Inverse Rate</th>
                                            <th>Source</th>
                                            <th>Status</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var record in historyData.History.OrderByDescending(h => h.EffectiveDate))
                                        {
                                            <tr class="@(record.IsActive ? "" : "text-muted")">
                                                <td>@record.EffectiveDate.ToString("dd MMM yyyy HH:mm")</td>
                                                <td class="text-end">@record.Rate.ToString("N4")</td>
                                                <td class="text-end">@record.InverseRate.ToString("N6")</td>
                                                <td>@(record.Source ?? "Manual")</td>
                                                <td>
                                                    @if (record.IsActive)
                                                    {
                                                        <span class="badge bg-success">Active</span>
                                                    }
                                                    else
                                                    {
                                                        <span class="badge bg-secondary">Historical</span>
                                                    }
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            }
                            else
                            {
                                <p class="text-muted">No history available for this currency pair.</p>
                            }
                        </div>
                        <div class="modal-footer">
                            <MudButton ButtonType="ButtonType.Button" Variant="Variant.Filled" Color="Color.Default"
                                       OnClick="() => showHistoryModal = false">Close</MudButton>
                        </div>
                    </div>
                </div>
            </div>
        }

@code {
    // The two converter pickers list the same currencies; only the resting
    // choice differs, which is why the order does.
    private static readonly NocturneSelectOption<string>[] ConvertFromOptions =
        NocturneSelectOption.FromLabels("USD", "ZIG", "EUR", "GBP", "ZAR");

    private static readonly NocturneSelectOption<string>[] ConvertToOptions =
        NocturneSelectOption.FromLabels("ZIG", "USD", "EUR", "GBP", "ZAR");

    private List<ExchangeRateDto>? rates;
    private List<ExchangeRateMonitorStatus>? monitorStatuses;
    private bool isLoadingMonitor = true;
    private bool isCheckingRate;
    private string? monitorMessage;
    private ExchangeRateDto? editingRate;
    private ExchangeRateHistoryResponse? historyData;
    private bool isLoading = true;
    private bool isSaving = false;
    private bool isFetchingExternal = false;
    private bool isConverting = false;
    private bool showAddModal = false;
    private bool showHistoryModal = false;
    private string? errorMessage;

    // New rate form
    private UpsertExchangeRateRequest newRate = new() { EffectiveDate = DateTime.Today };

    // Converter
    private decimal convertAmount = 100;
    private string convertFrom = "USD";
    private string convertTo = "ZIG";
    private decimal? convertedAmount;

    protected override async Task OnInitializedAsync()
    {
        // The monitor reads the API's own record and answers at once; the rate cards ask SAP live.
        // Draw the monitor as soon as it is in, so it is on screen when SAP is slow or down, which
        // is exactly when it matters.
        var rates = LoadRates();
        await LoadMonitor();
        StateHasChanged();
        await rates;
        await AuditService.LogAsync(AuditActions.ViewExchangeRates, "ExchangeRate", null);
    }

    private async Task LoadRates()
    {
        isLoading = true;
        errorMessage = null;

        try
        {
            rates = await ExchangeRateService.GetAllActiveRatesAsync();
            if (rates == null)
            {
                errorMessage = "Failed to load exchange rates.";
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Error: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task LoadMonitor()
    {
        isLoadingMonitor = true;
        try
        {
            monitorStatuses = await ExchangeRateService.GetMonitorStatusAsync();
        }
        finally
        {
            isLoadingMonitor = false;
        }
    }

    private async Task RunMonitorCheck()
    {
        isCheckingRate = true;
        monitorMessage = null;
        try
        {
            var results = await ExchangeRateService.RunMonitorCheckAsync();
            monitorMessage = results is null
                ? "The check could not be run."
                : string.Join(" ", results.Select(r => r.Succeeded
                    ? $"{r.Currency}: checked with SAP, {(r.AlertsRaised == 0 ? "no new alerts" : $"{r.AlertsRaised} new alert{(r.AlertsRaised == 1 ? "" : "s")}")}."
                    : $"{r.Currency}: SAP could not be read: {r.Error}"));
            await Task.WhenAll(LoadMonitor(), LoadRates());
        }
        finally
        {
            isCheckingRate = false;
        }
    }

    private static string Cat(DateTime utc) =>
        IAuditService.ToCAT(utc.Kind == DateTimeKind.Utc ? utc : DateTime.SpecifyKind(utc, DateTimeKind.Utc))
            .ToString("d MMM HH:mm");

    private static string HealthLabel(string health) => health switch
    {
        "Ok" => "OK",
        "Error" => "Action needed",
        "Warning" => "Check",
        _ => health
    };

    private static string HealthClass(string health) => health switch
    {
        "Ok" or "Info" => "fxm-ok",
        "Error" => "fxm-error",
        _ => "fxm-warning"
    };

    /// <summary>The factor next to today's rate as ZiG per USD: 36 against 30 is +20%.</summary>
    private static string FactorAgainstRate(decimal factor, ExchangeRateMonitorStatus monitor)
    {
        if (monitor.ForeignPerLocal is not { } perLocal || perLocal == 0)
        {
            return "—";
        }

        var difference = (factor - perLocal) / perLocal * 100m;
        return Math.Abs(difference) < 0.005m ? "Same" : $"{difference:+0.#;-0.#}%";
    }


    private async Task SaveRate()
    {
        if (string.IsNullOrEmpty(newRate.FromCurrency) || string.IsNullOrEmpty(newRate.ToCurrency) || newRate.Rate <= 0)
        {
            return;
        }

        isSaving = true;
        try
        {
            var result = await ExchangeRateService.UpsertRateAsync(newRate);
            if (result != null)
            {
                await AuditService.LogAsync(AuditActions.UpdateExchangeRate, "ExchangeRate", null, $"{newRate.FromCurrency} -> {newRate.ToCurrency}: {newRate.Rate}", true);
                CloseAddModal();
                await LoadRates();
            }
        }
        finally
        {
            isSaving = false;
        }
    }

    private void EditRate(ExchangeRateDto rate)
    {
        editingRate = rate;
        newRate = new UpsertExchangeRateRequest
        {
            FromCurrency = rate.FromCurrency,
            ToCurrency = rate.ToCurrency,
            Rate = rate.Rate,
            EffectiveDate = DateTime.Today,
            Source = rate.Source
        };
        showAddModal = true;
    }

    private void CloseAddModal()
    {
        showAddModal = false;
        editingRate = null;
        newRate = new UpsertExchangeRateRequest { EffectiveDate = DateTime.Today };
    }

    private async Task ShowHistory(string fromCurrency, string toCurrency)
    {
        historyData = await ExchangeRateService.GetRateHistoryAsync(fromCurrency, toCurrency, 90);
        showHistoryModal = historyData != null;
    }

    private async Task ConvertCurrency()
    {
        isConverting = true;
        try
        {
            convertedAmount = await ExchangeRateService.ConvertAsync(convertAmount, convertFrom, convertTo);
        }
        finally
        {
            isConverting = false;
        }
    }

    private void SwapCurrencies()
    {
        (convertFrom, convertTo) = (convertTo, convertFrom);
        convertedAmount = null;
    }

    private async Task FetchExternalRates()
    {
        isFetchingExternal = true;
        try
        {
            var success = await ExchangeRateService.FetchExternalRatesAsync();
            if (success)
            {
                await AuditService.LogAsync(AuditActions.FetchExternalRates, "ExchangeRate", null);
                await LoadRates();
            }
        }
        finally
        {
            isFetchingExternal = false;
        }
    }
}
