    private static string GetScheduleCadenceLabel(PodReportEmailSchedule schedule)
    {
        var time = PodScheduleTime.FormatTimeWithZone(schedule.SendMinuteOfDay);
        return PodReportEmailService.ParseFrequency(schedule.Frequency) switch
        {
            PodReportEmailFrequency.Daily => $"Every day at {time}",
            PodReportEmailFrequency.MonthToDateDaily => $"Every day at {time}, month to date",
            PodReportEmailFrequency.Weekly => $"{(DayOfWeek)Math.Clamp(schedule.DayOfWeek ?? (int)DayOfWeek.Monday, 0, 6)}s at {time}",
            PodReportEmailFrequency.Monthly => $"Day {Math.Clamp(schedule.DayOfMonth ?? 1, 1, 31)} of each month at {time}",
            PodReportEmailFrequency.Quarterly => $"Day {Math.Clamp(schedule.DayOfMonth ?? 1, 1, 31)} of each quarter at {time}",
            PodReportEmailFrequency.HalfYearly => $"Day {Math.Clamp(schedule.DayOfMonth ?? 1, 1, 31)} of each half-year at {time}",
            PodReportEmailFrequency.EveryNDays => $"Every {PodReportEmailService.NormalizeIntervalDays(schedule.IntervalDays)} days at {time}",
            _ => $"Weekly at {time}"
        };
    }

    private string FormatScheduleNextSend(PodReportEmailSchedule schedule)
    {
        if (!schedule.Enabled)
        {
            return "Disabled";
        }

        if (!GetBoolValue(SettingKeys.PodReportEmailsEnabled))
        {
            return "Paused";
        }

        var frequency = PodReportEmailService.ParseFrequency(schedule.Frequency);
        var nowLocal = PodScheduleTime.NowLocal();
        var mostRecentDueLocal = PodReportEmailJob.ComputeMostRecentDueLocal(schedule, frequency, nowLocal);
        if (mostRecentDueLocal.HasValue)
        {
            var mostRecentDueUtc = PodScheduleTime.ToUtc(mostRecentDueLocal.Value);
            var sentFloorUtc = schedule.LastSentUtc ?? schedule.AnchorDateUtc;
            if (mostRecentDueUtc > sentFloorUtc)
            {
                return $"Retry pending since {mostRecentDueLocal:dd MMM yyyy HH:mm} {PodScheduleTime.ZoneAbbreviation}";
            }
        }

        var nextLocal = PodReportEmailJob.ComputeNextDueLocal(schedule, frequency, nowLocal);
        return $"{nextLocal:dd MMM yyyy HH:mm} {PodScheduleTime.ZoneAbbreviation}";
    }

    private string ScheduleRecipientSummary(PodReportEmailSchedule schedule)
    {
        var to = ParseEmailRecipients(schedule.ToRecipients).Count;
        var cc = ParseEmailRecipients(schedule.CcRecipients).Count;
        var toText = $"{to} recipient{(to == 1 ? string.Empty : "s")}";
        return cc > 0 ? $"{toText} · {cc} cc" : toText;
    }

