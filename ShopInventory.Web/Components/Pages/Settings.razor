            mobileVersionPolicyMinimumSupportedVersion = settings.MinimumSupportedVersion;
            mobileVersionPolicyGooglePlayUrl = settings.GooglePlayUrl;
            mobileVersionPolicyReleaseNotes = settings.ReleaseNotes;
            mobileVersionPolicyWarnMessage = settings.WarnMessage;
            mobileVersionPolicyBlockMessage = settings.BlockMessage;
        }
        catch (Exception ex)
        {
            mobileVersionPolicySaveSucceeded = false;
            mobileVersionPolicyMessage = $"Failed to load mobile app policy settings: {ex.Message}";
        }
        finally
        {
            isLoadingMobileVersionPolicy = false;
        }
    }

    private async Task OnMobileVersionPolicyAppChanged(string appId)
    {
        selectedMobileVersionPolicyAppId = appId;
        mobileVersionPolicyMessage = null;
        await LoadMobileVersionPolicySettings();
        StateHasChanged();
    }

    private async Task SaveMobileVersionPolicySettings()
    {
        isSavingMobileVersionPolicy = true;
        mobileVersionPolicyMessage = null;
        StateHasChanged();

        try
        {
            var request = new MobileVersionPolicySettingsUpdateRequest
            {
                AppId = selectedMobileVersionPolicyAppId,
                Enabled = mobileVersionPolicyEnabled,
                RequireHeaders = mobileVersionPolicyRequireHeaders,
                LatestVersion = mobileVersionPolicyLatestVersion.Trim(),
                RecommendedVersion = mobileVersionPolicyRecommendedVersion.Trim(),
                MinimumSupportedVersion = mobileVersionPolicyMinimumSupportedVersion.Trim(),
                GooglePlayUrl = mobileVersionPolicyGooglePlayUrl.Trim(),
                ReleaseNotes = mobileVersionPolicyReleaseNotes.Trim(),
                WarnMessage = mobileVersionPolicyWarnMessage.Trim(),
                BlockMessage = mobileVersionPolicyBlockMessage.Trim()
            };

            var result = await MobileVersionPolicySettingsService.UpdateSettingsAsync(request);
            mobileVersionPolicySaveSucceeded = result.Success;
            mobileVersionPolicyMessage = result.Message;

            if (result.Success)
            {
                await LoadMobileVersionPolicySettings();
                await LogAudit(
                    AuditActions.UpdateSettings,
                    $"Updated {SelectedMobileVersionPolicyAppName} version policy (minimum: {mobileVersionPolicyMinimumSupportedVersion}, recommended: {mobileVersionPolicyRecommendedVersion}, latest: {mobileVersionPolicyLatestVersion})");
            }
        }
        catch (Exception ex)
        {
            mobileVersionPolicySaveSucceeded = false;
            mobileVersionPolicyMessage = $"Failed to save mobile app policy settings: {ex.Message}";
        }
        finally
        {
            isSavingMobileVersionPolicy = false;
            StateHasChanged();
        }
    }

    // ── Payment settings ────────────────────────────────────────────────

    private async Task LoadPaymentSettingsData()
    {
        try
        {
            await using var db = await DbContextFactory.CreateDbContextAsync();
            cachedGLAccounts = await db.CachedGLAccounts
                .Where(g => g.IsActive)
                .OrderBy(g => g.Code)
                .ToListAsync();
            cachedWarehouses = await db.CachedWarehouses
                .Where(w => w.IsActive)
                .OrderBy(w => w.WarehouseCode)
                .ToListAsync();

            // Load current values from settings
            var glSetting = await SettingsService.GetValueAsync(SettingKeys.IncomingPaymentGLAccount);
            paymentGLAccount = glSetting ?? "";

            var methodSetting = await SettingsService.GetValueAsync(SettingKeys.DefaultPaymentMethod);
            defaultPaymentMethod = methodSetting ?? "cash";
        }
        catch (Exception ex)
        {
            errorMessage = $"Failed to load payment settings data: {ex.Message}";
        }
    }

    private string GLAccountText
    {
        get
        {
            if (glQuery is not null)
            {
                return glQuery;
            }

            if (string.IsNullOrWhiteSpace(paymentGLAccount))
            {
                return string.Empty;
            }

            var account = cachedGLAccounts.FirstOrDefault(gl => gl.Code == paymentGLAccount);
            return account is null ? paymentGLAccount : $"{account.Code} · {account.Name}";
        }
    }

    private List<CachedGLAccount> FilterGLAccounts()
    {
        var eligible = paymentEligibleGLAccounts;
        if (!string.IsNullOrWhiteSpace(glQuery))
        {
            eligible = eligible.Where(gl =>
                $"{gl.Code} {gl.Name}".Contains(glQuery, StringComparison.OrdinalIgnoreCase));
        }

        return eligible.Take(20).ToList();
    }

    private async Task PickGLAccount(CachedGLAccount? gl)
    {
        paymentGLAccount = gl?.Code ?? "";
        glQuery = null;
        glOpen = false;
        await SettingsService.SaveSettingAsync(SettingKeys.IncomingPaymentGLAccount, paymentGLAccount, currentUsername);
        successMessage = $"G/L account updated to {(string.IsNullOrEmpty(paymentGLAccount) ? "(none)" : $"{gl?.Code} · {gl?.Name}")}";
        await LogAudit(AuditActions.UpdateSettings, $"Updated incoming payment G/L account to: {paymentGLAccount}");
    }

    private async Task OnDefaultPaymentMethodChanged(ChangeEventArgs e)
    {
        defaultPaymentMethod = e.Value?.ToString() ?? "cash";
        await SettingsService.SaveSettingAsync(SettingKeys.DefaultPaymentMethod, defaultPaymentMethod, currentUsername);
        var label = defaultPaymentMethod switch
        {
            "cash" => "Cash",
            "transfer" => "Transfer",
            "check" => "Check",
            "credit" => "Credit card",
            _ => defaultPaymentMethod
        };
        successMessage = $"Default payment method updated to {label}";
        await LogAudit(AuditActions.UpdateSettings, $"Updated default payment method to: {label}");
    }

    // ── Database reset ──────────────────────────────────────────────────

    private void ShowResetConfirmation()
    {
        resetConfirmationText = string.Empty;
        resetMessage = null;
        showResetConfirmation = true;
    }

    private void CancelReset()
    {
        showResetConfirmation = false;
        resetConfirmationText = string.Empty;
    }

    private async Task ConfirmResetDatabase()
    {
        if (resetConfirmationText != "RESET")
            return;

        isResettingDatabase = true;
        showResetConfirmation = false;
        resetMessage = null;
        StateHasChanged();

        try
        {
            var (success, message) = await BackupService.ResetDatabaseAsync();
            resetSuccess = success;
            resetMessage = success
                ? "Database has been reset successfully. All transactional data has been deleted."
                : message;

            if (success)
            {
                // Clear cached master data from web database so stale test data doesn't persist
                await ClearWebCachesAfterDatabaseResetAsync();

                // Invalidate in-memory caches so fresh data is fetched on next access
                CacheService.InvalidateCache();

                await LogAudit(AuditActions.ResetDatabase, "Database reset completed - all transactional and cached data deleted");
            }
        }
        catch (Exception ex)
        {
            resetSuccess = false;
            resetMessage = $"Database reset failed: {ex.Message}";
        }
        finally
        {
            isResettingDatabase = false;
            resetConfirmationText = string.Empty;
            StateHasChanged();
        }
    }

    private async Task ClearWebCachesAfterDatabaseResetAsync()
    {
        await using var dbContext = await DbContextFactory.CreateDbContextAsync();

        await ExecuteDeleteIfTableExistsAsync(dbContext.CachedProducts, "CachedProducts");
        await ExecuteDeleteIfTableExistsAsync(dbContext.CachedPrices, "CachedPrices");
        await ExecuteDeleteIfTableExistsAsync(dbContext.CachedBusinessPartners, "CachedBusinessPartners");
        await ExecuteDeleteIfTableExistsAsync(dbContext.CachedWarehouses, "CachedWarehouses");
        await ExecuteDeleteIfTableExistsAsync(dbContext.CachedWarehouseStocks, "CachedWarehouseStocks");
        await ExecuteDeleteIfTableExistsAsync(dbContext.CachedGLAccounts, "CachedGLAccounts");
        await ExecuteDeleteIfTableExistsAsync(dbContext.CachedCostCentres, "CachedCostCentres");
        await ExecuteDeleteIfTableExistsAsync(dbContext.CachedIncomingPayments, "CachedIncomingPayments");
        await ExecuteDeleteIfTableExistsAsync(dbContext.CachedInventoryTransfers, "CachedInventoryTransfers");
        await ExecuteDeleteIfTableExistsAsync(dbContext.CacheSyncInfo, "CacheSyncInfo");
    }

    private async Task ExecuteDeleteIfTableExistsAsync<TEntity>(IQueryable<TEntity> query, string tableName)
        where TEntity : class
    {
        try
        {
            await query.ExecuteDeleteAsync();
        }
        catch (Npgsql.PostgresException ex) when (ex.SqlState == Npgsql.PostgresErrorCodes.UndefinedTable)
        {
            Logger.LogWarning(
                ex,
                "Skipped cache clear for missing web table {TableName} during database reset",
                tableName);
        }
    }
}
