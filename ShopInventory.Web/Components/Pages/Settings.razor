@page "/settings"
@using ShopInventory.Web.Data
@using ShopInventory.Web.Services
@using ShopInventory.Web.Models
@using Microsoft.EntityFrameworkCore
@inject IAppSettingsService SettingsService
@inject IAuditService AuditService
@inject IMasterDataCacheService CacheService
@inject IBackupService BackupService
@inject IDbContextFactory<WebAppDbContext> DbContextFactory
@inject ILogger<Settings> Logger
@inject AuthenticationStateProvider AuthStateProvider
@inject IAppSettingsProvider AppSettingsProvider
@inject IJSRuntime JS
@inject ISAPSettingsService SAPSettingsService
@inject IMobileVersionPolicySettingsService MobileVersionPolicySettingsService
@inject IPodReportEmailService PodEmailService
@inject IPodReportEmailScheduleService PodReportEmailScheduleService
@attribute [Authorize(Roles = "Admin")]
@rendermode InteractiveServer

<PageTitle>Settings - Shop Inventory</PageTitle>

@* Styles live in wwwroot/css/settings.css (linked from App.razor). The imported design
   (Settings.dc.html) is a single dark scheme; the stylesheet keeps those values as its
   dark theme and carries a light one built from the shell's palette, so the page follows
   the app's light/dark toggle. *@

<div class="stg">

    <!-- ── Header ─────────────────────────────────────────────────────── -->
    <header class="stg-header">
        <div class="stg-header-inner">
            <div class="stg-header-title">
                <div class="stg-header-title-row">
                    <i class="ph ph-gear-six"></i>
                    <h1>Settings</h1>
                </div>
                <p>Application configuration, data sync and user accounts</p>
            </div>
            <div class="stg-header-actions">
                @if (justSaved && DirtyCount == 0)
                {
                    <span class="stg-saved-flag"><i class="ph ph-check"></i>All changes saved</span>
                }
                else if (DirtyCount > 0)
                {
                    <span class="stg-dirty-flag">
                        <span class="stg-dirty-dot"></span>
                        <span>@DirtyCount unsaved</span>
                    </span>
                }
                <button type="button" class="stg-btn stg-btn-primary" style="letter-spacing:.02em"
                        disabled="@(DirtyCount == 0 || isSaving)" @onclick="RequestSave">
                    @if (isSaving)
                    {
                        <span class="stg-spin"></span>
                    }
                    Save changes
                </button>
            </div>
        </div>
        <div class="stg-rule"></div>
    </header>

    @if (isLoading)
    {
        <div class="stg-loading">
            <span class="stg-spin stg-spin-lg"></span>
            <p>Loading settings…</p>
        </div>
    }
    else
    {
        <div class="stg-body">

            <!-- ── Sidebar ────────────────────────────────────────────── -->
            <aside class="stg-nav">
                <div class="stg-nav-label">Configuration</div>
                <button type="button" class="stg-nav-item @Active(SettingCategories.Display)"
                        @onclick="() => SelectCategory(SettingCategories.Display)">
                    <i class="ph ph-palette"></i><span>Display</span>
                </button>
                <button type="button" class="stg-nav-item @Active(SettingCategories.General)"
                        @onclick="() => SelectCategory(SettingCategories.General)">
                    <i class="ph ph-sliders-horizontal"></i><span>General</span>
                </button>
                <button type="button" class="stg-nav-item @Active(SettingCategories.Printing)"
                        @onclick="() => SelectCategory(SettingCategories.Printing)">
                    <i class="ph ph-printer"></i><span>Printing</span>
                </button>

                <div class="stg-nav-label">Integration</div>
                <button type="button" class="stg-nav-item @Active(PaymentsCategory)"
                        @onclick="() => SelectCategory(PaymentsCategory)">
                    <i class="ph ph-credit-card"></i><span>Payments</span>
                </button>
                <button type="button" class="stg-nav-item @Active(SAPCategory)"
                        @onclick="() => SelectCategory(SAPCategory)">
                    <i class="ph ph-cloud-arrow-up"></i><span>SAP Connection</span>
                </button>
                <button type="button" class="stg-nav-item @Active(MobileAppCategory)"
                        @onclick="() => SelectCategory(MobileAppCategory)">
                    <i class="ph ph-device-mobile"></i><span>Mobile App</span>
                </button>
                <button type="button" class="stg-nav-item @Active(SettingCategories.API)"
                        @onclick="() => SelectCategory(SettingCategories.API)">
                    <i class="ph ph-plugs"></i><span>API</span>
                </button>
                <button type="button" class="stg-nav-item @Active(SettingCategories.EmailReports)"
                        @onclick="() => SelectCategory(SettingCategories.EmailReports)">
                    <i class="ph ph-envelope-simple"></i><span>Email Reports</span>
                </button>

                <div class="stg-nav-label">System</div>
                <button type="button" class="stg-nav-item @Active(DataManagementCategory)"
                        @onclick="() => SelectCategory(DataManagementCategory)">
                    <i class="ph ph-arrows-clockwise"></i><span>Data Sync</span>
                </button>
                <button type="button" class="stg-nav-item stg-nav-item-danger @Active(DangerZoneCategory)"
                        @onclick="() => SelectCategory(DangerZoneCategory)">
                    <i class="ph ph-warning"></i><span>Danger Zone</span>
                </button>
            </aside>

            <!-- ── Content ────────────────────────────────────────────── -->
            <main class="stg-main">

                @if (!string.IsNullOrEmpty(successMessage))
                {
                    <div class="stg-alert stg-alert-success">
                        <i class="ph ph-check-circle"></i>
                        <span>@successMessage</span>
                        <button type="button" class="stg-alert-close" @onclick="() => successMessage = null"><i class="ph ph-x"></i></button>
                    </div>
                }
                @if (!string.IsNullOrEmpty(errorMessage))
                {
                    <div class="stg-alert stg-alert-error">
                        <i class="ph ph-warning-circle"></i>
                        <span>@errorMessage</span>
                        <button type="button" class="stg-alert-close" @onclick="() => errorMessage = null"><i class="ph ph-x"></i></button>
                    </div>
                }

                @* ── General ─────────────────────────────────────────── *@
                @if (selectedCategory == SettingCategories.General)
                {
                    <section class="stg-card">
                        <div class="stg-section-head">
                            <span class="stg-section-icon"><i class="ph ph-sliders-horizontal"></i></span>
                            <div class="stg-section-text">
                                <h2>General</h2>
                                <p>Company defaults, warehouse, currency and date formatting.</p>
                            </div>
                        </div>

                        <!-- Company name -->
                        <div class="stg-row">
                            <div class="stg-row-info">
                                <div class="stg-row-label">
                                    <span>Company Name</span>
                                    @if (IsDirty(SettingKeys.CompanyName))
                                    {
                                        <span class="stg-tag">edited</span>
                                    }
                                </div>
                                <span class="stg-row-desc">
                                    Heading on printed inventory transfer notes. Invoice, quotation and sales-order PDFs,
                                    exported reports and outgoing email all carry the registered company name and are not
                                    affected by this.
                                </span>
                                @if (SettingMeta(SettingKeys.CompanyName) is string companyMeta)
                                {
                                    <span class="stg-row-meta"><i class="ph ph-pencil-simple"></i>@companyMeta</span>
                                }
                            </div>
                            <div class="stg-row-control">
                                @if (IsDirty(SettingKeys.CompanyName))
                                {
                                    <button type="button" class="stg-btn stg-btn-ghost stg-btn-icon" title="Revert"
                                            @onclick="() => Revert(SettingKeys.CompanyName)">
                                        <i class="ph ph-arrow-counter-clockwise"></i>
                                    </button>
                                }
                                <input class="stg-input" placeholder="Company name" value="@GetValue(SettingKeys.CompanyName)"
                                       @onchange="e => OnSettingChanged(SettingKeys.CompanyName, e.Value?.ToString())" />
                            </div>
                        </div>

                        <!-- Default warehouse -->
                        <div class="stg-row">
                            <div class="stg-row-info">
                                <div class="stg-row-label">
                                    <span>Default Warehouse</span>
                                    @if (IsDirty(SettingKeys.DefaultWarehouse))
                                    {
                                        <span class="stg-tag">edited</span>
                                    }
                                </div>
                                <span class="stg-row-desc">
                                    Pre-selected in the defaults bar on a new invoice, so every line starts on it. Sales
                                    orders start from the warehouse assigned to the signed-in user instead.
                                </span>
                                @if (SettingMeta(SettingKeys.DefaultWarehouse) is string warehouseMeta)
                                {
                                    <span class="stg-row-meta"><i class="ph ph-pencil-simple"></i>@warehouseMeta</span>
                                }
                            </div>
                            <div class="stg-row-control">
                                @if (IsDirty(SettingKeys.DefaultWarehouse))
                                {
                                    <button type="button" class="stg-btn stg-btn-ghost stg-btn-icon" title="Revert"
                                            @onclick="RevertWarehouse">
                                        <i class="ph ph-arrow-counter-clockwise"></i>
                                    </button>
                                }
                                <div class="stg-combo" @onfocusout="() => whOpen = false">
                                    <i class="ph ph-magnifying-glass stg-combo-icon"></i>
                                    <input class="stg-input" placeholder="Search warehouse" value="@WarehouseText"
                                           @oninput="e => { whQuery = e.Value?.ToString() ?? string.Empty; whOpen = true; }"
                                           @onfocus="() => whOpen = true" />
                                    @if (whOpen)
                                    {
                                        var matches = FilterWarehouses();
                                        <div class="stg-combo-menu">
                                            @foreach (var wh in matches)
                                            {
                                                <button type="button" class="stg-combo-item"
                                                        @onmousedown="() => PickWarehouse(wh)">
                                                    <i class="ph ph-warehouse"></i>
                                                    <span class="stg-combo-code">@wh.WarehouseCode</span>
                                                    <span class="stg-combo-name">@wh.WarehouseName</span>
                                                </button>
                                            }
                                            @if (matches.Count == 0)
                                            {
                                                <div class="stg-combo-empty">
                                                    @(cachedWarehouses.Count == 0
                                                        ? "No warehouses cached — sync them from Data Sync first."
                                                        : "No warehouse matches that code")
                                                </div>
                                            }
                                        </div>
                                    }
                                </div>
                            </div>
                        </div>

                        <!-- Default currency -->
                        <div class="stg-row">
                            <div class="stg-row-info">
                                <div class="stg-row-label">
                                    <span>Default Currency</span>
                                    @if (IsDirty(SettingKeys.DefaultCurrency))
                                    {
                                        <span class="stg-tag">edited</span>
                                    }
                                </div>
                                <span class="stg-row-desc">
                                    Currency a new invoice or credit note opens on. Picking a customer replaces it with
                                    that customer's own currency.
                                </span>
                                @if (SettingMeta(SettingKeys.DefaultCurrency) is string currencyMeta)
                                {
                                    <span class="stg-row-meta"><i class="ph ph-pencil-simple"></i>@currencyMeta</span>
                                }
                            </div>
                            <div class="stg-row-control">
                                @if (IsDirty(SettingKeys.DefaultCurrency))
                                {
                                    <button type="button" class="stg-btn stg-btn-ghost stg-btn-icon" title="Revert"
                                            @onclick="() => Revert(SettingKeys.DefaultCurrency)">
                                        <i class="ph ph-arrow-counter-clockwise"></i>
                                    </button>
                                }
                                <div class="stg-select-wrap">
                                    <select class="stg-input stg-select" value="@GetValue(SettingKeys.DefaultCurrency)"
                                            @onchange="e => OnSettingChanged(SettingKeys.DefaultCurrency, e.Value?.ToString())">
                                        @* Only the currencies the invoice and credit-note screens can actually be
                                           raised in. ZAR was offered here but neither screen lists it, and pricing
                                           falls back to the USD price for anything that is not ZIG. *@
                                        <option value="USD">USD · US Dollar</option>
                                        <option value="ZIG">ZIG · Zimbabwe Gold</option>
                                    </select>
                                    <i class="ph ph-caret-down stg-select-caret"></i>
                                </div>
                            </div>
                        </div>

                        <!-- Date format -->
                        <div class="stg-row">
                            <div class="stg-row-info">
                                <div class="stg-row-label">
                                    <span>Date Format</span>
                                    @if (IsDirty(SettingKeys.DateFormat))
                                    {
                                        <span class="stg-tag">edited</span>
                                    }
                                </div>
                                <span class="stg-row-desc">
                                    Format the date pickers use on documents, reports and list filters. Table columns and
                                    exported reports render a fixed 04 Jan 2026 regardless.
                                </span>
                                @if (SettingMeta(SettingKeys.DateFormat) is string dateMeta)
                                {
                                    <span class="stg-row-meta"><i class="ph ph-pencil-simple"></i>@dateMeta</span>
                                }
                            </div>
                            <div class="stg-row-control">
                                @if (IsDirty(SettingKeys.DateFormat))
                                {
                                    <button type="button" class="stg-btn stg-btn-ghost stg-btn-icon" title="Revert"
                                            @onclick="() => Revert(SettingKeys.DateFormat)">
                                        <i class="ph ph-arrow-counter-clockwise"></i>
                                    </button>
                                }
                                <div class="stg-select-wrap">
                                    <select class="stg-input stg-select" value="@GetValue(SettingKeys.DateFormat)"
                                            @onchange="e => OnSettingChanged(SettingKeys.DateFormat, e.Value?.ToString())">
                                        <option value="dd MMM yyyy">04 Jan 2026</option>
                                        <option value="dd/MM/yyyy">04/01/2026</option>
                                        <option value="MM/dd/yyyy">01/04/2026</option>
                                        <option value="yyyy-MM-dd">2026-01-04</option>
                                    </select>
                                    <i class="ph ph-caret-down stg-select-caret"></i>
                                </div>
                            </div>
                        </div>

                        <div class="stg-footnote">
                            <i class="ph ph-info"></i>
                            <span>Changes apply to new documents only — existing records keep the values they were created with.</span>
                        </div>
                    </section>
                }

                @* ── Display ─────────────────────────────────────────── *@
                else if (selectedCategory == SettingCategories.Display)
                {
                    <section class="stg-card">
                        <div class="stg-section-head">
                            <span class="stg-section-icon"><i class="ph ph-palette"></i></span>
                            <div class="stg-section-text">
                                <h2>Display</h2>
                                <p>List density and how prices are presented.</p>
                            </div>
                        </div>

                        <!-- Page size -->
                        <div class="stg-row">
                            <div class="stg-row-info">
                                <div class="stg-row-label">
                                    <span>Rows Per Page</span>
                                    @if (IsDirty(SettingKeys.PageSize))
                                    {
                                        <span class="stg-tag">edited</span>
                                    }
                                </div>
                                <span class="stg-row-desc">Starting page size for every paged list — invoices, transfers, customers and the audit trail</span>
                                @if (SettingMeta(SettingKeys.PageSize) is string pageSizeMeta)
                                {
                                    <span class="stg-row-meta"><i class="ph ph-pencil-simple"></i>@pageSizeMeta</span>
                                }
                            </div>
                            <div class="stg-row-control">
                                @if (IsDirty(SettingKeys.PageSize))
                                {
                                    <button type="button" class="stg-btn stg-btn-ghost stg-btn-icon" title="Revert"
                                            @onclick="() => Revert(SettingKeys.PageSize)">
                                        <i class="ph ph-arrow-counter-clockwise"></i>
                                    </button>
                                }
                                <input type="number" min="5" max="200" class="stg-input" value="@GetValue(SettingKeys.PageSize)"
                                       @onchange="e => OnIntSettingChanged(SettingKeys.PageSize, e, 5, 200)" />
                            </div>
                        </div>

                        <!-- Prices with tax -->
                        <div class="stg-row">
                            <div class="stg-row-info">
                                <div class="stg-row-label">
                                    <span>Show Prices With VAT</span>
                                    @if (IsDirty(SettingKeys.ShowPricesWithTax))
                                    {
                                        <span class="stg-tag">edited</span>
                                    }
                                </div>
                                <span class="stg-row-desc">
                                    On the Create Invoice screen, quote line prices and totals VAT-inclusive and move the
                                    excluding figure to the secondary line. Quotations, sales orders and credit notes
                                    always show excluding.
                                </span>
                                @if (SettingMeta(SettingKeys.ShowPricesWithTax) is string taxMeta)
                                {
                                    <span class="stg-row-meta"><i class="ph ph-pencil-simple"></i>@taxMeta</span>
                                }
                            </div>
                            <div class="stg-row-control">
                                @if (IsDirty(SettingKeys.ShowPricesWithTax))
                                {
                                    <button type="button" class="stg-btn stg-btn-ghost stg-btn-icon" title="Revert"
                                            @onclick="() => Revert(SettingKeys.ShowPricesWithTax)">
                                        <i class="ph ph-arrow-counter-clockwise"></i>
                                    </button>
                                }
                                <label class="stg-switch">
                                    <input type="checkbox" checked="@GetBoolValue(SettingKeys.ShowPricesWithTax)"
                                           @onchange="e => OnBoolSettingChanged(SettingKeys.ShowPricesWithTax, e)" />
                                    <span class="stg-switch-track"></span>
                                    <span class="stg-switch-text">@(GetBoolValue(SettingKeys.ShowPricesWithTax) ? "Incl." : "Excl.")</span>
                                </label>
                            </div>
                        </div>

                        <div class="stg-footnote">
                            <i class="ph ph-info"></i>
                            <span>Light and dark theme is a per-browser choice — use the toggle in the top bar.</span>
                        </div>
                    </section>
                }

                @* ── API ─────────────────────────────────────────────── *@
                else if (selectedCategory == SettingCategories.API)
                {
                    <section class="stg-card">
                        <div class="stg-section-head">
                            <span class="stg-section-icon"><i class="ph ph-plugs"></i></span>
                            <div class="stg-section-text">
                                <h2>API</h2>
                                <p>How long the web app trusts its cached copy of SAP master data.</p>
                            </div>
                        </div>

                        <div class="stg-row">
                            <div class="stg-row-info">
                                <div class="stg-row-label">
                                    <span>Cache Duration</span>
                                    @if (IsDirty(SettingKeys.CacheDurationMinutes))
                                    {
                                        <span class="stg-tag">edited</span>
                                    }
                                </div>
                                <span class="stg-row-desc">Minutes before price lists and master data are re-read from the API. Data Sync overrides this on demand.</span>
                                @if (SettingMeta(SettingKeys.CacheDurationMinutes) is string cacheMeta)
                                {
                                    <span class="stg-row-meta"><i class="ph ph-pencil-simple"></i>@cacheMeta</span>
                                }
                            </div>
                            <div class="stg-row-control">
                                @if (IsDirty(SettingKeys.CacheDurationMinutes))
                                {
                                    <button type="button" class="stg-btn stg-btn-ghost stg-btn-icon" title="Revert"
                                            @onclick="() => Revert(SettingKeys.CacheDurationMinutes)">
                                        <i class="ph ph-arrow-counter-clockwise"></i>
                                    </button>
                                }
                                <input type="number" min="1" max="1440" class="stg-input"
                                       value="@GetValue(SettingKeys.CacheDurationMinutes)"
                                       @onchange="e => OnIntSettingChanged(SettingKeys.CacheDurationMinutes, e, 1, 1440)" />
                            </div>
                        </div>

                        <div class="stg-footnote">
                            <i class="ph ph-info"></i>
                            <span>The API address itself is deployment configuration, not a setting — it comes from appsettings.</span>
                        </div>
                    </section>
                }

                @* ── Printing ────────────────────────────────────────── *@
                else if (selectedCategory == SettingCategories.Printing)
                {
                    <section class="stg-card">
                        <div class="stg-section-head">
                            <span class="stg-section-icon"><i class="ph ph-printer"></i></span>
                            <div class="stg-section-text">
                                <h2>Printing</h2>
                                <p>What happens after an invoice is created, and what the print dialog starts from.</p>
                            </div>
                        </div>

                        @if (!string.IsNullOrWhiteSpace(printingMessage))
                        {
                            <div class="stg-alert @(printingMessageSuccess ? "stg-alert-success" : "stg-alert-error")">
                                <i class="ph @(printingMessageSuccess ? "ph-check-circle" : "ph-warning-circle")"></i>
                                <span>@printingMessage</span>
                                <button type="button" class="stg-alert-close" @onclick="() => printingMessage = null"><i class="ph ph-x"></i></button>
                            </div>
                        }

                        <!-- Auto print -->
                        <div class="stg-row">
                            <div class="stg-row-info">
                                <div class="stg-row-label">
                                    <span>Auto Print Invoice</span>
                                    @if (IsDirty(SettingKeys.AutoPrintInvoice))
                                    {
                                        <span class="stg-tag">edited</span>
                                    }
                                </div>
                                <span class="stg-row-desc">Open the invoice PDF print flow automatically after a successful invoice</span>
                                @if (SettingMeta(SettingKeys.AutoPrintInvoice) is string autoPrintMeta)
                                {
                                    <span class="stg-row-meta"><i class="ph ph-pencil-simple"></i>@autoPrintMeta</span>
                                }
                            </div>
                            <div class="stg-row-control">
                                @if (IsDirty(SettingKeys.AutoPrintInvoice))
                                {
                                    <button type="button" class="stg-btn stg-btn-ghost stg-btn-icon" title="Revert"
                                            @onclick="() => Revert(SettingKeys.AutoPrintInvoice)">
                                        <i class="ph ph-arrow-counter-clockwise"></i>
                                    </button>
                                }
                                <label class="stg-switch">
                                    <input type="checkbox" checked="@GetBoolValue(SettingKeys.AutoPrintInvoice)"
                                           @onchange="e => OnBoolSettingChanged(SettingKeys.AutoPrintInvoice, e)" />
                                    <span class="stg-switch-track"></span>
                                    <span class="stg-switch-text">@(GetBoolValue(SettingKeys.AutoPrintInvoice) ? "On" : "Off")</span>
                                </label>
                            </div>
                        </div>

                        <!-- Copies -->
                        <div class="stg-row">
                            <div class="stg-row-info">
                                <div class="stg-row-label">
                                    <span>Print Copies</span>
                                    @if (IsDirty(SettingKeys.PrintCopies))
                                    {
                                        <span class="stg-tag">edited</span>
                                    }
                                </div>
                                <span class="stg-row-desc">
                                    The copy count shown to the cashier in the print dialog. Browsers do not let a page set
                                    copies on a job, so this is a prompt rather than an instruction.
                                </span>
                                @if (SettingMeta(SettingKeys.PrintCopies) is string copiesMeta)
                                {
                                    <span class="stg-row-meta"><i class="ph ph-pencil-simple"></i>@copiesMeta</span>
                                }
                            </div>
                            <div class="stg-row-control">
                                @if (IsDirty(SettingKeys.PrintCopies))
                                {
                                    <button type="button" class="stg-btn stg-btn-ghost stg-btn-icon" title="Revert"
                                            @onclick="() => Revert(SettingKeys.PrintCopies)">
                                        <i class="ph ph-arrow-counter-clockwise"></i>
                                    </button>
                                }
                                <input type="number" min="1" max="10" class="stg-input" value="@GetPrintCopies()"
                                       @onchange="e => OnIntSettingChanged(SettingKeys.PrintCopies, e, 1, 10)" />
                            </div>
                        </div>

                        <!-- Test output -->
                        <div class="stg-panel">
                            <div class="stg-panel-head">
                                <div>
                                    <h3>Test output</h3>
                                    <p>Send a clean test page through the same browser print path invoices and reports use.</p>
                                </div>
                                <div class="stg-panel-head-aside">
                                    <button type="button" class="stg-btn stg-btn-primary" @onclick="PrintSettingsTestPage"
                                            disabled="@isTestingPrinter">
                                        @if (isTestingPrinter)
                                        {
                                            <span class="stg-spin"></span>
                                        }
                                        else
                                        {
                                            <i class="ph ph-printer"></i>
                                        }
                                        Test print
                                    </button>
                                </div>
                            </div>
                        </div>

                        <div class="stg-footnote">
                            <i class="ph ph-info"></i>
                            <span>
                                Which printer a job goes to is chosen by each operator in their own browser's print dialog —
                                a web page cannot route to a named device, so there is no printer to configure here.
                            </span>
                        </div>
                    </section>
                }

                @* ── Payments ────────────────────────────────────────── *@
                else if (selectedCategory == PaymentsCategory)
                {
                    <section class="stg-card">
                        <div class="stg-section-head">
                            <span class="stg-section-icon"><i class="ph ph-credit-card"></i></span>
                            <div class="stg-section-text">
                                <h2>Payments</h2>
                                <p>Posting account, method and the customers cashiers may take payment from.</p>
                            </div>
                        </div>

                        <!-- G/L account -->
                        <div class="stg-row">
                            <div class="stg-row-info">
                                <div class="stg-row-label"><span>Incoming Payment G/L Account</span></div>
                                <span class="stg-row-desc">
                                    Pick a <strong>cash or bank</strong> account for posting incoming payments — not expense,
                                    revenue or controlling accounts. Saved as soon as you pick it.
                                </span>
                                @if (!string.IsNullOrEmpty(paymentGLAccount))
                                {
                                    <span class="stg-row-meta"><i class="ph ph-check"></i>Posting to @paymentGLAccount</span>
                                }
                            </div>
                            <div class="stg-row-control">
                                <div class="stg-combo" @onfocusout="() => glOpen = false">
                                    <i class="ph ph-magnifying-glass stg-combo-icon"></i>
                                    <input class="stg-input" placeholder="Search G/L account" value="@GLAccountText"
                                           @oninput="e => { glQuery = e.Value?.ToString() ?? string.Empty; glOpen = true; }"
                                           @onfocus="() => glOpen = true" />
                                    @if (glOpen)
                                    {
                                        var glMatches = FilterGLAccounts();
                                        <div class="stg-combo-menu">
                                            @foreach (var gl in glMatches)
                                            {
                                                <button type="button" class="stg-combo-item"
                                                        @onmousedown="() => PickGLAccount(gl)">
                                                    <i class="ph ph-currency-dollar"></i>
                                                    <span class="stg-combo-code">@gl.Code</span>
                                                    <span class="stg-combo-name">@gl.Name</span>
                                                </button>
                                            }
                                            @if (glMatches.Count == 0)
                                            {
                                                <div class="stg-combo-empty">
                                                    @(cachedGLAccounts.Count == 0
                                                        ? "No G/L accounts cached — sync them from Data Sync first."
                                                        : "No G/L account matches that search")
                                                </div>
                                            }
                                        </div>
                                    }
                                </div>
                            </div>
                        </div>

                        <!-- Payment method -->
                        <div class="stg-row">
                            <div class="stg-row-info">
                                <div class="stg-row-label"><span>Default Payment Method</span></div>
                                <span class="stg-row-desc">The method pre-selected on a new incoming payment; cashiers can switch to another. Saved as soon as you pick it.</span>
                            </div>
                            <div class="stg-row-control">
                                <div class="stg-select-wrap">
                                    <select class="stg-input stg-select" value="@defaultPaymentMethod"
                                            @onchange="OnDefaultPaymentMethodChanged">
                                        <option value="cash">Cash</option>
                                        <option value="transfer">Transfer</option>
                                        <option value="check">Check</option>
                                        <option value="credit">Credit card</option>
                                    </select>
                                    <i class="ph ph-caret-down stg-select-caret"></i>
                                </div>
                            </div>
                        </div>
                    </section>
                }

                @* ── SAP Connection ──────────────────────────────────── *@
                else if (selectedCategory == SAPCategory)
                {
                    <section class="stg-card">
                        <div class="stg-section-head">
                            <span class="stg-section-icon"><i class="ph ph-cloud-arrow-up"></i></span>
                            <div class="stg-section-text">
                                <h2>SAP Connection</h2>
                                <p>Endpoint, company database and the service user the app posts with.</p>
                            </div>
                        </div>

                        @if (isLoadingSAPSettings)
                        {
                            <div class="stg-pane-loading"><span class="stg-spin"></span><span>Loading SAP settings…</span></div>
                        }
                        else
                        {
                            @if (sapConnectionTested)
                            {
                                <div class="stg-alert @(sapConnectionSuccess ? "stg-alert-success" : "stg-alert-error")">
                                    <i class="ph @(sapConnectionSuccess ? "ph-check-circle" : "ph-warning-circle")"></i>
                                    <span>@sapConnectionMessage</span>
                                    <button type="button" class="stg-alert-close" @onclick="() => sapConnectionTested = false"><i class="ph ph-x"></i></button>
                                </div>
                            }

                            <div class="stg-row">
                                <div class="stg-row-info">
                                    <div class="stg-row-label"><span>Service Layer URL</span></div>
                                    <span class="stg-row-desc">Base URL of the SAP Business One Service Layer</span>
                                </div>
                                <div class="stg-row-control">
                                    <input class="stg-input" placeholder="https://server:50000/b1s/v1/" @bind="sapServiceLayerUrl" />
                                </div>
                            </div>

                            <div class="stg-row">
                                <div class="stg-row-info">
                                    <div class="stg-row-label"><span>Company Database</span></div>
                                    <span class="stg-row-desc">The SAP Business One company database name</span>
                                </div>
                                <div class="stg-row-control">
                                    <input class="stg-input" placeholder="COMPANY_DB" @bind="sapCompanyDB" />
                                </div>
                            </div>

                            <div class="stg-row">
                                <div class="stg-row-info">
                                    <div class="stg-row-label"><span>A/R Invoice Series</span></div>
                                    <span class="stg-row-desc">Numbering series name used for A/R invoices in this company database</span>
                                </div>
                                <div class="stg-row-control">
                                    <input class="stg-input" placeholder="New1" @bind="sapInvoiceSeriesName" />
                                </div>
                            </div>

                            <div class="stg-row">
                                <div class="stg-row-info">
                                    <div class="stg-row-label"><span>Username</span></div>
                                    <span class="stg-row-desc">SAP Business One service user account</span>
                                </div>
                                <div class="stg-row-control">
                                    <input class="stg-input" placeholder="manager" @bind="sapUsername" />
                                </div>
                            </div>

                            <div class="stg-row">
                                <div class="stg-row-info">
                                    <div class="stg-row-label"><span>Password</span></div>
                                    <span class="stg-row-desc">Leave blank to keep the current password</span>
                                </div>
                                <div class="stg-row-control">
                                    <input class="stg-input" placeholder="Enter new password" @bind="sapPassword"
                                           type="@(showSAPPassword ? "text" : "password")" />
                                    <button type="button" class="stg-btn stg-btn-ghost stg-btn-icon"
                                            title="@(showSAPPassword ? "Hide password" : "Show password")"
                                            @onclick="() => showSAPPassword = !showSAPPassword">
                                        <i class="ph @(showSAPPassword ? "ph-eye-slash" : "ph-eye")"></i>
                                    </button>
                                </div>
                            </div>

                            <div class="stg-row">
                                <div class="stg-row-info">
                                    <div class="stg-row-label"><span>Connection Test</span></div>
                                    <span class="stg-row-desc">Verify the credentials against the Service Layer before they are stored</span>
                                </div>
                                <div class="stg-row-control">
                                    <label class="stg-switch">
                                        <input type="checkbox" @bind="sapTestOnSave" />
                                        <span class="stg-switch-track"></span>
                                        <span class="stg-switch-text">Test on save</span>
                                    </label>
                                </div>
                            </div>

                            <div class="stg-dialog-actions">
                                <button type="button" class="stg-btn stg-btn-secondary" @onclick="TestSAPConnection"
                                        disabled="@isSAPTesting">
                                    @if (isSAPTesting)
                                    {
                                        <span class="stg-spin"></span>
                                    }
                                    else
                                    {
                                        <i class="ph ph-plugs-connected"></i>
                                    }
                                    Test connection
                                </button>
                                <button type="button" class="stg-btn stg-btn-primary" @onclick="SaveSAPSettings"
                                        disabled="@(isSAPSaving || string.IsNullOrWhiteSpace(sapServiceLayerUrl) || string.IsNullOrWhiteSpace(sapCompanyDB) || string.IsNullOrWhiteSpace(sapUsername))">
                                    @if (isSAPSaving)
                                    {
                                        <span class="stg-spin"></span>
                                    }
                                    else
                                    {
                                        <i class="ph ph-floppy-disk"></i>
                                    }
                                    Save SAP settings
                                </button>
                            </div>
                        }
                    </section>
                }

                @* ── Mobile App ──────────────────────────────────────── *@
                else if (selectedCategory == MobileAppCategory)
                {
                    <section class="stg-card">
                        <div class="stg-section-head">
                            <span class="stg-section-icon"><i class="ph ph-device-mobile"></i></span>
                            <div class="stg-section-text">
                                <h2>Mobile App</h2>
                                <p>Minimum supported Android version, upgrade guidance and store link per app.</p>
                            </div>
                        </div>

                        @if (isLoadingMobileVersionPolicy)
                        {
                            <div class="stg-pane-loading"><span class="stg-spin"></span><span>Loading mobile app policy…</span></div>
                        }
                        else
                        {
                            @if (!string.IsNullOrWhiteSpace(mobileVersionPolicyMessage))
                            {
                                <div class="stg-alert @(mobileVersionPolicySaveSucceeded ? "stg-alert-success" : "stg-alert-error")">
                                    <i class="ph @(mobileVersionPolicySaveSucceeded ? "ph-check-circle" : "ph-warning-circle")"></i>
                                    <span>@mobileVersionPolicyMessage</span>
                                    <button type="button" class="stg-alert-close" @onclick="() => mobileVersionPolicyMessage = null"><i class="ph ph-x"></i></button>
                                </div>
                            }

                            <div class="stg-alert stg-alert-warn">
                                <i class="ph ph-info"></i>
                                <span>
                                    Keep the order <strong>minimum ≤ recommended ≤ latest</strong>. Leave recommended or
                                    minimum blank to fall back to the next higher version.
                                </span>
                            </div>

                            <div class="stg-row">
                                <div class="stg-row-info">
                                    <div class="stg-row-label"><span>Target Mobile App</span></div>
                                    <span class="stg-row-desc">Which connected app's version policy you are editing</span>
                                </div>
                                <div class="stg-row-control">
                                    <div class="stg-select-wrap">
                                        <select class="stg-input stg-select" value="@selectedMobileVersionPolicyAppId"
                                                @onchange="e => OnMobileVersionPolicyAppChanged(e.Value?.ToString() ?? selectedMobileVersionPolicyAppId)">
                                            @foreach (var mobileApp in mobileVersionPolicyApps)
                                            {
                                                <option value="@mobileApp.Key">@mobileApp.Value</option>
                                            }
                                        </select>
                                        <i class="ph ph-caret-down stg-select-caret"></i>
                                    </div>
                                </div>
                            </div>

                            <div class="stg-row">
                                <div class="stg-row-info">
                                    <div class="stg-row-label"><span>Version Policy Enabled</span></div>
                                    <span class="stg-row-desc">Turn Android version enforcement on or off without redeploying the API</span>
                                </div>
                                <div class="stg-row-control">
                                    <label class="stg-switch">
                                        <input type="checkbox" @bind="mobileVersionPolicyEnabled" />
                                        <span class="stg-switch-track"></span>
                                        <span class="stg-switch-text">@(mobileVersionPolicyEnabled ? "On" : "Off")</span>
                                    </label>
                                </div>
                            </div>

                            <div class="stg-row">
                                <div class="stg-row-info">
                                    <div class="stg-row-label"><span>Require Version Headers</span></div>
                                    <span class="stg-row-desc">Require Android requests to carry <strong>X-App-Platform</strong> and <strong>X-App-Version</strong></span>
                                </div>
                                <div class="stg-row-control">
                                    <label class="stg-switch">
                                        <input type="checkbox" @bind="mobileVersionPolicyRequireHeaders" />
                                        <span class="stg-switch-track"></span>
                                        <span class="stg-switch-text">@(mobileVersionPolicyRequireHeaders ? "On" : "Off")</span>
                                    </label>
                                </div>
                            </div>

                            <div class="stg-row">
                                <div class="stg-row-info">
                                    <div class="stg-row-label"><span>Latest Version</span></div>
                                    <span class="stg-row-desc">The current Android release, and the upper version bound</span>
                                </div>
                                <div class="stg-row-control">
                                    <input class="stg-input" placeholder="1.0.2" @bind="mobileVersionPolicyLatestVersion" />
                                </div>
                            </div>

                            <div class="stg-row">
                                <div class="stg-row-info">
                                    <div class="stg-row-label"><span>Recommended Version</span></div>
                                    <span class="stg-row-desc">Builds below this are warned but can still continue</span>
                                </div>
                                <div class="stg-row-control">
                                    <input class="stg-input" placeholder="1.0.2" @bind="mobileVersionPolicyRecommendedVersion" />
                                </div>
                            </div>

                            <div class="stg-row">
                                <div class="stg-row-info">
                                    <div class="stg-row-label"><span>Minimum Supported Version</span></div>
                                    <span class="stg-row-desc">Builds below this are blocked until the user upgrades</span>
                                </div>
                                <div class="stg-row-control">
                                    <input class="stg-input" placeholder="1.0.1" @bind="mobileVersionPolicyMinimumSupportedVersion" />
                                </div>
                            </div>

                            <div class="stg-row">
                                <div class="stg-row-info">
                                    <div class="stg-row-label"><span>Google Play URL</span></div>
                                    <span class="stg-row-desc">Store link the app opens when users choose to update</span>
                                </div>
                                <div class="stg-row-control">
                                    <input class="stg-input" placeholder="https://play.google.com/store/apps/details?id=…"
                                           @bind="mobileVersionPolicyGooglePlayUrl" />
                                </div>
                            </div>

                            <div class="stg-row stg-row-top">
                                <div class="stg-row-info">
                                    <div class="stg-row-label"><span>Release Notes</span></div>
                                    <span class="stg-row-desc">Optional notes shown when a newer version is available</span>
                                </div>
                                <div class="stg-row-control">
                                    <textarea class="stg-input" rows="3" @bind="mobileVersionPolicyReleaseNotes"></textarea>
                                </div>
                            </div>

                            <div class="stg-row stg-row-top">
                                <div class="stg-row-info">
                                    <div class="stg-row-label"><span>Warn Message</span></div>
                                    <span class="stg-row-desc">Optional message for a build that is outdated but still usable</span>
                                </div>
                                <div class="stg-row-control">
                                    <textarea class="stg-input" rows="3" @bind="mobileVersionPolicyWarnMessage"></textarea>
                                </div>
                            </div>

                            <div class="stg-row stg-row-top">
                                <div class="stg-row-info">
                                    <div class="stg-row-label"><span>Block Message</span></div>
                                    <span class="stg-row-desc">Optional message for a build below the minimum supported version</span>
                                </div>
                                <div class="stg-row-control">
                                    <textarea class="stg-input" rows="3" @bind="mobileVersionPolicyBlockMessage"></textarea>
                                </div>
                            </div>

                            <div class="stg-dialog-actions">
                                <button type="button" class="stg-btn stg-btn-primary" @onclick="SaveMobileVersionPolicySettings"
                                        disabled="@(!CanSaveMobileVersionPolicy)">
                                    @if (isSavingMobileVersionPolicy)
                                    {
                                        <span class="stg-spin"></span>
                                    }
                                    else
                                    {
                                        <i class="ph ph-floppy-disk"></i>
                                    }
                                    Save @SelectedMobileVersionPolicyAppName policy
                                </button>
                            </div>
                        }
                    </section>
                }

                @* ── Email Reports ───────────────────────────────────── *@
                else if (selectedCategory == SettingCategories.EmailReports)
                {
                    <section class="stg-card">
                        <div class="stg-section-head">
                            <span class="stg-section-icon"><i class="ph ph-envelope-simple"></i></span>
                            <div class="stg-section-text">
                                <h2>Email Reports</h2>
                                <p>POD report schedules — each with its own frequency and recipients, delivered as Excel attachments.</p>
                            </div>
                            <div class="stg-section-head-action">
                                <button type="button" class="stg-btn stg-btn-primary" @onclick="OpenNewSchedule">
                                    <i class="ph ph-plus"></i>Add schedule
                                </button>
                            </div>
                        </div>

                        @if (!string.IsNullOrWhiteSpace(podEmailMessage))
                        {
                            <div class="stg-alert @(podEmailMessageSuccess ? "stg-alert-success" : "stg-alert-error")">
                                <i class="ph @(podEmailMessageSuccess ? "ph-check-circle" : "ph-warning-circle")"></i>
                                <span>@podEmailMessage</span>
                                <button type="button" class="stg-alert-close" @onclick="() => podEmailMessage = null"><i class="ph ph-x"></i></button>
                            </div>
                        }

                        <div class="stg-stats">
                            <div class="stg-stat"><span>Schedules</span><strong>@podSchedules.Count</strong></div>
                            <div class="stg-stat"><span>Active</span><strong>@podSchedules.Count(s => s.Enabled)</strong></div>
                            <div class="stg-stat"><span>Recipients</span><strong>@TotalScheduleRecipientCount()</strong></div>
                            <div class="stg-stat">
                                <span>Automation</span>
                                <strong>@(GetBoolValue(SettingKeys.PodReportEmailsEnabled) ? "On" : "Paused")</strong>
                            </div>
                        </div>

                        <div class="stg-row">
                            <div class="stg-row-info">
                                <div class="stg-row-label"><span>Scheduled Sending</span></div>
                                <span class="stg-row-desc">
                                    Master switch for automatic delivery. When off, schedules are kept but nothing is sent on a
                                    schedule — “Send now” still works. Saved as soon as you toggle it.
                                </span>
                                @if (SettingMeta(SettingKeys.PodReportEmailsEnabled) is string podMeta)
                                {
                                    <span class="stg-row-meta"><i class="ph ph-pencil-simple"></i>@podMeta</span>
                                }
                            </div>
                            <div class="stg-row-control">
                                <label class="stg-switch">
                                    <input type="checkbox" checked="@GetBoolValue(SettingKeys.PodReportEmailsEnabled)"
                                           disabled="@isSavingPodAutomation"
                                           @onchange="OnPodScheduledSendingChangedAsync" />
                                    <span class="stg-switch-track"></span>
                                    <span class="stg-switch-text">@(GetBoolValue(SettingKeys.PodReportEmailsEnabled) ? "On" : "Off")</span>
                                </label>
                            </div>
                        </div>

                        @if (!GetBoolValue(SettingKeys.PodReportEmailsEnabled))
                        {
                            <div class="stg-footnote">
                                <i class="ph ph-pause-circle"></i>
                                <span>Automatic sending is paused. Turn <strong>Scheduled Sending</strong> back on to resume deliveries.</span>
                            </div>
                        }

                        @if (podSchedules.Count == 0)
                        {
                            <div class="stg-sync-grid" style="grid-template-columns: 1fr">
                                <div class="stg-empty" style="flex-direction:column; text-align:center; gap:var(--stg-space-3); padding:var(--stg-space-8)">
                                    <i class="ph ph-envelope-simple" style="font-size:22px"></i>
                                    <span>No schedules yet — add one to start delivering POD reports to a group of recipients.</span>
                                    <button type="button" class="stg-btn stg-btn-primary" @onclick="OpenNewSchedule">
                                        <i class="ph ph-plus"></i>Add your first schedule
                                    </button>
                                </div>
                            </div>
                        }
                        else
                        {
                            <div class="stg-sched-grid">
                                @foreach (var schedule in podSchedules)
                                {
                                    var sending = sendingScheduleIds.Contains(schedule.Id);
                                    <div class="stg-sched-card @(schedule.Enabled ? "" : "stg-sched-card-off")">
                                        <div class="stg-sched-top">
                                            <div class="stg-sched-top-text">
                                                <span class="stg-tag stg-tag-neutral">@GetScheduleFrequencyLabel(schedule)</span>
                                                <h3>@(string.IsNullOrWhiteSpace(schedule.Name) ? "Untitled schedule" : schedule.Name)</h3>
                                            </div>
                                            <label class="stg-switch" title="@(schedule.Enabled ? "Enabled" : "Disabled")">
                                                <input type="checkbox" checked="@schedule.Enabled"
                                                       @onchange="() => ToggleScheduleEnabledAsync(schedule)" />
                                                <span class="stg-switch-track"></span>
                                            </label>
                                        </div>

                                        <div class="stg-sched-meta">
                                            <div><i class="ph ph-clock"></i><span>@GetScheduleCadenceLabel(schedule)</span></div>
                                            <div><i class="ph ph-calendar-blank"></i><span>Next: @FormatScheduleNextSend(schedule)</span></div>
                                            <div><i class="ph ph-users"></i><span>@ScheduleRecipientSummary(schedule)</span></div>
                                            <div><i class="ph ph-clock-counter-clockwise"></i><span>Last sent: @FormatScheduleLastSent(schedule)</span></div>
                                        </div>

                                        <div class="stg-sched-actions">
                                            @if (confirmingDeleteId == schedule.Id)
                                            {
                                                <span class="stg-sched-confirm">Delete this schedule?</span>
                                                <button type="button" class="stg-btn stg-btn-danger stg-btn-sm"
                                                        @onclick="() => DeleteScheduleAsync(schedule.Id)">Delete</button>
                                                <button type="button" class="stg-btn stg-btn-secondary stg-btn-sm"
                                                        @onclick="() => confirmingDeleteId = null">Cancel</button>
                                            }
                                            else
                                            {
                                                <button type="button" class="stg-btn stg-btn-secondary stg-btn-sm"
                                                        @onclick="() => OpenEditSchedule(schedule)">
                                                    <i class="ph ph-pencil-simple"></i>Edit
                                                </button>
                                                <button type="button" class="stg-btn stg-btn-primary stg-btn-sm"
                                                        @onclick="() => SendScheduleNowAsync(schedule)" disabled="@sending">
                                                    @if (sending)
                                                    {
                                                        <span class="stg-spin"></span>
                                                        <span>Sending…</span>
                                                    }
                                                    else
                                                    {
                                                        <i class="ph ph-paper-plane-tilt"></i>
                                                        <span>Send now</span>
                                                    }
                                                </button>
                                                <button type="button" class="stg-btn stg-btn-secondary stg-btn-icon"
                                                        style="margin-left:auto" title="Delete schedule"
                                                        @onclick="() => confirmingDeleteId = schedule.Id">
                                                    <i class="ph ph-trash"></i>
                                                </button>
                                            }
                                        </div>
                                    </div>
                                }
                            </div>
                        }
                    </section>
                }

                @* ── Data Sync ───────────────────────────────────────── *@
                else if (selectedCategory == DataManagementCategory)
                {
                    <section class="stg-card">
                        <div class="stg-section-head">
                            <span class="stg-section-icon"><i class="ph ph-arrows-clockwise"></i></span>
                            <div class="stg-section-text">
                                <h2>Data Sync</h2>
                                <p>Refresh cached master data from SAP. Use when something changed in the source system.</p>
                            </div>
                        </div>

                        @if (!string.IsNullOrEmpty(refreshMessage))
                        {
                            <div class="stg-alert @(refreshSuccess ? "stg-alert-success" : "stg-alert-error")">
                                <i class="ph @(refreshSuccess ? "ph-check-circle" : "ph-warning-circle")"></i>
                                <span>@refreshMessage</span>
                                <button type="button" class="stg-alert-close" @onclick="() => refreshMessage = null"><i class="ph ph-x"></i></button>
                            </div>
                        }

                        <div class="stg-sync-grid">
                            <div class="stg-sync-card">
                                <span class="stg-sync-icon"><i class="ph ph-package"></i></span>
                                <div class="stg-sync-body">
                                    <h3>Products</h3>
                                    <span>@FormatLastSync(productsLastSync)</span>
                                </div>
                                <button type="button" class="stg-btn stg-btn-secondary stg-btn-icon" title="Sync products"
                                        @onclick="RefreshProducts" disabled="@isRefreshingProducts">
                                    @if (isRefreshingProducts)
                                    {
                                        <span class="stg-spin"></span>
                                    }
                                    else
                                    {
                                        <i class="ph ph-arrows-clockwise"></i>
                                    }
                                </button>
                            </div>

                            <div class="stg-sync-card">
                                <span class="stg-sync-icon"><i class="ph ph-tag"></i></span>
                                <div class="stg-sync-body">
                                    <h3>Prices</h3>
                                    <span>@FormatLastSync(pricesLastSync)</span>
                                </div>
                                <button type="button" class="stg-btn stg-btn-secondary stg-btn-icon" title="Sync prices"
                                        @onclick="RefreshPrices" disabled="@isRefreshingPrices">
                                    @if (isRefreshingPrices)
                                    {
                                        <span class="stg-spin"></span>
                                    }
                                    else
                                    {
                                        <i class="ph ph-arrows-clockwise"></i>
                                    }
                                </button>
                            </div>

                            <div class="stg-sync-card">
                                <span class="stg-sync-icon"><i class="ph ph-users"></i></span>
                                <div class="stg-sync-body">
                                    <h3>Business Partners</h3>
                                    <span>@FormatLastSync(bpLastSync)</span>
                                </div>
                                <button type="button" class="stg-btn stg-btn-secondary stg-btn-icon" title="Sync business partners"
                                        @onclick="RefreshBusinessPartners" disabled="@isRefreshingBP">
                                    @if (isRefreshingBP)
                                    {
                                        <span class="stg-spin"></span>
                                    }
                                    else
                                    {
                                        <i class="ph ph-arrows-clockwise"></i>
                                    }
                                </button>
                            </div>

                            <div class="stg-sync-card">
                                <span class="stg-sync-icon"><i class="ph ph-buildings"></i></span>
                                <div class="stg-sync-body">
                                    <h3>Warehouses</h3>
                                    <span>@FormatLastSync(warehousesLastSync)</span>
                                </div>
                                <button type="button" class="stg-btn stg-btn-secondary stg-btn-icon" title="Sync warehouses"
                                        @onclick="RefreshWarehouses" disabled="@isRefreshingWarehouses">
                                    @if (isRefreshingWarehouses)
                                    {
                                        <span class="stg-spin"></span>
                                    }
                                    else
                                    {
                                        <i class="ph ph-arrows-clockwise"></i>
                                    }
                                </button>
                            </div>

                            <div class="stg-sync-card">
                                <span class="stg-sync-icon"><i class="ph ph-tree-structure"></i></span>
                                <div class="stg-sync-body">
                                    <h3>Cost Centres</h3>
                                    <span>@FormatLastSync(costCentresLastSync)</span>
                                </div>
                                <button type="button" class="stg-btn stg-btn-secondary stg-btn-icon" title="Sync cost centres"
                                        @onclick="RefreshCostCentres" disabled="@isRefreshingCostCentres">
                                    @if (isRefreshingCostCentres)
                                    {
                                        <span class="stg-spin"></span>
                                    }
                                    else
                                    {
                                        <i class="ph ph-arrows-clockwise"></i>
                                    }
                                </button>
                            </div>

                            <div class="stg-sync-card stg-sync-card-all">
                                <span class="stg-sync-icon"><i class="ph ph-arrows-clockwise"></i></span>
                                <div class="stg-sync-body">
                                    <h3>Sync everything</h3>
                                    <span>All master data in one pass</span>
                                </div>
                                <button type="button" class="stg-btn stg-btn-primary stg-btn-icon" title="Sync everything"
                                        @onclick="RefreshAllData" disabled="@isRefreshingAll">
                                    @if (isRefreshingAll)
                                    {
                                        <span class="stg-spin"></span>
                                    }
                                    else
                                    {
                                        <i class="ph ph-arrows-clockwise"></i>
                                    }
                                </button>
                            </div>
                        </div>

                        <div class="stg-footnote">
                            <i class="ph ph-info"></i>
                            <span>Syncing is manual — nothing runs these on a timer. The API is the source; the web cache follows it.</span>
                        </div>
                    </section>
                }

                @* ── Danger Zone ─────────────────────────────────────── *@
                else if (selectedCategory == DangerZoneCategory)
                {
                    <section class="stg-card">
                        <div class="stg-section-head">
                            <span class="stg-section-icon stg-section-icon-danger"><i class="ph ph-warning"></i></span>
                            <div class="stg-section-text">
                                <h2>Danger Zone</h2>
                                <p>Irreversible operations on company data. Proceed with extreme caution.</p>
                            </div>
                        </div>

                        @if (!string.IsNullOrEmpty(resetMessage))
                        {
                            <div class="stg-alert @(resetSuccess ? "stg-alert-success" : "stg-alert-error")">
                                <i class="ph @(resetSuccess ? "ph-check-circle" : "ph-warning-circle")"></i>
                                <span>@resetMessage</span>
                                <button type="button" class="stg-alert-close" @onclick="() => resetMessage = null"><i class="ph ph-x"></i></button>
                            </div>
                        }

                        <div class="stg-row stg-row-top">
                            <div class="stg-row-info">
                                <div class="stg-row-label">
                                    <span>Reset Database</span>
                                    <span class="stg-tag stg-tag-danger">irreversible</span>
                                </div>
                                <span class="stg-row-desc">
                                    Permanently deletes every invoice, order, payment, product, transfer and audit log, and
                                    clears the web cache. Admin accounts are preserved. <strong>This cannot be undone</strong> —
                                    take a backup first.
                                </span>
                            </div>
                            <div class="stg-row-control">
                                <button type="button" class="stg-btn stg-btn-danger" @onclick="ShowResetConfirmation"
                                        disabled="@isResettingDatabase">
                                    @if (isResettingDatabase)
                                    {
                                        <span class="stg-spin"></span>
                                        <span>Resetting…</span>
                                    }
                                    else
                                    {
                                        <i class="ph ph-trash"></i>
                                        <span>Reset database</span>
                                    }
                                </button>
                            </div>
                        </div>
                    </section>
                }
            </main>
        </div>
    }

    <!-- ── Save confirmation ──────────────────────────────────────────── -->
    @if (confirmingSave)
    {
        <div class="stg-backdrop" @onclick="() => confirmingSave = false">
            <div class="stg-dialog" style="max-width:380px" @onclick:stopPropagation="true">
                <h3 class="stg-dialog-title">Apply @DirtyCount change@(DirtyCount == 1 ? "" : "s")?</h3>
                <p class="stg-dialog-body">
                    Company defaults are used by every open session. Users may need to reload before they see the new values.
                </p>
                <div class="stg-dialog-actions">
                    <button type="button" class="stg-btn stg-btn-secondary" @onclick="() => confirmingSave = false">Cancel</button>
                    <button type="button" class="stg-btn stg-btn-primary" @onclick="SaveSettings">Apply changes</button>
                </div>
            </div>
        </div>
    }

    <!-- ── Reset database confirmation ────────────────────────────────── -->
    @if (showResetConfirmation)
    {
        <div class="stg-backdrop">
            <div class="stg-dialog">
                <div class="stg-dialog-head">
                    <span class="stg-section-icon stg-section-icon-danger"><i class="ph ph-warning"></i></span>
                    <div class="stg-section-text">
                        <h2 style="font-size:18px">Reset database</h2>
                        <p>Everything below is deleted permanently. Admin accounts survive.</p>
                    </div>
                </div>
                <div class="stg-dialog-body">
                    <ul class="stg-danger-list">
                        <li>All invoices, sales orders and purchase orders</li>
                        <li>All payments and credit notes</li>
                        <li>All products and price lists</li>
                        <li>All inventory transfers and stock reservations</li>
                        <li>All audit logs and notifications</li>
                        <li>All webhooks, templates and system configs</li>
                    </ul>
                </div>
                <div class="stg-field">
                    <label>Type <strong>RESET</strong> to confirm</label>
                    <input class="stg-input" placeholder="RESET" @bind="resetConfirmationText" @bind:event="oninput" />
                </div>
                <div class="stg-dialog-actions">
                    <button type="button" class="stg-btn stg-btn-secondary" @onclick="CancelReset">Cancel</button>
                    <button type="button" class="stg-btn stg-btn-danger" @onclick="ConfirmResetDatabase"
                            disabled="@(resetConfirmationText != "RESET" || isResettingDatabase)">
                        @if (isResettingDatabase)
                        {
                            <span class="stg-spin"></span>
                        }
                        else
                        {
                            <i class="ph ph-trash"></i>
                        }
                        Reset database
                    </button>
                </div>
            </div>
        </div>
    }

    <!-- ── POD schedule editor ────────────────────────────────────────── -->
    @if (showScheduleModal && editingSchedule is not null)
    {
        <div class="stg-backdrop" @onclick="CloseScheduleModal">
            <div class="stg-dialog stg-dialog-wide" @onclick:stopPropagation="true">
                <div class="stg-dialog-head">
                    <div class="stg-section-text">
                        <h2 style="font-size:18px">@(editingSchedule.Id == 0 ? "New POD report schedule" : "Edit schedule")</h2>
                        <p>Reports cover the most recently completed period for the chosen frequency.</p>
                    </div>
                    <button type="button" class="stg-dialog-close" @onclick="CloseScheduleModal"><i class="ph ph-x"></i></button>
                </div>

                <div class="stg-dialog-body">
                    @if (!string.IsNullOrWhiteSpace(scheduleValidationError))
                    {
                        <div class="stg-alert stg-alert-error">
                            <i class="ph ph-warning-circle"></i>
                            <span>@scheduleValidationError</span>
                        </div>
                    }

                    <div class="stg-form-grid">
                        <div class="stg-field stg-form-grid-full">
                            <label>Schedule name <span class="stg-req">*</span></label>
                            <input class="stg-input" maxlength="200" placeholder="e.g. Operations — weekly"
                                   value="@editingSchedule.Name"
                                   @onchange="e => editingSchedule.Name = e.Value?.ToString() ?? string.Empty" />
                        </div>

                        <div class="stg-field">
                            <label>Frequency</label>
                            <div class="stg-select-wrap">
                                <select class="stg-input stg-select" value="@editingSchedule.Frequency"
                                        @onchange="OnScheduleFrequencyChanged">
                                    @foreach (var freq in Enum.GetValues<PodReportEmailFrequency>())
                                    {
                                        <option value="@freq.ToString()">@FrequencyOptionLabel(freq)</option>
                                    }
                                </select>
                                <i class="ph ph-caret-down stg-select-caret"></i>
                            </div>
                        </div>

                        @{
                            var selectedFrequency = PodReportEmailService.ParseFrequency(editingSchedule.Frequency);
                        }
                        @if (selectedFrequency == PodReportEmailFrequency.Weekly)
                        {
                            <div class="stg-field">
                                <label>Day of week</label>
                                <div class="stg-select-wrap">
                                    <select class="stg-input stg-select" value="@(editingSchedule.DayOfWeek ?? (int)DayOfWeek.Monday)"
                                            @onchange="e => editingSchedule.DayOfWeek = ParseIntOrNull(e.Value?.ToString())">
                                        @foreach (var day in Enum.GetValues<DayOfWeek>())
                                        {
                                            <option value="@((int)day)">@day</option>
                                        }
                                    </select>
                                    <i class="ph ph-caret-down stg-select-caret"></i>
                                </div>
                            </div>
                        }
                        else if (IsCalendarPeriodFrequency(selectedFrequency))
                        {
                            <div class="stg-field">
                                <label>Send on day</label>
                                <input type="number" min="1" max="31" class="stg-input"
                                       value="@(editingSchedule.DayOfMonth ?? 1)"
                                       @onchange="e => editingSchedule.DayOfMonth = ParseIntOrNull(e.Value?.ToString())" />
                                <span class="stg-field-hint">The report covers the previous completed calendar period.</span>
                            </div>
                        }
                        else if (selectedFrequency == PodReportEmailFrequency.EveryNDays)
                        {
                            <div class="stg-field">
                                <label>Every N days</label>
                                <input type="number" min="1" max="365" class="stg-input"
                                       value="@(editingSchedule.IntervalDays ?? 1)"
                                       @onchange="e => editingSchedule.IntervalDays = ParseIntOrNull(e.Value?.ToString())" />
                            </div>
                        }

                        <div class="stg-field">
                            <label>Send time (@PodScheduleTime.ZoneAbbreviation)</label>
                            <input type="time" class="stg-input" value="@PodScheduleTime.FormatTime(editingSchedule.SendMinuteOfDay)"
                                   @onchange="OnScheduleTimeChanged" />
                            <span class="stg-field-hint">
                                Local time — sends at @PodScheduleTime.FormatTimeWithZone(editingSchedule.SendMinuteOfDay), to the minute
                            </span>
                        </div>

                        <div class="stg-field">
                            <label>Enabled</label>
                            <label class="stg-switch">
                                <input type="checkbox" checked="@editingSchedule.Enabled"
                                       @onchange="e => editingSchedule.Enabled = (bool)(e.Value ?? false)" />
                                <span class="stg-switch-track"></span>
                                <span class="stg-switch-text">@(editingSchedule.Enabled ? "On" : "Off")</span>
                            </label>
                        </div>

                        <div class="stg-field stg-form-grid-full">
                            <label>To recipients <span class="stg-req">*</span></label>
                            <textarea class="stg-input" rows="2"
                                      placeholder="Name &lt;email@example.com&gt;; or separate addresses with commas or new lines"
                                      value="@editingSchedule.ToRecipients"
                                      @onchange="e => editingSchedule.ToRecipients = e.Value?.ToString() ?? string.Empty"></textarea>
                        </div>

                        <div class="stg-field stg-form-grid-full">
                            <label>Cc recipients</label>
                            <textarea class="stg-input" rows="2" placeholder="Optional copied recipients"
                                      value="@editingSchedule.CcRecipients"
                                      @onchange="e => editingSchedule.CcRecipients = e.Value?.ToString() ?? string.Empty"></textarea>
                        </div>
                    </div>
                </div>

                <div class="stg-dialog-actions">
                    <button type="button" class="stg-btn stg-btn-secondary" @onclick="CloseScheduleModal"
                            disabled="@isSavingSchedule">Cancel</button>
                    <button type="button" class="stg-btn stg-btn-primary" @onclick="SaveScheduleAsync"
                            disabled="@isSavingSchedule">
                        @if (isSavingSchedule)
                        {
                            <span class="stg-spin"></span>
                        }
                        else
                        {
                            <i class="ph ph-check"></i>
                        }
                        Save schedule
                    </button>
                </div>
            </div>
        </div>
    }
</div>

@code {
    private const string DataManagementCategory = "Data Management";
    private const string DangerZoneCategory = "Danger Zone";
    private const string PaymentsCategory = "Payments";
    private const string SAPCategory = "SAP Connection";
    private const string MobileAppCategory = "Mobile App";

    /// <summary>Default send time for a brand-new POD schedule: 06:00 local.</summary>
    private const int DefaultSendMinuteOfDay = 6 * 60;

    private List<AppSetting> allSettings = new();
    private string selectedCategory = SettingCategories.General;
    private Dictionary<string, string> editedValues = new();
    private bool isLoading = true;
    private bool isSaving = false;
    private bool justSaved = false;
    private bool confirmingSave = false;
    private string? successMessage;
    private string? errorMessage;
    private string currentUsername = "Unknown";

    // Payment settings fields
    private string paymentGLAccount = "";
    private string defaultPaymentMethod = "cash";
    private List<CachedGLAccount> cachedGLAccounts = new();
    private bool glOpen;
    private string? glQuery;

    // Warehouse lookup fields
    private List<CachedWarehouse> cachedWarehouses = new();
    private bool whOpen;
    private string? whQuery;

    // Exclude expense and revenue accounts — only cash/bank/other may take a payment.
    private static readonly HashSet<string> _excludedAccountTypes = new(StringComparer.OrdinalIgnoreCase)
    {
        "at_Expenses", "at_Revenues"
    };

    private IEnumerable<CachedGLAccount> paymentEligibleGLAccounts =>
        cachedGLAccounts.Where(gl => string.IsNullOrEmpty(gl.AccountType) || !_excludedAccountTypes.Contains(gl.AccountType));

    // Data Management fields
    private bool isRefreshingProducts = false;
    private bool isRefreshingPrices = false;
    private bool isRefreshingBP = false;
    private bool isRefreshingWarehouses = false;
    private bool isRefreshingCostCentres = false;
    private bool isRefreshingAll = false;
    private string? refreshMessage;
    private bool refreshSuccess = false;
    private DateTime? productsLastSync;
    private DateTime? pricesLastSync;
    private DateTime? bpLastSync;
    private DateTime? warehousesLastSync;
    private DateTime? costCentresLastSync;

    // Database reset fields
    private bool showResetConfirmation = false;
    private bool isResettingDatabase = false;
    private string resetConfirmationText = string.Empty;
    private string? resetMessage;
    private bool resetSuccess = false;

    // SAP settings fields
    private string sapServiceLayerUrl = string.Empty;
    private string sapCompanyDB = string.Empty;
    private string sapInvoiceSeriesName = string.Empty;
    private string sapUsername = string.Empty;
    private string sapPassword = string.Empty;
    private bool showSAPPassword = false;
    private bool sapTestOnSave = true;
    private bool isLoadingSAPSettings = false;
    private bool isSAPSaving = false;
    private bool isSAPTesting = false;
    private bool sapConnectionTested = false;
    private bool sapConnectionSuccess = false;
    private string? sapConnectionMessage;

    // Mobile app version policy fields
    private readonly Dictionary<string, string> mobileVersionPolicyApps = new(StringComparer.OrdinalIgnoreCase)
    {
        ["cheeseman-driver"] = "Cheeseman Driver App",
        ["kefalos-so"] = "Kefalos SO App",
        ["kefalos-vansales"] = "Kefalos Van Sales App"
    };
    private bool isLoadingMobileVersionPolicy = false;
    private bool isSavingMobileVersionPolicy = false;
    private string selectedMobileVersionPolicyAppId = "cheeseman-driver";
    private bool mobileVersionPolicyEnabled = true;
    private bool mobileVersionPolicyRequireHeaders = true;
    private string mobileVersionPolicyLatestVersion = string.Empty;
    private string mobileVersionPolicyRecommendedVersion = string.Empty;
    private string mobileVersionPolicyMinimumSupportedVersion = string.Empty;
    private string mobileVersionPolicyGooglePlayUrl = string.Empty;
    private string mobileVersionPolicyReleaseNotes = string.Empty;
    private string mobileVersionPolicyWarnMessage = string.Empty;
    private string mobileVersionPolicyBlockMessage = string.Empty;
    private bool mobileVersionPolicySaveSucceeded = false;
    private string? mobileVersionPolicyMessage;

    private string SelectedMobileVersionPolicyAppName => mobileVersionPolicyApps.TryGetValue(selectedMobileVersionPolicyAppId, out var appName)
        ? appName
        : "Mobile App";

    private bool CanSaveMobileVersionPolicy => !isSavingMobileVersionPolicy
        && (!mobileVersionPolicyEnabled || !string.IsNullOrWhiteSpace(mobileVersionPolicyLatestVersion));

    // Printing
    private bool isTestingPrinter = false;
    private string? printingMessage;
    private bool printingMessageSuccess = true;

    // POD report email schedule fields
    private string? podEmailMessage;
    private bool podEmailMessageSuccess = true;
    private List<PodReportEmailSchedule> podSchedules = new();
    private PodReportEmailSchedule? editingSchedule;
    private bool showScheduleModal = false;
    private bool isSavingSchedule = false;
    private bool isSavingPodAutomation = false;
    private readonly HashSet<int> sendingScheduleIds = new();
    private int? confirmingDeleteId;
    private string? scheduleValidationError;

    protected override async Task OnInitializedAsync()
    {
        await LoadCurrentUser();
        await LoadSettings();
        await LoadLastSyncTimes();
        await LoadPaymentSettingsData();
        await LoadSAPSettings();
        await LoadMobileVersionPolicySettings();
        await LogAudit(AuditActions.ViewSettings);
    }

    private async Task LoadCurrentUser()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        currentUsername = authState.User.Identity?.Name ?? "Unknown";
    }

    private async Task LoadLastSyncTimes()
    {
        productsLastSync = CacheService.GetLastRefreshTime("Products_All");
        pricesLastSync = CacheService.GetLastRefreshTime("ItemPrices");
        bpLastSync = CacheService.GetLastRefreshTime("BusinessPartners");
        warehousesLastSync = CacheService.GetLastRefreshTime("Warehouses");
        costCentresLastSync = CacheService.GetLastRefreshTime("CostCentres");
        await Task.CompletedTask;
    }

    private async Task LoadSettings()
    {
        isLoading = true;
        try
        {
            await SettingsService.InitializeDefaultSettingsAsync();
            allSettings = await SettingsService.GetAllSettingsAsync();
            editedValues = allSettings.ToDictionary(s => s.Key, s => s.Value);
            await LoadSchedulesAsync();
        }
        catch (Exception ex)
        {
            errorMessage = $"Failed to load settings: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }

    private void SelectCategory(string category)
    {
        selectedCategory = category;
        whOpen = false;
        glOpen = false;
    }

    private string Active(string category) => selectedCategory == category ? "active" : string.Empty;

    // ── Edited-value plumbing ────────────────────────────────────────────
    // "Dirty" is derived from the edit buffer against the loaded rows rather than tracked
    // by hand, which is what lets the header count unsaved changes and each row offer a revert.

    private AppSetting? GetSetting(string key) => allSettings.FirstOrDefault(s => s.Key == key);

    private string GetValue(string key) => editedValues.TryGetValue(key, out var value) ? value : string.Empty;

    private bool GetBoolValue(string key) => bool.TryParse(GetValue(key), out var result) && result;

    private bool IsDirty(string key) =>
        editedValues.TryGetValue(key, out var edited) && GetSetting(key) is AppSetting setting && setting.Value != edited;

    private int DirtyCount => allSettings.Count(s => IsDirty(s.Key));

    private void Revert(string key)
    {
        if (GetSetting(key) is AppSetting setting)
        {
            editedValues[key] = setting.Value;
        }
    }

    /// <summary>The design's per-row provenance line: who last touched this setting, and when.</summary>
    private string? SettingMeta(string key)
    {
        var setting = GetSetting(key);
        if (setting?.LastModifiedBy is null)
        {
            return null;
        }

        return $"{setting.LastModifiedBy} · {IAuditService.ToCAT(DateTime.SpecifyKind(setting.LastModifiedAt, DateTimeKind.Utc)):dd MMM yyyy HH:mm}";
    }

    private void OnSettingChanged(string key, string? value)
    {
        if (value == null) return;
        editedValues[key] = value;
        justSaved = false;
    }

    private void OnBoolSettingChanged(string key, ChangeEventArgs e)
    {
        var newValue = e.Value is bool b ? b : bool.TryParse(e.Value?.ToString(), out var parsed) && parsed;
        editedValues[key] = newValue.ToString().ToLower();
        justSaved = false;
    }

    private void OnIntSettingChanged(string key, ChangeEventArgs e, int min, int max)
    {
        var parsed = int.TryParse(e.Value?.ToString(), out var value) ? value : min;
        editedValues[key] = Math.Clamp(parsed, min, max).ToString();
        justSaved = false;
    }

    private void RequestSave()
    {
        confirmingSave = true;
    }

    private async Task SaveSettings()
    {
        confirmingSave = false;
        isSaving = true;
        errorMessage = null;
        successMessage = null;

        try
        {
            var changed = DirtyCount;
            await SettingsService.SaveSettingsAsync(editedValues, currentUsername);
            await AppSettingsProvider.ReloadAsync();

            allSettings = await SettingsService.GetAllSettingsAsync();
            editedValues = allSettings.ToDictionary(s => s.Key, s => s.Value);
            justSaved = true;
            await LogAudit(AuditActions.UpdateSettings, details: $"Updated {changed} setting(s)");
        }
        catch (Exception ex)
        {
            errorMessage = $"Failed to save settings: {ex.Message}";
        }
        finally
        {
            isSaving = false;
        }
    }

    // ── Warehouse lookup ────────────────────────────────────────────────

    private string WarehouseText
    {
        get
        {
            if (whQuery is not null)
            {
                return whQuery;
            }

            var code = GetValue(SettingKeys.DefaultWarehouse);
            if (string.IsNullOrWhiteSpace(code))
            {
                return string.Empty;
            }

            var warehouse = cachedWarehouses.FirstOrDefault(w => w.WarehouseCode == code);
            return warehouse is null ? code : $"{warehouse.WarehouseCode} · {warehouse.WarehouseName}";
        }
    }

    private List<CachedWarehouse> FilterWarehouses()
    {
        var active = cachedWarehouses.Where(w => w.IsActive);
        if (!string.IsNullOrWhiteSpace(whQuery))
        {
            active = active.Where(w =>
                $"{w.WarehouseCode} {w.WarehouseName}".Contains(whQuery, StringComparison.OrdinalIgnoreCase));
        }

        return active.Take(20).ToList();
    }

    private void PickWarehouse(CachedWarehouse warehouse)
    {
        OnSettingChanged(SettingKeys.DefaultWarehouse, warehouse.WarehouseCode ?? string.Empty);
        whQuery = null;
        whOpen = false;
    }

    private void RevertWarehouse()
    {
        Revert(SettingKeys.DefaultWarehouse);
        whQuery = null;
    }

    // ── POD report schedules ────────────────────────────────────────────

    private async Task LoadSchedulesAsync()
    {
        try
        {
            podSchedules = await PodReportEmailScheduleService.GetSchedulesAsync();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to load POD report email schedules.");
            podSchedules = new();
        }
    }

    private int TotalScheduleRecipientCount() => podSchedules
        .SelectMany(s => ParseEmailRecipients(s.ToRecipients))
        .Distinct(StringComparer.OrdinalIgnoreCase)
        .Count();

    private void OpenNewSchedule()
    {
        editingSchedule = new PodReportEmailSchedule
        {
            Name = string.Empty,
            Enabled = true,
            Frequency = nameof(PodReportEmailFrequency.Weekly),
            DayOfWeek = (int)DayOfWeek.Monday,
            SendMinuteOfDay = DefaultSendMinuteOfDay,
            ToRecipients = string.Empty,
            CcRecipients = string.Empty
        };
        scheduleValidationError = null;
        confirmingDeleteId = null;
        showScheduleModal = true;
    }

