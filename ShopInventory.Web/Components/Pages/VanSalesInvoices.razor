@page "/van-sales/invoices"
@page "/van-sales-invoices"
@using Microsoft.AspNetCore.Authorization
@using ShopInventory.Web.Common
@using ShopInventory.Web.Features.VanSalesDocuments
@using ShopInventory.Web.Models
@attribute [Authorize(Roles = "Admin,Manager,Cashier")]
@rendermode InteractiveServer

<PageTitle>Van Sales Invoices - Shop Inventory</PageTitle>

@* Nocturne, from wwwroot/css/van-sales-documents.css under the `vsd` prefix, built from the "Van Sales
   Redesign" design canvas (Main.dc.html and InvoiceDrawer.dc.html), which took its shape from /desktop-sales:
   a summary whose state lanes are the state filter, one filter bar, and a drawer that states the document —
   a headline amount, the facts, the lines, the receipt the device signed and a trail.

   /van-sales-invoices is kept as a second route because it is where the old list lived and people have it
   bookmarked; that list read SAP and showed anything with a van order field set, which is not the same set
   as this. *@

<div class="vsd">

    <div class="vsd-hero">
        <div class="vsd-hero-text">
            <div class="vsd-kicker-row">
                <span class="vsd-kicker">Van sales</span>
                <span class="vsd-kicker-rule"></span>
                <span class="vsd-kicker-note">Online, offline and converted orders</span>
            </div>
            <h1>Invoices</h1>
            <p>
                Every invoice the van sales app created, and where each one stands: whether ZIMRA holds its
                receipt and SAP holds the invoice.
            </p>
        </div>

        <div class="vsd-hero-side">
            <div class="vsd-read">
                <div class="vsd-read-now">@(readAt is { } at ? $"Read {at:HH:mm:ss}" : "Not read yet")</div>
                <div>@VanSalesDocumentDisplay.Range(fromDate ?? DateTime.Today, toDate ?? DateTime.Today)</div>
            </div>
            <div class="vsd-hero-actions">
                <a class="vsd-btn vsd-btn-ghost" href="/van-sales/credit-notes">
                    <i class="ph ph-file-minus" aria-hidden="true"></i>
                    <span>Credit notes</span>
                </a>
                <button type="button" class="vsd-btn vsd-btn-ghost" @onclick="ExportAsync"
                        disabled="@(isExporting || isLoading || view.TotalCount == 0)">
                    @if (isExporting)
                    {
                        <span class="vsd-spin"></span>
                        <span>Exporting&hellip;</span>
                    }
                    else
                    {
                        <i class="ph ph-file-xls" aria-hidden="true"></i>
                        <span>Export</span>
                    }
                </button>
                <button type="button" class="vsd-icon-btn vsd-icon-btn-edged" title="Refresh" aria-label="Refresh"
                        @onclick="LoadAsync" disabled="@isLoading">
                    @if (isLoading)
                    {
                        <span class="vsd-spin"></span>
                    }
                    else
                    {
                        <i class="ph ph-arrows-clockwise" aria-hidden="true"></i>
                    }
                </button>
            </div>
        </div>
    </div>

    <div class="vsd-rule-fade"></div>

    <div class="vsd-summary">
        @* The period, divided. The strip states the split before the numbers do, and each lane is the state
           filter — it says what pressing it would show, because the counts are taken before that filter. *@
        <section class="vsd-card">
            <div class="vsd-card-head">
                <span class="vsd-card-label">@PeriodLabel</span>
                <span class="vsd-card-tally"><b>@view.Counts.All.ToString("N0")</b> invoice@(view.Counts.All == 1 ? "" : "s")</span>
            </div>

            <div class="vsd-strip">
                @if (view.Counts.All > 0)
                {
                    @foreach (var state in VanSalesDocumentDisplay.Lanes)
                    {
                        var count = VanSalesDocumentDisplay.Count(view.Counts, state);
                        if (count > 0)
                        {
                            <div class="vsd-strip-seg @VanSalesDocumentDisplay.Family(state)"
                                 style="width:@VanSalesDocumentDisplay.Width(count, view.Counts.All)"></div>
                        }
                    }
                }
            </div>

            <div class="vsd-lanes" role="group" aria-label="Show invoices in one state">
                @foreach (var state in VanSalesDocumentDisplay.Lanes)
                {
                    var on = stateFilter == state;
                    <button type="button" class="vsd-lane @VanSalesDocumentDisplay.Family(state) @(on ? "is-on" : null)"
                            aria-pressed="@(on ? "true" : "false")" @onclick="() => ToggleStateAsync(state)">
                        <span class="vsd-lane-num">@VanSalesDocumentDisplay.Count(view.Counts, state).ToString("N0")</span>
                        <span class="vsd-lane-name"><span class="vsd-dot"></span>@VanSalesDocumentDisplay.Label(state)</span>
                    </button>
                }
            </div>

            <div class="vsd-aside vsd-aside-ruled">
                <span>Value <b>@VanSalesDocumentDisplay.Totals(view.Summary.Totals)</b></span>
                <span>VAT <b>@VanSalesDocumentDisplay.Totals(view.Summary.Totals.Select(t => new VanSalesMoneyTotalModel { Currency = t.Currency, Amount = t.Vat }).ToList())</b></span>
                <span>Online <b>@view.Summary.Online.ToString("N0")</b></span>
                <span>Offline <b>@view.Summary.Offline.ToString("N0")</b></span>
                @if (view.Summary.Totals.Sum(t => t.NetOnlyCount) is > 0 and var netOnly)
                {
                    @* An online sale from before receipts were stored carries only its net figure. Said, so the
                       value is not read as gross throughout. *@
                    <span class="vsd-aside-note">@netOnly without VAT in the value</span>
                }
            </div>
        </section>

        @* What has been sold and is not in the back office yet: the number somebody chases. *@
        <section class="vsd-card">
            <div class="vsd-card-head vsd-card-head-start">
                <i class="ph ph-truck" aria-hidden="true"></i>
                <span class="vsd-card-label">Not yet invoiced in SAP</span>
            </div>

            <div class="vsd-value"><b>@VanSalesDocumentDisplay.Totals(view.Summary.NotInSap)</b></div>
            <div class="vsd-aside">
                <span>
                    @if (view.Summary.NotInSapCount == 0)
                    {
                        <text>Every invoice in this view is in SAP.</text>
                    }
                    else
                    {
                        <text>@view.Summary.NotInSapCount.ToString("N0") invoice@(view.Summary.NotInSapCount == 1 ? "" : "s") sold with no SAP invoice behind @(view.Summary.NotInSapCount == 1 ? "it" : "them")</text>
                    }
                </span>
            </div>

            @if (view.Summary.NotInSapByVan.Count > 0)
            {
                <div class="vsd-split"></div>
                <div class="vsd-breakdown">
                    <div class="vsd-card-label">By van</div>
                    @foreach (var van in view.Summary.NotInSapByVan)
                    {
                        <div class="vsd-break-row">
                            <span class="vsd-break-name" title="@van.Count.ToString("N0") invoice(s)">
                                @van.WarehouseCode@(van.RepName is null ? "" : $" · {van.RepName}")
                            </span>
                            <span class="vsd-break-track">
                                <span class="vsd-break-fill" style="width:@VanSalesDocumentDisplay.Width(van.Amount, NotInSapMax)"></span>
                            </span>
                            <span class="vsd-break-val">@VanSalesDocumentDisplay.Money(van.Currency, van.Amount)</span>
                        </div>
                    }
                </div>
            }
        </section>
    </div>

    <section class="vsd-fbar" aria-label="Filters">
        <div class="vsd-search">
            <i class="ph ph-magnifying-glass" aria-hidden="true"></i>
            <input class="vsd-input vsd-input-search" type="search"
                   placeholder="INV no., van order, shop, rep, receipt or SAP no."
                   aria-label="Search invoices"
                   @bind="searchTerm" @bind:after="ApplyAsync" />
        </div>

        <div class="vsd-seg" role="group" aria-label="Period">
            @foreach (var option in PeriodOptions)
            {
                <button type="button" class="vsd-seg-opt @(period == option.Value ? "is-on" : null)"
                        aria-pressed="@(period == option.Value ? "true" : "false")"
                        @onclick="() => SetPeriodAsync(option.Value)">@option.Label</button>
            }
        </div>

        @if (period == PeriodCustom)
        {
            <div class="vsd-dates">
                <NocturneDateField Class="vsd-input-date" Date="fromDate" DateChanged="OnFromChangedAsync" AriaLabel="From" />
                <span class="vsd-dates-to" aria-hidden="true">&rarr;</span>
                <NocturneDateField Class="vsd-input-date" Date="toDate" DateChanged="OnToChangedAsync" AriaLabel="To" />
            </div>
        }

        <div class="vsd-rep">
            <NocturneSelect Class="nsel-block" TValue="Guid?" Options="RepOptions"
                            @bind-Value="repFilter" OnChanged="ApplyAsync"
                            Placeholder="All reps" Caption="Filter by rep" AriaLabel="Filter by rep" />
        </div>

        <div class="vsd-seg" role="group" aria-label="Channel">
            @foreach (var option in ChannelOptions)
            {
                <button type="button" class="vsd-seg-opt @(channelFilter == option.Value ? "is-on" : null)"
                        aria-pressed="@(channelFilter == option.Value ? "true" : "false")"
                        @onclick="() => SetChannelAsync(option.Value)">@option.Label</button>
            }
        </div>
    </section>

    @if (!string.IsNullOrWhiteSpace(loadError))
    {
        <div class="vsd-msg vsd-fam-bad" role="alert">
            <i class="ph ph-warning-octagon" aria-hidden="true"></i>
            <div class="vsd-msg-body">@loadError</div>
        </div>
    }

    <div class="vsd-listbar">
        <div class="vsd-listbar-count">
            <span class="vsd-shown">@view.TotalCount.ToString("N0") invoice@(view.TotalCount == 1 ? "" : "s")</span>
            @if (stateFilter is not null)
            {
                <button type="button" class="vsd-pill" @onclick="ClearStateAsync"
                        aria-label="@($"Stop showing only {VanSalesDocumentDisplay.Label(stateFilter)}")">
                    <span>@VanSalesDocumentDisplay.Label(stateFilter)</span>
                    <i class="ph ph-x" aria-hidden="true"></i>
                </button>
            }
        </div>
        <span class="vsd-listbar-note">Newest first</span>
    </div>

    <div class="vsd-list">
        @if (isLoading && view.Rows.Count == 0)
        {
            <div class="vsd-empty">
                <span class="vsd-spin vsd-spin-lg"></span>
                <p>Loading van sales invoices&hellip;</p>
            </div>
        }
        else if (view.Rows.Count == 0)
        {
            <div class="vsd-empty">
                <i class="ph ph-receipt" aria-hidden="true"></i>
                <p>
                    @if (view.Counts.All == 0 && stateFilter is null)
                    {
                        <text>The van sales app created no invoices in this view.</text>
                    }
                    else
                    {
                        <text>No invoice in this view is in that state.</text>
                    }
                </p>
            </div>
        }
        else
        {
            <div class="vsd-grid vsd-grid-invoices @(isLoading ? "is-busy" : null)">
                <div class="vsd-thead">
                    <div>Invoice</div>
                    <div>Customer</div>
                    <div>Rep · van</div>
                    <div>Payment</div>
                    <div class="vsd-r">Amount</div>
                    <div>Fiscal receipt</div>
                    <div>SAP</div>
                    <div>State</div>
                    <div><span class="visually-hidden">Open</span></div>
                </div>

                @foreach (var row in view.Rows)
                {
                    var fiscal = FiscalMark(row);
                    var sap = SapMark(row);
                    <div class="vsd-row @(row.Reference == detailReference ? "is-open" : null)" role="button" tabindex="0"
                         aria-label="@($"Invoice {row.Number}")"
                         @onclick="() => OpenAsync(row.Reference)"
                         @onkeydown="e => RowKeyAsync(e, row.Reference)">
                        <div class="vsd-cell vsd-cell-main">
                            @* The short number first, as Desktop Sales shows the same sale; the handset's
                               reference under it, for fiscal and support work. *@
                            <span class="vsd-ref">@row.Number</span>
                            @if (row.HasSaleNumber)
                            {
                                <span class="vsd-devref">@row.Reference</span>
                            }
                            <span class="vsd-sub">@Stamp(row.CreatedAtUtc) · @row.Channel</span>
                        </div>
                        <div class="vsd-cell" data-label="Customer">
                            <span class="vsd-strong">@(row.CustomerName ?? row.CustomerCode ?? "—")</span>
                            @if (row.CustomerName is not null && row.CustomerCode is not null)
                            {
                                <span class="vsd-sub">@row.CustomerCode</span>
                            }
                        </div>
                        <div class="vsd-cell" data-label="Rep · van">
                            <span class="vsd-strong">@(row.RepName ?? "—")</span>
                            <span class="vsd-sub">@(row.WarehouseCode ?? "")</span>
                        </div>
                        <div class="vsd-cell" data-label="Payment">
                            <span class="@(string.IsNullOrWhiteSpace(row.PaymentMethod) ? "vsd-none" : "vsd-strong")">@Tender(row.PaymentMethod)</span>
                        </div>
                        <div class="vsd-cell vsd-r" data-label="Amount">
                            <span class="vsd-num">@VanSalesDocumentDisplay.Amount(row.Amount)</span>
                            <span class="vsd-sub">@row.Currency · @(row.AmountIncludesVat ? "incl. VAT" : "excl. VAT")</span>
                        </div>
                        <div class="vsd-cell" data-label="Fiscal receipt">
                            <span class="vsd-mark @fiscal.Family"><span class="vsd-dot"></span>@fiscal.Text</span>
                        </div>
                        <div class="vsd-cell" data-label="SAP">
                            <span class="vsd-mark @sap.Family"><span class="vsd-dot"></span>@sap.Text</span>
                        </div>
                        <div class="vsd-cell vsd-cell-state" data-label="State">
                            <span class="vsd-badge @VanSalesDocumentDisplay.Family(row.State)">@VanSalesDocumentDisplay.Label(row.State)</span>
                            @if (!string.IsNullOrWhiteSpace(row.Problem))
                            {
                                <span class="vsd-problem" title="@row.Problem">@row.Problem</span>
                            }
                        </div>
                        <div class="vsd-cell vsd-cell-chev">
                            <i class="ph ph-arrow-right vsd-chev" aria-hidden="true"></i>
                        </div>
                    </div>
                }
            </div>

            <div class="vsd-foot">
                <span>@PageSummary</span>
                @if (PageCount > 1)
                {
                    <div class="vsd-pages">
                        <button type="button" class="vsd-step" disabled="@(isLoading || page <= 1)"
                                @onclick="() => GoToPageAsync(page - 1)">
                            <i class="ph ph-caret-left" aria-hidden="true"></i>Previous
                        </button>
                        <span class="vsd-page-now">@(page) of @PageCount</span>
                        <button type="button" class="vsd-step" disabled="@(isLoading || page >= PageCount)"
                                @onclick="() => GoToPageAsync(page + 1)">
                            Next<i class="ph ph-caret-right" aria-hidden="true"></i>
                        </button>
                    </div>
                }
            </div>
        }
    </div>
</div>

@* A sibling of `.vsd`, not a child, so the page cannot clip it; it reaches the tokens through `.vsd-overlay`. *@
@if (detailReference is not null)
{
    var index = DetailIndex;

    <div class="vsd-overlay" @onclick="CloseDetail">
        <aside class="vsd-drawer" role="dialog" aria-modal="true" aria-label="@($"Invoice {DetailNumber}")"
               tabindex="-1" @onkeydown="DrawerKeyAsync" @onclick:stopPropagation="true">

            <div class="vsd-dhead">
                <div class="vsd-dhead-top">
                    <div class="vsd-dhead-id">
                        <span class="vsd-kicker">Van sales invoice</span>
                        <span class="vsd-dhead-no">@DetailNumber</span>
                        @if (DetailNumber != detailReference)
                        {
                            <span class="vsd-dhead-ref">@detailReference</span>
                        }
                        @if (detail is not null)
                        {
                            <span class="vsd-dhead-sub">
                                Sold @detail.Invoice.Channel.ToLowerInvariant() · @Full(detail.Invoice.CreatedAtUtc)
                            </span>
                        }
                    </div>

                    <div class="vsd-dnav">
                        <button type="button" class="vsd-icon-btn" title="Previous invoice" aria-label="Previous invoice"
                                disabled="@(index < 0 || view.Rows.Count < 2)" @onclick="() => StepAsync(-1)">
                            <i class="ph ph-caret-up" aria-hidden="true"></i>
                        </button>
                        <button type="button" class="vsd-icon-btn" title="Next invoice" aria-label="Next invoice"
                                disabled="@(index < 0 || view.Rows.Count < 2)" @onclick="() => StepAsync(1)">
                            <i class="ph ph-caret-down" aria-hidden="true"></i>
                        </button>
                        <button type="button" class="vsd-icon-btn" title="Close" aria-label="Close" @onclick="CloseDetail">
                            <i class="ph ph-x" aria-hidden="true"></i>
                        </button>
                    </div>
                </div>

                @if (detail is not null)
                {
                    var head = detail.Invoice;
                    var headFiscal = FiscalMark(head);
                    var headSap = SapMark(head);
                    <div class="vsd-dtags">
                        <span class="vsd-badge @VanSalesDocumentDisplay.Family(head.State)">@VanSalesDocumentDisplay.Label(head.State)</span>
                        <span class="vsd-mark @headFiscal.Family"><span class="vsd-dot"></span>ZIMRA · @(string.IsNullOrWhiteSpace(head.FiscalReceiptNumber) ? headFiscal.Text.ToLowerInvariant() : "signed")</span>
                        <span class="vsd-mark @headSap.Family"><span class="vsd-dot"></span>SAP · @(head.SapDocNum is { } n ? $"invoice #{n}" : headSap.Text.ToLowerInvariant())</span>
                    </div>
                }
            </div>

            <div class="vsd-dbody">
                @if (isDetailLoading)
                {
                    <div class="vsd-dloading"><span class="vsd-spin"></span> Reading the invoice&hellip;</div>
                }
                else if (!string.IsNullOrWhiteSpace(detailError))
                {
                    <div class="vsd-msg vsd-fam-bad" role="alert">
                        <i class="ph ph-warning-octagon" aria-hidden="true"></i>
                        <div class="vsd-msg-body">@detailError</div>
                    </div>
                }
                else if (detail is not null)
                {
                    var invoice = detail.Invoice;
                    var qrImage = FiscalQrCode.ToImageSource(detail.FiscalQrCode);
                    var credited = detail.CreditNotes.Where(c => c.GivesBack && c.Currency == invoice.Currency).Sum(c => c.Amount);

                    <div class="vsd-headline">
                        <b>@VanSalesDocumentDisplay.Money(invoice.Currency, invoice.Amount)</b>
                        <span>@(invoice.AmountIncludesVat ? "incl. VAT" : "excl. VAT") · paid @Tender(invoice.PaymentMethod).ToLowerInvariant()</span>
                    </div>

                    @if (!string.IsNullOrWhiteSpace(invoice.Problem))
                    {
                        @* The system's own words, verbatim: an operator cannot act on "posting failed". *@
                        <div class="vsd-msg vsd-fam-bad" role="alert">
                            <i class="ph ph-warning-octagon" aria-hidden="true"></i>
                            <div class="vsd-msg-body">
                                <strong>
                                    @(string.IsNullOrWhiteSpace(invoice.FiscalReceiptNumber) && invoice.SapDocNum is null
                                        ? "This invoice has no confirmed fiscal receipt."
                                        : "SAP has not accepted this invoice.")
                                </strong>
                                <div class="vsd-said">@invoice.Problem</div>
                                @if (detail.PostingAttempts > 0 || !string.IsNullOrWhiteSpace(detail.QueueStatus))
                                {
                                    <div class="vsd-sub">
                                        @(detail.PostingAttempts > 0 ? $"{detail.PostingAttempts} attempt{(detail.PostingAttempts == 1 ? "" : "s")} so far" : "")@(detail.PostingAttempts > 0 && !string.IsNullOrWhiteSpace(detail.QueueStatus) ? " · " : "")@(string.IsNullOrWhiteSpace(detail.QueueStatus) ? "" : $"queue entry {detail.QueueStatus}")
                                    </div>
                                }
                            </div>
                        </div>
                    }

                    <div class="vsd-defs">
                        <div>
                            <div class="vsd-def-k">Customer</div>
                            <div class="vsd-def-v">@(invoice.CustomerName ?? invoice.CustomerCode ?? "—")</div>
                            @if (invoice.CustomerName is not null && invoice.CustomerCode is not null)
                            {
                                <div class="vsd-sub">@invoice.CustomerCode</div>
                            }
                        </div>
                        <div>
                            <div class="vsd-def-k">Rep</div>
                            <div class="vsd-def-v">@(invoice.RepName ?? "—")</div>
                        </div>
                        <div>
                            <div class="vsd-def-k">Van</div>
                            <div class="vsd-def-v">@(invoice.WarehouseCode ?? "—")</div>
                        </div>
                        <div>
                            <div class="vsd-def-k">Payment</div>
                            <div class="vsd-def-v">@Tender(invoice.PaymentMethod)</div>
                        </div>
                        <div>
                            <div class="vsd-def-k">Channel</div>
                            <div class="vsd-def-v">@invoice.Channel</div>
                            <div class="vsd-sub">@(invoice.Channel == "Offline" ? "sold without signal, uploaded later" : "posted from the handset")</div>
                        </div>
                        <div>
                            <div class="vsd-def-k">Trading day</div>
                            <div class="vsd-def-v">@invoice.TradingDate.ToString("dd MMM yyyy", System.Globalization.CultureInfo.InvariantCulture)</div>
                        </div>
                        <div>
                            <div class="vsd-def-k">SAP invoice</div>
                            <div class="vsd-def-v @(invoice.SapDocNum is null ? "is-none" : null)">@(invoice.SapDocNum is { } docNum ? $"#{docNum}" : "Not in SAP yet")</div>
                        </div>
                        <div>
                            <div class="vsd-def-k">Posting attempts</div>
                            <div class="vsd-def-v">@detail.PostingAttempts</div>
                            @if (!string.IsNullOrWhiteSpace(detail.QueueStatus))
                            {
                                <div class="vsd-sub">queue entry @detail.QueueStatus</div>
                            }
                        </div>
                    </div>

                    @if (detail.Lines.Count > 0)
                    {
                        <div class="vsd-block">
                            <div class="vsd-def-k">Lines · @detail.Lines.Count</div>
                            <div class="vsd-lines">
                                <table>
                                    <thead>
                                        <tr>
                                            <th>Item</th>
                                            <th class="vsd-r">Qty</th>
                                            <th class="vsd-r">Price</th>
                                            <th>Tax</th>
                                            <th class="vsd-r">Total</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var line in detail.Lines)
                                        {
                                            <tr>
                                                <td>
                                                    <span class="vsd-strong">@(line.ItemDescription ?? line.ItemCode)</span>
                                                    <span class="vsd-code">@line.ItemCode</span>
                                                </td>
                                                <td class="vsd-r">@line.Quantity.ToString("0.###") @line.UoMCode</td>
                                                <td class="vsd-r">@VanSalesDocumentDisplay.Amount(line.UnitPrice)</td>
                                                <td class="vsd-tax">@(line.TaxCode ?? "—")</td>
                                                <td class="vsd-r vsd-strong">@VanSalesDocumentDisplay.Amount(line.LineTotal)</td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                                <div class="vsd-sum">
                                    @if (invoice.VatAmount is { } vat && invoice.AmountIncludesVat)
                                    {
                                        <div><span>Net</span><span>@VanSalesDocumentDisplay.Money(invoice.Currency, invoice.Amount - vat)</span></div>
                                        <div><span>VAT</span><span>@VanSalesDocumentDisplay.Money(invoice.Currency, vat)</span></div>
                                    }
                                    <div class="vsd-sum-total">
                                        <span>@(invoice.AmountIncludesVat ? "Total" : "Total excl. VAT")</span>
                                        <span>@VanSalesDocumentDisplay.Money(invoice.Currency, invoice.Amount)</span>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }

                    @if (detail.CreditNotes.Count > 0)
                    {
                        @* That credits exist is what somebody reading this total needs to know before reading it as
                           money the business kept. Only what was actually given back comes off it. *@
                        <div class="vsd-block">
                            <div class="vsd-def-k">Credit notes · @detail.CreditNotes.Count</div>
                            <div class="vsd-credits">
                                @foreach (var credit in detail.CreditNotes)
                                {
                                    <a class="vsd-credit @(credit.IsCancelled ? "is-off" : null)"
                                       href="@($"/van-sales/credit-notes?search={Uri.EscapeDataString(credit.Number)}&from={credit.Date:yyyy-MM-dd}&to={credit.Date:yyyy-MM-dd}&open={Uri.EscapeDataString(credit.Key)}")">
                                        <span class="vsd-credit-top">
                                            <span class="vsd-code vsd-strong">@credit.Number</span>
                                            <span class="vsd-num">&minus; @VanSalesDocumentDisplay.Money(credit.Currency, credit.Amount)</span>
                                        </span>
                                        <span class="vsd-sub">
                                            @(credit.Reason is { Length: > 0 } reason ? $"{reason} · " : "")@(credit.Origin == "Till" ? "Till credit" : "SAP memo") · @credit.Date.ToString("dd MMM yyyy", System.Globalization.CultureInfo.InvariantCulture)@(credit.IsCancelled ? " · cancelled" : "")
                                        </span>
                                        <span class="vsd-mark @(credit.GivesBack ? "vsd-fam-good" : credit.IsCancelled ? "vsd-fam-off" : "vsd-fam-warn")">
                                            <span class="vsd-dot"></span>@(credit.GivesBack ? "Given back" : credit.IsCancelled ? "Cancelled" : "Not given back yet")
                                        </span>
                                    </a>
                                }
                            </div>
                            @if (credited > 0)
                            {
                                <div class="vsd-sum">
                                    <div><span>Credited</span><span>&minus; @VanSalesDocumentDisplay.Money(invoice.Currency, credited)</span></div>
                                    <div class="vsd-sum-total">
                                        <span>Net of credits</span>
                                        <span>@VanSalesDocumentDisplay.Money(invoice.Currency, invoice.Amount - credited)</span>
                                    </div>
                                </div>
                            }
                        </div>
                    }

                    @if (!string.IsNullOrWhiteSpace(invoice.FiscalReceiptNumber))
                    {
                        <div class="vsd-qr">
                            @if (!string.IsNullOrWhiteSpace(qrImage))
                            {
                                <div class="vsd-qr-plate">
                                    <img src="@qrImage" alt="ZIMRA fiscal receipt QR code" />
                                </div>
                            }
                            <div class="vsd-qr-copy">
                                <div class="vsd-def-k">Fiscal signature</div>
                                <div class="vsd-qr-title">Receipt @invoice.FiscalReceiptNumber</div>
                                <p>
                                    @(string.Join(" · ", new[]
                                    {
                                        invoice.FiscalDay is null ? null : $"Fiscal day {invoice.FiscalDay}",
                                        invoice.FiscalDeviceSerial is null ? null : $"device {invoice.FiscalDeviceSerial}"
                                    }.Where(part => part is not null)))
                                </p>
                                @if (!string.IsNullOrWhiteSpace(invoice.FiscalVerificationCode))
                                {
                                    <span class="vsd-code">@FiscalQrCode.FormatVerificationCode(invoice.FiscalVerificationCode)</span>
                                }
                                @if (Uri.TryCreate(detail.FiscalQrCode?.Trim(), UriKind.Absolute, out var verify)
                                     && (verify.Scheme == Uri.UriSchemeHttp || verify.Scheme == Uri.UriSchemeHttps))
                                {
                                    <a class="vsd-verify" href="@verify.AbsoluteUri" target="_blank" rel="noopener noreferrer">
                                        Verify with ZIMRA<i class="ph ph-arrow-up-right" aria-hidden="true"></i>
                                    </a>
                                }
                            </div>
                        </div>
                    }

                    <div class="vsd-block">
                        <div class="vsd-def-k">Trail</div>
                        <div class="vsd-trail">
                            @foreach (var step in Trail(detail))
                            {
                                <div class="vsd-trail-step @step.Family">
                                    <div class="vsd-trail-rail"><span class="vsd-trail-mark @(step.IsCurrent ? "is-now" : null)"></span></div>
                                    <div class="vsd-trail-body">
                                        <div class="vsd-trail-label">@step.Label</div>
                                        <div class="vsd-trail-meta">@step.Meta</div>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                }
            </div>

            <div class="vsd-dfoot">
                @if (detail is not null && detail.Invoice.SapDocEntry is null)
                {
                    <span class="vsd-dfoot-why">No SAP invoice to download yet</span>
                }
                <button type="button" class="vsd-btn vsd-btn-ghost" @onclick="CloseDetail">Close</button>
                @* Offered on any invoice ZIMRA holds a receipt for, whether or not SAP took it — which is
                   the case that most needs it. A van sale is signed before SAP is asked, so a sale SAP
                   refused has a customer holding a receipt and, once they bring the goods back, nothing
                   else that can reverse it. The credit is filed with ZIMRA now and its SAP memo follows
                   when the invoice posts; the dialog says which of the two it is doing. *@
                @if (detail is not null && !string.IsNullOrWhiteSpace(detail.Invoice.FiscalReceiptNumber))
                {
                    <button type="button" class="vsd-btn vsd-btn-primary" @onclick="OpenCredit">
                        <i class="ph ph-arrow-u-up-left" aria-hidden="true"></i>
                        <span>Credit notes</span>
                    </button>
                }
                @if (detail?.Invoice.SapDocEntry is not null)
                {
                    <button type="button" class="vsd-btn vsd-btn-primary" @onclick="DownloadPdfAsync" disabled="@isDownloading">
                        @if (isDownloading)
                        {
                            <span class="vsd-spin"></span>
                            <span>Downloading&hellip;</span>
                        }
                        else
                        {
                            <i class="ph ph-download-simple" aria-hidden="true"></i>
                            <span>SAP invoice PDF</span>
                        }
                    </button>
                }
            </div>
        </aside>
    </div>
}

@* The same dialog /desktop-sales and /vending raise a credit from, which owns all of its own state
   and talks to the API itself — see DesktopCreditNoteDialog. It is addressed by the van order, which
   is what the receipt was signed under and what the API looks the sale up by. *@
<DesktopCreditNoteDialog Reference="@creditInvoice?.Reference"
                         SaleNumber="@creditInvoice?.Number"
                         Currency="@creditInvoice?.Currency"
                         OnClosed="CloseCredit" />
