                                    src="https://www.openstreetmap.org/export/embed.html?bbox=@((selectedOrder.Longitude.Value - 0.005m).ToString(CultureInfo.InvariantCulture))%2C@((selectedOrder.Latitude.Value - 0.005m).ToString(CultureInfo.InvariantCulture))%2C@((selectedOrder.Longitude.Value + 0.005m).ToString(CultureInfo.InvariantCulture))%2C@((selectedOrder.Latitude.Value + 0.005m).ToString(CultureInfo.InvariantCulture))&marker=@(selectedOrder.Latitude.Value.ToString(CultureInfo.InvariantCulture))%2C@(selectedOrder.Longitude.Value.ToString(CultureInfo.InvariantCulture))">
                            </iframe>
