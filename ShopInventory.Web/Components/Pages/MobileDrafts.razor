    private async Task ViewOrder(SalesOrderDto order)
    {
        if (!TryBeginOrderAction(order.Id, OrderActionType.View))
            return;

        await ClosePurchaseOrderViewer();
        selectedOrder = order;
        StateHasChanged();

        try
        {
            var detailOrder = await SalesOrderService.GetSalesOrderDetailsAsync(order) ?? order;
            if (!ReferenceEquals(detailOrder, order))
            {
                selectedOrder = detailOrder;
                StateHasChanged();
            }

            await LoadPurchaseOrderAttachmentsAsync(detailOrder);

            // Hydrate missing mobile draft prices from the local BP catalog; approval re-verifies against live SAP pricing.
            if (OrderHasMissingPrices(detailOrder))
            {
                await PopulateOrderPricesAsync(detailOrder);
            }

            if (CanRefreshOrderPricesInBackground(detailOrder))
            {
                _ = RefreshOrderPricesInBackgroundAsync(detailOrder.Id, ordersLoadVersion);
            }

            StateHasChanged();
        }
        finally
        {
            EndOrderAction(order.Id);
            StateHasChanged();
        }
    }

    private async Task ClearSelectedOrder()
    {
        await ClosePurchaseOrderViewer();
        selectedOrder = null;
        purchaseOrderAttachments.Clear();
        purchaseOrderAttachmentError = null;
        isLoadingPurchaseOrderAttachments = false;
    }

    private async Task LoadPurchaseOrderAttachmentsAsync(SalesOrderDto order)
    {
        purchaseOrderAttachments.Clear();
        purchaseOrderAttachmentError = null;

        var poReferenceNumber = GetPurchaseOrderReference(order);

        if (string.IsNullOrWhiteSpace(poReferenceNumber))
            return;

        isLoadingPurchaseOrderAttachments = true;

        try
        {
            var response = await PurchaseOrderService.GetDocumentsAsync(poReferenceNumber);
            if (response?.Attachments != null)
            {
                purchaseOrderAttachments.AddRange(response.Attachments);
            }
            else
            {
                purchaseOrderAttachmentError = "Failed to load uploaded purchase order files.";
            }
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Failed to load physical purchase order attachments for mobile order {OrderId} and reference {PoReference}", order.Id, poReferenceNumber);
            purchaseOrderAttachmentError = "Failed to load uploaded purchase order files.";
        }
        finally
        {
            isLoadingPurchaseOrderAttachments = false;
        }
    }

    private async Task LoadOrderPodStatusesAsync(IEnumerable<SalesOrderDto> loadedOrders, int loadVersion)
    {
        podStatusByOrderId.Clear();

        var ordersBySalesOrderDocNum = loadedOrders
            .Where(ShouldCheckPodStatus)
            .OrderByDescending(order => order.OrderDate)
            .GroupBy(order => order.SAPDocNum!.Value)
            .ToDictionary(group => group.Key, group => group.ToList());

        if (ordersBySalesOrderDocNum.Count == 0)
            return;

        try
        {
            foreach (var salesOrderDocNumBatch in ordersBySalesOrderDocNum.Keys.Chunk(PodStatusBatchSize))
            {
                var response = await PodService.ValidateBulkSalesOrderPodsAsync(salesOrderDocNumBatch);
                if (loadVersion != ordersLoadVersion)
                    return;

                foreach (var podStatus in response?.Results ?? Enumerable.Empty<BulkPodValidationResult>())
                {
                    if (!podStatus.SalesOrderDocNum.HasValue || !ordersBySalesOrderDocNum.TryGetValue(podStatus.SalesOrderDocNum.Value, out var matchingOrders))
                        continue;

                    foreach (var order in matchingOrders)
                    {
                        podStatusByOrderId[order.Id] = podStatus;
                    }
                }

                if (loadVersion == ordersLoadVersion)
                    await InvokeAsync(StateHasChanged);
            }
        }
        catch (Exception ex)
        {
            if (loadVersion != ordersLoadVersion)
                return;

            Logger.LogWarning(ex, "Failed to load POD delivery status for mobile orders.");
        }
    }

    private static bool ShouldCheckPodStatus(SalesOrderDto order)
    {
        return order.SAPDocNum is > 0
            && order.Status is SalesOrderStatus.Approved
                or SalesOrderStatus.PartiallyFulfilled
                or SalesOrderStatus.Fulfilled;
    }

    private bool IsOrderDelivered(SalesOrderDto order)
    {
        return podStatusByOrderId.TryGetValue(order.Id, out var podStatus)
            && podStatus.Found
            && podStatus.ExistingPodCount > 0;
    }

    private string GetDisplayStatusName(SalesOrderDto order)
        => IsOrderDelivered(order) ? "Delivered" : order.Status.ToString();

    /// <summary>
    /// Nocturne is a mono palette, so the ramp does the separating rather than
    /// a colour per status: settled work carries the accent, work still in the
    /// queue carries it faintly and pulses, untouched work stays neutral, and
    /// only a genuine failure leaves the accent for the bad ink.
    /// </summary>
    private string GetStatusToneClass(SalesOrderDto order)
    {
        if (IsOrderDelivered(order))
            return "is-done";

        return order.Status switch
        {
            SalesOrderStatus.Approved or SalesOrderStatus.Fulfilled or SalesOrderStatus.Invoiced => "is-done",
            SalesOrderStatus.Pending or SalesOrderStatus.PartiallyFulfilled => "is-open",
            SalesOrderStatus.Cancelled or SalesOrderStatus.Rejected => "is-bad",
            _ => string.Empty
        };
    }

    private static int GetStatusSortOrder(SalesOrderStatus status) => status switch
    {
        SalesOrderStatus.Draft => 0,
        SalesOrderStatus.Pending => 1,
        SalesOrderStatus.Approved => 2,
        SalesOrderStatus.PartiallyFulfilled => 3,
        SalesOrderStatus.Fulfilled => 4,
        SalesOrderStatus.Cancelled => 6,
        SalesOrderStatus.OnHold => 7,
        SalesOrderStatus.Rejected => 8,
        _ => 9
    };

    private int GetDisplayStatusSortOrder(SalesOrderDto order)
        => IsOrderDelivered(order) ? 5 : GetStatusSortOrder(order.Status);

    private int? GetOrderPodInvoiceDocNum(SalesOrderDto order)
    {
        if (!podStatusByOrderId.TryGetValue(order.Id, out var podStatus)
            || !podStatus.Found
            || podStatus.ExistingPodCount <= 0
            || (!podStatus.ResolvedInvoiceDocNum.HasValue && podStatus.DocNum <= 0))
        {
            return null;
        }

        return podStatus.ResolvedInvoiceDocNum is > 0
            ? podStatus.ResolvedInvoiceDocNum
            : podStatus.DocNum;
    }

    private int? GetSelectedOrderInvoiceDocNum()
    {
        var order = GetSelectedOrderListState() ?? selectedOrder;
        if (order == null)
            return null;

        if (podStatusByOrderId.TryGetValue(order.Id, out var podStatus))
        {
            if (podStatus.ResolvedInvoiceDocNum is > 0)
                return podStatus.ResolvedInvoiceDocNum;

            if (podStatus.DocNum > 0)
                return podStatus.DocNum;
        }

        return order.InvoiceSapDocNum;
    }

    private bool CanViewOrderPod(SalesOrderDto order)
        => GetOrderPodInvoiceDocNum(order).HasValue;

    private void NavigateToPod(SalesOrderDto order)
    {
        var invoiceDocNum = GetOrderPodInvoiceDocNum(order);
        if (!invoiceDocNum.HasValue)
            return;

        NavigationManager.NavigateTo($"/pods?docNum={invoiceDocNum.Value.ToString(CultureInfo.InvariantCulture)}&viewLatest=true");
    }

    private static string? GetPurchaseOrderReference(SalesOrderDto order)
    {
        return !string.IsNullOrWhiteSpace(order.CustomerRefNo)
            ? order.CustomerRefNo
            : order.OrderNumber;
    }

    private static bool IsViewablePurchaseOrderAttachment(DocumentAttachmentDto attachment)
    {
        var mimeType = GetPurchaseOrderViewerMimeType(attachment);
        return mimeType != null && (mimeType.StartsWith("image/") || mimeType == "application/pdf");
    }

    private static string? GetPurchaseOrderViewerMimeType(DocumentAttachmentDto attachment)
    {
        if (!string.IsNullOrWhiteSpace(attachment.MimeType))
            return attachment.MimeType;

        return Path.GetExtension(attachment.FileName).ToLowerInvariant() switch
        {
            ".jpg" or ".jpeg" => "image/jpeg",
            ".png" => "image/png",
            ".webp" => "image/webp",
            ".gif" => "image/gif",
            ".bmp" => "image/bmp",
            ".pdf" => "application/pdf",
            _ => null
        };
    }

    private async Task ViewPurchaseOrderAttachment(DocumentAttachmentDto attachment)
    {
        var mimeType = GetPurchaseOrderViewerMimeType(attachment);

        if (mimeType == null)
            return;

        try
        {
            await RevokePurchaseOrderViewerDataUriAsync();

            purchaseOrderViewerAttachment = attachment;
            purchaseOrderViewerFileName = attachment.FileName;
            purchaseOrderViewerMimeType = mimeType;
            purchaseOrderViewerDataUri = null;
            showPurchaseOrderViewer = true;
            isLoadingPurchaseOrderViewer = true;
            StateHasChanged();

            purchaseOrderViewerDataUri = await JS.InvokeAsync<string>(
                "createAuthenticatedObjectUrl",
                $"/download/purchase-order/{attachment.Id}");
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to view physical purchase order attachment {AttachmentId}", attachment.Id);
            Snackbar.Add("Failed to load the purchase order attachment.", Severity.Error);
            showPurchaseOrderViewer = false;
        }
        finally
        {
            isLoadingPurchaseOrderViewer = false;
            StateHasChanged();
        }
    }

    private async Task DownloadPurchaseOrderAttachment(DocumentAttachmentDto attachment)
    {
        try
        {
            await JS.InvokeVoidAsync("downloadAuthenticatedFile", $"/download/purchase-order/{attachment.Id}", attachment.FileName);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to download physical purchase order attachment {AttachmentId}", attachment.Id);
            Snackbar.Add("Failed to download the purchase order attachment.", Severity.Error);
        }
    }

    private async Task ClosePurchaseOrderViewer()
    {
        showPurchaseOrderViewer = false;
        await RevokePurchaseOrderViewerDataUriAsync();
        purchaseOrderViewerFileName = null;
        purchaseOrderViewerMimeType = null;
        purchaseOrderViewerAttachment = null;
    }

    private async Task RevokePurchaseOrderViewerDataUriAsync()
    {
        if (!string.IsNullOrWhiteSpace(purchaseOrderViewerDataUri))
        {
            await JS.InvokeVoidAsync("revokeObjectUrl", purchaseOrderViewerDataUri);
            purchaseOrderViewerDataUri = null;
        }
    }

    private async Task CreateSelectedOrderPdfAsync()
    {
        if (selectedOrder == null || isGeneratingOrderPdf)
            return;

        isGeneratingOrderPdf = true;

        try
        {
            var orderForExport = await SalesOrderService.GetSalesOrderDetailsAsync(selectedOrder) ?? selectedOrder;
            selectedOrder = orderForExport;

            var exportHtml = MobileOrderDocumentBuilder.Build(
                orderForExport,
                purchaseOrderAttachments.ToList(),
                purchaseOrderAttachmentError,
                GetPurchaseOrderReference(orderForExport),
                IAuditService.ToCAT(DateTime.UtcNow));

            await JS.InvokeVoidAsync("printReportHtml", exportHtml);
            Snackbar.Add("Print dialog opened. Choose Save as PDF to create the mobile order PDF.", Severity.Info);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to create PDF for mobile order {OrderId}", selectedOrder.Id);
            Snackbar.Add("Failed to create the mobile order PDF.", Severity.Error);
        }
        finally
        {
            isGeneratingOrderPdf = false;
        }
    }

    private async Task RefreshSelectedOrderAsync()
    {
        if (selectedOrder == null)
            return;

        var refreshedOrder = orders?.FirstOrDefault(o => o.Id == selectedOrder.Id);
        if (refreshedOrder != null && (refreshedOrder.Lines?.Any() == true || selectedOrder.Lines?.Any() != true))
        {
            selectedOrder = refreshedOrder;
            return;
        }

        try
        {
            var fullOrder = await SalesOrderService.GetSalesOrderDetailsAsync(selectedOrder);
            if (fullOrder != null)
            {
                selectedOrder = fullOrder;
            }
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Failed to refresh selected mobile order {OrderId}", selectedOrder.Id);
        }
    }

    private static bool OrderHasMissingPrices(SalesOrderDto order)
    {
        return order.Source == SalesOrderSource.Mobile
            && (!order.IsSynced || !order.SAPDocEntry.HasValue || order.SAPDocEntry.Value <= 0)
            && order.Lines?.Any() == true
            && order.Lines.Any(l => l.UnitPrice <= 0 || l.LineTotal <= 0);
    }

    private static bool CanRefreshOrderPricesInBackground(SalesOrderDto order)
    {
        return order.Source == SalesOrderSource.Mobile
            && (!order.IsSynced || !order.SAPDocEntry.HasValue || order.SAPDocEntry.Value <= 0)
            && order.Lines?.Any() == true;
    }

    private async Task PopulateMissingOrderPricesAsync(IEnumerable<SalesOrderDto> loadedOrders, int loadVersion)
    {
        var missingPriceOrders = loadedOrders
            .Where(OrderHasMissingPrices)
            .ToList();

        if (missingPriceOrders.Count == 0)
            return;

        foreach (var order in missingPriceOrders)
        {
            await PopulateOrderPricesAsync(order);
        }

        StateHasChanged();
        QueueBackgroundLivePriceRefresh(missingPriceOrders, loadVersion);
    }

    private async Task<bool> PopulateOrderPricesAsync(SalesOrderDto order, bool useLivePricing = false)
    {
        if (order.IsSynced && order.SAPDocEntry.HasValue && order.SAPDocEntry.Value > 0)
            return false;

        try
        {
            var itemCodes = order.Lines?
                .Select(line => line.ItemCode)
                .Where(itemCode => !string.IsNullOrWhiteSpace(itemCode))
                .Distinct(StringComparer.OrdinalIgnoreCase)
                .ToList() ?? [];

            if (itemCodes.Count == 0)
                return false;

            var bpPrices = await PriceService.GetPricesByBusinessPartnerAsync(order.CardCode, itemCodes, useLivePricing);
            if (bpPrices?.Prices == null || bpPrices.Prices.Count == 0)
                return false;

            var priceMap = bpPrices.Prices
                .Where(p => p.ItemCode != null)
                .ToDictionary(p => p.ItemCode!, p => p.Price, StringComparer.OrdinalIgnoreCase);

            var pricesChanged = false;
            var updatedLines = new List<CreateSalesOrderLineRequest>();

            foreach (var line in order.Lines!)
            {
                var updatedUnitPrice = line.UnitPrice;
                if (priceMap.TryGetValue(line.ItemCode, out var price))
                {
                    if (line.UnitPrice != price)
                        pricesChanged = true;

                    updatedUnitPrice = price;
                }

                updatedLines.Add(new CreateSalesOrderLineRequest
                {
                    ItemCode = line.ItemCode,
                    ItemDescription = line.ItemDescription,
                    Quantity = line.Quantity,
                    UnitPrice = updatedUnitPrice,
                    DiscountPercent = line.DiscountPercent,
                    TaxPercent = line.TaxPercent,
                    WarehouseCode = line.WarehouseCode,
                    UoMCode = line.UoMCode,
                    BatchNumber = line.BatchNumber
                });
            }

            if (!pricesChanged)
                return false;

            var updateRequest = new CreateSalesOrderRequest
            {
                DeliveryDate = order.DeliveryDate,
                CardCode = order.CardCode,
                CardName = order.CardName,
                CustomerRefNo = order.CustomerRefNo,
                Comments = order.Comments,
                SalesPersonCode = order.SalesPersonCode,
                SalesPersonName = order.SalesPersonName,
                Currency = order.Currency,
                DiscountPercent = order.DiscountPercent,
                ShipToAddress = order.ShipToAddress,
                BillToAddress = order.BillToAddress,
                WarehouseCode = order.WarehouseCode,
                Source = order.Source,
                MerchandiserNotes = order.MerchandiserNotes,
                DeviceInfo = order.DeviceInfo,
                RowVersion = order.RowVersion,
                Lines = updatedLines
            };

            var updatedOrder = await SalesOrderService.UpdateSalesOrderAsync(order.Id, updateRequest);
            if (updatedOrder != null)
            {
                ApplyUpdatedOrderPricingState(order, updatedOrder);
                return true;
            }
        }
        catch (Exception ex)
        {
            Logger.LogWarning(
                ex,
                "Failed to fetch {PricingSource} BP prices for order {OrderId} ({CardCode})",
                useLivePricing ? "live" : "locally stored",
                order.Id,
                order.CardCode);
        }

        return false;
    }

    private void QueueBackgroundLivePriceRefresh(IEnumerable<SalesOrderDto> ordersToRefresh, int loadVersion)
    {
        var refreshCandidates = ordersToRefresh
            .Where(CanRefreshOrderPricesInBackground)
            .GroupBy(order => order.Id)
            .Select(group => group.First())
            .Where(order => !IsOrderActionBusy(order.Id))
            .ToList();

        if (refreshCandidates.Count == 0)
            return;

        _ = RefreshOrderPricesInBackgroundAsync(refreshCandidates, loadVersion);
    }

    private async Task RefreshOrderPricesInBackgroundAsync(IReadOnlyCollection<SalesOrderDto> ordersToRefresh, int loadVersion)
    {
        foreach (var order in ordersToRefresh)
        {
            if (loadVersion != ordersLoadVersion)
                return;

            if (!TryBeginBackgroundPriceRefresh(order.Id))
                continue;

            try
            {
                if (IsOrderActionBusy(order.Id))
                    continue;

                var pricesUpdated = await PopulateOrderPricesAsync(order, useLivePricing: true);
                if (!pricesUpdated || loadVersion != ordersLoadVersion)
                    continue;

                await InvokeAsync(StateHasChanged);
            }
            catch (Exception ex)
            {
                Logger.LogWarning(ex, "Failed background live price refresh for order {OrderId} ({CardCode})", order.Id, order.CardCode);
            }
            finally
            {
                EndBackgroundPriceRefresh(order.Id);
            }
        }
    }

    private async Task RefreshOrderPricesInBackgroundAsync(int orderId, int loadVersion)
    {
        if (!TryBeginBackgroundPriceRefresh(orderId))
            return;

        try
        {
            var order = FindOrderForPricingRefresh(orderId);
            if (order == null || loadVersion != ordersLoadVersion || !CanRefreshOrderPricesInBackground(order))
                return;

            await PopulateOrderPricesAsync(order, useLivePricing: true);

            if (loadVersion == ordersLoadVersion)
            {
                await InvokeAsync(StateHasChanged);
            }
        }
        finally
        {
            EndBackgroundPriceRefresh(orderId);
        }
    }

    private SalesOrderDto? FindOrderForPricingRefresh(int orderId)
    {
        if (selectedOrder?.Id == orderId)
            return selectedOrder;

        return orders?.FirstOrDefault(order => order.Id == orderId);
    }

    private bool TryBeginBackgroundPriceRefresh(int orderId)
    {
        lock (backgroundPriceRefreshLock)
        {
            return backgroundPriceRefreshOrderIds.Add(orderId);
        }
    }

    private void EndBackgroundPriceRefresh(int orderId)
    {
        lock (backgroundPriceRefreshLock)
        {
            backgroundPriceRefreshOrderIds.Remove(orderId);
        }
    }

    private void ApplyUpdatedOrderPricingState(SalesOrderDto currentOrder, SalesOrderDto updatedOrder)
    {
        CopyUpdatedOrderPricingState(currentOrder, updatedOrder);

        var listOrder = orders?.FirstOrDefault(order => order.Id == updatedOrder.Id);
        if (listOrder != null && !ReferenceEquals(listOrder, currentOrder))
        {
            CopyUpdatedOrderPricingState(listOrder, updatedOrder);
        }

        if (selectedOrder != null
            && selectedOrder.Id == updatedOrder.Id
            && !ReferenceEquals(selectedOrder, currentOrder)
            && !ReferenceEquals(selectedOrder, listOrder))
        {
            CopyUpdatedOrderPricingState(selectedOrder, updatedOrder);
        }
    }

    private static void CopyUpdatedOrderPricingState(SalesOrderDto target, SalesOrderDto source)
    {
        target.SubTotal = source.SubTotal;
        target.TaxAmount = source.TaxAmount;
        target.DiscountAmount = source.DiscountAmount;
        target.DocTotal = source.DocTotal;
        target.RowVersion = source.RowVersion;
        target.Lines = source.Lines;
    }

