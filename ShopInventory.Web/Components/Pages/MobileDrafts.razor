                                        <td>@line.ItemDescription</td>
                                        <td class="mox-num">@QuantityDisplay.Format(line.Quantity, line.UoMCode)</td>
                                        <td>@(string.IsNullOrWhiteSpace(line.UoMCode) ? "-" : line.UoMCode)</td>
                                        <td class="mox-num">@line.UnitPrice.ToString("N2")</td>
                                        <td class="mox-num">@line.LineTotal.ToString("N2")</td>
