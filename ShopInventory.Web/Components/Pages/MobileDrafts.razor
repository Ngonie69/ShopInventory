    private bool TryBeginOrderAction(int id, OrderActionType action)
    {
        if (orderActionStates.ContainsKey(id))
            return false;

        orderActionStates[id] = action;
        return true;
    }

    private void EndOrderAction(int id)
    {
        orderActionStates.Remove(id);
    }

    private bool IsOrderActionBusy(int id) => orderActionStates.ContainsKey(id);

    private bool IsOrderActionBusy(int id, OrderActionType action)
        => orderActionStates.TryGetValue(id, out var currentAction) && currentAction == action;

    private SalesOrderDto? GetSelectedOrderListState()
    {
        if (selectedOrder == null)
            return null;

        return orders?.FirstOrDefault(order => order.Id == selectedOrder.Id);
    }

    private SalesOrderStatus GetSelectedOrderStatus()
        => GetSelectedOrderListState()?.Status ?? selectedOrder?.Status ?? SalesOrderStatus.Draft;

    private string GetSelectedOrderStatusName()
    {
        var order = GetSelectedOrderListState() ?? selectedOrder;
        return order == null ? SalesOrderStatus.Draft.ToString() : GetDisplayStatusName(order);
    }

    private string GetSelectedOrderToneClass()
    {
        var order = GetSelectedOrderListState() ?? selectedOrder;
        return order == null ? string.Empty : GetStatusToneClass(order);
    }

    private bool IsSelectedOrderSynced()
        => GetSelectedOrderListState()?.IsSynced ?? selectedOrder?.IsSynced == true;

    private bool CanViewSelectedOrderPod()
    {
        var order = GetSelectedOrderListState() ?? selectedOrder;
        return order != null && CanViewOrderPod(order);
    }

    private void NavigateToSelectedOrderPod()
    {
        var order = GetSelectedOrderListState() ?? selectedOrder;
        if (order != null)
        {
            NavigateToPod(order);
        }
    }

    private bool CanEditSelectedOrder()
        => selectedOrder != null && !IsSelectedOrderSynced() && GetSelectedOrderStatus() is SalesOrderStatus.Draft or SalesOrderStatus.Pending;

    private bool CanPostSelectedOrderToSap()
        => selectedOrder != null && !IsSelectedOrderSynced() && GetSelectedOrderStatus() == SalesOrderStatus.Approved;

    private static string FormatOrderLineCount(SalesOrderDto order)
    {
        var lineCount = order.Lines?.Count ?? 0;
        return $"{lineCount:N0} {(lineCount == 1 ? "line" : "lines")}";
    }

    private static string FormatOrderItemCount(SalesOrderDto order)
    {
        var itemCount = order.Lines?.Sum(line => line.Quantity) ?? 0m;
        return $"{QuantityDisplay.Format(itemCount)} {(itemCount == 1m ? "item" : "items")}";
    }

    private async Task ApproveOrder(int id)
    {
        if (!TryBeginOrderAction(id, OrderActionType.Approve))
            return;

        StateHasChanged();

        try
        {
            var result = await SalesOrderService.ApproveAsync(id);
            if (result != null)
            {
                var approvalMessage = result.IsSynced
                    ? result.SAPDocNum.HasValue
                        ? $"Order {result.OrderNumber} approved and posted to SAP successfully! (Doc #{result.SAPDocNum})"
                        : $"Order {result.OrderNumber} approved and posted to SAP successfully."
                    : $"Order {result.OrderNumber} approved successfully.";
                Snackbar.Add(approvalMessage, Severity.Success);
                selectedOrder = result;
                await LoadOrders();
            }
            else
            {
                Snackbar.Add("Failed to approve order. Please try again.", Severity.Error);
            }
        }
        catch (HttpRequestException ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error approving order: {ex.Message}", Severity.Error);
        }
        finally
        {
            EndOrderAction(id);
            StateHasChanged();
        }
    }

    private async Task PostOrderToSAP(int id)
    {
        if (!TryBeginOrderAction(id, OrderActionType.PostToSap))
            return;

        StateHasChanged();

        try
        {
            var result = await SalesOrderService.PostToSAPAsync(id);
            if (result != null)
            {
                Snackbar.Add($"Order {result.OrderNumber} posted to SAP successfully! (Doc #{result.SAPDocNum})", Severity.Success);
                await ClearSelectedOrder();
                await LoadOrders();
            }
            else
            {
                Snackbar.Add("Failed to post order to SAP. Please try again.", Severity.Error);
            }
        }
        catch (HttpRequestException ex)
        {
            Snackbar.Add($"SAP posting failed: {ex.Message}", Severity.Error);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error posting to SAP: {ex.Message}", Severity.Error);
        }
        finally
        {
            EndOrderAction(id);
            StateHasChanged();
        }
    }

    private async Task ConvertToInvoice(SalesOrderDto order)
    {
        var result = await DialogService.ShowMessageBoxAsync(
            "Convert to Invoice",
            $"Are you sure you want to convert order {order.OrderNumber} for {order.CardName ?? order.CardCode} (Total: {order.Currency} {order.DocTotal:N2}) into an invoice?",
            yesText: "Convert",
            cancelText: "Cancel");

        if (result != true) return;

        if (!TryBeginOrderAction(order.Id, OrderActionType.ConvertToInvoice))
            return;

        StateHasChanged();

        try
        {
            var invoice = await SalesOrderService.ConvertToInvoiceAsync(order.Id);
            if (invoice != null)
            {
                Snackbar.Add($"Order {order.OrderNumber} converted to Invoice #{invoice.DocNum} successfully!", Severity.Success);
                await LoadOrders();
            }
            else
            {
                Snackbar.Add("Failed to convert sales order to invoice. Please try again.", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error converting order: {ex.Message}", Severity.Error);
        }
        finally
        {
            EndOrderAction(order.Id);
            StateHasChanged();
        }
    }

    private Task CancelOrder(int id)
        => ChangeOrderStatus(id, SalesOrderStatus.Cancelled, "Order cancelled successfully.");

    private Task RestoreOrderToDraft(int id)
        => ChangeOrderStatus(id, SalesOrderStatus.Draft, "Order moved back to draft.");

    private async Task ChangeOrderStatus(int id, SalesOrderStatus status, string successMessage)
    {
        if (!TryBeginOrderAction(id, OrderActionType.UpdateStatus))
            return;

        StateHasChanged();

        try
        {
            var result = await SalesOrderService.UpdateStatusAsync(id, status);
            if (result != null)
            {
                if (selectedOrder?.Id == id)
                {
                    selectedOrder = result;
                }

                ApplyOrderUpdateToList(result);
                Snackbar.Add(successMessage, Severity.Success);
            }
            else
            {
                Snackbar.Add($"Failed to {GetStatusChangeVerb(status)} order. Please try again.", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error updating order status: {ex.Message}", Severity.Error);
        }
        finally
        {
            EndOrderAction(id);
            StateHasChanged();
        }
    }

    private async Task DeleteOrder(int id)
    {
        if (!TryBeginOrderAction(id, OrderActionType.Delete))
            return;

        StateHasChanged();

        try
        {
            var success = await SalesOrderService.DeleteSalesOrderAsync(id);
            if (success)
            {
                await RemoveOrderFromListAsync(id);
                Snackbar.Add("Order deleted successfully.", Severity.Success);
            }
            else
            {
                Snackbar.Add("Failed to delete order. Please try again.", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error deleting order: {ex.Message}", Severity.Error);
        }
        finally
        {
            EndOrderAction(id);
            StateHasChanged();
        }
    }

    private static string GetStatusChangeVerb(SalesOrderStatus status)
        => status == SalesOrderStatus.Draft ? "restore" : "cancel";

    private void ApplyOrderUpdateToList(SalesOrderDto updatedOrder)
    {
        if (orders == null)
            return;

        availableStatusFilters.Add(updatedOrder.Status);

        var index = orders.FindIndex(order => order.Id == updatedOrder.Id);
        if (index < 0)
            return;

        var activeStatusFilter = GetSelectedStatusFilter();
        if (activeStatusFilter.HasValue && updatedOrder.Status != activeStatusFilter.Value)
        {
            orders.RemoveAt(index);
            selectedOrderIds.Remove(updatedOrder.Id);
            totalCount = Math.Max(0, totalCount - 1);
            totalPages = totalCount == 0 ? 1 : (int)Math.Ceiling(totalCount / (double)pageSize);
            return;
        }

        orders[index] = updatedOrder;
    }

    private async Task RemoveOrderFromListAsync(int id)
    {
        if (selectedOrder?.Id == id)
        {
            await ClearSelectedOrder();
        }

        podStatusByOrderId.Remove(id);
        selectedOrderIds.Remove(id);

        if (orders == null)
            return;

        var removedCount = orders.RemoveAll(order => order.Id == id);
        if (removedCount == 0)
            return;

        totalCount = Math.Max(0, totalCount - removedCount);
        totalPages = totalCount == 0 ? 1 : (int)Math.Ceiling(totalCount / (double)pageSize);
    }

    // ── Row selection ──────────────────────────────────────────────────────

    private int SelectedOrderCount => selectedOrderIds.Count;

    private bool IsOrderSelected(int id) => selectedOrderIds.Contains(id);

    private void ToggleOrderSelection(int id)
    {
        if (!selectedOrderIds.Add(id))
        {
            selectedOrderIds.Remove(id);
        }
    }

    private void ClearSelection() => selectedOrderIds.Clear();

    private bool AreAllPageOrdersSelected(IReadOnlyCollection<SalesOrderDto> pageOrders)
        => pageOrders.Count > 0 && pageOrders.All(order => selectedOrderIds.Contains(order.Id));

    private void ToggleAllPageOrders(IReadOnlyCollection<SalesOrderDto> pageOrders)
    {
        var selectAll = !AreAllPageOrdersSelected(pageOrders);

        foreach (var order in pageOrders)
        {
            if (selectAll)
            {
                selectedOrderIds.Add(order.Id);
            }
            else
            {
                selectedOrderIds.Remove(order.Id);
            }
        }
    }

    /// <summary>
    /// Drops selections for orders that are no longer in the list, so a reload
    /// cannot leave a count pointing at rows nobody can see.
    /// </summary>
    private void PruneSelection()
    {
        if (orders == null)
        {
            selectedOrderIds.Clear();
            return;
        }

        var present = orders.Select(order => order.Id).ToHashSet();
        selectedOrderIds.RemoveWhere(id => !present.Contains(id));
    }

    private List<SalesOrderDto> GetSelectedOrders()
        => orders?.Where(order => selectedOrderIds.Contains(order.Id)).ToList() ?? [];

    private List<SalesOrderDto> GetApprovableSelectedOrders()
        => GetSelectedOrders().Where(SalesOrderActions.CanApprove).ToList();

    private bool CanBulkApprove => !isBulkApproving && GetApprovableSelectedOrders().Count > 0;

    private string BulkApproveTitle
    {
        get
        {
            var approvable = GetApprovableSelectedOrders().Count;
            if (approvable == 0)
                return "None of the selected orders are waiting on approval";

            var selected = SelectedOrderCount;
            return approvable == selected
                ? $"Approve {approvable} selected order{(approvable == 1 ? string.Empty : "s")}"
                : $"Approve the {approvable} of {selected} selected orders still waiting on approval";
        }
    }

    /// <summary>
    /// Approval posts the order to SAP, so a batch is confirmed once up front
    /// rather than silently firing one request per selected row.
    /// </summary>
    private async Task BulkApproveSelected()
    {
        if (isBulkApproving)
            return;

        var approvable = GetApprovableSelectedOrders();
        if (approvable.Count == 0)
            return;

        var confirmed = await DialogService.ShowMessageBoxAsync(
            "Approve orders",
            $"Approve {approvable.Count} order{(approvable.Count == 1 ? string.Empty : "s")}? Each one posts to SAP.",
            yesText: "Approve",
            cancelText: "Cancel");

        if (confirmed != true)
            return;

        isBulkApproving = true;
        StateHasChanged();

        var approved = 0;
        var failures = new List<string>();

        try
        {
            foreach (var order in approvable)
            {
                try
                {
                    var result = await SalesOrderService.ApproveAsync(order.Id);
                    if (result != null)
                    {
                        approved++;
                        selectedOrderIds.Remove(order.Id);
                    }
                    else
                    {
                        failures.Add(order.OrderNumber);
                    }
                }
                catch (Exception ex)
                {
                    Logger.LogWarning(ex, "Failed to approve mobile order {OrderId} during a bulk approval", order.Id);
                    failures.Add(order.OrderNumber);
                }

                StateHasChanged();
            }
        }
        finally
        {
            isBulkApproving = false;
        }

        if (approved > 0)
        {
            Snackbar.Add($"{approved} order{(approved == 1 ? string.Empty : "s")} approved.", Severity.Success);
        }

        if (failures.Count > 0)
        {
            var named = string.Join(", ", failures.Take(5));
            var more = failures.Count > 5 ? "…" : string.Empty;
            Snackbar.Add($"Could not approve {failures.Count} order{(failures.Count == 1 ? string.Empty : "s")}: {named}{more}", Severity.Error);
        }

        await LoadOrders();
    }

    // ── Export ─────────────────────────────────────────────────────────────

    private string ExportLabel => SelectedOrderCount > 0
        ? $"Export {SelectedOrderCount} to Excel"
        : "Export to Excel";

    /// <summary>
    /// The design exports the selection when there is one and everything the
    /// filters leave standing otherwise — the same rows the table is showing,
    /// in the same order, not just the page on screen.
    /// </summary>
    private async Task ExportToExcel()
    {
        if (isExporting)
            return;

        var sorted = GetSortedOrders();
        var rows = selectedOrderIds.Count > 0
            ? sorted.Where(order => selectedOrderIds.Contains(order.Id)).ToList()
            : sorted;

        if (rows.Count == 0)
        {
            Snackbar.Add("There are no orders to export.", Severity.Info);
            return;
        }

        isExporting = true;
        StateHasChanged();

        try
        {
            var title = IsVanSalesView ? "Van Sales Orders" : "Mobile Orders";
            var bytes = ExportService.ExportMobileOrdersToExcel(rows, title);
            var prefix = IsVanSalesView ? "Van_Sales_Orders" : "Mobile_Orders";
            await JS.InvokeVoidAsync(
                "downloadFile",
                $"{prefix}_{DateTime.Now:yyyyMMdd_HHmm}.xlsx",
                Convert.ToBase64String(bytes));
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to export mobile orders to Excel");
            Snackbar.Add($"Export failed: {ex.Message}", Severity.Error);
        }
        finally
        {
            isExporting = false;
            StateHasChanged();
        }
    }

    // ── Row display ────────────────────────────────────────────────────────

    private static string GetSubmittedByName(SalesOrderDto order)
    {
        if (!string.IsNullOrWhiteSpace(order.CreatedByUserName))
            return order.CreatedByUserName;

        return string.IsNullOrWhiteSpace(order.SalesPersonName) ? "Unknown" : order.SalesPersonName;
    }

    /// <summary>
    /// A submission carries a free-text device string, shown in the drawer.
    /// Where the rep allowed it, the submission also carries coordinates; those
    /// have no place name to resolve to, so the drawer spells them out instead.
    /// </summary>
    private static string GetDeviceLabel(SalesOrderDto order)
        => string.IsNullOrWhiteSpace(order.DeviceInfo) ? "Device not captured" : order.DeviceInfo.Trim();

    private static string GetLineCountSuffix(SalesOrderDto order)
    {
        var lineCount = order.Lines?.Count ?? 0;
        return lineCount == 0
            ? string.Empty
            : $" · {lineCount:N0} {(lineCount == 1 ? "line" : "lines")}";
    }

    private static string GetSapDocLabel(SalesOrderDto order)
    {
        if (order.SAPDocNum.HasValue)
            return order.SAPDocNum.Value.ToString(CultureInfo.InvariantCulture);

        return order.Status == SalesOrderStatus.Approved ? "Pending" : "—";
    }

    private static string GetSapDocClass(SalesOrderDto order)
    {
        if (order.SAPDocNum.HasValue)
            return "mox-sap";

        return order.Status == SalesOrderStatus.Approved ? "mox-sap is-waiting" : "mox-sap is-none";
    }
}
