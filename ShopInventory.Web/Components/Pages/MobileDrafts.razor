                    </button>
                    <button type="button" class="mox-iconbtn" title="Close" aria-label="Close"
                            @onclick="ClosePurchaseOrderViewer">
                        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"></path></svg>
                    </button>
                </div>
                <div class="mox-viewer-body">
                    @if (isLoadingPurchaseOrderViewer)
                    {
                        <span class="mox-spin" aria-hidden="true"></span>
                    }
                    else if (purchaseOrderViewerMimeType?.StartsWith("image/") == true)
                    {
                        <img src="@purchaseOrderViewerDataUri" alt="@purchaseOrderViewerFileName" />
                    }
                    else if (purchaseOrderViewerMimeType == "application/pdf")
                    {
                        <iframe src="@purchaseOrderViewerDataUri" title="@purchaseOrderViewerFileName"></iframe>
                    }
                </div>
            </div>
        </div>
    </div>
}

@code {
    private static readonly int[] DefaultPageSizeOptions = [10, 25, 50, 100, 200];
    private bool IsVanSalesView => NavigationManager.ToBaseRelativePath(NavigationManager.Uri)
        .StartsWith("van-sales-orders", StringComparison.OrdinalIgnoreCase);

    private int _pageSize = 10;
    private int _page = 1;
    private bool showFilters;
    private bool isExporting;
    private bool isBulkApproving;
    private readonly HashSet<int> selectedOrderIds = new();
    private OrderSortKey sortKey = OrderSortKey.Ordered;
    private bool sortDescending = true;
    private List<SalesOrderDto>? orders;
    private SalesOrderDto? selectedOrder;
    private readonly List<DocumentAttachmentDto> purchaseOrderAttachments = new();
    private bool isLoading = true;
    private bool isLoadingPurchaseOrderAttachments;
    private string? errorMessage;
    private string? purchaseOrderAttachmentError;
    private bool showPurchaseOrderViewer;
    private bool isLoadingPurchaseOrderViewer;
    private bool isGeneratingOrderPdf;
    private string? purchaseOrderViewerDataUri;
    private string? purchaseOrderViewerFileName;
    private string? purchaseOrderViewerMimeType;
    private DocumentAttachmentDto? purchaseOrderViewerAttachment;
    private readonly Dictionary<int, OrderActionType> orderActionStates = new();
    private readonly HashSet<int> backgroundPriceRefreshOrderIds = new();
    private readonly object backgroundPriceRefreshLock = new();
    private readonly Dictionary<int, BulkPodValidationResult> podStatusByOrderId = new();
    private readonly HashSet<SalesOrderStatus> availableStatusFilters = new()
    {
        SalesOrderStatus.Draft,
        SalesOrderStatus.Pending,
        SalesOrderStatus.Approved
    };
    private int ordersLoadVersion;
    private const string DeliveredStatusFilterValue = "delivered";
    private const int PodStatusBatchSize = 100;

    private sealed record StatusFilterOption(string Value, string Label);

    private static readonly StatusFilterOption[] AllStatusFilterOptions =
    [
        new("0", "Draft"),
        new("1", "Pending"),
        new("2", "Approved"),
        new("3", "Partially Fulfilled"),
        new("4", "Fulfilled"),
        new(DeliveredStatusFilterValue, "Delivered"),
        new("5", "Cancelled"),
        new("6", "On Hold"),
        new("7", "Rejected")
    ];

    // Filters
    private string? orderNumberFilter;
    private string? customerFilter;
    private DateTime? orderDateFilter;
    private DateTime? deliveryDateFilter;
    private string? statusFilter;
    private string? currencyFilter;
    private string? totalFilter;
    private string? sapDocFilter;

    // Pagination
    private int currentPage = 1;
    private int pageSize = 10000;
    private int totalPages = 1;
    private int totalCount = 0;

    private enum OrderActionType
    {
        View,
        Approve,
        PostToSap,
        ConvertToInvoice,
        UpdateStatus,
        Delete
    }

    private enum OrderSortKey
    {
        Number,
        Customer,
        Ordered,
        Delivery,
        Status,
        Total,
        SapDoc
    }

    protected override async Task OnInitializedAsync()
    {
        _pageSize = ResolveInitialPageSize(AppSettings.PageSize);
        await LoadOrders();
    }

    private void GoToPage(int page)
    {
        _page = Math.Clamp(page, 1, GetVisiblePageCount());
    }

    // Both lists are computed rather than static: the page size can be a value
    // Settings carries that is not one of the five, and the currencies are
    // whichever ones the loaded orders actually use.
    private IEnumerable<NocturneSelectOption<int>> PageSizeSelectOptions =>
        GetPageSizeOptions().Select(size => new NocturneSelectOption<int>(size, size.ToString()));

    private IEnumerable<NocturneSelectOption<string>> CurrencyFilterSelectOptions =>
        GetCurrencyFilterOptions()
            .Select(currency => new NocturneSelectOption<string>(currency, currency))
            .Prepend(new NocturneSelectOption<string>(string.Empty, "All", "neutral") { RuleAfter = true });

    private IEnumerable<int> GetPageSizeOptions()
    {
        if (DefaultPageSizeOptions.Contains(_pageSize))
        {
            return DefaultPageSizeOptions;
        }

        return DefaultPageSizeOptions
            .Append(_pageSize)
            .Where(size => size > 0)
            .Distinct()
            .OrderBy(size => size)
            .ToArray();
    }

    private void ResetToFirstPage()
    {
        _page = 1;
    }

    /// <summary>
    /// The filtered orders in sort order. The list is held whole in memory
    /// (LoadOrders fetches every mobile order in one page), so sorting and
    /// paging are both done here rather than round-tripping to the API.
    /// </summary>
    private List<SalesOrderDto> GetSortedOrders()
    {
        var filtered = GetFilteredOrders();

        // Id descends alongside creation, so it breaks ties into a stable order
        // instead of leaving equal-key rows to shuffle between renders.
        IOrderedEnumerable<SalesOrderDto> sorted = sortKey switch
        {
            OrderSortKey.Number => Order(filtered, order => order.OrderNumber ?? string.Empty),
            OrderSortKey.Customer => Order(filtered, order => order.CardName ?? order.CardCode ?? string.Empty),
            OrderSortKey.Delivery => Order(filtered, order => order.DeliveryDate ?? DateTime.MinValue),
            OrderSortKey.Status => Order(filtered, GetDisplayStatusSortOrder),
            OrderSortKey.Total => Order(filtered, order => order.DocTotal),
            OrderSortKey.SapDoc => Order(filtered, order => order.SAPDocNum ?? 0),
            _ => Order(filtered, order => order.OrderDate)
        };

        return sorted.ThenByDescending(order => order.Id).ToList();

        IOrderedEnumerable<SalesOrderDto> Order<TKey>(IEnumerable<SalesOrderDto> source, Func<SalesOrderDto, TKey> key)
            => sortDescending ? source.OrderByDescending(key) : source.OrderBy(key);
    }

    private List<SalesOrderDto> GetPageOrders()
    {
        if (orders == null)
            return [];

        var sorted = GetSortedOrders();
        var pageCount = Math.Max(1, (sorted.Count + _pageSize - 1) / _pageSize);

        // A page can fall off the end when a filter narrows the list; clamp on
        // read so the table never renders empty with rows still to show.
        if (_page > pageCount)
            _page = pageCount;

        return sorted.Skip((_page - 1) * _pageSize).Take(_pageSize).ToList();
    }

    private void SortBy(OrderSortKey key)
    {
        if (sortKey == key)
        {
            sortDescending = !sortDescending;
        }
        else
        {
            sortKey = key;
            sortDescending = key is OrderSortKey.Ordered or OrderSortKey.Delivery or OrderSortKey.Total or OrderSortKey.SapDoc;
        }

        ResetToFirstPage();
    }

    private string SortMark(OrderSortKey key)
        => sortKey != key ? string.Empty : sortDescending ? "▼" : "▲";

    private string GetRangeLabel(int filteredCount)
    {
        if (filteredCount == 0)
            return "No orders to show";

        var first = ((_page - 1) * _pageSize) + 1;
        var last = Math.Min(_page * _pageSize, filteredCount);
        var narrowed = filteredCount == totalCount
            ? string.Empty
            : $" (filtered from {totalCount:N0})";

        return $"Showing {first:N0}–{last:N0} of {filteredCount:N0} orders{narrowed}";
    }

    private void ToggleFilters()
    {
        showFilters = !showFilters;
    }

    private static int ResolveInitialPageSize(int configuredPageSize)
    {
        return configuredPageSize > 0 ? configuredPageSize : DefaultPageSizeOptions[0];
    }

    private static bool TryParseStatusFilterValue(string? value, out SalesOrderStatus status)
    {
        if (int.TryParse(value, NumberStyles.Integer, CultureInfo.InvariantCulture, out var statusInt)
            && Enum.IsDefined(typeof(SalesOrderStatus), statusInt))
        {
            status = (SalesOrderStatus)statusInt;
            return true;
        }

        status = default;
        return false;
    }

    private static bool IsDeliveredStatusFilterValue(string? value)
        => string.Equals(value, DeliveredStatusFilterValue, StringComparison.OrdinalIgnoreCase);

    private SalesOrderStatus? GetSelectedStatusFilter()
    {
        if (TryParseStatusFilterValue(statusFilter, out var selectedStatus))
            return selectedStatus;

        return null;
    }

    private bool IsDeliveredStatusFilterSelected()
        => IsDeliveredStatusFilterValue(statusFilter);

    private IEnumerable<StatusFilterOption> GetStatusFilterOptions()
    {
        var selectedStatus = GetSelectedStatusFilter();
        if (selectedStatus.HasValue)
        {
            availableStatusFilters.Add(selectedStatus.Value);
        }

        return AllStatusFilterOptions.Where(option =>
        {
            if (IsDeliveredStatusFilterValue(option.Value))
                return IsDeliveredStatusFilterSelected() || HasDeliveredOrders();

            return TryParseStatusFilterValue(option.Value, out var parsedStatus)
                && availableStatusFilters.Contains(parsedStatus);
        });
    }

    private bool HasDeliveredOrders()
        => orders?.Any(IsOrderDelivered) == true;

    /// <summary>
    /// The design's tab strip owns the status filter, so the filter panel has
    /// no status control — one status filter, in one place. "All" is the empty
    /// value the rest of the filter code already treats as unset.
    /// </summary>
    private IEnumerable<StatusFilterOption> GetStatusTabs()
        => new[] { new StatusFilterOption(string.Empty, "All") }.Concat(GetStatusFilterOptions());

    private bool IsStatusTabActive(string? value)
        => string.Equals(statusFilter ?? string.Empty, value ?? string.Empty, StringComparison.OrdinalIgnoreCase);

    private void SelectStatusTab(string? value)
    {
        statusFilter = string.IsNullOrEmpty(value) ? null : value;
        ClearSelection();
        ResetToFirstPage();
    }

    private int CountByStatus(SalesOrderStatus status)
        => orders?.Count(order => order.Status == status) ?? 0;

    private string StatValue(int count) => orders == null ? "—" : count.ToString("N0");

    /// <summary>
    /// The design's "Oldest waiting 3 days" line under the pending tile —
    /// measured from when the submission arrived, not from the order date the
    /// rep keyed.
    /// </summary>
    private string OldestPendingLabel
    {
        get
        {
            if (orders == null)
                return "—";

            var oldest = orders
                .Where(order => order.Status == SalesOrderStatus.Pending)
                .Select(order => (DateTime?)order.CreatedAt)
                .Min();

            if (!oldest.HasValue)
                return "Nothing waiting on review";

            var days = (int)Math.Floor((DateTime.UtcNow - EnsureUtc(oldest.Value)).TotalDays);
            return days switch
            {
                <= 0 => "Oldest arrived today",
                1 => "Oldest waiting 1 day",
                _ => $"Oldest waiting {days} days"
            };
        }
    }

    private static DateTime EnsureUtc(DateTime value)
        => value.Kind == DateTimeKind.Utc ? value : DateTime.SpecifyKind(value, DateTimeKind.Utc);

    private IEnumerable<string> GetCurrencyFilterOptions()
    {
        var options = orders?
            .Select(order => order.Currency?.Trim())
            .Where(currency => !string.IsNullOrWhiteSpace(currency))
            .Select(currency => currency!)
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .OrderBy(currency => currency, StringComparer.OrdinalIgnoreCase)
            .ToList() ?? [];

        if (!string.IsNullOrWhiteSpace(currencyFilter) && !options.Contains(currencyFilter, StringComparer.OrdinalIgnoreCase))
        {
            options.Add(currencyFilter);
            options = options.OrderBy(currency => currency, StringComparer.OrdinalIgnoreCase).ToList();
        }

        return options;
    }

    private IEnumerable<SalesOrderDto> GetFilteredOrders()
    {
        return orders?.Where(MatchesColumnFilters) ?? Enumerable.Empty<SalesOrderDto>();
    }

    private bool MatchesColumnFilters(SalesOrderDto order)
    {
        if (!string.IsNullOrWhiteSpace(orderNumberFilter) &&
            !(order.OrderNumber?.Contains(orderNumberFilter.Trim(), StringComparison.OrdinalIgnoreCase) ?? false))
        {
            return false;
        }

        if (!string.IsNullOrWhiteSpace(customerFilter))
        {
            var customerTerm = customerFilter.Trim();
            var matchesCustomer = (order.CardName?.Contains(customerTerm, StringComparison.OrdinalIgnoreCase) ?? false)
                || (order.CardCode?.Contains(customerTerm, StringComparison.OrdinalIgnoreCase) ?? false);

            if (!matchesCustomer)
            {
                return false;
            }
        }

        if (orderDateFilter.HasValue && order.OrderDate.Date != orderDateFilter.Value.Date)
        {
            return false;
        }

        if (deliveryDateFilter.HasValue
            && (!order.DeliveryDate.HasValue || order.DeliveryDate.Value.Date != deliveryDateFilter.Value.Date))
        {
            return false;
        }

        var selectedStatus = GetSelectedStatusFilter();
        if (IsDeliveredStatusFilterSelected())
        {
            if (!IsOrderDelivered(order))
            {
                return false;
            }
        }
        else if (selectedStatus.HasValue && (IsOrderDelivered(order) || order.Status != selectedStatus.Value))
        {
            return false;
        }

        if (!string.IsNullOrWhiteSpace(currencyFilter) &&
            !string.Equals(order.Currency, currencyFilter, StringComparison.OrdinalIgnoreCase))
        {
            return false;
        }

        if (!string.IsNullOrWhiteSpace(totalFilter))
        {
            var totalTerm = totalFilter.Trim();
            var formattedTotal = order.DocTotal.ToString("N2");
            var compactTotal = order.DocTotal.ToString("0.##");

            if (!formattedTotal.Contains(totalTerm, StringComparison.OrdinalIgnoreCase)
                && !compactTotal.Contains(totalTerm, StringComparison.OrdinalIgnoreCase))
            {
                return false;
            }
        }

        if (!string.IsNullOrWhiteSpace(sapDocFilter))
        {
            var sapDocNumber = order.SAPDocNum?.ToString() ?? string.Empty;
            if (!sapDocNumber.Contains(sapDocFilter.Trim(), StringComparison.OrdinalIgnoreCase))
            {
                return false;
            }
        }

        return true;
    }

    /// <summary>
    /// The filter-panel filters only. Status is not counted: it lives on the
    /// tab strip, where it is already visible, and counting it would light the
    /// Filters button for a choice the user can see.
    /// </summary>
    private bool HasActiveFilters() => ActiveFilterCount > 0;

    private int ActiveFilterCount
    {
        get
        {
            var count = 0;
            if (!string.IsNullOrWhiteSpace(orderNumberFilter)) count++;
            if (!string.IsNullOrWhiteSpace(customerFilter)) count++;
            if (orderDateFilter.HasValue) count++;
            if (deliveryDateFilter.HasValue) count++;
            if (!string.IsNullOrWhiteSpace(currencyFilter)) count++;
            if (!string.IsNullOrWhiteSpace(totalFilter)) count++;
            if (!string.IsNullOrWhiteSpace(sapDocFilter)) count++;
            return count;
        }
    }

    private int GetVisibleOrderCount()
    {
        return GetFilteredOrders().Count();
    }

    private int GetVisiblePageCount()
    {
        var visibleCount = GetVisibleOrderCount();
        return Math.Max(1, (visibleCount + _pageSize - 1) / _pageSize);
    }

    private void TrackAvailableStatusFilters(IEnumerable<SalesOrderDto>? loadedOrders)
    {
        if (loadedOrders == null)
            return;

        foreach (var status in loadedOrders.Select(order => order.Status).Distinct())
        {
            availableStatusFilters.Add(status);
        }
    }

    private async Task LoadOrders()
    {
        var loadVersion = System.Threading.Interlocked.Increment(ref ordersLoadVersion);
        isLoading = true;
        errorMessage = null;

        try
        {
            var response = await SalesOrderService.GetSalesOrdersAsync(
                currentPage,
                pageSize,
                source: SalesOrderSource.Mobile,
                vanSalesUsersOnly: IsVanSalesView ? true : null);
            if (loadVersion != ordersLoadVersion)
                return;

            if (response != null)
            {
                orders = response.Orders;
                totalCount = response.TotalCount;
                totalPages = response.TotalPages;
                TrackAvailableStatusFilters(orders);
                PruneSelection();

                await PopulateMissingOrderPricesAsync(orders, loadVersion);
                if (loadVersion != ordersLoadVersion)
                    return;

                _ = LoadOrderPodStatusesInBackgroundAsync(loadVersion);
            }
            else
            {
                errorMessage = "Failed to load mobile orders.";
            }
        }
        catch (Exception ex)
        {
            if (loadVersion != ordersLoadVersion)
                return;

            errorMessage = $"Error: {ex.Message}";
        }
        finally
        {
            if (loadVersion == ordersLoadVersion)
            {
                isLoading = false;
            }
        }
    }

    private async Task LoadOrderPodStatusesInBackgroundAsync(int loadVersion)
    {
        var currentOrders = orders;
        if (currentOrders == null)
            return;

        await LoadOrderPodStatusesAsync(currentOrders, loadVersion);
        if (loadVersion != ordersLoadVersion)
            return;

        await RefreshSelectedOrderAsync();

        if (loadVersion == ordersLoadVersion)
            await InvokeAsync(StateHasChanged);
    }

