                            </tbody>
                            <tfoot>
                                <tr>
                                    <td colspan="5" class="mox-num">Item count</td>
                                    <td class="mox-num">@FormatOrderItemCount(selectedOrder)</td>
                                </tr>
                                <tr>
                                    <td colspan="5" class="mox-num">Subtotal</td>
                                    <td class="mox-num">@selectedOrder.SubTotal.ToString("N2")</td>
                                </tr>
                                <tr>
                                    <td colspan="5" class="mox-num">Tax</td>
                                    <td class="mox-num">@selectedOrder.TaxAmount.ToString("N2")</td>
                                </tr>
                            </tfoot>
                        </table>
                    </div>

                    <div class="mox-grand">
                        <span class="mox-grand-label">Total</span>
                        <span class="mox-grand-value">@selectedOrder.Currency @selectedOrder.DocTotal.ToString("N2")</span>
                    </div>
                }
            </div>

            <div class="mox-drawer-foot">
                <button type="button" class="mox-btn mox-btn-secondary" disabled="@isGeneratingOrderPdf"
                        @onclick="CreateSelectedOrderPdfAsync">
                    @if (isGeneratingOrderPdf)
                    {
                        <span class="mox-spin" aria-hidden="true"></span>
                        <span>Creating PDF…</span>
                    }
                    else
                    {
                        <span>Create PDF</span>
                    }
                </button>
                @if (CanViewSelectedOrderPod())
                {
                    <button type="button" class="mox-btn mox-btn-secondary" @onclick="NavigateToSelectedOrderPod">
                        View POD
                    </button>
                }
                @if (CanEditSelectedOrder())
                {
                    <button type="button" class="mox-btn mox-btn-secondary"
                            disabled="@IsOrderActionBusy(selectedOrder.Id)"
                            @onclick="() => NavigateToEdit(selectedOrder.Id)">
                        Edit
                    </button>
                    <AuthorizeView Roles="Admin,Cashier,SalesRep" Context="drawerApproveAccess">
                        <Authorized>
                            <button type="button" class="mox-btn mox-btn-primary"
                                    disabled="@IsOrderActionBusy(selectedOrder.Id)"
                                    @onclick="() => ApproveOrder(selectedOrder.Id)">
                                @if (IsOrderActionBusy(selectedOrder.Id, OrderActionType.Approve))
                                {
                                    <span class="mox-spin" aria-hidden="true"></span>
                                    <span>Approving…</span>
                                }
                                else
                                {
                                    <span>Approve</span>
                                }
                            </button>
                        </Authorized>
                    </AuthorizeView>
                }
                @if (CanPostSelectedOrderToSap())
                {
                    <AuthorizeView Roles="Admin,Cashier,SalesRep" Context="drawerPostAccess">
                        <Authorized>
                            <button type="button" class="mox-btn mox-btn-primary"
                                    disabled="@IsOrderActionBusy(selectedOrder.Id)"
                                    @onclick="() => PostOrderToSAP(selectedOrder.Id)">
                                @if (IsOrderActionBusy(selectedOrder.Id, OrderActionType.PostToSap))
                                {
                                    <span class="mox-spin" aria-hidden="true"></span>
                                    <span>Posting…</span>
                                }
                                else
                                {
                                    <span>Post to SAP</span>
                                }
                            </button>
                        </Authorized>
                    </AuthorizeView>
                }
                <button type="button" class="mox-btn mox-btn-ghost" @onclick="ClearSelectedOrder">Close</button>
            </div>
        </aside>
    </div>
}

@if (showPurchaseOrderViewer)
{
    <div class="mox-overlay">
        <div class="mox-viewer-wrap" @onclick="ClosePurchaseOrderViewer">
            <div class="mox-viewer" @onclick:stopPropagation>
                <div class="mox-viewer-head">
                    <h2 class="mox-viewer-name">@purchaseOrderViewerFileName</h2>
                    <button type="button" class="mox-btn mox-btn-secondary mox-btn-sm"
