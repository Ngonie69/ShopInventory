@page "/mobile-drafts"
@page "/van-sales-orders"
@using System.Globalization
@using Microsoft.AspNetCore.Authorization
@using MudBlazor
@attribute [Authorize(Roles = "Admin,Cashier,Merchandiser,SalesRep")]
@inject ISalesOrderService SalesOrderService
@inject IPodService PodService
@inject IPurchaseOrderService PurchaseOrderService
@inject NavigationManager NavigationManager
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject IJSRuntime JS
@inject ILogger<MobileDrafts> Logger
@inject IAppSettingsProvider AppSettings
@inject IPriceService PriceService
@inject IReportExportService ExportService
@rendermode InteractiveServer

<PageTitle>@(IsVanSalesView ? "Van Sales Orders - Shop Inventory" : "Mobile Orders - Shop Inventory")</PageTitle>

@* The imported Nocturne design (Mobile Orders.dc.html) is dark;
   wwwroot/css/mobile-orders.css — linked from App.razor — carries it and its
   light counterpart, and follows the app's theme toggle like every other page.

   The import draws the sidebar and the top search bar as well. Those are the
   app's own chrome, already built, so only the content column is rebuilt here.

   Row actions draw their glyph as inline SVG rather than from the Phosphor
   font: the glyph is the button's whole label, so a font that failed to load
   would leave them reading as dead controls. *@

@{
    var pageOrders = GetPageOrders();
    var filteredCount = GetVisibleOrderCount();
}

<div class="mox">

    <header class="mox-head">
        <div class="mox-shell">
            <div class="mox-titles">
                <div class="mox-kicker">Sales &amp; billing</div>
                <h1 class="mox-title">@(IsVanSalesView ? "Van Sales Orders" : "Mobile Orders")</h1>
                <p class="mox-sub">
                    @(IsVanSalesView
                        ? "ADR and sales-person orders captured against route customers, waiting on review before they post to SAP."
                        : "Sales orders submitted from the field app, waiting on review before they post to SAP.")
                </p>
            </div>
            <div class="mox-head-actions">
                <button type="button" class="mox-btn mox-btn-secondary" title="Download the listed orders as a workbook"
                        disabled="@(isExporting || filteredCount == 0)" @onclick="ExportToExcel">
                    @if (isExporting)
                    {
                        <span class="mox-spin" aria-hidden="true"></span>
                        <span>Exporting…</span>
                    }
                    else
                    {
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"
                             stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <path d="M6 3h8l5 5v13H6z"></path>
                            <path d="M14 3v5h5"></path>
                            <path d="M9.5 12.5l5 5M14.5 12.5l-5 5"></path>
                        </svg>
                        <span>@ExportLabel</span>
                    }
                </button>
            </div>
        </div>
        <div class="mox-rule"></div>
    </header>

    <div class="mox-body">

        @if (!string.IsNullOrEmpty(errorMessage))
        {
            <div class="mox-alert" role="alert">
                <i class="ph ph-warning-octagon" aria-hidden="true"></i>
                <div class="mox-alert-body">@errorMessage</div>
                <button type="button" class="mox-iconbtn" title="Dismiss" aria-label="Dismiss error"
                        @onclick="() => errorMessage = null">
                    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"></path></svg>
                </button>
            </div>
        }

        @* Counts read "—" until the orders are in, rather than showing four
           zeroes that are about to jump. *@
        <section class="mox-stats">
            <div class="mox-stat is-lead">
                <div class="mox-stat-label"><span class="mox-stat-mark"></span>Total orders</div>
                <div class="mox-stat-value">@StatValue(totalCount)</div>
                <div class="mox-stat-foot">@(IsVanSalesView ? "All time, van sales" : "All time, mobile app")</div>
            </div>
            <div class="mox-stat">
                <div class="mox-stat-label"><span class="mox-stat-mark"></span>Draft</div>
                <div class="mox-stat-value is-quiet">@StatValue(CountByStatus(SalesOrderStatus.Draft))</div>
                <div class="mox-stat-foot">Not yet submitted</div>
            </div>
            <div class="mox-stat is-live">
                <div class="mox-stat-label"><span class="mox-stat-pip"></span>Pending review</div>
                <div class="mox-stat-value">@StatValue(CountByStatus(SalesOrderStatus.Pending))</div>
                <div class="mox-stat-foot">@OldestPendingLabel</div>
            </div>
            <div class="mox-stat">
                <div class="mox-stat-label"><span class="mox-stat-mark"></span>Approved</div>
                <div class="mox-stat-value is-quiet">@StatValue(CountByStatus(SalesOrderStatus.Approved))</div>
                <div class="mox-stat-foot">Posted to SAP</div>
            </div>
        </section>

        <section class="mox-card">

            <div class="mox-toolbar">
                <div class="mox-tabs" role="group" aria-label="Filter by status">
                    @foreach (var tab in GetStatusTabs())
                    {
                        <button type="button" class="mox-tab @(IsStatusTabActive(tab.Value) ? "is-on" : null)"
                                aria-pressed="@IsStatusTabActive(tab.Value)"
                                @onclick="() => SelectStatusTab(tab.Value)">
                            @tab.Label
                        </button>
                    }
                </div>
                <span class="mox-shown">@filteredCount.ToString("N0") shown</span>

                <div class="mox-toolbar-right">
                    @if (SelectedOrderCount > 0)
                    {
                        <div class="mox-selbar">
                            <span class="mox-selcount">@SelectedOrderCount selected</span>
                            <button type="button" class="mox-btn mox-btn-sm mox-btn-solid"
                                    title="@BulkApproveTitle" disabled="@(!CanBulkApprove)"
                                    @onclick="BulkApproveSelected">
                                @if (isBulkApproving)
                                {
                                    <span class="mox-spin" aria-hidden="true"></span>
                                    <span>Approving…</span>
                                }
                                else
                                {
                                    <span>Approve</span>
                                }
                            </button>
                            <button type="button" class="mox-btn mox-btn-sm mox-btn-ghost" @onclick="ClearSelection">
                                Clear
                            </button>
                        </div>
                    }
                    <button type="button" class="mox-btn mox-btn-secondary mox-btn-pill"
                            aria-expanded="@showFilters" @onclick="ToggleFilters">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"
                             stroke-linecap="round" aria-hidden="true">
                            <path d="M4 6h16M7 12h10M10 18h4"></path>
                        </svg>
                        <span>Filters</span>
                        @if (ActiveFilterCount > 0)
                        {
                            <span class="mox-filter-count">@ActiveFilterCount</span>
                        }
                    </button>
                </div>
            </div>

            @if (showFilters)
            {
                <section class="mox-filters">
                    <div class="mox-field" style="width:148px">
                        <label for="mox-f-number">Order #</label>
                        <input id="mox-f-number" class="mox-input mox-input-num" type="text" placeholder="SO-…"
                               @bind="orderNumberFilter" @bind:event="oninput" @bind:after="ResetToFirstPage" />
                    </div>
                    <div class="mox-field" style="width:210px">
                        <label for="mox-f-customer">Customer</label>
                        <input id="mox-f-customer" class="mox-input" type="text" placeholder="Name or code"
                               @bind="customerFilter" @bind:event="oninput" @bind:after="ResetToFirstPage" />
                    </div>
                    <div class="mox-field" style="width:146px">
                        <label for="mox-f-ordered">Order date</label>
                        <NocturneDateField Id="mox-f-ordered" @bind-Date="orderDateFilter"
                                           @bind-Date:after="ResetToFirstPage" />
                    </div>
                    <div class="mox-field" style="width:146px">
                        <label for="mox-f-delivery">Delivery</label>
                        <NocturneDateField Id="mox-f-delivery" @bind-Date="deliveryDateFilter"
                                           @bind-Date:after="ResetToFirstPage" />
                    </div>
                    <div class="mox-field" style="width:118px">
                        <label for="mox-f-currency">Currency</label>
                        <NocturneSelect Id="mox-f-currency" Class="nsel-block" TValue="string"
                                        Options="CurrencyFilterSelectOptions" @bind-Value="currencyFilter"
                                        OnChanged="ResetToFirstPage" Caption="Filter by currency"
                                        AriaLabel="Filter by currency" Placeholder="All" />
                    </div>
                    <div class="mox-field" style="width:130px">
                        <label for="mox-f-total">Total</label>
                        <input id="mox-f-total" class="mox-input mox-input-num" type="text" placeholder="Amount"
                               @bind="totalFilter" @bind:event="oninput" @bind:after="ResetToFirstPage" />
                    </div>
                    <div class="mox-field" style="width:130px">
                        <label for="mox-f-sap">SAP doc #</label>
                        <input id="mox-f-sap" class="mox-input mox-input-num" type="text" placeholder="SAP #"
                               @bind="sapDocFilter" @bind:event="oninput" @bind:after="ResetToFirstPage" />
                    </div>
                    <div class="mox-filter-actions">
                        <button type="button" class="mox-btn mox-btn-ghost" disabled="@(!HasActiveFilters())"
                                @onclick="ClearFilter">
                            Clear filters
                        </button>
                    </div>
                </section>
            }

            <div class="mox-tablewrap">
                <table class="mox-table">
                    <thead>
                        <tr>
                            <th>
                                <input class="mox-check" type="checkbox" title="Select the orders on this page"
                                       aria-label="Select the orders on this page"
                                       disabled="@(pageOrders.Count == 0)"
                                       checked="@AreAllPageOrdersSelected(pageOrders)"
                                       @onchange="() => ToggleAllPageOrders(pageOrders)" />
                            </th>
                            <th class="mox-th-sort" @onclick="() => SortBy(OrderSortKey.Number)">
                                Order #<span class="mox-sort-mark">@SortMark(OrderSortKey.Number)</span>
                            </th>
                            <th class="mox-th-sort" @onclick="() => SortBy(OrderSortKey.Customer)">
                                Customer<span class="mox-sort-mark">@SortMark(OrderSortKey.Customer)</span>
                            </th>
                            <th class="mox-th-sort" @onclick="() => SortBy(OrderSortKey.Ordered)">
                                Ordered<span class="mox-sort-mark">@SortMark(OrderSortKey.Ordered)</span>
                            </th>
                            <th class="mox-th-sort" @onclick="() => SortBy(OrderSortKey.Delivery)">
                                Delivery<span class="mox-sort-mark">@SortMark(OrderSortKey.Delivery)</span>
                            </th>
                            <th class="mox-th-sort" @onclick="() => SortBy(OrderSortKey.Status)">
                                Status<span class="mox-sort-mark">@SortMark(OrderSortKey.Status)</span>
                            </th>
                            <th>Ccy</th>
                            <th class="mox-th-sort mox-num" @onclick="() => SortBy(OrderSortKey.Total)">
                                Total<span class="mox-sort-mark">@SortMark(OrderSortKey.Total)</span>
                            </th>
                            <th class="mox-th-sort" @onclick="() => SortBy(OrderSortKey.SapDoc)">
                                SAP doc<span class="mox-sort-mark">@SortMark(OrderSortKey.SapDoc)</span>
                            </th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (isLoading)
                        {
                            @for (var skeletonRow = 0; skeletonRow < 8; skeletonRow++)
                            {
                                <tr>
                                    @for (var skeletonCell = 0; skeletonCell < 10; skeletonCell++)
                                    {
                                        <td><div class="mox-skel"></div></td>
                                    }
                                </tr>
                            }
                        }
                        else if (pageOrders.Count == 0)
                        {
                            <tr>
                                <td colspan="10">
                                    <div class="mox-empty">
                                        <i class="ph ph-device-mobile" aria-hidden="true"></i>
                                        @if (orders?.Any() == true)
                                        {
                                            <strong>No orders match these filters</strong>
                                            <span>Switch tab or clear the filters to see more orders.</span>
                                            <button type="button" class="mox-btn mox-btn-secondary"
                                                    disabled="@(!HasActiveFilters() && IsStatusTabActive(null))"
                                                    @onclick="ResetAllFilters">
                                                Reset filters
                                            </button>
                                        }
                                        else
                                        {
                                            <strong>No mobile orders yet</strong>
                                            <span>Orders submitted from the mobile app will appear here for review.</span>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var order in pageOrders)
                            {
                                <tr class="@(IsOrderSelected(order.Id) ? "is-selected" : null)">
                                    <td>
                                        <input class="mox-check" type="checkbox"
                                               aria-label="@($"Select order {order.OrderNumber}")"
                                               checked="@IsOrderSelected(order.Id)"
                                               @onchange="() => ToggleOrderSelection(order.Id)" />
                                    </td>
                                    <td>
                                        <button type="button" class="mox-docnum" title="View this order"
                                                @onclick="() => ViewOrder(order)">
                                            @order.OrderNumber
                                        </button>
                                        <span class="mox-sync @(order.IsSynced ? null : "is-queued")"
                                              title="@(order.IsSynced ? "Posted to SAP" : "Not yet posted to SAP")">
                                            <span class="mox-sync-dot"></span>@(order.IsSynced ? "Synced" : "Queued")
                                        </span>
                                    </td>
                                    <td>
                                        <div class="mox-cust">
                                            <span class="mox-cust-name" title="@order.CardName">@order.CardName</span>
                                            <span class="mox-cust-meta">@order.CardCode@(GetLineCountSuffix(order))</span>
                                        </div>
                                    </td>
                                    <td class="mox-when">
                                        @order.OrderDate.ToString("dd MMM yyyy")
                                        <span class="mox-when-at">@IAuditService.ToCAT(order.CreatedAt).ToString("HH:mm") CAT</span>
                                    </td>
                                    <td class="mox-when">@(order.DeliveryDate?.ToString("dd MMM yyyy") ?? "—")</td>
                                    <td>
                                        <span class="mox-status @GetStatusToneClass(order)">
                                            <span class="mox-dot"></span>@GetDisplayStatusName(order)
                                        </span>
                                    </td>
                                    <td><span class="mox-ccy">@order.Currency</span></td>
                                    <td class="mox-num mox-total">@order.DocTotal.ToString("N2")</td>
                                    <td>
                                        <span class="@GetSapDocClass(order)">@GetSapDocLabel(order)</span>
                                    </td>
                                    <td>
                                        <div class="mox-rowactions">
                                            <button type="button" class="mox-iconbtn" title="View details"
                                                    disabled="@IsOrderActionBusy(order.Id)"
                                                    @onclick="() => ViewOrder(order)">
                                                @if (IsOrderActionBusy(order.Id, OrderActionType.View))
                                                {
                                                    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M7 3h10M7 21h10M8 3v4l4 4 4-4V3M8 21v-4l4-4 4 4v4"></path></svg>
                                                }
                                                else
                                                {
                                                    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M2 12s3.6-6 10-6 10 6 10 6-3.6 6-10 6-10-6-10-6z"></path><circle cx="12" cy="12" r="2.6"></circle></svg>
                                                }
                                            </button>
                                            @if (CanViewOrderPod(order))
                                            {
                                                <button type="button" class="mox-iconbtn" title="View POD"
                                                        disabled="@IsOrderActionBusy(order.Id)"
                                                        @onclick="() => NavigateToPod(order)">
                                                    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 7h11v9H3z"></path><path d="M14 10h4l3 3v3h-7"></path><path d="M7 19a2 2 0 1 0 0-.01M18 19a2 2 0 1 0 0-.01"></path></svg>
                                                </button>
                                            }
                                            @if (SalesOrderActions.CanEdit(order))
                                            {
                                                <button type="button" class="mox-iconbtn" title="Edit"
                                                        disabled="@IsOrderActionBusy(order.Id)"
                                                        @onclick="() => NavigateToEdit(order.Id)">
                                                    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 20h4L19 9a2.1 2.1 0 0 0-3-3L5 17z"></path></svg>
                                                </button>
                                            }
                                            <AuthorizeView Roles="Admin,Cashier" Context="invoiceAccess">
                                                <Authorized>
                                                    @if (order.Status == SalesOrderStatus.Approved && order.InvoiceId == null)
                                                    {
                                                        <button type="button" class="mox-iconbtn" title="Convert to invoice"
                                                                disabled="@IsOrderActionBusy(order.Id)"
                                                                @onclick="() => ConvertToInvoice(order)">
                                                            @if (IsOrderActionBusy(order.Id, OrderActionType.ConvertToInvoice))
                                                            {
                                                                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M7 3h10M7 21h10M8 3v4l4 4 4-4V3M8 21v-4l4-4 4 4v4"></path></svg>
                                                            }
                                                            else
                                                            {
                                                                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 3h12v18l-3-2-3 2-3-2-3 2z"></path><path d="M9 8h6M9 12h6"></path></svg>
                                                            }
                                                        </button>
                                                    }
                                                </Authorized>
                                            </AuthorizeView>
                                            @if (!order.IsSynced)
                                            {
                                                <AuthorizeView Roles="Admin,Cashier,SalesRep" Context="approveAccess">
                                                    <Authorized>
                                                        @if (SalesOrderActions.CanApprove(order))
                                                        {
                                                            <button type="button" class="mox-iconbtn is-accent" title="Approve"
                                                                    disabled="@IsOrderActionBusy(order.Id)"
                                                                    @onclick="() => ApproveOrder(order.Id)">
                                                                @if (IsOrderActionBusy(order.Id, OrderActionType.Approve))
                                                                {
                                                                    <span class="mox-spin" aria-hidden="true"></span>
                                                                }
                                                                else
                                                                {
                                                                    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12.5l4.5 4.5L19 7"></path></svg>
                                                                }
                                                            </button>
                                                        }
                                                    </Authorized>
                                                </AuthorizeView>
                                                <AuthorizeView Roles="Admin,Cashier,SalesRep" Context="statusActionAccess">
                                                    <Authorized>
                                                        @if (SalesOrderActions.CanCancel(order))
                                                        {
                                                            <button type="button" class="mox-iconbtn is-bad" title="Cancel"
                                                                    disabled="@IsOrderActionBusy(order.Id)"
                                                                    @onclick="() => CancelOrder(order.Id)">
                                                                @if (IsOrderActionBusy(order.Id, OrderActionType.UpdateStatus))
                                                                {
                                                                    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M7 3h10M7 21h10M8 3v4l4 4 4-4V3M8 21v-4l4-4 4 4v4"></path></svg>
                                                                }
                                                                else
                                                                {
                                                                    <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="9"></circle><path d="M5.6 5.6l12.8 12.8"></path></svg>
                                                                }
                                                            </button>
                                                        }
                                                        @if (SalesOrderActions.CanRestoreToDraft(order))
                                                        {
                                                            <button type="button" class="mox-iconbtn" title="Back to draft"
                                                                    disabled="@IsOrderActionBusy(order.Id)"
                                                                    @onclick="() => RestoreOrderToDraft(order.Id)">
                                                                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 9h11a5 5 0 0 1 0 10H9"></path><path d="M8 5L4 9l4 4"></path></svg>
                                                            </button>
                                                        }
                                                    </Authorized>
                                                </AuthorizeView>
                                                <AuthorizeView Roles="Admin" Context="deleteAccess">
                                                    <Authorized>
                                                        @if (SalesOrderActions.CanDelete(order))
                                                        {
                                                            <button type="button" class="mox-iconbtn is-bad" title="Delete"
                                                                    disabled="@IsOrderActionBusy(order.Id)"
                                                                    @onclick="() => DeleteOrder(order.Id)">
                                                                @if (IsOrderActionBusy(order.Id, OrderActionType.Delete))
                                                                {
                                                                    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M7 3h10M7 21h10M8 3v4l4 4 4-4V3M8 21v-4l4-4 4 4v4"></path></svg>
                                                                }
                                                                else
                                                                {
                                                                    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 7h16"></path><path d="M9 7V5h6v2"></path><path d="M6 7l1 13h10l1-13"></path></svg>
                                                                }
                                                            </button>
                                                        }
                                                    </Authorized>
                                                </AuthorizeView>
                                            }
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>

            <div class="mox-foot">
                <span class="mox-foot-range">@GetRangeLabel(filteredCount)</span>
                <div class="mox-pagesize">
                    <span>Rows</span>
                    <NocturneSelect Class="nsel-sm nsel-end nsel-up" Options="PageSizeSelectOptions"
                                    @bind-Value="_pageSize" OnChanged="ResetToFirstPage"
                                    AriaLabel="Rows per page" />
                </div>
                <div class="mox-pager">
                    <button type="button" class="mox-btn mox-btn-secondary mox-btn-sm"
                            disabled="@(_page <= 1)" @onclick="() => GoToPage(_page - 1)">
                        Previous
                    </button>
                    <span class="mox-page-label">Page @_page of @GetVisiblePageCount()</span>
                    <button type="button" class="mox-btn mox-btn-secondary mox-btn-sm"
                            disabled="@(_page >= GetVisiblePageCount())" @onclick="() => GoToPage(_page + 1)">
                        Next
                    </button>
                </div>
            </div>

        </section>
    </div>
</div>

@if (selectedOrder != null)
{
    <div class="mox-overlay">
        <div class="mox-scrim" @onclick="ClearSelectedOrder"></div>
        <aside class="mox-drawer" aria-label="Mobile order detail">
            <div class="mox-drawer-head">
                <h2 class="mox-drawer-title">
                    <i class="ph ph-device-mobile" aria-hidden="true"></i>
                    <span>@selectedOrder.OrderNumber</span>
                </h2>
                <span class="mox-status @GetSelectedOrderToneClass()">
                    <span class="mox-dot"></span>@GetSelectedOrderStatusName()
                </span>
                <button type="button" class="mox-iconbtn" title="Close" aria-label="Close"
                        @onclick="ClearSelectedOrder">
                    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"></path></svg>
                </button>
            </div>

            <div class="mox-drawer-body">
                <div class="mox-grid">
                    <div>
                        <div class="mox-dt">Customer</div>
                        <div class="mox-dd">@selectedOrder.CardCode — @selectedOrder.CardName</div>
                    </div>
                    <div>
                        <div class="mox-dt">Order date</div>
                        <div class="mox-dd">@selectedOrder.OrderDate.ToString("dd MMM yyyy")</div>
                    </div>
                    <div>
                        <div class="mox-dt">Received from mobile</div>
                        <div class="mox-dd">@IAuditService.ToCAT(selectedOrder.CreatedAt).ToString("dd MMM yyyy HH:mm") CAT</div>
                    </div>
                    <div>
                        <div class="mox-dt">Delivery date</div>
                        <div class="mox-dd">@(selectedOrder.DeliveryDate?.ToString("dd MMM yyyy") ?? "Not set")</div>
                    </div>
                    <div>
                        <div class="mox-dt">Currency</div>
                        <div class="mox-dd">@selectedOrder.Currency</div>
                    </div>
                    <div>
                        <div class="mox-dt">Submitted by</div>
                        <div class="mox-dd">@GetSubmittedByName(selectedOrder)</div>
                    </div>
                    <div>
                        <div class="mox-dt">Device</div>
                        <div class="mox-dd">@GetDeviceLabel(selectedOrder)</div>
                    </div>
                    <div>
                        <div class="mox-dt">Customer PO ref</div>
                        <div class="mox-dd">@(string.IsNullOrWhiteSpace(selectedOrder.CustomerRefNo) ? "—" : selectedOrder.CustomerRefNo)</div>
                    </div>
                    @if (selectedOrder.SAPDocNum.HasValue)
                    {
                        <div>
                            <div class="mox-dt">SAP document #</div>
                            <div class="mox-dd mox-num" style="text-align:left">@selectedOrder.SAPDocNum</div>
                        </div>
                    }
                    @if (GetSelectedOrderInvoiceDocNum().HasValue)
                    {
                        <div>
