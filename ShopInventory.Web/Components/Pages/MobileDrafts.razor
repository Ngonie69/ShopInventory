                    else
                    {
                        @foreach (var attachment in purchaseOrderAttachments)
                        {
                            <div class="mox-file">
                                <div style="min-width:0">
                                    <div class="mox-file-name">@attachment.FileName</div>
                                    <div class="mox-file-meta">
                                        @attachment.FileSizeFormatted
                                        @if (!string.IsNullOrWhiteSpace(attachment.UploadedByUserName))
                                        {
                                            <span> · @attachment.UploadedByUserName</span>
                                        }
                                        <span> · @IAuditService.ToCAT(attachment.UploadedAt).ToString("dd MMM yyyy HH:mm")</span>
                                    </div>
                                    @if (!string.IsNullOrWhiteSpace(attachment.Description))
                                    {
                                        <div class="mox-file-meta">@attachment.Description</div>
                                    }
