@page "/lab/batch-status"
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize(Roles = "Admin,Lab")]
@rendermode InteractiveServer

<PageTitle>Batch Status Control - Shop Inventory</PageTitle>

@* Styles live in wwwroot/css/batch-status.css (linked from App.razor) and are shared with
   /lab/batch-status/history — the two pages are one design. The import (Batch Status
   Control.dc.html) is drawn as a dark scheme; the stylesheet carries a daylight palette
   alongside it, so this page follows the app's light/dark toggle. *@

<div class="bsc">

    <!-- ── Header ─────────────────────────────────────────────────────── -->
    <header class="bsc-header">
        <div class="bsc-header-inner">
            <div class="bsc-header-title">
                <div class="bsc-kicker"><i class="ph ph-flask"></i><span>Lab operations</span></div>
                <h1>Batch Status Control</h1>
            </div>
            <div class="bsc-header-actions">
                <a class="bsc-btn bsc-btn-ghost" href="/lab/batch-status/history">
                    <i class="ph ph-clock-counter-clockwise"></i>Status history
                </a>
            </div>
        </div>
        <div class="bsc-rule"></div>
    </header>

    <div class="bsc-body">

        <!-- ── What the page does, and the query it runs on ───────────── -->
        <section class="bsc-intro">
            <p>
                Search a batch number to review the stock rows that still carry quantity on hand, then move the
                SAP batch status from this page. Results are limited to the first @ResultLimit in-stock matches.
            </p>
            <div class="bsc-search">
                <div class="bsc-field">
                    <label for="bsc-batch-search">Batch number</label>
                    <div class="bsc-field-control">
                        <i class="ph ph-magnifying-glass"></i>
                        <input id="bsc-batch-search" class="bsc-input has-icon" @bind="searchTerm"
                               @bind:event="oninput" @onkeydown="HandleSearchKeyDown"
                               placeholder="e.g. ICC001" />
                    </div>
                </div>
                <button type="button" class="bsc-btn bsc-btn-primary" disabled="@isSearching"
                        @onclick="SearchAsync">
                    @if (isSearching)
                    {
                        <span class="bsc-spin"></span>
                    }
                    @(isSearching ? "Searching" : "Search")
                </button>
            </div>
        </section>

        <!-- ── Results ────────────────────────────────────────────────── -->
        <section class="bsc-card">

            <div class="bsc-card-head">
                <div class="bsc-card-head-text">
                    <h2>Results</h2>
                    <p>One row per SAP stock record — a batch repeats when it sits in several warehouses.</p>
                </div>
                @if (results.Count > 0)
                {
                    <div class="bsc-card-head-meta">
                        <span class="bsc-count">@CountLabel</span>
                        @if (PendingCount > 0)
                        {
                            <button type="button" class="bsc-btn bsc-btn-primary bsc-btn-sm"
                                    disabled="@isApplyingAll" @onclick="ApplyAllAsync">
                                @if (isApplyingAll)
                                {
                                    <span class="bsc-spin"></span>
                                }
                                else
                                {
                                    <i class="ph ph-check"></i>
                                }
                                Apply @PendingCount change@(PendingCount == 1 ? "" : "s")
                            </button>
                        }
                    </div>
                }
            </div>

            @if (isSearching && results.Count == 0)
            {
                <div class="bsc-loading">
                    <span class="bsc-spin bsc-spin-lg"></span>
                    <span>Searching batches…</span>
                </div>
            }
            else if (results.Count == 0)
            {
                <div class="bsc-empty">
                    <i class="ph ph-package"></i>
                    @if (!hasSearched)
                    {
                        <span class="bsc-empty-title">Search a batch number to begin</span>
                        <span class="bsc-empty-hint">Any part of the batch number works — a prefix is enough.</span>
                    }
                    else
                    {
                        <span class="bsc-empty-title">No in-stock rows for that batch number</span>
                        <span class="bsc-empty-hint">Nothing with quantity on hand matched <strong>@lastSearchTerm</strong> — try a shorter prefix.</span>
                    }
                </div>
            }
            else
            {
                <div class="bsc-table-wrap">
                    <table class="bsc-table">
                        <thead>
                            <tr>
                                <th class="bsc-col-first">Batch</th>
                                <th>Item</th>
                                <th>Warehouse</th>
                                <th class="bsc-col-num">Qty on hand</th>
                                <th>Status</th>
                                <th class="bsc-col-nowrap">Change to</th>
                                <th class="bsc-col-action bsc-col-last"></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in PageItems)
                            {
                                var isDirty = IsDirty(item);
                                <tr class="@(isDirty ? "is-dirty" : null)">
                                    <td class="bsc-col-first">
                                        <div class="bsc-stack bsc-stack-batch">
                                            <span class="bsc-strong-mono">@item.BatchNumber</span>
                                            @if (!string.IsNullOrWhiteSpace(item.ExpiryDate))
                                            {
                                                <span class="bsc-sub">Expires @FormatDate(item.ExpiryDate)</span>
                                            }
                                        </div>
                                    </td>
                                    <td>
                                        <div class="bsc-stack">
                                            <span class="bsc-strong">@item.ItemCode</span>
                                            @if (!string.IsNullOrWhiteSpace(item.ItemName))
                                            {
                                                <span class="bsc-sub">@item.ItemName</span>
                                            }
                                        </div>
                                    </td>
                                    <td class="bsc-warehouse">@item.WarehouseCode</td>
                                    <td class="bsc-col-num">@FormatQuantity(item.Quantity)</td>
                                    <td>
                                        <span class="bsc-status @GetStatusToneClass(item.Status)">@GetStatusLabel(item.Status)</span>
                                    </td>
                                    <td>
                                        <div class="bsc-select-wrap">
                                            <select class="bsc-input bsc-select" @bind="item.PendingStatus"
                                                    aria-label="@($"New status for batch {item.BatchNumber} in {item.WarehouseCode}")">
                                                @if (!IsSelectableStatus(item.Status))
                                                {
                                                    @* The batch carries a status SAP does not let us set back
                                                       (typically Unknown), so it is shown but not offered. *@
                                                    <option value="@item.Status" disabled>@GetStatusLabel(item.Status)</option>
                                                }
                                                @foreach (var option in StatusOptions)
                                                {
                                                    <option value="@option.Value">@option.Label</option>
                                                }
                                            </select>
                                            <i class="ph ph-caret-down"></i>
                                        </div>
                                    </td>
                                    <td class="bsc-col-action bsc-col-last">
                                        @if (IsUpdating(item.BatchEntryId))
                                        {
                                            <span class="bsc-updated"><span class="bsc-spin"></span>Updating</span>
                                        }
                                        else if (isDirty)
                                        {
                                            <button type="button" class="bsc-btn bsc-btn-primary bsc-btn-xs"
                                                    disabled="@isApplyingAll" @onclick="() => UpdateStatusAsync(item)">
                                                Update
                                            </button>
                                        }
                                        else if (recentlyUpdated.Contains(item.BatchEntryId))
                                        {
                                            <span class="bsc-updated"><i class="ph ph-check-circle"></i>Updated</span>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <div class="bsc-foot">
                    <span class="bsc-range">@RangeLabel</span>
                    <div class="bsc-pager">
                        <button type="button" class="bsc-btn bsc-btn-secondary bsc-btn-icon" title="Previous page"
                                disabled="@(pageNumber <= 1)" @onclick="PreviousPage">
                            <i class="ph ph-caret-left"></i>
                        </button>
                        <span class="bsc-page-label">@PageLabel</span>
                        <button type="button" class="bsc-btn bsc-btn-secondary bsc-btn-icon" title="Next page"
                                disabled="@(pageNumber >= PageCount)" @onclick="NextPage">
                            <i class="ph ph-caret-right"></i>
                        </button>
                    </div>
                </div>

                @if (results.Count >= ResultLimit)
                {
                    <div class="bsc-note">
                        <i class="ph ph-info"></i>
                        <span>
                            Only the first @ResultLimit in-stock matches are returned — narrow the batch number
                            to see the rest.
                        </span>
                    </div>
                }
            }
        </section>
    </div>
</div>
