@* The administrator's dashboard, rendered by Home at /dashboard.

   It replaces a page that reported a cashier's day — invoices raised, payments
   taken, "Create invoice" as the primary action — to whoever opened it. That
   was the right page when every office role shared this route. It is not an
   administrator's page, so this one asks the four questions an administrator
   actually opens a dashboard for: is the system up, what is stuck, what is
   waiting on a decision, and who is doing what.

   Trading stays, demoted to "Today so far": still worth a glance, but no longer
   what the page is about. The Manager dashboard picks it up properly.

   "Today so far" also carries the day's document flow — mobile orders, sales
   orders, invoices and transfers — one card each, every count scoped to today
   and every card a link to the list behind it. The second figure on a document
   card is the part of that day's intake that has not finished moving: unpriced
   mobile orders, unapproved sales orders, transfers not yet in SAP.

   Dressed from `Operations Dashboard.dc.html` in wwwroot/css/operations-dashboard.css,
   which is this page's own sheet — the `.dsh` rules it used to share belong to
   the sales-rep dashboard at the same route, and this design changes the
   shapes rather than the colours. The icons stay inline (DashIcon) rather than
   the design's Phosphor webfont: this is the first page a session paints, and
   it paints before any icon font has arrived. *@

<div class="opd">

    <header class="opd-head">
        <nav class="opd-crumbs" aria-label="Breadcrumb">
            <span>System</span>
            <span class="opd-crumb-sep" aria-hidden="true">/</span>
            <span class="opd-crumb-now" aria-current="page">Operations</span>
        </nav>

        <div class="opd-head-meta">
            <span class="opd-stamp @(loadedAt is null ? "is-reading" : null)">
                <span class="opd-stamp-dot" aria-hidden="true"></span>
                @if (loadedAt is { } stamp)
                {
                    @($"Read at {stamp:HH:mm}")
                }
                else
                {
                    @("Reading…")
                }
            </span>

            <button type="button" class="opd-btn opd-btn-quiet" disabled="@isRefreshing"
                    @onclick="RefreshAsync">
                @if (isRefreshing)
                {
                    <span class="opd-spin" aria-hidden="true"></span>
                }
                else
                {
                    <DashIcon Name="refresh" Size="15" />
                }
                Refresh
            </button>

            <a class="opd-btn opd-btn-primary" href="/exception-center">
                <DashIcon Name="warning" Size="15" />
                Exception centre
            </a>
        </div>
    </header>

    <div class="opd-body">

        <section class="opd-hero">
            <div class="opd-hero-titles">
                <div class="opd-kicker">Operations</div>
                <h1 class="opd-title">@GreetingText, @DisplayName</h1>
                <p class="opd-sub">
                    What the system is doing, what is stuck, and what is waiting on you.
                    Figures are read once when the page opens.
                </p>
            </div>
            <div class="opd-date">
                <DashIcon Name="calendar" Size="15" />
                <span>@DateTime.Now.ToString("dddd d MMMM yyyy")</span>
            </div>
        </section>

        @* Health leads: everything below it is only worth reading if the
           system behind it is actually up. The state is one word across both
           sections of the report and every check — reading its top-level
           status alone says "Healthy" through a SAP outage. *@
        <section class="opd-health @HealthStateClass" aria-label="System health">
            <span class="opd-health-icon" aria-hidden="true">
                <DashIcon Name="heartbeat" Size="26" />
            </span>
            <div class="opd-health-text">
                <span class="opd-health-state">@HealthHeadline</span>
                <span class="opd-health-note">API and its dependencies@(HealthNote is null ? null : $" — {HealthNote}")</span>
            </div>
            <div class="opd-health-rail">
                <div class="opd-rail-item">
                    <span class="opd-rail-label">Retries</span>
                    <span class="opd-rail-value">@RetriesRail</span>
                </div>
                <span class="opd-rail-sep" aria-hidden="true"></span>
                <div class="opd-rail-item">
                    <span class="opd-rail-label">Stalled</span>
                    <span class="opd-rail-value">@Figure(stalledCount)</span>
                </div>
                <span class="opd-rail-sep" aria-hidden="true"></span>
                <div class="opd-rail-item">
                    <span class="opd-rail-label">Last read</span>
                    <span class="opd-rail-value">@(loadedAt is { } read ? read.ToString("HH:mm") : "—")</span>
                </div>
            </div>
        </section>

        <section class="opd-section" aria-label="Waiting on you">
            <div class="opd-band">
                <span class="opd-band-label">Waiting on you</span>
                <span class="opd-band-rule" aria-hidden="true"></span>
                <a class="opd-link" href="/exception-center">
                    Open exception centre
                    <DashIcon Name="arrow-right" Size="13" />
                </a>
            </div>

            <div class="opd-calls">

                <a class="opd-call @ToneClass(BlockedTone)" href="/exception-center">
                    <div class="opd-call-top">
                        <span class="opd-call-mark" aria-hidden="true"></span>
                        <span class="opd-call-label">Blocked</span>
                        <span class="opd-call-glyph" aria-hidden="true"><DashIcon Name="warning" Size="15" /></span>
                    </div>
                    <div class="opd-call-value">@Figure(blockedCount)</div>
                    <div class="opd-call-what">Exceptions needing a decision</div>
                    @if (BlockedNote is { } blockedNote)
                    {
                        <div class="opd-call-foot">
                            <DashIcon Name="hourglass" Size="14" />
                            @blockedNote
                        </div>
                    }
                </a>

                <a class="opd-call @ToneClass(PostFailedTone)" href="/inventory-transfers">
                    <div class="opd-call-top">
                        <span class="opd-call-mark" aria-hidden="true"></span>
                        <span class="opd-call-label">Failed posts</span>
                        <span class="opd-call-glyph" aria-hidden="true"><DashIcon Name="plug" Size="15" /></span>
                    </div>
                    <div class="opd-call-value">@Figure(postFailedCount)</div>
                    <div class="opd-call-what">Approved but not in SAP</div>
                    @if (PostFailedNote is { } postNote)
                    {
                        <div class="opd-call-foot">
                            <DashIcon Name="refresh" Size="14" />
                            @postNote
                        </div>
                    }
                </a>

                @* The design leads this card with the accounts that have no
                   second factor and foots it with the lock-outs, which is the
                   right way round: a lock-out is today's incident and clears
                   itself, an account without 2FA is a standing exposure. *@
                <a class="opd-call @ToneClass(SecurityTone)" href="/user-management">
                    <div class="opd-call-top">
                        <span class="opd-call-mark" aria-hidden="true"></span>
                        <span class="opd-call-label">Accounts</span>
                        <span class="opd-call-glyph" aria-hidden="true"><DashIcon Name="shield" Size="15" /></span>
                    </div>
                    <div class="opd-call-value">@Figure(usersWithoutTwoFactor)</div>
                    <div class="opd-call-what">Users without 2FA</div>
                    @if (LockoutNote is { } lockNote)
                    {
                        <div class="opd-call-foot">
                            <DashIcon Name="lock-open" Size="14" />
                            @lockNote
                        </div>
                    }
                </a>

                @* Two queues that are usually empty. They keep their figures but
                   not a card each, because a row of four equal cards would say
                   these matter as much as the three that can carry work. *@
                <div class="opd-quiet-stack">
                    <a class="opd-quiet @(retryOverdueCount > 0 ? "is-watch" : null)" href="/exception-center">
                        <span class="opd-quiet-value">@Figure(retryOverdueCount)</span>
                        <span class="opd-quiet-body">
                            <span class="opd-quiet-label">Retries overdue</span>
                            <span class="opd-quiet-note">@(RetryNote ?? "Past their retry time")</span>
                        </span>
                        <span class="opd-quiet-glyph" aria-hidden="true"><DashIcon Name="clock" Size="16" /></span>
                    </a>
                    <a class="opd-quiet @(pendingTransferCount > 0 ? "is-watch" : null)" href="/inventory-transfers">
                        <span class="opd-quiet-value">@Figure(pendingTransferCount)</span>
                        <span class="opd-quiet-body">
                            <span class="opd-quiet-label">Transfers to approve</span>
                            @* No unit total here. The figure this card used to
                               carry summed TotalQuantity across transfers
                               measured in crates, kilograms and eaches, which
                               was never a number. *@
                            <span class="opd-quiet-note">Across all warehouses</span>
                        </span>
                        <span class="opd-quiet-glyph" aria-hidden="true"><DashIcon Name="swap" Size="16" /></span>
                    </a>
                </div>

            </div>
        </section>

        <section class="opd-section" aria-label="Today so far">
            <div class="opd-band">
                <span class="opd-band-label">Today so far</span>
                <span class="opd-band-rule" aria-hidden="true"></span>
            </div>

            @* Every card counts a list that lives on another page, so every card
               is the way through to it. The four document cards lead: they are
               the day's work moving through the system, and each one's second
               figure says how much of it has not finished moving. *@
            <div class="opd-today">
                <a class="opd-fig" href="/mobile-drafts">
                    <div class="opd-fig-top">
                        <span class="opd-fig-mark" aria-hidden="true"></span>
                        <span class="opd-fig-label">Mobile orders</span>
                        <span class="opd-fig-glyph" aria-hidden="true"><DashIcon Name="phone" Size="15" /></span>
                    </div>
                    <div class="opd-fig-line">
                        <span class="opd-fig-value">@Figure(todayMobileOrderCount)</span>
                        @if (MobileReviewNote is { } mobileNote)
                        {
                            <span class="opd-fig-amount">@mobileNote</span>
                        }
                    </div>
                    @if (mobileOrderTrend.Text is { Length: > 0 } mobileTrendText)
                    {
                        <div class="opd-fig-foot">
                            <span class="opd-fig-trend">
                                <DashIcon Name="@TrendIcon(mobileOrderTrend.Direction)" Size="14" />
                                @mobileTrendText
                            </span>
                        </div>
                    }
                </a>

                <a class="opd-fig" href="/sales-orders">
                    <div class="opd-fig-top">
                        <span class="opd-fig-mark" aria-hidden="true"></span>
                        <span class="opd-fig-label">Sales orders</span>
                        <span class="opd-fig-glyph" aria-hidden="true"><DashIcon Name="cart" Size="15" /></span>
                    </div>
                    <div class="opd-fig-line">
                        <span class="opd-fig-value">@Figure(todaySalesOrderCount)</span>
                        @if (SalesOrderApprovalNote is { } salesOrderNote)
                        {
                            <span class="opd-fig-amount">@salesOrderNote</span>
                        }
                    </div>
                    @if (salesOrderTrend.Text is { Length: > 0 } salesOrderTrendText)
                    {
                        <div class="opd-fig-foot">
                            <span class="opd-fig-trend">
                                <DashIcon Name="@TrendIcon(salesOrderTrend.Direction)" Size="14" />
                                @salesOrderTrendText
                            </span>
                        </div>
                    }
                </a>

                <a class="opd-fig" href="/invoices">
                    <div class="opd-fig-top">
                        <span class="opd-fig-mark" aria-hidden="true"></span>
                        <span class="opd-fig-label">Invoices raised</span>
                        <span class="opd-fig-glyph" aria-hidden="true"><DashIcon Name="receipt" Size="15" /></span>
                    </div>
                    <div class="opd-fig-line">
                        <span class="opd-fig-value">@Figure(todayInvoiceCount)</span>
                        <span class="opd-fig-amount">@FormatMoney(invoiceTotal) total</span>
                    </div>
                    @if (invoiceTrend.Text is { Length: > 0 } invoiceTrendText)
                    {
                        <div class="opd-fig-foot">
                            <span class="opd-fig-trend">
                                <DashIcon Name="@TrendIcon(invoiceTrend.Direction)" Size="14" />
                                @invoiceTrendText
                            </span>
                        </div>
                    }
                </a>

                @* Transfers raised through this app. One raised in SAP directly
                   never passes through the approval queue this counts, and there
                   is no company-wide read of those — the SAP-side list is asked
                   for one warehouse at a time. *@
                <a class="opd-fig" href="/inventory-transfers">
                    <div class="opd-fig-top">
                        <span class="opd-fig-mark" aria-hidden="true"></span>
                        <span class="opd-fig-label">Transfers</span>
                        <span class="opd-fig-glyph" aria-hidden="true"><DashIcon Name="swap" Size="15" /></span>
                    </div>
                    <div class="opd-fig-line">
                        <span class="opd-fig-value">@Figure(todayTransferCount)</span>
                        @if (TransferPostedNote is { } transferNote)
                        {
                            <span class="opd-fig-amount">@transferNote</span>
                        }
                    </div>
                    @if (transferTrend.Text is { Length: > 0 } transferTrendText)
                    {
                        <div class="opd-fig-foot">
                            <span class="opd-fig-trend">
                                <DashIcon Name="@TrendIcon(transferTrend.Direction)" Size="14" />
                                @transferTrendText
                            </span>
                        </div>
                    }
                </a>

                <a class="opd-fig" href="/payments">
                    <div class="opd-fig-top">
                        <span class="opd-fig-mark" aria-hidden="true"></span>
                        <span class="opd-fig-label">Payments received</span>
                        <span class="opd-fig-glyph" aria-hidden="true"><DashIcon Name="card" Size="15" /></span>
                    </div>
                    <div class="opd-fig-line">
                        <span class="opd-fig-value">@Figure(todayPaymentCount)</span>
                        <span class="opd-fig-amount">@FormatMoney(paymentTotal) received</span>
                    </div>
                    @if (paymentTrend.Text is { Length: > 0 } paymentTrendText)
                    {
                        <div class="opd-fig-foot">
                            <span class="opd-fig-trend">
                                <DashIcon Name="@TrendIcon(paymentTrend.Direction)" Size="14" />
                                @paymentTrendText
                            </span>
                        </div>
                    }
                </a>

                @* The design foots this card with the names of the people who
                   signed in. There is no read that returns them — the activity
                   statistics give a count, and the six rows of the audit panel
                   are the latest actions, not the day's roll. So the foot
                   carries what was actually asked for: how much they did, and
                   how much of it failed. *@
                <a class="opd-fig" href="/user-activity">
                    <div class="opd-fig-top">
                        <span class="opd-fig-mark" aria-hidden="true"></span>
                        <span class="opd-fig-label">People active</span>
                        <span class="opd-fig-glyph" aria-hidden="true"><DashIcon Name="users" Size="15" /></span>
                    </div>
                    <div class="opd-fig-line">
                        <span class="opd-fig-value">@Figure(activeUsers)</span>
                        <span class="opd-fig-amount">signed in today</span>
                    </div>
                    @if (ActionsNote is { } actionsNote)
                    {
                        <div class="opd-fig-foot">
                            <DashIcon Name="list-check" Size="14" />
                            @actionsNote
                        </div>
                    }
                </a>
            </div>
        </section>

        <section class="opd-panels" aria-label="What is failing and who is working">

            @* The clusters carry a Guidance string that says what to do about
               each family of failure. That is the column worth the width. *@
            <section class="opd-panel" aria-labelledby="clusters-heading">
                <header class="opd-panel-head">
                    <h2 id="clusters-heading" class="opd-panel-title">What is failing</h2>
                    @if (ClusterTotal is { } clusterTotal)
                    {
                        <span class="opd-panel-note">@clusterTotal in the last 24 hours</span>
                    }
                    <a class="opd-link" href="/exception-center">
                        View all
                        <DashIcon Name="arrow-right" Size="13" />
                    </a>
                </header>

                @* The filter's options come from the clusters on screen, not a
                   fixed list of families, so it can never offer a choice that
                   empties the table. It is hidden entirely below two families,
                   where it would only be able to say "All". *@
                @if (Families.Count > 1)
                {
                    <div class="opd-seg" role="group" aria-label="Filter failures by family">
                        @* aria-pressed is written out as a string: rendering the
                           bool directly emits "True", which is not one of the
                           two values the attribute accepts. *@
                        <button type="button"
                                class="opd-seg-opt @(familyFilter is null ? "is-on" : null)"
                                aria-pressed="@Pressed(familyFilter is null)"
                                @onclick="@(() => SetFamily(null))">
                            All
                        </button>
                        @foreach (var family in Families)
                        {
                            <button type="button"
                                    class="opd-seg-opt @(familyFilter == family ? "is-on" : null)"
                                    aria-pressed="@Pressed(familyFilter == family)"
                                    @onclick="@(() => SetFamily(family))">
                                @family
                            </button>
                        }
                    </div>
                }

                @if (isLoadingExceptions)
                {
                    <div class="opd-state" role="status">
                        <span class="opd-spin" aria-hidden="true"></span>
                        <span>Loading failures&#8230;</span>
                    </div>
                }
                else if (VisibleClusters is { Count: > 0 } visibleClusters)
                {
                    <div class="opd-scroll">
                        <table class="opd-table">
                            <thead>
                                <tr>
                                    <th scope="col" style="width:34%">Failure</th>
                                    <th scope="col" style="width:20%">Family</th>
                                    <th scope="col" class="opd-num" style="width:12%">Count</th>
                                    <th scope="col" style="width:34%">What to do</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var cluster in visibleClusters)
                                {
                                    <tr>
                                        <td class="opd-name" title="@cluster.SampleError">@cluster.Label</td>
                                        <td><span class="opd-tag">@cluster.Family</span></td>
                                        <td class="opd-num">@cluster.Count.ToString("N0")</td>
                                        <td class="opd-guide" title="@cluster.Guidance">@cluster.Guidance</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else if (exceptionsUnavailable)
                {
                    <div class="opd-state">Exception centre unavailable</div>
                }
                else
                {
                    <div class="opd-state">Nothing is failing</div>
                }
            </section>

            <section class="opd-panel" aria-labelledby="activity-heading">
                <header class="opd-panel-head">
                    <h2 id="activity-heading" class="opd-panel-title">Recent activity</h2>
                    <span class="opd-panel-note">Live audit trail</span>
                    <a class="opd-link" href="/user-activity">
                        View all
                        <DashIcon Name="arrow-right" Size="13" />
                    </a>
                </header>

                @if (isLoadingActivity)
                {
                    <div class="opd-state" role="status">
                        <span class="opd-spin" aria-hidden="true"></span>
                        <span>Loading activity&#8230;</span>
                    </div>
                }
                else if (recentActivity is { Count: > 0 })
                {
                    <div class="opd-scroll">
                        <table class="opd-table">
                            <thead>
                                <tr>
                                    <th scope="col" style="width:30%">User</th>
                                    <th scope="col" style="width:34%">Action</th>
                                    <th scope="col" style="width:24%">Time</th>
                                    <th scope="col" class="opd-num" style="width:12%">Result</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var entry in recentActivity)
                                {
                                    <tr>
                                        <td class="opd-name" title="@entry.Username">@entry.Username</td>
                                        <td class="opd-guide" title="@ActivityDetail(entry)">@entry.Action</td>
                                        <td class="opd-when">@entry.Timestamp.ToLocalTime().ToString("dd MMM HH:mm")</td>
                                        <td class="opd-num">
                                            <span class="opd-tag @(entry.IsSuccess ? "opd-tag-ok" : "opd-tag-bad")">
                                                @(entry.IsSuccess ? "OK" : "Failed")
                                            </span>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <div class="opd-state">No recent activity</div>
                }
            </section>

        </section>

        <section class="opd-section" aria-label="Quick actions">
            <div class="opd-band">
                <span class="opd-band-label">Quick actions</span>
                <span class="opd-band-rule" aria-hidden="true"></span>
            </div>

            <div class="opd-acts">
                <a class="opd-act" href="/exception-center">
                    <span class="opd-act-glyph" aria-hidden="true"><DashIcon Name="warning" Size="19" /></span>
                    <span class="opd-act-body">
                        <span class="opd-act-title">Exception centre</span>
                        <span class="opd-act-note">Retry and assign what failed</span>
                    </span>
                    <span class="opd-act-chev" aria-hidden="true"><DashIcon Name="arrow-right" Size="15" /></span>
                </a>
                <a class="opd-act" href="/user-management">
                    <span class="opd-act-glyph" aria-hidden="true"><DashIcon Name="users" Size="19" /></span>
                    <span class="opd-act-body">
                        <span class="opd-act-title">Users</span>
                        <span class="opd-act-note">Accounts, roles and warehouses</span>
                    </span>
                    <span class="opd-act-chev" aria-hidden="true"><DashIcon Name="arrow-right" Size="15" /></span>
                </a>
                <a class="opd-act" href="/sync-status">
                    <span class="opd-act-glyph" aria-hidden="true"><DashIcon Name="database" Size="19" /></span>
                    <span class="opd-act-body">
                        <span class="opd-act-title">Sync status</span>
                        <span class="opd-act-note">Check the cached data</span>
                    </span>
                    <span class="opd-act-chev" aria-hidden="true"><DashIcon Name="arrow-right" Size="15" /></span>
                </a>
                <a class="opd-act" href="/approval-process/setup">
                    <span class="opd-act-glyph" aria-hidden="true"><DashIcon Name="clipboard-check" Size="19" /></span>
                    <span class="opd-act-body">
                        <span class="opd-act-title">Approvals</span>
                        <span class="opd-act-note">Stages and templates</span>
                    </span>
                    <span class="opd-act-chev" aria-hidden="true"><DashIcon Name="arrow-right" Size="15" /></span>
                </a>
                <a class="opd-act" href="/backups">
                    <span class="opd-act-glyph" aria-hidden="true"><DashIcon Name="shield" Size="19" /></span>
                    <span class="opd-act-body">
                        <span class="opd-act-title">Backups</span>
                        <span class="opd-act-note">Database snapshots</span>
                    </span>
                    <span class="opd-act-chev" aria-hidden="true"><DashIcon Name="arrow-right" Size="15" /></span>
                </a>
                <a class="opd-act" href="/settings">
                    <span class="opd-act-glyph" aria-hidden="true"><DashIcon Name="gauge" Size="19" /></span>
                    <span class="opd-act-body">
                        <span class="opd-act-title">Settings</span>
                        <span class="opd-act-note">Company and SAP configuration</span>
                    </span>
                    <span class="opd-act-chev" aria-hidden="true"><DashIcon Name="arrow-right" Size="15" /></span>
                </a>
            </div>
        </section>

    </div>
</div>
