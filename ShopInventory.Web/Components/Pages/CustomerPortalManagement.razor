@page "/customer-portal-management"
@using ShopInventory.Web.Data
@attribute [Authorize(Roles = "Admin")]
@rendermode InteractiveServer

<PageTitle>Customer portal accounts - Shop Inventory</PageTitle>

@* The imported Nocturne design is dark; wwwroot/css/customer-portal-accounts.css
   (linked from App.razor) carries it and its light counterpart, and follows the
   app's theme toggle like every other Nocturne page.

   The design's shape is a list beside a sticky detail panel, so the common
   changes — a statement preference, two-factor, a suspension — happen next to
   the row they apply to rather than behind a modal. Only the things that
   genuinely need a form of their own are dialogs: creating and editing an
   account, resetting a password, deleting, the linked-account hierarchy, and
   the read-only activity log.

   Icons are drawn inline rather than from the Phosphor font: several are the
   only content of their control, so a font that failed to load would leave
   them reading as nothing.

   The list is a plain table filtered in memory. Portal accounts are
   admin-configured records numbering in the dozens, and the design asks for
   live search, per-status counts and sortable columns — each of which would
   otherwise be a server round trip. *@

<div class="cpa">
    <div class="cpa-body">

        <section class="cpa-hero">
            <div class="cpa-hero-text">
                <div class="cpa-crumbs">
                    <span>Administration</span><span aria-hidden="true">/</span><span>Portal management</span>
                </div>
                <h1>Customer portal accounts</h1>
                <p>Who can sign in to the customer portal, and what they can see there.</p>
            </div>
            <div class="cpa-hero-actions">
                @if (lastSyncedAt.HasValue)
                {
                    <span class="cpa-synced">Loaded @lastSyncedAt.Value.ToString("d MMM yyyy, HH:mm")</span>
                }
                <button type="button" class="cpa-btn cpa-btn-quiet" disabled="@isLoading" @onclick="Refresh">
                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"
                         stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <path d="M20 11a8 8 0 0 0-13.7-5.3L4 8"></path>
                        <path d="M4 4v4h4"></path>
                        <path d="M4 13a8 8 0 0 0 13.7 5.3L20 16"></path>
                        <path d="M20 20v-4h-4"></path>
                    </svg>
                    Refresh
                </button>
                <button type="button" class="cpa-btn cpa-btn-primary" @onclick="OpenCreateDialog">
                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"
                         stroke-linecap="round" aria-hidden="true">
                        <path d="M12 5v14M5 12h14"></path>
                    </svg>
                    Add account
                </button>
            </div>
        </section>

        @if (!string.IsNullOrEmpty(successMessage))
        {
            <div class="cpa-msg cpa-msg-good" role="status">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"
                     stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M4 12.5l5 5L20 7"></path>
                </svg>
                <span class="cpa-msg-text">@successMessage</span>
                <button type="button" class="cpa-icon-btn" aria-label="Dismiss" @onclick="() => successMessage = null">
                    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"
                         stroke-linecap="round" aria-hidden="true">
                        <path d="M6 6l12 12M18 6L6 18"></path>
                    </svg>
                </button>
            </div>
        }

        @if (!string.IsNullOrEmpty(errorMessage))
        {
            <div class="cpa-msg cpa-msg-bad" role="alert">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"
                     stroke-linecap="round" aria-hidden="true">
                    <circle cx="12" cy="12" r="9"></circle>
                    <path d="M12 7.5v5.5M12 16.2v.1"></path>
                </svg>
                <span class="cpa-msg-text">@errorMessage</span>
                <button type="button" class="cpa-icon-btn" aria-label="Dismiss" @onclick="() => errorMessage = null">
                    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"
                         stroke-linecap="round" aria-hidden="true">
                        <path d="M6 6l12 12M18 6L6 18"></path>
                    </svg>
                </button>
            </div>
        }

        @if (isLoading)
        {
            <section class="cpa-loading" aria-busy="true">
                <div class="cpa-loading-text">Loading portal accounts&#8230;</div>
                @for (var i = 0; i < 5; i++)
                {
                    <div class="cpa-skel" style="animation-delay: @((i * 0.09).ToString("0.00", System.Globalization.CultureInfo.InvariantCulture))s"></div>
                }
            </section>
        }
        else if (accounts.Count == 0)
        {
            <section class="cpa-state">
                <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"
                     stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <circle cx="14" cy="9" r="4"></circle>
                    <path d="M7.5 20a7 7 0 0 1 13 0"></path>
                    <path d="M2 8h4M2 12h3M2 16h4"></path>
                </svg>
                <h2>No portal accounts yet</h2>
                <p>
                    Create an account against a customer card code to give them statements, invoices and
                    delivery notes online.
                </p>
                <button type="button" class="cpa-btn cpa-btn-primary" @onclick="OpenCreateDialog">
                    Add customer account
                </button>
            </section>
        }
        else
        {
            var rows = Filtered;

            <section class="cpa-summary">
                <div class="cpa-sum-lead">
                    <div class="cpa-sum-headline">
                        <div class="cpa-sum-total">@TotalCount</div>
                        <div class="cpa-sum-of">@ActiveCount of @TotalCount active</div>
                    </div>
                    <div class="cpa-meter" role="img" aria-label="@ActivePercent% of portal accounts are active">
                        <div class="cpa-meter-fill" style="width: @ActivePercent%"></div>
                    </div>
                    <div class="cpa-sum-label">Portal accounts</div>
                </div>
                <div class="cpa-sum-cell">
                    <div class="cpa-sum-num cpa-sum-num-lead">@ActiveCount</div>
                    <div class="cpa-sum-label">Active</div>
                    <div class="cpa-sum-note">Can sign in today</div>
                </div>
                <div class="cpa-sum-cell">
                    <div class="cpa-sum-num">@InactiveCount</div>
                    <div class="cpa-sum-label">Inactive</div>
                    <div class="cpa-sum-note">Access suspended</div>
                </div>
                <div class="cpa-sum-cell">
                    <div class="cpa-sum-num">@LockedCount</div>
                    <div class="cpa-sum-label">Locked</div>
                    <div class="cpa-sum-note">Failed sign-in lockouts</div>
                </div>
            </section>

            <div class="cpa-split">

                <section class="cpa-panel">
                    <div class="cpa-panel-head">
                        <label class="cpa-search">
                            <span class="visually-hidden">Search portal accounts</span>
                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                 stroke-width="1.7" stroke-linecap="round" aria-hidden="true">
                                <circle cx="11" cy="11" r="7"></circle>
                                <path d="M20 20l-3.5-3.5"></path>
                            </svg>
                            <input class="cpa-input cpa-input-search" type="search" autocomplete="off"
                                   placeholder="Card code, customer or email"
                                   @bind="searchTerm" @bind:event="oninput" />
                        </label>
                        <div class="cpa-seg" role="group" aria-label="Account status">
                            @foreach (var (value, label) in StatusFilters)
                            {
                                <button type="button" class="cpa-seg-opt @(statusFilter == value ? "cpa-seg-on" : "")"
                                        aria-pressed="@(statusFilter == value)" @onclick="() => SetStatusFilter(value)">
                                    @label
                                    @if (value != FilterAll)
                                    {
                                        <span class="cpa-seg-count">@CountOf(value)</span>
                                    }
                                </button>
                            }
                        </div>
                    </div>

                    @if (rows.Count == 0)
                    {
                        <div class="cpa-nomatch">
                            No accounts match this filter. Clear the search or switch back to all statuses.
                        </div>
                    }
                    else
                    {
                        <div class="cpa-scroll">
                            <table class="cpa-table">
                                <thead>
                                    <tr>
                                        <th scope="col">
                                            <button type="button" class="cpa-sort @(sortKey == SortName ? "cpa-sort-on" : "")"
                                                    @onclick="() => SortBy(SortName)">
                                                Account<span class="cpa-arrow" aria-hidden="true">@SortArrow(SortName)</span>
                                            </button>
                                        </th>
                                        <th scope="col">
                                            <button type="button" class="cpa-sort @(sortKey == SortCode ? "cpa-sort-on" : "")"
                                                    @onclick="() => SortBy(SortCode)">
                                                Card code<span class="cpa-arrow" aria-hidden="true">@SortArrow(SortCode)</span>
                                            </button>
                                        </th>
                                        <th scope="col">
                                            <button type="button" class="cpa-sort @(sortKey == SortStatus ? "cpa-sort-on" : "")"
                                                    @onclick="() => SortBy(SortStatus)">
                                                Status<span class="cpa-arrow" aria-hidden="true">@SortArrow(SortStatus)</span>
                                            </button>
                                        </th>
                                        <th scope="col">Access</th>
                                        <th scope="col">
                                            <button type="button" class="cpa-sort @(sortKey == SortLastLogin ? "cpa-sort-on" : "")"
                                                    @onclick="() => SortBy(SortLastLogin)">
                                                Last login<span class="cpa-arrow" aria-hidden="true">@SortArrow(SortLastLogin)</span>
                                            </button>
                                        </th>
                                        <th scope="col" class="cpa-th-right"><span class="visually-hidden">Select</span></th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var account in rows)
                                    {
                                        var status = StatusOf(account);
                                        var isOn = account.Id == selectedId;

                                        <tr class="@(isOn ? "cpa-row-on" : "")" @onclick="() => SelectAccount(account)">
                                            <td>
                                                <div class="cpa-account">
                                                    <span class="cpa-avatar" aria-hidden="true">@Initials(account.CardName)</span>
                                                    <span class="cpa-account-text">
                                                        <span class="cpa-name">@account.CardName</span>
                                                        <span class="cpa-email">@Dash(account.Email)</span>
                                                    </span>
                                                </div>
                                            </td>
                                            <td class="cpa-td-nowrap">
                                                <span class="cpa-codes">
                                                    <span class="cpa-code">@account.CardCode</span>
                                                    @foreach (var linked in account.LinkedAccounts
                                                        .Where(l => l.CardCode != account.CardCode).Take(2))
                                                    {
                                                        <span class="cpa-code">@linked.CardCode</span>
                                                    }
                                                    @{
                                                        var extra = account.LinkedAccounts
                                                            .Count(l => l.CardCode != account.CardCode) - 2;
                                                    }
                                                    @if (extra > 0)
                                                    {
                                                        <span class="cpa-code">+@extra</span>
                                                    }
                                                </span>
                                                <span class="cpa-type">@StructureLabel(account)</span>
                                            </td>
                                            <td>
                                                <span class="cpa-status cpa-status-@status">
                                                    <span class="cpa-dot" aria-hidden="true"></span>@StatusLabel(status)
                                                </span>
                                            </td>
                                            <td>
                                                <span class="cpa-rl">Access</span>
                                                <span class="cpa-access">
                                                    <span class="cpa-chip @(account.ReceiveStatements ? "cpa-chip-on" : "")">
                                                        @(account.ReceiveStatements ? "Statements" : "No statements")
                                                    </span>
                                                    <span class="cpa-chip @(account.TwoFactorEnabled ? "cpa-chip-on" : "")">
                                                        @(account.TwoFactorEnabled ? "2FA on" : "2FA off")
                                                    </span>
                                                </span>
                                            </td>
                                            <td class="cpa-td-nowrap">
                                                <span class="cpa-rl">Last login</span>
                                                <span class="cpa-when">@When(account.LastLoginAt)</span>
                                                <span class="cpa-when-sub">Created @Day(account.CreatedAt)</span>
                                            </td>
                                            <td class="cpa-td-right">
                                                <span class="cpa-chevron" aria-hidden="true">&#8250;</span>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }

                    <div class="cpa-panel-foot">
                        <span>Showing @rows.Count of @TotalCount accounts</span>
                        <button type="button" class="cpa-btn cpa-btn-ghost cpa-btn-sm"
                                disabled="@(isExporting || rows.Count == 0)" @onclick="() => ExportCsv(rows)">
                            @if (isExporting)
                            {
                                <span class="cpa-spin" aria-hidden="true"></span>
                                <span>Exporting&#8230;</span>
                            }
                            else
                            {
                                <span>Export account list</span>
                            }
                        </button>
                    </div>
                </section>

                <aside class="cpa-side" aria-label="Account detail">
                    @* `is not { } selected` rather than a plain local: the
                       designation is definitely assigned wherever the pattern
                       matched — the else branch — so the detail block's
                       lambdas capture a non-nullable account, which a local
                       narrowed by an `is null` test would not give them. *@
                    @if (Selected is not { } selected)
                    {
                        <div class="cpa-side-none">
                            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                 stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                <rect x="3" y="4" width="18" height="16" rx="2"></rect>
                                <path d="M7 9h10M7 13h10M7 17h6"></path>
                            </svg>
                            <div class="cpa-side-none-title">No account selected</div>
                            <p>
                                Pick a row to manage credentials, statement access and two-factor sign-in without
                                leaving the list.
                            </p>
                        </div>
                    }
                    else
                    {
                        var status = StatusOf(selected);

                        <div class="cpa-side-head">
                            <div class="cpa-side-id">
                                <span class="cpa-avatar cpa-avatar-lg" aria-hidden="true">@Initials(selected.CardName)</span>
                                <div style="min-width:0">
                                    <h2>@selected.CardName</h2>
                                    <div class="cpa-side-email">@Dash(selected.Email)</div>
                                </div>
                                <button type="button" class="cpa-icon-btn" style="margin-left:auto"
                                        title="Edit account" aria-label="Edit account"
                                        @onclick="() => OpenEditDialog(selected)">
                                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                         stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"
                                         aria-hidden="true">
                                        <path d="M4 20h4L19 9a2.1 2.1 0 0 0-3-3L5 17z"></path>
                                        <path d="M14.5 6.5l3 3"></path>
                                    </svg>
                                </button>
                            </div>
                            <div class="cpa-tags">
                                <span class="cpa-tag cpa-tag-accent">@StatusLabel(status)</span>
                                <span class="cpa-tag cpa-tag-outline">@StructureLabel(selected)</span>
                                <span class="cpa-tag">@selected.CardCode</span>
                            </div>
                        </div>

                        <div class="cpa-side-section">
                            <div class="cpa-side-label">Access</div>
                            <label class="cpa-switch">
                                <input type="checkbox" checked="@selected.ReceiveStatements" disabled="@isSaving"
                                       @onchange="() => ToggleStatements(selected)" />
                                <span class="cpa-track" aria-hidden="true"><span class="cpa-knob"></span></span>
                                <span class="cpa-switch-text">
                                    <span class="cpa-switch-title">Monthly statements</span>
                                    <span class="cpa-switch-note">Emailed on the 1st, visible in portal</span>
                                </span>
                            </label>
                            <label class="cpa-switch">
                                <input type="checkbox" checked="@selected.TwoFactorEnabled" disabled="@isSaving"
                                       @onchange="() => ToggleTwoFactor(selected)" />
                                <span class="cpa-track" aria-hidden="true"><span class="cpa-knob"></span></span>
                                <span class="cpa-switch-text">
                                    <span class="cpa-switch-title">Two-factor sign-in</span>
                                    <span class="cpa-switch-note">One-time code by email</span>
                                </span>
                            </label>
                        </div>

                        <div class="cpa-facts">
                            <div>
                                <div class="cpa-fact-label">Phone</div>
                                <div class="cpa-fact-value cpa-fact-num">@Dash(selectedPartner?.Phone1)</div>
                            </div>
                            <div>
                                <div class="cpa-fact-label">Currency</div>
                                <div class="cpa-fact-value">@Dash(selectedPartner?.Currency)</div>
                            </div>
                            <div>
                                <div class="cpa-fact-label">Open balance</div>
                                <div class="cpa-fact-value cpa-fact-num">@Money(selectedPartner?.Balance)</div>
                            </div>
                            <div>
                                <div class="cpa-fact-label">Linked accounts</div>
                                <div class="cpa-fact-value cpa-fact-num">@selected.LinkedAccounts.Count</div>
                            </div>
                            <div>
                                <div class="cpa-fact-label">Password set</div>
                                <div class="cpa-fact-value">@Day(selected.LastPasswordChangeAt ?? selected.CreatedAt)</div>
                            </div>
                            <div>
                                <div class="cpa-fact-label">Failed sign-ins</div>
                                <div class="cpa-fact-value cpa-fact-num">@selected.FailedLoginAttempts</div>
                            </div>
                        </div>

                        <div class="cpa-side-actions">
                            <button type="button" class="cpa-btn cpa-btn-primary cpa-btn-block" @onclick="OpenResetDialog">
                                Reset password
                            </button>
                            <div class="cpa-side-pair">
                                <button type="button" class="cpa-btn cpa-btn-quiet" @onclick="OpenLinkedDialog">
                                    Linked accounts
                                </button>
                                <button type="button" class="cpa-btn cpa-btn-quiet" @onclick="OpenActivityDialog">
                                    Activity
                                </button>
                            </div>
                            <div class="cpa-side-quiet">
                                @if (status == StatusLocked)
                                {
                                    <button type="button" class="cpa-btn cpa-btn-ghost cpa-btn-sm" disabled="@isSaving"
                                            @onclick="() => UnlockAccount(selected)">
                                        Unlock account
                                    </button>
                                }
                                else
                                {
                                    <button type="button" class="cpa-btn cpa-btn-ghost cpa-btn-sm" disabled="@isSaving"
                                            @onclick="() => ToggleSuspended(selected)">
                                        @(selected.IsActive ? "Suspend access" : "Restore access")
                                    </button>
                                }
                                <button type="button" class="cpa-btn cpa-btn-danger cpa-btn-sm" @onclick="OpenDeleteDialog">
                                    Delete account
                                </button>
                            </div>
                        </div>
                    }
                </aside>
            </div>
        }

    </div>
</div>

@* The dialogs are peers of the page root rather than children, so they carry
   .cpa-overlay: the sheet pairs that class with .cpa everywhere the palette and
   the controls are scoped. Neither element may carry .cpa itself — its
   min-height: 100vh would beat a dialog's own height and push its footer below
   the fold. *@

@if (showFormDialog)
{
    <div class="cpa-overlay">
        <div class="cpa-scrim" @onclick="CloseFormDialog"></div>
        <div class="cpa-modal">
            <div class="cpa-dialog cpa-dialog-lg" role="dialog" aria-modal="true" aria-label="Portal account">
                <div class="cpa-dialog-head">
                    <div>
                        <h2>@(isEditing ? "Edit portal account" : "New portal account")</h2>
                        <div class="cpa-dialog-sub">
                            @(isEditing
                                ? "The card code is fixed once the account exists."
                                : "Pick the customer this account signs in as, then set its first password.")
                        </div>
                    </div>
                    <button type="button" class="cpa-icon-btn" aria-label="Close" @onclick="CloseFormDialog">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                             stroke-width="2" stroke-linecap="round" aria-hidden="true">
                            <path d="M6 6l12 12M18 6L6 18"></path>
                        </svg>
                    </button>
                </div>

                <div class="cpa-dialog-body">
                    @if (!isEditing)
                    {
                        <div class="cpa-field cpa-picker">
                            <span class="cpa-label">Customer</span>
                            @if (pickedPartner is not null)
                            {
                                <div class="cpa-picked">
                                    <span class="cpa-picker-code">@pickedPartner.CardCode</span>
                                    <span class="cpa-picked-name">@pickedPartner.CardName</span>
                                    <button type="button" class="cpa-icon-btn" aria-label="Clear selection"
                                            @onclick="ClearPickedPartner">
                                        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                             stroke-width="2" stroke-linecap="round" aria-hidden="true">
                                            <path d="M6 6l12 12M18 6L6 18"></path>
                                        </svg>
                                    </button>
                                </div>
                            }
                            else
                            {
                                <input class="cpa-input" type="search" autocomplete="off"
                                       placeholder="Search by card code or name…"
                                       value="@pickerTerm" @oninput="OnPickerInput" />
                                @if (isPickerSearching)
                                {
                                    <span class="cpa-hint">Searching&#8230;</span>
                                }
                                else if (pickerResults.Count > 0)
                                {
                                    <div class="cpa-picker-list">
                                        @foreach (var partner in pickerResults)
                                        {
                                            <button type="button" class="cpa-picker-opt"
                                                    @onclick="() => PickPartner(partner)">
                                                <span class="cpa-picker-code">@partner.CardCode</span>@partner.CardName
                                            </button>
                                        }
                                    </div>
                                }
                                else if (pickerTerm.Trim().Length >= 2)
                                {
                                    <span class="cpa-hint">
                                        No customer matches that, or every match already has a portal account.
                                    </span>
                                }
                                else
                                {
                                    <span class="cpa-hint">
                                        Type at least two characters. Customers that already have an account are
                                        left out.
                                    </span>
                                }
                            }
                        </div>

                        <hr class="cpa-rule" />
                    }

                    <div class="cpa-form-grid">
                        <label class="cpa-field">
                            <span class="cpa-label">Card code <span class="cpa-required">*</span></span>
                            <input class="cpa-input" @bind="form.CardCode" readonly="@isEditing" />
                        </label>
                        <label class="cpa-field">
                            <span class="cpa-label">Customer name <span class="cpa-required">*</span></span>
                            <input class="cpa-input" @bind="form.CardName" />
                        </label>
                        <label class="cpa-field cpa-form-wide">
                            <span class="cpa-label">Email <span class="cpa-required">*</span></span>
                            <input class="cpa-input" type="email" @bind="form.Email" />
                        </label>

                        @if (!isEditing)
                        {
                            <div class="cpa-field">
                                <label class="cpa-label" for="cpa-pw">
                                    Password <span class="cpa-required">*</span>
                                </label>
                                <span class="cpa-input-wrap">
                                    <input id="cpa-pw" class="cpa-input" type="@(showPassword ? "text" : "password")"
                                           autocomplete="new-password" @bind="form.Password" />
                                    <button type="button" class="cpa-icon-btn"
                                            aria-label="@(showPassword ? "Hide password" : "Show password")"
                                            @onclick="() => showPassword = !showPassword">
                                        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                             stroke-width="1.6" stroke-linecap="round" aria-hidden="true">
                                            <path d="M2 12s3.6-6 10-6 10 6 10 6-3.6 6-10 6-10-6-10-6z"></path>
                                            <circle cx="12" cy="12" r="2.6"></circle>
                                            @if (showPassword)
                                            {
                                                <path d="M4 20L20 4"></path>
                                            }
                                        </svg>
                                    </button>
                                </span>
                                <span class="cpa-hint">
                                    At least 8 characters, with an uppercase letter, a lowercase letter, a number and
                                    a symbol.
                                </span>
                            </div>
                            <div class="cpa-field">
                                <label class="cpa-label" for="cpa-pw2">
                                    Confirm password <span class="cpa-required">*</span>
                                </label>
                                <input id="cpa-pw2" class="cpa-input" type="@(showPassword ? "text" : "password")"
                                       autocomplete="new-password" @bind="form.ConfirmPassword" />
                                <button type="button" class="cpa-btn cpa-btn-ghost cpa-btn-sm"
                                        style="align-self:flex-start" @onclick="GenerateFormPassword">
                                    Generate a strong password
                                </button>
                            </div>
                        }
                    </div>

                    <hr class="cpa-rule" />

                    <div class="cpa-side-section" style="padding:0; border:0; gap:12px">
                        <label class="cpa-switch">
                            <input type="checkbox" @bind="form.IsActive" />
                            <span class="cpa-track" aria-hidden="true"><span class="cpa-knob"></span></span>
                            <span class="cpa-switch-text">
                                <span class="cpa-switch-title">Account active</span>
                                <span class="cpa-switch-note">An inactive account cannot sign in</span>
                            </span>
                        </label>
                        <label class="cpa-switch">
                            <input type="checkbox" @bind="form.TwoFactorEnabled" />
                            <span class="cpa-track" aria-hidden="true"><span class="cpa-knob"></span></span>
                            <span class="cpa-switch-text">
                                <span class="cpa-switch-title">Two-factor sign-in</span>
                                <span class="cpa-switch-note">One-time code by email</span>
                            </span>
                        </label>
                        <label class="cpa-switch">
                            <input type="checkbox" @bind="form.ReceiveStatements" />
                            <span class="cpa-track" aria-hidden="true"><span class="cpa-knob"></span></span>
                            <span class="cpa-switch-text">
                                <span class="cpa-switch-title">Monthly statements</span>
                                <span class="cpa-switch-note">Emailed on the 1st, visible in portal</span>
                            </span>
                        </label>
                    </div>
                </div>

                <div class="cpa-dialog-foot">
                    <button type="button" class="cpa-btn cpa-btn-quiet" @onclick="CloseFormDialog">Cancel</button>
                    <button type="button" class="cpa-btn cpa-btn-primary" disabled="@isSaving" @onclick="SaveAccount">
                        @if (isSaving)
                        {
                            <span class="cpa-spin" aria-hidden="true"></span>
                        }
                        @(isEditing ? "Save changes" : "Create account")
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@if (showResetDialog && Selected is not null)
{
    var account = Selected;

    <div class="cpa-overlay">
        <div class="cpa-scrim" @onclick="() => showResetDialog = false"></div>
        <div class="cpa-modal">
            <div class="cpa-dialog" role="dialog" aria-modal="true" aria-label="Reset password">
                <div class="cpa-dialog-head">
                    <div>
                        <h2>Reset password</h2>
                        <div class="cpa-dialog-sub">@account.CardCode &#183; @account.CardName</div>
                    </div>
                    <button type="button" class="cpa-icon-btn" aria-label="Close"
                            @onclick="() => showResetDialog = false">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                             stroke-width="2" stroke-linecap="round" aria-hidden="true">
                            <path d="M6 6l12 12M18 6L6 18"></path>
                        </svg>
                    </button>
                </div>

                <div class="cpa-dialog-body">
                    <div class="cpa-field">
                        <label class="cpa-label" for="cpa-newpw">New password</label>
                        <span class="cpa-input-wrap">
                            <input id="cpa-newpw" class="cpa-input" type="@(showNewPassword ? "text" : "password")"
                                   autocomplete="new-password" @bind="newPassword" />
                            <button type="button" class="cpa-icon-btn"
                                    aria-label="@(showNewPassword ? "Hide password" : "Show password")"
                                    @onclick="() => showNewPassword = !showNewPassword">
                                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                     stroke-width="1.6" stroke-linecap="round" aria-hidden="true">
                                    <path d="M2 12s3.6-6 10-6 10 6 10 6-3.6 6-10 6-10-6-10-6z"></path>
                                    <circle cx="12" cy="12" r="2.6"></circle>
                                    @if (showNewPassword)
                                    {
                                        <path d="M4 20L20 4"></path>
                                    }
                                </svg>
                            </button>
                        </span>
                        <span class="cpa-hint">
                            At least 8 characters, with an uppercase letter, a lowercase letter, a number and a
                            symbol. Resetting also clears any lockout.
                        </span>
                        <button type="button" class="cpa-btn cpa-btn-ghost cpa-btn-sm" style="align-self:flex-start"
                                @onclick="GenerateResetPassword">
                            Generate a strong password
                        </button>
                    </div>
                </div>

                <div class="cpa-dialog-foot">
                    <button type="button" class="cpa-btn cpa-btn-quiet" @onclick="() => showResetDialog = false">
                        Cancel
                    </button>
                    <button type="button" class="cpa-btn cpa-btn-primary" disabled="@isSaving" @onclick="ResetPassword">
                        @if (isSaving)
                        {
                            <span class="cpa-spin" aria-hidden="true"></span>
                        }
                        Reset password
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@if (showDeleteDialog && Selected is not null)
{
    var account = Selected;

    <div class="cpa-overlay">
        <div class="cpa-scrim" @onclick="() => showDeleteDialog = false"></div>
        <div class="cpa-modal">
            <div class="cpa-dialog" role="dialog" aria-modal="true" aria-label="Delete portal account">
                <div class="cpa-dialog-head">
                    <div>
                        <h2>Delete this portal account?</h2>
                        <div class="cpa-dialog-sub">@account.CardCode &#183; @account.CardName</div>
                    </div>
                </div>

                <div class="cpa-dialog-body">
                    <div class="cpa-msg cpa-msg-bad">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                             stroke-width="1.7" stroke-linecap="round" aria-hidden="true">
                            <circle cx="12" cy="12" r="9"></circle>
                            <path d="M12 7.5v5.5M12 16.2v.1"></path>
                        </svg>
                        <span class="cpa-msg-text">
                            They lose portal access immediately, along with any linked accounts set up here. The
                            customer's SAP record is untouched. This cannot be undone.
                        </span>
                    </div>
                </div>

                <div class="cpa-dialog-foot">
                    <button type="button" class="cpa-btn cpa-btn-quiet" @onclick="() => showDeleteDialog = false">
                        Cancel
                    </button>
                    <button type="button" class="cpa-btn cpa-btn-danger" disabled="@isSaving" @onclick="DeleteAccount">
                        @if (isSaving)
                        {
                            <span class="cpa-spin" aria-hidden="true"></span>
                        }
                        Delete account
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@if (showActivityDialog && Selected is not null)
{
    var account = Selected;

    <div class="cpa-overlay">
        <div class="cpa-scrim" @onclick="() => showActivityDialog = false"></div>
        <div class="cpa-modal">
            <div class="cpa-dialog cpa-dialog-lg" role="dialog" aria-modal="true" aria-label="Account activity">
                <div class="cpa-dialog-head">
                    <div>
                        <h2>Activity</h2>
                        <div class="cpa-dialog-sub">
                            @account.CardCode &#183; the 50 most recent portal security events
                        </div>
                    </div>
                    <button type="button" class="cpa-icon-btn" aria-label="Close"
                            @onclick="() => showActivityDialog = false">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                             stroke-width="2" stroke-linecap="round" aria-hidden="true">
                            <path d="M6 6l12 12M18 6L6 18"></path>
                        </svg>
                    </button>
                </div>

                <div class="cpa-dialog-body">
                    @if (isLoadingActivity)
                    {
                        <div class="cpa-mini-empty">Loading activity&#8230;</div>
                    }
                    else if (activity.Count == 0)
                    {
                        <div class="cpa-mini-empty">Nothing recorded for this account yet.</div>
                    }
                    else
                    {
                        <div class="cpa-mini-wrap">
                            <table class="cpa-mini">
                                <thead>
                                    <tr>
                                        <th scope="col">When</th>
                                        <th scope="col">Action</th>
                                        <th scope="col">Result</th>
                                        <th scope="col">From</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var entry in activity)
                                    {
                                        <tr>
                                            <td class="cpa-fact-num">@When(entry.Timestamp)</td>
                                            <td>@entry.Action</td>
                                            <td>
                                                <span class="cpa-chip @(entry.Success ? "cpa-chip-on" : "")">
                                                    @(entry.Success ? "OK" : Dash(entry.FailureReason))
                                                </span>
                                            </td>
                                            <td class="cpa-fact-num">@Dash(entry.IpAddress)</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </div>

                <div class="cpa-dialog-foot">
                    <button type="button" class="cpa-btn cpa-btn-quiet" @onclick="() => showActivityDialog = false">
                        Close
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@if (showLinkedDialog && Selected is not null)
{
    var account = Selected;

    <div class="cpa-overlay">
        <div class="cpa-scrim" @onclick="CloseLinkedDialog"></div>
        <div class="cpa-modal">
            <div class="cpa-dialog cpa-dialog-xl" role="dialog" aria-modal="true" aria-label="Linked accounts">
                <div class="cpa-dialog-head">
                    <div>
                        <h2>Linked accounts</h2>
                        <div class="cpa-dialog-sub">
                            @account.CardCode &#183; @account.CardName &#183; @StructureLabel(account)
                        </div>
                    </div>
                    <button type="button" class="cpa-icon-btn" aria-label="Close" @onclick="CloseLinkedDialog">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                             stroke-width="2" stroke-linecap="round" aria-hidden="true">
                            <path d="M6 6l12 12M18 6L6 18"></path>
                        </svg>
                    </button>
                </div>

                <div class="cpa-dialog-body">
                    @if (!string.IsNullOrEmpty(linkedMessage))
                    {
                        <div class="cpa-msg @(linkedMessageIsError ? "cpa-msg-bad" : "cpa-msg-good")" role="status">
                            <span class="cpa-msg-text">@linkedMessage</span>
                            <button type="button" class="cpa-icon-btn" aria-label="Dismiss"
                                    @onclick="() => linkedMessage = null">
                                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                     stroke-width="2.2" stroke-linecap="round" aria-hidden="true">
                                    <path d="M6 6l12 12M18 6L6 18"></path>
                                </svg>
                            </button>
                        </div>
                    }

                    <div class="cpa-guide">
                        <strong>Main</strong> accounts carry invoicing and incoming payments &#8212; typically one
                        per currency. <strong>Sub</strong> accounts carry sales orders and invoicing, and their
                        balances roll up to the main account they derive from.
                    </div>

                    @if (linkedAccounts is { Count: > 0 })
                    {
                        <div class="cpa-mini-wrap">
                            <table class="cpa-mini">
                                <thead>
                                    <tr>
                                        <th scope="col">Card code</th>
                                        <th scope="col">Name</th>
                                        <th scope="col">Type</th>
                                        <th scope="col">Currency</th>
                                        <th scope="col">Parent</th>
                                        <th scope="col">Transactions</th>
                                        <th scope="col">Description</th>
                                        <th scope="col"><span class="visually-hidden">Remove</span></th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var linked in linkedAccounts)
                                    {
                                        <tr>
                                            <td><span class="cpa-code">@linked.CardCode</span></td>
                                            <td>@linked.CardName</td>
                                            <td>
                                                <span class="cpa-chip @(linked.AccountType == "Main" ? "cpa-chip-on" : "")">
                                                    @linked.AccountType
                                                </span>
                                            </td>
                                            <td>@Dash(linked.Currency)</td>
                                            <td>@Dash(linked.ParentCardCode)</td>
                                            <td>
                                                <span class="cpa-access">
                                                    @foreach (var transaction in linked.AllowedTransactions)
                                                    {
                                                        <span class="cpa-chip">@transaction</span>
                                                    }
                                                </span>
                                            </td>
                                            <td>@Dash(linked.Description)</td>
                                            <td class="cpa-td-right">
                                                <button type="button" class="cpa-icon-btn" disabled="@isSaving"
                                                        title="Remove @linked.CardCode"
                                                        aria-label="Remove @linked.CardCode"
                                                        @onclick="() => RemoveLinkedAccount(linked.CardCode)">
                                                    <svg width="13" height="13" viewBox="0 0 24 24" fill="none"
                                                         stroke="currentColor" stroke-width="2" stroke-linecap="round"
                                                         aria-hidden="true">
                                                        <path d="M6 6l12 12M18 6L6 18"></path>
                                                    </svg>
                                                </button>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>

                        @if (account.AccountStructure == "Multi")
                        {
                            <div>
                                <button type="button" class="cpa-btn cpa-btn-danger cpa-btn-sm" disabled="@isSaving"
                                        @onclick="ConvertToSingleAccount">
                                    Convert back to a single account
                                </button>
                            </div>
                        }
                    }
                    else
                    {
                        <div class="cpa-mini-empty">
                            Nothing linked yet &#8212; this account trades on @account.CardCode alone.
                        </div>
                    }

                    <hr class="cpa-rule" />

                    <div class="cpa-bulk-bar">
                        <div class="cpa-side-label" style="flex:1">
                            @(showBulkAdd ? "Add many sub accounts" : "Add a linked account")
                        </div>
                        <button type="button" class="cpa-btn cpa-btn-quiet cpa-btn-sm"
                                @onclick="() => { showBulkAdd = !showBulkAdd; bulkResults = null; bulkSelected.Clear(); bulkTerm = string.Empty; }">
                            @(showBulkAdd ? "Add one instead" : "Bulk add sub accounts")
                        </button>
                    </div>

                    @if (!showBulkAdd)
                    {
                        <div class="cpa-form-grid">
                            <div class="cpa-field cpa-form-wide cpa-picker">
                                <span class="cpa-label">Business partner</span>
                                @if (linkedPickedPartner is not null)
                                {
                                    <div class="cpa-picked">
                                        <span class="cpa-picker-code">@linkedPickedPartner.CardCode</span>
                                        <span class="cpa-picked-name">@linkedPickedPartner.CardName</span>
                                        <button type="button" class="cpa-icon-btn" aria-label="Clear selection"
                                                @onclick="() => linkedPickedPartner = null">
                                            <svg width="13" height="13" viewBox="0 0 24 24" fill="none"
                                                 stroke="currentColor" stroke-width="2" stroke-linecap="round"
                                                 aria-hidden="true">
                                                <path d="M6 6l12 12M18 6L6 18"></path>
                                            </svg>
                                        </button>
                                    </div>
                                }
                                else
                                {
                                    <input class="cpa-input" type="search" autocomplete="off"
                                           placeholder="Search by card code or name…"
                                           value="@linkedPickerTerm" @oninput="OnLinkedPickerInput" />
                                    @if (linkedPickerResults.Count > 0)
                                    {
                                        <div class="cpa-picker-list">
                                            @foreach (var partner in linkedPickerResults)
                                            {
                                                <button type="button" class="cpa-picker-opt"
                                                        @onclick="() => PickLinkedPartner(partner)">
                                                    <span class="cpa-picker-code">@partner.CardCode</span>@partner.CardName
                                                </button>
                                            }
                                        </div>
                                    }
                                }
                            </div>

                            <label class="cpa-field">
                                <span class="cpa-label">Account type</span>
                                <span class="cpa-select">
                                    <select class="cpa-input" @bind="newLinkedType">
                                        <option value="Main">Main</option>
                                        <option value="Sub">Sub</option>
                                    </select>
                                    <span class="cpa-caret" aria-hidden="true"></span>
                                </span>
                            </label>
                            <label class="cpa-field">
                                <span class="cpa-label">Currency</span>
                                <span class="cpa-select">
                                    <select class="cpa-input" @bind="newLinkedCurrency">
                                        <option value="">Not set</option>
                                        <option value="USD">USD</option>
                                        <option value="ZiG">ZiG</option>
                                    </select>
                                    <span class="cpa-caret" aria-hidden="true"></span>
                                </span>
                            </label>
                            <label class="cpa-field">
                                <span class="cpa-label">Parent (for a sub account)</span>
                                <span class="cpa-select">
                                    <select class="cpa-input" @bind="newLinkedParent" disabled="@(newLinkedType != "Sub")">
                                        <option value="">None</option>
                                        @foreach (var main in MainAccounts)
                                        {
                                            <option value="@main.CardCode">@main.CardCode (@Dash(main.Currency))</option>
                                        }
                                        @if (!MainAccounts.Any(m => m.CardCode == account.CardCode))
                                        {
                                            <option value="@account.CardCode">@account.CardCode (portal account)</option>
                                        }
                                    </select>
                                    <span class="cpa-caret" aria-hidden="true"></span>
                                </span>
                            </label>
                            <label class="cpa-field">
                                <span class="cpa-label">Description</span>
                                <input class="cpa-input" placeholder="e.g. ZiG main" @bind="newLinkedDescription" />
                            </label>
                            <div class="cpa-field cpa-form-wide">
                                <button type="button" class="cpa-btn cpa-btn-primary" style="align-self:flex-start"
                                        disabled="@isSaving" @onclick="AddLinkedAccount">
                                    @if (isSaving)
                                    {
                                        <span class="cpa-spin" aria-hidden="true"></span>
                                    }
                                    Add linked account
                                </button>
                            </div>
                        </div>
                    }
                    else
                    {
                        <div class="cpa-form-grid">
                            <label class="cpa-field">
                                <span class="cpa-label">Currency</span>
                                <span class="cpa-select">
                                    <select class="cpa-input" @bind="bulkCurrency">
                                        <option value="">Not set</option>
                                        <option value="USD">USD</option>
                                        <option value="ZiG">ZiG</option>
                                    </select>
                                    <span class="cpa-caret" aria-hidden="true"></span>
                                </span>
                            </label>
                            <label class="cpa-field">
                                <span class="cpa-label">Parent main account</span>
                                <span class="cpa-select">
                                    <select class="cpa-input" @bind="bulkParent">
                                        <option value="">Choose one</option>
                                        @foreach (var main in MainAccounts)
                                        {
                                            <option value="@main.CardCode">@main.CardCode (@Dash(main.Currency))</option>
                                        }
                                        @if (!MainAccounts.Any(m => m.CardCode == account.CardCode))
                                        {
                                            <option value="@account.CardCode">@account.CardCode (portal account)</option>
                                        }
                                    </select>
                                    <span class="cpa-caret" aria-hidden="true"></span>
                                </span>
                            </label>
                            <label class="cpa-field cpa-form-wide">
                                <span class="cpa-label">Description</span>
                                <input class="cpa-input" placeholder="e.g. Sub account - USD" @bind="bulkDescription" />
                            </label>
                        </div>

                        <div class="cpa-bulk-bar">
                            <label class="cpa-field">
                                <span class="cpa-label">Search business partners</span>
                                <input class="cpa-input" type="search" autocomplete="off"
                                       placeholder="Card code or name…" @bind="bulkTerm" />
                            </label>
                            <button type="button" class="cpa-btn cpa-btn-quiet" disabled="@isBulkSearching"
                                    @onclick="BulkSearch">
                                @if (isBulkSearching)
                                {
                                    <span class="cpa-spin" aria-hidden="true"></span>
                                }
                                Search
                            </button>
                            @if (bulkSelected.Count > 0)
                            {
                                <span class="cpa-selected-count">@bulkSelected.Count selected</span>
                            }
                            <button type="button" class="cpa-btn cpa-btn-primary"
                                    disabled="@(isBulkAdding || bulkSelected.Count == 0)"
                                    @onclick="BulkAddLinkedAccounts">
                                @if (isBulkAdding)
                                {
                                    <span class="cpa-spin" aria-hidden="true"></span>
                                }
                                Add @bulkSelected.Count selected
                            </button>
                        </div>

                        @if (bulkResults is not null)
                        {
                            <div class="cpa-mini-wrap">
                                <table class="cpa-mini">
                                    <thead>
                                        <tr>
                                            <th scope="col" style="width:38px">
                                                <input type="checkbox" class="cpa-box" aria-label="Select all results"
                                                       checked="@AllBulkSelected" @onchange="ToggleSelectAllBulk" />
                                            </th>
                                            <th scope="col">Card code</th>
                                            <th scope="col">Name</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @if (bulkResults.Count == 0)
                                        {
                                            <tr>
                                                <td colspan="3" class="cpa-mini-empty">No business partners match that.</td>
                                            </tr>
                                        }
                                        @foreach (var partner in bulkResults)
                                        {
                                            var alreadyLinked = IsAlreadyLinked(partner.CardCode);

                                            <tr>
                                                <td>
                                                    <input type="checkbox" class="cpa-box"
                                                           aria-label="Select @partner.CardCode"
                                                           checked="@bulkSelected.Contains(partner.CardCode)"
                                                           disabled="@alreadyLinked"
                                                           @onchange="() => ToggleBulkSelect(partner.CardCode)" />
                                                </td>
                                                <td>
                                                    <span class="cpa-code">@partner.CardCode</span>
                                                    @if (alreadyLinked)
                                                    {
                                                        <span class="cpa-type">Already linked</span>
                                                    }
                                                </td>
                                                <td>@partner.CardName</td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                    }
                </div>

                <div class="cpa-dialog-foot">
                    <button type="button" class="cpa-btn cpa-btn-quiet" @onclick="CloseLinkedDialog">Close</button>
                </div>
            </div>
        </div>
    </div>
}
