@page "/credit-notes/create"
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize(Roles = "Admin,Cashier")]
@inject ICreditNoteService CreditNoteService
@inject IMasterDataCacheService CacheService
@inject IBusinessPartnerPricingService BusinessPartnerPricingService
@inject NavigationManager NavigationManager
@inject IAppSettingsProvider AppSettings
@using ShopInventory.Web.Data
@using ShopInventory.Web.Services
@inject ISnackbar Snackbar
@inject ILogger<CreateCreditNote> Logger
@inject IAuditService AuditService
@rendermode InteractiveServer

<PageTitle>Create Credit Note - Shop Inventory</PageTitle>

@* Styles live in wwwroot/css/sales-forms.css (linked from App.razor), shared
   with the other four sales document forms — see that file's header. The sheet
   carries a light and a dark palette and follows the app's theme toggle.

   `is-credit` selects this form's line-editor columns from the sheet: a return
   prices tax per line and names the warehouse the stock comes back into, so it
   is the widest of the five.

   Icon-only controls draw their glyph inline rather than from the Phosphor
   font: the glyph is their whole label, so a font that failed to load would
   leave them reading as dead controls. Icons beside a word keep the font. *@

<div class="sfm is-credit">
    <div class="sfm-accentbar"></div>
    <div class="sfm-shell">

        <!-- ── Breadcrumb strip ───────────────────────────────────────── -->
        <div class="sfm-crumbs">
            <a href="/credit-notes">Credit notes</a>
            <span class="sfm-crumb-sep">/</span>
            <span class="sfm-crumb-now">Create new</span>
            <span class="sfm-spacer"></span>
            <a href="/credit-notes" class="sfm-btn"><i class="ph ph-arrow-left"></i>Back</a>
        </div>

        <!-- ── Head ───────────────────────────────────────────────────── -->
        <div class="sfm-head">
            <div class="sfm-head-main">
                <h1>Create credit note</h1>
                <p>Credits a customer for returned or over-billed goods &middot; posts to SAP Business One</p>
            </div>
            <div class="sfm-stats">
                <div class="sfm-stat">
                    <div class="sfm-stat-k">Lines</div>
                    <div class="sfm-stat-v">@newCreditNote.Lines.Count</div>
                </div>
                <div class="sfm-stat">
                    <div class="sfm-stat-k">Credit total</div>
                    <div class="sfm-stat-v is-total">@CalculateGrandTotal().ToString("N2")</div>
                </div>
            </div>
        </div>

        @if (!isMasterDataLoaded)
        {
            <div class="sfm-card sfm-loading">
                <span class="sfm-spin"></span>Loading master data&hellip;
            </div>
        }
        else
        {
            <div class="sfm-grid">
                <div class="sfm-main">

                    <!-- ── Customer ───────────────────────────────────── -->
                    <section class="sfm-card">
                        <div class="sfm-card-hd">
                            <i class="ph ph-user-circle"></i>
                            <h2>Customer</h2>
                            <span class="sfm-spacer"></span>
                            <span class="sfm-note">@allBusinessPartners.Count.ToString("N0") cached</span>
                        </div>
                        <div class="sfm-card-bd sfm-fields">
                            @* Not a <label>: the field carries a clear button and a result list, and a
                               label would forward stray clicks on them back to the input. *@
                            <div class="sfm-lab sfm-span2">
                                <span class="sfm-lab-t">Customer <span class="sfm-req">*</span></span>
                                <div class="sfm-combo">
                                    <input class="sfm-input" @bind="bpSearchTerm" @bind:event="oninput"
                                           @onfocus="() => showBPDropdown = true" @onblur="OnBPSearchBlur"
                                           placeholder="Search by code or name…" autocomplete="off" />
                                    @if (selectedBusinessPartner != null)
                                    {
                                        <button type="button" class="sfm-combo-clear" @onclick="ClearSelectedBP"
                                                title="Clear customer" aria-label="Clear customer">
                                            <i class="ph ph-x"></i>
                                        </button>
                                    }
                                    @if (showBPDropdown)
                                    {
                                        <div class="sfm-drop is-wide">
                                            @if (!filteredBusinessPartners.Any())
                                            {
                                                <div class="sfm-drop-empty">No customers match that search.</div>
                                            }
                                            else
                                            {
                                                @foreach (var bp in filteredBusinessPartners.Take(15))
                                                {
                                                    <button type="button" class="sfm-drop-i"
                                                            @onmousedown:preventDefault="true"
                                                            @onmousedown="() => SelectBusinessPartner(bp)">
                                                        <span>
                                                            <span class="sfm-drop-code">@bp.CardCode</span>
                                                            <span class="sfm-drop-sub">@bp.CardName</span>
                                                        </span>
                                                        @if (!string.IsNullOrEmpty(bp.Currency))
                                                        {
                                                            <span class="sfm-note">@bp.Currency</span>
                                                        }
                                                    </button>
                                                }
                                                @if (filteredBusinessPartners.Count() > 15)
                                                {
                                                    <div class="sfm-drop-empty">
                                                        @filteredBusinessPartners.Count().ToString("N0") match &mdash; type more to narrow.
                                                    </div>
                                                }
                                            }
                                        </div>
                                    }
                                </div>
                            </div>

                            @if (selectedBusinessPartner != null)
                            {
                                <div class="sfm-lab sfm-span2">
                                    <span class="sfm-lab-t">Selected</span>
                                    <div class="sfm-field-meta">
                                        <i class="ph-fill ph-check-circle"></i>@selectedBusinessPartner.CardCode
                                        &mdash; @selectedBusinessPartner.CardName
                                        @if (!string.IsNullOrEmpty(selectedBusinessPartner.Phone1))
                                        {
                                            <span> &middot; @selectedBusinessPartner.Phone1</span>
                                        }
                                        @if (customerPriceListNum.HasValue)
                                        {
                                            <span> &middot; price list #@customerPriceListNum</span>
                                            @if (isLoadingCustomerPrices)
                                            {
                                                <span class="sfm-spin sfm-gap-sm"></span>
                                            }
                                            else
                                            {
                                                <span> (@customerPricing.Count.ToString("N0") items)</span>
                                            }
                                        }
                                    </div>
                                </div>
                            }
                        </div>
                    </section>

                    <!-- ── Credit note details ────────────────────────── -->
                    <section class="sfm-card">
                        <div class="sfm-card-hd">
                            <i class="ph ph-info"></i>
                            <h2>Credit note details</h2>
                        </div>
                        <div class="sfm-card-bd sfm-fields">
                            <label class="sfm-lab">
                                <span class="sfm-lab-t">Type</span>
                                <select class="sfm-select" @bind="newCreditNote.Type">
                                    @foreach (CreditNoteType type in Enum.GetValues(typeof(CreditNoteType)))
                                    {
                                        <option value="@type">@type</option>
                                    }
                                </select>
                            </label>
                            <label class="sfm-lab">
                                <span class="sfm-lab-t">Currency</span>
                                <select class="sfm-select" @bind="newCreditNote.Currency">
                                    <option value="USD">USD</option>
                                    <option value="ZIG">ZIG</option>
                                </select>
                            </label>
                            <label class="sfm-lab">
                                <span class="sfm-lab-t">Restock warehouse</span>
                                <select class="sfm-select" @bind="newCreditNote.RestockWarehouseCode">
                                    <option value="">&mdash; Select &mdash;</option>
                                    @foreach (var wh in cachedWarehouses)
                                    {
                                        <option value="@wh.WarehouseCode">@wh.WarehouseCode</option>
                                    }
                                </select>
                            </label>
                            <div class="sfm-lab">
                                <span class="sfm-lab-t">Options</span>
                                <label class="sfm-check">
                                    <input type="checkbox" @bind="newCreditNote.RestockItems" />Restock items
                                </label>
                            </div>
                            <label class="sfm-lab sfm-span3">
                                <span class="sfm-lab-t">Reason <span class="sfm-req">*</span></span>
                                <input class="sfm-input" @bind="newCreditNote.Reason"
                                       placeholder="Reason for credit note" />
                            </label>
                        </div>
                    </section>

                    <!-- ── Lines ──────────────────────────────────────── -->
                    <section class="sfm-card">
                        <div class="sfm-card-hd">
                            <i class="ph ph-list-bullets"></i>
                            <h2>Credit note lines</h2>
                            <span class="sfm-spacer"></span>
                            <span class="sfm-count">@newCreditNote.Lines.Count</span>
                        </div>
                        <div class="sfm-lines @(IsAnyPickerOpen ? "is-picking" : "")">
                            <div class="sfm-lines-inner">
                                @if (!newCreditNote.Lines.Any())
                                {
                                    <button type="button" class="sfm-addline" @onclick="AddLine">
                                        <i class="ph ph-plus"></i>Add the first line
                                    </button>
                                }
                                else
                                {
                                    <div class="sfm-row is-head">
                                        <div>#</div>
                                        <div>Item</div>
                                        <div>Description</div>
                                        <div class="sfm-r">Qty</div>
                                        <div class="sfm-r">Unit price</div>
                                        <div class="sfm-r">Disc %</div>
                                        <div class="sfm-r">Tax %</div>
                                        <div>Warehouse</div>
                                        <div class="sfm-r">Total</div>
                                        <div></div>
                                    </div>

                                    @for (int i = 0; i < newCreditNote.Lines.Count; i++)
                                    {
                                        var index = i;
                                        var line = newCreditNote.Lines[index];
                                        var lineState = GetCnLineState(index);
                                        var badItem = showLineItemsError && string.IsNullOrWhiteSpace(line.ItemCode);
                                        var badQty = showLineItemsError && line.Quantity <= 0;

                                        <div class="sfm-row">
                                            <div class="sfm-n">@(index + 1)</div>
                                            <div class="sfm-combo">
                                                <input class="sfm-input sfm-cell @(badItem ? "is-bad" : "")"
                                                       value="@line.ItemCode"
                                                       @oninput="e => OnCnItemCodeInput(index, e.Value?.ToString())"
                                                       @onfocus="() => OnCnItemCodeFocus(index)"
                                                       @onblur="() => OnCnItemCodeBlur(index)"
                                                       placeholder="Search…" autocomplete="off" />
                                                @if (lineState.ShowDropdown)
                                                {
                                                    <div class="sfm-drop is-wide">
                                                        @if (!lineState.FilteredProducts.Any())
                                                        {
                                                            <div class="sfm-drop-empty">No items match that search.</div>
                                                        }
                                                        else
                                                        {
                                                            @foreach (var product in lineState.FilteredProducts.Take(10))
                                                            {
                                                                var isCustomerPrice = HasSpecialPrice(product.ItemCode);
                                                                <button type="button" class="sfm-drop-i"
                                                                        @onmousedown:preventDefault="true"
                                                                        @onmousedown="async () => await SelectCnProduct(index, product)">
                                                                    <span>
                                                                        <span class="sfm-drop-code">@product.ItemCode</span>
                                                                        <span class="sfm-drop-sub">@TruncateText(product.ItemName, 30)</span>
                                                                    </span>
                                                                    <span class="sfm-drop-price @(isCustomerPrice ? "is-customer" : "")">
                                                                        @GetPricingForItem(product.ItemCode, product.Price).NetPrice.ToString("N2")
                                                                    </span>
                                                                </button>
                                                            }
                                                            @if (lineState.FilteredProducts.Count > 10)
                                                            {
                                                                <div class="sfm-drop-empty">
                                                                    @(lineState.FilteredProducts.Count - 10) more &mdash; type to narrow.
                                                                </div>
                                                            }
                                                        }
                                                    </div>
                                                }
                                            </div>
                                            <input class="sfm-input sfm-desc" value="@line.ItemDescription"
                                                   placeholder="Select an item" readonly />
                                            <input type="number" min="0.001" step="0.001"
                                                   class="sfm-input sfm-num @(badQty ? "is-bad" : "")"
                                                   @bind="line.Quantity" />
                                            <input type="number" min="0" step="0.01"
                                                   class="sfm-input sfm-num" @bind="line.UnitPrice" />
                                            @* step matches SAP's six-decimal discounts so a special price like 5.714286% is not flagged as invalid *@
                                            <input type="number" min="0" max="100" step="0.000001"
                                                   class="sfm-input sfm-num" @bind="line.DiscountPercent" />
                                            <input type="number" min="0" max="100" step="0.01"
                                                   class="sfm-input sfm-num" @bind="line.TaxPercent" />
                                            <select class="sfm-select sfm-cell" @bind="line.WarehouseCode">
                                                <option value="">Default</option>
                                                @foreach (var wh in cachedWarehouses)
                                                {
                                                    <option value="@wh.WarehouseCode">@wh.WarehouseCode</option>
                                                }
                                            </select>
                                            <div class="sfm-r">
                                                <div class="sfm-amt-v">@CalculateLineTotal(line).ToString("N2")</div>
                                                @if (HasSpecialPrice(line.ItemCode))
                                                {
                                                    <div class="sfm-amt-x">Special price</div>
                                                }
                                            </div>
                                            @* The glyph is drawn inline, not set in the icon font: it is this
                                               button's only label, so a font that fails to load would leave an
                                               empty square that reads as a broken control. *@
                                            <button type="button" class="sfm-btn-x" title="Remove line"
                                                    aria-label="Remove line @(index + 1)"
                                                    @onclick="() => RemoveLine(index)">
                                                <svg viewBox="0 0 256 256" aria-hidden="true" focusable="false">
                                                    <path d="M205.66,194.34a8,8,0,0,1-11.32,11.32L128,139.31,61.66,205.66a8,8,0,0,1-11.32-11.32L116.69,128,50.34,61.66A8,8,0,0,1,61.66,50.34L128,116.69l66.34-66.35a8,8,0,0,1,11.32,11.32L139.31,128Z" />
                                                </svg>
                                            </button>
                                        </div>
                                    }

                                    <button type="button" class="sfm-addline" @onclick="AddLine">
                                        <i class="ph ph-plus"></i>Add another line
                                    </button>
                                }
                            </div>
                        </div>
                    </section>
                </div>

                <!-- ── Aside ──────────────────────────────────────────── -->
                <aside class="sfm-aside">
                    <div class="sfm-card sfm-total-card">
                        <div class="sfm-total-hd">
                            <span class="sfm-total-k">Credit total</span>
                            <span class="sfm-total-cur">@newCreditNote.Currency</span>
                        </div>
                        <div class="sfm-total-v">@CalculateGrandTotal().ToString("N2")</div>
                        <div class="sfm-total-sub">@newCreditNote.Lines.Count line(s)</div>

                        @if (showLineItemsError)
                        {
                            <div class="sfm-err-panel">
                                <div class="sfm-err-panel-t">
                                    <i class="ph ph-warning"></i>Please fix the following
                                </div>
                                <ul>
                                    <li>At least one line needs an item code and a quantity above zero.</li>
                                </ul>
                            </div>
                        }

                        <button type="button" class="sfm-btn-solid" @onclick="CreateCreditNoteAsync" disabled="@isCreating">
                            @if (isCreating)
                            {
                                <span class="sfm-spin on-solid"></span>
                                <span>Creating&hellip;</span>
                            }
                            else
                            {
                                <i class="ph-fill ph-check-circle"></i>
                                <span>Create credit note</span>
                            }
                        </button>
                        <a href="/credit-notes" class="sfm-btn sfm-btn-wide sfm-gap-sm">Cancel</a>
                    </div>

                    <div class="sfm-card sfm-panel">
                        <div class="sfm-card-hd">
                            <i class="ph ph-shield-check"></i>
                            <span class="sfm-panel-t">Pre-flight checks</span>
                            <span class="sfm-spacer"></span>
                            <span class="sfm-note">@PassedCheckCount/3</span>
                        </div>
                        <div class="sfm-checks">
                            <div class="sfm-checks-i @(HasCustomer ? "" : "is-no")">
                                <span class="sfm-checks-ic"><i class="ph-fill @(HasCustomer ? "ph-check" : "ph-x")"></i></span>
                                <span>Customer selected</span>
                            </div>
                            <div class="sfm-checks-i @(HasReason ? "" : "is-no")">
                                <span class="sfm-checks-ic"><i class="ph-fill @(HasReason ? "ph-check" : "ph-x")"></i></span>
                                <span>Reason given</span>
                            </div>
                            <div class="sfm-checks-i @(LinesComplete ? "" : "is-no")">
                                <span class="sfm-checks-ic"><i class="ph-fill @(LinesComplete ? "ph-check" : "ph-x")"></i></span>
                                <span>All lines complete</span>
                            </div>
                        </div>
                    </div>

                    <div class="sfm-card sfm-panel">
                        <div class="sfm-card-hd">
                            <i class="ph ph-database"></i>
                            <span class="sfm-panel-t">Cached data</span>
                        </div>
                        <div class="sfm-cache">
                            <div class="sfm-cache-i"><i class="ph ph-users"></i>@allBusinessPartners.Count.ToString("N0") customers</div>
                            <div class="sfm-cache-i"><i class="ph ph-cube"></i>@cachedProducts.Count.ToString("N0") products</div>
                            <div class="sfm-cache-i"><i class="ph ph-buildings"></i>@cachedWarehouses.Count.ToString("N0") warehouses</div>
                            <div class="sfm-cache-i"><i class="ph ph-tag"></i>@customerPricing.Count.ToString("N0") prices</div>
                        </div>
                    </div>
                </aside>
            </div>
        }
    </div>
</div>

@code {
    private CreateCreditNoteRequest newCreditNote = new();
    private bool isCreating = false;
    private bool showLineItemsError = false;
    private bool isMasterDataLoaded = false;

    private List<ProductDto> cachedProducts = new();
    private List<WarehouseDto> cachedWarehouses = new();
    private List<BusinessPartnerDto> allBusinessPartners = new();

    private BusinessPartnerDto? selectedBusinessPartner;
    private Dictionary<string, ResolvedItemPrice> customerPricing = new(StringComparer.OrdinalIgnoreCase);
    private int? customerPriceListNum;
    private bool isLoadingCustomerPrices = false;
    private string? bpSearchTerm;
    private bool showBPDropdown = false;

    private Dictionary<int, CnLineState> cnLineStates = new();

    private class CnLineState
    {
        public string SearchTerm { get; set; } = string.Empty;
        public bool ShowDropdown { get; set; } = false;
        public List<ProductDto> FilteredProducts { get; set; } = new();
    }

    // ── Pre-flight checks ───────────────────────────────
    // Stated in the aside so the operator sees what is still missing before
    // pressing Create, rather than after the round trip.

    private bool HasCustomer => selectedBusinessPartner != null
        && !string.IsNullOrEmpty(newCreditNote.CardCode);

    private bool HasReason => !string.IsNullOrWhiteSpace(newCreditNote.Reason);

    private bool LinesComplete => newCreditNote.Lines.Any()
        && newCreditNote.Lines.All(l => !string.IsNullOrWhiteSpace(l.ItemCode) && l.Quantity > 0);

    private int PassedCheckCount =>
        (HasCustomer ? 1 : 0) + (HasReason ? 1 : 0) + (LinesComplete ? 1 : 0);

    // The line scroller clips vertically as well as horizontally, which would cut
    // an open item picker off at the bottom of the table; the clip is lifted while
    // one is open. See .sfm-lines.is-picking.
    private bool IsAnyPickerOpen => cnLineStates.Values.Any(s => s.ShowDropdown);

    private IEnumerable<BusinessPartnerDto> filteredBusinessPartners
    {
        get
        {
            if (string.IsNullOrWhiteSpace(bpSearchTerm))
            {
                return allBusinessPartners.Take(50);
            }

            var search = bpSearchTerm.ToLowerInvariant();
            return allBusinessPartners.Where(bp =>
                (bp.CardCode?.ToLowerInvariant().Contains(search) ?? false) ||
                (bp.CardName?.ToLowerInvariant().Contains(search) ?? false));
        }
    }

    protected override async Task OnInitializedAsync()
    {
        await LoadMasterDataAsync();
    }

    private async Task LoadMasterDataAsync()
    {
        try
        {
            var productsTask = CacheService.GetProductsAsync();
            var warehousesTask = CacheService.GetWarehousesAsync();
            var bpTask = CacheService.GetBusinessPartnersAsync();
            await Task.WhenAll(productsTask, warehousesTask, bpTask);
            cachedProducts = await productsTask ?? new();
            cachedWarehouses = await warehousesTask ?? new();
            allBusinessPartners = await bpTask ?? new();
            isMasterDataLoaded = true;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error loading master data for credit note creation");
            isMasterDataLoaded = true;
        }
    }

    private async Task SelectBusinessPartnerAsync(BusinessPartnerDto bp)
    {
        selectedBusinessPartner = bp;
        newCreditNote.CardCode = bp.CardCode ?? string.Empty;
        newCreditNote.CardName = bp.CardName;
        showBPDropdown = false;

        await LoadBusinessPartnerPricesAsync(bp);
        UpdateExistingLinePrices();
    }

    private void SelectBusinessPartner(BusinessPartnerDto bp)
    {
        _ = SelectBusinessPartnerAsync(bp);
    }

    private void ClearSelectedBP()
    {
        selectedBusinessPartner = null;
        newCreditNote.CardCode = string.Empty;
        newCreditNote.CardName = null;
        bpSearchTerm = null;
        showBPDropdown = false;
        customerPricing.Clear();
        customerPriceListNum = null;
        UpdateExistingLinePrices();
    }

    private async Task OnBPSearchBlur()
    {
        await Task.Delay(200);
        showBPDropdown = false;
    }

    private CnLineState GetCnLineState(int index)
    {
        if (!cnLineStates.ContainsKey(index))
        {
            cnLineStates[index] = new CnLineState();
        }

        return cnLineStates[index];
    }

    private void UpdateExistingLinePrices()
    {
        foreach (var line in newCreditNote.Lines)
        {
            if (!string.IsNullOrWhiteSpace(line.ItemCode))
            {
                var product = cachedProducts.FirstOrDefault(p =>
                    string.Equals(p.ItemCode, line.ItemCode, StringComparison.OrdinalIgnoreCase));
                var defaultPrice = product?.Price ?? line.UnitPrice;
                ApplyPricing(line, GetPricingForItem(line.ItemCode, defaultPrice));
            }
        }
    }

    private async Task LoadBusinessPartnerPricesAsync(BusinessPartnerDto bp)
    {
        isLoadingCustomerPrices = true;
        StateHasChanged();

        try
        {
            var lookup = await BusinessPartnerPricingService.LoadPriceLookupAsync(bp);
            customerPricing = lookup.Pricing;
            customerPriceListNum = lookup.PriceListNum;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error loading credit note prices for {CardCode}", bp.CardCode);
            customerPricing.Clear();
            customerPriceListNum = null;
        }
        finally
        {
            isLoadingCustomerPrices = false;
            StateHasChanged();
        }
    }

    private ResolvedItemPrice GetPricingForItem(string? itemCode, decimal defaultPrice)
    {
        if (string.IsNullOrEmpty(itemCode))
        {
            return ResolvedItemPrice.Flat(defaultPrice);
        }

        return customerPricing.TryGetValue(itemCode, out var customerPrice)
            ? customerPrice
            : ResolvedItemPrice.Flat(defaultPrice);
    }

    /// <summary>
    /// Shows a customer's special price the way SAP does - the price list price in Unit Price and the
    /// gap in Discount % - rather than collapsing both into a net price with an empty discount.
    /// </summary>
    private static void ApplyPricing(CreateCreditNoteLineRequest line, ResolvedItemPrice pricing)
    {
        line.UnitPrice = pricing.UnitPrice;
        line.DiscountPercent = pricing.DiscountPercent;
    }

    private bool HasSpecialPrice(string? itemCode)
        => !string.IsNullOrEmpty(itemCode)
            && customerPricing.TryGetValue(itemCode, out var pricing)
            && pricing.DiscountPercent > 0;

    private void OnCnItemCodeInput(int index, string? value)
    {
        var line = newCreditNote.Lines[index];
        line.ItemCode = value ?? string.Empty;

        var state = GetCnLineState(index);
        state.SearchTerm = value ?? string.Empty;

        if (string.IsNullOrWhiteSpace(value))
        {
            state.FilteredProducts.Clear();
            state.ShowDropdown = false;
            line.ItemDescription = null;
            return;
        }

        var searchLower = value.ToLowerInvariant();
        var searchUpper = value.ToUpperInvariant();
        state.FilteredProducts = cachedProducts.Where(p =>
            (p.ItemCode?.ToUpperInvariant().StartsWith(searchUpper) ?? false) ||
            (p.ItemCode?.ToLowerInvariant().Contains(searchLower) ?? false) ||
            (p.ItemName?.ToLowerInvariant().Contains(searchLower) ?? false) ||
            (p.BarCode?.ToLowerInvariant().Contains(searchLower) ?? false))
            .OrderByDescending(p => p.ItemCode?.ToUpperInvariant().StartsWith(searchUpper) ?? false)
            .ThenBy(p => p.ItemCode)
            .ToList();

        state.ShowDropdown = true;
    }

    private void OnCnItemCodeFocus(int index)
    {
        var state = GetCnLineState(index);
        state.ShowDropdown = true;

        if (string.IsNullOrWhiteSpace(state.SearchTerm))
        {
            state.FilteredProducts = cachedProducts.Take(15).ToList();
        }
    }

    private async Task OnCnItemCodeBlur(int index)
    {
        await Task.Delay(200);
        var state = GetCnLineState(index);
        state.ShowDropdown = false;
    }

    private async Task SelectCnProduct(int index, ProductDto product)
    {
        var line = newCreditNote.Lines[index];
        line.ItemCode = product.ItemCode ?? string.Empty;
        line.ItemDescription = product.ItemName;
        ApplyPricing(line, GetPricingForItem(product.ItemCode, product.Price));

        if (!string.IsNullOrEmpty(product.ItemCode))
        {
            try
            {
                ApplyPricing(line, await BusinessPartnerPricingService.ResolveItemPriceAsync(
                    product.ItemCode,
                    selectedBusinessPartner?.Currency ?? AppSettings.DefaultCurrency,
                    product.Price,
                    newCreditNote.CardCode,
                    customerPriceListNum,
                    customerPricing));
            }
            catch (Exception ex)
            {
                Logger.LogWarning(ex, "Failed to resolve BP-aware credit note price for item {ItemCode}", product.ItemCode);
            }
        }

        if (string.IsNullOrEmpty(line.WarehouseCode))
        {
            line.WarehouseCode = string.IsNullOrEmpty(newCreditNote.RestockWarehouseCode)
                ? product.DefaultWarehouse
                : newCreditNote.RestockWarehouseCode;
        }

        var state = GetCnLineState(index);
        state.SearchTerm = line.ItemCode;
        state.ShowDropdown = false;
    }

    private void AddLine()
    {
        newCreditNote.Lines.Add(new CreateCreditNoteLineRequest
        {
            Quantity = 1,
            WarehouseCode = newCreditNote.RestockWarehouseCode ?? string.Empty
        });
        showLineItemsError = false;
    }

    private void RemoveLine(int index)
    {
        if (index >= 0 && index < newCreditNote.Lines.Count)
        {
            newCreditNote.Lines.RemoveAt(index);
            cnLineStates.Remove(index);

            var oldStates = new Dictionary<int, CnLineState>(cnLineStates);
            cnLineStates.Clear();

            for (int i = 0; i < newCreditNote.Lines.Count; i++)
            {
                var oldIndex = i >= index ? i + 1 : i;
                if (oldStates.TryGetValue(oldIndex, out var state))
                {
                    cnLineStates[i] = state;
                }
            }
        }
    }

    private decimal CalculateLineTotal(CreateCreditNoteLineRequest line)
    {
        var subtotal = line.Quantity * line.UnitPrice;
        var afterDiscount = subtotal * (1m - line.DiscountPercent / 100m);
        var tax = afterDiscount * (line.TaxPercent / 100m);
        return afterDiscount + tax;
    }

    private decimal CalculateGrandTotal()
    {
        return newCreditNote.Lines.Sum(l => CalculateLineTotal(l));
    }

    private async Task CreateCreditNoteAsync()
    {
        if (string.IsNullOrEmpty(newCreditNote.CardCode))
        {
            Snackbar.Add("Please select a customer.", Severity.Warning);
            return;
        }

        if (string.IsNullOrEmpty(newCreditNote.Reason))
        {
            Snackbar.Add("Please provide a reason for the credit note.", Severity.Warning);
            return;
        }

        if (newCreditNote.Lines.Count == 0 || !newCreditNote.Lines.Any(l => !string.IsNullOrWhiteSpace(l.ItemCode) && l.Quantity
> 0))
        {
            showLineItemsError = true;
            return;
        }

        showLineItemsError = false;
        isCreating = true;
        try
        {
            var result = await CreditNoteService.CreateCreditNoteAsync(newCreditNote);
            if (result != null)
            {
                Snackbar.Add($"Credit note {result.CreditNoteNumber} created successfully!", Severity.Success);
                await AuditService.LogAsync(AuditActions.CreateCreditNote, "CreditNote", result.CreditNoteNumber);
                NavigationManager.NavigateTo("/credit-notes");
            }
            else
            {
                Snackbar.Add("Failed to create credit note.", Severity.Error);
                await AuditService.LogAsync(AuditActions.CreateCreditNote, "CreditNote", newCreditNote.CardCode, null, false, "Failed to create credit note");
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error: {ex.Message}", Severity.Error);
        }
        finally
        {
            isCreating = false;
        }
    }

    private string TruncateText(string? text, int maxLength)
    {
        if (string.IsNullOrEmpty(text))
        {
            return "—";
        }

        return text.Length <= maxLength ? text : text.Substring(0, maxLength) + "...";
    }
}