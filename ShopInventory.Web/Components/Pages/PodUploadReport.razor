@page "/pod-report"
@using System.Globalization
@using Microsoft.AspNetCore.Authorization
@using ShopInventory.Web.Common
@using ShopInventory.Web.Models
@using ShopInventory.Web.Services
@attribute [Authorize(Roles = "Admin,Cashier,PodOperator,Driver,SalesRep")]
@inject AuthenticationStateProvider AuthStateProvider
@inject IPodService PodService
@inject IReportExportService ExportService
@inject IDeliveryRouteDirectory RouteDirectory
@inject IJSRuntime JS
@inject NavigationManager Navigation
@rendermode InteractiveServer
@implements IAsyncDisposable

<PageTitle>Product and Crate POD Upload Report - Shop Inventory</PageTitle>

@* Nocturne, imported from `POD Report.dc.html` in the claude.ai design project
   c1fbdfac-3c24-4b01-a378-e8dc569b49c7. wwwroot/css/pod-report.css (linked from
   App.razor) carries the design and its light counterpart and follows the app's
   theme toggle like every other page; the sidebar and top bar the design draws
   are the app's own chrome.

   The design gives product and crate proof of delivery a column each. In this
   data they are not independent: an invoice is either a crate invoice or a
   product one, and the handler resolves the POD it carries accordingly, so the
   column that does not apply reads as a dash rather than as missing. The tabs
   count the same way — "Missing product POD" is product invoices without one,
   never a crate invoice being asked for a product POD it can never have.

   Two figures the design states as one number are stated per currency here.
   The window can hold USD, ZWG and ZAR invoices at once, and one total across
   them would be a number that means nothing.

   The grid is a CSS grid rather than a <table>: below 1040px the same markup
   re-lays as a labelled card, which a table element cannot do.

   Icons are drawn inline rather than from the Phosphor font, for the reason the
   sibling pages give — a font that failed to load leaves a control reading as
   nothing, and here the status marks are what make a chase list scannable. *@

<div class="podr">

    <header class="podr-head">
        <div class="podr-head-inner">
            <div class="podr-crumbs">
                <span>Reports</span>
                <span aria-hidden="true">/</span>
                <span aria-current="page">Proof of delivery</span>
            </div>
            <div class="podr-head-meta">
                @if (report != null)
                {
                    <span class="podr-stamp">Run @runStamp?.ToString("dd MMM yyyy, HH:mm")</span>
                }
                <button type="button" class="podr-btn podr-btn-quiet"
                        disabled="@(isExporting || report == null || BaseFilteredCount == 0)" @onclick="ExportToExcel">
                    @if (isExporting)
                    {
                        <span class="podr-spin" aria-hidden="true"></span>
                        <span>Exporting&#8230;</span>
                    }
                    else
                    {
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                             stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <path d="M12 3v12"></path>
                            <path d="M7.5 10.5L12 15l4.5-4.5"></path>
                            <path d="M4 19h16"></path>
                        </svg>
                        <span>Export Excel</span>
                    }
                </button>
                <button type="button" class="podr-btn podr-btn-primary" disabled="@isLoading" @onclick="LoadReport">
                    @if (isLoading)
                    {
                        <span class="podr-spin" aria-hidden="true"></span>
                        <span>Running&#8230;</span>
                    }
                    else
                    {
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                             stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <path d="M20 11a8 8 0 0 0-13.7-5.3L4 8"></path>
                            <path d="M4 4v4h4"></path>
                            <path d="M4 13a8 8 0 0 0 13.7 5.3L20 16"></path>
                            <path d="M20 20v-4h-4"></path>
                        </svg>
                        <span>Run report</span>
                    }
                </button>
            </div>
        </div>
    </header>

    <div class="podr-body">

        <section class="podr-hero">
            <div>
                <div class="podr-kicker">Proof of delivery</div>
                <h1>Product and crate POD upload</h1>
                <p>Which invoices have proof of delivery attached &#8212; and which are still open.</p>
            </div>
        </section>

        @if (!string.IsNullOrEmpty(errorMessage))
        {
            <div class="podr-msg" role="alert">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"
                     stroke-linecap="round" aria-hidden="true">
                    <circle cx="12" cy="12" r="9"></circle>
                    <path d="M12 7.5v5.5M12 16.2v.1"></path>
                </svg>
                <span>@errorMessage</span>
            </div>
        }

        <section class="podr-panel">
            <div class="podr-controls">
                <div class="podr-seg" role="group" aria-label="Reporting window">
                    @foreach (var option in QuickRanges)
                    {
                        var value = option.Value;
                        <button type="button" class="podr-seg-opt @(selectedQuickRange == value ? "is-on" : null)"
                                aria-pressed="@(selectedQuickRange == value)" @onclick="() => SelectQuickRange(value)">
                            @option.Label
                        </button>
                    }
                    <button type="button" class="podr-seg-opt @(selectedQuickRange == "custom" ? "is-on" : null)"
                            aria-pressed="@(selectedQuickRange == "custom")" @onclick="SelectCustomRange">
                        Custom
                    </button>
                </div>

                @* Not a <label>: NocturneDateField carries a button and a popup,
                   which a label would swallow the clicks of. *@
                <div class="podr-dates">
                    <NocturneDateField Id="podr-from" @bind-Date="fromDate" @bind-Date:after="OnDateRangeChanged"
                                       AriaLabel="From date" />
                    <span class="podr-dates-arrow" aria-hidden="true">&#8594;</span>
                    <NocturneDateField Id="podr-to" @bind-Date="toDate" @bind-Date:after="OnDateRangeChanged"
                                       AriaLabel="To date" />
                </div>

                <label class="podr-search">
                    <span class="visually-hidden">Search this report</span>
                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"
                         stroke-linecap="round" aria-hidden="true">
                        <circle cx="11" cy="11" r="7"></circle>
                        <path d="M20 20l-3.5-3.5"></path>
                    </svg>
                    <input class="podr-input podr-input-search" type="search" autocomplete="off"
                           placeholder="Invoice #, customer or card code" @bind="searchTerm" @bind:event="oninput"
                           @bind:after="OnAdvancedFiltersChanged" />
                </label>

                <button type="button" class="podr-btn podr-btn-quiet" aria-expanded="@showMoreFilters"
                        @onclick="() => showMoreFilters = !showMoreFilters">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"
                         stroke-linecap="round" aria-hidden="true">
                        <path d="M4 7h16M7 12h10M10 17h4"></path>
                    </svg>
                    <span>@(showMoreFilters ? "Fewer filters" : "More filters")</span>
                </button>
            </div>

            @if (showMoreFilters)
            {
                <div class="podr-more">
                    <label class="podr-field">
                        <span class="podr-label">Delivery route</span>
                        <NocturneSelect Class="nsel-block" Options="RouteFilterOptions"
                                        @bind-Value="routeFilter" OnChanged="OnAdvancedFiltersChanged"
                                        Caption="Filter by delivery route" AriaLabel="Filter by delivery route" />
                    </label>
                    <label class="podr-field">
                        <span class="podr-label">Currency</span>
                        <NocturneSelect Class="nsel-block" Options="CurrencyFilterOptions"
                                        @bind-Value="currencyFilter" OnChanged="OnAdvancedFiltersChanged"
                                        Caption="Filter by currency" AriaLabel="Filter by currency" />
                    </label>
                    <label class="podr-field">
                        <span class="podr-label">Uploaded by</span>
                        <NocturneSelect Class="nsel-block" Options="UploaderFilterOptions"
                                        @bind-Value="uploadedByFilter" OnChanged="OnAdvancedFiltersChanged"
                                        Caption="Filter by uploader" AriaLabel="Filter by uploader" />
                    </label>
                    <label class="podr-field">
                        <span class="podr-label">Uploader role</span>
                        <NocturneSelect Class="nsel-block" Options="UploaderRoleFilterOptions"
                                        @bind-Value="uploaderRoleFilter" OnChanged="OnAdvancedFiltersChanged"
                                        Caption="Filter by uploader role" AriaLabel="Filter by uploader role" />
                    </label>
                    <label class="podr-field">
                        <span class="podr-label">Generated location</span>
                        <NocturneSelect Class="nsel-block" Options="GeneratedLocationFilterOptions"
                                        @bind-Value="generatedLocationFilter" OnChanged="OnAdvancedFiltersChanged"
                                        Caption="Filter by generated location"
                                        AriaLabel="Filter by generated location" />
                    </label>
                    <div class="podr-field">
                        <span class="podr-label">Amount range</span>
                        <div class="podr-pair">
                            <input class="podr-input" type="number" min="0" step="0.01" placeholder="Min"
                                   inputmode="decimal" aria-label="Minimum amount" @bind="minAmount"
                                   @bind:after="OnAdvancedFiltersChanged" />
                            <input class="podr-input" type="number" min="0" step="0.01" placeholder="Max"
                                   inputmode="decimal" aria-label="Maximum amount" @bind="maxAmount"
                                   @bind:after="OnAdvancedFiltersChanged" />
                        </div>
                    </div>
                </div>
            }
        </section>

        @if (isLoading)
        {
            <section class="podr-panel">
                <div class="podr-skeletons" aria-live="polite">
                    <span class="podr-count">Building report&#8230;</span>
                    @for (var i = 0; i < 7; i++)
                    {
                        <div class="podr-skeleton" style="animation-delay: @(FormatDelay(i))" aria-hidden="true"></div>
                    }
                </div>
            </section>
        }
        else if (report == null)
        {
            <section class="podr-unloaded">
                <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"
                     stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M4 20h16"></path>
                    <path d="M7 20v-6M12 20V8M17 20v-10"></path>
                </svg>
                <h2>No report loaded</h2>
                <p>
                    Pick a date range above and run the report to see which invoices are missing product or crate proof
                    of delivery.
                </p>
                <button type="button" class="podr-btn podr-btn-primary" @onclick="LoadReport">
                    Run report for @PresetLabel
                </button>
            </section>
        }
        else
        {
            @* Held in a local so the credit-note branches below read a non-null
               report through the nested lambdas the render tree compiles to. *@
            var loadedReport = report;

            @* Materialised once. Sorting is the one filter step that is not free,
               and reading the count, the page and the rows off separate property
               calls would sort the window three times a render. *@
            var rows = FilteredItems.ToList();
            var totalPages = rows.Count > 0 ? (int)Math.Ceiling(rows.Count / (double)pageSize) : 1;
            var pageNo = Math.Clamp(currentPage, 1, totalPages);
            var firstShown = rows.Count == 0 ? 0 : ((pageNo - 1) * pageSize) + 1;
            var lastShown = Math.Min(pageNo * pageSize, rows.Count);
            var firstLink = Math.Max(1, pageNo - 2);
            var lastLink = Math.Min(totalPages, firstLink + 4);

            <section class="podr-figs">
                <div class="podr-fig podr-fig-lead">
                    <div class="podr-fig-top">
                        <span class="podr-fig-num">@CompletePercentLabel</span>
                        <span class="podr-fig-of">@DocumentedCount of @BaseFilteredCount invoices</span>
                    </div>
                    <div class="podr-meter" role="img"
                         aria-label="@($"{CompletePercentLabel} of invoices fully documented")">
                        <div class="podr-meter-on" style="width: @CompletePercentLabel"></div>
                    </div>
                    <div class="podr-fig-label">Fully documented</div>
                </div>
                <div class="podr-fig @(MissingProductCount > 0 ? "podr-fig-risk" : null)">
                    <div class="podr-fig-top">
                        <span class="podr-fig-num">@MissingProductCount</span>
                    </div>
                    <div class="podr-fig-label">Missing product POD</div>
                    <div class="podr-fig-sub">@FormatAtRisk(MissingProductItems)</div>
                </div>
                <div class="podr-fig @(MissingCrateCount > 0 ? "podr-fig-risk" : null)">
                    <div class="podr-fig-top">
                        <span class="podr-fig-num">@MissingCrateCount</span>
                    </div>
                    <div class="podr-fig-label">Missing crate POD</div>
                    <div class="podr-fig-sub">@FormatAtRisk(MissingCrateItems)</div>
                </div>
                <div class="podr-fig">
                    <div class="podr-fig-top">
                        <span class="podr-fig-num">@MedianLagLabel</span>
                    </div>
                    <div class="podr-fig-label">Median upload lag</div>
                    @* Invoice date rather than delivery time: SAP carries a date on the
                       invoice, not a timestamp, so the lag is in whole days. *@
                    <div class="podr-fig-sub">Invoice date &#8594; upload</div>
                </div>
            </section>

            <section class="podr-panel">
                @* A group of toggles rather than a tablist: they filter one list
                   in place, they do not switch between panels. *@
                <div class="podr-tabs" role="group" aria-label="Filter by POD status">
                    @foreach (var tab in Tabs)
                    {
                        var key = tab.Key;
                        <button type="button" class="podr-tab @(activeTab == key ? "is-on" : null)"
                                aria-pressed="@(activeTab == key)" @onclick="() => SetTab(key)">
                            <span>@tab.Label</span>
                            <span class="podr-tab-n">@tab.Count</span>
                        </button>
                    }
                    <div class="podr-tabs-meta">
                        <span class="podr-count">Showing @rows.Count of @BaseFilteredCount invoices</span>
                        <button type="button" class="podr-btn podr-btn-ghost" @onclick="ResetAdvancedFilters">
                            Clear filters
                        </button>
                    </div>
                </div>

                @if (!loadedReport.CreditNoteDataComplete)
                {
                    <div class="podr-note" role="status" aria-live="polite">
                        @if (isRefreshingCreditNotes)
                        {
                            <span class="podr-spin" aria-hidden="true"></span>
                            <span>Credit-note status is updating. The report remains available.</span>
                        }
                        else
                        {
                            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                 stroke-width="1.7" stroke-linecap="round" aria-hidden="true">
                                <circle cx="12" cy="12" r="9"></circle>
                                <path d="M12 11v5.5M12 7.8v.1"></path>
                            </svg>
                            <span>
                                Credit-note synchronization is catching up automatically. Some statuses are not yet
                                verified.
                            </span>
                            <button type="button" class="podr-btn podr-btn-quiet podr-btn-sm"
                                    @onclick="RetryCreditNoteDataAsync">
                                Retry
                            </button>
                        }
                    </div>
                }

                @if (rows.Count == 0)
                {
                    <div class="podr-empty">
                        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                             stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <path d="M6 3h12v18l-3-2-3 2-3-2-3 2z"></path>
                            <path d="M9 9h6M9 13h4"></path>
                        </svg>
                        <span>No invoices match this filter. Widen the date range or clear the search.</span>
                        <div class="podr-empty-actions">
                            <button type="button" class="podr-btn podr-btn-quiet" @onclick="ResetAdvancedFilters">
                                Clear filters
                            </button>
                        </div>
                    </div>
                }
                else
                {
                    <div class="podr-scroll">
                        <div class="podr-grid" role="table" aria-label="Invoices and their proof of delivery">
                            <div class="podr-thead" role="row">
                                <span role="columnheader">
                                    <button type="button" class="podr-sort @(sortKey == "docnum" ? "is-on" : null)"
                                            @onclick='() => SortBy("docnum")'>
                                        Invoice / customer<span class="podr-sort-mark">@SortMark("docnum")</span>
                                    </button>
                                </span>
                                <span role="columnheader">
                                    <button type="button" class="podr-sort @(sortKey == "date" ? "is-on" : null)"
                                            @onclick='() => SortBy("date")'>
                                        Delivered<span class="podr-sort-mark">@SortMark("date")</span>
                                    </button>
                                </span>
                                <span role="columnheader" class="podr-amount">
                                    <button type="button" class="podr-sort @(sortKey == "amount" ? "is-on" : null)"
                                            @onclick='() => SortBy("amount")'>
                                        Amount<span class="podr-sort-mark">@SortMark("amount")</span>
                                    </button>
                                </span>
                                <span role="columnheader">Product POD</span>
                                <span role="columnheader">Crate POD</span>
                                <span role="columnheader">Credit note</span>
                                <span role="columnheader">
                                    <button type="button" class="podr-sort @(sortKey == "uploader" ? "is-on" : null)"
                                            @onclick='() => SortBy("uploader")'>
                                        Uploaded by<span class="podr-sort-mark">@SortMark("uploader")</span>
                                    </button>
                                </span>
                                <span role="columnheader"><span class="visually-hidden">Actions</span></span>
                            </div>

                            @foreach (var item in rows.Skip((pageNo - 1) * pageSize).Take(pageSize))
                            {
                                var docNum = item.DocNum;
                                var uploadedAt = GetDisplayPodUploadedAt(item);
                                var uploadLocation = FormatPodUploadLocationDisplay(item);
                                <div class="podr-row" role="row">
                                    <span class="podr-cell podr-cell-invoice" role="cell">
                                        <span class="podr-strong podr-docnum">@item.DocNum</span>
                                        <span class="podr-weak">@item.CardName</span>
                                        <span class="podr-weak">@item.CardCode</span>
                                        @{
                                            var itemRoutes = routeMap?.FormatRoutes(item.CardCode) ?? string.Empty;
                                        }
                                        @if (itemRoutes.Length > 0)
                                        {
                                            <span class="podr-weak podr-route">@itemRoutes</span>
                                        }
                                    </span>
                                    <span class="podr-cell podr-cell-delivered" role="cell">
                                        <span class="podr-strong">
                                            <span class="podr-rl">Delivered</span>@FormatDate(item.DocDate)
                                        </span>
                                        @if (!string.IsNullOrWhiteSpace(item.CreatedLocation))
                                        {
                                            <span class="podr-weak">
                                                @AssignedSectionOptions.GetLabel(item.CreatedLocation)
                                            </span>
                                        }
                                    </span>
                                    <span class="podr-cell podr-amount" role="cell">
                                        <span class="podr-strong">
                                            @item.DocCurrency @item.DocTotal.ToString("N2")
                                        </span>
                                    </span>
                                    <span class="podr-cell podr-cell-product" role="cell">
                                        @if (item.IsCrateInvoice)
                                        {
                                            <span class="podr-state is-na" title="This is a crate invoice.">
                                                <span class="podr-dot" aria-hidden="true"></span>
                                                <span class="podr-rl">Product POD</span>Not applicable
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="podr-state @(item.HasProductPod ? "is-on" : null)">
                                                <span class="podr-dot" aria-hidden="true"></span>
                                                <span class="podr-rl">Product POD</span>@(item.HasProductPod ? "Uploaded" : "Missing")
                                            </span>
                                            @if (item.ProductPodCount > 0)
                                            {
                                                <span class="podr-files">
                                                    @item.ProductPodCount @(item.ProductPodCount == 1 ? "file" : "files")
                                                </span>
                                            }
                                        }
                                    </span>
                                    <span class="podr-cell podr-cell-crate" role="cell">
                                        @if (!item.IsCrateInvoice)
                                        {
                                            <span class="podr-state is-na" title="This is a product invoice.">
                                                <span class="podr-dot" aria-hidden="true"></span>
                                                <span class="podr-rl">Crate POD</span>Not applicable
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="podr-state @(item.HasCratePod ? "is-on" : null)">
                                                <span class="podr-dot" aria-hidden="true"></span>
                                                <span class="podr-rl">Crate POD</span>@(item.HasCratePod ? "Uploaded" : "Missing")
                                            </span>
                                            @if (item.CratePodCount > 0)
                                            {
                                                <span class="podr-files">
                                                    @item.CratePodCount @(item.CratePodCount == 1 ? "file" : "files")
                                                </span>
                                            }
                                        }
                                    </span>
                                    <span class="podr-cell podr-cell-credit @(HasCreditCell(item) ? null : "podr-cell-blank")"
                                          role="cell">
                                        @if (!string.IsNullOrWhiteSpace(item.CreditNoteNumber))
                                        {
                                            <span class="podr-tag @(item.IsFullyCredited ? "podr-tag-credited" : null)"
                                                  title="@item.CreditNoteReason">
                                                <span class="podr-rl">Credit note</span>@item.CreditNoteNumber
                                            </span>
                                            @if (item.IsFullyCredited)
                                            {
                                                <span class="podr-weak">Fully credited</span>
                                            }
                                            else if (!string.IsNullOrWhiteSpace(item.CreditNoteReason))
                                            {
                                                <span class="podr-weak">@item.CreditNoteReason</span>
                                            }
                                        }
                                        else if (!loadedReport.CreditNoteDataComplete)
                                        {
                                            <span class="podr-none">
                                                <span class="podr-rl">Credit note</span>Not verified
                                            </span>
                                        }
                                        else
                                        {
                                            @* The em dash is the grid's way of holding an empty
                                               cell open. In the card layout below 1040px there is
                                               no column to hold open, so `podr-cell-blank` drops
                                               the whole line rather than leaving a stray dash. *@
                                            <span class="podr-none" aria-hidden="true">&#8212;</span>
                                        }
                                    </span>
                                    <span class="podr-cell podr-cell-uploader" role="cell">
                                        @if (item.HasPod && uploadedAt.HasValue)
                                        {
                                            <span class="podr-strong">
                                                <span class="podr-rl">Uploaded by</span>@FormatPodUploadedByDisplay(item)
                                            </span>
                                            <span class="podr-weak">
                                                @uploadedAt.Value.ToString("dd MMM yyyy HH:mm")
                                            </span>
                                            @if (!string.Equals(uploadLocation, "-", StringComparison.Ordinal))
                                            {
                                                <span class="podr-weak">@uploadLocation</span>
                                            }
                                        }
                                        else
                                        {
                                            <span class="podr-none">
                                                <span class="podr-rl">Uploaded by</span>Not uploaded
                                            </span>
                                        }
                                    </span>
                                    <span class="podr-actions" role="cell">
                                        @if (item.HasPod)
                                        {
                                            <button type="button" class="podr-btn podr-btn-ghost podr-btn-sm"
                                                    @onclick="() => GoToUpload(docNum)">
                                                View PODs
                                            </button>
                                        }
                                        else
                                        {
                                            <button type="button" class="podr-btn podr-btn-quiet podr-btn-sm"
                                                    @onclick="() => GoToUpload(docNum)">
                                                <svg width="13" height="13" viewBox="0 0 24 24" fill="none"
                                                     stroke="currentColor" stroke-width="1.8" stroke-linecap="round"
                                                     stroke-linejoin="round" aria-hidden="true">
                                                    <path d="M5 5h14"></path>
                                                    <path d="M12 20V9"></path>
                                                    <path d="M8 12.5L12 9l4 3.5"></path>
                                                </svg>
                                                <span>Upload</span>
                                            </button>
                                        }
                                    </span>
                                </div>
                            }
                        </div>
                    </div>

                    <div class="podr-foot">
                        <span class="podr-foot-info">
                            Showing @firstShown&#8211;@lastShown of @rows.Count
                        </span>
                        @if (totalPages > 1)
                        {
                            <div class="podr-pages">
                                <button type="button" class="podr-step" disabled="@(pageNo <= 1)"
                                        @onclick="() => GoToPage(pageNo - 1)">
                                    Previous
                                </button>
                                @for (var link = firstLink; link <= lastLink; link++)
                                {
                                    var target = link;
                                    <button type="button"
                                            class="podr-page @(target == pageNo ? "podr-page-on" : null)"
                                            aria-current="@(target == pageNo ? "page" : null)"
                                            @onclick="() => GoToPage(target)">
                                        @target
                                    </button>
                                }
                                <button type="button" class="podr-step" disabled="@(pageNo >= totalPages)"
                                        @onclick="() => GoToPage(pageNo + 1)">
                                    Next
                                </button>
                            </div>
                        }
                    </div>
                }
            </section>
        }
    </div>
</div>

@code {
    private PodUploadStatusReport? report;
    private bool isLoading;
    private bool isExporting;
    private bool isRefreshingCreditNotes;
    private bool isDisposed;
    private string? errorMessage;
    private CancellationTokenSource? creditNoteRefreshCts;
    private const int DefaultQuickRangeDays = 30;
    private DateTime? fromDate = InclusiveRangeStart(DateTime.Today, DefaultQuickRangeDays);
    private DateTime? toDate = DateTime.Today;
    private string selectedQuickRange = DefaultQuickRangeDays.ToString();
    private DateTime? runStamp;
    private string activeTab = "all";
    private string sortKey = "date";
    private bool sortAscending;
    private bool showMoreFilters;
    private string? searchTerm;
    // The routes as they currently stand: the generated catalogue with everyone's
    // reassignments applied. Read once per render pass rather than per row, since
    // filtering runs it over every invoice in the window.
    private RouteMap? routeMap;
    private string routeFilter = "all";
    private string currencyFilter = "all";
    private string uploadedByFilter = "all";
    private string uploaderRoleFilter = "all";
    private string generatedLocationFilter = "all";
    private decimal? minAmount;
    private decimal? maxAmount;
    private int currentPage = 1;
    private const int pageSize = 25;

    // The window control. "Custom" is drawn beside these rather than listed here
    // because it sets no range of its own — it only stops a preset claiming the
    // dates the user then typed.
    private static readonly (string Value, string Label)[] QuickRanges =
    [
        ("7", "7d"),
        ("30", "30d"),
        ("90", "90d"),
        ("180", "6m")
    ];

    // The dropdowns are NocturneSelect. "all" rather than an empty string is
    // this page's no-filter sentinel, so those rows carry IsUnset.
    private static NocturneSelectOption<string> AnyRow(string label) =>
        new("all", label, "neutral") { IsUnset = true, RuleAfter = true };

    // A shop that the routes workbook does not place on a truck still invoices,
    // so the menu offers it as its own choice rather than hiding those rows
    // behind "any route" -- that set is worth being able to look at.
    private const string UnroutedFilterValue = "__unrouted";

    private IEnumerable<NocturneSelectOption<string>> RouteFilterOptions
    {
        get
        {
            var routes = AvailableRoutes.ToList();
            var options = new List<NocturneSelectOption<string>> { AnyRow("Any route") };

            for (var index = 0; index < routes.Count; index++)
            {
                options.Add(new NocturneSelectOption<string>(
                    routes[index], DeliveryRoutes.GetLabel(routes[index]), "accent")
                {
                    RuleAfter = index == routes.Count - 1
                });
            }

            options.Add(new NocturneSelectOption<string>(
                UnroutedFilterValue, "Not on a route", "warn"));
            return options;
        }
    }

    private IEnumerable<NocturneSelectOption<string>> CurrencyFilterOptions =>
        AvailableCurrencies
            .Select(currency => new NocturneSelectOption<string>(currency, currency, "accent"))
            .Prepend(AnyRow("All currencies"));

    private IEnumerable<NocturneSelectOption<string>> UploaderFilterOptions =>
        AvailableUploaders
            .Select(uploader => new NocturneSelectOption<string>(uploader, uploader, "info"))
            .Prepend(AnyRow("Any uploader"));

    private IEnumerable<NocturneSelectOption<string>> UploaderRoleFilterOptions =>
        AvailableUploaderRoles
            .Select(role => new NocturneSelectOption<string>(role, role, "warn"))
            .Prepend(AnyRow("Any role"));

    // AssignedSectionOptions.GetLabel is the same helper the table labels a row
    // with, so the menu and the results cannot disagree about a location's name.
    private IEnumerable<NocturneSelectOption<string>> GeneratedLocationFilterOptions =>
        AvailableGeneratedLocations
            .Select(location => new NocturneSelectOption<string>(
                location, AssignedSectionOptions.GetLabel(location), "good"))
            .Prepend(AnyRow("Any location"));

    // Only the routes this report actually has invoices for, kept in the
    // catalogue's own order so the menu reads the way the workbook does rather
    // than re-sorting itself as the date range moves.
    private IEnumerable<string> AvailableRoutes
    {
        get
        {
            if (report?.Items == null || routeMap is null)
                return Enumerable.Empty<string>();

            var present = report.Items
                .SelectMany(item => routeMap.GetRoutes(item.CardCode))
                .ToHashSet(StringComparer.OrdinalIgnoreCase);

            return routeMap.Names.Where(present.Contains);
        }
    }

    private IEnumerable<string> AvailableCurrencies => report?.Items?
        .Select(i => i.DocCurrency?.Trim())
        .Where(currency => !string.IsNullOrWhiteSpace(currency))
        .Distinct(StringComparer.OrdinalIgnoreCase)
        .OrderBy(currency => currency)
        .Cast<string>()
        ?? Enumerable.Empty<string>();

    private IEnumerable<string> AvailableUploaders => report?.Items?
        .SelectMany(GetPodUploadedByUsers)
        .Select(uploader => uploader.Username.Trim())
        .Where(uploader => !string.IsNullOrWhiteSpace(uploader))
        .Distinct(StringComparer.OrdinalIgnoreCase)
        .OrderBy(uploader => uploader)
        ?? Enumerable.Empty<string>();

    private IEnumerable<string> AvailableUploaderRoles => report?.Items?
        .SelectMany(GetPodUploadedByUsers)
        .Select(uploader => uploader.Role?.Trim())
        .Where(role => !string.IsNullOrWhiteSpace(role))
        .Select(role => role!)
        .Distinct(StringComparer.OrdinalIgnoreCase)
        .OrderBy(role => role)
        ?? Enumerable.Empty<string>();

    private IEnumerable<string> AvailableGeneratedLocations => report?.Items?
        .Select(item => NormalizeLocationValue(item.CreatedLocation))
        .Where(location => !string.IsNullOrWhiteSpace(location))
        .Distinct(StringComparer.OrdinalIgnoreCase)
        .OrderBy(location => location)
        ?? Enumerable.Empty<string>();

    private bool HasUploaderIdentityFilters =>
        !string.Equals(uploadedByFilter, "all", StringComparison.OrdinalIgnoreCase) ||
        !string.Equals(uploaderRoleFilter, "all", StringComparison.OrdinalIgnoreCase);

    private bool HasGeneratedLocationFilter =>
        !string.Equals(generatedLocationFilter, "all", StringComparison.OrdinalIgnoreCase);

    private IEnumerable<PodUploadStatusItem> BaseFilteredItems
    {
        get
        {
            if (report?.Items == null)
                return Enumerable.Empty<PodUploadStatusItem>();

            var items = report.Items.AsEnumerable();

            if (!string.IsNullOrWhiteSpace(searchTerm))
            {
                var term = searchTerm.Trim();
                items = items.Where(i =>
                    (i.CardName?.Contains(term, StringComparison.OrdinalIgnoreCase) ?? false) ||
                    (i.CardCode?.Contains(term, StringComparison.OrdinalIgnoreCase) ?? false) ||
                    (i.CreditNoteNumber?.Contains(term, StringComparison.OrdinalIgnoreCase) ?? false) ||
                    (i.CreditNoteReason?.Contains(term, StringComparison.OrdinalIgnoreCase) ?? false) ||
                    i.DocNum.ToString().Contains(term));
            }

            if (routeMap is not null && !string.Equals(routeFilter, "all", StringComparison.OrdinalIgnoreCase))
            {
                items = string.Equals(routeFilter, UnroutedFilterValue, StringComparison.Ordinal)
                    ? items.Where(i => routeMap.GetRoutes(i.CardCode).Count == 0)
                    : items.Where(i => routeMap.IsOnRoute(i.CardCode, routeFilter));
            }

            if (!string.Equals(currencyFilter, "all", StringComparison.OrdinalIgnoreCase))
            {
                items = items.Where(i => string.Equals(i.DocCurrency?.Trim(), currencyFilter, StringComparison.OrdinalIgnoreCase));
            }

            if (HasUploaderIdentityFilters)
            {
                items = items.Where(i => GetUploaderFilteredPodUploadedByUsers(i).Any());
            }

            if (HasGeneratedLocationFilter)
            {
                items = items.Where(MatchesGeneratedLocationFilter);
            }

            if (minAmount.HasValue)
            {
                items = items.Where(i => i.DocTotal >= EffectiveMinAmount);
            }

            if (maxAmount.HasValue)
            {
                items = items.Where(i => i.DocTotal <= EffectiveMaxAmount);
            }

            return items;
        }
    }

    // An invoice is either a crate invoice or a product one — never both — so a
    // crate invoice is never counted as missing a product POD, and vice versa.
    // See GetPodUploadStatusHandler.ResolvePodTypeInfo.
    private static bool IsMissingProductPod(PodUploadStatusItem item) =>
        !item.IsCrateInvoice && !item.HasProductPod;

    private static bool IsMissingCratePod(PodUploadStatusItem item) =>
        item.IsCrateInvoice && !item.HasCratePod;

    private IEnumerable<PodUploadStatusItem> MissingProductItems => BaseFilteredItems.Where(IsMissingProductPod);
    private IEnumerable<PodUploadStatusItem> MissingCrateItems => BaseFilteredItems.Where(IsMissingCratePod);

    private IEnumerable<PodUploadStatusItem> FilteredItems
    {
        get
        {
            var items = activeTab switch
            {
                "product" => BaseFilteredItems.Where(IsMissingProductPod),
                "crate" => BaseFilteredItems.Where(IsMissingCratePod),
                "documented" => BaseFilteredItems.Where(i => i.HasPod),
                _ => BaseFilteredItems
            };

            return SortItems(items);
        }
    }

    // Every key but the invoice number breaks ties on the invoice number, so a
    // page of same-day deliveries keeps a stable order between renders.
    private IEnumerable<PodUploadStatusItem> SortItems(IEnumerable<PodUploadStatusItem> items) => sortKey switch
    {
        "docnum" => sortAscending
            ? items.OrderBy(i => i.DocNum)
            : items.OrderByDescending(i => i.DocNum),
        "amount" => sortAscending
            ? items.OrderBy(i => i.DocTotal).ThenBy(i => i.DocNum)
            : items.OrderByDescending(i => i.DocTotal).ThenByDescending(i => i.DocNum),
        "uploader" => sortAscending
            ? items.OrderBy(FormatPodUploadedByDisplay, StringComparer.OrdinalIgnoreCase).ThenBy(i => i.DocNum)
            : items.OrderByDescending(FormatPodUploadedByDisplay, StringComparer.OrdinalIgnoreCase)
                .ThenByDescending(i => i.DocNum),
        _ => sortAscending
            ? items.OrderBy(i => ParseDocDate(i.DocDate)).ThenBy(i => i.DocNum)
            : items.OrderByDescending(i => ParseDocDate(i.DocDate)).ThenByDescending(i => i.DocNum)
    };

    private IReadOnlyList<TabDefinition> Tabs =>
    [
        new("all", "All invoices", BaseFilteredCount),
        new("product", "Missing product POD", MissingProductCount),
        new("crate", "Missing crate POD", MissingCrateCount),
        new("documented", "Fully documented", DocumentedCount)
    ];

    private sealed record TabDefinition(string Key, string Label, int Count);

    private int BaseFilteredCount => BaseFilteredItems.Count();
    private int DocumentedCount => BaseFilteredItems.Count(i => i.HasPod);
    private int MissingProductCount => MissingProductItems.Count();
    private int MissingCrateCount => MissingCrateItems.Count();
    private int FilteredCount => FilteredItems.Count();
    private int EffectiveCurrentPage => Math.Clamp(currentPage, 1, TotalFilteredPages);

    private decimal EffectiveMinAmount => minAmount.HasValue && maxAmount.HasValue && minAmount.Value > maxAmount.Value
        ? maxAmount.Value
        : minAmount ?? 0m;
    private decimal EffectiveMaxAmount => minAmount.HasValue && maxAmount.HasValue && minAmount.Value > maxAmount.Value
        ? minAmount.Value
        : maxAmount ?? decimal.MaxValue;

    // Paging on the event paths only — what a render draws is computed once from
    // the materialised list, so nothing here re-sorts the window.
    private int TotalFilteredPages => FilteredCount > 0
        ? (int)Math.Ceiling((double)FilteredCount / pageSize) : 1;

    private string CompletePercentLabel => BaseFilteredCount == 0
        ? "0%"
        : Math.Round(DocumentedCount * 100.0 / BaseFilteredCount).ToString("0", CultureInfo.InvariantCulture) + "%";

    private string PresetLabel => selectedQuickRange switch
    {
        "7" => "the last 7 days",
        "30" => "the last 30 days",
        "90" => "the last 90 days",
        "180" => "the last 6 months",
        _ => "the selected range"
    };

    // The invoice carries a date and the upload a timestamp, so the lag is in
    // whole days rather than hours. Median rather than mean: one invoice whose
    // POD arrived a month late would otherwise move the whole figure.
    private string MedianLagLabel
    {
        get
        {
            var lags = BaseFilteredItems
                .Where(i => i.HasPod)
                .Select(i => new { Uploaded = GetDisplayPodUploadedAt(i), Raised = ParseDocDate(i.DocDate) })
                .Where(pair => pair.Uploaded.HasValue && pair.Raised != DateTime.MinValue)
                .Select(pair => (int)Math.Max(0, (pair.Uploaded!.Value.Date - pair.Raised.Date).TotalDays)
                )
                .OrderBy(days => days)
                .ToList();

            if (lags.Count == 0)
                return "—";

            var median = lags.Count % 2 == 1
                ? lags[lags.Count / 2]
                : (int)Math.Round((lags[(lags.Count / 2) - 1] + lags[lags.Count / 2]) / 2.0, MidpointRounding.AwayFromZero);

            return median switch
            {
                0 => "Same day",
                1 => "1 day",
                _ => $"{median} days"
            };
        }
    }

    // Stated per currency rather than summed: the window can hold USD, ZWG and
    // ZAR invoices at once, and adding them would produce a number that is not
    // an amount of anything.
    private static string FormatAtRisk(IEnumerable<PodUploadStatusItem> items)
    {
        var totals = items
            .GroupBy(i => string.IsNullOrWhiteSpace(i.DocCurrency) ? "?" : i.DocCurrency!.Trim(),
                StringComparer.OrdinalIgnoreCase)
            .Select(group => new { Currency = group.Key, Total = group.Sum(i => i.DocTotal) })
            .OrderByDescending(entry => entry.Total)
            .ToList();

        if (totals.Count == 0)
            return "Nothing outstanding";

        var shown = totals.Take(2).Select(entry => $"{entry.Currency} {entry.Total:N2}");
        var label = string.Join(" · ", shown);

        if (totals.Count > 2)
            label += $" +{totals.Count - 2} more";

        return label + " at risk";
    }

    private static string FormatDelay(int index) =>
        (index * 0.09).ToString("0.00", CultureInfo.InvariantCulture) + "s";

    // Whether the credit cell has anything to say. The grid needs the column held
    // open either way; the card layout below 1040px drops the line instead.
    private bool HasCreditCell(PodUploadStatusItem item) =>
        !string.IsNullOrWhiteSpace(item.CreditNoteNumber) || report?.CreditNoteDataComplete == false;

    private string SortMark(string key) => sortKey != key ? string.Empty : sortAscending ? "▲" : "▼";

    private void SortBy(string key)
    {
        if (string.Equals(sortKey, key, StringComparison.Ordinal))
        {
            sortAscending = !sortAscending;
        }
        else
        {
            sortKey = key;
            // Text reads best from A; a date or an amount reads best from the top.
            sortAscending = key is "docnum" or "uploader";
        }

        currentPage = 1;
    }

    private static DateTime ParseDocDate(string? dateStr) =>
        DateTime.TryParse(dateStr, CultureInfo.InvariantCulture, DateTimeStyles.None, out var parsed)
            ? parsed
            : DateTime.MinValue;

    private async Task LoadReport()
    {
        if (!fromDate.HasValue || !toDate.HasValue)
        {
            errorMessage = "Please select both From and To dates.";
            return;
        }

        if (fromDate.Value.Date > toDate.Value.Date)
        {
            errorMessage = "From Date cannot be later than To Date.";
            return;
        }

        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        if (authState.User.Identity?.IsAuthenticated != true)
        {
            errorMessage = "Your session has expired. Please sign in again and reload the report.";
            return;
        }

        CancelCreditNoteRefresh();
        isLoading = true;
        errorMessage = null;
        report = null;
        currentPage = 1;

        // Re-read on every run rather than once per circuit, so a reassignment
        // made on /route-assignments shows up on the next run of the report
        // rather than on the next sign-in.
        routeMap = await RouteDirectory.GetMapAsync();

        try
        {
            report = await PodService.GetPodUploadStatusAsync(
                fromDate.Value,
                toDate.Value,
                includeCreditNoteActivity: false);
            NormalizeDynamicFilters();
            currentPage = EffectiveCurrentPage;
            if (report == null)
                errorMessage = "Failed to load report. Please try again.";
            else
                runStamp = DateTime.Now;
        }
        catch (Exception ex)
        {
            errorMessage = $"Error loading report: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }

    }

    private Task RetryCreditNoteDataAsync() => RefreshCreditNoteDataAsync();

    private async Task RefreshCreditNoteDataAsync()
    {
        if (report is null ||
            report.CreditNoteDataComplete ||
            isRefreshingCreditNotes ||
            !fromDate.HasValue ||
            !toDate.HasValue)
        {
            return;
        }

        var refreshFromDate = fromDate.Value;
        var refreshToDate = toDate.Value;
        var refreshCts = new CancellationTokenSource();
        creditNoteRefreshCts = refreshCts;
        isRefreshingCreditNotes = true;
        await InvokeAsync(StateHasChanged);

        try
        {
            var refreshedReport = await PodService.GetPodUploadStatusAsync(
                refreshFromDate,
                refreshToDate,
                includeCreditNoteActivity: false,
                refreshCts.Token);

            if (!refreshCts.IsCancellationRequested &&
                refreshedReport is not null &&
                fromDate == refreshFromDate &&
                toDate == refreshToDate)
            {
                report = refreshedReport;
                runStamp = DateTime.Now;
                NormalizeDynamicFilters();
                currentPage = EffectiveCurrentPage;
            }
        }
        catch (OperationCanceledException) when (refreshCts.IsCancellationRequested)
        {
            // A new report load or component disposal superseded this refresh.
        }
        finally
        {
            if (ReferenceEquals(creditNoteRefreshCts, refreshCts))
            {
                creditNoteRefreshCts = null;
                isRefreshingCreditNotes = false;
            }

            refreshCts.Dispose();
            if (!isDisposed)
            {
                await InvokeAsync(StateHasChanged);
            }
        }
    }

    private void CancelCreditNoteRefresh()
    {
        var refreshCts = creditNoteRefreshCts;
        creditNoteRefreshCts = null;
        isRefreshingCreditNotes = false;
        refreshCts?.Cancel();
    }

    private void SetTab(string tab)
    {
        activeTab = tab;
        currentPage = 1;
    }

    private void GoToPage(int page)
    {
        if (page >= 1 && page <= TotalFilteredPages)
            currentPage = page;
    }

    private void GoToUpload(int docNum)
    {
        Navigation.NavigateTo($"/pods?docNum={docNum}");
    }

    private void SelectCustomRange() => selectedQuickRange = "custom";

    private void SelectQuickRange(string value)
    {
        selectedQuickRange = value;

        if (int.TryParse(value, out var days) && days > 0)
        {
            var today = DateTime.Today;
            fromDate = InclusiveRangeStart(today, days);
            toDate = today;
            currentPage = 1;
        }
    }

    private static DateTime InclusiveRangeStart(DateTime endDate, int days) =>
        endDate.Date.AddDays(-(days - 1));

    private void OnDateRangeChanged()
    {
        selectedQuickRange = "custom";
        currentPage = 1;
    }

    private void OnAdvancedFiltersChanged()
    {
        currentPage = 1;
    }

    private void ResetAdvancedFilters()
    {
        activeTab = "all";
        searchTerm = null;
        routeFilter = "all";
        currencyFilter = "all";
        uploadedByFilter = "all";
        uploaderRoleFilter = "all";
        generatedLocationFilter = "all";
        minAmount = null;
        maxAmount = null;
        currentPage = 1;
    }

    private void NormalizeDynamicFilters()
    {
        // "Not on a route" is offered whatever the range holds, so it survives a
        // reload the way the named routes do not.
        if (!string.Equals(routeFilter, "all", StringComparison.OrdinalIgnoreCase)
            && !string.Equals(routeFilter, UnroutedFilterValue, StringComparison.Ordinal)
            && !AvailableRoutes.Contains(routeFilter, StringComparer.OrdinalIgnoreCase))
        {
            routeFilter = "all";
        }

        if (!string.Equals(currencyFilter, "all", StringComparison.OrdinalIgnoreCase)
            && !AvailableCurrencies.Contains(currencyFilter, StringComparer.OrdinalIgnoreCase))
        {
            currencyFilter = "all";
        }

        if (!string.Equals(uploadedByFilter, "all", StringComparison.OrdinalIgnoreCase)
            && !AvailableUploaders.Contains(uploadedByFilter, StringComparer.OrdinalIgnoreCase))
        {
            uploadedByFilter = "all";
        }

        if (!string.Equals(uploaderRoleFilter, "all", StringComparison.OrdinalIgnoreCase)
            && !AvailableUploaderRoles.Contains(uploaderRoleFilter, StringComparer.OrdinalIgnoreCase))
        {
            uploaderRoleFilter = "all";
        }

        if (!string.Equals(generatedLocationFilter, "all", StringComparison.OrdinalIgnoreCase)
            && !AvailableGeneratedLocations.Contains(generatedLocationFilter, StringComparer.OrdinalIgnoreCase))
        {
            generatedLocationFilter = "all";
        }
    }

    private bool MatchesGeneratedLocationFilter(PodUploadStatusItem item) =>
        LocationMatchesFilter(item.CreatedLocation, generatedLocationFilter);

    // The section mapping lives in AssignedSectionOptions so this report and the
    // POD dashboard, which scopes an operator's figures to their own section,
    // resolve the same spellings to the same place.
    private static bool LocationMatchesFilter(string? location, string? filterValue) =>
        AssignedSectionOptions.AreSameSection(location, filterValue);

    private static string NormalizeLocationValue(string? location) =>
        AssignedSectionOptions.Normalize(location);

    private IEnumerable<PodUploadUserSummary> GetUploaderFilteredPodUploadedByUsers(PodUploadStatusItem item)
    {
        IEnumerable<PodUploadUserSummary> uploaders = GetPodUploadedByUsers(item);

        if (!string.Equals(uploadedByFilter, "all", StringComparison.OrdinalIgnoreCase))
        {
            uploaders = uploaders.Where(uploader =>
                string.Equals(uploader.Username.Trim(), uploadedByFilter, StringComparison.OrdinalIgnoreCase));
        }

        if (!string.Equals(uploaderRoleFilter, "all", StringComparison.OrdinalIgnoreCase))
        {
            uploaders = uploaders.Where(uploader =>
                string.Equals(uploader.Role?.Trim(), uploaderRoleFilter, StringComparison.OrdinalIgnoreCase));
        }

        return uploaders;
    }

    private IReadOnlyList<PodUploadUserSummary> GetDisplayPodUploadedByUsers(PodUploadStatusItem item)
    {
        if (!HasUploaderIdentityFilters)
            return GetPodUploadedByUsers(item);

        var filteredUploaders = GetUploaderFilteredPodUploadedByUsers(item).ToList();
        if (filteredUploaders.Count > 0)
            return filteredUploaders;

        return GetPodUploadedByUsers(item);
    }

    private DateTime? GetDisplayPodUploadedAt(PodUploadStatusItem item)
    {
        if (!HasUploaderIdentityFilters)
            return item.PodUploadedAt;

        var filteredUploaders = GetUploaderFilteredPodUploadedByUsers(item)
            .Select(uploader => uploader.LatestUploadedAt)
            .Where(uploadedAt => uploadedAt.HasValue)
            .ToList();

        if (filteredUploaders.Count > 0)
            return filteredUploaders.Max();

        return item.PodUploadedAt;
    }

    private static IReadOnlyList<PodUploadUserSummary> GetPodUploadedByUsers(PodUploadStatusItem item)
    {
        if (item.PodUploadedByUsers.Count > 0)
            return item.PodUploadedByUsers;

        if (!string.IsNullOrWhiteSpace(item.PodUploadedBy))
        {
            return
            [
                new PodUploadUserSummary
                {
                    Username = item.PodUploadedBy.Trim(),
                    FileCount = item.PodCount > 0 ? item.PodCount : 1,
                    LatestUploadedAt = item.PodUploadedAt
                }
            ];
        }

        return [];
    }

    private string FormatPodUploadedByDisplay(PodUploadStatusItem item)
    {
        var uploaders = GetDisplayPodUploadedByUsers(item)
            .Select(uploader => uploader.Username.Trim())
            .Where(username => !string.IsNullOrWhiteSpace(username))
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .ToList();

        if (uploaders.Count == 0)
            return string.IsNullOrWhiteSpace(item.PodUploadedBy) ? "Unknown uploader" : item.PodUploadedBy;

        return string.Join(", ", uploaders);
    }

    private string FormatPodUploadLocationDisplay(PodUploadStatusItem item)
    {
        var locations = GetDisplayPodUploadedByUsers(item)
            .Select(uploader => uploader.AssignedSection?.Trim())
            .Where(location => !string.IsNullOrWhiteSpace(location))
            .Select(location => location!)
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .ToList();

        return locations.Count == 0
            ? "-"
            : string.Join(", ", locations.Select(AssignedSectionOptions.GetLabel));
    }

    private string FormatDate(string? dateStr)
    {
        if (string.IsNullOrEmpty(dateStr)) return "-";
        if (DateTime.TryParse(dateStr, out var dt))
            return dt.ToString("dd MMM yyyy");
        return dateStr;
    }

    private async Task ExportToExcel()
    {
        if (report == null || BaseFilteredCount == 0) return;
        isExporting = true;
        StateHasChanged();
        try
        {
            var exportItems = BaseFilteredItems.ToList();
            var exportReport = new PodUploadStatusReport
            {
                FromDate = report.FromDate,
                ToDate = report.ToDate,
                TotalInvoices = exportItems.Count,
                UploadedCount = exportItems.Count(i => i.HasPod),
                PendingCount = exportItems.Count(i => !i.HasPod),
                CreditNoteDataComplete = report.CreditNoteDataComplete,
                Items = exportItems
            };

            var bytes = ExportService.ExportPodUploadStatusToExcel(
                exportReport, routeMap ?? await RouteDirectory.GetMapAsync());
            var base64 = Convert.ToBase64String(bytes);
            await JS.InvokeVoidAsync("downloadFile", $"POD_Upload_Report_{DateTime.UtcNow:yyyyMMdd_HHmm}.xlsx", base64);
        }
        catch (Exception ex)
        {
            errorMessage = $"Export failed: {ex.Message}";
        }
        finally
        {
            isExporting = false;
            StateHasChanged();
        }
    }

    public ValueTask DisposeAsync()
    {
        isDisposed = true;
        CancelCreditNoteRefresh();
        return ValueTask.CompletedTask;
    }
}
