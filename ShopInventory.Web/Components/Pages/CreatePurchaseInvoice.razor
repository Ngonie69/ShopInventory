@page "/purchase-invoices/create"
@attribute [Authorize(Roles = "Admin,Manager")]
@rendermode InteractiveServer

<PageTitle>Create A/P Invoice</PageTitle>

@* Nocturne. wwwroot/css/purchase-forms.css (linked from App.razor) carries the
   design and its light counterpart, and follows the app's theme toggle like
   every other page. See CreatePurchaseQuotation for the notes on the line grid
   and the inline icons, which this page repeats.

   This page previously carried its own 300-line <style> block plus several
   hundred inline `style=` attributes, which is why its dark mode was whatever
   app.css happened to say. Both are gone.

   The item cell keeps its own picker rather than a <datalist> like the
   quotation form's: this form completes the code as it is typed and takes
   Enter/Tab/Escape and the arrow keys, which a datalist cannot do. While a
   picker is open the line scroller drops its overflow clip, or the popup would
   be cut off at the bottom of the table. *@

<div class="pfm is-invoice">
    <div class="pfm-shell">

        <nav class="pfm-crumbs" aria-label="Breadcrumb">
            <a href="/purchase-invoices">A/P invoices</a>
            <span class="pfm-crumb-sep" aria-hidden="true">/</span>
            <span class="pfm-crumb-now">New</span>
        </nav>

        <header class="pfm-head">
            <div class="pfm-head-main">
                <div class="pfm-kicker">Purchasing</div>
                <h1>New A/P invoice</h1>
                <p>
                    Post a supplier invoice straight to SAP &#8212; what was billed, against which
                    items, and what the document comes to once discounts are applied.
                </p>
            </div>
            <div class="pfm-stats">
                <div class="pfm-stat">
                    <div class="pfm-stat-k">Lines</div>
                    <div class="pfm-stat-v">@purchaseInvoice.Lines.Count</div>
                </div>
                <div class="pfm-stat">
                    <div class="pfm-stat-k">Subtotal</div>
                    <div class="pfm-stat-v">@SubTotal.ToString("N2")</div>
                </div>
                <div class="pfm-stat">
                    <div class="pfm-stat-k">Estimated</div>
                    <div class="pfm-stat-v is-total">@EstimatedTotal.ToString("N2")</div>
                </div>
            </div>
        </header>

        @if (!string.IsNullOrWhiteSpace(errorMessage))
        {
            <div class="pfm-alert is-err" role="alert">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"
                     stroke-linecap="round" aria-hidden="true">
                    <circle cx="12" cy="12" r="9"></circle>
                    <path d="M12 7.5v5.5M12 16.2v.1"></path>
                </svg>
                <div class="pfm-alert-bd">@errorMessage</div>
                <button type="button" class="pfm-alert-x" aria-label="Dismiss" @onclick="() => errorMessage = null">
                    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"
                         stroke-linecap="round" aria-hidden="true">
                        <path d="M6 6l12 12M18 6L6 18"></path>
                    </svg>
                </button>
            </div>
        }

        @if (!string.IsNullOrWhiteSpace(successMessage))
        {
            <div class="pfm-alert is-ok" role="status">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"
                     stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M5 12.5l4.5 4.5L19 7"></path>
                </svg>
                <div class="pfm-alert-bd">@successMessage</div>
            </div>
        }

        @if (isLoadingLookups)
        {
            <section class="pfm-card" style="margin-top:22px">
                <div class="pfm-loading">
                    <span class="pfm-spin" aria-hidden="true"></span>
                    <span>Loading suppliers, products and warehouses&#8230;</span>
                </div>
            </section>
        }
        else
        {
            <div class="pfm-grid">
                <div class="pfm-main">

                    <section class="pfm-card">
                        <div class="pfm-card-hd">
                            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                 stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                <path d="M4 21V6l7-3v18"></path>
                                <path d="M11 9h6a2 2 0 0 1 2 2v10"></path>
                                <path d="M2 21h20M7 8v.01M7 12v.01M7 16v.01"></path>
                            </svg>
                            <h2>Supplier</h2>
                        </div>
                        <div class="pfm-card-bd">
                            @if (selectedSupplier is not null)
                            {
                                <div class="pfm-party">
                                    <div>
                                        <div class="pfm-party-code">
                                            <svg width="13" height="13" viewBox="0 0 24 24" fill="none"
                                                 stroke="currentColor" stroke-width="2.4" stroke-linecap="round"
                                                 stroke-linejoin="round" aria-hidden="true">
                                                <path d="M5 12.5l4.5 4.5L19 7"></path>
                                            </svg>
                                            @selectedSupplier.CardCode
                                        </div>
                                        <div class="pfm-party-name">@selectedSupplier.CardName</div>
                                        <div class="pfm-party-meta">
                                            @if (!string.IsNullOrWhiteSpace(selectedSupplier.Phone1))
                                            {
                                                <span>@selectedSupplier.Phone1</span>
                                            }
                                            @if (!string.IsNullOrWhiteSpace(selectedSupplier.Address))
                                            {
                                                <span>@TruncateName(selectedSupplier.Address, 60)</span>
                                            }
                                            @if (!string.IsNullOrWhiteSpace(selectedSupplier.Currency)
                                                && !string.Equals(selectedSupplier.Currency, "##", StringComparison.OrdinalIgnoreCase))
                                            {
                                                <span>@selectedSupplier.Currency</span>
                                            }
                                        </div>
                                    </div>
                                    <button type="button" class="pfm-btn-x" aria-label="Clear the supplier"
                                            @onclick="ClearSupplier">
                                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"
                                             stroke-linecap="round" aria-hidden="true">
                                            <path d="M6 6l12 12M18 6L6 18"></path>
                                        </svg>
                                    </button>
                                </div>
                            }
                            else
                            {
                                @* Not a <label>: it wraps a popup whose clicks a label would
                                   swallow by refocusing the input behind it. *@
                                <div class="pfm-lab">
                                    <span class="pfm-lab-t" id="apinv-c-supplier-label">
                                        Supplier <span class="pfm-req">*</span>
                                    </span>
                                    <span class="pfm-combo">
                                        <input class="pfm-input @(HasError("CardCode") ? "is-bad" : "")" type="text"
                                               aria-labelledby="apinv-c-supplier-label" autocomplete="off"
                                               placeholder="Search a supplier code or name, or type an exact code&#8230;"
                                               value="@supplierSearchTerm" @oninput="OnSupplierInput"
                                               @onfocus="ShowSupplierResults" @onblur="HandleSupplierBlur" />
                                        @if (showSupplierResults && FilteredSuppliers.Any())
                                        {
                                            <span class="pfm-drop is-wide" @onmousedown:preventDefault>
                                                @foreach (var supplier in FilteredSuppliers)
                                                {
                                                    <button type="button" class="pfm-drop-i"
                                                            @onmousedown="() => SelectSupplier(supplier)">
                                                        <span>
                                                            <span class="pfm-drop-code">@supplier.CardCode</span>
                                                            <span class="pfm-drop-sub">@supplier.CardName</span>
                                                        </span>
                                                        @if (!string.IsNullOrWhiteSpace(supplier.Currency)
                                                            && !string.Equals(supplier.Currency, "##", StringComparison.OrdinalIgnoreCase))
                                                        {
                                                            <span class="pfm-drop-price">@supplier.Currency</span>
                                                        }
                                                    </button>
                                                }
                                            </span>
                                        }
                                        else if (showSupplierResults && !string.IsNullOrWhiteSpace(supplierSearchTerm))
                                        {
                                            <span class="pfm-drop">
                                                <span class="pfm-drop-empty">No supplier in the cache matches that.</span>
                                            </span>
                                        }
                                    </span>
                                    @if (HasError("CardCode"))
                                    {
                                        <span class="pfm-field-err">@GetError("CardCode")</span>
                                    }
                                </div>
                            }
                        </div>
                    </section>

                    <section class="pfm-card">
                        <div class="pfm-card-hd">
                            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                 stroke-width="1.7" stroke-linecap="round" aria-hidden="true">
                                <circle cx="12" cy="12" r="9"></circle>
                                <path d="M12 11v5M12 7.8v.1"></path>
                            </svg>
                            <h2>Invoice details</h2>
                        </div>
                        <div class="pfm-card-bd">
                            <div class="pfm-fields">
                                <div class="pfm-lab">
                                    <span class="pfm-lab-t">Posting date</span>
                                    @* The posting date is not nullable on the request — an invoice has
                                       to be dated. Clearing it therefore puts the previous date back
                                       rather than leaving the model holding a date the box no longer
                                       shows. *@
                                    <NocturneDateField Id="apinv-c-doc-date" Date="purchaseInvoice.DocDate"
                                                       DateChanged="d => purchaseInvoice.DocDate = d ?? purchaseInvoice.DocDate"
                                                       AriaLabel="Posting date" />
                                </div>
                                <div class="pfm-lab">
                                    <span class="pfm-lab-t">Due date</span>
                                    <NocturneDateField Id="apinv-c-due-date" @bind-Date="purchaseInvoice.DocDueDate"
                                                       AriaLabel="Due date" />
                                </div>
                                <div class="pfm-lab">
                                    <span class="pfm-lab-t">Tax date</span>
                                    <NocturneDateField Id="apinv-c-tax-date" @bind-Date="purchaseInvoice.TaxDate"
                                                       AriaLabel="Tax date" />
                                </div>
                                <label class="pfm-lab">
                                    <span class="pfm-lab-t">Currency</span>
                                    <input class="pfm-input" type="text" placeholder="USD"
                                           @bind="purchaseInvoice.DocCurrency" />
                                </label>
                                <label class="pfm-lab">
                                    <span class="pfm-lab-t">Supplier reference</span>
                                    <input class="pfm-input" type="text" placeholder="The supplier's invoice number"
                                           @bind="purchaseInvoice.NumAtCard" />
                                </label>
                                <label class="pfm-lab">
                                    <span class="pfm-lab-t">Header discount %</span>
                                    <input class="pfm-input" type="number" min="0" max="100" step="0.01"
                                           @bind="purchaseInvoice.DiscountPercent" />
                                </label>
                                <label class="pfm-lab pfm-span3">
                                    <span class="pfm-lab-t">Comments</span>
                                    <textarea class="pfm-area" rows="2" placeholder="Optional comments for SAP"
                                              @bind="purchaseInvoice.Comments"></textarea>
                                </label>
                            </div>
                        </div>
                    </section>

                    <section class="pfm-card">
                        <div class="pfm-card-hd">
                            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                 stroke-width="1.7" stroke-linecap="round" aria-hidden="true">
                                <path d="M8 6h12M8 12h12M8 18h12M4 6v.01M4 12v.01M4 18v.01"></path>
                            </svg>
                            <h2>Invoice lines</h2>
                            <span class="pfm-count">@purchaseInvoice.Lines.Count</span>
                            <span class="pfm-spacer"></span>
                            <button type="button" class="pfm-btn pfm-btn-accent" @onclick="AddLine">
                                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                     stroke-width="2" stroke-linecap="round" aria-hidden="true">
                                    <path d="M12 5v14M5 12h14"></path>
                                </svg>
                                <span>Add line</span>
                            </button>
                        </div>

                        @if (HasError("Lines"))
                        {
                            <div class="pfm-card-bd" style="padding-bottom:0">
                                <div class="pfm-err-panel">
                                    <div class="pfm-err-panel-t">@GetError("Lines")</div>
                                </div>
                            </div>
                        }

                        @if (purchaseInvoice.Lines.Count == 0)
                        {
                            <div class="pfm-card-bd">
                                <button type="button" class="pfm-addline" @onclick="AddLine">
                                    <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                         stroke-width="2" stroke-linecap="round" aria-hidden="true">
                                        <path d="M12 5v14M5 12h14"></path>
                                    </svg>
                                    <span>Add the first line</span>
                                </button>
                            </div>
                        }
                        else
                        {
                            var picking = Enumerable.Range(0, purchaseInvoice.Lines.Count)
                                .Any(i => GetLineState(i).ShowProductDropdown);

                            <div class="pfm-lines @(picking ? "is-picking" : "")">
                                <div class="pfm-lines-inner">
                                    <div class="pfm-row is-head">
                                        <span>#</span>
                                        <span>Item</span>
                                        <span>Description</span>
                                        <span class="pfm-r">Qty</span>
                                        <span class="pfm-r">Unit price</span>
                                        <span>Warehouse</span>
                                        <span>Tax</span>
                                        <span class="pfm-r">Disc %</span>
                                        <span class="pfm-r">Total</span>
                                        <span></span>
                                    </div>

                                    @for (var i = 0; i < purchaseInvoice.Lines.Count; i++)
                                    {
                                        var index = i;
                                        var line = purchaseInvoice.Lines[index];
                                        var lineState = GetLineState(index);

                                        <div class="pfm-row">
                                            <span class="pfm-n">@(index + 1)</span>

                                            <span class="pfm-combo">
                                                <input class="pfm-input pfm-cell @(HasError($"Lines[{index}].ItemCode") ? "is-bad" : "")"
                                                       type="text" autocomplete="off" placeholder="Item code"
                                                       value="@line.ItemCode"
                                                       @oninput="e => OnItemCodeInput(index, e.Value?.ToString())"
                                                       @onkeydown="e => OnItemCodeKeyDown(index, e)"
                                                       @onfocus="() => OnItemCodeFocus(index)"
                                                       @onblur="() => OnItemCodeBlur(index)" />
                                                @if (lineState.ShowProductDropdown && lineState.FilteredProducts.Any())
                                                {
                                                    <span class="pfm-drop is-wide" @onmousedown:preventDefault>
                                                        @foreach (var product in lineState.FilteredProducts.Take(10))
                                                        {
                                                            <button type="button"
                                                                    class="pfm-drop-i @(lineState.SuggestedProduct?.ItemCode == product.ItemCode ? "is-sel" : "")"
                                                                    @onmousedown="() => SelectProduct(index, product)">
                                                                <span>
                                                                    <span class="pfm-drop-code">@product.ItemCode</span>
                                                                    <span class="pfm-drop-sub">@TruncateName(product.ItemName, 32)</span>
                                                                </span>
                                                                <span class="pfm-drop-price">@product.Price.ToString("N2")</span>
                                                            </button>
                                                        }
                                                        @if (lineState.FilteredProducts.Count > 10)
                                                        {
                                                            <span class="pfm-drop-empty">
                                                                @(lineState.FilteredProducts.Count - 10) more &#8212; keep typing to narrow it.
                                                            </span>
                                                        }
                                                    </span>
                                                }
                                            </span>

                                            @* Set from the item, not typed: the description SAP posts is
                                               the product's own. *@
                                            <input class="pfm-input pfm-desc" type="text" readonly
                                                   placeholder="Choose an item"
                                                   value="@TruncateName(line.ItemDescription ?? string.Empty, 45)" />

                                            <input class="pfm-input pfm-num @(HasError($"Lines[{index}].Quantity") ? "is-bad" : "")"
                                                   type="number" min="0.01" step="0.01" value="@line.Quantity"
                                                   @onchange="e => OnQuantityChange(index, e.Value?.ToString())" />

                                            <input class="pfm-input pfm-num @(HasError($"Lines[{index}].UnitPrice") ? "is-bad" : "")"
                                                   type="number" min="0.01" step="0.01" value="@line.UnitPrice"
                                                   @onchange="e => OnUnitPriceChange(index, e.Value?.ToString())" />

                                            <select class="pfm-select pfm-cell" @bind="line.WarehouseCode">
                                                <option value="">Warehouse</option>
                                                @foreach (var warehouse in warehouses)
                                                {
                                                    <option value="@warehouse.WarehouseCode">@warehouse.DisplayName</option>
                                                }
                                            </select>

                                            <input class="pfm-input pfm-cell" type="text" placeholder="A15"
                                                   @bind="line.TaxCode" />

                                            <input class="pfm-input pfm-num" type="number" min="0" max="100" step="0.01"
                                                   @bind="line.DiscountPercent" />

                                            <span class="pfm-amt-v pfm-r">@CalculateLineTotal(line).ToString("N2")</span>

                                            <button type="button" class="pfm-btn-x" aria-label="Remove this line"
                                                    @onclick="() => RemoveLine(index)">
                                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                                     stroke-width="2.2" stroke-linecap="round" aria-hidden="true">
                                                    <path d="M6 6l12 12M18 6L6 18"></path>
                                                </svg>
                                            </button>

                                            @if (HasError($"Lines[{index}].ItemCode") || HasError($"Lines[{index}].Quantity")
                                                || HasError($"Lines[{index}].UnitPrice"))
                                            {
                                                <span class="pfm-row-err">
                                                    @(HasError($"Lines[{index}].ItemCode")
                                                        ? GetError($"Lines[{index}].ItemCode")
                                                        : HasError($"Lines[{index}].Quantity")
                                                            ? GetError($"Lines[{index}].Quantity")
                                                            : GetError($"Lines[{index}].UnitPrice"))
                                                </span>
                                            }
                                        </div>
                                    }

                                    <button type="button" class="pfm-addline" @onclick="AddLine">
                                        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                             stroke-width="2" stroke-linecap="round" aria-hidden="true">
                                            <path d="M12 5v14M5 12h14"></path>
                                        </svg>
                                        <span>Add another line</span>
                                    </button>
                                </div>
                            </div>
                        }
                    </section>
                </div>

                <aside class="pfm-aside">
                    <section class="pfm-card pfm-total-card">
                        <div class="pfm-total-hd">
                            <span class="pfm-total-k">Estimated total</span>
                            <span class="pfm-total-cur">
                                @(string.IsNullOrWhiteSpace(purchaseInvoice.DocCurrency)
                                    ? "No currency" : purchaseInvoice.DocCurrency)
                            </span>
                        </div>
                        <div class="pfm-total-v">@EstimatedTotal.ToString("N2")</div>

                        <div class="pfm-gap-md">
                            <div class="pfm-sum">
                                <span>Subtotal</span>
                                <span class="pfm-sum-v">@SubTotal.ToString("N2")</span>
                            </div>
                            <div class="pfm-sum">
                                <span>Header discount</span>
                                <span class="pfm-sum-v">@HeaderDiscountAmount.ToString("N2")</span>
                            </div>
                            <div class="pfm-sum-rule" aria-hidden="true"></div>
                            <div class="pfm-sum">
                                <span>Lines</span>
                                <span class="pfm-sum-v">@purchaseInvoice.Lines.Count</span>
                            </div>
                        </div>

                        <div class="pfm-gap-md">
                            <button type="button" class="pfm-btn-solid" @onclick="SubmitAsync" disabled="@isSubmitting">
                                @if (isSubmitting)
                                {
                                    <span class="pfm-spin on-solid" aria-hidden="true"></span>
                                    <span>Posting&#8230;</span>
                                }
                                else
                                {
                                    <span>Post A/P invoice</span>
                                }
                            </button>
                            <a class="pfm-btn pfm-btn-wide" style="margin-top:8px" href="/purchase-invoices">Cancel</a>
                        </div>
                    </section>

                    <section class="pfm-card pfm-panel">
                        <div class="pfm-panel-hd">
                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                 stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                <path d="M5 12.5l4.5 4.5L19 7"></path>
                            </svg>
                            <span>Before posting</span>
                        </div>
                        <div class="pfm-checks">
                            <div class="pfm-checks-i @(selectedSupplier is null ? "is-no" : "")">
                                <span class="pfm-checks-ic">
                                    <svg width="9" height="9" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                         stroke-width="3" stroke-linecap="round" stroke-linejoin="round"
                                         aria-hidden="true">
                                        <path d="M5 12.5l4.5 4.5L19 7"></path>
                                    </svg>
                                </span>
                                <span>A supplier is chosen</span>
                            </div>
                            <div class="pfm-checks-i @(purchaseInvoice.Lines.Any(l => !string.IsNullOrWhiteSpace(l.ItemCode)) ? "" : "is-no")">
                                <span class="pfm-checks-ic">
                                    <svg width="9" height="9" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                         stroke-width="3" stroke-linecap="round" stroke-linejoin="round"
                                         aria-hidden="true">
                                        <path d="M5 12.5l4.5 4.5L19 7"></path>
                                    </svg>
                                </span>
                                <span>At least one line has an item</span>
                            </div>
                            <div class="pfm-checks-i @(string.IsNullOrWhiteSpace(purchaseInvoice.DocCurrency) ? "is-no" : "")">
                                <span class="pfm-checks-ic">
                                    <svg width="9" height="9" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                         stroke-width="3" stroke-linecap="round" stroke-linejoin="round"
                                         aria-hidden="true">
                                        <path d="M5 12.5l4.5 4.5L19 7"></path>
                                    </svg>
                                </span>
                                <span>A currency is set</span>
                            </div>
                        </div>
                    </section>
                </aside>
            </div>
        }
    </div>
</div>
