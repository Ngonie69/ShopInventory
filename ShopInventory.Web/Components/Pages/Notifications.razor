@page "/notifications"
@using Microsoft.AspNetCore.Authorization
@using ShopInventory.Web.Data
@using ShopInventory.Web.Services
@using ShopInventory.Web.Models
@attribute [Authorize(Roles = UserRoles.SystemRoles)]
@inject INotificationClientService NotificationService
@inject NavigationManager Navigation
@inject IAppSettingsProvider AppSettings
@rendermode InteractiveServer

<PageTitle>Notifications - Shop Inventory</PageTitle>

@* The Nocturne sheet is wwwroot/css/notifications.css (linked from App.razor),
   derived from audit-trail.css — the same page shape, and the same
   family-token badge for saying what kind of event a row is. It lives in a
   file rather than in the <style> block this page used to carry because
   app.css's global `.dark-theme select` rules have to be out-specified, which
   a scoped block cannot do.

   The type and the category are the two things that distinguish one row from
   another, so each takes a family hue: the type tints the row's mark, the
   category tints the badge beside the title. *@

<div class="ntf">

    <header class="ntf-head">
        <div class="ntf-head-inner">
            <nav class="ntf-crumbs" aria-label="Breadcrumb">
                <span>Administration</span>
                <span class="ntf-crumb-sep" aria-hidden="true">/</span>
                <span class="ntf-crumb-now" aria-current="page">Notifications</span>
            </nav>
            <div class="ntf-head-actions">
                @if (unreadCount > 0)
                {
                    <button type="button" class="ntf-btn ntf-btn-primary"
                            disabled="@isProcessing" @onclick="MarkAllAsRead">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                             stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <path d="M2 12l5 5L14 8"></path>
                            <path d="M11 15l3 2 7-9"></path>
                        </svg>
                        <span>Mark all read</span>
                    </button>
                }
                <button type="button" class="ntf-btn ntf-btn-ghost"
                        disabled="@isLoading" @onclick="RefreshNotifications">
                    @if (isLoading)
                    {
                        <span class="ntf-spin" aria-hidden="true"></span>
                        <span>Refreshing&#8230;</span>
                    }
                    else
                    {
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                             stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <path d="M20 11a8 8 0 0 0-13.7-5.3L4 8"></path>
                            <path d="M4 4v4h4"></path>
                            <path d="M4 13a8 8 0 0 0 13.7 5.3L20 16"></path>
                            <path d="M20 20v-4h-4"></path>
                        </svg>
                        <span>Refresh</span>
                    }
                </button>
            </div>
        </div>
    </header>

    <div class="ntf-body">

        <section class="ntf-hero">
            <div>
                <div class="ntf-kicker">System alerts</div>
                <h1>Notifications</h1>
                <p>
                    What the system noticed while you were elsewhere — stock that ran low, a payment that
                    landed, a sync that failed. Opening one marks it read and takes you to what it is about;
                    Details reads it out in full without leaving the page.
                </p>
            </div>
        </section>

        <section class="ntf-stats">
            <div class="ntf-stat @(unreadCount > 0 ? "ntf-stat-lead" : "")">
                <div class="ntf-stat-head"><span class="ntf-stat-rule"></span>Unread</div>
                <div class="ntf-stat-num">@unreadCount</div>
                <div class="ntf-stat-sub">waiting on you</div>
            </div>
            <div class="ntf-stat">
                <div class="ntf-stat-head"><span class="ntf-stat-rule"></span>Total</div>
                <div class="ntf-stat-num">@totalCount</div>
                <div class="ntf-stat-sub">in this view</div>
            </div>
            <div class="ntf-stat @(alertCount > 0 ? "ntf-stat-alert" : "")">
                <div class="ntf-stat-head"><span class="ntf-stat-rule"></span>Alerts</div>
                <div class="ntf-stat-num">@alertCount</div>
                <div class="ntf-stat-sub">warnings and errors on this page</div>
            </div>
            <div class="ntf-stat">
                <div class="ntf-stat-head"><span class="ntf-stat-rule"></span>Read</div>
                <div class="ntf-stat-num">@(totalCount - unreadCount)</div>
                <div class="ntf-stat-sub">dealt with</div>
            </div>
        </section>

        @if (errorMessage != null)
        {
            <div class="ntf-notice" role="alert">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                     stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <circle cx="12" cy="12" r="9"></circle>
                    <path d="M12 7v6"></path>
                    <path d="M12 16.5v.01"></path>
                </svg>
                <span>@errorMessage</span>
            </div>
        }

        <section class="ntf-panel">
            <div class="ntf-panel-head">
                <h2>Inbox</h2>
                <span class="ntf-count">@totalCount @(totalCount == 1 ? "notification" : "notifications")</span>
                <div class="ntf-panel-tools">
                    <div class="ntf-seg" role="group" aria-label="Read state">
                        <button type="button" class="ntf-seg-btn @(showUnreadOnly ? "" : "ntf-seg-on")"
                                aria-pressed="@(!showUnreadOnly)" @onclick="() => SetFilter(false)">
                            All
                            @if (totalCount > 0)
                            {
                                <span class="ntf-seg-count">@totalCount</span>
                            }
                        </button>
                        <button type="button" class="ntf-seg-btn @(showUnreadOnly ? "ntf-seg-on" : "")"
                                aria-pressed="@showUnreadOnly" @onclick="() => SetFilter(true)">
                            Unread
                            @if (unreadCount > 0)
                            {
                                <span class="ntf-seg-count">@unreadCount</span>
                            }
                        </button>
                    </div>
                    <NocturneSelect Id="ntfCategory" TValue="string" Options="CategoryFilterOptions"
                                    @bind-Value="selectedCategory" OnChanged="OnCategoryChanged"
                                    Caption="Filter by category" AriaLabel="Filter by category"
                                    Placeholder="All categories" />
                </div>
            </div>

            @if (isLoading && !notifications.Any())
            {
                <div class="ntf-loading">
                    <span class="ntf-spin" aria-hidden="true"></span>
                    <span>Loading notifications&#8230;</span>
                </div>
            }
            else if (!notifications.Any())
            {
                <div class="ntf-empty">
                    <svg width="30" height="30" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                         stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"></path>
                        <path d="M13.7 21a2 2 0 0 1-3.4 0"></path>
                    </svg>
                    <h3>@(showUnreadOnly ? "Nothing unread" : "You're all caught up")</h3>
                    <p>
                        @(showUnreadOnly
                            ? "Everything in this view has been read. Switch to All to see it again."
                            : "No notifications match this view. New alerts will appear here as they are raised.")
                    </p>
                </div>
            }
            else
            {
                <div class="ntf-list">
                    @foreach (var notification in notifications)
                    {
                        var n = notification;
                        var isOpen = expandedIds.Contains(n.Id);
                        var detailId = $"ntf-detail-{n.Id}";
                        <div class="ntf-item @TypeFamily(n.Type) @(n.IsRead ? "" : "ntf-item-unread")"
                             role="button" tabindex="0" @onclick="() => HandleNotificationClick(n)"
                             @onkeydown="args => HandleNotificationKey(args, n)">
                            <span class="ntf-mark" aria-hidden="true"></span>
                            <div class="ntf-content">
                                <div class="ntf-title-row">
                                    <p class="ntf-title">@n.Title</p>
                                    <span class="ntf-badge @CategoryFamily(n.Category)">@n.Category</span>
                                </div>
                                <p class="ntf-msg @(isOpen ? "ntf-msg-open" : "")"
                                   @onclick:stopPropagation="isOpen">@n.Message</p>
                                @if (!string.IsNullOrEmpty(n.EntityType) && !string.IsNullOrEmpty(n.EntityId))
                                {
                                    <span class="ntf-entity">@n.EntityType @n.EntityId</span>
                                }
                                <button type="button" class="ntf-more" aria-expanded="@isOpen" aria-controls="@detailId"
                                        @onclick="() => ToggleDetails(n)" @onclick:stopPropagation="true">
                                    <svg class="ntf-more-caret" width="12" height="12" viewBox="0 0 24 24" fill="none"
                                         stroke="currentColor" stroke-width="1.9" stroke-linecap="round"
                                         stroke-linejoin="round" aria-hidden="true">
                                        <path d="M6 9l6 6 6-6"></path>
                                    </svg>
                                    <span>@(isOpen ? "Hide details" : "Details")</span>
                                </button>
                                @if (isOpen)
                                {
                                    <div class="ntf-detail" id="@detailId" @onclick:stopPropagation="true">
                                        <dl class="ntf-facts">
                                            @foreach (var fact in n.DetailFacts())
                                            {
                                                <div class="ntf-fact">
                                                    <dt>@fact.Label</dt>
                                                    <dd>@fact.Value</dd>
                                                </div>
                                            }
                                        </dl>
                                        @if (!string.IsNullOrEmpty(n.EffectiveActionUrl))
                                        {
                                            <button type="button" class="ntf-open" @onclick="() => OpenNotification(n)">
                                                <span>Open</span>
                                                <span class="ntf-open-path">@n.EffectiveActionUrl</span>
                                            </button>
                                        }
                                    </div>
                                }
                            </div>
                            <div class="ntf-meta">
                                <span class="ntf-time" title="@NotificationModel.FormatTimestamp(n.CreatedAt)">@n.TimeAgo</span>
                                <button type="button" class="ntf-icon-btn" title="Delete" aria-label="Delete notification"
                                        @onclick="() => DeleteNotification(n.Id)" @onclick:stopPropagation="true">
                                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                         stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                        <path d="M4 7h16"></path>
                                        <path d="M9 7V5h6v2"></path>
                                        <path d="M6 7l1 13h10l1-13"></path>
                                    </svg>
                                </button>
                            </div>
                        </div>
                    }
                </div>

                @if (totalPages > 1)
                {
                    <div class="ntf-foot">
                        <span class="ntf-foot-info">
                            @(((currentPage - 1) * pageSize) + 1)&#8211;@(Math.Min(currentPage * pageSize, totalCount)) of @totalCount
                        </span>
                        <div class="ntf-pages">
                            <button type="button" class="ntf-step" disabled="@(currentPage == 1)"
                                    @onclick="() => GoToPage(currentPage - 1)">Previous</button>
                            @foreach (var pg in GetPageNumbers())
                            {
                                var p = pg;
                                <button type="button" class="ntf-page @(currentPage == p ? "ntf-page-on" : "")"
                                        @onclick="() => GoToPage(p)">@p</button>
                            }
                            <button type="button" class="ntf-step" disabled="@(currentPage == totalPages)"
                                    @onclick="() => GoToPage(currentPage + 1)">Next</button>
                        </div>
                    </div>
                }
            }
        </section>
    </div>
</div>

@code {
    private static readonly NocturneSelectOption<string>[] CategoryFilterOptions =
    [
        new(string.Empty, "All categories", "neutral") { IsUnset = true, RuleAfter = true },
        new("System", "System", "neutral"),
        new("LowStock", "Low stock", "warn"),
        new("Payment", "Payment", "good"),
        new("Invoice", "Invoice", "info")
    ];

    private List<NotificationModel> notifications = new();
    private bool isLoading = true;
    private bool isProcessing = false;
    private string? errorMessage;
    private bool showUnreadOnly = false;
    private string selectedCategory = "";
    private int currentPage = 1;
    private int pageSize = 20;
    private int totalCount = 0;
    private int unreadCount = 0;

    // Rows whose detail is open. Ids rather than models so it survives the list
    // being replaced by a reload, and cleared on load because a row that scrolls
    // in on the next page has nothing to do with the one that was open on this.
    private readonly HashSet<int> expandedIds = new();
    private int totalPages => totalCount == 0 ? 1 : (int)Math.Ceiling((double)totalCount / pageSize);

    protected override async Task OnInitializedAsync()
    {
        pageSize = AppSettings.PageSize;
        await LoadNotifications();
    }

    private async Task LoadNotifications()
    {
        isLoading = true;
        errorMessage = null;
        expandedIds.Clear();
        StateHasChanged();

        try
        {
            var category = string.IsNullOrEmpty(selectedCategory) ? null : selectedCategory;
            var response = await NotificationService.GetNotificationsAsync(currentPage, pageSize, showUnreadOnly, category);
            if (response != null)
            {
                notifications = response.Notifications;
                totalCount = response.TotalCount;
                unreadCount = response.UnreadCount;
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Failed to load notifications: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task RefreshNotifications()
    {
        currentPage = 1;
        await LoadNotifications();
    }

    private async Task SetFilter(bool unreadOnly)
    {
        showUnreadOnly = unreadOnly;
        currentPage = 1;
        await LoadNotifications();
    }

    private async Task OnCategoryChanged()
    {
        currentPage = 1;
        await LoadNotifications();
    }

    private async Task GoToPage(int page)
    {
        if (page >= 1 && page <= totalPages)
        {
            currentPage = page;
            await LoadNotifications();
        }
    }

    private async Task HandleNotificationClick(NotificationModel notification)
    {
        await MarkRead(notification);

        if (!string.IsNullOrEmpty(notification.EffectiveActionUrl))
        {
            Navigation.NavigateTo(notification.EffectiveActionUrl);
            return;
        }

        // Nothing to open, so the click shows what the row says instead of doing
        // nothing at all — which is what it did before.
        ToggleExpanded(notification.Id);
    }

    // The row carries role="button" but had no key handler, so it could be focused
    // and not activated. Enter only, not Space: Blazor's :preventDefault is fixed
    // per render and would have to swallow Tab with it, so Space would scroll the
    // page as well as open the row. The Details button inside the row is a real
    // button and takes both keys natively.
    private async Task HandleNotificationKey(KeyboardEventArgs args, NotificationModel notification)
    {
        if (args.Key == "Enter")
        {
            await HandleNotificationClick(notification);
        }
    }

    /// <summary>
    /// Opens or closes a row's detail. Separate from the row click on purpose: a
    /// notification that carries an ActionUrl navigates away on click, so the
    /// message the row clamped to two lines could never be read in full — the
    /// evening credit limit sweep names several accounts in one message and links
    /// to /sales-orders, and both halves of that were unreachable at once.
    /// </summary>
    private async Task ToggleDetails(NotificationModel notification)
    {
        var opened = ToggleExpanded(notification.Id);

        // Reading it is reading it, whichever way the row was opened.
        if (opened)
        {
            await MarkRead(notification);
        }
    }

    private bool ToggleExpanded(int id)
    {
        if (expandedIds.Remove(id))
        {
            return false;
        }

        expandedIds.Add(id);
        return true;
    }

    private void OpenNotification(NotificationModel notification)
    {
        if (!string.IsNullOrEmpty(notification.EffectiveActionUrl))
        {
            Navigation.NavigateTo(notification.EffectiveActionUrl);
        }
    }

    private async Task MarkRead(NotificationModel notification)
    {
        if (notification.IsRead)
        {
            return;
        }

        await NotificationService.MarkAsReadAsync(new List<int> { notification.Id });
        notification.IsRead = true;
        unreadCount = Math.Max(0, unreadCount - 1);
    }

    private async Task MarkAllAsRead()
    {
        isProcessing = true;
        try
        {
            await NotificationService.MarkAsReadAsync(null);
            foreach (var n in notifications)
            {
                n.IsRead = true;
            }
            unreadCount = 0;
        }
        finally
        {
            isProcessing = false;
        }
    }

    private async Task DeleteNotification(int id)
    {
        try
        {
            var success = await NotificationService.DeleteNotificationAsync(id);
            if (success)
            {
                var notification = notifications.FirstOrDefault(n => n.Id == id);
                if (notification != null)
                {
                    if (!notification.IsRead)
                    {
                        unreadCount = Math.Max(0, unreadCount - 1);
                    }
                    notifications.Remove(notification);
                    expandedIds.Remove(id);
                    totalCount--;
                }
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Failed to delete notification: {ex.Message}";
        }
    }

    // Warnings and errors on the page in hand, not across the whole result set:
    // the API returns a count of everything and a count of what is unread, and
    // nothing that would let this be totalled server-side. The figure's label
    // says which it is rather than implying a total it cannot know.
    private int alertCount => notifications.Count(n => n.Type == "Warning" || n.Type == "Error");

    // The type tints the row's mark and the category tints the badge. Both come
    // from the same six-family set in nocturne-tokens.css, so a hue is stated
    // once and its ink is mixed from the same value as its wash.
    private static string TypeFamily(string type) => type switch
    {
        "Error" => "ntf-fam-bad",
        "Warning" => "ntf-fam-warn",
        "Success" => "ntf-fam-good",
        "Info" => "ntf-fam-info",
        _ => "ntf-fam-neutral"
    };

    private static string CategoryFamily(string category) => category switch
    {
        "LowStock" => "ntf-fam-warn",
        "Payment" => "ntf-fam-good",
        "Invoice" => "ntf-fam-info",
        "System" => "ntf-fam-neutral",
        _ => "ntf-fam-accent"
    };

    private List<int> GetPageNumbers()
    {
        var pages = new List<int>();
        var start = Math.Max(1, currentPage - 2);
        var end = Math.Min(totalPages, currentPage + 2);
        for (var i = start; i <= end; i++)
            pages.Add(i);
        return pages;
    }
}
