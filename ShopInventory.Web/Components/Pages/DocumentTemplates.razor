@page "/document-templates"
@using Microsoft.AspNetCore.Authorization
@using ShopInventory.Web.Data
@using ShopInventory.Web.Models
@using ShopInventory.Web.Services
@attribute [Authorize(Roles = UserRoles.SystemRoles)]
@inject HttpClient Http
@inject IJSRuntime JS
@inject IAppSettingsProvider AppSettings
@rendermode InteractiveServer

<PageTitle>Document Templates - Shop Inventory</PageTitle>

@* The Nocturne sheet is wwwroot/css/document-templates.css (linked from
   App.razor), derived from audit-trail.css — the same header, hero, four
   figures, filtered panel, pagination foot and right-hand drawer. It lives in
   a file rather than in the <style> block this page used to carry because
   app.css's global `.dark-theme input/select/textarea` rules have to be
   out-specified, which a scoped block cannot do.

   The modal and both drawers carry `.dtp` themselves. They sit outside the
   page element, and that class is what puts the page's tokens in reach — every
   rule in the sheet reads two classes deep, so none of them would apply
   otherwise, and the old block's hard-coded #fff is why they stayed white in
   dark mode. *@

<div class="dtp">

    <header class="dtp-head">
        <div class="dtp-head-inner">
            <nav class="dtp-crumbs" aria-label="Breadcrumb">
                <span>Administration</span>
                <span class="dtp-crumb-sep" aria-hidden="true">/</span>
                <span class="dtp-crumb-now" aria-current="page">Document templates</span>
            </nav>
            <div class="dtp-head-actions">
                <button type="button" class="dtp-btn dtp-btn-primary" @onclick="OpenCreateModal">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                         stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <path d="M12 5v14"></path>
                        <path d="M5 12h14"></path>
                    </svg>
                    <span>New template</span>
                </button>
            </div>
        </div>
    </header>

    <div class="dtp-body">

        <section class="dtp-hero">
            <div>
                <div class="dtp-kicker">Print and PDF</div>
                <h1>Document templates</h1>
                <p>
                    The markup every printed document is rendered from. One template per document type is
                    the default; the rest are kept for editing and can be switched in at any time.
                </p>
            </div>
        </section>

        @if (!isLoading && templates != null)
        {
            <section class="dtp-stats">
                <div class="dtp-stat dtp-stat-lead">
                    <div class="dtp-stat-head"><span class="dtp-stat-rule"></span>Templates</div>
                    <div class="dtp-stat-num">@totalCount</div>
                    <div class="dtp-stat-sub">across all document types</div>
                </div>
                <div class="dtp-stat">
                    <div class="dtp-stat-head"><span class="dtp-stat-rule"></span>Active</div>
                    <div class="dtp-stat-num">@templates.Count(t => t.IsActive)</div>
                    <div class="dtp-stat-sub">on this page</div>
                </div>
                <div class="dtp-stat">
                    <div class="dtp-stat-head"><span class="dtp-stat-rule"></span>Defaults set</div>
                    <div class="dtp-stat-num">@templates.Count(t => t.IsDefault)</div>
                    <div class="dtp-stat-sub">one per type is used</div>
                </div>
                <div class="dtp-stat">
                    <div class="dtp-stat-head"><span class="dtp-stat-rule"></span>Doc types</div>
                    <div class="dtp-stat-num">@templates.Select(t => t.DocumentType).Distinct().Count()</div>
                    <div class="dtp-stat-sub">represented on this page</div>
                </div>
            </section>
        }

        @if (successMessage != null)
        {
            <div class="dtp-notice dtp-notice-good" role="status">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                     stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M20 6L9 17l-5-5"></path>
                </svg>
                <span class="dtp-notice-text">@successMessage</span>
                <button type="button" class="dtp-notice-x" aria-label="Dismiss" @onclick="() => successMessage = null">
                    <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                         stroke-width="2" stroke-linecap="round" aria-hidden="true">
                        <path d="M5 5l14 14M19 5L5 19"></path>
                    </svg>
                </button>
            </div>
        }
        @if (errorMessage != null)
        {
            <div class="dtp-notice dtp-notice-bad" role="alert">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                     stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <circle cx="12" cy="12" r="9"></circle>
                    <path d="M12 7v6"></path>
                    <path d="M12 16.5v.01"></path>
                </svg>
                <span class="dtp-notice-text">@errorMessage</span>
                <button type="button" class="dtp-notice-x" aria-label="Dismiss" @onclick="() => errorMessage = null">
                    <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                         stroke-width="2" stroke-linecap="round" aria-hidden="true">
                        <path d="M5 5l14 14M19 5L5 19"></path>
                    </svg>
                </button>
            </div>
        }

        <section class="dtp-panel">
            <div class="dtp-panel-head">
                <h2>Templates</h2>
                <span class="dtp-count">
                    @totalCount @(totalCount == 1 ? "template" : "templates")@(selectedDocumentType == null ? "" : $" · {FormatDocType(selectedDocumentType)}")
                </span>
            </div>

            <div class="dtp-chips" role="group" aria-label="Document type">
                <button type="button" class="dtp-chip @(selectedDocumentType == null ? "dtp-chip-on" : "")"
                        @onclick="() => FilterByType(null)">All</button>
                @foreach (var t in documentTypes)
                {
                    var type = t;
                    <button type="button" class="dtp-chip @(selectedDocumentType == type ? "dtp-chip-on" : "")"
                            @onclick="() => FilterByType(type)">@FormatDocType(type)</button>
                }
            </div>

            @if (isLoading)
            {
                <div class="dtp-loading">
                    <span class="dtp-spin" aria-hidden="true"></span>
                    <span>Loading templates&#8230;</span>
                </div>
            }
            else if (templates?.Any() == true)
            {
                <div class="dtp-grid">
                    @foreach (var template in templates)
                    {
                        var tpl = template;
                        <article class="dtp-card @(tpl.IsDefault ? "dtp-card-default" : "") @(tpl.IsActive ? "" : "dtp-card-off")">
                            <div class="dtp-card-head">
                                <h3 class="dtp-card-title">@tpl.Name</h3>
                                <div class="dtp-card-marks">
                                    @if (tpl.IsDefault)
                                    {
                                        <span class="dtp-mark dtp-mark-default">Default</span>
                                    }
                                    @if (!tpl.IsActive)
                                    {
                                        <span class="dtp-mark dtp-mark-off">Inactive</span>
                                    }
                                </div>
                            </div>
                            <div class="dtp-card-body">
                                <div class="dtp-card-meta">
                                    <span class="dtp-badge @DocTypeFamily(tpl.DocumentType)">@FormatDocType(tpl.DocumentType)</span>
                                    <span class="dtp-paper">@tpl.PaperSize &middot; @tpl.Orientation</span>
                                </div>
                                <div class="dtp-dates">
                                    <span>Created @tpl.CreatedAt.ToLocalTime().ToString("d MMM yyyy")</span>
                                    @if (tpl.UpdatedAt.HasValue)
                                    {
                                        <span>Updated @tpl.UpdatedAt.Value.ToLocalTime().ToString("d MMM yyyy")</span>
                                    }
                                </div>
                            </div>
                            <div class="dtp-card-foot">
                                <button type="button" class="dtp-icon-btn" title="Preview" aria-label="Preview template"
                                        @onclick="() => PreviewTemplate(tpl)">
                                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                         stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                        <path d="M2 12s3.6-6.5 10-6.5S22 12 22 12s-3.6 6.5-10 6.5S2 12 2 12z"></path>
                                        <circle cx="12" cy="12" r="2.6"></circle>
                                    </svg>
                                </button>
                                <button type="button" class="dtp-icon-btn" title="Edit" aria-label="Edit template"
                                        @onclick="() => EditTemplate(tpl)">
                                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                         stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                        <path d="M4 20h4l10-10a2.1 2.1 0 0 0-3-3L5 17v3z"></path>
                                    </svg>
                                </button>
                                @if (!tpl.IsDefault)
                                {
                                    <button type="button" class="dtp-icon-btn" title="Set as default"
                                            aria-label="Set as default template" @onclick="() => SetAsDefault(tpl.Id)">
                                        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                             stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                            <path d="M12 4l2.4 5 5.6.8-4 3.9 1 5.5-5-2.6-5 2.6 1-5.5-4-3.9 5.6-.8z"></path>
                                        </svg>
                                    </button>
                                }
                                <span class="dtp-card-foot-gap"></span>
                                <button type="button" class="dtp-icon-btn dtp-icon-btn-danger" title="Delete"
                                        aria-label="Delete template" @onclick="() => DeleteTemplate(tpl.Id)">
                                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                         stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                        <path d="M4 7h16"></path>
                                        <path d="M9 7V5h6v2"></path>
                                        <path d="M6 7l1 13h10l1-13"></path>
                                    </svg>
                                </button>
                            </div>
                        </article>
                    }
                </div>

                @if (totalPages > 1)
                {
                    <div class="dtp-foot">
                        <span class="dtp-foot-info">
                            @(((currentPage - 1) * pageSize) + 1)&#8211;@(Math.Min(currentPage * pageSize, totalCount)) of @totalCount
                        </span>
                        <div class="dtp-pages">
                            <button type="button" class="dtp-step" disabled="@(currentPage == 1)"
                                    @onclick="() => OnPageChanged(currentPage - 1)">Previous</button>
                            @foreach (var pg in GetPageNumbers())
                            {
                                var p = pg;
                                <button type="button" class="dtp-page @(currentPage == p ? "dtp-page-on" : "")"
                                        @onclick="() => OnPageChanged(p)">@p</button>
                            }
                            <button type="button" class="dtp-step" disabled="@(currentPage == totalPages)"
                                    @onclick="() => OnPageChanged(currentPage + 1)">Next</button>
                        </div>
                    </div>
                }
            }
            else
            {
                <div class="dtp-empty">
                    <svg width="30" height="30" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                         stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <path d="M14 3H7a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8z"></path>
                        <path d="M14 3v5h5"></path>
                        <path d="M12 11v6"></path>
                        <path d="M9 14h6"></path>
                    </svg>
                    <h3>No templates here</h3>
                    <p>
                        @(selectedDocumentType == null
                            ? "Nothing has been created yet. A document type with no template falls back to the built-in layout."
                            : $"No {FormatDocType(selectedDocumentType)} template exists yet.")
                    </p>
                    <div class="dtp-empty-actions">
                        @if (selectedDocumentType != null)
                        {
                            <button type="button" class="dtp-btn dtp-btn-quiet" @onclick="() => FilterByType(null)">Show all types</button>
                        }
                        <button type="button" class="dtp-btn dtp-btn-primary" @onclick="OpenCreateModal">Create a template</button>
                    </div>
                </div>
            }
        </section>
    </div>
</div>

@* ── The editor ────────────────────────────────────────────────────────── *@
@if (showTemplateModal)
{
    <div class="dtp dtp-scrim" @onclick="CloseTemplateModal">
        <div class="dtp-modal" role="dialog" aria-modal="true" aria-label="@(editingTemplate == null ? "Create template" : "Edit template")"
             @onclick:stopPropagation="true">
            <div class="dtp-modal-head">
                <h2>@(editingTemplate == null ? "Create template" : "Edit template")</h2>
                <button type="button" class="dtp-icon-btn dtp-modal-x" aria-label="Close" @onclick="CloseTemplateModal">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                         stroke-width="1.8" stroke-linecap="round" aria-hidden="true">
                        <path d="M5 5l14 14M19 5L5 19"></path>
                    </svg>
                </button>
            </div>

            <div class="dtp-modal-body">
                @if (savingError != null)
                {
                    <div class="dtp-notice dtp-notice-bad" role="alert">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                             stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <circle cx="12" cy="12" r="9"></circle>
                            <path d="M12 7v6"></path>
                            <path d="M12 16.5v.01"></path>
                        </svg>
                        <span class="dtp-notice-text">@savingError</span>
                    </div>
                }

                <div class="dtp-form-row">
                    <div class="dtp-field">
                        <label class="dtp-label" for="tplName">Template name</label>
                        <input id="tplName" type="text" class="dtp-input" @bind="templateName"
                               placeholder="Default invoice template" />
                    </div>
                    <div class="dtp-field">
                        <label class="dtp-label" for="tplType">Document type</label>
                        <div class="dtp-select">
                            <select id="tplType" class="dtp-input" @bind="templateDocumentType">
                                <option value="">Select a type&#8230;</option>
                                @foreach (var t in documentTypes)
                                {
                                    <option value="@t">@FormatDocType(t)</option>
                                }
                            </select>
                            <span class="dtp-caret" aria-hidden="true"></span>
                        </div>
                    </div>
                </div>

                <div class="dtp-form-row dtp-form-row-3">
                    <div class="dtp-field">
                        <label class="dtp-label" for="tplPaper">Paper size</label>
                        <div class="dtp-select">
                            <select id="tplPaper" class="dtp-input" @bind="templatePaperSize">
                                <option value="A4">A4</option>
                                <option value="Letter">Letter</option>
                                <option value="Legal">Legal</option>
                            </select>
                            <span class="dtp-caret" aria-hidden="true"></span>
                        </div>
                    </div>
                    <div class="dtp-field">
                        <label class="dtp-label" for="tplOrient">Orientation</label>
                        <div class="dtp-select">
                            <select id="tplOrient" class="dtp-input" @bind="templateOrientation">
                                <option value="Portrait">Portrait</option>
                                <option value="Landscape">Landscape</option>
                            </select>
                            <span class="dtp-caret" aria-hidden="true"></span>
                        </div>
                    </div>
                    <div class="dtp-field">
                        <span class="dtp-label">Options</span>
                        <div class="dtp-checks">
                            <label class="dtp-check">
                                <input type="checkbox" @bind="templateIsDefault" />
                                <span>Default</span>
                            </label>
                            <label class="dtp-check">
                                <input type="checkbox" @bind="templateIsActive" />
                                <span>Active</span>
                            </label>
                        </div>
                    </div>
                </div>

                <div class="dtp-legend">
                    <span>Template content</span>
                    <button type="button" class="dtp-btn dtp-btn-ghost dtp-legend-action" @onclick="ShowPlaceholders">
                        View placeholders
                    </button>
                </div>

                <div class="dtp-field">
                    <label class="dtp-label" for="tplHeader">Header (HTML)</label>
                    <textarea id="tplHeader" class="dtp-textarea" rows="3" @bind="templateHeaderContent"
                              placeholder="Company logo, address, contact details&#8230;"></textarea>
                    <span class="dtp-hint">Appears at the top of every page of the document.</span>
                </div>

                <div class="dtp-field">
                    <label class="dtp-label" for="tplBody">Main content (HTML)</label>
                    <textarea id="tplBody" class="dtp-textarea" rows="12" @bind="templateHtmlContent"
                              placeholder="Use &#123;&#123;PlaceholderName&#125;&#125; for values from the document&#8230;"></textarea>
                    <span class="dtp-hint">&#123;&#123;PlaceholderName&#125;&#125; is substituted when the document is rendered.</span>
                </div>

                <div class="dtp-field">
                    <label class="dtp-label" for="tplFooter">Footer (HTML)</label>
                    <textarea id="tplFooter" class="dtp-textarea" rows="3" @bind="templateFooterContent"
                              placeholder="Terms, conditions, signature blocks&#8230;"></textarea>
                </div>

                <div class="dtp-field">
                    <label class="dtp-label" for="tplCss">CSS</label>
                    <textarea id="tplCss" class="dtp-textarea" rows="5" @bind="templateCssStyles"
                              placeholder=".header &#123; font-size: 24px; &#125;"></textarea>
                </div>
            </div>

            <div class="dtp-modal-foot">
                <button type="button" class="dtp-btn dtp-btn-quiet" @onclick="CloseTemplateModal">Cancel</button>
                <button type="button" class="dtp-btn dtp-btn-primary" disabled="@isSaving" @onclick="SaveTemplate">
                    @if (isSaving)
                    {
                        <span class="dtp-spin" aria-hidden="true"></span>
                        <span>Saving&#8230;</span>
                    }
                    else
                    {
                        <span>Save template</span>
                    }
                </button>
            </div>
        </div>
    </div>
}

@* ── Placeholders ──────────────────────────────────────────────────────── *@
@if (showPlaceholderDrawer)
{
    <div class="dtp dtp-drawer-scrim" @onclick="ClosePlaceholderDrawer"></div>
    <aside class="dtp dtp-drawer" role="dialog" aria-modal="true" aria-label="Template placeholders">
        <div class="dtp-drawer-head">
            <div>
                <h2>Placeholders</h2>
                <div class="dtp-drawer-sub">
                    <span class="dtp-badge @DocTypeFamily(templateDocumentType)">@FormatDocType(templateDocumentType)</span>
                </div>
            </div>
            <button type="button" class="dtp-icon-btn dtp-drawer-x" aria-label="Close" @onclick="ClosePlaceholderDrawer">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                     stroke-width="1.8" stroke-linecap="round" aria-hidden="true">
                    <path d="M5 5l14 14M19 5L5 19"></path>
                </svg>
            </button>
        </div>
        <div class="dtp-drawer-body">
            @if (placeholders != null)
            {
                @foreach (var group in placeholders.Placeholders.GroupBy(p => p.Category))
                {
                    <section class="dtp-section">
                        <h3>@group.Key</h3>
                        <div class="dtp-ph-group">
                            @foreach (var ph in group)
                            {
                                var key = ph.Key;
                                <div class="dtp-ph-row">
                                    <div class="dtp-ph-text">
                                        <span class="dtp-ph-key">@($"{{{{{key}}}}}")</span>
                                        <div class="dtp-ph-desc">@ph.Description</div>
                                    </div>
                                    <button type="button" class="dtp-icon-btn" title="Copy" aria-label="Copy placeholder"
                                            @onclick="() => CopyPlaceholder(key)">
                                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                             stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                            <rect x="9" y="9" width="11" height="11" rx="2"></rect>
                                            <path d="M5 15V5a2 2 0 0 1 2-2h8"></path>
                                        </svg>
                                    </button>
                                </div>
                            }
                        </div>
                    </section>
                }
            }
            else
            {
                <div class="dtp-loading">
                    <span class="dtp-spin" aria-hidden="true"></span>
                    <span>Loading placeholders&#8230;</span>
                </div>
            }
        </div>
    </aside>
}

@* ── Preview ───────────────────────────────────────────────────────────── *@
@if (showPreviewDrawer && previewTemplate != null)
{
    <div class="dtp dtp-drawer-scrim" @onclick="ClosePreviewDrawer"></div>
    <aside class="dtp dtp-drawer dtp-drawer-wide" role="dialog" aria-modal="true" aria-label="Template preview">
        <div class="dtp-drawer-head">
            <div>
                <h2>@previewTemplate.Name</h2>
                <div class="dtp-drawer-sub">
                    <span class="dtp-badge @DocTypeFamily(previewTemplate.DocumentType)">@FormatDocType(previewTemplate.DocumentType)</span>
                    <span class="dtp-paper">@previewTemplate.PaperSize &middot; @previewTemplate.Orientation</span>
                    @if (previewTemplate.IsDefault)
                    {
                        <span class="dtp-mark dtp-mark-default">Default</span>
                    }
                </div>
            </div>
            <button type="button" class="dtp-icon-btn dtp-drawer-x" aria-label="Close" @onclick="ClosePreviewDrawer">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                     stroke-width="1.8" stroke-linecap="round" aria-hidden="true">
                    <path d="M5 5l14 14M19 5L5 19"></path>
                </svg>
            </button>
        </div>
        <div class="dtp-drawer-body">
            @if (!string.IsNullOrWhiteSpace(previewTemplate.CssStyles))
            {
                <section class="dtp-section">
                    <h3>CSS</h3>
                    <pre class="dtp-pre">@previewTemplate.CssStyles</pre>
                </section>
            }
            @if (!string.IsNullOrWhiteSpace(previewTemplate.HeaderContent))
            {
                <section class="dtp-section">
                    <h3>Header</h3>
                    <pre class="dtp-pre">@previewTemplate.HeaderContent</pre>
                </section>
            }
            <section class="dtp-section">
                <h3>Main content</h3>
                <pre class="dtp-pre">@previewTemplate.HtmlContent</pre>
            </section>
            @if (!string.IsNullOrWhiteSpace(previewTemplate.FooterContent))
            {
                <section class="dtp-section">
                    <h3>Footer</h3>
                    <pre class="dtp-pre">@previewTemplate.FooterContent</pre>
                </section>
            }
        </div>
        <div class="dtp-drawer-foot">
            <button type="button" class="dtp-btn dtp-btn-quiet" @onclick="ClosePreviewDrawer">Close</button>
            <button type="button" class="dtp-btn dtp-btn-primary" @onclick="() => EditTemplate(previewTemplate)">
                Edit template
            </button>
        </div>
    </aside>
}

@code {
    private List<DocumentTemplateDto>? templates;
    private bool isLoading = true;
    private string? errorMessage;
    private string? successMessage;
    private string? selectedDocumentType;
    private int currentPage = 1;
    private int pageSize = 12;
    private int totalCount;
    private int totalPages => (int)Math.Ceiling((double)totalCount / pageSize);

    // Modal state
    private bool showTemplateModal;
    private bool isSaving;
    private string? savingError;
    private DocumentTemplateDto? editingTemplate;

    // Placeholder drawer
    private bool showPlaceholderDrawer;
    private TemplatePlaceholdersDto? placeholders;

    // Preview drawer
    private bool showPreviewDrawer;
    private DocumentTemplateDto? previewTemplate;

    // Form fields
    private string templateName = "";
    private string templateDocumentType = "";
    private string templateHtmlContent = "";
    private string? templateCssStyles;
    private string? templateHeaderContent;
    private string? templateFooterContent;
    private string templatePaperSize = "A4";
    private string templateOrientation = "Portrait";
    private bool templateIsDefault;
    private bool templateIsActive = true;

    protected override async Task OnInitializedAsync()
    {
        pageSize = AppSettings.PageSize;
        await LoadTemplates();
    }

    private async Task LoadTemplates()
    {
        isLoading = true;
        errorMessage = null;
        try
        {
            var url = $"/api/document/templates?page={currentPage}&pageSize={pageSize}";
            if (!string.IsNullOrEmpty(selectedDocumentType))
            {
                url += $"&documentType={selectedDocumentType}";
            }

            var response = await Http.GetFromJsonAsync<DocumentTemplateListResponseDto>(url);
            templates = response?.Templates;
            totalCount = response?.TotalCount ?? 0;
        }
        catch (Exception ex)
        {
            errorMessage = $"Error loading templates: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task FilterByType(string? documentType)
    {
        selectedDocumentType = documentType;
        currentPage = 1;
        await LoadTemplates();
    }

    private async Task OnPageChanged(int page)
    {
        currentPage = page;
        await LoadTemplates();
    }

    private void OpenCreateModal()
    {
        editingTemplate = null;
        templateName = "";
        templateDocumentType = "";
        templateHtmlContent = "";
        templateCssStyles = null;
        templateHeaderContent = null;
        templateFooterContent = null;
        templatePaperSize = "A4";
        templateOrientation = "Portrait";
        templateIsDefault = false;
        templateIsActive = true;
        savingError = null;
        showTemplateModal = true;
    }

    private void EditTemplate(DocumentTemplateDto template)
    {
        showPreviewDrawer = false;
        editingTemplate = template;
        templateName = template.Name;
        templateDocumentType = template.DocumentType;
        templateHtmlContent = template.HtmlContent;
        templateCssStyles = template.CssStyles;
        templateHeaderContent = template.HeaderContent;
        templateFooterContent = template.FooterContent;
        templatePaperSize = template.PaperSize;
        templateOrientation = template.Orientation;
        templateIsDefault = template.IsDefault;
        templateIsActive = template.IsActive;
        savingError = null;
        showTemplateModal = true;
    }

    private void CloseTemplateModal()
    {
        showTemplateModal = false;
    }

    private async Task SaveTemplate()
    {
        isSaving = true;
        savingError = null;

        try
        {
            var request = new UpsertDocumentTemplateRequest
            {
                Name = templateName,
                DocumentType = templateDocumentType,
                HtmlContent = templateHtmlContent,
                CssStyles = templateCssStyles,
                HeaderContent = templateHeaderContent,
                FooterContent = templateFooterContent,
                PaperSize = templatePaperSize,
                Orientation = templateOrientation,
                IsDefault = templateIsDefault,
                IsActive = templateIsActive
            };

            HttpResponseMessage response;
            if (editingTemplate == null)
            {
                response = await Http.PostAsJsonAsync("/api/document/templates", request);
            }
            else
            {
                response = await Http.PutAsJsonAsync($"/api/document/templates/{editingTemplate.Id}", request);
            }

            if (response.IsSuccessStatusCode)
            {
                successMessage = editingTemplate == null ? "Template created successfully!" : "Template updated successfully!";
                CloseTemplateModal();
                await LoadTemplates();
            }
            else
            {
                savingError = "Failed to save template. Please try again.";
            }
        }
        catch (Exception ex)
        {
            savingError = $"Error: {ex.Message}";
        }
        finally
        {
            isSaving = false;
        }
    }

    private async Task SetAsDefault(int templateId)
    {
        if (await JS.InvokeAsync<bool>("confirm", "Set this template as the default for its document type?"))
        {
            try
            {
                var response = await Http.PostAsync($"/api/document/templates/{templateId}/set-default", null);
                if (response.IsSuccessStatusCode)
                {
                    successMessage = "Template set as default!";
                    await LoadTemplates();
                }
            }
            catch (Exception ex)
            {
                errorMessage = $"Error setting default: {ex.Message}";
            }
        }
    }

    private async Task DeleteTemplate(int templateId)
    {
        if (await JS.InvokeAsync<bool>("confirm", "Are you sure you want to delete this template? This cannot be undone."))
        {
            try
            {
                var response = await Http.DeleteAsync($"/api/document/templates/{templateId}");
                if (response.IsSuccessStatusCode)
                {
                    successMessage = "Template deleted successfully!";
                    await LoadTemplates();
                }
            }
            catch (Exception ex)
            {
                errorMessage = $"Error deleting template: {ex.Message}";
            }
        }
    }

    private void PreviewTemplate(DocumentTemplateDto template)
    {
        previewTemplate = template;
        showPreviewDrawer = true;
    }

    private void ClosePreviewDrawer()
    {
        showPreviewDrawer = false;
    }

    private async Task ShowPlaceholders()
    {
        if (string.IsNullOrEmpty(templateDocumentType))
        {
            savingError = "Please select a document type first to view available placeholders.";
            return;
        }

        placeholders = null;
        showPlaceholderDrawer = true;

        try
        {
            placeholders = await Http.GetFromJsonAsync<TemplatePlaceholdersDto>(
                $"/api/document/templates/placeholders/{templateDocumentType}");
        }
        catch (Exception ex)
        {
            errorMessage = $"Error loading placeholders: {ex.Message}";
            showPlaceholderDrawer = false;
        }
    }

    private void ClosePlaceholderDrawer()
    {
        showPlaceholderDrawer = false;
    }

    private async Task CopyPlaceholder(string key)
    {
        await JS.InvokeVoidAsync("navigator.clipboard.writeText", $"{{{{{key}}}}}");
    }

    // The filter chips and the editor's type picker are the same six values, so
    // they are stated once. Order is the order a document is met in: quote,
    // order, delivery, invoice, credit — with the purchase order beside the
    // sales one.
    private static readonly string[] documentTypes =
        ["Invoice", "Quote", "SalesOrder", "PurchaseOrder", "DeliveryNote", "CreditNote"];

    // Six hues off the one family set in nocturne-tokens.css, so each type's ink
    // is mixed from the same value as its wash. Held apart in hue rather than
    // ranked: no document type matters more than another.
    private static string DocTypeFamily(string docType) => docType switch
    {
        "Invoice" => "dtp-fam-info",
        "Quote" => "dtp-fam-good",
        "SalesOrder" => "dtp-fam-accent",
        "PurchaseOrder" => "dtp-fam-warn",
        "DeliveryNote" => "dtp-fam-neutral",
        "CreditNote" => "dtp-fam-bad",
        _ => "dtp-fam-neutral"
    };

    private List<int> GetPageNumbers()
    {
        var pages = new List<int>();
        var start = Math.Max(1, currentPage - 2);
        var end = Math.Min(totalPages, currentPage + 2);
        for (var i = start; i <= end; i++)
            pages.Add(i);
        return pages;
    }

    private string FormatDocType(string docType) => docType switch
    {
        "SalesOrder" => "Sales Order",
        "PurchaseOrder" => "Purchase Order",
        "DeliveryNote" => "Delivery Note",
        "CreditNote" => "Credit Note",
        _ => docType
    };

