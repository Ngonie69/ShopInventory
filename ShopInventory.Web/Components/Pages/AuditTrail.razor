@page "/audit-trail"
@using ShopInventory.Web.Data
@using ShopInventory.Web.Services
@inject IAuditService AuditService
@inject AuthenticationStateProvider AuthStateProvider
@inject IAppSettingsProvider AppSettings
@inject Microsoft.JSInterop.IJSRuntime JS
@attribute [Authorize(Roles = "Admin")]
@rendermode InteractiveServer
@implements IDisposable

<PageTitle>Audit Trail - Shop Inventory</PageTitle>

@* Nocturne. wwwroot/css/audit-trail.css (linked from App.razor) carries the
   design and its light counterpart, and follows the app's theme toggle like
   every other page. There is no Audit Trail.dc.html in the design project, so
   the sheet is derived from business-partners.css — the same page shape — and
   its header says what that costs.

   Icons are drawn inline rather than from the Phosphor font: the search glyph
   sits inside a field and the outcome glyph is what makes a failed row findable
   at a glance, so a font that failed to load would leave both reading as
   nothing.

   The log is a plain CSS grid rather than a <table>. Each row has a per-column
   treatment, and below 1040px the same markup re-lays as a labelled card —
   which a table element cannot do.

   The date filters are NocturneDateField, which keeps the shorthand entry the
   FlexibleDatePicker here accepted (`030826`, `3/8/26`, …) and draws its own
   calendar. Neither native control can do both: `<input type="date">` refuses
   the shorthand and draws a calendar no stylesheet can reach, and the
   MudDatePicker it replaces would have to be re-skinned against a stylesheet
   that loads last. *@

<div class="aud">

    <header class="aud-head">
        <div class="aud-head-inner">
            <label class="aud-head-search">
                <span class="visually-hidden">Search the events on this page</span>
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"
                     stroke-linecap="round" aria-hidden="true">
                    <circle cx="11" cy="11" r="7"></circle>
                    <path d="M20 20l-3.5-3.5"></path>
                </svg>
                @* Filters the page in hand; the date, user and action filters below
                   are the ones that go back to the database. *@
                <input class="aud-input aud-input-search" type="search" autocomplete="off"
                       placeholder="Search this page&#8230;" @bind="_searchString" @bind:event="oninput" />
            </label>
            <div class="aud-head-meta">
                <span class="aud-range">@DateRangeLabel</span>
                <button type="button" class="aud-btn aud-btn-ghost" disabled="@isLoading" @onclick="RefreshLogs">
                    @if (isLoading)
                    {
                        <span class="aud-spin" aria-hidden="true"></span>
                        <span>Loading&#8230;</span>
                    }
                    else
                    {
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                             stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <path d="M20 11a8 8 0 0 0-13.7-5.3L4 8"></path>
                            <path d="M4 4v4h4"></path>
                            <path d="M4 13a8 8 0 0 0 13.7 5.3L20 16"></path>
                            <path d="M20 20v-4h-4"></path>
                        </svg>
                        <span>Refresh</span>
                    }
                </button>
            </div>
        </div>
    </header>

    <div class="aud-body">

        <section class="aud-hero">
            <div>
                <div class="aud-kicker">Security</div>
                <h1>Audit trail</h1>
                <p>Every action the system recorded &#8212; who took it, what it touched, and whether it succeeded.</p>
            </div>
        </section>

        @if (errorMessage != null)
        {
            <div class="aud-msg" role="alert">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"
                     stroke-linecap="round" aria-hidden="true">
                    <circle cx="12" cy="12" r="9"></circle>
                    <path d="M12 7.5v5.5M12 16.2v.1"></path>
                </svg>
                <span>@errorMessage</span>
                <button type="button" class="aud-msg-x" aria-label="Dismiss" @onclick="() => errorMessage = null">
                    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"
                         stroke-linecap="round" aria-hidden="true">
                        <path d="M6 6l12 12M18 6L6 18"></path>
                    </svg>
                </button>
            </div>
        }

        <section class="aud-stats">
            <div class="aud-stat aud-stat-lead">
                <div class="aud-stat-head"><span class="aud-stat-rule" aria-hidden="true"></span>Total events</div>
                <div class="aud-stat-num">@GetTotalCountText()</div>
                <div class="aud-stat-sub">In the selected window</div>
            </div>
            <div class="aud-stat">
                <div class="aud-stat-head"><span class="aud-stat-rule" aria-hidden="true"></span>Unique users</div>
                <div class="aud-stat-num">@distinctUsers.Count.ToString("N0")</div>
                <div class="aud-stat-sub">Everyone on record</div>
            </div>
            <div class="aud-stat">
                <div class="aud-stat-head"><span class="aud-stat-rule" aria-hidden="true"></span>Action types</div>
                <div class="aud-stat-num">@distinctActions.Count.ToString("N0")</div>
                <div class="aud-stat-sub">Distinct kinds of event</div>
            </div>
            @* The count is of this page, not the window — the query that fills the
               table is paged, so say which it is rather than let it read as a total. *@
            <div class="aud-stat @(failedCount > 0 ? "aud-stat-alert" : "")">
                <div class="aud-stat-head"><span class="aud-stat-rule" aria-hidden="true"></span>Failed actions</div>
                <div class="aud-stat-num">@failedCount.ToString("N0")</div>
                <div class="aud-stat-sub">On this page</div>
            </div>
        </section>

        <section class="aud-panel">
            <div class="aud-panel-head">
                <h2>Activity log</h2>
                <span class="aud-count">@GetRecordCountText()</span>
                <div class="aud-panel-tools">
                    <button type="button" class="aud-tool" disabled="@isLoading" @onclick="ExportLogs">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                             stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <path d="M12 3v12"></path>
                            <path d="M7.5 10.5L12 15l4.5-4.5"></path>
                            <path d="M4 19h16"></path>
                        </svg>
                        <span>Export CSV</span>
                    </button>
                </div>
            </div>

            <div class="aud-filters">
                @* Not a <label>: the field carries a button and a popup, which a
                   label would swallow the clicks of. *@
                <div class="aud-field">
                    <span class="aud-label" id="aud-from-label">From date</span>
                    <NocturneDateField @bind-Date="fromDate" AriaLabel="From date" />
                </div>
                <div class="aud-field">
                    <span class="aud-label" id="aud-to-label">To date</span>
                    <NocturneDateField @bind-Date="toDate" AriaLabel="To date" />
                </div>
                <label class="aud-field">
                    <span class="aud-label">User</span>
                    <span class="aud-select">
                        <select class="aud-input" @bind="selectedUser">
                            <option value="">All users</option>
                            @foreach (var user in distinctUsers)
                            {
                                <option value="@user">@user</option>
                            }
                        </select>
                        <span class="aud-caret" aria-hidden="true"></span>
                    </span>
                </label>
                <label class="aud-field">
                    <span class="aud-label">Action</span>
                    <span class="aud-select">
                        <select class="aud-input" @bind="selectedAction">
                            <option value="">All actions</option>
                            @foreach (var action in distinctActions)
                            {
                                <option value="@action">@FormatAction(action)</option>
                            }
                        </select>
                        <span class="aud-caret" aria-hidden="true"></span>
                    </span>
                </label>
                <label class="aud-field">
                    <span class="aud-label">Per page</span>
                    <span class="aud-select">
                        <select class="aud-input" @bind="pageSize" @bind:after="OnPageSizeChanged">
                            <option value="25">25</option>
                            <option value="50">50</option>
                            <option value="100">100</option>
                            <option value="200">200</option>
                        </select>
                        <span class="aud-caret" aria-hidden="true"></span>
                    </span>
                </label>
                @* These four go back to the database, so they are applied on the
                   button rather than on change. *@
                <div class="aud-field">
                    <span class="aud-label">&nbsp;</span>
                    <div class="aud-filter-actions">
                        <button type="button" class="aud-btn aud-btn-primary" disabled="@isLoading"
                                @onclick="ApplyFilters">
                            Apply
                        </button>
                        <button type="button" class="aud-btn aud-btn-quiet" disabled="@isLoading"
                                @onclick="ClearFilters">
                            Clear
                        </button>
                    </div>
                </div>
            </div>

            @if (isLoading)
            {
                <div class="aud-loading">
                    <span class="aud-spin" aria-hidden="true"></span>
                    <span>Loading audit logs&#8230;</span>
                </div>
            }
            else
            {
                var rows = filteredLogs.ToList();

                if (rows.Count == 0)
                {
                    <div class="aud-empty">
                        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                             stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <path d="M6 3h12v18l-3-2-3 2-3-2-3 2z"></path>
                            <path d="M9 9h6M9 13h4"></path>
                        </svg>
                        @if (string.IsNullOrWhiteSpace(_searchString))
                        {
                            <span>No events were recorded in this window.</span>
                            <div class="aud-empty-actions">
                                <button type="button" class="aud-btn aud-btn-quiet" @onclick="ClearFilters">
                                    Reset to the last seven days
                                </button>
                            </div>
                        }
                        else
                        {
                            <span>No event on this page matches &#8220;@_searchString&#8221;.</span>
                            <div class="aud-empty-actions">
                                <button type="button" class="aud-btn aud-btn-quiet" @onclick="() => _searchString = string.Empty">
                                    Clear the search
                                </button>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <div class="aud-scroll">
                        <div class="aud-grid" role="table" aria-label="Audit events">
                            <div class="aud-thead" role="row">
                                <span role="columnheader">Timestamp</span>
                                <span role="columnheader">User</span>
                                <span role="columnheader">Role</span>
                                <span role="columnheader">Action</span>
                                <span role="columnheader">Details</span>
                                <span role="columnheader">IP address</span>
                                <span role="columnheader">Status</span>
                            </div>

                            @foreach (var log in rows)
                            {
                                var stamp = IAuditService.ToCAT(log.Timestamp);
                                <div class="aud-row @(log.IsSuccess ? "" : "aud-row-failed")" role="row"
                                     @onclick="() => SelectLog(log)">
                                    <span class="aud-ts" role="cell">
                                        <span class="aud-ts-date">@stamp.ToString("dd MMM yyyy")</span>
                                        <span class="aud-ts-time">@stamp.ToString("HH:mm:ss")</span>
                                    </span>
                                    <span class="aud-user" role="cell">
                                        <span class="aud-avatar" aria-hidden="true">@GetInitials(log.Username)</span>
                                        <span class="aud-name">@log.Username</span>
                                    </span>
                                    <span class="aud-cell-role" role="cell">
                                        <span class="aud-badge @GetRoleFamily(log.UserRole)">@log.UserRole</span>
                                    </span>
                                    <span class="aud-cell-action" role="cell">
                                        <span class="aud-badge @GetActionFamily(log.Action)">@FormatAction(log.Action)</span>
                                    </span>
                                    <span class="aud-detail" role="cell">
                                        @if (!string.IsNullOrEmpty(log.EntityType) || !string.IsNullOrWhiteSpace(log.AppVersion))
                                        {
                                            <span class="aud-detail-line">
                                                @if (!string.IsNullOrEmpty(log.EntityType))
                                                {
                                                    <span class="aud-tag">
                                                        @log.EntityType@(string.IsNullOrEmpty(log.EntityId) ? "" : $" #{log.EntityId}")
                                                    </span>
                                                }
                                                @if (!string.IsNullOrWhiteSpace(log.AppVersion))
                                                {
                                                    <span class="aud-tag">@log.AppVersion</span>
                                                }
                                            </span>
                                        }
                                        @if (!string.IsNullOrEmpty(log.Details))
                                        {
                                            <span class="aud-detail-text">
                                                <span class="aud-rl">Details</span>@TruncateText(log.Details, 90)
                                            </span>
                                        }
                                        @if (!string.IsNullOrWhiteSpace(log.DeviceModel))
                                        {
                                            <span class="aud-detail-text">
                                                <span class="aud-rl">Device</span>@TruncateText(log.DeviceModel, 40)
                                            </span>
                                        }
                                        @if (!log.IsSuccess && !string.IsNullOrEmpty(log.ErrorMessage))
                                        {
                                            <span class="aud-err">
                                                <span class="aud-rl">Error</span>@TruncateText(log.ErrorMessage, 80)
                                            </span>
                                        }
                                    </span>
                                    <span class="aud-cell-ip" role="cell">
                                        @if (!string.IsNullOrWhiteSpace(log.IpAddress))
                                        {
                                            <span class="aud-ip"><span class="aud-rl">IP</span>@log.IpAddress</span>
                                        }
                                        else
                                        {
                                            <span class="aud-ip-none"><span class="aud-rl">IP</span>Not captured</span>
                                        }
                                    </span>
                                    <span class="aud-cell-status" role="cell">
                                        @if (log.IsSuccess)
                                        {
                                            <span class="aud-badge aud-fam-good">
                                                <svg width="11" height="11" viewBox="0 0 24 24" fill="none"
                                                     stroke="currentColor" stroke-width="2.4" stroke-linecap="round"
                                                     stroke-linejoin="round" aria-hidden="true">
                                                    <path d="M5 12.5l4.5 4.5L19 7"></path>
                                                </svg>
                                                OK
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="aud-badge aud-fam-bad">
                                                <svg width="11" height="11" viewBox="0 0 24 24" fill="none"
                                                     stroke="currentColor" stroke-width="2.4" stroke-linecap="round"
                                                     aria-hidden="true">
                                                    <path d="M6 6l12 12M18 6L6 18"></path>
                                                </svg>
                                                Failed
                                            </span>
                                        }
                                    </span>
                                </div>
                            }
                        </div>
                    </div>

                    <div class="aud-foot">
                        <span class="aud-foot-info">
                            @if (currentRangeStart == 0)
                            {
                                <text>No records</text>
                            }
                            else if (totalCount is int exactCount)
                            {
                                <text>Showing @currentRangeStart&#8211;@currentRangeEnd of @exactCount.ToString("N0")</text>
                            }
                            else
                            {
                                <text>Showing @currentRangeStart&#8211;@currentRangeEnd</text>
                                @if (isTotalCountLoading)
                                {
                                    <text> · counting&#8230;</text>
                                }
                            }
                        </span>
                        <div class="aud-pages">
                            @if (totalCount.HasValue)
                            {
                                <button type="button" class="aud-step" disabled="@(currentPage <= 1)"
                                        aria-label="First page" @onclick="() => GoToPage(1)">
                                    &#8676;
                                </button>
                            }
                            <button type="button" class="aud-step" disabled="@(currentPage <= 1)"
                                    aria-label="Previous page" @onclick="() => GoToPage(currentPage - 1)">
                                Previous
                            </button>
                            @if (totalCount.HasValue)
                            {
                                @foreach (var p in GetPageNumbers())
                                {
                                    <button type="button" class="aud-page @(p == currentPage ? "aud-page-on" : "")"
                                            aria-current="@(p == currentPage ? "page" : null)"
                                            @onclick="() => GoToPage(p)">
                                        @p
                                    </button>
                                }
                            }
                            else
                            {
                                <span class="aud-gap">Page @currentPage</span>
                            }
                            <button type="button" class="aud-step"
                                    disabled="@(totalCount.HasValue ? currentPage >= totalPages : !hasMorePages)"
                                    aria-label="Next page" @onclick="() => GoToPage(currentPage + 1)">
                                Next
                            </button>
                            @if (totalCount.HasValue)
                            {
                                <button type="button" class="aud-step" disabled="@(currentPage >= totalPages)"
                                        aria-label="Last page" @onclick="() => GoToPage(totalPages)">
                                    &#8677;
                                </button>
                            }
                        </div>
                    </div>
                }
            }
        </section>
    </div>
</div>

@* The scrim and the drawer carry `.aud` themselves: they sit outside the page
   element so it cannot clip them, and the class is what puts the tokens in
   reach. *@
@if (selectedLog is AuditLog detail)
{
    var detailStamp = IAuditService.ToCAT(detail.Timestamp);

    <div class="aud aud-scrim" @onclick="CloseDrawer"></div>
    <aside class="aud aud-drawer" role="dialog" aria-modal="true" aria-label="Event details">
        <div class="aud-drawer-head">
            <div>
                <h2>@FormatAction(detail.Action)</h2>
                <div class="aud-drawer-sub">@detailStamp.ToString("dd MMM yyyy, HH:mm:ss") CAT · @detail.Username</div>
            </div>
            <button type="button" class="aud-icon-btn aud-drawer-x" aria-label="Close" @onclick="CloseDrawer">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                     stroke-linecap="round" aria-hidden="true">
                    <path d="M6 6l12 12M18 6L6 18"></path>
                </svg>
            </button>
        </div>

        <div class="aud-drawer-body">
            <section class="aud-section">
                <h3>Event</h3>
                <div class="aud-dl">
                    <div>
                        <div class="aud-dt">Timestamp</div>
                        <div class="aud-dd aud-dd-num">@detailStamp.ToString("dd MMM yyyy, HH:mm:ss") CAT</div>
                    </div>
                    <div>
                        <div class="aud-dt">Outcome</div>
                        <div class="aud-dd">
                            @if (detail.IsSuccess)
                            {
                                <span class="aud-badge aud-fam-good">
                                    <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                         stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"
                                         aria-hidden="true">
                                        <path d="M5 12.5l4.5 4.5L19 7"></path>
                                    </svg>
                                    Success
                                </span>
                            }
                            else
                            {
                                <span class="aud-badge aud-fam-bad">
                                    <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                         stroke-width="2.4" stroke-linecap="round" aria-hidden="true">
                                        <path d="M6 6l12 12M18 6L6 18"></path>
                                    </svg>
                                    Failed
                                </span>
                            }
                        </div>
                    </div>
                    <div>
                        <div class="aud-dt">User</div>
                        <div class="aud-dd">@detail.Username</div>
                    </div>
                    <div>
                        <div class="aud-dt">Role</div>
                        <div class="aud-dd">
                            <span class="aud-badge @GetRoleFamily(detail.UserRole)">@detail.UserRole</span>
                        </div>
                    </div>
                    <div>
                        <div class="aud-dt">Action</div>
                        <div class="aud-dd">
                            <span class="aud-badge @GetActionFamily(detail.Action)">@FormatAction(detail.Action)</span>
                        </div>
                    </div>
                    @if (!string.IsNullOrEmpty(detail.EntityType))
                    {
                        <div>
                            <div class="aud-dt">Entity</div>
                            <div class="aud-dd">
                                @detail.EntityType@(string.IsNullOrEmpty(detail.EntityId) ? "" : $" #{detail.EntityId}")
                            </div>
                        </div>
                    }
                </div>
            </section>

            @if (!string.IsNullOrEmpty(detail.Details))
            {
                <section class="aud-section">
                    <h3>Details</h3>
                    <pre class="aud-pre">@detail.Details</pre>
                </section>
            }

            @if (!string.IsNullOrEmpty(detail.ErrorMessage))
            {
                <section class="aud-section">
                    <h3>Error</h3>
                    <pre class="aud-pre aud-pre-err">@detail.ErrorMessage</pre>
                </section>
            }

            @if (HasClientMetadata(detail))
            {
                <section class="aud-section">
                    <h3>Client</h3>
                    <div class="aud-meta">
                        @if (!string.IsNullOrWhiteSpace(detail.IpAddress))
                        {
                            <div class="aud-meta-row">
                                <span class="aud-meta-label">IP address</span>
                                <span class="aud-meta-value">@detail.IpAddress</span>
                                <button type="button" class="aud-icon-btn" title="Copy IP address"
                                        aria-label="Copy IP address" @onclick="() => CopyClientDetail(detail.IpAddress)">
                                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                         stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"
                                         aria-hidden="true">
                                        <rect x="9" y="9" width="11" height="11" rx="2"></rect>
                                        <path d="M5 15V5a2 2 0 0 1 2-2h8"></path>
                                    </svg>
                                </button>
                            </div>
                        }
                        @if (!string.IsNullOrWhiteSpace(detail.UserAgent))
                        {
                            <div class="aud-meta-row aud-meta-row-long">
                                <span class="aud-meta-label">User agent</span>
                                <span class="aud-meta-value">@detail.UserAgent</span>
                                <button type="button" class="aud-icon-btn" title="Copy user agent"
                                        aria-label="Copy user agent" @onclick="() => CopyClientDetail(detail.UserAgent)">
                                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                         stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"
                                         aria-hidden="true">
                                        <rect x="9" y="9" width="11" height="11" rx="2"></rect>
                                        <path d="M5 15V5a2 2 0 0 1 2-2h8"></path>
                                    </svg>
                                </button>
                            </div>
                        }
                        @if (!string.IsNullOrWhiteSpace(detail.AppVersion))
                        {
                            <div class="aud-meta-row">
                                <span class="aud-meta-label">App version</span>
                                <span class="aud-meta-value">@detail.AppVersion</span>
                            </div>
                        }
                        @if (!string.IsNullOrWhiteSpace(detail.DeviceModel))
                        {
                            <div class="aud-meta-row">
                                <span class="aud-meta-label">Device model</span>
                                <span class="aud-meta-value">@detail.DeviceModel</span>
                            </div>
                        }
                        @if (!string.IsNullOrWhiteSpace(detail.PageUrl))
                        {
                            <div class="aud-meta-row aud-meta-row-long">
                                <span class="aud-meta-label">Page URL</span>
                                <span class="aud-meta-value">@detail.PageUrl</span>
                                <button type="button" class="aud-icon-btn" title="Copy page URL"
                                        aria-label="Copy page URL" @onclick="() => CopyClientDetail(detail.PageUrl)">
                                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                         stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"
                                         aria-hidden="true">
                                        <rect x="9" y="9" width="11" height="11" rx="2"></rect>
                                        <path d="M5 15V5a2 2 0 0 1 2-2h8"></path>
                                    </svg>
                                </button>
                            </div>
                        }
                    </div>
                </section>
            }
        </div>
    </aside>
}

@code {
    private List<AuditLog> logs = new();
    private List<string> distinctUsers = new();
    private List<string> distinctActions = new();
    private bool isLoading = true;
    private string? errorMessage;
    private string _searchString = string.Empty;
    private AuditLog? selectedLog;
    private int failedCount;
    private bool isTotalCountLoading;
    private bool hasMorePages;
    private int _pageLoadVersion;
    private int _countLoadVersion;
    private string _activeCountKey = string.Empty;
    private bool _isDisposed;

    // Filters
    private DateTime? fromDate;
    private DateTime? toDate;
    private string? selectedUser;
    private string? selectedAction;

    // Pagination
    private int currentPage = 1;
    private int pageSize = 50;
    private int? totalCount;
    private int totalPages => totalCount is int count
        ? Math.Max(1, (int)Math.Ceiling((double)count / pageSize))
        : Math.Max(1, currentPage + (hasMorePages ? 1 : 0));
    private int currentRangeStart => logs.Count == 0 ? 0 : ((currentPage - 1) * pageSize) + 1;
    private int currentRangeEnd => logs.Count == 0 ? 0 : ((currentPage - 1) * pageSize) + logs.Count;

    private IEnumerable<AuditLog> filteredLogs => string.IsNullOrWhiteSpace(_searchString)
        ? logs
        : logs.Where(MatchesQuickSearch);

    // The window the figures above the table are counted over, said in the header
    // so a screenshot of this page carries its own scope.
    private string DateRangeLabel => (fromDate, toDate) switch
    {
        ({ } from, { } to) => $"{from:d MMM} – {to:d MMM yyyy}",
        ({ } from, null) => $"From {from:d MMM yyyy}",
        (null, { } to) => $"Up to {to:d MMM yyyy}",
        _ => "All dates"
    };

    // Roles and actions are drawn as one badge whose hue comes from a family
    // token, so both of these return a family class rather than a bespoke one.
    private string GetRoleFamily(string? role) => role switch
    {
        UserRoles.Admin => "aud-fam-accent",
        UserRoles.Cashier => "aud-fam-info",
        UserRoles.StockController => "aud-fam-good",
        UserRoles.DepotController => "aud-fam-warn",
        _ => "aud-fam-neutral"
    };

    // Views are the noise floor of an audit log, so they take the neutral family
    // and recede; the writes and the failures are what the page is scanned for.
    private string GetActionFamily(string? action) => action switch
    {
        AuditActions.Login or AuditActions.Logout => "aud-fam-good",
        AuditActions.LoginFailed => "aud-fam-bad",
        var a when a != null && a.StartsWith("Create") => "aud-fam-info",
        var a when a != null && a.StartsWith("Update") => "aud-fam-warn",
        var a when a != null && a.StartsWith("Delete") => "aud-fam-bad",
        var a when a != null && a.StartsWith("View") => "aud-fam-neutral",
        var a when a != null && a.StartsWith("Sync") => "aud-fam-accent",
        _ => "aud-fam-neutral"
    };

    private static string GetInitials(string? name)
    {
        if (string.IsNullOrWhiteSpace(name)) return "?";
        var parts = name.Split(new[] { '.', ' ', '_' }, StringSplitOptions.RemoveEmptyEntries);
        if (parts.Length >= 2)
        {
            return $"{parts[0][0]}{parts[1][0]}".ToUpperInvariant();
        }

        var compactName = new string(name.Where(char.IsLetterOrDigit).Take(2).ToArray());
        return string.IsNullOrWhiteSpace(compactName)
            ? "?"
            : compactName.ToUpperInvariant();
    }

    private static string FormatAction(string? action)
    {
        if (string.IsNullOrEmpty(action)) return "";
        if (action == AuditActions.RefreshToken) return "Session Renewed";

        // Insert space before uppercase letters: "ViewInvoice" → "View Invoice"
        return System.Text.RegularExpressions.Regex.Replace(action, "(?<=[a-z])(?=[A-Z])", " ");
    }

    private static string TruncateText(string text, int maxLen) =>
        text.Length <= maxLen ? text : text[..maxLen] + "...";

    private string GetTotalCountText() => totalCount?.ToString("N0") ?? "…";

    private string GetRecordCountText() => totalCount is int count
        ? $"{count:N0} records"
        : isTotalCountLoading
            ? "Calculating total..."
            : $"{logs.Count:N0} records";

    private string BuildCountKey() => string.Join("|",
        fromDate?.Date.Ticks.ToString() ?? "null",
        toDate?.Date.Ticks.ToString() ?? "null",
        selectedUser ?? string.Empty,
        selectedAction ?? string.Empty);

    private IEnumerable<int> GetPageNumbers()
    {
        const int maxVisible = 5;
        var start = Math.Max(1, currentPage - maxVisible / 2);
        var end = Math.Min(totalPages, start + maxVisible - 1);
        start = Math.Max(1, end - maxVisible + 1);
        return Enumerable.Range(start, end - start + 1);
    }

    private void SelectLog(AuditLog log) => selectedLog = log;
    private void CloseDrawer() => selectedLog = null;

    private static bool HasClientMetadata(AuditLog log) =>
        !string.IsNullOrWhiteSpace(log.IpAddress) ||
        !string.IsNullOrWhiteSpace(log.UserAgent) ||
        !string.IsNullOrWhiteSpace(log.AppVersion) ||
        !string.IsNullOrWhiteSpace(log.DeviceModel) ||
        !string.IsNullOrWhiteSpace(log.PageUrl);

    private async Task CopyClientDetail(string? value)
    {
        if (string.IsNullOrWhiteSpace(value))
        {
            return;
        }

        try
        {
            await JS.InvokeVoidAsync("navigator.clipboard.writeText", value);
        }
        catch
        {
            errorMessage = "Unable to copy this value to the clipboard.";
        }
    }

    protected override async Task OnInitializedAsync()
    {
        pageSize = AppSettings.PageSize;
        var catNow = IAuditService.ToCAT(DateTime.UtcNow);
        toDate = catNow.Date;
        fromDate = catNow.Date.AddDays(-7);

        await LoadFilterOptions();
        await LoadLogs(refreshTotalCount: true);
        await LogViewAudit();
    }

    private async Task LoadFilterOptions()
    {
        try
        {
            distinctUsers = await AuditService.GetDistinctUsersAsync();
            distinctActions = await AuditService.GetDistinctActionsAsync();
        }
        catch (Exception ex)
        {
            errorMessage = $"Failed to load filter options: {ex.Message}";
        }
    }

    private async Task LoadLogs(bool refreshTotalCount = false)
    {
        isLoading = true;
        errorMessage = null;

        var pageLoadVersion = ++_pageLoadVersion;
        var countKey = BuildCountKey();
        var shouldRefreshTotalCount = refreshTotalCount ||
            totalCount is null ||
            !string.Equals(_activeCountKey, countKey, StringComparison.Ordinal);

        try
        {
            if (shouldRefreshTotalCount)
            {
                totalCount = null;
                isTotalCountLoading = true;
                _activeCountKey = countKey;
                _ = LoadTotalCountAsync(
                    countKey,
                    ++_countLoadVersion,
                    fromDate,
                    toDate,
                    selectedUser,
                    selectedAction);
            }

            var pageResult = await AuditService.GetLogPageAsync(fromDate, toDate, selectedUser, selectedAction, currentPage,
pageSize);
            if (_isDisposed || pageLoadVersion != _pageLoadVersion)
            {
                return;
            }

            logs = pageResult.Items;
            hasMorePages = pageResult.HasMore;
            failedCount = logs.Count(l => !l.IsSuccess);
        }
        catch (Exception ex)
        {
            if (_isDisposed || pageLoadVersion != _pageLoadVersion)
            {
                return;
            }

            logs.Clear();
            hasMorePages = false;
            errorMessage = $"Failed to load audit logs: {ex.Message}";
        }
        finally
        {
            if (!_isDisposed && pageLoadVersion == _pageLoadVersion)
            {
                isLoading = false;
            }
        }
    }

    private async Task LoadTotalCountAsync(
        string countKey,
        int countLoadVersion,
        DateTime? countFromDate,
        DateTime? countToDate,
        string? countSelectedUser,
        string? countSelectedAction)
    {
        try
        {
            var count = await AuditService.GetLogCountAsync(countFromDate, countToDate, countSelectedUser, countSelectedAction);
            if (_isDisposed || countLoadVersion != _countLoadVersion || !string.Equals(_activeCountKey, countKey,
StringComparison.Ordinal))
            {
                return;
            }

            totalCount = count;
        }
        catch
        {
            if (_isDisposed || countLoadVersion != _countLoadVersion || !string.Equals(_activeCountKey, countKey,
StringComparison.Ordinal))
            {
                return;
            }

            totalCount = null;
        }
        finally
        {
            if (!_isDisposed && countLoadVersion == _countLoadVersion && string.Equals(_activeCountKey, countKey,
StringComparison.Ordinal))
            {
                isTotalCountLoading = false;
                await TryRefreshAsync();
            }
        }
    }

    private async Task TryRefreshAsync()
    {
        try
        {
            await InvokeAsync(StateHasChanged);
        }
        catch
        {
            // The count task is deliberately fire-and-forget; a disposed circuit should not surface here.
        }
    }

    private async Task ApplyFilters()
    {
        currentPage = 1;
        await LoadLogs(refreshTotalCount: true);
    }

    private async Task ClearFilters()
    {
        var catNow = IAuditService.ToCAT(DateTime.UtcNow);
        fromDate = catNow.Date.AddDays(-7);
        toDate = catNow.Date;
        selectedUser = null;
        selectedAction = null;
        currentPage = 1;
        await LoadLogs(refreshTotalCount: true);
    }

    private async Task RefreshLogs()
    {
        await LoadFilterOptions();
        await LoadLogs(refreshTotalCount: true);
    }

    private async Task GoToPage(int page)
    {
        if (page < 1)
        {
            return;
        }

        if (totalCount.HasValue)
        {
            if (page > totalPages)
            {
                return;
            }
        }
        else if (page > currentPage && !hasMorePages)
        {
            return;
        }

        currentPage = page;
        await LoadLogs();
    }

    private async Task OnPageSizeChanged()
    {
        currentPage = 1;
        await LoadLogs();
    }

    private async Task ExportLogs()
    {
        errorMessage = null;

        try
        {
            var exportCount = totalCount ?? await AuditService.GetLogCountAsync(fromDate, toDate, selectedUser, selectedAction);
            var exportLogs = await AuditService.GetLogsAsync(
                fromDate,
                toDate,
                selectedUser,
                selectedAction,
                page: 1,
                pageSize: Math.Max(exportCount, 1));

            var rows = string.IsNullOrWhiteSpace(_searchString)
                ? exportLogs
                : exportLogs.Where(MatchesQuickSearch).ToList();

            var csvContent = BuildCsv(rows);
            var csvBytes = System.Text.Encoding.UTF8.GetPreamble()
                .Concat(System.Text.Encoding.UTF8.GetBytes(csvContent))
                .ToArray();
            var fileName = $"AuditTrail_{IAuditService.ToCAT(DateTime.UtcNow):yyyyMMdd_HHmmss}.csv";

            await JS.InvokeVoidAsync(
                "downloadFile",
                fileName,
                "text/csv;charset=utf-8",
                Convert.ToBase64String(csvBytes));

            await AuditService.LogAsync(
                AuditActions.ExportAuditTrail,
                "AuditLog",
                null,
                $"Exported {rows.Count:N0} audit log entries to CSV.",
                true);
        }
        catch (Exception ex)
        {
            errorMessage = $"Failed to export audit logs: {ex.Message}";

            await AuditService.LogAsync(
                AuditActions.ExportAuditTrail,
                "AuditLog",
                null,
                "Failed to export audit log entries to CSV.",
                false,
                ex.Message);
        }
    }

    private bool MatchesQuickSearch(AuditLog log) =>
        (log.Username?.Contains(_searchString, StringComparison.OrdinalIgnoreCase) == true) ||
        (log.UserRole?.Contains(_searchString, StringComparison.OrdinalIgnoreCase) == true) ||
        (log.Action?.Contains(_searchString, StringComparison.OrdinalIgnoreCase) == true) ||
        (log.EntityType?.Contains(_searchString, StringComparison.OrdinalIgnoreCase) == true) ||
        (log.Details?.Contains(_searchString, StringComparison.OrdinalIgnoreCase) == true) ||
        (log.ErrorMessage?.Contains(_searchString, StringComparison.OrdinalIgnoreCase) == true) ||
        (log.IpAddress?.Contains(_searchString, StringComparison.OrdinalIgnoreCase) == true) ||
        (log.UserAgent?.Contains(_searchString, StringComparison.OrdinalIgnoreCase) == true) ||
        (log.PageUrl?.Contains(_searchString, StringComparison.OrdinalIgnoreCase) == true) ||
        (log.AppVersion?.Contains(_searchString, StringComparison.OrdinalIgnoreCase) == true) ||
        (log.DeviceModel?.Contains(_searchString, StringComparison.OrdinalIgnoreCase) == true);

    private static string BuildCsv(IEnumerable<AuditLog> auditLogs)
    {
        var csv = new System.Text.StringBuilder();
        csv.AppendLine("Timestamp CAT,Username,User Role,Action,Entity Type,Entity Id,Details,Page Url,Status,Error Message,IP Address,App Version,Device Model,User Agent");

        foreach (var log in auditLogs)
        {
            csv.AppendJoin(',',
                EscapeCsv(IAuditService.ToCAT(log.Timestamp).ToString("yyyy-MM-dd HH:mm:ss")),
                EscapeCsv(log.Username),
                EscapeCsv(log.UserRole),
                EscapeCsv(log.Action),
                EscapeCsv(log.EntityType),
                EscapeCsv(log.EntityId),
                EscapeCsv(log.Details),
                EscapeCsv(log.PageUrl),
                EscapeCsv(log.IsSuccess ? "Success" : "Failed"),
                EscapeCsv(log.ErrorMessage),
                EscapeCsv(log.IpAddress),
                EscapeCsv(log.AppVersion),
                EscapeCsv(log.DeviceModel),
                EscapeCsv(log.UserAgent));
            csv.AppendLine();
        }

        return csv.ToString();
    }

    private static string EscapeCsv(string? value)
    {
        if (string.IsNullOrEmpty(value))
        {
            return string.Empty;
        }

        var normalized = value.Replace("\r\n", "\n").Replace('\r', '\n');
        var escaped = normalized.Replace("\"", "\"\"");

        return escaped.IndexOfAny(new[] { ',', '\"', '\n' }) >= 0
            ? $"\"{escaped}\""
            : escaped;
    }

    private async Task LogViewAudit()
    {
        try
        {
            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            var username = authState.User.Identity?.Name ?? "Unknown";
            var role = authState.User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value ?? "Unknown";
            await AuditService.LogAsync(AuditActions.ViewAuditTrail, username, role, "AuditLog", null, null, "/audit-trail");
        }
        catch
        {
            // Viewing the audit page should not fail because writing the view audit entry failed.
        }
    }

    public void Dispose()
    {
        _isDisposed = true;
        _pageLoadVersion++;
        _countLoadVersion++;
    }
}
