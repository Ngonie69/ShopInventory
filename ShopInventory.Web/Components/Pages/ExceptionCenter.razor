@page "/exception-center"
@attribute [Authorize(Roles = "Admin,Cashier,StockController,Manager")]
@rendermode InteractiveServer

<PageTitle>Exception Center - Shop Inventory</PageTitle>

@* Styles live in wwwroot/css/exception-center.css (linked from App.razor). The Nocturne
   design is a single dark scheme; the stylesheet keeps those values as its dark theme and
   carries a light one built from the shell's palette, so the page follows the app's
   light/dark toggle — same arrangement as /settings and /invoices/create. *@

<div class="exc">

    <!-- ── Header ─────────────────────────────────────────────────────── -->
    <header class="exc-header">
        <div class="exc-header-inner">
            <div class="exc-header-title">
                <div class="exc-header-title-row">
                    <i class="ph ph-siren"></i>
                    <h1>Exception Center</h1>
                </div>
                <p>What is stuck across SAP posting, fiscalization, mobile sync and payments — grouped by cause, priced by impact</p>
            </div>
            <div class="exc-header-actions">
                @if (dashboard is not null)
                {
                    <span class="exc-asof">
                        @if (isRefreshing)
                        {
                            <span class="exc-spin"></span>
                        }
                        else
                        {
                            <i class="ph ph-clock-countdown"></i>
                        }
                        as of @FormatTime(dashboard.GeneratedAtUtc)
                    </span>
                }
                <label class="exc-switch" title="Reload every 60 seconds">
                    <input type="checkbox" checked="@autoRefresh" @onchange="ToggleAutoRefresh" />
                    <span class="exc-switch-track"></span>
                    <span>Live</span>
                </label>
                <button type="button" class="exc-btn exc-btn-secondary" @onclick="ReloadAsync" disabled="@(isLoading || isRefreshing)">
                    <i class="ph ph-arrows-clockwise"></i> Refresh
                </button>
            </div>
        </div>
        <div class="exc-rule"></div>
    </header>

    @if (isLoading)
    {
        <div class="exc-loading">
            <span class="exc-spin exc-spin-lg"></span>
            <p>Reading the integration queues…</p>
        </div>
    }
    else
    {
        <div class="exc-body">

            <SystemHealthBanner ShowDetailsButton="false" />

            @if (!string.IsNullOrWhiteSpace(errorMessage))
            {
                <div class="exc-alert exc-alert-error">
                    <i class="ph ph-warning-circle"></i>
                    <span>@errorMessage</span>
                    <button type="button" class="exc-alert-close" @onclick="() => errorMessage = null">
                        <i class="ph ph-x"></i>
                    </button>
                </div>
            }

            @if (!string.IsNullOrWhiteSpace(successMessage))
            {
                <div class="exc-alert exc-alert-success">
                    <i class="ph ph-check-circle"></i>
                    <span>@successMessage</span>
                    <button type="button" class="exc-alert-close" @onclick="() => successMessage = null">
                        <i class="ph ph-x"></i>
                    </button>
                </div>
            }

            @* Items past their own retry schedule mean the worker is not draining the
               queue — a different problem from the failures themselves, so it is called
               out separately rather than buried in a row. *@
            @if (Triage.RetryOverdueCount > 0)
            {
                <div class="exc-alert exc-alert-warn">
                    <i class="ph ph-plug"></i>
                    <span>
                        <strong>@Triage.RetryOverdueCount item(s) are past their scheduled retry time.</strong>
                        Retries are queued but nothing is picking them up — check that the queue processor is running.
                    </span>
                </div>
            }

            @if (Triage.StalledCount > 0)
            {
                <div class="exc-alert exc-alert-warn">
                    <i class="ph ph-pause-circle"></i>
                    <span>
                        <strong>@Triage.StalledCount item(s) have been left mid-flight.</strong>
                        A worker took them and never returned a verdict. Confirm the document did not post in SAP before retrying.
                    </span>
                </div>
            }

            @if (dashboard?.AnalysisTruncated == true)
            {
                <div class="exc-alert exc-alert-info">
                    <i class="ph ph-info"></i>
                    <span>
                        There are more exceptions than this page reads in one pass. Totals below are exact;
                        the cause grouping and value figures describe the most recent @Items.Count of @dashboard.TotalItemCount.
                    </span>
                </div>
            }

            <!-- ── Triage ─────────────────────────────────────────────── -->
            @* Five tiles instead of seven equal category counts: the split that decides
               what an operator does next is "will this recover on its own", not "which
               subsystem was it". Each tile is also the filter for the queue below. *@
            <div class="exc-triage">
                <button type="button"
                        class="exc-tile exc-tile-danger @(preset == PresetNeedsHuman ? "exc-tile-on" : null)"
                        @onclick="() => SetPreset(PresetNeedsHuman)">
                    <span class="exc-tile-label"><i class="ph ph-hand-palm"></i> Needs a human</span>
                    <span class="exc-tile-value">@Triage.BlockedCount</span>
                    <span class="exc-tile-note">
                        @if (Triage.BlockedCount == 0)
                        {
                            @("nothing waiting on you")
                        }
                        else
                        {
                            @($"{Triage.BlockedUnassignedCount} unassigned · {Triage.BlockedUnacknowledgedCount} unseen")
                        }
                    </span>
                </button>

                <button type="button"
                        class="exc-tile exc-tile-calm @(preset == PresetRetrying ? "exc-tile-on" : null)"
                        @onclick="() => SetPreset(PresetRetrying)">
                    <span class="exc-tile-label"><i class="ph ph-arrows-clockwise"></i> Self-healing</span>
                    <span class="exc-tile-value">@Triage.RetryingCount</span>
                    <span class="exc-tile-note">
                        @(Triage.NextRetryAtUtc.HasValue ? $"next attempt {FormatCountdown(Triage.NextRetryAtUtc)}" : "no retry scheduled")
                    </span>
                </button>

                <button type="button"
                        class="exc-tile exc-tile-warn @(preset == PresetStalled ? "exc-tile-on" : null)"
                        @onclick="() => SetPreset(PresetStalled)">
                    <span class="exc-tile-label"><i class="ph ph-pause-circle"></i> Stalled or overdue</span>
                    <span class="exc-tile-value">@(Triage.StalledCount + Triage.RetryOverdueCount)</span>
                    <span class="exc-tile-note">@Triage.StalledCount mid-flight · @Triage.RetryOverdueCount past due</span>
                </button>

                <div class="exc-tile exc-tile-quiet">
                    <span class="exc-tile-label"><i class="ph ph-coins"></i> Value at risk</span>
                    @{
                        var headlineMoney = Exposure.FirstOrDefault(entry => entry.Currency is not null);
                    }
                    <span class="exc-tile-value exc-tile-value-sm">
                        @(headlineMoney is null ? "—" : FormatMoney(headlineMoney.Amount, headlineMoney.Currency))
                    </span>
                    <span class="exc-tile-note">
                        @(headlineMoney is null
                            ? "no priced documents held up"
                            : $"{headlineMoney.Label.ToLowerInvariant()} · {headlineMoney.ItemCount} document(s)")
                    </span>
                </div>

                <div class="exc-tile exc-tile-quiet">
                    <span class="exc-tile-label"><i class="ph ph-hourglass-high"></i> Oldest unresolved</span>
                    <span class="exc-tile-value exc-tile-value-sm">@FormatAge(Triage.OldestOpenAtUtc)</span>
                    <span class="exc-tile-note">
                        @if (Triage.NewLast24hCount == 0 && Triage.PreviousDayCount == 0)
                        {
                            @("nothing new in 48 hours")
                        }
                        else
                        {
                            <span class="exc-delta @(Triage.NewLast24hCount > Triage.PreviousDayCount ? "exc-delta-up" : Triage.NewLast24hCount < Triage.PreviousDayCount ? "exc-delta-down" : "exc-delta-flat")">
                                <i class="ph @(Triage.NewLast24hCount > Triage.PreviousDayCount ? "ph-trend-up" : Triage.NewLast24hCount < Triage.PreviousDayCount ? "ph-trend-down" : "ph-minus")"></i>
                                @Triage.NewLast24hCount in 24h vs @Triage.PreviousDayCount before
                            </span>
                        }
                    </span>
                </div>
            </div>

            @if (!HasAnything)
            {
                <section class="exc-card">
                    <div class="exc-empty">
                        <i class="ph-fill ph-check-circle"></i>
                        <div>
                            <strong>Every integration queue is clear.</strong>
                            <p>Nothing has failed posting, fiscalization, mobile sync or payment settlement.</p>
                        </div>
                    </div>
                </section>
            }
            else
            {
                <div class="exc-split">

                    <!-- ── Root causes ────────────────────────────────── -->
                    <section class="exc-card">
                        <div class="exc-card-head">
                            <span class="exc-card-icon exc-card-icon-danger"><i class="ph ph-git-fork"></i></span>
                            <div class="exc-card-text">
                                <h2>Root causes</h2>
                                <p>@Clusters.Count distinct cause(s) behind @Items.Count exception(s) — fix the cause, clear the group</p>
                            </div>
                        </div>

                        <div class="exc-causes">
                            @foreach (var cluster in Clusters)
                            {
                                var isOpen = expandedClusters.Contains(cluster.Signature);
                                var isFocused = string.Equals(focusedCluster, cluster.Signature, StringComparison.OrdinalIgnoreCase);

                                <article class="exc-cause @FamilyClass(cluster.Family)">
                                    <div class="exc-cause-top">
                                        <span class="exc-cause-icon"><i class="@FamilyIcon(cluster.Family)"></i></span>
                                        <div class="exc-cause-heading">
                                            <span class="exc-cause-title">@cluster.Label</span>
                                            <div class="exc-cause-meta">
                                                <span><i class="ph ph-stack"></i>@string.Join(", ", cluster.Sources.Select(DescribeSource))</span>
                                                <span><i class="ph ph-clock"></i>first @FormatAge(cluster.FirstSeenUtc) ago, last @FormatAge(cluster.LastSeenUtc) ago</span>
                                                @foreach (var entry in cluster.Exposure)
                                                {
                                                    <span><i class="ph ph-coins"></i>@FormatExposure(entry)</span>
                                                }
                                            </div>
                                        </div>
                                        <div class="exc-cause-count @(cluster.BlockedCount > 0 ? "exc-cause-count-blocked" : null)">
                                            <strong>@cluster.Count</strong>
                                            <span>@(cluster.BlockedCount > 0 ? $"{cluster.BlockedCount} blocked" : "retrying")</span>
                                        </div>
                                    </div>

                                    <div class="exc-cause-guidance">
                                        <i class="ph ph-lightbulb"></i>
                                        <span>@cluster.Guidance</span>
                                    </div>

                                    <div class="exc-cause-foot">
                                        <button type="button" class="exc-btn exc-btn-sm exc-btn-ghost"
                                                @onclick="() => ToggleCluster(cluster.Signature)">
                                            <i class="ph @(isOpen ? "ph-caret-up" : "ph-caret-down")"></i>
                                            @(isOpen ? "Hide error" : "Show error")
                                        </button>
                                        <button type="button" class="exc-btn exc-btn-sm exc-btn-secondary"
                                                @onclick="() => FocusCluster(cluster.Signature)">
                                            <i class="ph @(isFocused ? "ph-funnel-x" : "ph-funnel")"></i>
                                            @(isFocused ? "Clear filter" : $"Filter queue ({cluster.Count})")
                                        </button>
                                        <span class="exc-cause-foot-spacer"></span>
                                        @if (cluster.RetryableCount > 0)
                                        {
                                            <button type="button" class="exc-btn exc-btn-sm exc-btn-primary"
                                                    disabled="@retryingClusters.Contains(cluster.Signature)"
                                                    @onclick="() => RetryClusterAsync(cluster)">
                                                @if (retryingClusters.Contains(cluster.Signature))
                                                {
                                                    <span class="exc-spin"></span>
                                                    <span>Requeueing…</span>
                                                }
                                                else
                                                {
                                                    <i class="ph ph-arrow-counter-clockwise"></i>
                                                    <span>Retry all @cluster.RetryableCount</span>
                                                }
                                            </button>
                                        }
                                        else
                                        {
                                            <span class="exc-badge exc-badge-quiet">Retry not available</span>
                                        }
                                    </div>

                                    @if (isOpen)
                                    {
                                        <pre class="exc-cause-error">@(string.IsNullOrWhiteSpace(cluster.SampleError) ? "No error text was recorded." : cluster.SampleError)</pre>
                                        @if (cluster.SampleReferences.Count > 0)
                                        {
                                            <div class="exc-cause-meta">
                                                <span><i class="ph ph-hash"></i>@string.Join(", ", cluster.SampleReferences)@(cluster.Count > cluster.SampleReferences.Count ? $" +{cluster.Count - cluster.SampleReferences.Count} more" : null)</span>
                                            </div>
                                        }
                                    }
                                </article>
                            }
                        </div>
                    </section>

                    <div>
                        <!-- ── Arrivals & aging ───────────────────────── -->
                        <section class="exc-card">
                            <div class="exc-card-head">
                                <span class="exc-card-icon"><i class="ph ph-chart-bar"></i></span>
                                <div class="exc-card-text">
                                    <h2>Arrivals</h2>
                                    <p>Failures per hour, last 24 hours</p>
                                </div>
                            </div>

                            <div class="exc-spark">
                                @foreach (var point in Trend)
                                {
                                    var isRecent = point.HourUtc >= DateTime.UtcNow.AddHours(-3);
                                    <div class="exc-spark-bar @(point.Count == 0 ? "exc-spark-bar-empty" : isRecent && point.Count > 0 ? "exc-spark-bar-hot" : null)"
                                         style="height:@(TrendBarHeight(point.Count))%"
                                         title="@FormatTime(point.HourUtc): @point.Count"></div>
                                }
                            </div>
                            <div class="exc-spark-axis">
                                <span>24h ago</span>
                                <span>@(TrendPeak == 0 ? "quiet" : $"peak {TrendPeak}/h")</span>
                                <span>now</span>
                            </div>

                            @{
                                var agingTotal = Triage.AgeUnder1hCount + Triage.Age1To24hCount + Triage.Age1To7dCount + Triage.AgeOver7dCount;
                            }
                            <div class="exc-aging">
                                <div class="exc-aging-seg" style="width:@AgingPercent(Triage.AgeUnder1hCount, agingTotal)%;background:var(--exc-calm)"></div>
                                <div class="exc-aging-seg" style="width:@AgingPercent(Triage.Age1To24hCount, agingTotal)%;background:var(--exc-accent)"></div>
                                <div class="exc-aging-seg" style="width:@AgingPercent(Triage.Age1To7dCount, agingTotal)%;background:var(--exc-warn)"></div>
                                <div class="exc-aging-seg" style="width:@AgingPercent(Triage.AgeOver7dCount, agingTotal)%;background:var(--exc-danger)"></div>
                            </div>
                            <div class="exc-aging-legend">
                                <div class="exc-aging-legend-row">
                                    <span class="exc-aging-dot" style="background:var(--exc-calm)"></span>
                                    <span>Under an hour old</span><strong>@Triage.AgeUnder1hCount</strong>
                                </div>
                                <div class="exc-aging-legend-row">
                                    <span class="exc-aging-dot" style="background:var(--exc-accent)"></span>
                                    <span>1 to 24 hours</span><strong>@Triage.Age1To24hCount</strong>
                                </div>
                                <div class="exc-aging-legend-row">
                                    <span class="exc-aging-dot" style="background:var(--exc-warn)"></span>
                                    <span>1 to 7 days</span><strong>@Triage.Age1To7dCount</strong>
                                </div>
                                <div class="exc-aging-legend-row">
                                    <span class="exc-aging-dot" style="background:var(--exc-danger)"></span>
                                    <span>Over a week</span><strong>@Triage.AgeOver7dCount</strong>
                                </div>
                            </div>
                        </section>

                        <!-- ── Exposure ───────────────────────────────── -->
                        @if (Exposure.Count > 0)
                        {
                            <section class="exc-card">
                                <div class="exc-card-head">
                                    <span class="exc-card-icon"><i class="ph ph-coins"></i></span>
                                    <div class="exc-card-text">
                                        <h2>Held up</h2>
                                        <p>What the failures are keeping out of SAP</p>
                                    </div>
                                </div>

                                <div class="exc-exposure">
                                    @foreach (var entry in Exposure)
                                    {
                                        <div class="exc-exposure-cell">
                                            <span>@entry.Label</span>
                                            <strong>@FormatExposure(entry)</strong>
                                            <em>@entry.ItemCount document(s)</em>
                                        </div>
                                    }
                                </div>
                            </section>
                        }

                        <!-- ── Pipelines ──────────────────────────────── -->
                        <section class="exc-card">
                            <div class="exc-card-head">
                                <span class="exc-card-icon"><i class="ph ph-flow-arrow"></i></span>
                                <div class="exc-card-text">
                                    <h2>Pipelines</h2>
                                    <p>Where the failures are concentrated</p>
                                </div>
                            </div>

                            <div class="exc-srcs">
                                @foreach (var source in Sources)
                                {
                                    <div class="exc-src">
                                        <div class="exc-src-body">
                                            <strong>@source.DisplayName</strong>
                                            <span>oldest @FormatAge(source.OldestOpenAtUtc) ago · last failed @FormatAge(source.LastFailureAtUtc) ago</span>
                                        </div>
                                        <div class="exc-src-counts">
                                            @if (source.BlockedCount > 0)
                                            {
                                                <span class="exc-badge exc-badge-blocked">@source.BlockedCount blocked</span>
                                            }
                                            @if (source.StalledCount > 0)
                                            {
                                                <span class="exc-badge exc-badge-stalled">@source.StalledCount stalled</span>
                                            }
                                            @if (source.RetryingCount > 0)
                                            {
                                                <span class="exc-badge exc-badge-retrying">@source.RetryingCount retrying</span>
                                            }
                                            <span class="exc-badge exc-badge-quiet">@source.TotalCount total</span>
                                        </div>
                                    </div>
                                }
                            </div>
                        </section>
                    </div>
                </div>

                <!-- ── Work queue ─────────────────────────────────────── -->
                <section class="exc-card">
                    <div class="exc-card-head">
                        <span class="exc-card-icon"><i class="ph ph-list-checks"></i></span>
                        <div class="exc-card-text">
                            <h2>Work queue</h2>
                            <p>
                                @FilteredItems.Count of @Items.Count shown
                                @if (dashboard?.ItemsTruncated == true)
                                {
                                    @($" · {dashboard.TotalItemCount} in total")
                                }
                            </p>
                        </div>
                        <div class="exc-card-aside">
                            <button type="button" class="exc-btn exc-btn-sm exc-btn-ghost" @onclick="ResetFilters">
                                <i class="ph ph-arrow-counter-clockwise"></i> Reset view
                            </button>
                        </div>
                    </div>

                    <div class="exc-filters">
                        <button type="button" class="exc-preset @(preset == PresetNeedsHuman ? "exc-preset-on" : null)"
                                @onclick="() => SetPreset(PresetNeedsHuman)">
                            Needs a human <span class="exc-preset-count">@PresetCount(PresetNeedsHuman)</span>
                        </button>
                        <button type="button" class="exc-preset @(preset == PresetStalled ? "exc-preset-on" : null)"
                                @onclick="() => SetPreset(PresetStalled)">
                            Stalled <span class="exc-preset-count">@PresetCount(PresetStalled)</span>
                        </button>
                        <button type="button" class="exc-preset @(preset == PresetRetrying ? "exc-preset-on" : null)"
                                @onclick="() => SetPreset(PresetRetrying)">
                            Self-healing <span class="exc-preset-count">@PresetCount(PresetRetrying)</span>
                        </button>
                        <button type="button" class="exc-preset @(preset == PresetMine ? "exc-preset-on" : null)"
                                @onclick="() => SetPreset(PresetMine)">
                            Mine <span class="exc-preset-count">@PresetCount(PresetMine)</span>
                        </button>
                        <button type="button" class="exc-preset @(preset == PresetUnassigned ? "exc-preset-on" : null)"
                                @onclick="() => SetPreset(PresetUnassigned)">
                            Unassigned <span class="exc-preset-count">@PresetCount(PresetUnassigned)</span>
                        </button>
                        <button type="button" class="exc-preset @(preset == PresetAll ? "exc-preset-on" : null)"
                                @onclick="() => SetPreset(PresetAll)">
                            Everything <span class="exc-preset-count">@PresetCount(PresetAll)</span>
                        </button>

                        <span class="exc-filter-spacer"></span>

                        <div class="exc-search">
                            <i class="ph ph-magnifying-glass"></i>
                            <input type="text" class="exc-input" @bind="searchText" @bind:event="oninput"
                                   placeholder="Reference, customer, error…" />
                        </div>
                        <NocturneSelect Options="SourceFilterOptions" @bind-Value="selectedSource"
                                        Caption="Filter by pipeline" AriaLabel="Filter by pipeline" />
                        <NocturneSelect Options="FamilyFilterOptions" @bind-Value="selectedFamily"
                                        Caption="Filter by cause type" AriaLabel="Filter by cause type" />
                        <NocturneSelect Options="SortSelectOptions" @bind-Value="sortOrder"
                                        Icon="ph ph-sort-ascending" Caption="Sort by" AriaLabel="Sort order" />
                    </div>

                    @if (!string.IsNullOrWhiteSpace(focusedCluster))
                    {
                        <div class="exc-alert exc-alert-info">
                            <i class="ph ph-funnel"></i>
                            <span>Showing one root cause only: <strong>@(Clusters.FirstOrDefault(c => c.Signature == focusedCluster)?.Label ?? focusedCluster)</strong></span>
                            <button type="button" class="exc-alert-close" @onclick="() => FocusCluster(null)">
                                <i class="ph ph-x"></i>
                            </button>
                        </div>
                    }

                    @if (FilteredItems.Count == 0)
                    {
                        <div class="exc-empty exc-empty-inline">
                            <i class="ph ph-funnel-x"></i>
                            <span>Nothing matches this view. Try “Everything”, or reset the view.</span>
                        </div>
                    }
                    else
                    {
                        <div class="exc-table-wrap">
                            <table class="exc-table">
                                <thead>
                                    <tr>
                                        <th>Document</th>
                                        <th>Root cause</th>
                                        <th>State</th>
                                        <th>Attempts</th>
                                        <th>Age</th>
                                        <th class="exc-right">Value</th>
                                        <th class="exc-right">Action</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var item in FilteredItems)
                                    {
                                        var key = GetItemKey(item);
                                        var isOpen = expandedRows.Contains(key);
                                        var occurred = item.OccurredAtUtc ?? item.CreatedAtUtc;

                                        <tr class="@(isOpen ? "exc-row-open" : null)">
                                            <td>
                                                <div class="exc-cell-main">
                                                    <span class="exc-ref">
                                                        <button type="button" class="exc-ref-open" @onclick="() => ToggleRow(item)"
                                                                title="@(isOpen ? "Hide detail" : "Show detail")">
                                                            <i class="ph @(isOpen ? "ph-caret-down" : "ph-caret-right")"></i>
                                                        </button>
                                                        @item.Reference
                                                    </span>
                                                    <span class="exc-sub">@item.Title</span>
                                                    @if (!string.IsNullOrWhiteSpace(item.Counterparty) || !string.IsNullOrWhiteSpace(item.Location))
                                                    {
                                                        <span class="exc-sub">
                                                            @string.Join(" · ", new[] { item.Counterparty, item.Location }.Where(part => !string.IsNullOrWhiteSpace(part)))
                                                        </span>
                                                    }
                                                    @if (!string.IsNullOrWhiteSpace(item.AssignedToUsername))
                                                    {
                                                        <span class="exc-owner"><i class="ph ph-user-focus"></i>@item.AssignedToUsername</span>
                                                    }
                                                </div>
                                            </td>
                                            <td>
                                                <button type="button" class="exc-cause-link @FamilyClass(item.Family)"
                                                        @onclick="() => FocusCluster(item.ClusterSignature)"
                                                        title="Filter the queue to this cause">
                                                    <i class="@FamilyIcon(item.Family)"></i>
                                                    <span>@item.RootCause</span>
                                                </button>
                                            </td>
                                            <td>
                                                <span class="exc-badge @TriageBadgeClass(item.Triage)">
                                                    <i class="@TriageIcon(item.Triage)"></i>@TriageLabel(item.Triage)
                                                </span>
                                                @if (item.IsAcknowledged)
                                                {
                                                    <div class="exc-sub" title="@FormatDateTime(item.AcknowledgedAtUtc)">
                                                        seen by @item.AcknowledgedByUsername
                                                    </div>
                                                }
                                            </td>
                                            <td>
                                                @if (item.MaxRetries > 0)
                                                {
                                                    var exhausted = item.RetryCount >= item.MaxRetries;
                                                    <div class="exc-attempts">
                                                        <span class="exc-attempts-pips">
                                                            @for (var pip = 0; pip < item.MaxRetries; pip++)
                                                            {
                                                                <span class="exc-pip @(pip < item.RetryCount ? (exhausted ? "exc-pip-out" : "exc-pip-used") : null)"></span>
                                                            }
                                                        </span>
                                                        <span class="exc-attempts-text">@item.RetryCount/@item.MaxRetries</span>
                                                    </div>
                                                    @if (item.NextRetryAtUtc.HasValue && !exhausted)
                                                    {
                                                        <div class="exc-sub @(item.IsRetryOverdue ? "exc-age-stale" : null)">
                                                            @(item.IsRetryOverdue ? "overdue" : FormatCountdown(item.NextRetryAtUtc))
                                                        </div>
                                                    }
                                                }
                                                else
                                                {
                                                    <span class="exc-attempts-text">no auto retry</span>
                                                }
                                            </td>
                                            <td>
                                                <span class="exc-age @AgeClass(occurred)">@FormatAge(occurred)</span>
                                                <div class="exc-sub">@FormatDateTime(occurred)</div>
                                            </td>
                                            <td class="exc-right">
                                                @if (item.Amount.HasValue && item.Amount.Value != 0)
                                                {
                                                    <span class="exc-money">@FormatMoney(item.Amount.Value, item.Currency)</span>
                                                }
                                                else if (item.LineCount.HasValue && item.LineCount.Value > 0)
                                                {
                                                    <span class="exc-money">@item.LineCount line(s)</span>
                                                }
                                                else
                                                {
                                                    <span class="exc-sub">—</span>
                                                }
                                            </td>
                                            <td class="exc-right">
                                                <div class="exc-actions">
                                                    @if (!item.IsAcknowledged)
                                                    {
                                                        <button type="button" class="exc-btn exc-btn-sm exc-btn-secondary"
                                                                disabled="@acknowledgingKeys.Contains(key)"
                                                                @onclick="() => AcknowledgeItemAsync(item)">
                                                            @(acknowledgingKeys.Contains(key) ? "Saving…" : "Ack")
                                                        </button>
                                                    }
                                                    @if (CanAssignToCurrentUser(item))
                                                    {
                                                        <button type="button" class="exc-btn exc-btn-sm exc-btn-secondary"
                                                                disabled="@assigningKeys.Contains(key)"
                                                                @onclick="() => AssignItemAsync(item)">
                                                            @(assigningKeys.Contains(key)
                                                                ? "Assigning…"
                                                                : string.IsNullOrWhiteSpace(item.AssignedToUsername) ? "Take" : "Take over")
                                                        </button>
                                                    }
                                                    @if (item.CanRetry)
                                                    {
                                                        <button type="button" class="exc-btn exc-btn-sm exc-btn-primary"
                                                                disabled="@retryingKeys.Contains(key)"
                                                                @onclick="() => RetryItemAsync(item)">
                                                            @(retryingKeys.Contains(key) ? "Retrying…" : "Retry")
                                                        </button>
                                                    }
                                                </div>
                                            </td>
                                        </tr>

                                        @if (isOpen)
                                        {
                                            <tr class="exc-detail">
                                                <td colspan="7">
                                                    <div class="exc-detail-grid">
                                                        <div class="exc-detail-field">
                                                            <span>Pipeline</span>
                                                            <strong>@DescribeSource(item.Source)</strong>
                                                        </div>
                                                        <div class="exc-detail-field">
                                                            <span>Raw status</span>
                                                            <strong>@item.Status</strong>
                                                        </div>
                                                        <div class="exc-detail-field">
                                                            <span>First queued</span>
                                                            <strong>@FormatDateTime(item.CreatedAtUtc)</strong>
                                                        </div>
                                                        @if (item.ProcessingStartedAtUtc.HasValue)
                                                        {
                                                            <div class="exc-detail-field">
                                                                <span>Picked up</span>
                                                                <strong>@FormatDateTime(item.ProcessingStartedAtUtc)</strong>
                                                            </div>
                                                        }
                                                        @if (item.NextRetryAtUtc.HasValue)
                                                        {
                                                            <div class="exc-detail-field">
                                                                <span>Next retry</span>
                                                                <strong>@FormatDateTime(item.NextRetryAtUtc)</strong>
                                                            </div>
                                                        }
                                                        @if (!string.IsNullOrWhiteSpace(item.CreatedBy))
                                                        {
                                                            <div class="exc-detail-field">
                                                                <span>Raised by</span>
                                                                <strong>@item.CreatedBy</strong>
                                                            </div>
                                                        }
                                                        @if (!string.IsNullOrWhiteSpace(item.SourceSystem) || !string.IsNullOrWhiteSpace(item.Provider))
                                                        {
                                                            <div class="exc-detail-field">
                                                                <span>Origin</span>
                                                                <strong>@(item.SourceSystem ?? item.Provider)</strong>
                                                            </div>
                                                        }
                                                        @if (item.AssignedAtUtc.HasValue)
                                                        {
                                                            <div class="exc-detail-field">
                                                                <span>Assigned</span>
                                                                <strong>@FormatDateTime(item.AssignedAtUtc)</strong>
                                                            </div>
                                                        }
                                                    </div>
                                                    <pre class="exc-cause-error">@(string.IsNullOrWhiteSpace(item.LastError) ? "No error text was recorded for this item." : item.LastError)</pre>
                                                </td>
                                            </tr>
                                        }
                                    }
                                </tbody>
                            </table>
                        </div>
                    }

                    <div class="exc-footnote">
                        <i class="ph ph-info"></i>
                        <span>
                            “Needs a human” means the item is awaiting review, has used every retry attempt,
                            or has no automatic retry at all. Times are CAT.
                        </span>
                    </div>
                </section>
            }
        </div>
    }
</div>
