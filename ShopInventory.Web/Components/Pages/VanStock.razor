@page "/van-sales/reports/stock"
@* Admin and Manager only — see VanSalesActivity.razor. *@
@attribute [Authorize(Roles = "Admin,Manager")]
@rendermode InteractiveServer
@using System.Globalization
@using ShopInventory.Web.Models
@inject IVanSalesReportService VanSalesReportService
@inject IReportExportService ExportService
@inject IJSRuntime JS

<PageTitle>Van Stock - Shop Inventory</PageTitle>

@* Does every van's stock in SAP move only by documents we can name, and did every sale a van
   made reach SAP before the next morning's count?

   Carried by wwwroot/css/van-sales.css: the shared `vs-` chrome plus `vst-`.

   The morning count is SAP's own book stock for the van, read at about 07:00. SAP's stock moves
   only when a document is posted, so the page explains each morning with the SAP documents created
   since the count before it — by when SAP created them, not the date printed on them. An earlier
   version explained it with the app's own sales by trading day, so every sale that reached SAP a
   day or four late read as stock missing one morning and found the next.

   Two questions, kept apart because they need different people:
   - Stock: does each morning tie to SAP's invoices, credit notes and transfers? What is left was
     moved by a posting the report does not read — a breakage, a receipt, a count.
   - Sales: did each trading day's sales reach SAP before the next count, late, or not at all?

   Everything is judged in counts of items, never in summed quantities. A van carries cases,
   kilograms and singles, and a total across them is a figure in no unit. Quantities appear only
   item by item, each in that item's own unit.

   These are book figures. A van that is physically short shows only once someone counts it and
   posts the difference in SAP; the page says so rather than implying otherwise. *@

<div class="vs vst">

    <div class="vs-head">
        <div>
            <h2 class="vs-title">Van stock</h2>
            <p class="vs-subtitle vst-question">
                Does every van's stock in SAP move only by documents we can name, and did every sale a van
                made reach SAP before the next morning's count?
            </p>
        </div>
        <div class="vs-actions">
            @if (report?.Summary.LatestSnapshotDate is { } latest)
            {
                <span class="vst-fresh @(report.Summary.IsStale ? "vst-fresh-stale" : null)">
                    <span class="vst-fresh-dot"></span>
                    @FreshnessLabel(latest, report.Summary.LatestCountAt, report.Summary.SnapshotAgeDays)
                </span>
            }
            <button class="vs-btn" @onclick="ExportAsync" disabled="@(isLoading || report is null)">
                Export to Excel
            </button>
        </div>
    </div>

    <div class="vs-filters">
        <div class="row g-3">
            <div class="col-md-3">
                <label class="vs-filter-label" for="vst-from">From</label>
                <NocturneDateField Id="vst-from" @bind-Date="fromDate" AriaLabel="From date" />
            </div>
            <div class="col-md-3">
                <label class="vs-filter-label" for="vst-to">To</label>
                <NocturneDateField Id="vst-to" @bind-Date="toDate" AriaLabel="To date" />
            </div>
            <div class="col-md-3">
                <label class="vs-filter-label" for="vst-dead">Call an item idle after</label>
                <NocturneSelect Id="vst-dead" Class="nsel-block" TValue="string"
                                Options="DeadStockOptions" @bind-Value="selectedDeadStockDays"
                                OnChanged="LoadAsync"
                                AriaLabel="Days carried without a sale before an item counts as idle" />
            </div>
            <div class="col-md-3 vs-actions">
                <button class="vs-btn vs-btn-accent" @onclick="LoadAsync" disabled="@isLoading">
                    @(isLoading ? "Loading…" : "Run")
                </button>
            </div>
        </div>
    </div>

    @if (loadError is not null)
    {
        <div class="vs-notice">@loadError</div>
    }

    @if (isLoading)
    {
        <div class="vs-loading">
            <MudProgressCircular Indeterminate="true" Size="Size.Small" />
            <span>Reading the morning counts and SAP's documents…</span>
        </div>
    }
    else if (report is null)
    {
        <div class="vs-empty">
            <div class="vs-empty-title">Nothing loaded yet</div>
            <div>Choose a period and run the report.</div>
        </div>
    }
    else
    {
        var summary = report.Summary;

        @* Ahead of every figure, because it governs all of them. *@
        @if (summary.IsStale)
        {
            <div class="vst-stale">
                <strong>These figures are @summary.SnapshotAgeDays day(s) old.</strong>
                The newest stock count is from
                @(summary.LatestSnapshotDate?.ToString("dddd dd MMM yyyy") ?? "an unknown date"),
                so everything below describes the vans as they stood then. If the count job has
                stopped, nothing on this page will improve until it runs again.
            </div>
        }

        @if (!summary.SapChecked)
        {
            <div class="vst-stale">
                <strong>SAP's documents could not be read.</strong>
                @(report.Quality.SapProblem ?? "The report did not reach SAP.")
                The counts and sales below are real, but nothing says whether a morning ties to SAP or
                whether a day's sales reached it.
            </div>
        }

        var selected = selectedVan is null
            ? null
            : vanViews.FirstOrDefault(v => string.Equals(v.Code, selectedVan, StringComparison.OrdinalIgnoreCase));

        @if (selected is null)
        {
            @* ── The fleet ─────────────────────────────────────────────────── *@

            <div class="vst-rules">
                <div class="vst-rule">
                    <span class="vst-rule-label">Each morning, in SAP</span>
                    <span class="vst-rule-term">Yesterday's SAP count</span><span class="vst-mute">−</span>
                    <span class="vst-rule-term">Invoiced</span><span class="vst-mute">+</span>
                    <span class="vst-rule-term">Credit notes</span><span class="vst-mute">±</span>
                    <span class="vst-rule-term">Transfers</span><span class="vst-mute">±</span>
                    <span class="vst-rule-term">Other SAP postings</span><span class="vst-mute">=</span>
                    <span class="vst-rule-term vst-rule-result">This morning's SAP count</span>
                </div>
                <div class="vst-rule">
                    <span class="vst-rule-label">Each trading day</span>
                    <span class="vst-rule-term">Sales the van recorded</span><span class="vst-mute">→</span>
                    <span class="vst-rule-term">Invoiced in SAP before the next count?</span>
                    <span class="vst-mute">Documents are placed by when SAP created them, not by the date printed on them.</span>
                </div>
            </div>

            <div class="vst-answers">
                @{
                    var checkedMornings = report.Mornings.Count(m => m.SapChecked);
                    var tied = report.Mornings.Count(m => m.TiesToSap);
                    var otherVans = vanViews.Count(v => v.Stats?.MorningsWithOtherPostings > 0);
                }
                @if (!summary.SapChecked)
                {
                    <div class="vst-answer vst-answer-warn">
                        <div class="vst-answer-kicker">SAP book</div>
                        <div class="vst-answer-value">SAP not read</div>
                        <div class="vst-answer-text">The counts are here, but without SAP's documents no morning can be explained.</div>
                    </div>
                }
                else if (checkedMornings == 0)
                {
                    <div class="vst-answer">
                        <div class="vst-answer-kicker">SAP book</div>
                        <div class="vst-answer-value">Not enough counts</div>
                        <div class="vst-answer-text">Two complete counts of a van are needed before a morning can be explained.</div>
                    </div>
                }
                else if (tied == checkedMornings)
                {
                    <div class="vst-answer vst-answer-good">
                        <div class="vst-answer-kicker">SAP book</div>
                        <div class="vst-answer-value">Every morning ties</div>
                        <div class="vst-answer-text">@Plural(checkedMornings, "morning") across @Plural(vanViews.Count, "van") are explained by SAP invoices, credit notes and transfers.</div>
                    </div>
                }
                else
                {
                    <div class="vst-answer vst-answer-info">
                        <div class="vst-answer-kicker">SAP book</div>
                        <div class="vst-answer-value">@tied.ToString("N0") of @Plural(checkedMornings, "morning")</div>
                        <div class="vst-answer-text">
                            tie out to invoices, credit notes and transfers. The other @(checkedMornings - tied) moved by postings
                            those don't name — breakages, receipts or counts — on @Plural(otherVans, "van").
                        </div>
                    </div>
                }

                @{
                    var lateDays = report.SalesDays.Where(d => d.Status == "Late").ToList();
                    var worstLate = lateDays.OrderByDescending(d => d.DaysLate).ThenBy(d => d.TradingDate).FirstOrDefault();
                }
                @if (!summary.SapChecked)
                {
                    <div class="vst-answer">
                        <div class="vst-answer-kicker">Sales reaching SAP</div>
                        <div class="vst-answer-value">Unchecked</div>
                        <div class="vst-answer-text">SAP's invoices were not read.</div>
                    </div>
                }
                else if (worstLate is null)
                {
                    <div class="vst-answer vst-answer-good">
                        <div class="vst-answer-kicker">Sales reaching SAP</div>
                        <div class="vst-answer-value">On time</div>
                        <div class="vst-answer-text">Every day that reached SAP did so before the next morning's count.</div>
                    </div>
                }
                else
                {
                    <div class="vst-answer vst-answer-warn">
                        <div class="vst-answer-kicker">Sales reaching SAP late</div>
                        <div class="vst-answer-value">@Plural(lateDays.Count, "van-day")</div>
                        <div class="vst-answer-text">
                            were invoiced after the next morning's count. Worst: @worstLate.VanWarehouseCode's
                            @worstLate.TradingDate.ToString("ddd dd MMM") sales, @Plural(worstLate.DaysLate ?? 1, "day") late.
                        </div>
                    </div>
                }

                @{
                    var missingDays = report.SalesDays.Where(d => d.Status == "NotInSap").ToList();
                    var sapOnlyDays = report.SalesDays.Count(d => d.Status == "SapOnly");
                }
                @if (!summary.SapChecked)
                {
                    <div class="vst-answer">
                        <div class="vst-answer-kicker">Not in SAP</div>
                        <div class="vst-answer-value">Unchecked</div>
                        <div class="vst-answer-text">SAP's invoices were not read.</div>
                    </div>
                }
                else if (missingDays.Count == 0)
                {
                    <div class="vst-answer vst-answer-good">
                        <div class="vst-answer-kicker">Not in SAP</div>
                        <div class="vst-answer-value">Nothing missing</div>
                        <div class="vst-answer-text">
                            Every sale a van recorded has a SAP invoice.
                            @if (sapOnlyDays > 0)
                            {
                                @($"{Plural(sapOnlyDays, "van-day")} carry SAP invoices the app never recorded.")
                            }
                        </div>
                    </div>
                }
                else
                {
                    <div class="vst-answer vst-answer-bad">
                        <div class="vst-answer-kicker">Not in SAP</div>
                        <div class="vst-answer-value">@Plural(missingDays.Count, "van-day")</div>
                        <div class="vst-answer-text">
                            of recorded sales have no SAP invoice yet, on @Plural(missingDays.Select(d => d.VanWarehouseCode).Distinct().Count(), "van").
                            SAP overstates their stock until they post.
                        </div>
                    </div>
                }

                <div class="vst-answer">
                    <div class="vst-answer-kicker">Riding without selling</div>
                    @if (summary.DeadItemCount == 0)
                    {
                        <div class="vst-answer-value">Nothing idle</div>
                        <div class="vst-answer-text">No item was carried @report.DeadStockDays+ days without selling.</div>
                    }
                    else
                    {
                        <div class="vst-answer-value">@Plural(summary.DeadItemCount, "item")</div>
                        <div class="vst-answer-text">were carried @report.DeadStockDays+ days and never sold. Candidates to take off the load list.</div>
                    }
                </div>
            </div>

            <div class="vst-caveats">
                <div class="vst-caveats-head">What SAP cannot tell us</div>
                <ul class="vst-caveats-list">
                    <li>
                        These are book figures. A van that is physically short shows up here only once someone counts it
                        and posts the difference in SAP.
                    </li>
                    @foreach (var caveat in report.Quality.Caveats)
                    {
                        <li>@caveat</li>
                    }
                </ul>
            </div>

            <div class="vst-section-head">
                <div>
                    <h3 class="vst-heading">Van by van</h3>
                    <p class="vst-note">One square per morning. Open a van for its SAP documents, morning by morning.</p>
                </div>
                <div class="vst-legend">
                    <span><i class="vst-sq vst-sq-ok"></i>Ties to SAP</span>
                    <span><i class="vst-sq vst-sq-late"></i>Sales posted late</span>
                    <span><i class="vst-sq vst-sq-miss"></i>Sales not in SAP</span>
                    <span><i class="vst-sq vst-sq-other"></i>Other SAP posting</span>
                    <span><i class="vst-sq vst-sq-gap"></i>Not counted</span>
                </div>
            </div>

            <div class="vst-vans">
                <div class="vst-vans-head" aria-hidden="true">
                    <div>Van</div>
                    <div>@report.FromDate.AddDays(1).ToString("dd MMM") → @report.ToDate.ToString("dd MMM")</div>
                    <div>Ties to SAP</div>
                    <div>Sales late</div>
                    <div>Not in SAP</div>
                    <div>Other postings</div>
                    <div>What to do</div>
                    <div></div>
                </div>
                @foreach (var van in vanViews)
                {
                    <button type="button" class="vst-van" @onclick="() => OpenVan(van.Code)"
                            aria-label="Open @van.Code">
                        <div class="vst-van-id">
                            <span class="vst-van-code">@van.Code</span>
                            <span class="vst-pill vst-pill-@van.Tone">@van.Status</span>
                        </div>
                        <div class="vst-strip">
                            @foreach (var morning in van.Strip)
                            {
                                <i class="vst-sq vst-sq-@morning.Kind" title="@morning.Tip"></i>
                            }
                        </div>
                        <div>
                            @if (van.Stats is { MorningsChecked: > 0 } tiesStats)
                            {
                                <strong>@tiesStats.MorningsTied</strong><span class="vst-mute"> of @tiesStats.MorningsChecked</span>
                            }
                            else
                            {
                                <span class="vst-mute">—</span>
                            }
                        </div>
                        <div class="vst-stack">
                            @if (van.Stats is { SalesDaysLate: > 0 } lateStats)
                            {
                                <span>@Plural(lateStats.SalesDaysLate, "day")</span>
                                <span class="vst-mute vst-small">up to @Plural(lateStats.MaxDaysLate ?? 1, "day") behind</span>
                            }
                            else
                            {
                                <span class="vst-mute">—</span>
                            }
                        </div>
                        <div class="vst-stack">
                            @if (van.Stats is { SalesDaysNotInSap: > 0 } missStats)
                            {
                                <span class="vst-bad">@Plural(missStats.SalesDaysNotInSap, "day")</span>
                            }
                            else
                            {
                                <span class="vst-mute">—</span>
                            }
                        </div>
                        <div class="vst-stack">
                            @if (van.Stats is { MorningsWithOtherPostings: > 0 } otherStats)
                            {
                                <span class="vst-info-ink">@Plural(otherStats.MorningsWithOtherPostings, "morning")</span>
                            }
                            else
                            {
                                <span class="vst-mute">—</span>
                            }
                        </div>
                        <div class="vst-action">@van.Action</div>
                        <svg class="vst-chev" width="18" height="18" viewBox="0 0 18 18" fill="none" aria-hidden="true">
                            <path d="M7 4l5 5-5 5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" />
                        </svg>
                    </button>
                }
                <div class="vst-vans-foot">
                    Counted in items, not units. A van carries cases, kilograms and singles, so a morning is judged by
                    how many items SAP moved without a document this report can name, and units appear item by item.
                </div>
            </div>

            <div class="vst-pair">
                <section class="vst-panel">
                    @{
                        var idle = report.Items
                            .Where(i => i.IsDead && i.DaysOnVanWithoutSelling >= report.DeadStockDays)
                            .ToList();
                    }
                    <div class="vst-panel-head">
                        <h3 class="vst-heading">Carried, never sold</h3>
                        @if (idle.Count > IdlePreview)
                        {
                            <button type="button" class="vst-link" @onclick="() => showAllIdle = !showAllIdle">
                                @(showAllIdle ? "Show fewer" : $"All {idle.Count} items")
                            </button>
                        }
                    </div>
                    <p class="vst-note">Longest ride first. Each one is van space that could carry something that moves.</p>
                    @if (idle.Count == 0)
                    {
                        <div class="vst-quiet">Every item carried @report.DeadStockDays+ days sold at least once.</div>
                    }
                    else
                    {
                        <table class="vst-table">
                            <thead>
                                <tr><th>Item</th><th class="vs-num">On vans</th><th class="vs-num">Days carried</th></tr>
                            </thead>
                            <tbody>
                                @foreach (var item in showAllIdle ? idle : idle.Take(IdlePreview))
                                {
                                    <tr>
                                        <td>@item.DisplayName<span class="vst-sub">@item.ItemCode</span></td>
                                        <td class="vs-num">@item.VanCount.ToString("N0")</td>
                                        <td class="vs-num">@item.DaysOnVan.ToString("N0")</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    }
                </section>

                <section class="vst-panel">
                    <div class="vst-panel-head">
                        <h3 class="vst-heading">Close to expiry</h3>
                    </div>
                    <p class="vst-note">Batches on each van at its latest SAP count, soonest first.</p>
                    @if (report.Expiring.Count == 0)
                    {
                        <div class="vst-quiet">
                            <strong>Nothing to move</strong>
                            No batch on any van expires within 60 days.
                        </div>
                    }
                    else
                    {
                        <table class="vst-table">
                            <thead>
                                <tr><th>Van</th><th>Item</th><th>Batch</th><th class="vs-num">Days left</th><th class="vs-num">Quantity</th></tr>
                            </thead>
                            <tbody>
                                @foreach (var batch in report.Expiring)
                                {
                                    <tr class="@(batch.HasExpired ? "vst-expired" : null)">
                                        <td>@batch.VanWarehouseCode</td>
                                        <td>@batch.DisplayName<span class="vst-sub">@batch.ItemCode</span></td>
                                        <td>@batch.BatchNumber<span class="vst-sub">@batch.ExpiryDate.ToString("dd MMM yyyy")</span></td>
                                        <td class="vs-num @(batch.HasExpired ? "vst-bad" : null)">
                                            @(batch.HasExpired ? $"{-batch.DaysToExpiry:N0} past" : batch.DaysToExpiry.ToString("N0"))
                                        </td>
                                        <td class="vs-num">@batch.Quantity.ToString("N0")</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    }
                </section>
            </div>
        }
        else
        {
            @* ── One van ───────────────────────────────────────────────────── *@

            <button type="button" class="vst-back" @onclick="CloseVan">
                <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
                    <path d="M10 3.5L5.5 8l4.5 4.5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" />
                </svg>
                All vans
            </button>

            <div class="vst-verdict">
                <div class="vst-verdict-title">
                    <h3>@selected.Code</h3>
                    <span class="vst-pill vst-pill-@selected.Tone">@selected.Status</span>
                    <span class="vst-mute">
                        @if (selected.Stats is { AccountCodes.Count: > 0 } accounts)
                        {
                            @($"invoices to {string.Join(", ", accounts.AccountCodes)} · ")
                        }
                        @report.FromDate.ToString("dd MMM") – @report.ToDate.ToString("dd MMM")
                        @if (selected.Stats is { ItemCount: > 0 } stats)
                        {
                            @($" · {stats.ItemCount:N0} items carried")
                        }
                    </span>
                </div>
                <p class="vst-verdict-text">@selected.Action</p>
            </div>

            <div class="vst-figures">
                <div class="vst-figure">
                    <div class="vst-figure-label">Mornings that tie to SAP</div>
                    <div class="vst-figure-value">
                        @if (selected.Stats is { MorningsChecked: > 0 } tieStats)
                        {
                            @tieStats.MorningsTied<span class="vst-mute"> of @tieStats.MorningsChecked</span>
                        }
                        else
                        {
                            <span class="vst-mute">—</span>
                        }
                    </div>
                    <div class="vst-figure-sub">explained by invoices, credit notes and transfers</div>
                </div>
                <div class="vst-figure">
                    <div class="vst-figure-label">Trading days posted late</div>
                    @{ var vanWorstLate = selected.Sales.Where(d => d.Status == "Late").OrderByDescending(d => d.DaysLate).FirstOrDefault(); }
                    <div class="vst-figure-value @(vanWorstLate is not null ? "vst-warn-ink" : null)">
                        @(selected.Stats?.SalesDaysLate.ToString("N0") ?? "—")
                    </div>
                    @if (vanWorstLate is not null)
                    {
                        <div class="vst-figure-sub">worst: @vanWorstLate.TradingDate.ToString("ddd dd MMM"), @Plural(vanWorstLate.DaysLate ?? 1, "day") behind</div>
                    }
                </div>
                <div class="vst-figure">
                    <div class="vst-figure-label">Sales not in SAP</div>
                    @if (selected.Stats is { SalesDaysNotInSap: > 0 } missStats)
                    {
                        <div class="vst-figure-value vst-bad">@Plural(missStats.SalesDaysNotInSap, "day")</div>
                        <div class="vst-figure-sub">recorded by the van, no SAP invoice</div>
                    }
                    else
                    {
                        <div class="vst-figure-value vst-good-ink">None</div>
                        <div class="vst-figure-sub">everything recorded is invoiced</div>
                    }
                </div>
                <div class="vst-figure">
                    <div class="vst-figure-label">Other SAP postings</div>
                    @if (selected.Stats is { MorningsWithOtherPostings: > 0 } otherStats)
                    {
                        <div class="vst-figure-value vst-info-ink">@Plural(otherStats.MorningsWithOtherPostings, "morning")</div>
                        <div class="vst-figure-sub">breakages, receipts or counts</div>
                    }
                    else
                    {
                        <div class="vst-figure-value vst-mute">None</div>
                        <div class="vst-figure-sub">only invoices, credit notes and transfers</div>
                    }
                </div>
            </div>

            <div class="vst-section-head">
                <h3 class="vst-heading">Morning by morning</h3>
                <p class="vst-note">What SAP posted between one count and the next. Open a morning for its documents.</p>
            </div>

            @if (selected.Mornings.Count == 0)
            {
                <div class="vs-empty">
                    <div class="vs-empty-title">Nothing to compare</div>
                    <div>Two complete counts of this van are needed to explain a morning.</div>
                </div>
            }
            else
            {
                var opened = OpenedMorning(selected);

                <div class="vst-ledger">
                    <div class="vst-ledger-head" aria-hidden="true">
                        <div>Morning</div>
                        <div>Invoiced</div>
                        <div>Credit notes</div>
                        <div>Transfers</div>
                        <div>Unexplained</div>
                        <div>Ties?</div>
                        <div>Van's sales the day before</div>
                    </div>
                    @foreach (var morning in selected.Mornings)
                    {
                        var isOpen = ReferenceEquals(morning, opened);
                        var dayBefore = selected.Sales.FirstOrDefault(d => d.TradingDate == morning.ToSnapshot.AddDays(-1));

                        <button type="button"
                                class="vst-morning @(isOpen ? "vst-morning-open" : null)"
                                @onclick="() => openedMorning = morning.ToSnapshot">
                            <div class="vst-morning-date">
                                @morning.ToSnapshot.ToString("ddd dd MMM")
                                @if (morning.HasGap)
                                {
                                    <span class="vst-sub">since @morning.FromSnapshot.ToString("dd MMM"), @Plural(morning.GapDays - 1, "day") not counted</span>
                                }
                            </div>
                            <div>@DocumentCell(morning, "Invoice")</div>
                            <div>@DocumentCell(morning, "CreditNote")</div>
                            <div>@TransferCell(morning)</div>
                            <div class="@(morning.ItemsUnexplained > 0 ? "vst-info-ink" : "vst-mute")">
                                @(morning.SapChecked ? Plural(morning.ItemsUnexplained, "item") : "—")
                            </div>
                            <div>
                                @if (!morning.SapChecked)
                                {
                                    <span class="vst-mute">Unchecked</span>
                                }
                                else if (morning.TiesToSap)
                                {
                                    <span class="vst-good-ink">Yes</span>
                                }
                                else
                                {
                                    <span class="vst-info-ink">Other postings</span>
                                }
                            </div>
                            <div class="vst-stack">
                                @if (dayBefore is null)
                                {
                                    <span class="vst-mute">no sales</span>
                                }
                                else
                                {
                                    <span class="@SalesTone(dayBefore.Status)">@SalesVerdict(dayBefore)</span>
                                }
                            </div>
                        </button>
                    }
                </div>

                @if (opened is not null)
                {
                    <section class="vst-opened @(opened.TiesToSap ? "vst-opened-ok" : "vst-opened-over")">
                        <div class="vst-panel-head">
                            <div>
                                <h3 class="vst-heading">@opened.ToSnapshot.ToString("ddd dd MMM"): what SAP posted since the count before</h3>
                                <p class="vst-note">
                                    @opened.CountedFrom.ToString("ddd dd MMM HH:mm") → @opened.CountedTo.ToString("ddd dd MMM HH:mm").
                                    Printed date and creation time side by side, so a backdated document stands out.
                                </p>
                            </div>
                        </div>

                        @if (opened.Documents.Count == 0)
                        {
                            <div class="vst-quiet">
                                <strong>No SAP document</strong>
                                Nothing was invoiced, credited or transferred on this van between the two counts.
                            </div>
                        }
                        else
                        {
                            <table class="vst-table">
                                <thead>
                                    <tr>
                                        <th>Document</th>
                                        <th>Dated</th>
                                        <th>Created in SAP</th>
                                        <th class="vs-num">Items</th>
                                        <th>Remarks</th>
                                        <th>Reading</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var document in opened.Documents)
                                    {
                                        <tr>
                                            <td>@KindLabel(document.Kind) @document.DocNum</td>
                                            <td>@document.DocDate.ToString("ddd dd MMM")</td>
                                            <td>@(document.CreatedTimeKnown ? document.CreatedAt.ToString("ddd dd MMM HH:mm") : document.CreatedAt.ToString("ddd dd MMM") + " (no time)")</td>
                                            <td class="vs-num">@document.ItemCount.ToString("N0")</td>
                                            <td class="vst-mute-cell">@(document.Comments ?? "—")</td>
                                            <td class="@(document.DaysBackdated > 0 ? "vst-warn-ink" : "vst-good-ink")">
                                                @(document.DaysBackdated > 0 ? $"Posted {Plural(document.DaysBackdated, "day")} after its date" : "Same day")
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        }

                        @if (opened.Unexplained.Count > 0)
                        {
                            <h4 class="vst-subheading">Not explained by these documents</h4>
                            <p class="vst-note">
                                Each item in its own stock unit. SAP moved these by a posting this report does not read — a
                                goods issue such as a breakage, a goods receipt, or a stock count. Confirm each was physical.
                                @if (opened.ItemsUnexplained > opened.Unexplained.Count)
                                {
                                    @($" The {opened.Unexplained.Count} largest of {opened.ItemsUnexplained}.")
                                }
                            </p>
                            <table class="vst-table">
                                <thead>
                                    <tr>
                                        <th>Item</th>
                                        <th class="vs-num">@opened.FromSnapshot.ToString("dd MMM") count</th>
                                        <th class="vs-num">Invoiced</th>
                                        <th class="vs-num">Credited</th>
                                        <th class="vs-num">Transfers</th>
                                        <th class="vs-num">Documents say</th>
                                        <th class="vs-num">Counted</th>
                                        <th class="vs-num">Other postings</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var line in opened.Unexplained)
                                    {
                                        <tr>
                                            <td>@line.DisplayName<span class="vst-sub">@line.ItemCode</span></td>
                                            <td class="vs-num">@Qty(line.Opening)</td>
                                            <td class="vs-num">@Qty(line.Invoiced)</td>
                                            <td class="vs-num">@Qty(line.Credited)</td>
                                            <td class="vs-num">@Signed0(line.TransferredIn - line.TransferredOut)</td>
                                            <td class="vs-num vst-accent-ink">@Qty(line.Expected)</td>
                                            <td class="vs-num">@Qty(line.Closing)</td>
                                            <td class="vs-num vst-info-ink"><strong>@Signed(line.Unexplained)</strong></td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        }
                    </section>
                }
            }

            <div class="vst-section-head">
                <div>
                    <h3 class="vst-heading">Did each day's sales reach SAP?</h3>
                    <p class="vst-note">What the van recorded against the SAP invoices dated that day, and when SAP had them.</p>
                </div>
            </div>

            @if (selected.Sales.Count == 0)
            {
                <div class="vs-empty">
                    <div class="vs-empty-title">No sales</div>
                    <div>The van recorded no sale and SAP holds no invoice from it in this period.</div>
                </div>
            }
            else
            {
                <section class="vst-panel">
                    <table class="vst-table">
                        <thead>
                            <tr>
                                <th>Trading day</th>
                                <th class="vs-num">Items the van recorded</th>
                                <th class="vs-num">Items invoiced</th>
                                <th class="vs-num">Invoices</th>
                                <th>First invoice created</th>
                                <th>Last invoice created</th>
                                <th>Verdict</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var day in selected.Sales)
                            {
                                var isOpen = openedSalesDay == day.TradingDate;

                                <tr>
                                    <td>@day.TradingDate.ToString("ddd dd MMM")</td>
                                    <td class="vs-num">@day.RecordedItems.ToString("N0")</td>
                                    <td class="vs-num">@day.SapItems.ToString("N0")</td>
                                    <td class="vs-num">@day.SapInvoiceCount.ToString("N0")</td>
                                    <td>@(day.FirstInvoicedAt?.ToString("ddd dd MMM HH:mm") ?? "—")</td>
                                    <td>@(day.LastInvoicedAt?.ToString("ddd dd MMM HH:mm") ?? "—")</td>
                                    <td>
                                        <span class="vst-pill vst-pill-@SalesPill(day.Status)">@SalesVerdict(day)</span>
                                        @if (day.Differences.Count > 0)
                                        {
                                            <button type="button" class="vst-link vst-link-inline"
                                                    @onclick="() => openedSalesDay = isOpen ? null : day.TradingDate">
                                                @(isOpen ? "Hide items" : $"{Plural(day.ItemsNotInSap + day.ItemsOnlyInSap, "item")} differ")
                                            </button>
                                        }
                                    </td>
                                </tr>
                                @if (isOpen)
                                {
                                    <tr class="vst-subrow">
                                        <td colspan="7">
                                            <table class="vst-table">
                                                <thead>
                                                    <tr><th>Item</th><th class="vs-num">Van recorded</th><th class="vs-num">SAP invoiced</th><th class="vs-num">Difference</th></tr>
                                                </thead>
                                                <tbody>
                                                    @foreach (var item in day.Differences)
                                                    {
                                                        <tr>
                                                            <td>@item.DisplayName<span class="vst-sub">@item.ItemCode</span></td>
                                                            <td class="vs-num">@Qty(item.Recorded)</td>
                                                            <td class="vs-num">@Qty(item.Invoiced)</td>
                                                            <td class="vs-num @(item.Difference < 0 ? "vst-bad" : "vst-warn-ink")"><strong>@Signed(item.Difference)</strong></td>
                                                        </tr>
                                                    }
                                                </tbody>
                                            </table>
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </section>
            }
        }
    }
</div>

@code {
    private const int IdlePreview = 8;

    private VanStockReportResponse? report;
    private List<VanView> vanViews = [];

    private DateTime? fromDate;
    private DateTime? toDate;
    private string selectedDeadStockDays = "14";

    private string? selectedVan;
    private DateTime? openedMorning;
    private DateTime? openedSalesDay;
    private bool showAllIdle;

    private bool isLoading;
    private string? loadError;

    private static IEnumerable<INocturneSelectOption<string>> DeadStockOptions =>
    [
        new NocturneSelectOption<string>("7", "7 days without a sale"),
        new NocturneSelectOption<string>("14", "14 days without a sale"),
        new NocturneSelectOption<string>("21", "21 days without a sale"),
        new NocturneSelectOption<string>("30", "30 days without a sale")
    ];

    /// <summary>One square of a van's strip: the morning it describes and how it came out.</summary>
    private sealed record Morning(string Kind, string Tip);

    /// <summary>A van as the page talks about it: its mornings, its sales days, and what to do next.</summary>
    private sealed record VanView(
        string Code,
        VanStockVan? Stats,
        List<VanStockMorning> Mornings,
        List<VanStockSalesDay> Sales,
        List<Morning> Strip,
        string Status,
        string Tone,
        string Action);

    protected override async Task OnInitializedAsync()
    {
        // CAT, not the server's clock: a trading day belongs to the van.
        var today = DateTime.UtcNow.AddHours(2).Date;
        fromDate = today.AddDays(-13);
        toDate = today;

        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        isLoading = true;
        loadError = null;
        StateHasChanged();

        try
        {
            var deadStockDays = int.TryParse(selectedDeadStockDays, out var parsed) ? parsed : 14;

            report = await VanSalesReportService.GetStockReportAsync(
                fromDate,
                toDate,
                deadStockDays: deadStockDays);

            if (report is null)
            {
                loadError = "The stock report could not be loaded. Check that the API is reachable.";
                vanViews = [];
            }
            else
            {
                vanViews = BuildVanViews(report);
                openedMorning = null;
                openedSalesDay = null;
            }
        }
        catch (Exception ex)
        {
            loadError = $"Failed to load the stock report: {ex.Message}";
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    private void OpenVan(string code)
    {
        selectedVan = code;
        openedMorning = null;
        openedSalesDay = null;
    }

    private void CloseVan()
    {
        selectedVan = null;
        openedMorning = null;
        openedSalesDay = null;
    }

    /// <summary>The morning whose documents are listed: the one clicked, else the latest with something to explain, else the latest.</summary>
    private VanStockMorning? OpenedMorning(VanView van) =>
        (openedMorning is { } date ? van.Mornings.FirstOrDefault(m => m.ToSnapshot == date) : null)
        ?? van.Mornings.LastOrDefault(m => m.SapChecked && !m.TiesToSap)
        ?? van.Mornings.LastOrDefault();

    private async Task ExportAsync()
    {
        if (report is null)
        {
            return;
        }

        try
        {
            var bytes = ExportService.ExportVanStockToExcel(report);
            var fileName = $"VanStock_{DateTime.UtcNow.AddHours(2):yyyyMMdd_HHmmss}.xlsx";

            await JS.InvokeVoidAsync("downloadFile", fileName, Convert.ToBase64String(bytes));
        }
        catch (Exception ex)
        {
            loadError = $"The export could not be downloaded: {ex.Message}";
        }
    }

    // ── The verdicts ────────────────────────────────────────────────────────────

    private static List<VanView> BuildVanViews(VanStockReportResponse report)
    {
        var codes = report.Vans.Select(v => v.VanWarehouseCode)
            .Concat(report.Mornings.Select(m => m.VanWarehouseCode))
            .Concat(report.Days.Select(d => d.VanWarehouseCode))
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .OrderBy(code => code, StringComparer.OrdinalIgnoreCase);

        return codes
            .Select(code => BuildVanView(
                report,
                code,
                report.Vans.FirstOrDefault(v => Same(v.VanWarehouseCode, code)),
                report.Mornings.Where(m => Same(m.VanWarehouseCode, code)).OrderBy(m => m.ToSnapshot).ToList(),
                report.SalesDays.Where(d => Same(d.VanWarehouseCode, code)).OrderBy(d => d.TradingDate).ToList()))
            // The vans that need a person first, then the rest alphabetically.
            .OrderBy(view => view.Tone switch { "bad" => 0, "warn" => 1, "info" => 2, _ => 3 })
            .ThenBy(view => view.Code, StringComparer.OrdinalIgnoreCase)
            .ToList();
    }

    private static VanView BuildVanView(
        VanStockReportResponse report,
        string code,
        VanStockVan? stats,
        List<VanStockMorning> mornings,
        List<VanStockSalesDay> sales)
    {
        var counted = report.Days
            .Where(d => Same(d.VanWarehouseCode, code))
            .Select(d => d.SnapshotDate.Date)
            .ToHashSet();

        // One square per morning in the period after the first, so every van's strip lines up.
        var strip = new List<Morning>();
        for (var day = report.FromDate.Date.AddDays(1); day <= report.ToDate.Date; day = day.AddDays(1))
        {
            var morning = mornings.FirstOrDefault(m => m.ToSnapshot.Date == day);
            var salesBefore = sales.FirstOrDefault(d => d.TradingDate.Date == day.AddDays(-1));

            if (morning is null)
            {
                strip.Add(new Morning("gap", counted.Contains(day)
                    ? $"{day:ddd dd MMM}: counted, but no complete count before it to compare with"
                    : $"{day:ddd dd MMM}: not counted"));
                continue;
            }

            var (kind, tip) = !morning.SapChecked
                ? ("unk", "SAP not read")
                : salesBefore?.Status == "NotInSap"
                    ? ("miss", $"{salesBefore.TradingDate:ddd}'s sales not in SAP")
                    : !morning.TiesToSap
                        ? ("other", $"{Plural(morning.ItemsUnexplained, "item")} moved by other SAP postings")
                        : salesBefore?.Status == "Late"
                            ? ("late", $"{salesBefore.TradingDate:ddd}'s sales reached SAP {Plural(salesBefore.DaysLate ?? 1, "day")} late")
                            : ("ok", "ties to SAP");

            strip.Add(new Morning(kind, $"{day:ddd dd MMM}: {tip}"));
        }

        string status, tone, action;
        var missing = sales.Where(d => d.Status == "NotInSap").ToList();
        var late = sales.Where(d => d.Status == "Late").OrderByDescending(d => d.DaysLate).ToList();
        var sapOnly = sales.Where(d => d.Status == "SapOnly").ToList();
        var other = mornings.Where(m => m.SapChecked && !m.TiesToSap).ToList();

        if (counted.Count == 0)
        {
            (status, tone, action) = ("Not counted", "warn",
                "No morning stock count was taken for this van in the period. Check it is on the count list.");
        }
        else if (!report.Summary.SapChecked)
        {
            (status, tone, action) = ("SAP not read", "warn",
                "The counts are in, but SAP's documents could not be read, so nothing can be reconciled.");
        }
        else if (missing.Count > 0)
        {
            (status, tone, action) = ("Sales missing", "bad",
                $"{Plural(missing.Count, "day")} of recorded sales have no SAP invoice. Start with {missing[0].TradingDate:ddd dd MMM}. " +
                "Until they post, SAP overstates this van's stock.");
        }
        else if (other.Count > 0)
        {
            var biggest = other.OrderByDescending(m => m.ItemsUnexplained).First();
            (status, tone, action) = ("Other postings", "info",
                $"SAP moved stock on {Plural(other.Count, "morning")} by postings other than invoices, credit notes and transfers — " +
                $"a breakage, receipt or count. Start with {biggest.ToSnapshot:ddd dd MMM} and confirm it was physical.");
        }
        else if (late.Count > 0)
        {
            (status, tone, action) = ("Sales post late", "warn",
                $"Stock ties to SAP, but sales reached SAP up to {Plural(late[0].DaysLate ?? 1, "day")} late, so the count runs high and then drops. " +
                $"Start with {late[0].TradingDate:ddd dd MMM}.");
        }
        else if (sapOnly.Count > 0)
        {
            (status, tone, action) = ("Invoices not from the van", "warn",
                $"SAP holds invoices from this van on {Plural(sapOnly.Count, "day")} with no sale recorded by the app. " +
                $"Check who raised them, starting with {sapOnly[0].TradingDate:ddd dd MMM}.");
        }
        else if (stats is { DaysCounted: > 0, DaysWithSales: 0 })
        {
            (status, tone, action) = ("No sales", "warn",
                "No sale was recorded against the load. Either the van was parked or its sales are not reaching the app.");
        }
        else if (mornings.Count == 0)
        {
            (status, tone, action) = ("Can't compare", "warn",
                "No two complete counts were taken, so no morning can be explained.");
        }
        else
        {
            (status, tone, action) = ("Ties to SAP", "good",
                "Every morning is explained by SAP documents, and every day's sales reached SAP before the next count.");
        }

        return new VanView(code, stats, mornings, sales, strip, status, tone, action);
    }

    // ── Formatting ──────────────────────────────────────────────────────────────

    private static bool Same(string a, string b) => string.Equals(a, b, StringComparison.OrdinalIgnoreCase);

    private static RenderFragment DocumentCell(VanStockMorning morning, string kind) => builder =>
    {
        var documents = morning.Documents.Where(d => d.Kind == kind).ToList();
        if (documents.Count == 0)
        {
            builder.AddMarkupContent(0, "<span class=\"vst-mute\">—</span>");
            return;
        }

        builder.OpenElement(1, "span");
        builder.AddContent(2, Plural(documents.Count, kind == "Invoice" ? "invoice" : "credit note"));
        builder.CloseElement();
        builder.OpenElement(3, "span");
        builder.AddAttribute(4, "class", "vst-sub");
        builder.AddContent(5, Plural(documents.Sum(d => d.ItemCount), "item line", "item lines"));
        builder.CloseElement();
    };

    private static RenderFragment TransferCell(VanStockMorning morning) => builder =>
    {
        var on = morning.Documents.Count(d => d.Kind == "TransferIn");
        var off = morning.Documents.Count(d => d.Kind == "TransferOut");
        if (on + off == 0)
        {
            builder.AddMarkupContent(0, "<span class=\"vst-mute\">—</span>");
            return;
        }

        builder.OpenElement(1, "span");
        builder.AddContent(2, string.Join(", ", new[]
        {
            on > 0 ? $"{on:N0} on" : null,
            off > 0 ? $"{off:N0} off" : null
        }.Where(part => part is not null)));
        builder.CloseElement();
    };

    private static string KindLabel(string kind) => kind switch
    {
        "Invoice" => "Invoice",
        "CreditNote" => "Credit note",
        "TransferIn" => "Transfer on",
        "TransferOut" => "Transfer off",
        _ => kind
    };

    private static string SalesVerdict(VanStockSalesDay day) => day.Status switch
    {
        "OnTime" => "In SAP on time",
        "Late" => $"{Plural(day.DaysLate ?? 1, "day")} late",
        "NotInSap" => $"Not in SAP · {Plural(day.ItemsNotInSap, "item")}",
        "Pending" => "Due at the next count",
        "SapOnly" => "In SAP only",
        "Unchecked" => "SAP not read",
        _ => day.Status
    };

    private static string SalesTone(string status) => status switch
    {
        "OnTime" => "vst-good-ink",
        "Late" or "SapOnly" => "vst-warn-ink",
        "NotInSap" => "vst-bad",
        _ => "vst-mute"
    };

    private static string SalesPill(string status) => status switch
    {
        "OnTime" => "good",
        "Late" or "SapOnly" => "warn",
        "NotInSap" => "bad",
        _ => "neutral"
    };

    private static string FreshnessLabel(DateTime latest, DateTime? countedAt, int? ageDays)
    {
        var time = countedAt is { } at && at.Date == latest.Date ? $" {at:HH:mm}" : "";

        return ageDays switch
        {
            0 => $"SAP count read{time} this morning, {latest:ddd dd MMM}",
            1 => $"SAP count read{time} yesterday, {latest:ddd dd MMM}",
            _ => $"Latest SAP count: {latest:ddd dd MMM}"
        };
    }

    private static string Signed(decimal value) =>
        value > 0 ? $"+{value:#,##0.##}" : $"−{-value:#,##0.##}";

    private static string Signed0(decimal value) => value == 0 ? "0" : Signed(value);

    /// <summary>A quantity in the item's own unit: whole where it is whole, kilograms keep their decimals.</summary>
    private static string Qty(decimal value) => value.ToString("#,##0.##", CultureInfo.InvariantCulture) is { Length: > 0 } text ? text : "0";

    private static string Plural(int count, string one, string? many = null) =>
        $"{count:N0} {(count == 1 ? one : many ?? one + "s")}";
}
