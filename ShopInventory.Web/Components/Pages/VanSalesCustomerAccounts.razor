@page "/van-sales-customer-accounts"
@using Microsoft.AspNetCore.Authorization
@using ShopInventory.Web.Models
@attribute [Authorize(Roles = "Admin,Manager,Cashier")]
@rendermode InteractiveServer

<PageTitle>Customer App Access - Shop Inventory</PageTitle>

@* Nocturne, from `Customer App Access.dc.html`. Rules live in
   wwwroot/css/customer-app-access.css under the `caa` prefix — see that file's
   header for what this build takes from the design and the three places it
   departs from it, each because of what the data actually is.

   Both shop pickers are <NocturneSelect> rather than native <select>s: they are
   page controls the operator scans, and a native popup takes its background
   from the field, which on a Nocturne field's translucent wash renders the list
   near-white on near-white in dark theme. *@

<div class="caa">
    <div class="caa-body">

        <div class="caa-hero">
            <div class="caa-hero-text">
                <div class="caa-kicker">Van sales</div>
                <h1>Customer App Access</h1>
                <p>
                    Which shops can order for themselves in the app, and from which handset. Setting
                    one up here is what used to be done by hand over WhatsApp — the shop still gets
                    its sign-in code on WhatsApp, but the account is created here.
                </p>
            </div>
            <div class="caa-hero-meta">
                <div class="caa-fig">
                    <span class="caa-fig-num">@ActiveCount</span>
                    <span class="caa-fig-label">Shops active</span>
                </div>
                <a class="caa-btn caa-btn-quiet" href="/van-sales-customer-orders">
                    <i class="ph ph-shopping-cart" aria-hidden="true"></i>
                    <span>Customer orders</span>
                </a>
            </div>
        </div>

        <section class="caa-panel">
            <div class="caa-panel-head">
                <h2><i class="ph ph-device-mobile" aria-hidden="true"></i>Give a shop access</h2>
                <span class="caa-panel-note">One handset per shop</span>
            </div>

            @if (!string.IsNullOrWhiteSpace(formErrorMessage))
            {
                <div class="caa-msg" role="alert">
                    <i class="ph ph-warning-octagon" aria-hidden="true"></i>
                    <div>@formErrorMessage</div>
                </div>
            }

            <form @onsubmit="GiveAccessAsync" @onsubmit:preventDefault="true">
                <div class="caa-form">
                    <label class="caa-field">
                        <span class="caa-label">Shop</span>
                        <NocturneSelect Class="nsel-block" TValue="int" Options="ShopOptions"
                                        @bind-Value="form.RouteCustomerId"
                                        Placeholder="Select a shop" Caption="Choose the shop"
                                        EmptyText="No shops are on a route yet" AriaLabel="Shop" />
                    </label>

                    @* Typed however the rep has it written down. The API normalises to E.164 and is
                       the only place that decides what counts as a number. *@
                    <label class="caa-field">
                        <span class="caa-label">Phone number</span>
                        <input class="caa-input" type="tel" maxlength="32" placeholder="077 123 4567"
                               @bind="form.PhoneNumber" @bind:event="oninput" />
                    </label>

                    @* Legible rather than masked. The operator has to read this back to the
                       shopkeeper on the spot, and a password typed blind is one that gets passed on
                       wrong and comes back as a report that the app is broken. *@
                    <label class="caa-field">
                        <span class="caa-label">
                            Password
                            @if (ShopAlreadyHasAccess)
                            {
                                <span class="caa-optional">(blank keeps the current one)</span>
                            }
                        </span>
                        <input class="caa-input" type="text" maxlength="72" autocomplete="off"
                               placeholder="At least 8 characters"
                               @bind="form.Password" @bind:event="oninput" />
                    </label>

                    <label class="caa-field">
                        <span class="caa-label">
                            Who holds the phone <span class="caa-optional">(optional)</span>
                        </span>
                        <input class="caa-input" type="text" maxlength="200"
                               placeholder="e.g. Rudo, the owner"
                               @bind="form.DisplayName" @bind:event="oninput" />
                    </label>

                    <button type="submit" class="caa-btn caa-btn-primary caa-form-submit"
                            disabled="@isSaving">
                        @if (isSaving)
                        {
                            <span class="caa-spin"></span>
                            <span>Setting up&hellip;</span>
                        }
                        else
                        {
                            <i class="ph ph-check-circle" aria-hidden="true"></i>
                            <span>Give access</span>
                        }
                    </button>
                </div>

                <p class="caa-hint">
                    The shop signs in on the app with this number and password. A shop that already
                    has access will be moved to this handset, and a new password typed here replaces
                    the one they had — which is how a forgotten one is reset. The same number cannot
                    be used by two different shops.
                </p>
            </form>
        </section>

        <section class="caa-panel">
            <div class="caa-panel-head">
                <h2>Sign-ins</h2>
                <span class="caa-count">@FilteredAccounts.Count() of @view.Accounts.Count</span>

                <div class="caa-tools">
                    <div class="caa-search">
                        <i class="ph ph-magnifying-glass" aria-hidden="true"></i>
                        <input class="caa-input caa-input-search" type="search"
                               placeholder="Shop, code, number or person" aria-label="Search sign-ins"
                               @bind="searchTerm" @bind:event="oninput" />
                    </div>

                    <NocturneSelect Class="nsel-block" TValue="int?" Options="ShopFilterOptions"
                                    @bind-Value="routeCustomerFilter" OnChanged="LoadAsync"
                                    Placeholder="All shops" Caption="Filter by shop"
                                    AriaLabel="Filter by shop" />

                    <div class="caa-seg" role="group" aria-label="Which sign-ins to show">
                        @* `aria-pressed` is written out as words rather than bound to the bool:
                           Blazor treats a false bool attribute as absent and a true one as
                           valueless, and ARIA needs "true"/"false". The comment sits here rather
                           than among the attributes — a Razor comment inside a start tag compiles
                           clean and is then emitted as an attribute *name* at runtime, which
                           throws InvalidCharacterError and takes the whole render batch with it. *@
                        @foreach (var option in ViewFilters)
                        {
                            <button type="button"
                                    class="caa-seg-opt @(viewFilter == option.Value ? "is-on" : null)"
                                    aria-pressed="@(viewFilter == option.Value ? "true" : "false")"
                                    @onclick="() => SetViewAsync(option.Value)">
                                @option.Label
                            </button>
                        }
                    </div>

                    <button type="button" class="caa-btn caa-btn-icon" title="Refresh"
                            aria-label="Refresh" @onclick="LoadAsync" disabled="@isLoading">
                        <i class="ph ph-arrows-clockwise" aria-hidden="true"></i>
                    </button>
                </div>
            </div>

            @if (isLoading)
            {
                <div class="caa-empty"><p>Loading&hellip;</p></div>
            }
            else if (!FilteredAccounts.Any())
            {
                <div class="caa-empty">
                    <p>
                        @if (view.Accounts.Count == 0)
                        {
                            <text>No shop has app access yet. Set the first one up above.</text>
                        }
                        else
                        {
                            <text>No sign-in matches that search.</text>
                        }
                    </p>
                </div>
            }
            else
            {
                <div class="caa-scroll">
                    <div class="caa-grid">
                        <div class="caa-thead">
                            <div>Shop</div>
                            <div>Handset</div>
                            <div>Who holds it</div>
                            <div>Last signed in</div>
                            <div>Status</div>
                            <div></div>
                        </div>

                        @foreach (var account in FilteredAccounts)
                        {
                            <div class="caa-row @(account.IsActive ? null : "caa-row-off")">
                                <div class="caa-cell caa-cell-shop">
                                    <span class="caa-strong">@account.RouteCustomerName</span>
                                    <span class="caa-weak">@account.RouteCustomerCode</span>
                                </div>

                                <div class="caa-cell caa-cell-phone">
                                    <span class="caa-rl">Handset</span>
                                    <span class="caa-phone">@account.PhoneE164</span>
                                </div>

                                <div class="caa-cell caa-cell-holder">
                                    <span class="caa-rl">Who holds it</span>
                                    @if (string.IsNullOrWhiteSpace(account.DisplayName))
                                    {
                                        <span class="caa-none">&mdash;</span>
                                    }
                                    else
                                    {
                                        <span class="caa-weak">@account.DisplayName</span>
                                    }
                                </div>

                                <div class="caa-cell caa-cell-seen">
                                    <span class="caa-rl">Last signed in</span>
                                    <span class="caa-seen @(account.LastLoginAt is null ? "caa-seen-never" : null)">
                                        @LastSeen(account)
                                    </span>
                                </div>

                                <div class="caa-cell caa-cell-status">
                                    <span class="caa-badge @StatusFamily(account)">@StatusLabel(account)</span>
                                </div>

                                <div class="caa-actions">
                                    @if (account.IsActive)
                                    {
                                        <button type="button" class="caa-btn caa-btn-ghost caa-btn-sm"
                                                disabled="@isSaving"
                                                @onclick="() => BeginWithdraw(account)">
                                            Withdraw
                                        </button>
                                    }
                                    else
                                    {
                                        <button type="button" class="caa-btn caa-btn-ghost caa-btn-sm"
                                                disabled="@isSaving"
                                                @onclick="() => ReinstateAsync(account)">
                                            Reinstate
                                        </button>
                                    }
                                </div>
                            </div>
                        }
                    </div>
                </div>
            }
        </section>
    </div>
</div>

@* Outside `.caa` so the page cannot clip it, and on the `.caa-overlay` peer
   class rather than the page root — the root carries `min-height: 100vh`, which
   would beat the dialog's own height and push its footer below the fold. *@
@if (accountPendingWithdrawal is not null)
{
    <div class="caa-overlay" @onclick="CancelWithdraw">
        <div class="caa-dialog" role="dialog" aria-modal="true" aria-label="Withdraw app access"
             @onclick:stopPropagation="true">
            <div class="caa-dialog-head">
                <h2>Withdraw app access</h2>
                <button type="button" class="caa-btn caa-btn-icon caa-dialog-x" aria-label="Close"
                        @onclick="CancelWithdraw" disabled="@isWithdrawing">
                    <i class="ph ph-x" aria-hidden="true"></i>
                </button>
            </div>

            <div class="caa-dialog-body">
                @if (!string.IsNullOrWhiteSpace(withdrawErrorMessage))
                {
                    <div class="caa-msg" role="alert">
                        <i class="ph ph-warning-octagon" aria-hidden="true"></i>
                        <div>@withdrawErrorMessage</div>
                    </div>
                }

                <p>
                    <strong>@accountPendingWithdrawal.RouteCustomerName</strong>
                    (@accountPendingWithdrawal.PhoneE164) will be signed out on every handset and
                    will not be able to place orders.
                </p>
                <p class="caa-dialog-note">
                    Orders they have already placed are kept. You can reinstate this sign-in later
                    from the list.
                </p>
            </div>

            <div class="caa-dialog-foot">
                <button type="button" class="caa-btn caa-btn-quiet" @onclick="CancelWithdraw"
                        disabled="@isWithdrawing">Cancel</button>
                <button type="button" class="caa-btn caa-btn-danger" @onclick="ConfirmWithdrawAsync"
                        disabled="@isWithdrawing">
                    @if (isWithdrawing)
                    {
                        <span class="caa-spin"></span>
                        <span>Withdrawing&hellip;</span>
                    }
                    else
                    {
                        <i class="ph ph-prohibit" aria-hidden="true"></i>
                        <span>Withdraw access</span>
                    }
                </button>
            </div>
        </div>
    </div>
}
