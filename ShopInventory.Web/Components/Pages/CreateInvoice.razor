                operatorUser = authState.User;
                Logger.LogInformation("Auth state fetched, user authenticated: {IsAuthenticated}",
                authState.User?.Identity?.IsAuthenticated ?? false);
            }
            catch (Exception ex)
            {
                Logger.LogWarning(ex, "Failed to get auth state during initialization");
            }

            // Check if cache is already ready
            if (CacheService.IsCacheReady)
            {
                Logger.LogInformation("Cache is ready, loading from static cache...");
                isLoadingBPs = false;
                isLoadingMasterData = false;
            }

            await LoadAllMasterDataAsync();

            // Seed the defaults bar once master data is in, so the resolver can confirm the
            // warehouse is one the dropdown actually holds. First render only, so the manual
            // master-data refresh never overwrites a warehouse the cashier picked.
            warehouseCode = DefaultWarehouseResolver.Resolve(operatorUser, AppSettings.DefaultWarehouse, cachedWarehouses);
            if (warehouseCode is null)
            {
                Logger.LogWarning(
                "No usable default warehouse for this operator (configured default {Configured}); the defaults bar starts empty",
                AppSettings.DefaultWarehouse);
            }

            var operatorName = operatorUser?.Identity?.IsAuthenticated == true ? operatorUser.Identity.Name : null;
            await LoadRecentCustomersAsync(operatorName);

            // After the defaults, so a restored draft's own warehouse and cost centre win over them.
            draftStorageKey = InvoiceDraft.StorageKey(operatorName);
            await RestoreDraftAsync();
            isTrackingDraft = draftStorageKey is not null;

            _ = LoadShipFromCachedStockAsync();
            RequestStockForAllLines();

            // A fresh invoice starts on the customer, ready to type into.
            openCustomerPending = selectedBusinessPartner is null && invoice.Lines.Count == 0;

            StateHasChanged();
        }
    }

