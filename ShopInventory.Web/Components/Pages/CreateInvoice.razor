    };

    private async Task SaveDraftAsync()
    {
        if (draftStorageKey is null)
        {
            return;
        }

        var draft = CurrentDraft();
        var fingerprint = draft.Fingerprint();
        if (fingerprint == lastDraftFingerprint)
        {
            return;
        }

        try
        {
            if (InvoiceDraft.IsEmpty(invoice))
            {
                await LocalStorage.RemoveItemAsync(draftStorageKey);
            }
            else
            {
                draft.SavedAt = DateTimeOffset.UtcNow;
                await LocalStorage.SetItemAsStringAsync(draftStorageKey, draft.Serialize());
            }

            lastDraftFingerprint = fingerprint;
        }
        catch (Exception ex) when (ex is JSDisconnectedException or JSException or TaskCanceledException or InvalidOperationException)
        {
            // The circuit is going away or storage is refused. The fingerprint is not recorded, so the
            // next render tries again.
            Logger.LogDebug(ex, "Could not save the invoice draft");
        }
    }

    private async Task RestoreDraftAsync()
    {
        if (draftStorageKey is null)
        {
            return;
        }

        InvoiceDraft? draft;
        try
        {
            draft = InvoiceDraft.TryRestore(await LocalStorage.GetItemAsStringAsync(draftStorageKey), DateTimeOffset.UtcNow);
        }
        catch (Exception ex) when (ex is JSDisconnectedException or JSException or TaskCanceledException or InvalidOperationException)
        {
            Logger.LogWarning(ex, "Could not read the invoice draft");
            return;
        }

        if (draft is null)
        {
            // Nothing to bring back: record the empty form as saved, so an untouched page never
            // clears a draft another tab is still writing.
            lastDraftFingerprint = CurrentDraft().Fingerprint();
            return;
        }

        invoice = draft.Invoice;
        warehouseCode = draft.WarehouseCode ?? warehouseCode;
        defaultCostCentre = draft.DefaultCostCentre;
        notifyCustomerByEmail = draft.NotifyCustomerByEmail;

        // The lines keep the prices they were entered at — re-pricing them here would overwrite a
        // price the cashier typed. The customer's price list is still loaded, for lines added next.
        var bp = string.IsNullOrWhiteSpace(invoice.CardCode)
            ? null
            : allBusinessPartners.FirstOrDefault(p => string.Equals(p.CardCode, invoice.CardCode, StringComparison.OrdinalIgnoreCase));
        if (bp is not null)
        {
            var requestVersion = BeginBusinessPartnerPricingRequest();
            selectedBusinessPartner = bp;
            customerPriceListNum = bp.PriceListNum;
            _ = LoadBusinessPartnerPricesAsync(bp, requestVersion, businessPartnerPricingCts?.Token ?? CancellationToken.None);
        }

        string? lostCustomer = null;
        if (bp is null && !string.IsNullOrWhiteSpace(invoice.CardCode))
        {
            // The customer list did not load, or no longer holds this code: name it in the notice
            // for the cashier to pick again rather than post to a customer nobody can see.
            lostCustomer = invoice.CardCode;
            invoice.CardCode = string.Empty;
        }

        lastDraftFingerprint = CurrentDraft().Fingerprint();

        var lineCount = invoice.Lines.Count;
        var savedAt = draft.SavedAt.ToLocalTime();
        draftNotice = $"Restored the invoice you were entering ({lineCount} line{(lineCount == 1 ? "" : "s")}, "
            + $"last changed {savedAt:HH:mm}). Check it before you create it."
            + (lostCustomer is null ? string.Empty : $" Customer {lostCustomer} is no longer in the list; pick them again.");
        Logger.LogInformation("Restored an invoice draft with {LineCount} lines for {CardCode}", lineCount, draft.Invoice.CardCode);
    }

    private void DiscardRestoredDraft()
    {
        draftNotice = null;
        ClearForm();
    }

    private async Task LoadAllMasterDataAsync()
    {
        var showLoading = !CacheService.IsCacheReady;
        if (showLoading)
        {
            isLoadingBPs = true;
            isLoadingMasterData = true;
            StateHasChanged();
        }

        // Use a timeout for slow API calls - don't block the UI forever
        var timeout = TimeSpan.FromSeconds(15);

        try
        {
            // Load data SEQUENTIALLY to avoid EF Core DbContext concurrency issues.
            // Each cache getter creates its own DbContext, but background sync tasks
            // can overlap if multiple getters run in parallel, causing
            // "A second operation was started on this context instance" errors.

            // 1. Warehouses - usually fast
            await LoadWithTimeoutAsync(
            "Warehouses",
            async cancellationToken => cachedWarehouses = await CacheService.GetWarehousesAsync(
                cancellationToken: cancellationToken),
            timeout
            );

            // 2. Cost Centres - usually fast and rarely change
            await LoadWithTimeoutAsync(
            "Cost Centres",
            async cancellationToken => cachedCostCentres = await CacheService.GetCostCentresAsync(
                cancellationToken: cancellationToken),
            timeout
            );

            warehouseOptions = WarehouseOptions.ByCode(cachedWarehouses);
            costCentreOptions = CostCentreOptions.ByCode(cachedCostCentres.Where(c => c.IsActive));

            // Update UI - warehouses and cost centres are loaded
            isLoadingMasterData = cachedWarehouses.Count == 0;
            StateHasChanged();

            // 3. Business Partners - can be slow
            await LoadWithTimeoutAsync(
            "Business Partners",
            async cancellationToken =>
            {
                allBusinessPartners = await CacheService.GetBusinessPartnersAsync(
                    cancellationToken: cancellationToken);
                customerOptions = InvoiceEntry.CustomerOptions(allBusinessPartners, recentCustomerCodes);
                isLoadingBPs = false;
                await InvokeAsync(StateHasChanged);
            },
            timeout
            );

            // 4. Products - can be slow
            await LoadWithTimeoutAsync(
            "Products",
            async cancellationToken =>
            {
                cachedProducts = await CacheService.GetProductsAsync(cancellationToken: cancellationToken);
                isLoadingMasterData = false;
                await InvokeAsync(StateHasChanged);
            },
            timeout
            );

            lastCacheRefresh = CacheService.GetLastRefreshTime("BusinessPartners") ?? CacheService.GetLastRefreshTime("Warehouses");

            Logger.LogInformation("Loaded master data: {BPCount} customers, {ProductCount} products, {WHCount} warehouses, {CCCount} cost centres",
            allBusinessPartners.Count, cachedProducts.Count, cachedWarehouses.Count, cachedCostCentres.Count);

            if (allBusinessPartners.Count == 0 && cachedProducts.Count == 0 && cachedWarehouses.Count == 0)
            {
                errorMessage = "No master data available. The backend API may be slow or unavailable. Please try clicking 'Refresh'.";
            }
            else if (allBusinessPartners.Count == 0 || cachedProducts.Count == 0)
            {
                // Partial data loaded - show a warning but let user proceed
                var missing = new List<string>();
                if (allBusinessPartners.Count == 0) missing.Add("customers");
                if (cachedProducts.Count == 0) missing.Add("products");
                errorMessage = $"Some data is still loading ({string.Join(", ", missing)}). You may need to click 'Refresh' or wait.";
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error loading master data");
            errorMessage = $"Failed to load master data: {ex.Message}. Please ensure the backend API is running.";
        }
        finally
        {
            isLoadingBPs = false;
            isLoadingMasterData = false;
            StateHasChanged();
        }
    }

    private async Task LoadWithTimeoutAsync(
        string dataName,
        Func<CancellationToken, Task> loadAction,
        TimeSpan timeout)
    {
        try
        {
            using var cts = new CancellationTokenSource(timeout);
            await loadAction(cts.Token);
            Logger.LogDebug("{DataName} loaded successfully", dataName);
        }
        catch (OperationCanceledException)
        {
            Logger.LogWarning(
                "{DataName} load timed out after {Timeout}s - will continue with cached data",
                dataName,
                timeout.TotalSeconds);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error loading {DataName}", dataName);
            // Don't throw - allow other data to load
        }
    }

    private async Task RefreshMasterData()
    {
        isRefreshingCache = true;
        errorMessage = null;
        try
        {
            CacheService.InvalidateCache();
            await LoadAllMasterDataAsync();
            successMessage = "Master data refreshed successfully!";
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error refreshing master data");
            errorMessage = "Failed to refresh master data. Please try again.";
        }
        finally
        {
            isRefreshingCache = false;
        }
    }

    private string TruncateName(string? name, int maxLength)
    {
        if (string.IsNullOrEmpty(name)) return "";
        return name.Length <= maxLength ? name : name.Substring(0, maxLength) + "...";
    }

    private void OnCratesChange(string? value)
    {
        invoice.CrateQuantity = decimal.TryParse(value, out var crates) ? crates : null;
        validationErrors.Remove("CrateQuantity");
    }

    private void ApplyCostCentreToAllLines()
    {
        if (!string.IsNullOrEmpty(defaultCostCentre))
        {
            foreach (var line in invoice.Lines)
            {
                line.CostCentreCode = defaultCostCentre;
            }
        }
    }

    // ── Customer ─────────────────────────────────────────────────────────────
    private async Task OnCustomerPickedAsync(string? cardCode)
    {
        var bp = string.IsNullOrWhiteSpace(cardCode)
            ? null
            : allBusinessPartners.FirstOrDefault(p => string.Equals(p.CardCode, cardCode, StringComparison.OrdinalIgnoreCase));

        if (bp is null)
        {
            ClearSelectedBP();
            return;
        }

        // The cursor goes on to the items: the customer is the only thing they wait for.
        focusEntryItemPending = true;
        await SelectBusinessPartnerAsync(bp);
    }

    /// <summary>"Next invoice" on the success banner: the form is already clear, so open the customer.</summary>
    private void StartNextInvoice()
    {
        DismissSuccess();
        openCustomerPending = true;
    }

    private void OnFormKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && (e.CtrlKey || e.MetaKey) && !isSubmitting)
        {
            _ = SubmitInvoice();
        }
    }

    // ── Line defaults ────────────────────────────────────────────────────────
    private async Task OnDefaultWarehouseChanged(string? code)
    {
        var previous = warehouseCode;
        warehouseCode = string.IsNullOrWhiteSpace(code) ? null : code;

        if (string.IsNullOrWhiteSpace(warehouseCode))
        {
            return;
        }

        // Lines still on the old default, or on none, follow the new one; a line the cashier moved
        // to another warehouse by hand keeps it.
        for (var i = 0; i < invoice.Lines.Count; i++)
        {
            var line = invoice.Lines[i];
            if (string.IsNullOrWhiteSpace(line.WarehouseCode)
                || string.Equals(line.WarehouseCode, previous, StringComparison.OrdinalIgnoreCase))
            {
                line.WarehouseCode = warehouseCode;
                if (lineValidationErrors.TryGetValue(i, out var errors))
                {
                    errors.Remove("Warehouse");
                    errors.Remove("Stock");
                }

                RequestLineStock(line);
            }
        }

        await LoadShipFromCachedStockAsync();
    }

    private void OnDefaultCostCentreChanged(string? code)
    {
        defaultCostCentre = string.IsNullOrWhiteSpace(code) ? null : code;
        ApplyCostCentreToAllLines();
    }

    private void OnLineWarehouseChanged(int index, string? code)
    {
        if (index < 0 || index >= invoice.Lines.Count)
        {
            return;
        }

        var line = invoice.Lines[index];
        line.WarehouseCode = code ?? string.Empty;

        if (lineValidationErrors.TryGetValue(index, out var errors))
        {
            errors.Remove("Warehouse");
            errors.Remove("Stock");
        }

        RequestLineStock(line);
    }

    /// <summary>
    /// The warehouse rows for one line's picker, each saying how much of the line's item it holds
    /// as last cached — so moving a short line is a choice made with the figures in view.
    /// </summary>
    private List<NocturnePickerOption> LineWarehouseOptions(CreateInvoiceLineRequest line)
    {
        if (string.IsNullOrWhiteSpace(line.ItemCode)
            || !cachedStockByItem.TryGetValue(line.ItemCode, out var byWarehouse))
        {
            return warehouseOptions;
        }

        return warehouseOptions
            .Select(option =>
            {
                var hint = byWarehouse.TryGetValue(option.Value, out var inStock)
                    ? $"{FormatQty(inStock)} in stock"
                    : null;
                if (string.Equals(option.Value, warehouseCode, StringComparison.OrdinalIgnoreCase))
                {
                    hint = hint is null ? "Ship from" : $"{hint} · Ship from";
                }

                return hint is null ? option : option with { Hint = hint };
            })
            .ToList();
    }

    private Dictionary<string, string> GetLineValidationErrors(int index)
    {
        return lineValidationErrors.TryGetValue(index, out var errors) ? errors : new Dictionary<string, string>();
    }

    // ── The "Add item" row ───────────────────────────────────────────────────
    private bool EntryDisabled => selectedBusinessPartner is null || isLoadingMasterData;

    private string EntryPlaceholder => selectedBusinessPartner is null
        ? "Pick the customer first"
        : $"Scan or search {cachedProducts.Count:N0} items by code, name or barcode";

    private string EntryText => entryPicked is null
        ? entryText
        : $"{entryPicked.ItemCode} · {entryPicked.ItemName}";

    private ProductDto? EntryCandidate => entryPicked
        ?? (entryActive >= 0 && entryActive < entryMatches.Count ? entryMatches[entryActive] : null);

    private string EntryPreviewAmount
    {
        get
        {
            var product = EntryCandidate;
            if (product is null || !TryReadEntryQuantity(out var quantity))
            {
                return "—";
            }

            var pricing = GetPricingForItem(product.ItemCode, product.Price);
            return (GetDisplayPrice(pricing.NetPrice) * quantity).ToString("N2");
        }
    }

    private void OnEntryInput(string? value)
    {
        entryPicked = null;
        entryText = value ?? string.Empty;
        FilterEntryMatches();
    }

    private void FilterEntryMatches()
    {
        var search = entryText.Trim();
        if (search.Length == 0)
        {
            entryMatches = new List<ProductDto>();
            entryMatchTotal = 0;
            entryActive = -1;
            entryOpen = false;
            return;
        }

        // A scanned barcode or a typed code is an exact hit and goes first; then codes that start
        // with the text; then anything containing it in the code, name or barcode.
        var all = cachedProducts.Where(p =>
                (p.ItemCode?.Contains(search, StringComparison.OrdinalIgnoreCase) ?? false) ||
                (p.ItemName?.Contains(search, StringComparison.OrdinalIgnoreCase) ?? false) ||
                (p.BarCode?.Contains(search, StringComparison.OrdinalIgnoreCase) ?? false))
            .OrderByDescending(p => string.Equals(p.BarCode, search, StringComparison.OrdinalIgnoreCase)
                                    || string.Equals(p.ItemCode, search, StringComparison.OrdinalIgnoreCase))
            .ThenByDescending(p => p.ItemCode?.StartsWith(search, StringComparison.OrdinalIgnoreCase) ?? false)
            .ThenBy(p => p.ItemCode)
            .ToList();

        entryMatchTotal = all.Count;
        entryMatches = all.Take(EntryMatchLimit).ToList();
        entryActive = entryMatches.Count > 0 ? 0 : -1;
        entryOpen = true;
    }

    private void OnEntryKeyDown(KeyboardEventArgs e)
    {
        if (e.CtrlKey || e.MetaKey || e.AltKey)
        {
            return;
        }

        switch (e.Key)
        {
            case "ArrowDown" when entryMatches.Count > 0:
                entryOpen = true;
                entryActive = Math.Min(entryActive + 1, entryMatches.Count - 1);
                break;

            case "ArrowUp" when entryMatches.Count > 0:
                entryActive = Math.Max(entryActive - 1, 0);
                break;

            case "Enter" when entryPicked is not null:
                focusEntryQtyPending = true;
                break;

            case "Enter" or "Tab" when entryActive >= 0 && entryActive < entryMatches.Count:
                PickEntry(entryMatches[entryActive]);
                break;

            case "Escape":
                ResetEntry();
                break;
        }
    }

    private async Task OnEntryBlur()
    {
        // Long enough for a click on a list row to land before the list closes.
        await Task.Delay(200);
        entryOpen = false;
    }

    private void PickEntry(ProductDto product)
    {
        entryPicked = product;
        entryText = string.Empty;
        entryOpen = false;
        entryQtyBad = false;
        focusEntryQtyPending = true;

        // Read its stock in the Ship from warehouse now, so the line has it when it lands.
        if (!string.IsNullOrWhiteSpace(warehouseCode))
        {
            RequestStock(warehouseCode, product.ItemCode);
        }
    }

    private void OnEntryQtyInput(string? value)
    {
        entryQty = value ?? string.Empty;
        entryQtyBad = false;
    }

    private async Task OnEntryQtyKeyDown(KeyboardEventArgs e)
    {
        if (e.CtrlKey || e.MetaKey || e.AltKey)
        {
            return;
        }

        if (e.Key == "Enter")
        {
            await AddEntryLineAsync();
        }
        else if (e.Key == "Escape")
        {
            focusEntryItemPending = true;
        }
    }

    /// <summary>A blank quantity means one; anything else must be a number above zero.</summary>
    private bool TryReadEntryQuantity(out decimal quantity)
    {
        if (string.IsNullOrWhiteSpace(entryQty))
        {
            quantity = 1m;
            return true;
        }

        return decimal.TryParse(entryQty, out quantity) && quantity > 0;
    }

    private async Task AddEntryLineAsync()
    {
        var product = EntryCandidate;
        if (product is null || EntryDisabled)
        {
            focusEntryItemPending = true;
            return;
        }

        if (!TryReadEntryQuantity(out var quantity))
        {
            entryQtyBad = true;
            focusEntryQtyPending = true;
            return;
        }

        AddLine();
        var index = invoice.Lines.Count - 1;
        await SelectProduct(index, product);
        invoice.Lines[index].Quantity = quantity;
        justAddedIndex = index;

        RequestLineStock(invoice.Lines[index]);
        ResetEntry();
        focusEntryItemPending = true;
    }

    private void ResetEntry()
    {
        entryPicked = null;
        entryText = string.Empty;
        entryQty = string.Empty;
        entryQtyBad = false;
        entryMatches = new List<ProductDto>();
        entryMatchTotal = 0;
        entryActive = -1;
        entryOpen = false;
    }

    // ── Stock ────────────────────────────────────────────────────────────────
    private static string StockKey(string warehouse, string itemCode) => $"{warehouse.Trim()}|{itemCode.Trim()}";

    private void RequestLineStock(CreateInvoiceLineRequest line)
    {
        RequestStock(line.WarehouseCode, line.ItemCode);
        _ = PeekItemStockAsync(line.ItemCode);
    }

    private void RequestStockForAllLines()
    {
        foreach (var line in invoice.Lines)
        {
            RequestStock(line.WarehouseCode, line.ItemCode);
        }

        _ = PeekItemStockAsync(invoice.Lines.Select(l => l.ItemCode).ToArray());
    }

    private void RequestStock(string? warehouse, string? itemCode)
    {
        if (string.IsNullOrWhiteSpace(warehouse) || string.IsNullOrWhiteSpace(itemCode))
        {
            return;
        }

        if (!stockBatchers.TryGetValue(warehouse.Trim(), out var batcher))
        {
            // One per warehouse: a batcher reads one warehouse and drops its queue when asked for
            // another, so lines in two warehouses sharing one would cancel each other.
            batcher = new StockRefreshBatcher(StockCacheService, Logger, ApplyStockBatchAsync);
            stockBatchers[warehouse.Trim()] = batcher;
        }

        pendingStock.Add(StockKey(warehouse, itemCode));
        batcher.Request(warehouse, itemCode);
    }

    private Task ApplyStockBatchAsync(StockRefreshBatch batch) => InvokeAsync(() =>
    {
        foreach (var code in batch.RequestedItemCodes)
        {
            var key = StockKey(batch.WarehouseCode, code);
            pendingStock.Remove(key);

            if (batch.Stock.TryGetValue(code, out var stock))
            {
                confirmedStock[key] = stock.QuantityInStock;
            }
        }

        StateHasChanged();
    });

    private LineStock LineStockOf(CreateInvoiceLineRequest line)
    {
        if (string.IsNullOrWhiteSpace(line.WarehouseCode) || string.IsNullOrWhiteSpace(line.ItemCode))
        {
            return InvoiceEntry.EvaluateStock(line.Quantity, null, false);
        }

        var key = StockKey(line.WarehouseCode, line.ItemCode);

        // A line with no quantity is its own error; judging it by its siblings would mark it short.
        var requested = line.Quantity > 0 ? RequestedFrom(key) : line.Quantity;

        return InvoiceEntry.EvaluateStock(
            requested,
            confirmedStock.TryGetValue(key, out var inStock) ? inStock : null,
            pendingStock.Contains(key));
    }

    /// <summary>
    /// What the whole invoice asks of one item in one warehouse. Two lines for the same item from
    /// the same warehouse draw on the same stock, so they are judged together.
    /// </summary>
    private decimal RequestedFrom(string key) => invoice.Lines
        .Where(other => !string.IsNullOrWhiteSpace(other.WarehouseCode) && !string.IsNullOrWhiteSpace(other.ItemCode)
                        && string.Equals(StockKey(other.WarehouseCode, other.ItemCode), key, StringComparison.OrdinalIgnoreCase))
        .Sum(other => Math.Max(other.Quantity, 0m));

    /// <summary>The most this line can take once the other lines on the same stock have theirs.</summary>
    private decimal LineCanTake(CreateInvoiceLineRequest line, LineStock stock)
    {
        if (stock.InStock is not { } inStock || string.IsNullOrWhiteSpace(line.WarehouseCode) || string.IsNullOrWhiteSpace(line.ItemCode))
        {
            return 0m;
        }

        var others = RequestedFrom(StockKey(line.WarehouseCode, line.ItemCode)) - Math.Max(line.Quantity, 0m);
        return Math.Max(inStock - others, 0m);
    }

    private int ShortLineCount => invoice.Lines.Count(line => LineStockOf(line).IsShort);

    /// <summary>
    /// Every figure is read afresh for the next invoice: the one just posted has moved stock, and a
    /// figure kept from before it would let the next one through on stock that is gone.
    /// </summary>
    private void ForgetStockFigures()
    {
        foreach (var batcher in stockBatchers.Values)
        {
            batcher.Dispose();
        }

        stockBatchers.Clear();
        confirmedStock.Clear();
        pendingStock.Clear();
        cachedStockByItem.Clear();
    }

    private string StockNote(LineStock stock) => stock.State switch
    {
        LineStockState.Loading => "checking stock…",
        LineStockState.Unknown => "stock not confirmed",
        _ when stock.InStock <= 0 => "none in stock",
        _ => $"{FormatQty(stock.InStock!.Value)} in stock"
    };

    private string ShortText(CreateInvoiceLineRequest line, LineStock stock)
    {
        var have = stock.InStock > 0
            ? $"Only {FormatQty(stock.InStock!.Value)} in {line.WarehouseCode}"
            : $"None in {line.WarehouseCode}";

        var requested = RequestedFrom(StockKey(line.WarehouseCode, line.ItemCode));
        var together = requested > line.Quantity
            ? $", and this invoice's lines for {line.ItemCode} ask for {FormatQty(requested)} together"
            : string.Empty;

        return $"{have}{together}. Short by {FormatQty(stock.ShortBy)}.";
    }

    /// <summary>
    /// Another warehouse whose cached stock covers the whole line, the fullest first. A hint: picking
    /// it reads that warehouse again before the line counts as covered.
    /// </summary>
    private CachedStockFigure? CoverFrom(CreateInvoiceLineRequest line)
    {
        if (string.IsNullOrWhiteSpace(line.ItemCode)
            || !cachedStockByItem.TryGetValue(line.ItemCode, out var byWarehouse))
        {
            return null;
        }

        var known = warehouseOptions.Select(o => o.Value).ToHashSet(StringComparer.OrdinalIgnoreCase);
        return byWarehouse
            .Where(kv => !string.Equals(kv.Key, line.WarehouseCode, StringComparison.OrdinalIgnoreCase)
                         && kv.Value >= line.Quantity
                         && known.Contains(kv.Key))
            .OrderByDescending(kv => kv.Value)
            .Select(kv => new CachedStockFigure(kv.Key, line.ItemCode, kv.Value))
            .FirstOrDefault();
    }

    private void SetLineQuantity(int index, decimal quantity)
    {
        OnQuantityChange(index, quantity.ToString(System.Globalization.CultureInfo.CurrentCulture));
    }

    private static string FormatQty(decimal quantity) => quantity.ToString("#,0.##");

    /// <summary>The Ship from warehouse's cached figure for a search match: a hint, never a decision.</summary>
    private (string Text, string Long, string Css) ShipFromStockNote(string? itemCode)
    {
        if (string.IsNullOrWhiteSpace(itemCode) || string.IsNullOrWhiteSpace(warehouseCode))
        {
            return (string.Empty, "Choose a Ship from warehouse to see its stock", "is-unknown");
        }

        if (!shipFromCachedStock.TryGetValue(itemCode, out var inStock))
        {
            return (string.Empty, $"No stock figure for {warehouseCode} yet", "is-unknown");
        }

        return inStock > 0
            ? ($"{FormatQty(inStock)} in {warehouseCode}", $"{FormatQty(inStock)} in stock in {warehouseCode}", "is-enough")
            : ($"None in {warehouseCode}", $"None in stock in {warehouseCode} — the line will be flagged short", "is-short");
    }

    private async Task LoadShipFromCachedStockAsync()
    {
        var warehouse = warehouseCode;
        if (string.IsNullOrWhiteSpace(warehouse))
        {
            shipFromCachedStock = new(StringComparer.OrdinalIgnoreCase);
            return;
        }

        try
        {
            var figures = await StockCacheService.PeekCachedInStockAsync(warehouse, null);
            if (!string.Equals(warehouse, warehouseCode, StringComparison.OrdinalIgnoreCase))
            {
                return;
            }

            var map = new Dictionary<string, decimal>(StringComparer.OrdinalIgnoreCase);
            foreach (var figure in figures)
            {
                map[figure.ItemCode] = figure.InStock;
            }

            shipFromCachedStock = map;
            await InvokeAsync(StateHasChanged);
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Could not read cached stock for {Warehouse}", warehouse);
        }
    }

    private async Task PeekItemStockAsync(params string?[] itemCodes)
    {
        var codes = itemCodes.Where(c => !string.IsNullOrWhiteSpace(c)).Select(c => c!).ToList();
        if (codes.Count == 0)
        {
            return;
        }

        try
        {
            var figures = await StockCacheService.PeekCachedInStockAsync(null, codes);
            await InvokeAsync(() =>
            {
                foreach (var code in codes)
                {
                    cachedStockByItem[code] = new Dictionary<string, decimal>(StringComparer.OrdinalIgnoreCase);
                }

                foreach (var figure in figures)
                {
                    if (!cachedStockByItem.TryGetValue(figure.ItemCode, out var byWarehouse))
                    {
                        byWarehouse = new Dictionary<string, decimal>(StringComparer.OrdinalIgnoreCase);
                        cachedStockByItem[figure.ItemCode] = byWarehouse;
                    }

                    byWarehouse[figure.WarehouseCode] = figure.InStock;
                }

                StateHasChanged();
            });
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Could not read cached stock across warehouses");
        }
    }

    /// <summary>What still stands between the form and a post, in the cashier's words.</summary>
    private List<string> ReadinessIssues()
    {
        var issues = new List<string>();
        if (selectedBusinessPartner is null)
        {
            issues.Add("Pick a customer");
        }

        if (invoice.Lines.Count == 0)
        {
            issues.Add("Add at least one line");
        }

        var shortKeys = new HashSet<string>(StringComparer.OrdinalIgnoreCase);
        for (var i = 0; i < invoice.Lines.Count; i++)
        {
            var line = invoice.Lines[i];
            var n = i + 1;
            if (string.IsNullOrWhiteSpace(line.ItemCode))
            {
                issues.Add($"Line {n} has no item");
            }
            else if (!line.UnitPrice.HasValue || line.UnitPrice <= 0)
            {
                issues.Add($"Line {n} has no SAP price");
            }

            if (line.Quantity <= 0)
            {
                issues.Add($"Line {n} needs a quantity");
            }

            if (string.IsNullOrWhiteSpace(line.WarehouseCode))
            {
                issues.Add($"Line {n} needs a warehouse");
            }

            // Lines sharing one item's stock are short together; say it once, at the first of them.
            var stock = LineStockOf(line);
            if (stock.IsShort && shortKeys.Add(StockKey(line.WarehouseCode, line.ItemCode)))
            {
                issues.Add($"Line {n} short by {FormatQty(stock.ShortBy)}");
            }
        }

        return issues;
    }

    private void OnQuantityChange(int index, string? value)
    {
        var line = invoice.Lines[index];

        if (decimal.TryParse(value, out var quantity))
        {
            // Prevent negative quantities
            if (quantity < 0)
            {
                quantity = 0;
                errorMessage = "Quantity cannot be negative. Value has been reset to 0.";
            }
            line.Quantity = quantity;
        }
        else
        {
            line.Quantity = 0;
        }

        // Clear validation error when user changes value
        if (lineValidationErrors.TryGetValue(index, out var errors))
        {
            errors.Remove("Quantity");
            errors.Remove("Stock");
        }
    }

    private async Task SelectProduct(int index, ProductDto product)
    {
        var line = invoice.Lines[index];
        line.ItemCode = product.ItemCode ?? string.Empty;
        line.ItemDescription = product.ItemName ?? string.Empty;

        // The API decides whether a fractional quantity is allowed on this line, and it can only
        // decide it from the unit: decimals are for KG items and nobody else. It cannot look the
        // unit up for itself — the API's own Products table is never populated — so a line sent
        // without one and carrying a weighed quantity is refused. The transfer page already sends
        // it from the same cached master data.
        line.UoMCode = string.IsNullOrWhiteSpace(product.UoM) ? null : product.UoM.Trim();

        ApplyPricing(line, GetPricingForItem(product.ItemCode, product.Price));

        if (!string.IsNullOrEmpty(product.ItemCode))
        {
            try
            {
                ApplyPricing(line, await BusinessPartnerPricingService.ResolveItemPriceAsync(
                    product.ItemCode,
                    invoice.DocCurrency,
                    product.Price,
                    invoice.CardCode,
                    customerPriceListNum,
                    customerPricing));
            }
            catch (Exception ex)
            {
                Logger.LogWarning(ex, "Failed to resolve BP-aware invoice price for item {ItemCode}", product.ItemCode);
            }
        }

        line.WarehouseCode = !string.IsNullOrEmpty(warehouseCode) ? warehouseCode : (product.DefaultWarehouse ??
string.Empty);

        // Apply default cost centre if set
        if (!string.IsNullOrEmpty(defaultCostCentre))
        {
            line.CostCentreCode = defaultCostCentre;
        }

        if (line.UnitPrice.GetValueOrDefault() > 0)
        {
            ClearUnitPriceError(index);
        }
        else
        {
            line.UnitPrice = 0;
            SetMissingSapPriceError(index, line.ItemCode);
        }

        // Clear validation errors for this line
        if (lineValidationErrors.TryGetValue(index, out var errors))
        {
            errors.Remove("ItemCode");
            if (errors.Count == 0)
            {
                lineValidationErrors.Remove(index);
            }
        }
    }

    private async Task SelectBusinessPartnerAsync(BusinessPartnerDto bp)
    {
        var requestVersion = BeginBusinessPartnerPricingRequest();
        selectedBusinessPartner = bp;
        invoice.CardCode = bp.CardCode ?? string.Empty;

        // "##" is SAP's all-currencies marker, not a currency: such a customer leaves the choice to
        // the cashier rather than writing a code no option matches into the document.
        if (InvoiceEntry.DocumentCurrency(bp.Currency) is { } currency)
        {
            invoice.DocCurrency = currency;
        }

        // Clear validation error
        validationErrors.Remove("Customer");

        // Repaint immediately with the new BP selection while the fresh price lookup is loading.
        customerPricing.Clear();
        customerPriceListNum = bp.PriceListNum;
        isLoadingCustomerPrices = true;
        UpdateExistingLinePrices();
        await InvokeAsync(StateHasChanged);

        var pricingLoaded = await LoadBusinessPartnerPricesAsync(
            bp,
            requestVersion,
            businessPartnerPricingCts?.Token ?? CancellationToken.None);

        if (!pricingLoaded)
        {
            return;
        }

        // Update prices on any existing lines to reflect the customer's price list
        UpdateExistingLinePrices();
        StateHasChanged();
    }

    private void ClearSelectedBP()
    {
        CancelBusinessPartnerPricingRequest();
        selectedBusinessPartner = null;
        invoice.CardCode = string.Empty;
        customerPricing.Clear();
        customerPriceListNum = null;
        isLoadingCustomerPrices = false;
        UpdateExistingLinePrices();
    }

    private void UpdateExistingLinePrices()
    {
        for (var i = 0; i < invoice.Lines.Count; i++)
        {
            var line = invoice.Lines[i];
            if (!string.IsNullOrEmpty(line.ItemCode))
            {
                var product = cachedProducts.FirstOrDefault(p => p.ItemCode == line.ItemCode);
                var defaultPrice = product?.Price ?? 0m;
                ApplyPricing(line, GetPricingForItem(line.ItemCode, defaultPrice));

                if (line.UnitPrice.GetValueOrDefault() > 0)
                {
                    ClearUnitPriceError(i);
                }
                else
                {
                    line.UnitPrice = 0;
                    SetMissingSapPriceError(i, line.ItemCode);
                }
            }
        }
    }

    private void SetMissingSapPriceError(int index, string? itemCode)
    {
        if (!lineValidationErrors.TryGetValue(index, out var errors))
        {
            errors = new Dictionary<string, string>();
            lineValidationErrors[index] = errors;
        }

        errors["UnitPrice"] = MissingSapPriceMessage;
        errorMessage = $"Item {(string.IsNullOrWhiteSpace(itemCode) ? "selected" : itemCode)} has no price set in SAP. Please contact the admin.";
    }

    private void ClearUnitPriceError(int index)
    {
        if (!lineValidationErrors.TryGetValue(index, out var errors))
        {
            return;
        }

        errors.Remove("UnitPrice");

        if (errors.Count == 0)
        {
            lineValidationErrors.Remove(index);
        }
    }

    private async Task LoadCustomerPriceList(int priceListNum)
    {
        isLoadingCustomerPrices = true;
        StateHasChanged();

        try
        {
            Logger.LogInformation("Loading prices from customer price list {PriceListNum}", priceListNum);

            var response = await PriceService.GetPricesByPriceListAsync(priceListNum);

            if (response?.Prices != null && response.Prices.Any())
            {
                customerPricing.Clear();
                foreach (var price in response.Prices)
                {
                    if (!string.IsNullOrEmpty(price.ItemCode))
                    {
                        customerPricing[price.ItemCode] = ResolvedItemPrice.Flat(price.Price);
                    }
                }
                customerPriceListNum = priceListNum;

                Logger.LogInformation("Loaded {Count} live prices from customer price list {PriceListNum}",
                customerPricing.Count, priceListNum);
            }
            else
            {
                Logger.LogWarning("No prices found for price list {PriceListNum}", priceListNum);
                customerPricing.Clear();
                customerPriceListNum = null;
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error loading customer price list {PriceListNum}", priceListNum);
            customerPricing.Clear();
            customerPriceListNum = null;
        }
        finally
        {
            isLoadingCustomerPrices = false;
            StateHasChanged();
        }
    }

    private async Task<bool> LoadBusinessPartnerPricesAsync(
        BusinessPartnerDto bp,
        int requestVersion,
        CancellationToken cancellationToken)
    {
        isLoadingCustomerPrices = true;
        StateHasChanged();

        try
        {
            var lookup = await BusinessPartnerPricingService.LoadPriceLookupAsync(bp, cancellationToken);

            if (!IsCurrentBusinessPartnerPricingRequest(bp, requestVersion, cancellationToken))
            {
                return false;
            }

            customerPricing = lookup.Pricing;
            customerPriceListNum = lookup.PriceListNum;
            return true;
        }
        catch (OperationCanceledException)
        {
            return false;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error loading invoice prices for {CardCode}", bp.CardCode);
            customerPricing.Clear();
            customerPriceListNum = null;
            return IsCurrentBusinessPartnerPricingRequest(bp, requestVersion, cancellationToken);
        }
        finally
        {
            if (requestVersion == businessPartnerPricingRequestVersion)
            {
                isLoadingCustomerPrices = false;
                StateHasChanged();
            }
        }
    }

    private int BeginBusinessPartnerPricingRequest()
    {
        CancelBusinessPartnerPricingRequest();
        businessPartnerPricingCts = new CancellationTokenSource();
        businessPartnerPricingRequestVersion++;
        return businessPartnerPricingRequestVersion;
    }

    private void CancelBusinessPartnerPricingRequest()
    {
        businessPartnerPricingCts?.Cancel();
        businessPartnerPricingCts?.Dispose();
        businessPartnerPricingCts = null;
    }

    private bool IsCurrentBusinessPartnerPricingRequest(
        BusinessPartnerDto bp,
        int requestVersion,
        CancellationToken cancellationToken)
    {
        return !cancellationToken.IsCancellationRequested &&
            requestVersion == businessPartnerPricingRequestVersion &&
            string.Equals(selectedBusinessPartner?.CardCode, bp.CardCode, StringComparison.OrdinalIgnoreCase);
    }

    private async Task LoadCustomerPriceListFallback(int priceListNum)
    {
        try
        {
            Logger.LogInformation("Fallback: loading prices from price list {PriceListNum}", priceListNum);

            var response = await PriceService.GetPricesByPriceListAsync(priceListNum);
            if (response?.Prices != null && response.Prices.Any())
            {
                customerPricing.Clear();
                foreach (var price in response.Prices)
                {
                    if (!string.IsNullOrEmpty(price.ItemCode))
                    {
                        customerPricing[price.ItemCode] = ResolvedItemPrice.Flat(price.Price);
                    }
                }
                customerPriceListNum = priceListNum;
                Logger.LogInformation("Fallback: loaded {Count} live prices for price list {PriceListNum}",
customerPricing.Count, priceListNum);
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Fallback price loading also failed for price list {PriceListNum}", priceListNum);
        }
    }

    private ResolvedItemPrice GetPricingForItem(string? itemCode, decimal defaultPrice)
    {
        if (string.IsNullOrEmpty(itemCode))
            return ResolvedItemPrice.Flat(defaultPrice);

        // If customer has a price list with this item, use that price
        if (customerPricing.TryGetValue(itemCode, out var customerPrice))
        {
            return customerPrice;
        }

        // Fall back to default product price
        return ResolvedItemPrice.Flat(defaultPrice);
    }

    /// <summary>
    /// Shows a customer's special price the way SAP does - the price list price in Unit Price and the
    /// gap in Discount % - rather than collapsing both into a net price with an empty discount.
    /// </summary>
    private static void ApplyPricing(CreateInvoiceLineRequest line, ResolvedItemPrice pricing)
    {
        line.UnitPrice = pricing.UnitPrice;
        line.DiscountPercent = pricing.DiscountPercent;
    }

    private bool HasSpecialPrice(string? itemCode)
        => !string.IsNullOrEmpty(itemCode)
            && customerPricing.TryGetValue(itemCode, out var pricing)
            && pricing.DiscountPercent > 0;

    private decimal GetDisplayPrice(decimal amount)
    {
        return AppSettings.ShowPricesWithTax ? amount * (1 + VatRate) : amount;
    }

    private decimal GetDisplayLineTotal(CreateInvoiceLineRequest line)
    {
        return AppSettings.ShowPricesWithTax ? CalculateLineTotalInclVat(line) : CalculateLineTotal(line);
    }

    private decimal GetAlternateLineTotal(CreateInvoiceLineRequest line)
    {
        return AppSettings.ShowPricesWithTax ? CalculateLineTotal(line) : CalculateLineTotalInclVat(line);
    }

    private string DisplayPriceLabel => AppSettings.ShowPricesWithTax ? "incl. VAT" : "excl. VAT";

    private string AlternatePriceLabel => AppSettings.ShowPricesWithTax ? "excl. VAT" : "incl. VAT";

    private void AddLine()
    {
        var newLine = new CreateInvoiceLineRequest
        {
            Quantity = 1,
            // Empty when the resolver found nothing usable — "Warehouse is required" then asks the
            // cashier to pick one, rather than the line carrying a warehouse the bar never showed.
            WarehouseCode = warehouseCode ?? string.Empty
        };

        // Apply default cost centre if set
        if (!string.IsNullOrEmpty(defaultCostCentre))
        {
            newLine.CostCentreCode = defaultCostCentre;
        }

        invoice.Lines.Add(newLine);
    }

    private void RemoveLine(int index)
    {
        if (index >= 0 && index < invoice.Lines.Count)
        {
            invoice.Lines.RemoveAt(index);
            lineValidationErrors.Remove(index);
            justAddedIndex = -1;

            // Re-index the errors of the lines below
            var newErrors = new Dictionary<int, Dictionary<string, string>>();

            foreach (var kvp in lineValidationErrors.OrderBy(x => x.Key))
            {
                if (kvp.Key < index)
                {
                    newErrors[kvp.Key] = kvp.Value;
                }
                else if (kvp.Key > index)
                {
                    newErrors[kvp.Key - 1] = kvp.Value;
                }
            }

            lineValidationErrors = newErrors;
        }
    }

    // Unit Price is the price before discount, so the discount has to come off here or the
    // totals disagree with what SAP bills.
    private static decimal CalculateLineTotal(CreateInvoiceLineRequest line) =>
        InvoiceEntry.LineNet(line.Quantity, line.UnitPrice, line.DiscountPercent);

    // The sum of the line amounts as drawn. It used to add the lines up before their discounts, so
    // a customer's special price — carried as a discount — showed in each line but not in the total.
    private decimal CalculateSubtotal()
    {
        return invoice.Lines.Sum(CalculateLineTotal);
    }

    private decimal CalculateVatAmount()
    {
        return CalculateSubtotal() * VatRate;
    }

    private decimal CalculateTotalInclVat()
    {
        return CalculateSubtotal() * (1 + VatRate);
    }

    private decimal CalculateLineTotalInclVat(CreateInvoiceLineRequest line)
    {
        return CalculateLineTotal(line) * (1 + VatRate);
    }

    private bool ValidateForm()
    {
        validationErrors.Clear();
        lineValidationErrors.Clear();
        var isValid = true;

        // Validate customer
        if (string.IsNullOrWhiteSpace(invoice.CardCode))
        {
            validationErrors["Customer"] = "Please select a customer";
            isValid = false;
        }

        // Validate lines
        if (!invoice.Lines.Any())
        {
            validationErrors["Lines"] = "At least one line item is required";
            isValid = false;
        }

        if (invoice.CrateQuantity.HasValue && invoice.CrateQuantity.Value < 0)
        {
            validationErrors["CrateQuantity"] = "Crate quantity cannot be negative";
            isValid = false;
        }

        for (int i = 0; i < invoice.Lines.Count; i++)
        {
            var line = invoice.Lines[i];
            var errors = new Dictionary<string, string>();

            // Item code required
            if (string.IsNullOrWhiteSpace(line.ItemCode))
            {
                errors["ItemCode"] = "Item code is required";
                isValid = false;
            }

            // Warehouse required
            if (string.IsNullOrWhiteSpace(line.WarehouseCode))
            {
                errors["Warehouse"] = "Warehouse is required";
                isValid = false;
            }

            // Quantity validation - must be positive
            if (line.Quantity <= 0)
            {
                errors["Quantity"] = "Quantity must be greater than zero";
                isValid = false;
            }

            // Unit price validation - must be greater than zero
            if (!line.UnitPrice.HasValue || line.UnitPrice.Value <= 0)
            {
                errors["UnitPrice"] = MissingSapPriceMessage;
                isValid = false;
            }

            // Batch number is optional - auto-allocated using FEFO if not specified
            // The API will handle batch selection automatically

            // A line the warehouse is known to be short for is stopped here rather than sent for SAP
            // to refuse. Only a figure that came back counts: an unknown one goes through, and the
            // API's own check at posting has the last word either way.
            var stock = LineStockOf(line);
            if (stock.IsShort)
            {
                errors["Stock"] = ShortText(line, stock);
                isValid = false;
            }

            if (errors.Any())
            {
                lineValidationErrors[i] = errors;
            }
        }

        return isValid;
    }

    private async Task SubmitInvoice()
    {
        errorMessage = null;
        successMessage = null;

        if (!ValidateForm())
        {
            // No banner: the action bar already lists what is wrong and clears each item as it is
            // fixed, where a banner would stay up after the form was put right. It is drawn louder
            // instead, so the refused press is still answered.
            postRefused = true;
            Logger.LogWarning("Invoice validation failed. Errors: {Errors}",
            string.Join("; ", validationErrors.Select(e => $"{e.Key}: {e.Value}")
            .Concat(lineValidationErrors.SelectMany(le => le.Value.Select(e => $"Line {le.Key + 1} {e.Key}: {e.Value}")))));
            return;
        }

        isSubmitting = true;

        // Minted here rather than in the service so the draft saved on the render during the post
        // already carries it: a reload mid-submit then resubmits under the same key, and the API
        // replays the invoice instead of posting it twice.
        if (string.IsNullOrWhiteSpace(invoice.ClientRequestId))
        {
            invoice.ClientRequestId = Guid.NewGuid().ToString("N");
        }

        try
        {
            // Log the invoice request for debugging
            Logger.LogInformation("Creating invoice for customer {CardCode} with {LineCount} lines",
            invoice.CardCode, invoice.Lines.Count);

            foreach (var (line, index) in invoice.Lines.Select((l, i) => (l, i)))
            {
                Logger.LogDebug("Line {LineNum}: ItemCode={ItemCode}, Qty={Quantity}, Price={Price}, Warehouse={Warehouse}, Batch={Batch}, Account={Account}",
                index + 1,
                line.ItemCode,
                line.Quantity,
                line.UnitPrice,
                line.WarehouseCode,
                string.IsNullOrEmpty(line.BatchNumber) ? "(auto-FEFO)" : line.BatchNumber,
                line.AccountCode ?? "(default)");

                // Log batch numbers if specified
                if (line.BatchNumbers?.Any() == true)
                {
                    foreach (var batch in line.BatchNumbers)
                    {
                        Logger.LogDebug(" Batch: {BatchNumber}, Qty: {Quantity}", batch.BatchNumber, batch.Quantity);
                    }
                }
            }

            var (success, message, createdInvoice, fiscalization) = await InvoiceService.CreateInvoiceAsync(invoice);

            if (success)
            {
                Logger.LogInformation("Invoice #{DocNum} (DocEntry: {DocEntry}) created successfully for customer {CardCode}",
                createdInvoice?.DocNum, createdInvoice?.DocEntry, invoice.CardCode);

                var postCreateInvoice = createdInvoice;
                var postCreateNotifyByEmail = notifyCustomerByEmail;
                var postCreateCardCode = createdInvoice?.CardCode ?? invoice.CardCode;
                var postCreateCustomerName = selectedBusinessPartner?.CardName ?? createdInvoice?.CardName ?? "Customer";
                var postCreateCustomerEmail = selectedBusinessPartner?.Email;

                // Build success message with fiscalisation status
                if (fiscalization?.Queued == true)
                {
                    successMessage = $"Invoice #{createdInvoice?.DocNum} created successfully. Fiscalisation is running in the background.";
                }
                else if (fiscalization != null && fiscalization.Success)
                {
                    successMessage = $"Invoice #{createdInvoice?.DocNum} created and fiscalised successfully! Receipt: {fiscalization.ReceiptGlobalNo}";
                }
                else if (fiscalization != null && fiscalization.Skipped)
                {
                    successMessage = $"Invoice #{createdInvoice?.DocNum} created successfully! (Fiscalisation skipped)";
                }
                else if (fiscalization != null && !fiscalization.Success)
                {
                    successMessage = $"Invoice #{createdInvoice?.DocNum} created successfully!";
                    errorMessage = $"Fiscalisation failed: {fiscalization.Message ?? "Unknown error"}. The invoice was posted to SAP but not fiscalised.";
                }
                else
                {
                    successMessage = $"Invoice #{createdInvoice?.DocNum} created successfully!";
                }

                // Store reference for manual print button
                lastCreatedInvoice = createdInvoice;
                lastFiscalizationResult = fiscalization;

                await RememberCustomerAsync(postCreateCardCode);
                ClearForm();
                QueueInvoicePostCreateWork(
                    postCreateInvoice,
                    postCreateNotifyByEmail,
                    postCreateCardCode,
                    postCreateCustomerName,
                    postCreateCustomerEmail,
                    fiscalization);
            }
            else
            {
                Logger.LogError("Failed to create invoice for customer {CardCode}. Error: {Error}",
                invoice.CardCode, message);
                errorMessage = message;
                // Audit log: invoice creation failed
                await AuditService.LogAsync(AuditActions.CreateInvoice, "Invoice", invoice.CardCode, null, false, message);
            }
        }
        catch (HttpRequestException httpEx)
        {
            Logger.LogError(httpEx, "HTTP error creating invoice for customer {CardCode}. Status: {StatusCode}",
            invoice.CardCode, httpEx.StatusCode);
            errorMessage = $"Network error: {httpEx.Message}. Please check if the API is running.";
        }
        catch (TaskCanceledException tcEx) when (tcEx.InnerException is TimeoutException)
        {
            Logger.LogError(tcEx, "Timeout creating invoice for customer {CardCode}", invoice.CardCode);
            errorMessage = "Request timed out. The server may be busy, please try again.";
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Unexpected error creating invoice for customer {CardCode}. Exception: {ExceptionType}",
            invoice.CardCode, ex.GetType().Name);
            errorMessage = $"Error creating invoice: {ex.Message}";
        }
        finally
        {
            isSubmitting = false;
        }
    }

    private void QueueInvoicePostCreateWork(
        InvoiceDto? createdInvoice,
        bool notifyByEmail,
        string? cardCode,
        string customerName,
        string? customerEmail,
        FiscalizationResult? fiscalization)
    {
        _ = InvokeAsync(async () =>
        {
            try
            {
                var notificationNote = await TrySendCustomerInvoiceNotificationAsync(
                    createdInvoice,
                    notifyByEmail,
                    cardCode,
                    customerName,
                    customerEmail);

                if (!string.IsNullOrWhiteSpace(notificationNote) && !string.IsNullOrWhiteSpace(successMessage))
                {
                    successMessage = $"{successMessage} {notificationNote}";
                    StateHasChanged();
                }

                await TryAutoPrintInvoiceAsync(createdInvoice, fiscalization?.QRCode);
                await AuditService.LogAsync(AuditActions.CreateInvoice, "Invoice", createdInvoice?.DocNum.ToString());
            }
            catch (Exception ex)
            {
                Logger.LogWarning(ex, "Invoice post-create work failed for invoice {DocNum}", createdInvoice?.DocNum);
            }
        });
    }

    private async Task<string?> TrySendCustomerInvoiceNotificationAsync(
        InvoiceDto? createdInvoice,
        bool notifyByEmail,
        string? cardCode,
        string customerName,
        string? customerEmail)
    {
        if (!notifyByEmail)
        {
            return null;
        }

        if (createdInvoice == null)
        {
            Logger.LogWarning("Invoice created but no invoice details were returned. Skipping email notification.");
            return "Notification email skipped (invoice details unavailable).";
        }

        cardCode ??= createdInvoice.CardCode;
        customerName = string.IsNullOrWhiteSpace(customerName)
            ? createdInvoice.CardName ?? "Customer"
            : customerName;

        if (string.IsNullOrWhiteSpace(customerEmail) && !string.IsNullOrWhiteSpace(cardCode))
        {
            var bp = await BusinessPartnerService.GetBusinessPartnerByCodeAsync(cardCode);
            if (bp != null)
            {
                customerEmail = bp.Email;
                if (!string.IsNullOrWhiteSpace(bp.CardName))
                {
                    customerName = bp.CardName;
                }
            }
        }

        if (string.IsNullOrWhiteSpace(customerEmail))
        {
            Logger.LogWarning("No email found for customer {CardCode}. Skipping invoice notification.", cardCode);
            return "Notification email skipped (customer email missing).";
        }

        var sent = await EmailService.SendCustomerInvoiceNotificationAsync(
        customerEmail,
        customerName,
        createdInvoice.DocEntry,
        createdInvoice.DocNum.ToString(),
        createdInvoice.DocTotal);

        if (sent)
        {
            Logger.LogInformation("Invoice notification email sent to {Email} for invoice {DocNum}.",
            customerEmail, createdInvoice.DocNum);
            return "Notification email sent.";
        }

        Logger.LogWarning("Failed to send invoice notification email to {Email} for invoice {DocNum}.",
        customerEmail, createdInvoice.DocNum);
        return "Notification email failed to send.";
    }

    private async Task TryAutoPrintInvoiceAsync(InvoiceDto? createdInvoice, string? fiscalQrCode)
    {
        try
        {
            var autoPrint = await AppSettingsService.GetValueAsync<bool>(SettingKeys.AutoPrintInvoice);
            if (!autoPrint || createdInvoice == null)
                return;

            Logger.LogInformation("Auto-printing invoice #{DocNum} (DocEntry: {DocEntry})",
            createdInvoice.DocNum, createdInvoice.DocEntry);

            var pdfBytes = await InvoiceService.GetInvoicePdfAsync(createdInvoice.DocEntry, fiscalQrCode);
            if (pdfBytes == null || pdfBytes.Length == 0)
            {
                Logger.LogWarning("Failed to retrieve PDF for auto-print of invoice #{DocNum}", createdInvoice.DocNum);
                return;
            }

            var copies = await AppSettingsService.GetValueAsync<int>(SettingKeys.PrintCopies);
            copies = Math.Clamp(copies, 1, 10);

            var base64 = Convert.ToBase64String(pdfBytes);
            await JS.InvokeVoidAsync("printPdfFromBase64", base64);

            // The browser's dialog is what the cashier sets copies in; we can only open it once.
            Logger.LogInformation("Auto-print dialog opened for invoice #{DocNum} ({Copies} copies intended)",
            createdInvoice.DocNum, copies);
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Auto-print failed for invoice. Error: {Message}", ex.Message);
            // Don't fail the invoice creation if printing fails
        }
    }

    private void DismissSuccess()
    {
        successMessage = null;
        lastCreatedInvoice = null;
        lastFiscalizationResult = null;
    }

    private async Task OpenPrintDialog()
    {
        if (lastCreatedInvoice == null)
            return;

        try
        {
            printCopies = await AppSettingsService.GetValueAsync<int>(SettingKeys.PrintCopies);
            printCopies = Math.Clamp(printCopies, 1, 10);
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Error loading print settings");
            printCopies = 1;
        }

        showPrintDialog = true;
    }

    private async Task ExecutePrint()
    {
        if (lastCreatedInvoice == null || isPrinting)
            return;

        isPrinting = true;
        try
        {
            printCopies = Math.Clamp(printCopies, 1, 10);

            // Remember the copy count as the new default for the next invoice.
            await AppSettingsService.SaveSettingAsync(SettingKeys.PrintCopies, printCopies.ToString());

            var pdfBytes = await InvoiceService.GetInvoicePdfAsync(lastCreatedInvoice.DocEntry, lastFiscalizationResult?.QRCode);
            if (pdfBytes == null || pdfBytes.Length == 0)
            {
                errorMessage = "Failed to retrieve invoice PDF for printing.";
                return;
            }

            var base64 = Convert.ToBase64String(pdfBytes);
            await JS.InvokeVoidAsync("printPdfFromBase64", base64);

            Logger.LogInformation("Print dialog opened for invoice #{DocNum} ({Copies} copies intended)",
            lastCreatedInvoice.DocNum, printCopies);

            showPrintDialog = false;
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Print failed for invoice. Error: {Message}", ex.Message);
            errorMessage = $"Print failed: {ex.Message}";
        }
        finally
        {
            isPrinting = false;
        }
    }

    private async Task DownloadInvoicePdf()
    {
        if (lastCreatedInvoice == null || isPrinting)
            return;

        isPrinting = true;
        try
        {
            var pdfBytes = await InvoiceService.GetInvoicePdfAsync(lastCreatedInvoice.DocEntry, lastFiscalizationResult?.QRCode);
            if (pdfBytes == null || pdfBytes.Length == 0)
            {
                errorMessage = "Failed to retrieve invoice PDF.";
                return;
            }

            var base64 = Convert.ToBase64String(pdfBytes);
            var fileName = $"Invoice_{lastCreatedInvoice.DocNum}.pdf";
            await JS.InvokeVoidAsync("downloadPdfFromBase64", base64, fileName);

            Logger.LogInformation("PDF downloaded for invoice #{DocNum}", lastCreatedInvoice.DocNum);
            showPrintDialog = false;
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "PDF download failed for invoice. Error: {Message}", ex.Message);
            errorMessage = $"Download failed: {ex.Message}";
        }
        finally
        {
            isPrinting = false;
        }
    }

    private void ClearForm()
    {
        // The next render sees an empty form and removes the stored draft.
        draftNotice = null;
        invoice = new CreateInvoiceRequest
        {
            DocCurrency = AppSettings.DefaultCurrency,
            Lines = new List<CreateInvoiceLineRequest>()
        };
        lineValidationErrors.Clear();
        validationErrors.Clear();
        ClearSelectedBP();
        ResetEntry();
        showShortOnly = false;
        postRefused = false;
        justAddedIndex = -1;
        ForgetStockFigures();
    }

    public void Dispose()
    {
        CancelBusinessPartnerPricingRequest();
        ForgetStockFigures();
    }
}
