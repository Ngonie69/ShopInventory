                    }
                    there.
                </div>
            </div>
            <div class="sfm-dialog-ft">
                <button type="button" class="sfm-btn" @onclick="DownloadInvoicePdf" disabled="@isPrinting">
                    <i class="ph ph-download-simple"></i>Download PDF
                </button>
                <button type="button" class="sfm-btn" @onclick="() => showPrintDialog = false">Cancel</button>
                <button type="button" class="sfm-btn-solid" @onclick="ExecutePrint" disabled="@isPrinting">
                    @if (isPrinting)
                    {
                        <span class="sfm-spin on-solid"></span>
                    }
                    else
                    {
                        <i class="ph ph-printer"></i>
                    }
                    Print
                </button>
            </div>
        </div>
    </div>
}

