@page "/invoices/create"
@using Microsoft.AspNetCore.Authorization
@using Microsoft.JSInterop
@using ShopInventory.Web.Data
@attribute [Authorize(Roles = "Admin,Cashier")]
@inject IInvoiceService InvoiceService
@inject IProductService ProductService
@inject IPriceService PriceService
@inject IBusinessPartnerPricingService BusinessPartnerPricingService
@inject IBusinessPartnerService BusinessPartnerService
@inject IEmailService EmailService
@inject IMasterDataCacheService CacheService
@inject IAppSettingsService AppSettingsService
@inject IAppSettingsProvider AppSettings
@inject IJSRuntime JS
@inject NavigationManager NavigationManager
@inject ILogger<CreateInvoice> Logger
@inject AuthenticationStateProvider AuthStateProvider
@inject IAuditService AuditService
@rendermode InteractiveServer
@implements IDisposable

<PageTitle>Create Invoice - Shop Inventory</PageTitle>

@* Styles live in wwwroot/css/create-invoice.css (linked from App.razor). The
   imported design is a dark scheme; that file carries it and its light
   counterpart, and follows the app's theme toggle like every other page. *@

<div class="civ">
    <div class="civ-accentbar"></div>
    <div class="civ-shell">

        <!-- ── Breadcrumb strip ───────────────────────────────────────── -->
        <div class="civ-crumbs">
            <a href="/invoices">Invoices</a>
            <span class="civ-crumb-sep">/</span>
            <span class="civ-crumb-now">Create new</span>
            <span class="civ-spacer"></span>
            <span class="civ-pill @CacheStateClass">
                <span class="civ-dot"></span>@CacheStateLabel
            </span>
            <button type="button" class="civ-btn" @onclick="RefreshMasterData" disabled="@isRefreshingCache">
                @if (isRefreshingCache)
                {
                    <span class="civ-spin"></span>
                }
                else
                {
                    <i class="ph ph-arrows-clockwise"></i>
                }
                Refresh
            </button>
            <a href="/invoices" class="civ-btn"><i class="ph ph-arrow-left"></i>Back</a>
        </div>

        <!-- ── Head ───────────────────────────────────────────────────── -->
        <div class="civ-head">
            <div class="civ-head-main">
                <h1>Create invoice</h1>
                <p>Sales invoice with batch tracking &middot; posts directly to SAP Business One</p>
            </div>
            <div class="civ-stats">
                <div class="civ-stat">
                    <div class="civ-stat-k">Lines</div>
                    <div class="civ-stat-v">@invoice.Lines.Count</div>
                </div>
                <div class="civ-stat">
                    <div class="civ-stat-k">Subtotal</div>
                    <div class="civ-stat-v">@CalculateSubtotal().ToString("N2")</div>
                </div>
                <div class="civ-stat">
                    <div class="civ-stat-k">VAT @VatLabel</div>
                    <div class="civ-stat-v is-vat">@CalculateVatAmount().ToString("N2")</div>
                </div>
                <div class="civ-stat">
                    <div class="civ-stat-k">Invoice total</div>
                    <div class="civ-stat-v is-total">@CalculateTotalInclVat().ToString("N2")</div>
                </div>
            </div>
        </div>

        <!-- ── Alerts ─────────────────────────────────────────────────── -->
        @if (!string.IsNullOrEmpty(successMessage))
        {
            <div class="civ-alert is-ok">
                <i class="ph-fill ph-check-circle"></i>
                <div class="civ-alert-bd">
                    @successMessage
                    @if (lastCreatedInvoice != null)
                    {
                        <button type="button" class="civ-btn civ-gap-sm" @onclick="OpenPrintDialog"
                                disabled="@isPrinting">
                            <i class="ph ph-printer"></i>Print invoice
                        </button>
                    }
                </div>
                <button type="button" class="civ-alert-x" @onclick="DismissSuccess" aria-label="Dismiss">
                    <i class="ph ph-x"></i>
                </button>
            </div>
        }
        @if (!string.IsNullOrEmpty(errorMessage))
        {
            <div class="civ-alert is-err">
                <i class="ph-fill ph-warning-octagon"></i>
                <div class="civ-alert-bd">@((MarkupString)errorMessage)</div>
                <button type="button" class="civ-alert-x" @onclick="() => errorMessage = null" aria-label="Dismiss">
                    <i class="ph ph-x"></i>
                </button>
            </div>
        }

        <div class="civ-grid">
            <div class="civ-main">

                <!-- ── Customer ───────────────────────────────────────── -->
                <section class="civ-card">
                    <div class="civ-card-hd">
                        <i class="ph ph-user-circle"></i>
                        <h2>Customer</h2>
                        <span class="civ-spacer"></span>
                        <span class="civ-note">@allBusinessPartners.Count.ToString("N0") cached</span>
                    </div>
                    <div class="civ-card-bd civ-fields">
                        @* Not a <label>: the field carries a clear button and a result list, and a
                           label would forward stray clicks on them back to the input. *@
                        <div class="civ-lab civ-span2">
                            <span class="civ-lab-t">Customer <span class="civ-req">*</span></span>
                            <div class="civ-combo">
                                <input class="civ-input @(validationErrors.ContainsKey("Customer") ? "is-bad" : "")"
                                       value="@customerSearch"
                                       @oninput="e => OnCustomerInput(e.Value?.ToString())"
                                       @onfocus="OnCustomerFocus" @onblur="OnCustomerBlur"
                                       placeholder="@(isLoadingBPs ? "Loading customers…" : "Search by code or name…")"
                                       disabled="@isLoadingBPs" autocomplete="off" />
                                @if (selectedBusinessPartner != null)
                                {
                                    <button type="button" class="civ-combo-clear" @onclick="ClearCustomer"
                                            title="Clear customer">
                                        <i class="ph ph-x"></i>
                                    </button>
                                }
                                @if (showCustomerDrop)
                                {
                                    <div class="civ-drop is-wide">
                                        @if (customerMatches.Count == 0)
                                        {
                                            <div class="civ-drop-empty">No customers match that search.</div>
                                        }
                                        else
                                        {
                                            @foreach (var bp in customerMatches)
                                            {
                                                <button type="button" class="civ-drop-i"
                                                        @onmousedown:preventDefault="true"
                                                        @onclick="() => PickCustomerAsync(bp)">
                                                    <span>
                                                        <span class="civ-drop-code">@bp.CardCode</span>
                                                        <span class="civ-drop-sub">@bp.CardName</span>
                                                    </span>
                                                    @if (!string.IsNullOrEmpty(bp.Currency))
                                                    {
                                                        <span class="civ-note">@bp.Currency</span>
                                                    }
                                                </button>
                                            }
                                        }
                                    </div>
                                }
                            </div>
                            @if (validationErrors.ContainsKey("Customer"))
                            {
                                <div class="civ-field-err">@validationErrors["Customer"]</div>
                            }
                        </div>
                        <label class="civ-lab">
                            <span class="civ-lab-t">Customer reference</span>
                            <input class="civ-input" @bind="invoice.NumAtCard" placeholder="PO / reference number" />
                        </label>
                        <label class="civ-lab">
                            <span class="civ-lab-t">Currency</span>
                            <select class="civ-select" @bind="invoice.DocCurrency">
                                <option value="USD">USD &mdash; US Dollar</option>
                                <option value="ZIG">ZIG &mdash; Zimbabwe Gold</option>
                            </select>
                        </label>
                        <label class="civ-lab">
                            <span class="civ-lab-t">Crates expected</span>
                            <input type="number" min="0" step="0.01"
                                   class="civ-input @(validationErrors.ContainsKey("CrateQuantity") ? "is-bad" : "")"
                                   @bind="invoice.CrateQuantity" placeholder="0" />
                            @if (validationErrors.ContainsKey("CrateQuantity"))
                            {
                                <div class="civ-field-err">@validationErrors["CrateQuantity"]</div>
                            }
                        </label>
                        <label class="civ-lab civ-span3">
                            <span class="civ-lab-t">Comments</span>
                            <input class="civ-input" @bind="invoice.Comments"
                                   placeholder="Optional notes shown on the printed invoice" />
                        </label>
                        @if (selectedBusinessPartner != null)
                        {
                            <div class="civ-lab">
                                <span class="civ-lab-t">Price list</span>
                                <div class="civ-field-meta">
                                    @if (customerPriceListNum.HasValue)
                                    {
                                        <i class="ph ph-tag"></i>

                                        <span>#@customerPriceListNum</span>
                                        @if (isLoadingCustomerPrices)
                                        {
                                            <span class="civ-spin"></span>
                                        }
                                        else
                                        {
                                            <span> &middot; @customerPricing.Count items</span>
                                        }
                                    }
                                    else
                                    {
                                        <i class="ph ph-tag"></i>

                                        <span>Default pricing</span>
                                    }
                                </div>
                            </div>
                        }
                    </div>
                </section>

                <!-- ── Invoice lines ──────────────────────────────────── -->
                <section class="civ-card">
                    <div class="civ-card-hd">
                        <i class="ph ph-list-dashes"></i>
                        <h2>Invoice lines</h2>
                        <span class="civ-count">@invoice.Lines.Count</span>
                        <span class="civ-spacer"></span>
                        <button type="button" class="civ-btn civ-btn-accent" @onclick="AddLine">
                            <i class="ph ph-plus"></i>Add line
                        </button>
                    </div>

                    <div class="civ-defaults">
                        <span class="civ-defaults-k">Defaults</span>
                        <label class="civ-inline-lab">Warehouse
                            <select class="civ-select is-sm" value="@warehouseCode"
                                    @onchange="e => OnDefaultWarehouseChanged(e.Value?.ToString())">
                                <option value="">Select&hellip;</option>
                                @foreach (var warehouse in cachedWarehouses)
                                {
                                    <option value="@warehouse.WarehouseCode">@warehouse.DisplayName</option>
                                }
                            </select>
                        </label>
                        <label class="civ-inline-lab">Cost centre
                            <select class="civ-select is-sm" value="@defaultCostCentre"
                                    @onchange="e => OnDefaultCostCentreChanged(e.Value?.ToString())">
                                <option value="">Default</option>
                                @foreach (var centre in cachedCostCentres.Where(c => c.IsActive))
                                {
                                    <option value="@centre.CenterCode">
                                        @centre.CenterCode &mdash; @TruncateName(centre.CenterName, 25)
                                    </option>
                                }
                            </select>
                        </label>
                        <span class="civ-spacer"></span>
                        <span class="civ-batchmode" title="Batches are always allocated first-expired-first-out">
                            <i class="ph ph-sparkle"></i>Auto batch (FEFO)
                        </span>
                    </div>

                    <div class="civ-lines @(IsPickingProduct ? "is-picking" : "")">
                        <div class="civ-lines-inner">
                            <div class="civ-row is-head">
                                <div></div>
                                <div>Item code <span class="civ-req">*</span></div>
                                <div>Description</div>
                                <div>Warehouse <span class="civ-req">*</span></div>
                                <div class="civ-r">Qty</div>
                                <div class="civ-r">Unit price</div>
                                <div class="civ-r">Disc</div>
                                <div>Batch</div>
                                <div class="civ-r">Amount</div>
                                <div></div>
                            </div>

                            @if (isLoadingMasterData)
                            {
                                <div class="civ-loading">
                                    <span class="civ-spin"></span>Loading products and warehouses&hellip;
                                </div>
                            }
                            else
                            {
                                @for (var i = 0; i < invoice.Lines.Count; i++)
                                {
                                    var index = i;
                                    var line = invoice.Lines[index];
                                    var lineState = GetLineState(index);
                                    var lineErrors = GetLineValidationErrors(index);

                                    <div class="civ-row">
                                        <div class="civ-n">@(index + 1)</div>
                                        <div class="civ-combo">
                                            <input class="civ-input civ-cell @(lineErrors.ContainsKey("ItemCode") ? "is-bad" : "")"
                                                   value="@line.ItemCode"
                                                   @oninput="e => OnItemCodeInput(index, e.Value?.ToString())"
                                                   @onkeydown="e => OnItemCodeKeyDown(index, e)"
                                                   @onfocus="() => OnItemCodeFocus(index)"
                                                   @onblur="() => OnItemCodeBlur(index)"
                                                   placeholder="Select&hellip;" autocomplete="off" />
                                            @if (lineState.ShowProductDropdown && lineState.FilteredProducts.Any())
                                            {
                                                <div class="civ-drop is-wide">
                                                    @foreach (var product in lineState.FilteredProducts.Take(15))
                                                    {
                                                        var pricing = GetPricingForItem(product.ItemCode, product.Price);
                                                        var isCustomerPrice = customerPricing.ContainsKey(product.ItemCode ?? string.Empty);
                                                        <button type="button"
                                                                class="civ-drop-i @(lineState.SuggestedProduct == product ? "is-sel" : "")"
                                                                @onmousedown:preventDefault="true"
                                                                @onclick="() => SelectProduct(index, product)">
                                                            <span>
                                                                <span class="civ-drop-code">@product.ItemCode</span>
                                                                <span class="civ-drop-sub">@TruncateName(product.ItemName, 30)</span>
                                                            </span>
                                                            <span class="civ-drop-price @(isCustomerPrice ? "is-customer" : "")">
                                                                @GetDisplayPrice(pricing.NetPrice).ToString("N2")
                                                                <small>@DisplayPriceLabel</small>
                                                            </span>
                                                        </button>
                                                    }
                                                </div>
                                            }
                                        </div>
                                        <input class="civ-input civ-desc" @bind="line.ItemDescription"
                                               placeholder="Description" />
                                        <select class="civ-select civ-cell @(lineErrors.ContainsKey("Warehouse") ? "is-bad" : "")"
                                                value="@line.WarehouseCode"
                                                @onchange="e => OnLineWarehouseChanged(index, e.Value?.ToString())">
                                            <option value="">Select&hellip;</option>
                                            @foreach (var warehouse in cachedWarehouses)
                                            {
                                                <option value="@warehouse.WarehouseCode">@warehouse.DisplayName</option>
                                            }
                                        </select>
                                        <input type="number" min="0.001" step="0.001"
                                               class="civ-input civ-num @(lineErrors.ContainsKey("Quantity") ? "is-bad" : "")"
                                               value="@line.Quantity"
                                               @onchange="e => OnQuantityChange(index, e.Value?.ToString())" />
                                        <input type="number" min="0" step="0.001"
                                               class="civ-input civ-num @(lineErrors.ContainsKey("UnitPrice") ? "is-bad" : "")"
                                               value="@(line.UnitPrice ?? 0)"
                                               @onchange="e => OnUnitPriceChange(index, e.Value?.ToString())" />
                                        @* step matches SAP's six-decimal discounts so a special price like 5.714286% is not flagged as invalid *@
                                        <input type="number" min="0" max="100" step="0.000001"
                                               class="civ-input civ-num" @bind="line.DiscountPercent" />
                                        <div>
                                            <span class="civ-tag">Auto FEFO</span>
                                        </div>
                                        <div class="civ-r">
                                            <div class="civ-amt-v">@GetDisplayLineTotal(line).ToString("N2")</div>
                                            <div class="civ-amt-x">@AlternatePriceLabel @GetAlternateLineTotal(line).ToString("N2")</div>
                                        </div>
                                        @* The glyph is drawn inline, not set in the icon font: it is this
                                           button's only label, so a font that fails to load would leave an
                                           empty square that reads as a broken control. *@
                                        <button type="button" class="civ-btn-x" title="Remove line"
                                                aria-label="Remove line @(index + 1)"
                                                @onclick="() => RemoveLine(index)">
                                            <svg viewBox="0 0 256 256" aria-hidden="true" focusable="false">
                                                <path d="M205.66,194.34a8,8,0,0,1-11.32,11.32L128,139.31,61.66,205.66a8,8,0,0,1-11.32-11.32L116.69,128,50.34,61.66A8,8,0,0,1,61.66,50.34L128,116.69l66.34-66.35a8,8,0,0,1,11.32,11.32L139.31,128Z" />
                                            </svg>
                                        </button>
                                        @if (lineErrors.Any())
                                        {
                                            <div class="civ-row-err">
                                                @string.Join(" · ", lineErrors.Values)
                                            </div>
                                        }
                                    </div>
                                }

                                <button type="button" class="civ-addline" @onclick="AddLine">
                                    <i class="ph ph-plus"></i>@(invoice.Lines.Any() ? "Add another line" : "Add the first line")
                                </button>
                            }
                        </div>
                    </div>
                </section>
            </div>

            <!-- ── Aside ──────────────────────────────────────────────── -->
            <aside class="civ-aside">

                <div class="civ-card civ-total-card">
                    <div class="civ-total-hd">
                        <span class="civ-total-k">Total incl. VAT</span>
                        <span class="civ-total-cur">@invoice.DocCurrency</span>
                    </div>
                    <div class="civ-total-v">@CalculateTotalInclVat().ToString("N2")</div>
                    <div class="civ-total-sub">
                        @invoice.Lines.Count line(s) &middot; VAT @VatLabel = @CalculateVatAmount().ToString("N2")
                    </div>

                    <label class="civ-check">
                        <input type="checkbox" @bind="notifyCustomerByEmail" />Email customer notification
                    </label>

                    @if (validationErrors.Any() || lineValidationErrors.Any())
                    {
                        <div class="civ-err-panel">
                            <div class="civ-err-panel-t">
                                <i class="ph ph-warning"></i>Please fix the following
                            </div>
                            <ul>
                                @foreach (var error in validationErrors.Values)
                                {
                                    <li>@error</li>
                                }
                                @foreach (var lineError in lineValidationErrors)
                                {
                                    @foreach (var error in lineError.Value.Values)
                                    {
                                        <li>Line @(lineError.Key + 1): @error</li>
                                    }
                                }
                            </ul>
                        </div>
                    }

                    <button type="button" class="civ-btn-solid" @onclick="SubmitInvoice" disabled="@isSubmitting">
                        @if (isSubmitting)
                        {
                            <span class="civ-spin on-solid"></span>
                            <span>Creating&hellip;</span>
                        }
                        else
                        {
                            <i class="ph-fill ph-check-circle"></i>
                            <span>Create invoice</span>
                        }
                    </button>
                    <button type="button" class="civ-btn civ-btn-wide civ-btn-danger civ-gap-sm" @onclick="ClearForm"
                            disabled="@isSubmitting">
                        <i class="ph ph-arrow-counter-clockwise"></i>Clear form
                    </button>
                </div>

                <div class="civ-card civ-panel">
                    <div class="civ-panel-hd">
                        <i class="ph ph-shield-check"></i>
                        <span class="civ-panel-t">Pre-flight checks</span>
                        <span class="civ-spacer"></span>
                        <span class="civ-note">@PassedCheckCount/3</span>
                    </div>
                    <div class="civ-checks">
                        <div class="civ-checks-i @(HasCustomer ? "" : "is-no")">
                            <span class="civ-checks-ic"><i class="ph-fill @(HasCustomer ? "ph-check" : "ph-x")"></i></span>
                            <span>Customer selected</span>
                        </div>
                        <div class="civ-checks-i @(HasLines ? "" : "is-no")">
                            <span class="civ-checks-ic"><i class="ph-fill @(HasLines ? "ph-check" : "ph-x")"></i></span>
                            <span>Line items added</span>
                        </div>
                        <div class="civ-checks-i @(LinesComplete ? "" : "is-no")">
                            <span class="civ-checks-ic"><i class="ph-fill @(LinesComplete ? "ph-check" : "ph-x")"></i></span>
                            <span>All lines complete</span>
                        </div>
                    </div>
                </div>

                <div class="civ-card civ-panel">
                    <div class="civ-panel-hd">
                        <i class="ph ph-database"></i>
                        <span class="civ-panel-t">Cached data</span>
                    </div>
                    <div class="civ-cache">
                        <div class="civ-cache-i"><i class="ph ph-users"></i>@allBusinessPartners.Count.ToString("N0") customers</div>
                        <div class="civ-cache-i"><i class="ph ph-cube"></i>@cachedProducts.Count.ToString("N0") products</div>
                        <div class="civ-cache-i"><i class="ph ph-buildings"></i>@cachedWarehouses.Count.ToString("N0") warehouses</div>
                        <div class="civ-cache-i"><i class="ph ph-git-fork"></i>@cachedCostCentres.Count.ToString("N0") centres</div>
                    </div>
                    @if (lastCacheRefresh.HasValue)
                    {
                        <div class="civ-cache-ft">
                            <i class="ph ph-clock"></i>Last sync @lastCacheRefresh.Value.ToString("HH:mm:ss")
                        </div>
                    }
                </div>

                <div class="civ-info-note">
                    <i class="ph ph-info"></i>
                    <span>Invoices post directly to SAP Business One. Verify batch allocation and pricing before
                        submitting &mdash; posted documents can only be reversed by credit note.</span>
                </div>
            </aside>
        </div>
    </div>
</div>

<!-- ── Print dialog ───────────────────────────────────────────────────── -->
@if (showPrintDialog)
{
    <div class="civ-modal" @onclick="() => showPrintDialog = false">
        <div class="civ-dialog" @onclick:stopPropagation="true">
            <div class="civ-dialog-hd">
                <i class="ph-fill ph-printer"></i>
                <h3>Print invoice #@(lastCreatedInvoice?.DocNum)</h3>
                <span class="civ-spacer"></span>
                <button type="button" class="civ-alert-x" @onclick="() => showPrintDialog = false"
                        aria-label="Close">
                    <i class="ph ph-x"></i>
                </button>
            </div>
            <div class="civ-dialog-bd">
                <label class="civ-lab civ-w-narrow">
                    <span class="civ-lab-t">Copies</span>
                    <input type="number" min="1" max="10" class="civ-input" @bind="printCopies" />
                </label>

                @* A web page cannot name a printer or set a copy count on a job — the browser's own
                   dialog owns both. So this is guidance for the operator, not a device setting. *@
                <div class="civ-field-meta">
                    Your browser's print dialog opens next — choose the printer
                    @if (printCopies > 1)
                    {
                        <text>and set <strong>@printCopies copies</strong></text>
                    }
                    there.
                </div>
            </div>
            <div class="civ-dialog-ft">
                <button type="button" class="civ-btn" @onclick="DownloadInvoicePdf" disabled="@isPrinting">
                    <i class="ph ph-download-simple"></i>Download PDF
                </button>
                <button type="button" class="civ-btn" @onclick="() => showPrintDialog = false">Cancel</button>
                <button type="button" class="civ-btn-solid" @onclick="ExecutePrint" disabled="@isPrinting">
                    @if (isPrinting)
                    {
                        <span class="civ-spin on-solid"></span>
                    }
                    else
                    {
                        <i class="ph ph-printer"></i>
                    }
                    Print
                </button>
            </div>
        </div>
    </div>
}

@code {
    private CreateInvoiceRequest invoice = new()
    {
        DocCurrency = "USD",
        Lines = new List<CreateInvoiceLineRequest>()
    };

    private string? successMessage;
    private string? errorMessage;
    private bool isSubmitting = false;
    private bool isPrinting = false;
    private bool notifyCustomerByEmail = true;
    private InvoiceDto? lastCreatedInvoice;
    private FiscalizationResult? lastFiscalizationResult;

    // Print dialog state. There is no printer to track: the browser's print dialog owns that choice.
    private bool showPrintDialog = false;
    private int printCopies = 1;
    // Seeded from the configured default warehouse on first render — AppSettings is injected, so it
    // cannot be read here at field initialisation.
    private string? warehouseCode;
    private string? defaultCostCentre;

    // VAT rate (15.5%)
    private const decimal VatRate = 0.155m;
    private const string MissingSapPriceMessage = "No price is set for this item in SAP. Please contact the admin.";

    // Loading states

    private bool isLoadingMasterData = true;
    private bool isRefreshingCache = false;
    private DateTime? lastCacheRefresh;

    // Cached data
    private List<ProductDto> cachedProducts = new();
    private List<WarehouseDto> cachedWarehouses = new();
    private List<CostCentreDto> cachedCostCentres = new();

    // Line state tracking for product autocomplete
    private Dictionary<int, LineState> lineStates = new();

    // Validation
    private Dictionary<string, string> validationErrors = new();
    private Dictionary<int, Dictionary<string, string>> lineValidationErrors = new();

    private class LineState
    {
        public string SearchTerm { get; set; } = string.Empty;
        public bool ShowProductDropdown { get; set; } = false;
        public List<ProductDto> FilteredProducts { get; set; } = new();
        public ProductDto? SuggestedProduct { get; set; } = null;
        public string SuggestionSuffix { get; set; } = string.Empty;
    }

    // Business Partner fields
    private List<BusinessPartnerDto> allBusinessPartners = new();
    private BusinessPartnerDto? selectedBusinessPartner;
    private bool isLoadingBPs = true;

    // Customer combobox: the field is a plain input with its own filtered list,
    // so the 1 985 cached customers stay searchable by code or name.
    private string customerSearch = string.Empty;
    private bool showCustomerDrop = false;
    private List<BusinessPartnerDto> customerMatches = new();

    // Customer price list for dynamic pricing
    private Dictionary<string, ResolvedItemPrice> customerPricing = new(StringComparer.OrdinalIgnoreCase);
    private int? customerPriceListNum;
    private bool isLoadingCustomerPrices = false;
    private CancellationTokenSource? businessPartnerPricingCts;
    private int businessPartnerPricingRequestVersion;

    private bool IsCacheReady => CacheService.IsCacheReady;

    private string CacheStateClass => IsCacheReady ? "is-ready" : (isRefreshingCache ? "is-syncing" : "");

    private string CacheStateLabel => IsCacheReady ? "Data ready" : (isRefreshingCache ? "Syncing" : "Offline");

    private string VatLabel => (VatRate * 100).ToString("0.##") + "%";

    // Pre-flight checks
    private bool HasCustomer => selectedBusinessPartner != null;

    private bool HasLines => invoice.Lines.Any();

    private bool LinesComplete => invoice.Lines.Any() && invoice.Lines.All(line =>
        !string.IsNullOrWhiteSpace(line.ItemCode)
        && line.Quantity > 0
        && !string.IsNullOrWhiteSpace(line.WarehouseCode));

    private int PassedCheckCount => (HasCustomer ? 1 : 0) + (HasLines ? 1 : 0) + (LinesComplete ? 1 : 0);

    private bool IsPickingProduct =>
        lineStates.Values.Any(state => state.ShowProductDropdown && state.FilteredProducts.Any());

    private bool _hasInitialized = false;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && !_hasInitialized)
        {
            _hasInitialized = true;

            // Apply default currency from settings
            if (invoice.DocCurrency == "USD" && AppSettings.DefaultCurrency != "USD")
            {
                invoice.DocCurrency = AppSettings.DefaultCurrency;
            }

            // Apply default warehouse from settings. Only on first render, so the manual master-data
            // refresh never overwrites a warehouse the cashier picked in the defaults bar.
            warehouseCode = AppSettings.DefaultWarehouse;

            try
            {
                var authState = await AuthStateProvider.GetAuthenticationStateAsync();
                Logger.LogInformation("Auth state fetched, user authenticated: {IsAuthenticated}",
                authState.User?.Identity?.IsAuthenticated ?? false);
            }
            catch (Exception ex)
            {
                Logger.LogWarning(ex, "Failed to get auth state during initialization");
            }

            // Check if cache is already ready
            if (CacheService.IsCacheReady)
            {
                Logger.LogInformation("Cache is ready, loading from static cache...");
                isLoadingBPs = false;
                isLoadingMasterData = false;
            }

            await LoadAllMasterDataAsync();

            // The defaults bar can only show a warehouse the cache knows about. If the configured
            // one is missing the dropdown reads "Select…" while new lines still carry the code, so
            // say so in the log rather than letting the two diverge silently.
            if (!string.IsNullOrWhiteSpace(warehouseCode)
                && !cachedWarehouses.Any(w => string.Equals(w.WarehouseCode, warehouseCode, StringComparison.OrdinalIgnoreCase)))
            {
                Logger.LogWarning(
                "Default warehouse {Warehouse} from settings is not in the cached warehouse list; the defaults bar cannot pre-select it",
                warehouseCode);
            }

            StateHasChanged();
        }
    }

    private async Task LoadAllMasterDataAsync()
    {
        var showLoading = !CacheService.IsCacheReady;
        if (showLoading)
        {
            isLoadingBPs = true;
            isLoadingMasterData = true;
            StateHasChanged();
        }

        // Use a timeout for slow API calls - don't block the UI forever
        var timeout = TimeSpan.FromSeconds(15);

        try
        {
            // Load data SEQUENTIALLY to avoid EF Core DbContext concurrency issues.
            // Each cache getter creates its own DbContext, but background sync tasks
            // can overlap if multiple getters run in parallel, causing
            // "A second operation was started on this context instance" errors.

            // 1. Warehouses - usually fast
            await LoadWithTimeoutAsync(
            "Warehouses",
            async cancellationToken => cachedWarehouses = await CacheService.GetWarehousesAsync(
                cancellationToken: cancellationToken),
            timeout
            );

            // 2. Cost Centres - usually fast and rarely change
            await LoadWithTimeoutAsync(
            "Cost Centres",
            async cancellationToken => cachedCostCentres = await CacheService.GetCostCentresAsync(
                cancellationToken: cancellationToken),
            timeout
            );

            // Update UI - warehouses and cost centres are loaded
            isLoadingMasterData = cachedWarehouses.Count == 0;
            StateHasChanged();

            // 3. Business Partners - can be slow
            await LoadWithTimeoutAsync(
            "Business Partners",
            async cancellationToken =>
            {
                allBusinessPartners = await CacheService.GetBusinessPartnersAsync(
                    cancellationToken: cancellationToken);
                isLoadingBPs = false;
                await InvokeAsync(StateHasChanged);
            },
            timeout
            );

            // 4. Products - can be slow
            await LoadWithTimeoutAsync(
            "Products",
            async cancellationToken =>
            {
                cachedProducts = await CacheService.GetProductsAsync(cancellationToken: cancellationToken);
                isLoadingMasterData = false;
                await InvokeAsync(StateHasChanged);
            },
            timeout
            );

            lastCacheRefresh = CacheService.GetLastRefreshTime("BusinessPartners") ?? CacheService.GetLastRefreshTime("Warehouses");

            Logger.LogInformation("Loaded master data: {BPCount} customers, {ProductCount} products, {WHCount} warehouses, {CCCount} cost centres",
            allBusinessPartners.Count, cachedProducts.Count, cachedWarehouses.Count, cachedCostCentres.Count);

            if (allBusinessPartners.Count == 0 && cachedProducts.Count == 0 && cachedWarehouses.Count == 0)
            {
                errorMessage = "No master data available. The backend API may be slow or unavailable. Please try clicking 'Refresh'.";
            }
            else if (allBusinessPartners.Count == 0 || cachedProducts.Count == 0)
            {
                // Partial data loaded - show a warning but let user proceed
                var missing = new List<string>();
                if (allBusinessPartners.Count == 0) missing.Add("customers");
                if (cachedProducts.Count == 0) missing.Add("products");
                errorMessage = $"Some data is still loading ({string.Join(", ", missing)}). You may need to click 'Refresh' or wait.";
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error loading master data");
            errorMessage = $"Failed to load master data: {ex.Message}. Please ensure the backend API is running.";
        }
        finally
        {
            isLoadingBPs = false;
            isLoadingMasterData = false;
            StateHasChanged();
        }
    }

    private async Task LoadWithTimeoutAsync(
        string dataName,
        Func<CancellationToken, Task> loadAction,
        TimeSpan timeout)
    {
        try
        {
            using var cts = new CancellationTokenSource(timeout);
            await loadAction(cts.Token);
            Logger.LogDebug("{DataName} loaded successfully", dataName);
        }
        catch (OperationCanceledException)
        {
            Logger.LogWarning(
                "{DataName} load timed out after {Timeout}s - will continue with cached data",
                dataName,
                timeout.TotalSeconds);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error loading {DataName}", dataName);
            // Don't throw - allow other data to load
        }
    }

    private async Task RefreshMasterData()
    {
        isRefreshingCache = true;
        errorMessage = null;
        try
        {
            CacheService.InvalidateCache();
            await LoadAllMasterDataAsync();
            successMessage = "Master data refreshed successfully!";
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error refreshing master data");
            errorMessage = "Failed to refresh master data. Please try again.";
        }
        finally
        {
            isRefreshingCache = false;
        }
    }

    private string TruncateName(string? name, int maxLength)
    {
        if (string.IsNullOrEmpty(name)) return "";
        return name.Length <= maxLength ? name : name.Substring(0, maxLength) + "...";
    }

    private void ApplyCostCentreToAllLines()
    {
        if (!string.IsNullOrEmpty(defaultCostCentre))
        {
            foreach (var line in invoice.Lines)
            {
                line.CostCentreCode = defaultCostCentre;
            }
        }
    }

    // ── Customer field ───────────────────────────────────────────────────────
    private List<BusinessPartnerDto> FilterCustomers(string? searchText)
    {
        IEnumerable<BusinessPartnerDto> results = allBusinessPartners;

        if (!string.IsNullOrWhiteSpace(searchText))
        {
            results = results.Where(bp =>
                (bp.CardCode?.Contains(searchText, StringComparison.OrdinalIgnoreCase) ?? false) ||
                (bp.CardName?.Contains(searchText, StringComparison.OrdinalIgnoreCase) ?? false));
        }

        return results.Take(20).ToList();
    }

    private void OnCustomerInput(string? value)
    {
        // Typing over a chosen customer means the field no longer names that customer,
        // so drop the selection - and its price list - before filtering again.
        if (selectedBusinessPartner != null)
        {
            ClearSelectedBP();
        }

        customerSearch = value ?? string.Empty;
        customerMatches = FilterCustomers(customerSearch);
        showCustomerDrop = true;
    }

    private void OnCustomerFocus()
    {
        customerMatches = FilterCustomers(selectedBusinessPartner != null ? null : customerSearch);
        showCustomerDrop = true;
    }

    private async Task OnCustomerBlur()
    {
        // Long enough for a click on a list row to land before the list closes.
        await Task.Delay(200);
        showCustomerDrop = false;
    }

    private async Task PickCustomerAsync(BusinessPartnerDto bp)
    {
        showCustomerDrop = false;
        customerSearch = bp.DisplayName;
        await SelectBusinessPartnerAsync(bp);
    }

    private void ClearCustomer()
    {
        ClearSelectedBP();
        customerSearch = string.Empty;
        customerMatches = FilterCustomers(null);
        showCustomerDrop = false;
    }

    // ── Line defaults ────────────────────────────────────────────────────────
    private void OnDefaultWarehouseChanged(string? code)
    {
        warehouseCode = string.IsNullOrWhiteSpace(code) ? null : code;

        if (string.IsNullOrWhiteSpace(warehouseCode))
        {
            return;
        }

        // The defaults bar sets the document rather than only the next line, the same
        // way the default cost centre already applies to every line.
        foreach (var line in invoice.Lines)
        {
            line.WarehouseCode = warehouseCode;
        }

        foreach (var errors in lineValidationErrors.Values)
        {
            errors.Remove("Warehouse");
        }
    }

    private void OnDefaultCostCentreChanged(string? code)
    {
        defaultCostCentre = string.IsNullOrWhiteSpace(code) ? null : code;
        ApplyCostCentreToAllLines();
    }

    private void OnLineWarehouseChanged(int index, string? code)
    {
        if (index < 0 || index >= invoice.Lines.Count)
        {
            return;
        }

        invoice.Lines[index].WarehouseCode = code ?? string.Empty;

        if (lineValidationErrors.TryGetValue(index, out var errors))
        {
            errors.Remove("Warehouse");
        }
    }

    // Line state management for product autocomplete
    private LineState GetLineState(int index)
    {
        if (!lineStates.ContainsKey(index))
        {
            lineStates[index] = new LineState();
        }
        return lineStates[index];
    }

    private Dictionary<string, string> GetLineValidationErrors(int index)
    {
        return lineValidationErrors.TryGetValue(index, out var errors) ? errors : new Dictionary<string, string>();
    }

    private void OnItemCodeInput(int index, string? value)
    {
        var line = invoice.Lines[index];
        line.ItemCode = value ?? string.Empty;

        var state = GetLineState(index);
        state.SearchTerm = value ?? string.Empty;
        state.SuggestedProduct = null;
        state.SuggestionSuffix = string.Empty;

        // Clear validation error when user starts typing
        if (lineValidationErrors.TryGetValue(index, out var errors))
        {
            errors.Remove("ItemCode");
        }

        if (string.IsNullOrWhiteSpace(value))
        {
            state.FilteredProducts = new List<ProductDto>();
            state.ShowProductDropdown = false;
            return;
        }

        var searchLower = value.ToLowerInvariant();
        var searchUpper = value.ToUpperInvariant();

        state.FilteredProducts = cachedProducts.Where(p =>
        (p.ItemCode?.ToUpperInvariant().StartsWith(searchUpper) ?? false) ||
        (p.ItemCode?.ToLowerInvariant().Contains(searchLower) ?? false) ||
        (p.ItemName?.ToLowerInvariant().Contains(searchLower) ?? false) ||
        (p.BarCode?.ToLowerInvariant().Contains(searchLower) ?? false)
        ).OrderByDescending(p => p.ItemCode?.ToUpperInvariant().StartsWith(searchUpper) ?? false)
        .ThenBy(p => p.ItemCode)
        .ToList();

        var exactMatch = state.FilteredProducts.FirstOrDefault(p =>
        p.ItemCode?.ToUpperInvariant().StartsWith(searchUpper) ?? false);

        if (exactMatch != null && !string.IsNullOrEmpty(exactMatch.ItemCode))
        {
            state.SuggestedProduct = exactMatch;
            state.SuggestionSuffix = exactMatch.ItemCode.Substring(value.Length);
        }

        state.ShowProductDropdown = state.FilteredProducts.Any();
    }

    private async Task OnItemCodeKeyDown(int index, KeyboardEventArgs e)
    {
        var state = GetLineState(index);

        if ((e.Key == "Tab" || e.Key == "ArrowRight") && state.SuggestedProduct != null)
        {
            if (e.Key == "Tab" || !string.IsNullOrEmpty(state.SuggestionSuffix))
            {
                await SelectProduct(index, state.SuggestedProduct);
            }
        }
        else if (e.Key == "ArrowDown" && state.ShowProductDropdown && state.FilteredProducts.Any())
        {
            var currentIndex = state.SuggestedProduct != null
            ? state.FilteredProducts.IndexOf(state.SuggestedProduct)
            : -1;
            var nextIndex = Math.Min(currentIndex + 1, state.FilteredProducts.Count - 1);
            state.SuggestedProduct = state.FilteredProducts[nextIndex];
            if (state.SuggestedProduct?.ItemCode != null)
            {
                var line = invoice.Lines[index];
                var searchUpper = line.ItemCode?.ToUpperInvariant() ?? "";
                if (state.SuggestedProduct.ItemCode.ToUpperInvariant().StartsWith(searchUpper))
                {
                    state.SuggestionSuffix = state.SuggestedProduct.ItemCode.Substring(line.ItemCode?.Length ?? 0);
                }
                else
                {
                    state.SuggestionSuffix = string.Empty;
                }
            }
        }
        else if (e.Key == "ArrowUp" && state.ShowProductDropdown && state.FilteredProducts.Any())
        {
            var currentIndex = state.SuggestedProduct != null
            ? state.FilteredProducts.IndexOf(state.SuggestedProduct)
            : state.FilteredProducts.Count;
            var prevIndex = Math.Max(currentIndex - 1, 0);
            state.SuggestedProduct = state.FilteredProducts[prevIndex];
            if (state.SuggestedProduct?.ItemCode != null)
            {
                var line = invoice.Lines[index];
                var searchUpper = line.ItemCode?.ToUpperInvariant() ?? "";
                if (state.SuggestedProduct.ItemCode.ToUpperInvariant().StartsWith(searchUpper))
                {
                    state.SuggestionSuffix = state.SuggestedProduct.ItemCode.Substring(line.ItemCode?.Length ?? 0);
                }
                else
                {
                    state.SuggestionSuffix = string.Empty;
                }
            }
        }
        else if (e.Key == "Enter" && state.SuggestedProduct != null)
        {
            await SelectProduct(index, state.SuggestedProduct);
        }
        else if (e.Key == "Escape")
        {
            state.ShowProductDropdown = false;
            state.SuggestedProduct = null;
            state.SuggestionSuffix = string.Empty;
        }
    }

    private void OnItemCodeFocus(int index)
    {
        var state = GetLineState(index);
        if (!string.IsNullOrEmpty(state.SearchTerm) || cachedProducts.Any())
        {
            state.ShowProductDropdown = true;
            if (string.IsNullOrEmpty(state.SearchTerm))
            {
                state.FilteredProducts = cachedProducts.Take(15).ToList();
            }
        }
    }

    private async Task OnItemCodeBlur(int index)
    {
        await Task.Delay(200);
        var state = GetLineState(index);
        state.ShowProductDropdown = false;
        state.SuggestionSuffix = string.Empty;
    }

    private void OnQuantityChange(int index, string? value)
    {
        var line = invoice.Lines[index];

        if (decimal.TryParse(value, out var quantity))
        {
            // Prevent negative quantities
            if (quantity < 0)
            {
                quantity = 0;
                errorMessage = "Quantity cannot be negative. Value has been reset to 0.";
            }
            line.Quantity = quantity;
        }
        else
        {
            line.Quantity = 0;
        }

        // Clear validation error when user changes value
        if (lineValidationErrors.TryGetValue(index, out var errors))
        {
            errors.Remove("Quantity");
        }
    }

    private void OnUnitPriceChange(int index, string? value)
    {
        var line = invoice.Lines[index];

        if (decimal.TryParse(value, out var price))
        {
            if (price < 0)
            {
                price = 0;
                errorMessage = "Unit price cannot be negative. Value has been reset to 0.";
            }
            line.UnitPrice = price;
        }
        else
        {
            line.UnitPrice = 0;
        }

        if (line.UnitPrice.GetValueOrDefault() > 0)
        {
            ClearUnitPriceError(index);
        }
        else
        {
            SetMissingSapPriceError(index, line.ItemCode);
        }
    }

    private async Task SelectProduct(int index, ProductDto product)
    {
        var line = invoice.Lines[index];
        line.ItemCode = product.ItemCode ?? string.Empty;
        line.ItemDescription = product.ItemName ?? string.Empty;

        ApplyPricing(line, GetPricingForItem(product.ItemCode, product.Price));

        if (!string.IsNullOrEmpty(product.ItemCode))
        {
            try
            {
                ApplyPricing(line, await BusinessPartnerPricingService.ResolveItemPriceAsync(
                    product.ItemCode,
                    invoice.DocCurrency,
                    product.Price,
                    invoice.CardCode,
                    customerPriceListNum,
                    customerPricing));
            }
            catch (Exception ex)
            {
                Logger.LogWarning(ex, "Failed to resolve BP-aware invoice price for item {ItemCode}", product.ItemCode);
            }
        }

        line.WarehouseCode = !string.IsNullOrEmpty(warehouseCode) ? warehouseCode : (product.DefaultWarehouse ??
AppSettings.DefaultWarehouse);

        // Apply default cost centre if set
        if (!string.IsNullOrEmpty(defaultCostCentre))
        {
            line.CostCentreCode = defaultCostCentre;
        }

        var state = GetLineState(index);
        state.ShowProductDropdown = false;
        state.SearchTerm = product.ItemCode ?? string.Empty;
        state.SuggestedProduct = null;
        state.SuggestionSuffix = string.Empty;

        if (line.UnitPrice.GetValueOrDefault() > 0)
        {
            ClearUnitPriceError(index);
        }
        else
        {
            line.UnitPrice = 0;
            SetMissingSapPriceError(index, line.ItemCode);
        }

        // Clear validation errors for this line
        if (lineValidationErrors.TryGetValue(index, out var errors))
        {
            errors.Remove("ItemCode");
            if (errors.Count == 0)
            {
                lineValidationErrors.Remove(index);
            }
        }
    }

    private async Task SelectBusinessPartnerAsync(BusinessPartnerDto bp)
    {
        var requestVersion = BeginBusinessPartnerPricingRequest();
        selectedBusinessPartner = bp;
        invoice.CardCode = bp.CardCode ?? string.Empty;

        if (!string.IsNullOrEmpty(bp.Currency))
        {
            invoice.DocCurrency = bp.Currency;
        }

        // Clear validation error
        validationErrors.Remove("Customer");

        // Repaint immediately with the new BP selection while the fresh price lookup is loading.
        customerPricing.Clear();
        customerPriceListNum = bp.PriceListNum;
        isLoadingCustomerPrices = true;
        UpdateExistingLinePrices();
        await InvokeAsync(StateHasChanged);

        var pricingLoaded = await LoadBusinessPartnerPricesAsync(
            bp,
            requestVersion,
            businessPartnerPricingCts?.Token ?? CancellationToken.None);

        if (!pricingLoaded)
        {
            return;
        }

        // Update prices on any existing lines to reflect the customer's price list
        UpdateExistingLinePrices();
        StateHasChanged();
    }

    private void ClearSelectedBP()
    {
        CancelBusinessPartnerPricingRequest();
        selectedBusinessPartner = null;
        invoice.CardCode = string.Empty;
        customerPricing.Clear();
        customerPriceListNum = null;
        isLoadingCustomerPrices = false;
        UpdateExistingLinePrices();
    }

    private void UpdateExistingLinePrices()
    {
        for (var i = 0; i < invoice.Lines.Count; i++)
        {
            var line = invoice.Lines[i];
            if (!string.IsNullOrEmpty(line.ItemCode))
            {
                var product = cachedProducts.FirstOrDefault(p => p.ItemCode == line.ItemCode);
                var defaultPrice = product?.Price ?? 0m;
                ApplyPricing(line, GetPricingForItem(line.ItemCode, defaultPrice));

                if (line.UnitPrice.GetValueOrDefault() > 0)
                {
                    ClearUnitPriceError(i);
                }
                else
                {
                    line.UnitPrice = 0;
                    SetMissingSapPriceError(i, line.ItemCode);
                }
            }
        }
    }

    private void SetMissingSapPriceError(int index, string? itemCode)
    {
        if (!lineValidationErrors.TryGetValue(index, out var errors))
        {
            errors = new Dictionary<string, string>();
            lineValidationErrors[index] = errors;
        }

        errors["UnitPrice"] = MissingSapPriceMessage;
        errorMessage = $"Item {(string.IsNullOrWhiteSpace(itemCode) ? "selected" : itemCode)} has no price set in SAP. Please contact the admin.";
    }

    private void ClearUnitPriceError(int index)
    {
        if (!lineValidationErrors.TryGetValue(index, out var errors))
        {
            return;
        }

        errors.Remove("UnitPrice");

        if (errors.Count == 0)
        {
            lineValidationErrors.Remove(index);
        }
    }

    private async Task LoadCustomerPriceList(int priceListNum)
    {
        isLoadingCustomerPrices = true;
        StateHasChanged();

        try
        {
            Logger.LogInformation("Loading prices from customer price list {PriceListNum}", priceListNum);

            var response = await PriceService.GetPricesByPriceListAsync(priceListNum);

            if (response?.Prices != null && response.Prices.Any())
            {
                customerPricing.Clear();
                foreach (var price in response.Prices)
                {
                    if (!string.IsNullOrEmpty(price.ItemCode))
                    {
                        customerPricing[price.ItemCode] = ResolvedItemPrice.Flat(price.Price);
                    }
                }
                customerPriceListNum = priceListNum;

                Logger.LogInformation("Loaded {Count} live prices from customer price list {PriceListNum}",
                customerPricing.Count, priceListNum);
            }
            else
            {
                Logger.LogWarning("No prices found for price list {PriceListNum}", priceListNum);
                customerPricing.Clear();
                customerPriceListNum = null;
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error loading customer price list {PriceListNum}", priceListNum);
            customerPricing.Clear();
            customerPriceListNum = null;
        }
        finally
        {
            isLoadingCustomerPrices = false;
            StateHasChanged();
        }
    }

    private async Task<bool> LoadBusinessPartnerPricesAsync(
        BusinessPartnerDto bp,
        int requestVersion,
        CancellationToken cancellationToken)
    {
        isLoadingCustomerPrices = true;
        StateHasChanged();

        try
        {
            var lookup = await BusinessPartnerPricingService.LoadPriceLookupAsync(bp, cancellationToken);

            if (!IsCurrentBusinessPartnerPricingRequest(bp, requestVersion, cancellationToken))
            {
                return false;
            }

            customerPricing = lookup.Pricing;
            customerPriceListNum = lookup.PriceListNum;
            return true;
        }
        catch (OperationCanceledException)
        {
            return false;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error loading invoice prices for {CardCode}", bp.CardCode);
            customerPricing.Clear();
            customerPriceListNum = null;
            return IsCurrentBusinessPartnerPricingRequest(bp, requestVersion, cancellationToken);
        }
        finally
        {
            if (requestVersion == businessPartnerPricingRequestVersion)
            {
                isLoadingCustomerPrices = false;
                StateHasChanged();
            }
        }
    }

    private int BeginBusinessPartnerPricingRequest()
    {
        CancelBusinessPartnerPricingRequest();
        businessPartnerPricingCts = new CancellationTokenSource();
        businessPartnerPricingRequestVersion++;
        return businessPartnerPricingRequestVersion;
    }

    private void CancelBusinessPartnerPricingRequest()
    {
        businessPartnerPricingCts?.Cancel();
        businessPartnerPricingCts?.Dispose();
        businessPartnerPricingCts = null;
    }

    private bool IsCurrentBusinessPartnerPricingRequest(
        BusinessPartnerDto bp,
        int requestVersion,
        CancellationToken cancellationToken)
    {
        return !cancellationToken.IsCancellationRequested &&
            requestVersion == businessPartnerPricingRequestVersion &&
            string.Equals(selectedBusinessPartner?.CardCode, bp.CardCode, StringComparison.OrdinalIgnoreCase);
    }

    private async Task LoadCustomerPriceListFallback(int priceListNum)
    {
        try
        {
            Logger.LogInformation("Fallback: loading prices from price list {PriceListNum}", priceListNum);

            var response = await PriceService.GetPricesByPriceListAsync(priceListNum);
            if (response?.Prices != null && response.Prices.Any())
            {
                customerPricing.Clear();
                foreach (var price in response.Prices)
                {
                    if (!string.IsNullOrEmpty(price.ItemCode))
                    {
                        customerPricing[price.ItemCode] = ResolvedItemPrice.Flat(price.Price);
                    }
                }
                customerPriceListNum = priceListNum;
                Logger.LogInformation("Fallback: loaded {Count} live prices for price list {PriceListNum}",
customerPricing.Count, priceListNum);
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Fallback price loading also failed for price list {PriceListNum}", priceListNum);
        }
    }

    private ResolvedItemPrice GetPricingForItem(string? itemCode, decimal defaultPrice)
    {
        if (string.IsNullOrEmpty(itemCode))
            return ResolvedItemPrice.Flat(defaultPrice);

        // If customer has a price list with this item, use that price
        if (customerPricing.TryGetValue(itemCode, out var customerPrice))
        {
            return customerPrice;
        }

        // Fall back to default product price
        return ResolvedItemPrice.Flat(defaultPrice);
    }

    /// <summary>
    /// Shows a customer's special price the way SAP does - the price list price in Unit Price and the
    /// gap in Discount % - rather than collapsing both into a net price with an empty discount.
    /// </summary>
    private static void ApplyPricing(CreateInvoiceLineRequest line, ResolvedItemPrice pricing)
    {
        line.UnitPrice = pricing.UnitPrice;
        line.DiscountPercent = pricing.DiscountPercent;
    }

    private bool HasSpecialPrice(string? itemCode)
        => !string.IsNullOrEmpty(itemCode)
            && customerPricing.TryGetValue(itemCode, out var pricing)
            && pricing.DiscountPercent > 0;

    private decimal GetDisplayPrice(decimal amount)
    {
        return AppSettings.ShowPricesWithTax ? amount * (1 + VatRate) : amount;
    }

    private decimal GetDisplayLineTotal(CreateInvoiceLineRequest line)
    {
        return AppSettings.ShowPricesWithTax ? CalculateLineTotalInclVat(line) : CalculateLineTotal(line);
    }

    private decimal GetAlternateLineTotal(CreateInvoiceLineRequest line)
    {
        return AppSettings.ShowPricesWithTax ? CalculateLineTotal(line) : CalculateLineTotalInclVat(line);
    }

    private string DisplayPriceLabel => AppSettings.ShowPricesWithTax ? "incl. VAT" : "excl. VAT";

    private string AlternatePriceLabel => AppSettings.ShowPricesWithTax ? "excl. VAT" : "incl. VAT";

    private void AddLine()
    {
        var newLine = new CreateInvoiceLineRequest
        {
            Quantity = 1,
            WarehouseCode = warehouseCode ?? AppSettings.DefaultWarehouse
        };

        // Apply default cost centre if set
        if (!string.IsNullOrEmpty(defaultCostCentre))
        {
            newLine.CostCentreCode = defaultCostCentre;
        }

        invoice.Lines.Add(newLine);
    }

    private void RemoveLine(int index)
    {
        if (index >= 0 && index < invoice.Lines.Count)
        {
            invoice.Lines.RemoveAt(index);
            lineStates.Remove(index);
            lineValidationErrors.Remove(index);

            // Re-index states
            var newStates = new Dictionary<int, LineState>();
            var newErrors = new Dictionary<int, Dictionary<string, string>>();

            foreach (var kvp in lineStates.OrderBy(x => x.Key))
            {
                if (kvp.Key < index)
                {
                    newStates[kvp.Key] = kvp.Value;
                }
                else if (kvp.Key > index)
                {
                    newStates[kvp.Key - 1] = kvp.Value;
                }
            }

            foreach (var kvp in lineValidationErrors.OrderBy(x => x.Key))
            {
                if (kvp.Key < index)
                {
                    newErrors[kvp.Key] = kvp.Value;
                }
                else if (kvp.Key > index)
                {
                    newErrors[kvp.Key - 1] = kvp.Value;
                }
            }

            lineStates = newStates;
            lineValidationErrors = newErrors;
        }
    }

    private decimal CalculateLineTotal(CreateInvoiceLineRequest line)
    {
        var subtotal = line.Quantity * (line.UnitPrice ?? 0);
        var discountPercent = line.DiscountPercent ?? 0;

        // Unit Price is the price before discount, so the discount has to come off here or the
        // totals disagree with what SAP bills.
        return discountPercent > 0 ? subtotal * (1 - discountPercent / 100) : subtotal;
    }

    private decimal CalculateSubtotal()
    {
        return invoice.Lines.Sum(l => l.Quantity * (l.UnitPrice ?? 0));
    }

    private decimal CalculateTotal()
    {
        return invoice.Lines.Sum(l => CalculateLineTotal(l));
    }

    private decimal CalculateVatAmount()
    {
        return CalculateSubtotal() * VatRate;
    }

    private decimal CalculateTotalInclVat()
    {
        return CalculateSubtotal() * (1 + VatRate);
    }

    private decimal CalculateLineTotalInclVat(CreateInvoiceLineRequest line)
    {
        return CalculateLineTotal(line) * (1 + VatRate);
    }

    private bool ValidateForm()
    {
        validationErrors.Clear();
        lineValidationErrors.Clear();
        var isValid = true;

        // Validate customer
        if (string.IsNullOrWhiteSpace(invoice.CardCode))
        {
            validationErrors["Customer"] = "Please select a customer";
            isValid = false;
        }

        // Validate lines
        if (!invoice.Lines.Any())
        {
            validationErrors["Lines"] = "At least one line item is required";
            isValid = false;
        }

        if (invoice.CrateQuantity.HasValue && invoice.CrateQuantity.Value < 0)
        {
            validationErrors["CrateQuantity"] = "Crate quantity cannot be negative";
            isValid = false;
        }

        for (int i = 0; i < invoice.Lines.Count; i++)
        {
            var line = invoice.Lines[i];
            var errors = new Dictionary<string, string>();

            // Item code required
            if (string.IsNullOrWhiteSpace(line.ItemCode))
            {
                errors["ItemCode"] = "Item code is required";
                isValid = false;
            }

            // Warehouse required
            if (string.IsNullOrWhiteSpace(line.WarehouseCode))
            {
                errors["Warehouse"] = "Warehouse is required";
                isValid = false;
            }

            // Quantity validation - must be positive
            if (line.Quantity <= 0)
            {
                errors["Quantity"] = "Quantity must be greater than zero";
                isValid = false;
            }

            // Unit price validation - must be greater than zero
            if (!line.UnitPrice.HasValue || line.UnitPrice.Value <= 0)
            {
                errors["UnitPrice"] = MissingSapPriceMessage;
                isValid = false;
            }

            // Batch number is optional - auto-allocated using FEFO if not specified
            // The API will handle batch selection automatically

            if (errors.Any())
            {
                lineValidationErrors[i] = errors;
            }
        }

        return isValid;
    }

    private async Task SubmitInvoice()
    {
        errorMessage = null;
        successMessage = null;

        if (!ValidateForm())
        {
            errorMessage = "Please fix the validation errors before submitting.";
            Logger.LogWarning("Invoice validation failed. Errors: {Errors}",
            string.Join("; ", validationErrors.Select(e => $"{e.Key}: {e.Value}")
            .Concat(lineValidationErrors.SelectMany(le => le.Value.Select(e => $"Line {le.Key + 1} {e.Key}: {e.Value}")))));
            return;
        }

        isSubmitting = true;

        try
        {
            // Log the invoice request for debugging
            Logger.LogInformation("Creating invoice for customer {CardCode} with {LineCount} lines",
            invoice.CardCode, invoice.Lines.Count);

            foreach (var (line, index) in invoice.Lines.Select((l, i) => (l, i)))
            {
                Logger.LogDebug("Line {LineNum}: ItemCode={ItemCode}, Qty={Quantity}, Price={Price}, Warehouse={Warehouse}, Batch={Batch}, Account={Account}",
                index + 1,
                line.ItemCode,
                line.Quantity,
                line.UnitPrice,
                line.WarehouseCode,
                string.IsNullOrEmpty(line.BatchNumber) ? "(auto-FEFO)" : line.BatchNumber,
                line.AccountCode ?? "(default)");

                // Log batch numbers if specified
                if (line.BatchNumbers?.Any() == true)
                {
                    foreach (var batch in line.BatchNumbers)
                    {
                        Logger.LogDebug(" Batch: {BatchNumber}, Qty: {Quantity}", batch.BatchNumber, batch.Quantity);
                    }
                }
            }

            var (success, message, createdInvoice, fiscalization) = await InvoiceService.CreateInvoiceAsync(invoice);

            if (success)
            {
                Logger.LogInformation("Invoice #{DocNum} (DocEntry: {DocEntry}) created successfully for customer {CardCode}",
                createdInvoice?.DocNum, createdInvoice?.DocEntry, invoice.CardCode);

                var postCreateInvoice = createdInvoice;
                var postCreateNotifyByEmail = notifyCustomerByEmail;
                var postCreateCardCode = createdInvoice?.CardCode ?? invoice.CardCode;
                var postCreateCustomerName = selectedBusinessPartner?.CardName ?? createdInvoice?.CardName ?? "Customer";
                var postCreateCustomerEmail = selectedBusinessPartner?.Email;

                // Build success message with fiscalisation status
                if (fiscalization?.Queued == true)
                {
                    successMessage = $"Invoice #{createdInvoice?.DocNum} created successfully. Fiscalisation is running in the background.";
                }
                else if (fiscalization != null && fiscalization.Success)
                {
                    successMessage = $"Invoice #{createdInvoice?.DocNum} created and fiscalised successfully! Receipt: {fiscalization.ReceiptGlobalNo}";
                }
                else if (fiscalization != null && fiscalization.Skipped)
                {
                    successMessage = $"Invoice #{createdInvoice?.DocNum} created successfully! (Fiscalisation skipped)";
                }
                else if (fiscalization != null && !fiscalization.Success)
                {
                    successMessage = $"Invoice #{createdInvoice?.DocNum} created successfully!";
                    errorMessage = $"Fiscalisation failed: {fiscalization.Message ?? "Unknown error"}. The invoice was posted to SAP but not fiscalised.";
                }
                else
                {
                    successMessage = $"Invoice #{createdInvoice?.DocNum} created successfully!";
                }

                // Store reference for manual print button
                lastCreatedInvoice = createdInvoice;
                lastFiscalizationResult = fiscalization;

                ClearForm();
                QueueInvoicePostCreateWork(
                    postCreateInvoice,
                    postCreateNotifyByEmail,
                    postCreateCardCode,
                    postCreateCustomerName,
                    postCreateCustomerEmail,
                    fiscalization);
            }
            else
            {
                Logger.LogError("Failed to create invoice for customer {CardCode}. Error: {Error}",
                invoice.CardCode, message);
                errorMessage = message;
                // Audit log: invoice creation failed
                await AuditService.LogAsync(AuditActions.CreateInvoice, "Invoice", invoice.CardCode, null, false, message);
            }
        }
        catch (HttpRequestException httpEx)
        {
            Logger.LogError(httpEx, "HTTP error creating invoice for customer {CardCode}. Status: {StatusCode}",
            invoice.CardCode, httpEx.StatusCode);
            errorMessage = $"Network error: {httpEx.Message}. Please check if the API is running.";
        }
        catch (TaskCanceledException tcEx) when (tcEx.InnerException is TimeoutException)
        {
            Logger.LogError(tcEx, "Timeout creating invoice for customer {CardCode}", invoice.CardCode);
            errorMessage = "Request timed out. The server may be busy, please try again.";
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Unexpected error creating invoice for customer {CardCode}. Exception: {ExceptionType}",
            invoice.CardCode, ex.GetType().Name);
            errorMessage = $"Error creating invoice: {ex.Message}";
        }
        finally
        {
            isSubmitting = false;
        }
    }

    private void QueueInvoicePostCreateWork(
        InvoiceDto? createdInvoice,
        bool notifyByEmail,
        string? cardCode,
        string customerName,
        string? customerEmail,
        FiscalizationResult? fiscalization)
    {
        _ = InvokeAsync(async () =>
        {
            try
            {
                var notificationNote = await TrySendCustomerInvoiceNotificationAsync(
                    createdInvoice,
                    notifyByEmail,
                    cardCode,
                    customerName,
                    customerEmail);

                if (!string.IsNullOrWhiteSpace(notificationNote) && !string.IsNullOrWhiteSpace(successMessage))
                {
                    successMessage = $"{successMessage} {notificationNote}";
                    StateHasChanged();
                }

                await TryAutoPrintInvoiceAsync(createdInvoice, fiscalization?.QRCode);
                await AuditService.LogAsync(AuditActions.CreateInvoice, "Invoice", createdInvoice?.DocNum.ToString());
            }
            catch (Exception ex)
            {
                Logger.LogWarning(ex, "Invoice post-create work failed for invoice {DocNum}", createdInvoice?.DocNum);
            }
        });
    }

    private async Task<string?> TrySendCustomerInvoiceNotificationAsync(
        InvoiceDto? createdInvoice,
        bool notifyByEmail,
        string? cardCode,
        string customerName,
        string? customerEmail)
    {
        if (!notifyByEmail)
        {
            return null;
        }

        if (createdInvoice == null)
        {
            Logger.LogWarning("Invoice created but no invoice details were returned. Skipping email notification.");
            return "Notification email skipped (invoice details unavailable).";
        }

        cardCode ??= createdInvoice.CardCode;
        customerName = string.IsNullOrWhiteSpace(customerName)
            ? createdInvoice.CardName ?? "Customer"
            : customerName;

        if (string.IsNullOrWhiteSpace(customerEmail) && !string.IsNullOrWhiteSpace(cardCode))
        {
            var bp = await BusinessPartnerService.GetBusinessPartnerByCodeAsync(cardCode);
            if (bp != null)
            {
                customerEmail = bp.Email;
                if (!string.IsNullOrWhiteSpace(bp.CardName))
                {
                    customerName = bp.CardName;
                }
            }
        }

        if (string.IsNullOrWhiteSpace(customerEmail))
        {
            Logger.LogWarning("No email found for customer {CardCode}. Skipping invoice notification.", cardCode);
            return "Notification email skipped (customer email missing).";
        }

        var sent = await EmailService.SendCustomerInvoiceNotificationAsync(
        customerEmail,
        customerName,
        createdInvoice.DocEntry,
        createdInvoice.DocNum.ToString(),
        createdInvoice.DocTotal);

        if (sent)
        {
            Logger.LogInformation("Invoice notification email sent to {Email} for invoice {DocNum}.",
            customerEmail, createdInvoice.DocNum);
            return "Notification email sent.";
        }

        Logger.LogWarning("Failed to send invoice notification email to {Email} for invoice {DocNum}.",
        customerEmail, createdInvoice.DocNum);
        return "Notification email failed to send.";
    }

    private async Task TryAutoPrintInvoiceAsync(InvoiceDto? createdInvoice, string? fiscalQrCode)
    {
        try
        {
            var autoPrint = await AppSettingsService.GetValueAsync<bool>(SettingKeys.AutoPrintInvoice);
            if (!autoPrint || createdInvoice == null)
                return;

            Logger.LogInformation("Auto-printing invoice #{DocNum} (DocEntry: {DocEntry})",
            createdInvoice.DocNum, createdInvoice.DocEntry);

            var pdfBytes = await InvoiceService.GetInvoicePdfAsync(createdInvoice.DocEntry, fiscalQrCode);
            if (pdfBytes == null || pdfBytes.Length == 0)
            {
                Logger.LogWarning("Failed to retrieve PDF for auto-print of invoice #{DocNum}", createdInvoice.DocNum);
                return;
            }

            var copies = await AppSettingsService.GetValueAsync<int>(SettingKeys.PrintCopies);
            copies = Math.Clamp(copies, 1, 10);

            var base64 = Convert.ToBase64String(pdfBytes);
            await JS.InvokeVoidAsync("printPdfFromBase64", base64);

            // The browser's dialog is what the cashier sets copies in; we can only open it once.
            Logger.LogInformation("Auto-print dialog opened for invoice #{DocNum} ({Copies} copies intended)",
            createdInvoice.DocNum, copies);
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Auto-print failed for invoice. Error: {Message}", ex.Message);
            // Don't fail the invoice creation if printing fails
        }
    }

    private void DismissSuccess()
    {
        successMessage = null;
        lastCreatedInvoice = null;
        lastFiscalizationResult = null;
    }

    private async Task OpenPrintDialog()
    {
        if (lastCreatedInvoice == null)
            return;

        try
        {
            printCopies = await AppSettingsService.GetValueAsync<int>(SettingKeys.PrintCopies);
            printCopies = Math.Clamp(printCopies, 1, 10);
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Error loading print settings");
            printCopies = 1;
        }

        showPrintDialog = true;
    }

    private async Task ExecutePrint()
    {
        if (lastCreatedInvoice == null || isPrinting)
            return;

        isPrinting = true;
        try
        {
            printCopies = Math.Clamp(printCopies, 1, 10);

            // Remember the copy count as the new default for the next invoice.
            await AppSettingsService.SaveSettingAsync(SettingKeys.PrintCopies, printCopies.ToString());

            var pdfBytes = await InvoiceService.GetInvoicePdfAsync(lastCreatedInvoice.DocEntry, lastFiscalizationResult?.QRCode);
            if (pdfBytes == null || pdfBytes.Length == 0)
            {
                errorMessage = "Failed to retrieve invoice PDF for printing.";
                return;
            }

            var base64 = Convert.ToBase64String(pdfBytes);
            await JS.InvokeVoidAsync("printPdfFromBase64", base64);

            Logger.LogInformation("Print dialog opened for invoice #{DocNum} ({Copies} copies intended)",
            lastCreatedInvoice.DocNum, printCopies);

            showPrintDialog = false;
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Print failed for invoice. Error: {Message}", ex.Message);
            errorMessage = $"Print failed: {ex.Message}";
        }
        finally
        {
            isPrinting = false;
        }
    }

    private async Task DownloadInvoicePdf()
    {
        if (lastCreatedInvoice == null || isPrinting)
            return;

        isPrinting = true;
        try
        {
            var pdfBytes = await InvoiceService.GetInvoicePdfAsync(lastCreatedInvoice.DocEntry, lastFiscalizationResult?.QRCode);
            if (pdfBytes == null || pdfBytes.Length == 0)
            {
                errorMessage = "Failed to retrieve invoice PDF.";
                return;
            }

            var base64 = Convert.ToBase64String(pdfBytes);
            var fileName = $"Invoice_{lastCreatedInvoice.DocNum}.pdf";
            await JS.InvokeVoidAsync("downloadPdfFromBase64", base64, fileName);

            Logger.LogInformation("PDF downloaded for invoice #{DocNum}", lastCreatedInvoice.DocNum);
            showPrintDialog = false;
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "PDF download failed for invoice. Error: {Message}", ex.Message);
            errorMessage = $"Download failed: {ex.Message}";
        }
        finally
        {
            isPrinting = false;
        }
    }

    private void ClearForm()
    {
        invoice = new CreateInvoiceRequest
        {
            DocCurrency = AppSettings.DefaultCurrency,
            Lines = new List<CreateInvoiceLineRequest>()
        };
        lineStates.Clear();
        lineValidationErrors.Clear();
        validationErrors.Clear();
        ClearSelectedBP();
        customerSearch = string.Empty;
        customerMatches = FilterCustomers(null);
        showCustomerDrop = false;
    }

