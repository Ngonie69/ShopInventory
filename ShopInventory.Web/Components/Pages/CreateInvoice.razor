@page "/invoices/create"
@using System.Security.Claims
@using Blazored.LocalStorage
@using Microsoft.AspNetCore.Authorization
@using Microsoft.JSInterop
@using ShopInventory.Web.Data
@attribute [Authorize(Roles = "Admin,Cashier")]
@inject IInvoiceService InvoiceService
@inject IProductService ProductService
@inject IPriceService PriceService
@inject IBusinessPartnerPricingService BusinessPartnerPricingService
@inject IBusinessPartnerService BusinessPartnerService
@inject IEmailService EmailService
@inject IMasterDataCacheService CacheService
@inject IWarehouseStockCacheService StockCacheService
@inject IAppSettingsService AppSettingsService
@inject IAppSettingsProvider AppSettings
@inject IJSRuntime JS
@inject NavigationManager NavigationManager
@inject ILogger<CreateInvoice> Logger
@inject AuthenticationStateProvider AuthStateProvider
@inject IAuditService AuditService
@inject ILocalStorageService LocalStorage
@rendermode InteractiveServer
@implements IDisposable

<PageTitle>Create Invoice - Shop Inventory</PageTitle>

@* Styles live in wwwroot/css/sales-forms.css (linked from App.razor), shared
   with the other five sales document forms — see that file's header. The
   imported design is a dark scheme; the sheet carries it and its light
   counterpart, and follows the app's theme toggle like every other page.

   The invoice is laid out for keyboard speed, unlike its five siblings: every
   header field in one block, one "Add item" row the cursor lives in, and a
   bar pinned to the bottom with the totals and the post button. Its rules are
   the `.is-invoice` block near the end of the sheet. *@

<div class="sfm is-invoice" @onkeydown="OnFormKeyDown">
    <div class="sfm-accentbar"></div>
    <div class="sfm-shell">

        <!-- ── Top bar: where you are, how fresh the data is ──────────────── -->
        <div class="sfm-crumbs">
            <a href="/invoices">Invoices</a>
            <span class="sfm-crumb-sep">/</span>
            <h1 class="sfm-crumb-title">New invoice</h1>
            <span class="sfm-spacer"></span>
            <span class="sfm-pill @CacheStateClass">
                <span class="sfm-dot"></span>@CacheStateLabel
            </span>
            <span class="sfm-sync-note">@CacheSummary</span>
            <button type="button" class="sfm-btn sfm-btn-icon" @onclick="RefreshMasterData" disabled="@isRefreshingCache"
                    title="Refresh customers, products and warehouses" aria-label="Refresh cached data">
                @if (isRefreshingCache)
                {
                    <span class="sfm-spin"></span>
                }
                else
                {
                    <i class="ph ph-arrows-clockwise"></i>
                }
            </button>
            <a href="/invoices" class="sfm-btn"><i class="ph ph-arrow-left"></i>Back</a>
        </div>

        <!-- ── Alerts ─────────────────────────────────────────────────────── -->
        @if (!string.IsNullOrEmpty(draftNotice))
        {
            <div class="sfm-alert is-ok">
                <i class="ph-fill ph-clock-counter-clockwise"></i>
                <div class="sfm-alert-bd">
                    @draftNotice
                    <button type="button" class="sfm-btn sfm-gap-sm" @onclick="DiscardRestoredDraft"
                            disabled="@isSubmitting">
                        <i class="ph ph-trash"></i>Discard and start again
                    </button>
                </div>
                <button type="button" class="sfm-alert-x" @onclick="() => draftNotice = null" aria-label="Dismiss">
                    <i class="ph ph-x"></i>
                </button>
            </div>
        }
        @if (!string.IsNullOrEmpty(successMessage))
        {
            <div class="sfm-alert is-ok" role="status">
                <i class="ph-fill ph-check-circle"></i>
                <div class="sfm-alert-bd">
                    @successMessage
                    <span class="sfm-alert-acts">
                        @if (lastCreatedInvoice != null)
                        {
                            <button type="button" class="sfm-btn" @onclick="OpenPrintDialog" disabled="@isPrinting">
                                <i class="ph ph-printer"></i>Print invoice
                            </button>
                        }
                        <button type="button" class="sfm-btn sfm-btn-accent" @onclick="StartNextInvoice">
                            <i class="ph ph-plus"></i>Next invoice
                        </button>
                    </span>
                </div>
                <button type="button" class="sfm-alert-x" @onclick="DismissSuccess" aria-label="Dismiss">
                    <i class="ph ph-x"></i>
                </button>
            </div>
        }
        @if (!string.IsNullOrEmpty(errorMessage))
        {
            <div class="sfm-alert is-err" role="alert">
                <i class="ph-fill ph-warning-octagon"></i>
                <div class="sfm-alert-bd">@((MarkupString)errorMessage)</div>
                <button type="button" class="sfm-alert-x" @onclick="() => errorMessage = null" aria-label="Dismiss">
                    <i class="ph ph-x"></i>
                </button>
            </div>
        }

        <!-- ── Invoice details: every header field in one block ──────────── -->
        <section class="sfm-card sfm-docbar" aria-label="Invoice details">
            <div class="sfm-lab sfm-f-customer">
                <span class="sfm-lab-t" id="inv-customer-l">
                    Customer <span class="sfm-req">*</span>
                    @if (selectedBusinessPartner != null)
                    {
                        <span class="sfm-lab-note">&middot; @PriceListNote</span>
                    }
                </span>
                <NocturnePicker @ref="customerPicker" Class="npick-block" Options="customerOptions"
                                Value="@invoice.CardCode" ValueChanged="@((string? code) => OnCustomerPickedAsync(code))"
                                Loading="isLoadingBPs" LoadingText="Loading customers…"
                                Placeholder="@CustomerPlaceholder"
                                SearchPlaceholder="Search customers by name, code or currency"
                                EmptyText="No customers loaded — try Refresh"
                                Caption="Customer" AriaLabel="Customer" AllowClear="false" OpenOnType="true"
                                Invalid="@validationErrors.ContainsKey("Customer")" />
                @if (validationErrors.ContainsKey("Customer"))
                {
                    <div class="sfm-field-err">@validationErrors["Customer"]</div>
                }
            </div>

            <label class="sfm-lab sfm-f-ref">
                <span class="sfm-lab-t">Customer ref</span>
                <input class="sfm-input" @bind="invoice.NumAtCard" placeholder="PO number" />
            </label>

            <label class="sfm-lab sfm-f-crates">
                <span class="sfm-lab-t">Crates</span>
                <input type="text" inputmode="decimal" autocomplete="off"
                       class="sfm-input sfm-num @(validationErrors.ContainsKey("CrateQuantity") ? "is-bad" : "")"
                       value="@invoice.CrateQuantity" @onchange="e => OnCratesChange(e.Value?.ToString())" placeholder="0" />
                @if (validationErrors.ContainsKey("CrateQuantity"))
                {
                    <div class="sfm-field-err">@validationErrors["CrateQuantity"]</div>
                }
            </label>

            @if (LockedCurrency is { } lockedCurrency)
            {
                <div class="sfm-lab sfm-f-cur">
                    <span class="sfm-lab-t">Currency</span>
                    @* SAP keeps one customer account per currency, so the account fixes it. *@
                    <div class="sfm-locked" title="Set by the customer's SAP account">
                        <strong>@lockedCurrency</strong><span>from account</span>
                    </div>
                </div>
            }
            else
            {
                <div class="sfm-lab sfm-f-cur">
                    <label class="sfm-lab-t" for="sfm-currency">Currency</label>
                    <NocturneSelect Id="sfm-currency" TValue="string" Class="nsel-block"
                                    Options="DocumentCurrencyOptions.UsdZig" @bind-Value="invoice.DocCurrency"
                                    AriaLabel="Currency" />
                </div>
            }

            <div class="sfm-lab sfm-f-wh">
                <span class="sfm-lab-t">Ship from <span class="sfm-lab-note">&middot; new lines use this</span></span>
                <NocturnePicker Class="npick-block" Options="warehouseOptions"
                                Value="@warehouseCode" ValueChanged="@((string? code) => OnDefaultWarehouseChanged(code))"
                                Loading="@(isLoadingMasterData && cachedWarehouses.Count == 0)"
                                Placeholder="Choose a warehouse" SearchPlaceholder="Search warehouses"
                                Caption="Ship from" AriaLabel="Ship from warehouse" AllowClear="false" />
            </div>

            <div class="sfm-lab sfm-f-cc">
                <span class="sfm-lab-t">Cost centre</span>
                <NocturnePicker Class="npick-block" Options="costCentreOptions"
                                Value="@defaultCostCentre" ValueChanged="@((string? code) => OnDefaultCostCentreChanged(code))"
                                AllowClear="false" UnsetLabel="Default" UnsetHint="each item’s own" UnsetTag="per item"
                                SearchPlaceholder="Search cost centres"
                                Caption="Cost centre" AriaLabel="Cost centre" />
            </div>

            <label class="sfm-lab sfm-f-comments">
                <span class="sfm-lab-t">Comments <span class="sfm-lab-note">&middot; printed on the invoice</span></span>
                <input class="sfm-input" @bind="invoice.Comments" placeholder="Optional" />
            </label>
        </section>

        <!-- ── Lines ──────────────────────────────────────────────────────── -->
        <section class="sfm-card" aria-labelledby="inv-lines-h">
            <div class="sfm-card-hd">
                <i class="ph ph-list-dashes"></i>
                <h2 id="inv-lines-h">Lines</h2>
                <span class="sfm-count">@invoice.Lines.Count</span>
                @if (ShortLineCount > 0)
                {
                    <button type="button" class="sfm-short-chip @(showShortOnly ? "is-on" : "")"
                            aria-pressed="@(showShortOnly ? "true" : "false")" @onclick="() => showShortOnly = !showShortOnly"
                            title="Show only the lines without enough stock">
                        <i class="ph ph-funnel-simple"></i>
                        @(showShortOnly ? $"Showing {ShortLineCount} short · show all" : $"{ShortLineCount} short of stock")
                    </button>
                }
                <span class="sfm-spacer"></span>
                <span class="sfm-hd-note"><i class="ph ph-sparkle"></i>Batches pick themselves, first-expiry first</span>
                <span class="sfm-hd-note"><i class="ph ph-lock-simple"></i>Prices from SAP</span>
            </div>

            <div class="sfm-lines">
                <div class="sfm-lines-inner" role="table" aria-label="Invoice lines">
                    <div class="sfm-row is-head" role="row">
                        <div role="columnheader">#</div>
                        <div role="columnheader">Item</div>
                        <div role="columnheader">Warehouse</div>
                        <div role="columnheader" class="sfm-r">Qty</div>
                        <div role="columnheader" class="sfm-r">Unit price</div>
                        <div role="columnheader" class="sfm-r">Disc %</div>
                        <div role="columnheader" class="sfm-r">Amount</div>
                        <div role="columnheader"><span class="sfm-sr">Remove</span></div>
                    </div>

                    @if (invoice.Lines.Count == 0)
                    {
                        <div class="sfm-lines-empty">
                            @if (selectedBusinessPartner == null)
                            {
                                <strong>Pick the customer first</strong>
                                <span>Prices come from their price list, so items open once the customer is set.</span>
                            }
                            else
                            {
                                <strong>No lines yet</strong>
                                <span>Scan or type an item below, press Enter, type the quantity, press Enter.</span>
                            }
                        </div>
                    }

                    @for (var i = 0; i < invoice.Lines.Count; i++)
                    {
                        var index = i;
                        var line = invoice.Lines[index];
                        var stock = LineStockOf(line);
                        var lineErrors = GetLineValidationErrors(index);

                        if (showShortOnly && !stock.IsShort)
                        {
                            continue;
                        }

                        <div class="sfm-row @(stock.IsShort ? "is-short" : "") @(index == justAddedIndex ? "is-new" : "")"
                             role="row" @key="line">
                            <div class="sfm-n" role="cell">@(index + 1)</div>
                            <div class="sfm-item" role="cell">
                                <div class="sfm-item-top">
                                    <span class="sfm-item-code @(lineErrors.ContainsKey("ItemCode") ? "is-bad" : "")">
                                        @(string.IsNullOrWhiteSpace(line.ItemCode) ? "No item" : line.ItemCode)
                                    </span>
                                    @if (HasSpecialPrice(line.ItemCode))
                                    {
                                        <span class="sfm-chip is-info">customer price</span>
                                    }
                                </div>
                                <input class="sfm-input sfm-desc sfm-desc-sub" @bind="line.ItemDescription"
                                       aria-label="Description, line @(index + 1)" placeholder="Description" />
                            </div>
                            <div role="cell">
                                <NocturnePicker Class="npick-chips npick-end"
                                                Options="LineWarehouseOptions(line)"
                                                Value="@line.WarehouseCode" ValueChanged="@((string? code) => OnLineWarehouseChanged(index, code))"
                                                InheritedValue="@warehouseCode"
                                                Placeholder="Choose…" SearchPlaceholder="Search warehouses"
                                                Caption="@($"Warehouse for line {index + 1}")"
                                                AriaLabel="@($"Warehouse for line {index + 1}")" AllowClear="false"
                                                Invalid="@lineErrors.ContainsKey("Warehouse")" />
                            </div>
                            <div class="sfm-qty" role="cell">
                                @* A text field, not type="number": a number field's spinner, the
                                   mouse wheel and the arrow keys all changed the quantity by accident. *@
                                <input type="text" inputmode="decimal" autocomplete="off"
                                       class="sfm-input sfm-num sfm-qty-in @(lineErrors.ContainsKey("Quantity") || stock.IsShort ? "is-bad" : "")"
                                       value="@line.Quantity" aria-label="Quantity, line @(index + 1)"
                                       @onchange="e => OnQuantityChange(index, e.Value?.ToString())" />
                                <span class="sfm-stock is-@stock.State.ToString().ToLowerInvariant()">@StockNote(stock)</span>
                            </div>
                            @* The price comes from SAP and cannot be changed here. *@
                            <div class="sfm-r sfm-price @(lineErrors.ContainsKey("UnitPrice") ? "is-bad" : "")" role="cell"
                                 title="Set from the SAP price list">
                                @GetDisplayPrice(line.UnitPrice ?? 0).ToString("N2")
                            </div>
                            <div role="cell">
                                @* step matches SAP's six-decimal discounts so a special price like 5.714286% is not flagged as invalid *@
                                <input type="number" min="0" max="100" step="0.000001"
                                       class="sfm-input sfm-num sfm-disc @((line.DiscountPercent ?? 0) > 0 ? "has-disc" : "")"
                                       aria-label="Discount percent, line @(index + 1)" @bind="line.DiscountPercent" />
                            </div>
                            <div class="sfm-r" role="cell">
                                <div class="sfm-amt-v">@GetDisplayLineTotal(line).ToString("N2")</div>
                                <div class="sfm-amt-x">@AlternatePriceLabel @GetAlternateLineTotal(line).ToString("N2")</div>
                            </div>
                            <div role="cell">
                                @* The glyph is drawn inline, not set in the icon font: it is this
                                   button's only label, so a font that fails to load would leave an
                                   empty square that reads as a broken control. *@
                                <button type="button" class="sfm-btn-x" title="Remove line"
                                        aria-label="Remove line @(index + 1)"
                                        @onclick="() => RemoveLine(index)">
                                    <svg viewBox="0 0 256 256" aria-hidden="true" focusable="false">
                                        <path d="M205.66,194.34a8,8,0,0,1-11.32,11.32L128,139.31,61.66,205.66a8,8,0,0,1-11.32-11.32L116.69,128,50.34,61.66A8,8,0,0,1,61.66,50.34L128,116.69l66.34-66.35a8,8,0,0,1,11.32,11.32L139.31,128Z" />
                                    </svg>
                                </button>
                            </div>
                            @{
                                var otherErrors = lineErrors.Where(e => e.Key != "Stock").Select(e => e.Value).ToList();
                            }
                            @if (otherErrors.Count > 0)
                            {
                                <div class="sfm-row-err" role="cell">@string.Join(" · ", otherErrors)</div>
                            }
                            @if (stock.IsShort)
                            {
                                var cover = CoverFrom(line);
                                <div class="sfm-short" role="cell">
                                    <i class="ph-fill ph-warning-circle"></i>
                                    <span class="sfm-short-t">@ShortText(line, stock)</span>
                                    @if (cover is { } c)
                                    {
                                        <button type="button" class="sfm-fix is-move"
                                                @onclick="() => OnLineWarehouseChanged(index, c.WarehouseCode)">
                                            Take from @c.WarehouseCode (@FormatQty(c.InStock) in stock)
                                        </button>
                                    }
                                    @if (LineCanTake(line, stock) is var canTake && canTake > 0)
                                    {
                                        <button type="button" class="sfm-fix" @onclick="() => SetLineQuantity(index, canTake)">
                                            Invoice @FormatQty(canTake)
                                        </button>
                                    }
                                    <button type="button" class="sfm-fix is-quiet" @onclick="() => RemoveLine(index)">Remove line</button>
                                </div>
                            }
                        </div>
                    }

                    @if (showShortOnly && ShortLineCount > 0 && invoice.Lines.Count > ShortLineCount)
                    {
                        <div class="sfm-lines-hidden">
                            @(invoice.Lines.Count - ShortLineCount) lines with enough stock are hidden.
                            <button type="button" @onclick="() => showShortOnly = false">Show all lines</button>
                        </div>
                    }
                </div>
            </div>

            <!-- ── Add item: the cursor lives here ─────────────────────────── -->
            <div class="sfm-entry">
                <div class="sfm-entry-row">
                    <div class="sfm-lab sfm-entry-item">
                        <label class="sfm-lab-t is-accent" for="inv-entry-item">Add item</label>
                        <div class="sfm-combo">
                            <i class="ph ph-magnifying-glass sfm-entry-icon" aria-hidden="true"></i>
                            <input id="inv-entry-item" @ref="entryItemRef" class="sfm-input sfm-entry-input"
                                   value="@EntryText" @oninput="e => OnEntryInput(e.Value?.ToString())"
                                   @onkeydown="OnEntryKeyDown" @onblur="OnEntryBlur"
                                   placeholder="@EntryPlaceholder" autocomplete="off" spellcheck="false"
                                   role="combobox" aria-expanded="@(entryOpen ? "true" : "false")" aria-controls="inv-entry-list"
                                   disabled="@EntryDisabled" />
                            @if (entryOpen)
                            {
                                <div id="inv-entry-list" class="sfm-drop sfm-entry-drop" role="listbox" aria-label="Matching items">
                                    @if (entryMatches.Count == 0)
                                    {
                                        <div class="sfm-drop-empty">No item matches “@entryText.Trim()”. Check the code, or refresh the cache.</div>
                                    }
                                    @for (var m = 0; m < entryMatches.Count; m++)
                                    {
                                        var matchIndex = m;
                                        var product = entryMatches[matchIndex];
                                        var shipStock = ShipFromStockNote(product.ItemCode);
                                        <button type="button" role="option" aria-selected="@(matchIndex == entryActive ? "true" : "false")"
                                                class="sfm-drop-i @(matchIndex == entryActive ? "is-sel" : "")"
                                                @onmousedown:preventDefault="true"
                                                @onclick="() => PickEntry(product)">
                                            <span class="sfm-drop-main">
                                                <span class="sfm-drop-name">@product.ItemName</span>
                                                <span class="sfm-drop-sub">@product.ItemCode</span>
                                            </span>
                                            @if (HasSpecialPrice(product.ItemCode))
                                            {
                                                <span class="sfm-chip is-info">customer price</span>
                                            }
                                            <span class="sfm-drop-stock @shipStock.Css">@shipStock.Text</span>
                                            <span class="sfm-drop-amt">@GetDisplayPrice(GetPricingForItem(product.ItemCode, product.Price).NetPrice).ToString("N2")</span>
                                        </button>
                                    }
                                    <div class="sfm-drop-foot">
                                        <span>@entryMatches.Count of @entryMatchTotal.ToString("N0") matches · prices @DisplayPriceLabel</span>
                                        <span><kbd>↑</kbd><kbd>↓</kbd> move</span>
                                        <span><kbd>Enter</kbd> pick, then qty</span>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                    <label class="sfm-lab sfm-entry-qty">
                        <span class="sfm-lab-t">Qty</span>
                        <input @ref="entryQtyRef" type="text" inputmode="decimal" autocomplete="off"
                               class="sfm-input sfm-num sfm-entry-input @(entryQtyBad ? "is-bad" : "")"
                               value="@entryQty" @oninput="e => OnEntryQtyInput(e.Value?.ToString())"
                               @onkeydown="OnEntryQtyKeyDown" placeholder="1" disabled="@EntryDisabled" />
                    </label>
                    <div class="sfm-lab sfm-entry-amt">
                        <span class="sfm-lab-t">Line amount</span>
                        <span class="sfm-entry-amt-v">@EntryPreviewAmount</span>
                    </div>
                    <button type="button" class="sfm-btn sfm-btn-accent sfm-entry-add" @onclick="AddEntryLineAsync"
                            disabled="@EntryDisabled">
                        Add line <kbd>Enter</kbd>
                    </button>
                </div>
                @if (entryPicked != null)
                {
                    var pickedStock = ShipFromStockNote(entryPicked.ItemCode);
                    <div class="sfm-entry-stock @pickedStock.Css" role="status">
                        <i class="ph ph-package"></i>@entryPicked.ItemCode &middot; @pickedStock.Long
                    </div>
                }
                <div class="sfm-keys">
                    <span><kbd>↑</kbd><kbd>↓</kbd> choose</span>
                    <span><kbd>Enter</kbd> item → qty → add</span>
                    <span><kbd>Esc</kbd> clear</span>
                    <span><kbd>Ctrl</kbd><kbd>Enter</kbd> create invoice</span>
                </div>
            </div>
        </section>
    </div>

    <!-- ── Action bar: totals and the one button that matters ─────────────── -->
    <div class="sfm-actionbar">
        <div class="sfm-actionbar-in">
            <div class="sfm-ready">
                @{
                    var issues = ReadinessIssues();
                }
                @if (issues.Count == 0)
                {
                    <span class="sfm-ready-ok"><i class="ph-bold ph-check"></i>Ready to post &middot; @invoice.Lines.Count line@(invoice.Lines.Count == 1 ? "" : "s")</span>
                }
                else
                {
                    <span class="sfm-ready-no @(postRefused ? "is-attn" : "")" role="status">
                        <i class="ph-fill ph-warning"></i>
                        @foreach (var issue in issues.Take(4))
                        {
                            <span class="sfm-issue">@issue</span>
                        }
                        @if (issues.Count > 4)
                        {
                            <span class="sfm-issue">+@(issues.Count - 4) more</span>
                        }
                    </span>
                }
                <label class="sfm-check">
                    <input type="checkbox" @bind="notifyCustomerByEmail" />Email the customer a copy
                </label>
            </div>

            <dl class="sfm-totals">
                <div>
                    <dt>Subtotal</dt>
                    <dd>@CalculateSubtotal().ToString("N2")</dd>
                </div>
                <div>
                    <dt>VAT @VatLabel</dt>
                    <dd class="is-vat">@CalculateVatAmount().ToString("N2")</dd>
                </div>
                <div>
                    <dt>Total @invoice.DocCurrency</dt>
                    <dd class="is-total">@CalculateTotalInclVat().ToString("N2")</dd>
                </div>
            </dl>

            <div class="sfm-actions">
                <button type="button" class="sfm-btn sfm-btn-danger sfm-clear" @onclick="ClearForm" disabled="@isSubmitting">
                    Clear
                </button>
                <button type="button" class="sfm-btn-solid sfm-post @(issues.Count > 0 ? "is-blocked" : "")"
                        @onclick="SubmitInvoice" disabled="@isSubmitting"
                        title="Posts straight to SAP Business One. Only a credit note reverses it.">
                    @if (isSubmitting)
                    {
                        <span class="sfm-spin on-solid"></span>
                        <span>Creating&hellip;</span>
                    }
                    else
                    {
                        <span>Create invoice</span>
                        <kbd>Ctrl ↵</kbd>
                    }
                </button>
            </div>
        </div>
    </div>
</div>

<!-- ── Print dialog ───────────────────────────────────────────────────── -->
@if (showPrintDialog)
{
    <div class="sfm-modal" @onclick="() => showPrintDialog = false">
        <div class="sfm-dialog" @onclick:stopPropagation="true">
            <div class="sfm-dialog-hd">
                <i class="ph-fill ph-printer"></i>
                <h3>Print invoice #@(lastCreatedInvoice?.DocNum)</h3>
                <span class="sfm-spacer"></span>
                <button type="button" class="sfm-alert-x" @onclick="() => showPrintDialog = false"
                        aria-label="Close">
                    <i class="ph ph-x"></i>
                </button>
            </div>
            <div class="sfm-dialog-bd">
                <label class="sfm-lab sfm-w-narrow">
                    <span class="sfm-lab-t">Copies</span>
                    <input type="number" min="1" max="10" class="sfm-input" @bind="printCopies" />
                </label>

                @* A web page cannot name a printer or set a copy count on a job — the browser's own
                   dialog owns both. So this is guidance for the operator, not a device setting. *@
                <div class="sfm-field-meta">
                    Your browser's print dialog opens next — choose the printer
                    @if (printCopies > 1)
