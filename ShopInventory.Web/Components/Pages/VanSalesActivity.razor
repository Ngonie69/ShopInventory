@page "/van-sales/activity"
@* Admin and Manager only. A sales rep supervises merchandisers, not vans, and reads
   /timesheets; the API agrees — this page's data sits behind vansales.attendance.view,
   which a SalesRep does not hold, so the role list here and the permission there cannot
   drift apart into a page that renders and then fails to load. *@
@attribute [Authorize(Roles = "Admin,Manager")]
@rendermode InteractiveServer
@using System.Globalization
@using ShopInventory.Web.Models
@implements IAsyncDisposable
@inject IVanSalesAttendanceService VanSalesAttendanceService
@inject IJSRuntime JS

<PageTitle>Van Sales Activity - Shop Inventory</PageTitle>

@* The audit ledger — Van Activity.dc.html, concept 1a.

   Carried by wwwroot/css/van-sales.css (linked from App.razor) in both schemes.

   One row per round, with the whole day drawn as a strip, so fifty rounds can be
   scanned without opening any of them. A van's unit of work is the round, not the
   call: seventeen rows in check-in order say far less than "Tinashe, Tuesday,
   fourteen calls, first at 07:41, last at 18:05, two never closed". The
   compliance report answers how the day scored; this answers what happened in it.

   Rounds are assembled here rather than by the API because a round spans a page
   boundary: the endpoint pages by call, so grouping whatever happened to land on
   page 3 would cut rounds in half and mis-state every per-round figure on the
   screen. The period is fetched whole (bounded — see MaxCalls) and the searching,
   flagging and paging below are all over that set.

   Three markers earn their place on every row. A last-known GPS fix is not a fix
   taken at the door and a map pin looks identical either way, so it is labelled —
   and a call with no fix at all is kept off the map entirely rather than dropped
   at a guess. A visit queued on a handset with no signal is marked as such: its
   time is the rep's own clock rather than the server's, which is the right answer
   but one a supervisor should be able to see they are relying on. *@

<div class="vs vsa">

    <div class="vs-head">
        <div>
            <h2 class="vs-title">Van sales activity</h2>
            <p class="vs-subtitle">
                Check-in and check-out for the vans, grouped into rounds.
                Merchandiser visits are on the Timesheets page.
            </p>
        </div>
        <div class="vsa-head-actions">
            <button class="vs-btn" @onclick="ExportCsvAsync" disabled="@(isLoading || filtered.Count == 0)">
                Export CSV
            </button>
        </div>
    </div>

    <div class="vsa-bar">
        <div class="vsa-seg" role="group" aria-label="Period">
            @foreach (var option in PeriodOptions)
            {
                <button type="button"
                        class="vsa-seg-btn @(period == option.Key ? "vsa-seg-on" : "")"
                        aria-pressed="@(period == option.Key)"
                        disabled="@isLoading"
                        @onclick="() => SetPeriodAsync(option.Key)">
                    @PeriodLabel(option.Key)
                </button>
            }
        </div>

        <div class="vsa-search">
            <span class="vsa-search-icon" aria-hidden="true">⌕</span>
            <input class="vsa-search-input"
                   value="@query"
                   @oninput="OnQueryInput"
                   aria-label="Filter rounds"
                   placeholder="Rep, van, route, customer or code" />
        </div>

        <div class="vsa-flags" role="group" aria-label="Exception filters">
            @foreach (var flag in FlagOptions)
            {
                <button type="button"
                        class="vsa-flag @(flags.Contains(flag.Key) ? "vsa-flag-on" : "")"
                        aria-pressed="@flags.Contains(flag.Key)"
                        @onclick="() => ToggleFlag(flag.Key)">
                    @flag.Label<span class="vsa-flag-count">@FlagCount(flag.Key)</span>
                </button>
            }
        </div>

        <button type="button" class="vs-btn vsa-reset" @onclick="ResetAsync" disabled="@isLoading">Reset</button>
    </div>

    @if (period == PeriodChoice.Custom)
    {
        @* NocturneDateField, never <input type="date"> — see the compliance page for why. *@
        <div class="vsa-custom">
            <div class="vsa-custom-field">
                <label class="vs-filter-label" for="vsa-from">From</label>
                <NocturneDateField Id="vsa-from" @bind-Date="fromDate" AriaLabel="From date" />
            </div>
            <div class="vsa-custom-field">
                <label class="vs-filter-label" for="vsa-to">To</label>
                <NocturneDateField Id="vsa-to" @bind-Date="toDate" AriaLabel="To date" />
            </div>
            <button class="vs-btn vs-btn-accent" @onclick="LoadAsync" disabled="@isLoading">
                @(isLoading ? "Loading…" : "Apply")
            </button>
        </div>
    }

    <div class="vsa-summary-line">@SummaryLine()</div>

    @if (loadError is not null)
    {
        <div class="vs-notice">@loadError</div>
    }
    else if (truncatedAt is { } cap)
    {
        <div class="vs-notice">
            These dates hold more calls than one screen should claim to have audited.
            Showing the most recent @cap.ToString("N0") — narrow the dates to see the rest.
        </div>
    }

    @if (isLoading)
    {
        <div class="vs-loading">
            <MudProgressCircular Indeterminate="true" Size="Size.Small" />
            <span>Reading the rounds…</span>
        </div>
    }
    else
    {
        <div class="vsa-metrics">
            @foreach (var metric in Metrics())
            {
                <div class="vsa-metric">
                    <div class="vsa-metric-top">
                        <div class="vsa-metric-value @metric.ToneClass">@metric.Value</div>
                        <div class="vsa-metric-aside">@metric.Aside</div>
                    </div>
                    <div class="vsa-metric-track">
                        <div class="vsa-metric-bar @metric.ToneClass" style="width:@Pct(metric.Share)"></div>
                    </div>
                    <div class="vsa-metric-label">@metric.Label</div>
                </div>
            }
        </div>

        <div class="vsa-body">
            <div class="vsa-ledger">
                <div class="vsa-grid vsa-cols" aria-hidden="true">
                    <div></div>
                    <div>Rep &amp; van</div>
                    <div>Day</div>
                    <div>Round shape · @DayStartLabel — @DayEndLabel</div>
                    <div class="vsa-right">Calls</div>
                    <div class="vsa-right">On site</div>
                    <div>Needs a look</div>
                    <div></div>
                </div>
                <div class="vsa-rule"></div>

                @if (filtered.Count == 0)
                {
                    <div class="vs-empty">
                        <div class="vs-empty-title">No rounds match</div>
                        <div>No van rep checked in against these dates and filters.</div>
                    </div>
                }
                else
                {
                    @foreach (var round in pageRounds)
                    {
                        var isOpen = expandedId == round.Id;

                        <div class="vsa-round">
                            @* The grid lives on a span inside the button, not on the button itself:
                               a control element is the one place a browser is still entitled to
                               ignore `display: grid`, and this row is the page. *@
                            <button type="button"
                                    class="vsa-rowbtn"
                                    aria-expanded="@isOpen"
                                    @onclick="() => ToggleRound(round.Id)">
                            <span class="vsa-grid vsa-row @(isOpen ? "vsa-row-on" : "")">
                                <span class="vsa-status vsa-status-@round.Status"></span>

                                <span class="vsa-cell">
                                    <span class="vsa-who">@round.RepName</span>
                                    <span class="vsa-where">@round.VanLine</span>
                                </span>

                                <span class="vsa-cell">
                                    <span class="vsa-day">@round.Date.ToString("ddd dd MMM", CultureInfo.InvariantCulture)</span>
                                    <span class="vsa-where">@round.Window</span>
                                </span>

                                <span class="vsa-strip">
                                    @foreach (var tick in GridTicks)
                                    {
                                        <span class="vsa-strip-tick" style="left:@Pct(tick)"></span>
                                    }
                                    @foreach (var block in round.Blocks)
                                    {
                                        <span class="vsa-block vsa-block-@block.Tone"
                                              style="left:@Pct(block.Left); width:@Pct(block.Width)"
                                              title="@block.Title"></span>
                                    }
                                </span>

                                <span class="vsa-right vsa-num">@round.Calls</span>
                                <span class="vsa-right vsa-num">@FormatMinutes(round.OnSiteMinutes)</span>

                                <span class="vsa-chips">
                                    @foreach (var chip in round.Chips)
                                    {
                                        <span class="vs-chip @chip.CssClass">@chip.Label</span>
                                    }
                                </span>

                                <span class="vsa-chevron @(isOpen ? "vsa-chevron-on" : "")" aria-hidden="true">›</span>
                            </span>
                            </button>

                            @if (isOpen)
                            {
                                <div class="vsa-detail">
                                    <div class="vsa-detail-head">
                                        <div class="vsa-detail-line">@round.DetailLine</div>
                                        @if (round.Stops.Count > 0)
                                        {
                                            <div class="vsa-detail-hint">Click a call to pin it on the map →</div>
                                        }
                                    </div>

                                    <div class="vsa-grid vsa-call-cols" aria-hidden="true">
                                        <div>#</div><div>Customer</div><div>In</div><div>Out</div>
                                        <div>Duration</div><div>Position</div><div>Notes</div>
                                    </div>

                                    @foreach (var call in round.CallRows)
                                    {
                                        @* A call with no fix stays focusable and readable — it is
                                           only unpinnable, and disabling it would take the row a
                                           keyboard reader most wants to reach out of the tab order. *@
                                        <button type="button"
                                                class="vsa-callbtn @(call.StopIndex < 0 ? "vsa-callbtn-flat" : "")"
                                                aria-disabled="@(call.StopIndex < 0)"
                                                @onclick="() => PinStop(call.StopIndex)">
                                        <span class="vsa-grid vsa-call @(call.StopIndex >= 0 && call.StopIndex == activeStop ? "vsa-call-on" : "")">
                                            <span class="vsa-num vsa-call-n">@call.Number</span>

                                            <span class="vsa-cell">
                                                <span class="vsa-call-name">@call.Visit.CustomerName</span>
                                                <span class="vsa-where">@call.Visit.CustomerCode</span>
                                            </span>

                                            <span class="vsa-num">@call.InLabel</span>
                                            <span class="vsa-num">@call.OutLabel</span>

                                            <span class="vsa-cell">
                                                <span class="vsa-num">@call.DurationLabel</span>
                                                <span class="vsa-dur-track">
                                                    <span class="vsa-dur-bar @(call.IsOpen ? "vsa-tone-info" : "")"
                                                          style="width:@Pct(call.DurationShare)"></span>
                                                </span>
                                            </span>

                                            <span class="vsa-pos">
                                                <span class="vsa-where">@call.Position</span>
                                                @if (call.PositionChip is { } posChip)
                                                {
                                                    <span class="vs-chip @posChip.CssClass">@posChip.Label</span>
                                                }
                                            </span>

                                            <span class="vsa-pos">
                                                @if (call.Visit.WasCapturedOffline)
                                                {
                                                    <span class="vs-chip vs-chip-neutral">Offline</span>
                                                }
                                                <span class="vsa-where vsa-note">@call.Note</span>
                                            </span>
                                        </span>
                                        </button>
                                    }
                                </div>
                            }
                        </div>
                    }

                    <div class="vsa-grid vsa-axis-row" aria-hidden="true">
                        <div></div><div></div><div></div>
                        <div class="vsa-axis">
                            @foreach (var mark in AxisMarks)
                            {
                                <span class="vsa-axis-mark" style="left:@Pct(mark.At); @mark.Nudge">@mark.Label</span>
                            }
                        </div>
                        <div></div><div></div><div></div><div></div>
                    </div>

                    <div class="vsa-foot">
                        <div class="vsa-foot-label">@PageLabel()</div>
                        <div class="vsa-foot-actions">
                            <button class="vs-btn" disabled="@(currentPage <= 1)"
                                    @onclick="() => GoToPage(currentPage - 1)">Previous</button>
                            <button class="vs-btn" disabled="@(currentPage >= TotalPages)"
                                    @onclick="() => GoToPage(currentPage + 1)">Next</button>
                        </div>
                    </div>
                }
            </div>

            <div class="vsa-rail">
                <div class="vsa-map-card">
                    <div class="vsa-map-head">
                        <div class="vsa-map-kicker">Round on the ground</div>
                        <div class="vsa-map-title">@(MapRound?.RepName ?? "No round selected")</div>
                        <div class="vsa-where">@MapSubtitle()</div>
                    </div>

                    @if (MapStops.Count > 0)
                    {
                        <div id="@MapElementId" class="vsa-map"></div>
                    }
                    else
                    {
                        <div class="vsa-map vsa-map-blank">
                            <span>@(MapRound is null ? "Adjust the filters" : "No call on this round recorded a position")</span>
                        </div>
                    }

                    <div class="vsa-legend">
                        <span class="vsa-legend-item"><span class="vsa-legend-dot"></span>Fix at the door</span>
                        <span class="vsa-legend-item"><span class="vsa-legend-dot vsa-legend-stale"></span>Last known</span>
                        <span class="vsa-legend-stat">@MapStat()</span>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

@code {
    // The strip's window. Wide enough for a van day start to finish; anything outside it is clamped
    // to the edge rather than dropped, so a 04:40 check-in still shows as a block hard against the
    // left rather than vanishing off a chart that claims to draw the whole round.
    private const int DayStartMinutes = 5 * 60;
    private const int DayEndMinutes = 20 * 60;
    private const double DaySpan = DayEndMinutes - DayStartMinutes;

    private const int RoundsPerPage = 9;

    // How long a van has to stand still before the wait is a finding rather than a lunch break.
    //
    // The design labelled this filter "Idle 1h+" and then thresholded it at 100 minutes, which cannot
    // both be true. An hour is the wrong one to keep: on a week of real rounds it flagged 33 of 58,
    // and a filter that matches most of the list is not a filter. Ninety minutes is the design's
    // intent, and the label, the chip, the row's own status rail and the filter all read this.
    private const double IdleMinutes = 90;

    // The "Needs a look" column is one line of a row. See BuildChips.
    private const int MaxChips = 3;

    // The period is read whole so rounds are not cut in half by a page boundary — but "whole" needs a
    // ceiling, or a year-wide custom range walks every call the vans have ever made into one Blazor
    // circuit's memory. Six weeks of the current fleet fits inside this; past it the page says so
    // rather than silently reporting on a slice.
    private const int FetchPageSize = 500;
    private const int MaxCalls = 3000;

    // A call with no fix must never look like a call with one, so the strip's gridlines and the axis
    // below it are the same five marks, stated once.
    private static readonly double[] GridTicks = [1d / 15, 4d / 15, 7d / 15, 10d / 15, 13d / 15];

    private static readonly (double At, string Label, string Nudge)[] AxisMarks =
    [
        (0, "05", "transform:none;"),
        (1d / 15, "06", "transform:translateX(-50%);"),
        (4d / 15, "09", "transform:translateX(-50%);"),
        (7d / 15, "12", "transform:translateX(-50%);"),
        (10d / 15, "15", "transform:translateX(-50%);"),
        (13d / 15, "18", "transform:translateX(-50%);"),
        (1, "20", "transform:translateX(-100%);")
    ];

    private const string DayStartLabel = "05:00";
    private const string DayEndLabel = "20:00";

    private const string MapElementId = "vsa-round-map";

    private enum PeriodChoice { Today, Last3, Week, Custom }

    private static readonly (PeriodChoice Key, int Days)[] PeriodOptions =
    [
        (PeriodChoice.Today, 0),
        (PeriodChoice.Last3, 2),
        (PeriodChoice.Week, 6),
        (PeriodChoice.Custom, 6)
    ];

    private static readonly (string Key, string Label)[] FlagOptions =
    [
        ("open", "Open"),
        ("offline", "Offline"),
        ("nofix", "No fix"),
        ("gap", "Idle 90m+")
    ];

    private PeriodChoice period = PeriodChoice.Week;
    private DateTime? fromDate;
    private DateTime? toDate;
    private string query = string.Empty;
    private readonly HashSet<string> flags = [];

    private bool isLoading;
    private string? loadError;
    private int? truncatedAt;

    private List<Round> allRounds = [];
    private List<Round> filtered = [];
    private List<Round> pageRounds = [];

    private int currentPage = 1;
    private string? expandedId;
    private int activeStop = -1;

    private string? drawnMapKey;
    private bool mapDrawn;

    private int TotalPages => Math.Max(1, (int)Math.Ceiling((double)filtered.Count / RoundsPerPage));

    /// <summary>
    /// The round the map is showing: the opened one, or the first in view when nothing is opened.
    /// Never an arbitrary round — the map's caption names it, so the two cannot disagree.
    /// </summary>
    private Round? MapRound =>
        (expandedId is not null ? filtered.FirstOrDefault(round => round.Id == expandedId) : null)
        ?? pageRounds.FirstOrDefault();

    private List<Stop> MapStops => MapRound?.Stops ?? [];

    protected override async Task OnInitializedAsync()
    {
        ApplyPeriodDates();
        await LoadAsync();
    }

    // ---- Loading -----------------------------------------------------------------------------

    private void ApplyPeriodDates()
    {
        if (period == PeriodChoice.Custom) return;

        var back = PeriodOptions.First(option => option.Key == period).Days;
        var today = Today();

        fromDate = today.AddDays(-back);
        toDate = today;
    }

    private async Task LoadAsync()
    {
        isLoading = true;
        loadError = null;
        truncatedAt = null;
        StateHasChanged();

        try
        {
            // Inclusive of the whole closing day, and expressed as the UTC window the API filters on.
            var fromUtc = fromDate?.Date.AddHours(-2);
            var toUtc = toDate?.Date.AddDays(1).AddHours(-2).AddSeconds(-1);

            var visits = new List<VanVisitDto>();
            var page = 1;

            while (true)
            {
                var response = await VanSalesAttendanceService.GetVisitsAsync(
                    page, FetchPageSize, fromDate: fromUtc, toDate: toUtc);

                if (response is null)
                {
                    loadError = "Van sales activity could not be loaded. Check that the API is reachable.";
                    allRounds = [];
                    Refilter();
                    return;
                }

                visits.AddRange(response.Entries);

                // Stop on a short page as well as on the count: an entry deleted between two requests
                // would otherwise leave the loop asking for a page that no longer exists, forever.
                if (response.Entries.Count < FetchPageSize || visits.Count >= response.TotalCount) break;

                if (visits.Count >= MaxCalls)
                {
                    truncatedAt = MaxCalls;
                    break;
                }

                page++;
            }

            allRounds = BuildRounds(visits);
            Refilter();
        }
        catch (Exception ex)
        {
            loadError = $"Failed to load van sales activity: {ex.Message}";
            allRounds = [];
            Refilter();
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    // ---- Filtering ---------------------------------------------------------------------------

    private void Refilter()
    {
        var term = query.Trim();

        filtered = allRounds
            .Where(round => !flags.Contains("open") || round.OpenCalls > 0)
            .Where(round => !flags.Contains("offline") || round.OfflineCalls > 0)
            .Where(round => !flags.Contains("nofix") || round.NoFixCalls > 0)
            .Where(round => !flags.Contains("gap") || round.LongestGapMinutes >= IdleMinutes)
            .Where(round => round.Matches(term))
            .ToList();

        currentPage = Math.Clamp(currentPage, 1, TotalPages);

        if (expandedId is not null && filtered.All(round => round.Id != expandedId))
        {
            expandedId = null;
            activeStop = -1;
        }

        RepageAndKeepExpansion();
    }

    /// <summary>
    /// Take the current page, and keep an opened round visible on it. Opening a round on page 2 and
    /// then having the map caption name a round from page 1 is the kind of quiet disagreement this
    /// page exists to prevent.
    /// </summary>
    private void RepageAndKeepExpansion()
    {
        if (expandedId is not null)
        {
            var at = filtered.FindIndex(round => round.Id == expandedId);
            if (at >= 0) currentPage = at / RoundsPerPage + 1;
        }

        pageRounds = filtered.Skip((currentPage - 1) * RoundsPerPage).Take(RoundsPerPage).ToList();
    }

    private async Task SetPeriodAsync(PeriodChoice choice)
    {
        period = choice;
        currentPage = 1;
        expandedId = null;
        activeStop = -1;

        if (choice == PeriodChoice.Custom)
        {
            // Custom opens on whatever window was last loaded, so the pickers start from something
            // real rather than from empty fields, and nothing is fetched until Apply is pressed.
            return;
        }

        ApplyPeriodDates();
        await LoadAsync();
    }

    private void OnQueryInput(ChangeEventArgs e)
    {
        query = e.Value?.ToString() ?? string.Empty;
        currentPage = 1;
        expandedId = null;
        activeStop = -1;
        Refilter();
    }

    private void ToggleFlag(string key)
    {
        if (!flags.Remove(key)) flags.Add(key);

        currentPage = 1;
        expandedId = null;
        activeStop = -1;
        Refilter();
    }

    private async Task ResetAsync()
    {
        query = string.Empty;
        flags.Clear();
        currentPage = 1;
        expandedId = null;
        activeStop = -1;
        period = PeriodChoice.Week;

        ApplyPeriodDates();
        await LoadAsync();
    }

    private void GoToPage(int page)
    {
        currentPage = Math.Clamp(page, 1, TotalPages);
        expandedId = null;
        activeStop = -1;
        RepageAndKeepExpansion();
    }

    private void ToggleRound(string id)
    {
        expandedId = expandedId == id ? null : id;
        activeStop = -1;
    }

    private void PinStop(int stopIndex)
    {
        if (stopIndex < 0) return;
        activeStop = activeStop == stopIndex ? -1 : stopIndex;
    }

    private int FlagCount(string key) => key switch
    {
        "open" => allRounds.Count(round => round.OpenCalls > 0),
        "offline" => allRounds.Count(round => round.OfflineCalls > 0),
        "nofix" => allRounds.Count(round => round.NoFixCalls > 0),
        "gap" => allRounds.Count(round => round.LongestGapMinutes >= IdleMinutes),
        _ => 0
    };

    // ---- The map -----------------------------------------------------------------------------

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        var stops = MapStops;

        if (stops.Count == 0)
        {
            // The element is gone from the DOM, so the map object holding it has to go too.
            if (mapDrawn)
            {
                mapDrawn = false;
                drawnMapKey = null;
                await SafeDisposeMapAsync();
            }

            return;
        }

        // Redraw on a changed round or a changed pin, and not otherwise: the JS keeps its markers
        // between calls, and calling it on every Blazor render would still cost an interop hop per
        // keystroke in the search box.
        var key = $"{MapRound?.Id}|{activeStop}";
        if (mapDrawn && key == drawnMapKey) return;

        drawnMapKey = key;
        mapDrawn = true;

        try
        {
            await JS.InvokeVoidAsync("vanMap.render", MapElementId, stops, activeStop);
        }
        catch (JSDisconnectedException)
        {
            // The circuit went away mid-render. Nothing to draw on and nothing to report.
        }
    }

    public async ValueTask DisposeAsync()
    {
        if (mapDrawn) await SafeDisposeMapAsync();
    }

    private async Task SafeDisposeMapAsync()
    {
        try
        {
            await JS.InvokeVoidAsync("vanMap.dispose", MapElementId);
        }
        catch (JSDisconnectedException)
        {
            // The browser is already gone; the map went with it.
        }
        catch (InvalidOperationException)
        {
            // Disposed before the circuit was ever interactive — there is no map yet.
        }
    }

    private string MapSubtitle()
    {
        if (MapRound is not { } round) return "Adjust the filters";

        var suffix = expandedId == round.Id ? "" : " · first round in view";
        return $"{round.VanLine} · {round.Date.ToString("ddd dd MMM yyyy", CultureInfo.InvariantCulture)}{suffix}";
    }

    private string MapStat()
    {
        if (MapRound is not { } round) return string.Empty;

        var plural = round.Calls == 1 ? "call" : "calls";

        return round.NoFixCalls > 0
            ? $"{round.Calls} {plural} · {round.NoFixCalls} without a fix"
            : $"{round.Calls} {plural} · all positioned";
    }

    // ---- Headline figures --------------------------------------------------------------------

    private string SummaryLine()
    {
        var calls = filtered.Sum(round => round.Calls);
        var window = fromDate is { } from && toDate is { } to
            ? from.Date == to.Date
                ? from.ToString("ddd dd MMM yyyy", CultureInfo.InvariantCulture)
                : $"{from.ToString("ddd dd MMM", CultureInfo.InvariantCulture)} – {to.ToString("ddd dd MMM yyyy", CultureInfo.InvariantCulture)}"
            : "";

        var line = $"{filtered.Count} {(filtered.Count == 1 ? "round" : "rounds")} · {calls} {(calls == 1 ? "call" : "calls")} · {window}";

        return flags.Count > 0
            ? $"{line} · {flags.Count} flag filter{(flags.Count == 1 ? "" : "s")}"
            : line;
    }

    private string PageLabel()
    {
        var calls = filtered.Sum(round => round.Calls);
        return $"Page {currentPage} of {TotalPages} · {filtered.Count} rounds · {calls} calls";
    }

    private sealed record Metric(string Value, string Label, string Aside, double Share, string ToneClass);

    /// <summary>
    /// The five figures over the ledger.
    /// </summary>
    /// <remarks>
    /// Each bar is the plain share it describes — exceptions over calls — with a visible floor when
    /// the count is not zero. Deliberately not the design's scaled bar: a 2% no-fix rate drawn at 16%
    /// so it can be seen is a chart that lies about the number printed above it, and this page is an
    /// audit. A sliver that says "some, and few" is the honest version of the same signal.
    /// </remarks>
    private List<Metric> Metrics()
    {
        var calls = filtered.Sum(round => round.Calls);
        var allCalls = allRounds.Sum(round => round.Calls);
        var open = filtered.Sum(round => round.OpenCalls);
        var noFix = filtered.Sum(round => round.NoFixCalls);
        var stale = filtered.Sum(round => round.StaleCalls);
        var offline = filtered.Sum(round => round.OfflineCalls);
        var unproven = noFix + stale;

        return
        [
            new Metric(
                filtered.Count.ToString("N0"), "Rounds in view", $"of {allRounds.Count:N0}",
                allRounds.Count == 0 ? 0 : (double)filtered.Count / allRounds.Count, ""),

            new Metric(
                calls.ToString("N0"), "Calls audited",
                filtered.Count == 0 ? "" : $"{(double)calls / filtered.Count:F1} avg",
                allCalls == 0 ? 0 : (double)calls / allCalls, ""),

            new Metric(
                open.ToString("N0"), "Never checked out", "needs closing",
                Share(open, calls), open > 0 ? "vsa-tone-info" : "vsa-tone-none"),

            new Metric(
                unproven.ToString("N0"), "Position unproven", $"{noFix:N0} no fix",
                Share(unproven, calls), unproven > 0 ? "vsa-tone-bad" : "vsa-tone-none"),

            new Metric(
                offline.ToString("N0"), "Captured offline", "rep clock",
                Share(offline, calls), offline > 0 ? "vsa-tone-neutral" : "vsa-tone-none")
        ];
    }

    private static double Share(int part, int whole)
    {
        if (whole == 0 || part == 0) return 0;
        return Math.Max(0.02, (double)part / whole);
    }

    private static string Pct(double share) =>
        (Math.Clamp(share, 0, 1) * 100).ToString("0.##", CultureInfo.InvariantCulture) + "%";

    // ---- Export ------------------------------------------------------------------------------

    private async Task ExportCsvAsync()
    {
        // The filtered set, not the page: the button sits beside the filters and exports what they
        // describe. Every round in view, call by call, in the order the reader is looking at.
        var csv = new System.Text.StringBuilder();
        csv.AppendLine("Rep,Van,Route,Trading day,Customer code,Customer,In CAT,Out CAT,Duration minutes,Latitude,Longitude,Fix,Accuracy m,Captured offline,Check-in notes,Check-out notes");

        foreach (var round in filtered)
        {
            foreach (var call in round.CallRows)
            {
                var visit = call.Visit;

                csv.AppendJoin(',',
                    Csv(round.RepName),
                    Csv(visit.TruckRegNo),
                    Csv(visit.RouteName),
                    Csv(round.Date.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture)),
                    Csv(visit.CustomerCode),
                    Csv(visit.CustomerName),
                    Csv(ToCat(visit.CheckInTime).ToString("HH:mm", CultureInfo.InvariantCulture)),
                    Csv(visit.CheckOutTime is { } outTime ? ToCat(outTime).ToString("HH:mm", CultureInfo.InvariantCulture) : "Open"),
                    Csv(visit.DurationMinutes?.ToString("F0", CultureInfo.InvariantCulture)),
                    Csv(visit.CheckInLatitude?.ToString("F6", CultureInfo.InvariantCulture)),
                    Csv(visit.CheckInLongitude?.ToString("F6", CultureInfo.InvariantCulture)),
                    Csv(FixLabel(visit)),
                    Csv(visit.CheckInLocationAccuracyMetres?.ToString("F0", CultureInfo.InvariantCulture)),
                    Csv(visit.WasCapturedOffline ? "Yes" : "No"),
                    Csv(visit.CheckInNotes),
                    Csv(visit.CheckOutNotes));
                csv.AppendLine();
            }
        }

        var bytes = System.Text.Encoding.UTF8.GetPreamble()
            .Concat(System.Text.Encoding.UTF8.GetBytes(csv.ToString()))
            .ToArray();

        await JS.InvokeVoidAsync(
            "downloadFile",
            $"VanSalesActivity_{ToCat(DateTime.UtcNow):yyyyMMdd_HHmmss}.csv",
            "text/csv;charset=utf-8",
            Convert.ToBase64String(bytes));
    }

    private static string FixLabel(VanVisitDto visit) =>
        visit.CheckInLatitude is null || visit.CheckInLongitude is null ? "None"
        : visit.CheckInFixIsStale ? "Last known"
        : visit.HasPreciseCheckInFix ? "GPS"
        : visit.CheckInLocationSource ?? "Unknown";

    /// <summary>
    /// Quote a CSV field, and never let one open a formula. A customer name beginning "=" or "+" is
    /// executed by Excel on open, and these names come from the handset.
    /// </summary>
    private static string Csv(string? value)
    {
        if (string.IsNullOrEmpty(value)) return string.Empty;

        var safe = "=+-@\t\r".Contains(value[0]) ? "'" + value : value;
        return "\"" + safe.Replace("\"", "\"\"") + "\"";
    }

    // ---- Rounds ------------------------------------------------------------------------------

    /// <summary>
    /// Group the period's calls into rounds — one rep, one CAT trading day.
    ///
    /// Grouped on the CAT date rather than the raw UTC one, or every evening call after 22:00 local
    /// starts a second round on the following day.
    /// </summary>
    private static List<Round> BuildRounds(List<VanVisitDto> entries) =>
        entries
            .GroupBy(entry => new { entry.UserId, Date = ToCat(entry.CheckInTime).Date })
            .Select(group => Round.From(group.Key.UserId, group.Key.Date,
                                        group.OrderBy(entry => entry.CheckInTime).ToList()))
            .OrderByDescending(round => round.Date)
            .ThenBy(round => round.RepName, StringComparer.OrdinalIgnoreCase)
            .ToList();

    private sealed record Chip(string Label, string CssClass);

    private sealed record Block(double Left, double Width, string Tone, string Title);

    private sealed record Stop(int N, string Name, string Time, double Lat, double Lon, bool Stale);

    private sealed record CallRow(
        VanVisitDto Visit,
        string Number,
        int StopIndex,
        string InLabel,
        string OutLabel,
        string DurationLabel,
        double DurationShare,
        bool IsOpen,
        string Position,
        Chip? PositionChip,
        string Note);

    private sealed record Round(
        string Id,
        string RepName,
        string VanLine,
        DateTime Date,
        string Window,
        int Calls,
        int DistinctCustomers,
        double OnSiteMinutes,
        int OpenCalls,
        int OfflineCalls,
        int NoFixCalls,
        int StaleCalls,
        double LongestGapMinutes,
        string Status,
        List<Chip> Chips,
        List<Block> Blocks,
        List<CallRow> CallRows,
        List<Stop> Stops,
        string DetailLine,
        string SearchText)
    {
        public bool Matches(string term) =>
            term.Length == 0 || SearchText.Contains(term, StringComparison.OrdinalIgnoreCase);

        public static Round From(Guid userId, DateTime date, List<VanVisitDto> visits)
        {
            var first = visits[0];
            var repName = string.IsNullOrWhiteSpace(first.FullName) ? first.Username : first.FullName!;

            // The route is snapshotted per rep-day, so every call in a round carries the same one —
            // but a rep who never started a day on the handset has calls and no round record at all,
            // and a blank line there reads as a rendering fault rather than as the finding it is.
            var van = visits.Select(visit => visit.TruckRegNo).FirstOrDefault(reg => !string.IsNullOrWhiteSpace(reg));
            var route = visits.Select(visit => visit.RouteName).FirstOrDefault(name => !string.IsNullOrWhiteSpace(name));
            var vanLine = (van, route) switch
            {
                (not null, not null) => $"{van} · {route}",
                (not null, null) => van,
                (null, not null) => route,
                _ => "Route not recorded"
            };

            var openCalls = visits.Count(visit => visit.CheckOutTime is null);
            var offlineCalls = visits.Count(visit => visit.WasCapturedOffline);
            var noFixCalls = visits.Count(visit => visit.CheckInLatitude is null || visit.CheckInLongitude is null);
            var staleCalls = visits.Count(visit => visit.CheckInFixIsStale);
            var onSite = visits.Where(visit => visit.DurationMinutes.HasValue).Sum(visit => visit.DurationMinutes!.Value);

            var lastOut = visits
                .Where(visit => visit.CheckOutTime.HasValue)
                .Select(visit => ToCat(visit.CheckOutTime!.Value))
                .DefaultIfEmpty()
                .Max();
            var lastOutOrNull = lastOut.Ticks > 0 ? lastOut : (DateTime?)null;
            var firstIn = ToCat(first.CheckInTime);

            var longestGap = LongestGap(visits);
            var status = StatusOf(date, openCalls, offlineCalls, noFixCalls, staleCalls, longestGap);

            var stops = new List<Stop>();
            var callRows = new List<CallRow>();

            foreach (var visit in visits)
            {
                var hasFix = visit.CheckInLatitude is { } lat && visit.CheckInLongitude is { } lon;
                var stopIndex = -1;

                if (hasFix)
                {
                    stopIndex = stops.Count;
                    stops.Add(new Stop(
                        stops.Count + 1,
                        visit.CustomerName,
                        CallWindow(visit),
                        visit.CheckInLatitude!.Value,
                        visit.CheckInLongitude!.Value,
                        visit.CheckInFixIsStale));
                }

                callRows.Add(BuildCallRow(visit, stopIndex));
            }

            var detail = new System.Text.StringBuilder()
                .Append(visits.Count).Append(visits.Count == 1 ? " call · " : " calls · ")
                .Append(visits.Select(visit => visit.CustomerCode)
                              .Distinct(StringComparer.OrdinalIgnoreCase).Count())
                .Append(" customers · first in ").Append(firstIn.ToString("HH:mm", CultureInfo.InvariantCulture))
                .Append(lastOutOrNull is { } last
                    ? $" · last out {last.ToString("HH:mm", CultureInfo.InvariantCulture)}"
                    : openCalls == 1 ? " · one call still open" : $" · {openCalls} calls still open")
                .Append(" · longest idle gap ").Append(FormatMinutes(longestGap))
                .ToString();

            var searchText = string.Join(' ',
                new[] { repName, first.Username, van, route }
                    .Concat(visits.Select(visit => visit.CustomerName))
                    .Concat(visits.Select(visit => visit.CustomerCode))
                    .Where(part => !string.IsNullOrWhiteSpace(part)));

            return new Round(
                $"{userId:N}-{date:yyyyMMdd}",
                repName,
                vanLine!,
                date,
                lastOutOrNull is { } lastTime
                    ? $"{firstIn.ToString("HH:mm", CultureInfo.InvariantCulture)} – {lastTime.ToString("HH:mm", CultureInfo.InvariantCulture)}"
                    : $"{firstIn.ToString("HH:mm", CultureInfo.InvariantCulture)} – open",
                visits.Count,
                visits.Select(visit => visit.CustomerCode).Distinct(StringComparer.OrdinalIgnoreCase).Count(),
                onSite,
                openCalls,
                offlineCalls,
                noFixCalls,
                staleCalls,
                longestGap,
                status,
                BuildChips(openCalls, noFixCalls, staleCalls, offlineCalls, longestGap),
                BuildBlocks(visits),
                callRows,
                stops,
                detail,
                searchText);
        }

        /// <summary>
        /// How long the van stood still between two calls, at its worst. Measured from the previous
        /// check-out where there is one, and from its check-in where there is not — an unclosed call
        /// has no end, and treating it as instantaneous would invent an idle hour that never happened.
        /// </summary>
        private static double LongestGap(List<VanVisitDto> visits)
        {
            var worst = 0d;

            for (var i = 1; i < visits.Count; i++)
            {
                var previous = visits[i - 1];
                var previousEnd = previous.CheckOutTime ?? previous.CheckInTime;
                var gap = (visits[i].CheckInTime - previousEnd).TotalMinutes;

                if (gap > worst) worst = gap;
            }

            return worst;
        }

        /// <summary>
        /// How hard the round needs looking at. An unclosed call on a day that has finished is a
        /// finding; the same call on today's round is a rep who is still in the shop.
        /// </summary>
        private static string StatusOf(
            DateTime date, int open, int offline, int noFix, int stale, double longestGap)
        {
            if (noFix >= 2 || (open > 0 && date < Today())) return "flag";
            if (open > 0 || offline > 0 || stale >= 2 || longestGap >= IdleMinutes) return "watch";
            return "clean";
        }

        /// <summary>
        /// What is wrong with this round, worst first and at most three of them.
        /// </summary>
        /// <remarks>
        /// Capped because the column is one line of the row and real rounds carry four and five
        /// findings where the design's sample carried two — uncapped, a bad round grows to three lines
        /// of chips and pushes the rounds under it off the screen, which costs more attention than the
        /// fifth chip buys. The overflow is counted rather than dropped, and opening the round shows
        /// every one of them call by call.
        ///
        /// Severity order, not the order they are counted in: a round with no GPS fix and an idle hour
        /// should lead with the fix.
        /// </remarks>
        private static List<Chip> BuildChips(int open, int noFix, int stale, int offline, double longestGap)
        {
            var chips = new List<Chip>();

            if (noFix > 0) chips.Add(new Chip($"{noFix} no fix", "vs-chip-bad"));
            if (open > 0) chips.Add(new Chip($"{open} open", "vs-chip-info"));
            if (stale >= 2) chips.Add(new Chip($"{stale} last known", "vs-chip-warn"));
            if (offline > 0) chips.Add(new Chip($"{offline} offline", "vs-chip-neutral"));
            if (longestGap >= IdleMinutes) chips.Add(new Chip($"{CompactMinutes(longestGap)} idle", "vs-chip-neutral"));

            if (chips.Count == 0) return [new Chip("Clean", "vs-chip-clean")];

            if (chips.Count <= MaxChips) return chips;

            var shown = chips.Take(MaxChips - 1).ToList();
            shown.Add(new Chip($"+{chips.Count - shown.Count}", "vs-chip-clean"));

            return shown;
        }

        private static List<Block> BuildBlocks(List<VanVisitDto> visits) =>
            visits.Select(visit =>
            {
                var start = Minutes(ToCat(visit.CheckInTime));

                // An open call has no end, so it is drawn as the twelve-minute outline the design
                // gives it — long enough to see, short enough not to claim time on site that was
                // never recorded. A check-out that lands before its check-in (a round that ran past
                // midnight) is treated the same way rather than drawn backwards.
                var end = visit.CheckOutTime is { } outTime && Minutes(ToCat(outTime)) > start
                    ? Minutes(ToCat(outTime))
                    : start + 12;

                var left = Math.Clamp((start - DayStartMinutes) / DaySpan, 0, 1);
                var right = Math.Clamp((end - DayStartMinutes) / DaySpan, 0, 1);
                var width = Math.Max(0.005, right - left);

                if (left + width > 1) left = Math.Max(0, 1 - width);

                var tone =
                    visit.CheckInLatitude is null || visit.CheckInLongitude is null ? "bad"
                    : visit.CheckOutTime is null ? "open"
                    : visit.CheckInFixIsStale ? "warn"
                    : visit.WasCapturedOffline ? "neutral"
                    : "accent";

                return new Block(left, width, tone, $"{visit.CustomerName} · {CallWindow(visit)}");
            }).ToList();

        private static CallRow BuildCallRow(VanVisitDto visit, int stopIndex)
        {
            var hasFix = visit.CheckInLatitude is { } lat && visit.CheckInLongitude is { } lon;
            var isOpen = visit.CheckOutTime is null;

            var position = hasFix
                ? string.Create(CultureInfo.InvariantCulture,
                    $"{visit.CheckInLatitude!.Value:F5}, {visit.CheckInLongitude!.Value:F5}")
                : string.IsNullOrWhiteSpace(visit.LocationUnavailableReason)
                    ? "no fix recorded"
                    : visit.LocationUnavailableReason!;

            var positionChip =
                !hasFix ? new Chip("No fix", "vs-chip-bad")
                : visit.CheckInFixIsStale ? new Chip("Last known", "vs-chip-warn")
                : visit.CheckInLocationAccuracyMetres is { } metres
                    ? new Chip($"±{metres:F0}m", "vs-chip-quiet")
                    : null;

            var note = string.Join(" · ", new[] { visit.CheckInNotes, visit.CheckOutNotes }
                .Where(part => !string.IsNullOrWhiteSpace(part)));

            return new CallRow(
                visit,
                stopIndex >= 0 ? (stopIndex + 1).ToString(CultureInfo.InvariantCulture) : "–",
                stopIndex,
                ToCat(visit.CheckInTime).ToString("HH:mm", CultureInfo.InvariantCulture),
                visit.CheckOutTime is { } outTime
                    ? ToCat(outTime).ToString("HH:mm", CultureInfo.InvariantCulture)
                    : "Open",
                visit.DurationMinutes is { } minutes ? FormatMinutes(minutes) : "—",
                // Against a 45-minute call, which is a long one. Full bar means "as long as they get".
                Math.Clamp((visit.DurationMinutes ?? 6) / 45, 0, 1),
                isOpen,
                position,
                positionChip,
                note);
        }

        private static string CallWindow(VanVisitDto visit) =>
            visit.CheckOutTime is { } outTime
                ? $"{ToCat(visit.CheckInTime).ToString("HH:mm", CultureInfo.InvariantCulture)}–{ToCat(outTime).ToString("HH:mm", CultureInfo.InvariantCulture)}"
                : $"{ToCat(visit.CheckInTime).ToString("HH:mm", CultureInfo.InvariantCulture)} · still open";

        private static double Minutes(DateTime cat) => cat.TimeOfDay.TotalMinutes;
    }

    // ---- Shared helpers ----------------------------------------------------------------------

    /// <summary>
    /// The API stores UTC and this page shows CAT. A fixed offset is correct here: Zimbabwe has never
    /// observed daylight saving, and it matches what the rest of the portal already does.
    /// </summary>
    private static DateTime ToCat(DateTime utc) => utc.AddHours(2);

    private static DateTime Today() => ToCat(DateTime.UtcNow).Date;

    private static string FormatMinutes(double minutes)
    {
        var whole = (int)Math.Round(minutes);
        return whole >= 60 ? $"{whole / 60}h {whole % 60}m" : $"{whole}m";
    }

    /// <summary>The same duration without the space, for a chip that has to share a 164px column.</summary>
    private static string CompactMinutes(double minutes)
    {
        var whole = (int)Math.Round(minutes);
        return whole >= 60 ? $"{whole / 60}h{whole % 60:00}" : $"{whole}m";
    }

    private string PeriodLabel(PeriodChoice choice) => choice switch
    {
        PeriodChoice.Today => "Today",
        PeriodChoice.Last3 => "Last 3 days",
        PeriodChoice.Week => WeekLabel(),
        _ => "Custom…"
    };

    /// <summary>The week button names its own dates, so the segmented control never hides the window.</summary>
    private static string WeekLabel()
    {
        var today = Today();
        var from = today.AddDays(-6);

        return $"{from.ToString("dd", CultureInfo.InvariantCulture)} – {today.ToString("dd MMM", CultureInfo.InvariantCulture)}";
    }
}
