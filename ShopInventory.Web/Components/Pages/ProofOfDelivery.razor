@page "/pods"
@using System.Globalization
@using Microsoft.AspNetCore.Authorization
@using ShopInventory.Web.Common
@using ShopInventory.Web.Models
@using ShopInventory.Web.Services
@attribute [Authorize(Roles = "Admin,Cashier,PodOperator,Operator,Driver,SalesRep")]
@inject IPodService PodService
@inject IInvoiceService InvoiceService
@inject IJSRuntime JS
@using ShopInventory.Web.Data
@inject ILogger<ProofOfDelivery> Logger
@inject AuthenticationStateProvider AuthStateProvider
@inject IAuditService AuditService
@rendermode InteractiveServer

<PageTitle>Product PODs - Shop Inventory</PageTitle>

@* Nocturne, carried by wwwroot/css/pods.css (linked from App.razor) in both
   schemes, following the app's theme toggle like every other page. That file is
   shared with the two crate POD surfaces the tab bar leads to, which is what
   retired the pair of hand-synchronised style blocks these pages used to carry.

   Icon-only buttons draw their glyph inline rather than from the Phosphor font:
   the glyph is their whole label, so a font that fails to load would leave them
   reading as dead controls. *@

<div class="podx">

    <header class="podx-head">
        <div class="podx-shell">
            <div class="podx-head-row">
                <div class="podx-titles">
                    <div class="podx-titles-row">
                        <i class="ph ph-clipboard-text" aria-hidden="true"></i>
                        <h1 class="podx-title">Product PODs</h1>
                    </div>
                    <p class="podx-sub">Review and manage product delivery POD attachments for invoices.</p>
                </div>
                <div class="podx-head-actions">
                    <span class="podx-count">@((podResponse?.TotalCount ?? 0).ToString("N0")) POD records</span>
                    <button type="button" class="podx-btn podx-btn-secondary" @onclick="RefreshData"
                            disabled="@isLoading">
                        @if (isLoading)
                        {
                            <span class="podx-spin" aria-hidden="true"></span>
                        }
                        <span>Refresh</span>
                    </button>
                </div>
            </div>
            <PodNavTabs Active="PodNavTabs.PodNavTab.Product" />
        </div>
    </header>

    <div class="podx-body">

        @if (canUploadPods)
        {
            <section class="podx-card is-primary">
                <div class="podx-card-head">
                    <h2 class="podx-card-title">
                        <i class="ph ph-cloud-arrow-up" aria-hidden="true"></i>
                        @(uploadMode == UploadMode.Single ? "Upload product POD" : "Bulk upload product PODs")
                    </h2>
                    <div class="podx-seg" role="group" aria-label="Upload mode">
                        <button type="button" class="podx-seg-btn @(uploadMode == UploadMode.Single ? "is-on" : null)"
                                aria-pressed="@(uploadMode == UploadMode.Single)"
                                @onclick='() => SwitchUploadMode(UploadMode.Single)'>
                            <i class="ph ph-file-arrow-up" aria-hidden="true"></i>Single
                        </button>
                        <button type="button" class="podx-seg-btn @(uploadMode == UploadMode.Bulk ? "is-on" : null)"
                                aria-pressed="@(uploadMode == UploadMode.Bulk)"
                                @onclick='() => SwitchUploadMode(UploadMode.Bulk)'>
                            <i class="ph ph-files" aria-hidden="true"></i>Bulk
                        </button>
                    </div>
                </div>

                @if (uploadMode == UploadMode.Single)
                {
                    <div class="podx-card-body">
                        <div class="podx-fields">
                            <div class="podx-field">
                                <label for="podx-docnum">Invoice number</label>
                                <input id="podx-docnum" class="podx-input podx-input-num" type="number"
                                       placeholder="e.g. 10001" @bind="uploadDocNum" />
                            </div>
                            <div class="podx-field">
                                <label>&nbsp;</label>
                                <button type="button" class="podx-btn podx-btn-primary" style="width:100%"
                                        @onclick="LookupInvoice"
                                        disabled="@(uploadDocNum is null or <= 0 || isLookingUp)">
                                    @if (isLookingUp)
                                    {
                                        <span class="podx-spin" aria-hidden="true"></span>
                                        <span>Looking up…</span>
                                    }
                                    else
                                    {
                                        <span>Look up</span>
                                    }
                                </button>
                            </div>
                            <div class="podx-field is-wide">
                                @if (isLookingUp)
                                {
                                    <div class="podx-note">
                                        <span class="podx-spin" aria-hidden="true"></span>
                                        <div class="podx-note-body">Searching for invoice…</div>
                                    </div>
                                }
                                else if (lookupInvoice != null)
                                {
                                    <div class="podx-note is-ok">
                                        <i class="ph ph-check-circle" aria-hidden="true"></i>
                                        <div class="podx-note-body">
                                            Invoice #@lookupInvoice.DocNum — @lookupInvoice.CardName
                                        </div>
                                    </div>
                                }
                                else if (lookupError != null)
                                {
                                    <div class="podx-note is-bad">
                                        <i class="ph ph-warning-octagon" aria-hidden="true"></i>
                                        <div class="podx-note-body">@lookupError</div>
                                    </div>
                                }
                            </div>
                        </div>

                        <div class="podx-fields">
                            <div class="podx-field">
                                <label for="podx-files">POD file(s)</label>
                                <InputFile id="podx-files" @key="inputFileKey" OnChange="OnFilesSelected"
                                           class="podx-input" accept=".jpg,.jpeg,.png,.webp,.pdf" multiple />
                                <div class="podx-hint">JPG, PNG, WebP, PDF — max 20MB each. Select multiple files.</div>
                            </div>
                            <div class="podx-field is-wide">
                                <label for="podx-desc">Description (optional)</label>
                                <input id="podx-desc" class="podx-input" type="text" @bind="uploadDescription"
                                       placeholder="e.g. Signed delivery note from driver" />
                            </div>
                            <div class="podx-field">
                                <label>&nbsp;</label>
                                <button type="button" class="podx-btn podx-btn-primary" style="width:100%"
                                        @onclick="UploadPod"
                                        disabled="@(isUploading || lookupInvoice == null || !selectedFiles.Any())">
                                    @if (isUploading)
                                    {
                                        <span class="podx-spin" aria-hidden="true"></span>
                                        <span>Uploading @uploadProgress…</span>
                                    }
                                    else
                                    {
                                        <span>Upload @(selectedFiles.Count > 1 ? $"{selectedFiles.Count} PODs" : "POD")</span>
                                    }
                                </button>
                            </div>
                        </div>

                        @if (selectedFiles.Count > 0 && !isUploading)
                        {
                            <div>
                                <div class="podx-dt">@selectedFiles.Count file(s) selected</div>
                                <div class="podx-chips">
                                    @foreach (var file in selectedFiles)
                                    {
                                        <span class="podx-chip">
                                            <i class="ph ph-file" aria-hidden="true"></i>@file.Name
                                            <span class="podx-chip-size">@FormatFileSize(file.Size)</span>
                                        </span>
                                    }
                                </div>
                            </div>
                        }

                        @if (!string.IsNullOrEmpty(uploadMessage))
                        {
                            <div class="podx-note @(uploadSuccess ? "is-ok" : "is-bad")" role="status">
                                <i class="ph @(uploadSuccess ? "ph-check-circle" : "ph-warning-octagon")" aria-hidden="true"></i>
                                <div class="podx-note-body">@uploadMessage</div>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <div class="podx-card-body">
                        <div class="podx-note is-accent">
                            <i class="ph ph-info" aria-hidden="true"></i>
                            <div class="podx-note-body">
                                <strong>Naming convention:</strong> name each file starting with the invoice number —
                                <code>10001.pdf</code>, <code>10001_signed.jpg</code>, <code>10002_delivery.png</code>.
                                The leading digits are matched to the SAP invoice number.
                            </div>
                        </div>

                        <div class="podx-fields">
                            <div class="podx-field is-wide">
                                <label for="podx-bulk-files">Select POD files</label>
                                <InputFile id="podx-bulk-files" @key="bulkInputFileKey" OnChange="OnBulkFilesSelected"
                                           class="podx-input" accept=".jpg,.jpeg,.png,.webp,.pdf" multiple />
                                <div class="podx-hint">Each filename must start with the invoice number.</div>
                            </div>
                            <div class="podx-field">
                                <label for="podx-bulk-desc">Description (optional)</label>
                                <input id="podx-bulk-desc" class="podx-input" type="text" @bind="bulkDescription"
                                       placeholder="e.g. Weekly delivery batch" />
                            </div>
                            <div class="podx-field">
                                <label>&nbsp;</label>
                                <button type="button" class="podx-btn podx-btn-primary" style="width:100%"
                                        @onclick="ValidateBulkFiles"
                                        disabled="@(isBulkValidating || !bulkFiles.Any())">
                                    @if (isBulkValidating)
                                    {
                                        <span class="podx-spin" aria-hidden="true"></span>
                                        <span>Validating @bulkValidationProgress</span>
                                    }
                                    else
                                    {
                                        <span>Validate</span>
                                    }
                                </button>
                            </div>
                        </div>

                        @if (bulkFiles.Count > 0 && bulkMappings.Count > 0)
                        {
                            <div class="podx-tablewrap">
                                <table class="podx-table is-inset">
                                    <thead>
                                        <tr>
                                            <th style="width:40px">#</th>
                                            <th>Filename</th>
                                            <th>Invoice #</th>
                                            <th>Customer</th>
                                            <th>Existing PODs</th>
                                            <th class="podx-num">Size</th>
                                            <th>Status</th>
                                            <th></th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var (map, idx) in bulkMappings.Select((m, i) => (m, i)))
                                        {
                                            <tr class="@GetBulkRowClass(map.Status)">
                                                <td>@(idx + 1)</td>
                                                <td><span class="podx-strong">@map.FileName</span></td>
                                                <td>
                                                    @if (map.DocNum.HasValue)
                                                    {
                                                        <span class="podx-badge">@map.DocNum</span>
                                                    }
                                                    else
                                                    {
                                                        <span class="podx-pill is-bad">No number found</span>
                                                    }
                                                </td>
                                                <td>@(map.CardName ?? "—")</td>
                                                <td>
                                                    @if (map.ExistingPodCount > 0)
                                                    {
                                                        <span class="podx-pill is-warn"
                                                              title="This invoice already has @map.ExistingPodCount POD(s) uploaded">
                                                            @map.ExistingPodCount existing
                                                        </span>
                                                    }
                                                    else if (map.Status != BulkFileStatus.Pending && map.Status != BulkFileStatus.Error)
                                                    {
                                                        <span class="podx-weak">None</span>
                                                    }
                                                    else
                                                    {
                                                        <span class="podx-weak">—</span>
                                                    }
                                                </td>
                                                <td class="podx-num">@FormatFileSize(map.FileSize)</td>
                                                <td>
                                                    @switch (map.Status)
                                                    {
                                                        case BulkFileStatus.Pending:
                                                            <span class="podx-pill">Pending</span>
                                                            break;
                                                        case BulkFileStatus.Valid:
                                                            <span class="podx-pill is-ok">Ready</span>
                                                            break;
                                                        case BulkFileStatus.ValidWithWarning:
                                                            <span class="podx-pill is-warn">Ready (has POD)</span>
                                                            break;
                                                        case BulkFileStatus.Skipped:
                                                            <span class="podx-pill" title="@map.ErrorMessage">Skipped</span>
                                                            break;
                                                        case BulkFileStatus.Uploading:
                                                            <span class="podx-pill is-live">
                                                                <span class="podx-spin" aria-hidden="true"></span>Uploading
                                                            </span>
                                                            break;
                                                        case BulkFileStatus.Uploaded:
                                                            <span class="podx-pill is-ok">Uploaded</span>
                                                            break;
                                                        case BulkFileStatus.Error:
                                                            <span class="podx-pill is-bad" title="@map.ErrorMessage">@map.ErrorMessage</span>
                                                            break;
                                                    }
                                                </td>
                                                <td>
                                                    @if (map.Status != BulkFileStatus.Uploading && map.Status != BulkFileStatus.Uploaded
                                                         && !isBulkUploading)
                                                    {
                                                        <button type="button" class="podx-btn podx-btn-ghost podx-btn-icon-sm"
                                                                title="Remove" aria-label="Remove @map.FileName"
                                                                @onclick="() => RemoveBulkMapping(map)">
                                                            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 7h16"></path><path d="M9 7V5h6v2"></path><path d="M6 7l1 13h10l1-13"></path></svg>
                                                        </button>
                                                    }
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>

                            <div class="podx-bulk-foot">
                                <span class="podx-bulk-summary">
                                    @bulkMappings.Count(m => m.Status is BulkFileStatus.Valid or BulkFileStatus.ValidWithWarning)
                                    of @bulkMappings.Count ready to upload
                                    @if (bulkMappings.Any(m => m.Status == BulkFileStatus.Skipped))
                                    {
                                        <span> — <span class="is-skipped">@bulkMappings.Count(m => m.Status == BulkFileStatus.Skipped) skipped</span></span>
                                    }
                                    @if (bulkMappings.Any(m => m.Status == BulkFileStatus.Error))
                                    {
                                        <span> — <span class="is-bad">@bulkMappings.Count(m => m.Status == BulkFileStatus.Error) with errors</span></span>
                                    }
                                </span>
                                <div class="podx-bulk-actions">
                                    @if (bulkMappings.Any(m => m.Status == BulkFileStatus.Error))
                                    {
                                        <button type="button" class="podx-btn podx-btn-secondary" @onclick="RetryBulkValidation"
                                                disabled="@(isBulkValidating || isBulkUploading)">
                                            @if (isBulkValidating)
                                            {
                                                <span class="podx-spin" aria-hidden="true"></span>
                                                <span>Retrying @bulkValidationProgress</span>
                                            }
                                            else
                                            {
                                                <span>Retry @bulkMappings.Count(m => m.Status == BulkFileStatus.Error) errors</span>
                                            }
                                        </button>
                                    }
                                    <button type="button" class="podx-btn podx-btn-secondary" @onclick="ClearBulkUpload"
                                            disabled="@isBulkUploading">Clear</button>
                                    <button type="button" class="podx-btn podx-btn-primary" @onclick="ExecuteBulkUpload"
                                            disabled="@(isBulkUploading || !bulkMappings.Any(m => m.Status is BulkFileStatus.Valid or BulkFileStatus.ValidWithWarning))">
                                        @if (isBulkUploading)
                                        {
                                            <span class="podx-spin" aria-hidden="true"></span>
                                            <span>Uploading @bulkUploadProgress…</span>
                                        }
                                        else
                                        {
                                            <span>Upload @bulkMappings.Count(m => m.Status is BulkFileStatus.Valid or BulkFileStatus.ValidWithWarning) PODs</span>
                                        }
                                    </button>
                                </div>
                            </div>
                        }

                        @if (!string.IsNullOrEmpty(bulkMessage))
                        {
                            <div class="podx-note @(bulkSuccess ? "is-ok" : "is-bad")" role="status">
                                <i class="ph @(bulkSuccess ? "ph-check-circle" : "ph-warning-octagon")" aria-hidden="true"></i>
                                <div class="podx-note-body">@bulkMessage</div>
                            </div>
                        }
                    </div>
                }
            </section>

            @if (lookupInvoice != null)
            {
                <section class="podx-card">
                    <div class="podx-card-head">
                        <h2 class="podx-card-title">
                            <i class="ph ph-receipt" aria-hidden="true"></i>Invoice #@lookupInvoice.DocNum
                        </h2>
                        <span class="podx-status">
                            <span class="podx-dot @(lookupInvoice.DocStatus == "O" ? "is-open" : "is-closed")" aria-hidden="true"></span>
                            @(lookupInvoice.DocStatus == "O" ? "Open" : "Closed")
                        </span>
                    </div>
                    <div class="podx-card-body">
                        <div class="podx-grid">
                            <div>
                                <div class="podx-dt">Customer</div>
                                <div class="podx-dd">@lookupInvoice.CardName</div>
                                <div class="podx-dd-sub">@lookupInvoice.CardCode</div>
                            </div>
                            <div>
                                <div class="podx-dt">Invoice date</div>
                                <div class="podx-dd">@FormatDate(lookupInvoice.DocDate)</div>
                            </div>
                            <div>
                                <div class="podx-dt">Due date</div>
                                <div class="podx-dd">@FormatDate(lookupInvoice.DocDueDate)</div>
                            </div>
                            <div>
                                <div class="podx-dt">Total</div>
                                <div class="podx-dd">@lookupInvoice.DocCurrency @lookupInvoice.DocTotal.ToString("N2")</div>
                            </div>
                            <div>
                                <div class="podx-dt">Paid</div>
                                <div class="podx-dd">@lookupInvoice.DocCurrency @lookupInvoice.PaidToDate.ToString("N2")</div>
                                @{
                                    var balance = lookupInvoice.DocTotal - lookupInvoice.PaidToDate;
                                }
                                @if (balance > 0)
                                {
                                    <span class="podx-dd-flag">Balance: @lookupInvoice.DocCurrency @balance.ToString("N2")</span>
                                }
                            </div>
                            @if (!string.IsNullOrEmpty(lookupInvoice.NumAtCard))
                            {
                                <div>
                                    <div class="podx-dt">Customer ref</div>
                                    <div class="podx-dd">@lookupInvoice.NumAtCard</div>
                                </div>
                            }
                        </div>

                        @if (lookupInvoice.Lines?.Any() == true)
                        {
                            <div>
                                <div class="podx-sect"><i class="ph ph-list-bullets" aria-hidden="true"></i>Invoice lines</div>
                                <div class="podx-tablewrap">
                                    <table class="podx-table is-inset">
                                        <thead>
                                            <tr>
                                                <th>#</th>
                                                <th>Item</th>
                                                <th>Description</th>
                                                <th class="podx-num">Qty</th>
                                                <th class="podx-num">Unit price</th>
                                                <th class="podx-num">Discount</th>
                                                <th class="podx-num">Line total</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var line in lookupInvoice.Lines)
                                            {
                                                <tr>
                                                    <td>@(line.LineNum + 1)</td>
                                                    <td><span class="podx-mono">@line.ItemCode</span></td>
                                                    <td>@line.ItemDescription</td>
                                                    <td class="podx-num">@QuantityDisplay.FormatWithUom(line.Quantity, line.UoMCode)</td>
                                                    <td class="podx-num">@line.UnitPrice.ToString("N2")</td>
                                                    <td class="podx-num">@(line.DiscountPercent > 0 ? $"{line.DiscountPercent:N1}%" : "—")</td>
                                                    <td class="podx-num">@line.LineTotal.ToString("N2")</td>
                                                </tr>
                                            }
                                        </tbody>
                                        <tfoot>
                                            <tr>
                                                <td colspan="6" class="podx-num">VAT</td>
                                                <td class="podx-num">@lookupInvoice.VatSum.ToString("N2")</td>
                                            </tr>
                                            <tr>
                                                <td colspan="6" class="podx-num">Total</td>
                                                <td class="podx-num">@lookupInvoice.DocCurrency @lookupInvoice.DocTotal.ToString("N2")</td>
                                            </tr>
                                        </tfoot>
                                    </table>
                                </div>
                            </div>
                        }
                    </div>
                </section>
            }
        }
        else
        {
            <div class="podx-note is-accent">
                <i class="ph ph-info" aria-hidden="true"></i>
                <div class="podx-note-body">
                    You have read-only access to product POD history. Upload and delete actions are not
                    available for the Operator role.
                </div>
            </div>
        }

        <section class="podx-card">
            <div class="podx-card-head">
                <h2 class="podx-card-title">
                    <i class="ph ph-list-checks" aria-hidden="true"></i>Product POD uploads
                </h2>
                <span class="podx-count">@((podResponse?.TotalCount ?? 0).ToString("N0")) records</span>
            </div>

            <div class="podx-card-body">
                <div class="podx-fields">
                    <div class="podx-field">
                        <label for="podx-f-search">Search</label>
                        <input id="podx-f-search" class="podx-input" type="text" @bind="filterSearch"
                               @bind:event="oninput" @onkeydown="OnFilterKeyDown"
                               placeholder="Invoice #, customer, code, uploader" />
                    </div>
                    <div class="podx-field">
                        <label for="podx-f-card">Customer code</label>
                        <input id="podx-f-card" class="podx-input" type="text" @bind="filterCardCode"
                               @bind:event="oninput" @onkeydown="OnFilterKeyDown" placeholder="e.g. C00001" />
                    </div>
                    <div class="podx-field">
                        <label for="podx-f-by">Uploaded by</label>
                        <input id="podx-f-by" class="podx-input" type="text" @bind="filterUploadedBy"
                               @bind:event="oninput" @onkeydown="OnFilterKeyDown" placeholder="username" />
                    </div>
                    <div class="podx-field">
                        <label for="podx-f-loc">Upload location</label>
                        <NocturneSelect Id="podx-f-loc" Class="nsel-block" Options="LocationFilterOptions"
                                        @bind-Value="filterUploadedFromLocation"
                                        Caption="Filter by upload location" AriaLabel="Filter by upload location"
                                        Placeholder="All locations" />
                    </div>
                    <div class="podx-field">
                        <label for="podx-f-from">From date</label>
                        <NocturneDateField Id="podx-f-from" @bind-Date="filterFromDate" />
                    </div>
                    <div class="podx-field">
                        <label for="podx-f-to">To date</label>
                        <NocturneDateField Id="podx-f-to" @bind-Date="filterToDate" />
                    </div>
                    <div class="podx-field">
                        <label>&nbsp;</label>
                        <div style="display:flex;gap:var(--podx-s2)">
                            <button type="button" class="podx-btn podx-btn-secondary" style="flex:1"
                                    @onclick="ApplyFilter" disabled="@isLoading">Filter</button>
                            @if (HasActiveFilters)
                            {
                                <button type="button" class="podx-btn podx-btn-ghost" @onclick="ClearFilter"
                                        disabled="@isLoading">Clear</button>
                            }
                        </div>
                    </div>
                </div>

                @if (!string.IsNullOrWhiteSpace(podLoadError))
                {
                    <div class="podx-note is-bad" role="alert">
                        <i class="ph ph-warning-octagon" aria-hidden="true"></i>
                        <div class="podx-note-body">@podLoadError</div>
                    </div>
                }
            </div>

            <div class="podx-tablewrap">
                <table class="podx-table">
                    <thead>
                        <tr>
                            <th>Invoice #</th>
                            <th>Customer</th>
                            <th>File</th>
                            <th>Description</th>
                            <th class="podx-num">Size</th>
                            <th>Uploaded</th>
                            <th>By</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (isLoading)
                        {
                            @for (var skeletonRow = 0; skeletonRow < 6; skeletonRow++)
                            {
                                <tr>
                                    @for (var skeletonCell = 0; skeletonCell < 8; skeletonCell++)
                                    {
                                        <td><div class="podx-skel"></div></td>
                                    }
                                </tr>
                            }
                        }
                        else if (podResponse?.Items is not null)
                        {
                            @foreach (var pod in podResponse.Items)
                            {
                                <tr @key="pod.Id">
                                    <td>
                                        <span class="podx-badge">@(pod.InvoiceDocNum > 0 ? pod.InvoiceDocNum.ToString() : "—")</span>
                                    </td>
                                    <td>
                                        <span class="podx-stack">
                                            <span class="podx-strong">@(pod.CardName ?? "—")</span>
                                            <span class="podx-weak">@(pod.CardCode ?? "—")</span>
                                        </span>
                                    </td>
                                    <td>
                                        <span class="podx-stack">
                                            <span class="podx-strong">@pod.FileName</span>
                                            <span class="podx-weak">@pod.MimeType</span>
                                        </span>
                                    </td>
                                    <td>@(pod.Description ?? "—")</td>
                                    <td class="podx-num">@pod.FileSizeFormatted</td>
                                    <td>
                                        <span class="podx-stack">
                                            <span>@pod.UploadedAt.ToString("dd MMM yyyy")</span>
                                            <span class="podx-weak">@pod.UploadedAt.ToString("HH:mm")</span>
                                        </span>
                                    </td>
                                    <td>
                                        <span class="podx-stack">
                                            <span>@(pod.UploadedByUserName ?? "—")</span>
                                            @if (!string.IsNullOrWhiteSpace(pod.UploadedFromLocation))
                                            {
                                                <span class="podx-weak">@AssignedSectionOptions.GetLabel(pod.UploadedFromLocation)</span>
                                            }
                                        </span>
                                    </td>
                                    <td>
                                        <span class="podx-actions">
                                            @if (IsViewable(pod.MimeType))
                                            {
                                                <button type="button" class="podx-btn podx-btn-ghost podx-btn-icon-sm"
                                                        title="View" aria-label="View @pod.FileName"
                                                        @onclick="() => ViewPod(pod)">
                                                    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M2 12s3.6-6 10-6 10 6 10 6-3.6 6-10 6-10-6-10-6z"></path><circle cx="12" cy="12" r="2.6"></circle></svg>
                                                </button>
                                            }
                                            <button type="button" class="podx-btn podx-btn-ghost podx-btn-icon-sm"
                                                    title="Download" aria-label="Download @pod.FileName"
                                                    @onclick="() => DownloadPod(pod)">
                                                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 4v11"></path><path d="M7 11l5 5 5-5"></path><path d="M4 20h16"></path></svg>
                                            </button>
                                            @if (canDeletePods)
                                            {
                                                <button type="button" class="podx-btn podx-btn-ghost podx-btn-icon-sm"
                                                        title="Delete" aria-label="Delete @pod.FileName"
                                                        @onclick="() => ConfirmDeletePod(pod)">
                                                    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 7h16"></path><path d="M9 7V5h6v2"></path><path d="M6 7l1 13h10l1-13"></path></svg>
                                                </button>
                                            }
                                        </span>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>

            @if (!isLoading && (podResponse?.Items?.Count ?? 0) == 0 && string.IsNullOrWhiteSpace(podLoadError))
            {
                <div class="podx-empty">
                    <i class="ph ph-clipboard-text" aria-hidden="true"></i>
                    <span>No POD records found</span>
                    <span class="podx-empty-sub">
                        @(canUploadPods ? "Upload a product POD using the form above." : "Nothing matches the current filters.")
                    </span>
                </div>
            }

            <div class="podx-foot">
                <span class="podx-foot-range">@RangeLabel</span>
                <span class="podx-pagesize">
                    <span>Rows</span>
                    <NocturneSelect Class="nsel-sm nsel-end nsel-up" Options="PodPageSizeSelectOptions"
                                    @bind-Value="podPageSize" OnChanged="OnPodPageSizeChanged"
                                    AriaLabel="Rows per page" />
                </span>
                <div class="podx-pager">
                    <button type="button" class="podx-btn podx-btn-secondary podx-btn-icon" title="Previous page"
                            aria-label="Previous page" disabled="@(podPage <= 1 || isLoading)"
                            @onclick="() => GoToPodPage(podPage - 1)">
                        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M15 6l-6 6 6 6"></path></svg>
                    </button>
                    <span class="podx-page-label">Page @podPage / @PodTotalPages</span>
                    <button type="button" class="podx-btn podx-btn-secondary podx-btn-icon" title="Next page"
                            aria-label="Next page" disabled="@(podPage >= PodTotalPages || isLoading)"
                            @onclick="() => GoToPodPage(podPage + 1)">
                        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 6l6 6-6 6"></path></svg>
                    </button>
                </div>
            </div>
        </section>
    </div>
</div>

@if (showViewer)
{
    <div class="podx-overlay">
        <div class="podx-dialog-wrap" @onclick="CloseViewer">
            <div class="podx-viewer" role="dialog" aria-modal="true" aria-label="POD viewer"
                 @onclick:stopPropagation="true">
                <div class="podx-viewer-head">
                    <h2 class="podx-viewer-name">@viewerFileName</h2>
                    <button type="button" class="podx-btn podx-btn-secondary" @onclick="() => DownloadPod(viewerPod!)">
                        Download
                    </button>
                    <button type="button" class="podx-btn podx-btn-ghost podx-btn-icon" title="Close"
                            aria-label="Close viewer" @onclick="CloseViewer">
                        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"></path></svg>
                    </button>
                </div>
                <div class="podx-viewer-body">
                    @if (isLoadingViewer)
                    {
                        <span class="podx-spin podx-spin-lg" aria-hidden="true"></span>
                    }
                    else if (viewerMimeType?.StartsWith("image/") == true)
                    {
                        <img src="@viewerDataUri" alt="@viewerFileName" class="podx-viewer-image" />
                    }
                    else if (viewerMimeType == "application/pdf")
                    {
                        <iframe src="@viewerDataUri" class="podx-viewer-pdf" title="@viewerFileName"></iframe>
                    }
                </div>
            </div>
        </div>
    </div>
}

@if (showDeleteConfirm)
{
    <div class="podx-overlay">
        <div class="podx-dialog-wrap" @onclick="CancelDelete">
            <div class="podx-dialog" role="dialog" aria-modal="true" aria-labelledby="podx-del-title"
                 @onclick:stopPropagation="true">
                <h2 class="podx-dialog-title is-bad" id="podx-del-title">
                    <i class="ph ph-trash" aria-hidden="true"></i>Delete POD?
                </h2>
                <div class="podx-dialog-body">
                    <div>Are you sure you want to delete this attachment?</div>
                    <div class="podx-strong">@deletePod?.FileName</div>
                    @if (!string.IsNullOrEmpty(deleteMessage))
                    {
                        <div class="podx-note @(deleteSuccess ? "is-ok" : "is-bad")" role="status">
                            <i class="ph @(deleteSuccess ? "ph-check-circle" : "ph-warning-octagon")" aria-hidden="true"></i>
                            <div class="podx-note-body">@deleteMessage</div>
                        </div>
                    }
                </div>
                <div class="podx-dialog-actions">
                    <button type="button" class="podx-btn podx-btn-secondary" @onclick="CancelDelete"
                            disabled="@isDeleting">Cancel</button>
                    <button type="button" class="podx-btn podx-btn-bad" @onclick="DeletePod" disabled="@isDeleting">
                        @if (isDeleting)
                        {
                            <span class="podx-spin" aria-hidden="true"></span>
                        }
                        <span>Delete</span>
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private PodAttachmentListResponse? podResponse;
    private string? podLoadError;
    private bool isLoading = true;
    private const int DefaultPodPageSize = 20;
    private static readonly int[] PodPageSizeOptions = [20, 50, 100];

    private static readonly NocturneSelectOption<int>[] PodPageSizeSelectOptions =
        PodPageSizeOptions.Select(size => new NocturneSelectOption<int>(size, size.ToString())).ToArray();

    // GetLabel is the same helper the table labels a row with.
    private static readonly NocturneSelectOption<string>[] LocationFilterOptions =
        AssignedSectionOptions.All
            .Select(location => new NocturneSelectOption<string>(
                location, AssignedSectionOptions.GetLabel(location), "info"))
            .Prepend(NocturneSelectOption.All("All locations"))
            .ToArray();

    // The list is paged by the server: a page change is a refetch, not a slice
    // of something already in hand.
    private int podPage = 1;
    private int podPageSize = DefaultPodPageSize;

    private int PodTotalPages
    {
        get
        {
            var total = podResponse?.TotalCount ?? 0;
            return Math.Max(1, (int)Math.Ceiling(total / (double)podPageSize));
        }
    }

    private string RangeLabel
    {
        get
        {
            if (isLoading && podResponse is null)
                return "Loading…";

            var total = podResponse?.TotalCount ?? 0;
            var shown = podResponse?.Items?.Count ?? 0;
            if (total == 0 || shown == 0)
                return "No POD records";

            var first = ((podPage - 1) * podPageSize) + 1;
            return $"{first:N0}–{first + shown - 1:N0} of {total:N0} records";
        }
    }

    private static string? GetBulkRowClass(BulkFileStatus status) => status switch
    {
        BulkFileStatus.Error => "is-bad",
        BulkFileStatus.Uploaded => "is-done",
        BulkFileStatus.Skipped => "is-skipped",
        _ => null
    };
    private string? filterCardCode;
    private string? filterSearch;
    private string? filterUploadedBy;
    private string? filterUploadedFromLocation;
    private DateTime? filterFromDate;
    private DateTime? filterToDate;
    private string? activeFilterCardCode;
    private string? activeFilterSearch;
    private string? activeFilterUploadedBy;
    private string? activeFilterUploadedFromLocation;
    private DateTime? activeFilterFromDate;
    private DateTime? activeFilterToDate;

    private bool HasActiveFilters =>
        !string.IsNullOrEmpty(activeFilterCardCode) ||
        !string.IsNullOrEmpty(activeFilterSearch) ||
        !string.IsNullOrEmpty(activeFilterUploadedBy) ||
        !string.IsNullOrEmpty(activeFilterUploadedFromLocation) ||
        activeFilterFromDate.HasValue ||
        activeFilterToDate.HasValue;

    // Upload mode
    private UploadMode uploadMode = UploadMode.Single;

    // Business partners excluded from POD uploads
    private static readonly HashSet<string> ExcludedCardCodes = new(StringComparer.OrdinalIgnoreCase)
    {
        "CIS006", "MAC009", "MAC006", "COR007", "COR006", "COR008",
        "VAN008", "VAN009", "VAN010", "VAN011", "VAN012", "VAN013",
        "VAN014", "VAN015", "VAN016", "VAN017", "VAN018", "VAN019", "VAN020",
        "STA040", "STA041", "STA042", "STA043", "STA044", "STA045", "STA046", "STA047", "STA048",
        "PRO030", "PRO031", "PRO032", "PRO033", "PRO034", "PRO035", "PRO036",
        "CAS004(FCA)", "DON004", "TEA006", "TEA007"
    };

    // Single upload state
    private int? uploadDocNum;
    private int inputFileKey;
    private List<IBrowserFile> selectedFiles = new();
    private string? uploadDescription;
    private bool isUploading;
    private string? uploadProgress;
    private string? uploadMessage;
    private bool uploadSuccess;
    private InvoiceDto? lookupInvoice;
    private string? lookupError;
    private bool isLookingUp;

    // Bulk upload state
    private int bulkInputFileKey;
    private List<IBrowserFile> bulkFiles = new();
    private List<BulkFileMapping> bulkMappings = new();
    private string? bulkDescription;
    private bool isBulkValidating;
    private string? bulkValidationProgress;
    private bool isBulkUploading;
    private string? bulkUploadProgress;
    private string? bulkMessage;
    private bool bulkSuccess;
    private int bulkAutoRetryRound;
    private int bulkMaxAutoRetries = 3;
    private CancellationTokenSource? bulkValidationCts;

    private enum UploadMode { Single, Bulk }

    private enum BulkFileStatus { Pending, Valid, ValidWithWarning, Uploading, Uploaded, Skipped, Error }

    private class BulkFileMapping
    {
        public IBrowserFile File { get; set; } = default!;
        public string FileName { get; set; } = string.Empty;
        public int? DocNum { get; set; }
        public int? DocEntry { get; set; }
        public string? CardName { get; set; }
        public long FileSize { get; set; }
        public BulkFileStatus Status { get; set; } = BulkFileStatus.Pending;
        public string? ErrorMessage { get; set; }
        public int ExistingPodCount { get; set; }
    }

    // Viewer state
    private bool showViewer;
    private bool isLoadingViewer;
    private string? viewerDataUri;
    private string? viewerFileName;
    private string? viewerMimeType;
    private PodAttachmentItemDto? viewerPod;

    // Delete state
    private bool showDeleteConfirm;
    private bool isDeleting;
    private string? deleteMessage;
    private bool deleteSuccess;
    private PodAttachmentItemDto? deletePod;
    private string? currentUsername;
    private bool canUploadPods = true;
    private bool canDeletePods = true;
    private int? appliedInitialDocNum;
    private bool appliedInitialViewLatest;
    private bool isInteractive;

    [SupplyParameterFromQuery(Name = "docNum")]
    public int? InitialDocNum { get; set; }

    [SupplyParameterFromQuery(Name = "viewLatest")]
    public bool InitialViewLatest { get; set; }

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;
        currentUsername = user.Identity?.Name;
    }

    protected override async Task OnParametersSetAsync()
    {
        if (!isInteractive)
            return;

        await ApplyInitialNavigationAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        await base.OnAfterRenderAsync(firstRender);

        if (!firstRender)
            return;

        isInteractive = true;

        if (InitialDocNum.HasValue && InitialDocNum.Value > 0)
        {
            await ApplyInitialNavigationAsync();
            return;
        }

        await ReloadPodsTableAsync(resetToFirstPage: true);
    }

    private async Task ApplyInitialNavigationAsync()
    {
        if (!InitialDocNum.HasValue || InitialDocNum.Value <= 0)
            return;

        if (appliedInitialDocNum == InitialDocNum.Value && appliedInitialViewLatest == InitialViewLatest)
            return;

        appliedInitialDocNum = InitialDocNum.Value;
        appliedInitialViewLatest = InitialViewLatest;

        uploadDocNum = InitialDocNum.Value;
        filterSearch = InitialDocNum.Value.ToString(CultureInfo.InvariantCulture);
        activeFilterSearch = filterSearch;

        await LookupInvoice();
        await ReloadPodsTableAsync(resetToFirstPage: true);

        if (InitialViewLatest)
        {
            await OpenLatestPodForLookupInvoiceAsync();
        }
    }

    private async Task OpenLatestPodForLookupInvoiceAsync()
    {
        if (lookupInvoice == null)
            return;

        try
        {
            var response = await PodService.GetInvoicePodsAsync(lookupInvoice.DocEntry);
            var latestAttachment = response?.Attachments?
                .OrderByDescending(attachment => attachment.UploadedAt)
                .FirstOrDefault();

            if (latestAttachment == null)
            {
                uploadSuccess = false;
                uploadMessage = $"No POD upload was found for invoice #{lookupInvoice.DocNum}.";
                return;
            }

            await ViewPod(new PodAttachmentItemDto
            {
                Id = latestAttachment.Id,
                FileName = latestAttachment.FileName,
                MimeType = latestAttachment.MimeType,
                FileSizeBytes = latestAttachment.FileSizeBytes,
                FileSizeFormatted = latestAttachment.FileSizeFormatted,
                Description = latestAttachment.Description,
                UploadedAt = latestAttachment.UploadedAt,
                UploadedByUserName = latestAttachment.UploadedByUserName,
                DownloadUrl = latestAttachment.DownloadUrl,
                InvoiceDocEntry = lookupInvoice.DocEntry,
                InvoiceDocNum = lookupInvoice.DocNum,
                CardCode = lookupInvoice.CardCode,
                CardName = lookupInvoice.CardName
            });
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error opening latest POD for invoice {DocNum}", lookupInvoice.DocNum);
            uploadSuccess = false;
            uploadMessage = "Failed to open the uploaded POD.";
        }
    }

    /// <summary>
    /// Fetches the current page of POD records. On failure the previously loaded page is left on
    /// screen under the error rather than being blanked — the records are still what was true.
    /// </summary>
    private async Task LoadPodsAsync()
    {
        isLoading = true;
        podLoadError = null;

        try
        {
            var response = await PodService.GetAllPodsAsync(podPage, podPageSize, activeFilterCardCode,
activeFilterFromDate, activeFilterToDate, activeFilterSearch, activeFilterUploadedBy, activeFilterUploadedFromLocation,
CancellationToken.None);
            if (response != null)
            {
                podResponse = response;
            }
            else
            {
                podLoadError = "Failed to load POD records. Please refresh and try again.";
            }
        }
        catch (OperationCanceledException)
        {
            throw;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error loading PODs");
            podLoadError = "Failed to load POD records. Please refresh and try again.";
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task GoToPodPage(int page)
    {
        if (page >= 1 && page <= PodTotalPages && page != podPage)
        {
            podPage = page;
            await LoadPodsAsync();
        }
    }

    private async Task OnPodPageSizeChanged()
    {
        podPage = 1;
        await LoadPodsAsync();
    }

    private async Task RefreshData()
    {
        await ReloadPodsTableAsync(resetToFirstPage: true);
    }

    private async Task ApplyFilter()
    {
        activeFilterCardCode = string.IsNullOrWhiteSpace(filterCardCode) ? null : filterCardCode.Trim();
        activeFilterSearch = string.IsNullOrWhiteSpace(filterSearch) ? null : filterSearch.Trim();
        activeFilterUploadedBy = string.IsNullOrWhiteSpace(filterUploadedBy) ? null : filterUploadedBy.Trim();
        activeFilterUploadedFromLocation = string.IsNullOrWhiteSpace(filterUploadedFromLocation) ? null :
filterUploadedFromLocation.Trim();
        activeFilterFromDate = filterFromDate;
        activeFilterToDate = filterToDate;
        await ReloadPodsTableAsync(resetToFirstPage: true);
    }

    private async Task ClearFilter()
    {
        filterCardCode = null;
        filterSearch = null;
        filterUploadedBy = null;
        filterUploadedFromLocation = null;
        filterFromDate = null;
        filterToDate = null;
        activeFilterCardCode = null;
        activeFilterSearch = null;
        activeFilterUploadedBy = null;
        activeFilterUploadedFromLocation = null;
        activeFilterFromDate = null;
        activeFilterToDate = null;
        await ReloadPodsTableAsync(resetToFirstPage: true);
    }

    private async Task OnFilterKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
            await ApplyFilter();
    }

    private async Task ReloadPodsTableAsync(bool resetToFirstPage = false)
    {
        podLoadError = null;

        if (resetToFirstPage)
        {
            podPage = 1;
        }

        await LoadPodsAsync();
        await InvokeAsync(StateHasChanged);
    }

    private async Task LookupInvoice()
    {
        if (uploadDocNum is null or <= 0 || isLookingUp) return;

        isLookingUp = true;
        lookupInvoice = null;
        lookupError = null;

        try
        {
            lookupInvoice = await InvoiceService.GetInvoiceByDocNumAsync(uploadDocNum.Value);
            if (lookupInvoice == null)
            {
                lookupError = "Invoice not found";
            }
            else if (ExcludedCardCodes.Contains(lookupInvoice.CardCode ?? ""))
            {
                lookupError = $"POD uploads are not required for {lookupInvoice.CardName} ({lookupInvoice.CardCode})";
                lookupInvoice = null;
            }
        }
        catch (HttpRequestException ex)
        {
            Logger.LogWarning(ex, "Invoice lookup failed for DocNum {DocNum}", uploadDocNum);
            lookupError = ex.StatusCode switch
            {
                System.Net.HttpStatusCode.Unauthorized or System.Net.HttpStatusCode.Forbidden
                    => "Invoice lookup authentication failed. Please contact an administrator.",
                System.Net.HttpStatusCode.ServiceUnavailable or System.Net.HttpStatusCode.BadGateway or System.Net.HttpStatusCode.GatewayTimeout
                    => "SAP invoice lookup is temporarily unavailable. Please try again.",
                _ => "Could not look up invoice"
            };
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Unexpected invoice lookup failure for DocNum {DocNum}", uploadDocNum);
            lookupError = "Could not look up invoice";
        }
        finally
        {
            isLookingUp = false;
        }
    }

    private void OnFilesSelected(InputFileChangeEventArgs e)
    {
        if (!canUploadPods) return;

        selectedFiles = e.GetMultipleFiles(20).ToList();
        uploadMessage = null;
    }

    private async Task UploadPod()
    {
        if (!canUploadPods || lookupInvoice == null || !selectedFiles.Any() || isUploading) return;

        isUploading = true;
        uploadMessage = null;

        try
        {
            var total = selectedFiles.Count;
            var successCount = 0;
            var failedFiles = new List<string>();

            for (var i = 0; i < total; i++)
            {
                var file = selectedFiles[i];
                uploadProgress = $"({i + 1}/{total})";
                StateHasChanged();

                if (file.Size > 20 * 1024 * 1024)
                {
                    failedFiles.Add($"{file.Name} (too large)");
                    continue;
                }

                using var stream = file.OpenReadStream(maxAllowedSize: 20 * 1024 * 1024);
                var (success, message, _) = await PodService.UploadPodAsync(
                    lookupInvoice.DocEntry, stream, file.Name, file.ContentType, uploadDescription, currentUsername);

                if (success)
                    successCount++;
                else
                    failedFiles.Add(file.Name);
            }

            if (failedFiles.Count == 0)
            {
                uploadSuccess = true;
                uploadMessage = total == 1
                    ? "POD uploaded successfully."
                    : $"All {successCount} PODs uploaded successfully.";
                // Audit log: POD uploaded
                await AuditService.LogAsync(AuditActions.UploadPod, "POD", lookupInvoice?.DocNum.ToString(), $"{successCount} file(s) for invoice #{lookupInvoice?.DocNum}", true);
                selectedFiles.Clear();
                inputFileKey++;
                uploadDocNum = null;
                uploadDescription = null;
                lookupInvoice = null;
                lookupError = null;
                await ReloadPodsTableAsync(resetToFirstPage: true);
            }
            else
            {
                uploadSuccess = successCount > 0;
                uploadMessage = successCount > 0
                    ? $"{successCount} of {total} uploaded. Failed: {string.Join(", ", failedFiles)}"
                    : $"Upload failed for: {string.Join(", ", failedFiles)}";
                if (successCount > 0)
                    await ReloadPodsTableAsync(resetToFirstPage: true);
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error uploading POD");
            uploadMessage = "An unexpected error occurred. Please try again.";
            uploadSuccess = false;
        }
        finally
        {
            isUploading = false;
        }
    }

    private async Task DownloadPod(PodAttachmentItemDto pod)
    {
        try
        {
            var url = $"/download/pod/{pod.InvoiceDocEntry}/{pod.Id}";
            await JS.InvokeVoidAsync("downloadAuthenticatedFile", url, pod.FileName);
            await LogPodAuditAsync(
                AuditActions.DownloadPod,
                pod,
                true,
                $"Downloaded POD '{pod.FileName}' for {GetPodInvoiceLabel(pod)}.");
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error downloading POD {PodId}", pod.Id);
            await LogPodAuditAsync(
                AuditActions.DownloadPod,
                pod,
                false,
                $"Failed to download POD '{pod.FileName}' for {GetPodInvoiceLabel(pod)}.",
                ex.Message);
        }
    }

    private static bool IsViewable(string? mimeType) =>
        mimeType != null && (mimeType.StartsWith("image/") || mimeType == "application/pdf");

    private async Task ViewPod(PodAttachmentItemDto pod)
    {
        try
        {
            await RevokeViewerDataUriAsync();

            viewerPod = pod;
            viewerFileName = pod.FileName;
            viewerMimeType = pod.MimeType;
            viewerDataUri = null;
            showViewer = true;
            isLoadingViewer = true;
            StateHasChanged();

            viewerDataUri = await JS.InvokeAsync<string>(
                "createAuthenticatedObjectUrl",
                $"/download/pod/{pod.InvoiceDocEntry}/{pod.Id}");

            await LogPodAuditAsync(
                AuditActions.ViewPod,
                pod,
                true,
                $"Viewed POD '{pod.FileName}' for {GetPodInvoiceLabel(pod)}.");
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error viewing POD {PodId}", pod.Id);
            await LogPodAuditAsync(
                AuditActions.ViewPod,
                pod,
                false,
                $"Failed to view POD '{pod.FileName}' for {GetPodInvoiceLabel(pod)}.",
                ex.Message);
            showViewer = false;
        }
        finally
        {
            isLoadingViewer = false;
            StateHasChanged();
        }
    }

    private async Task CloseViewer()
    {
        showViewer = false;
        await RevokeViewerDataUriAsync();
        viewerPod = null;
    }

    private async Task RevokeViewerDataUriAsync()
    {
        if (!string.IsNullOrWhiteSpace(viewerDataUri))
        {
            await JS.InvokeVoidAsync("revokeObjectUrl", viewerDataUri);
            viewerDataUri = null;
        }
    }

    private async Task LogPodAuditAsync(
        string action,
        PodAttachmentItemDto pod,
        bool isSuccess,
        string details,
        string? errorMessage = null)
    {
        try
        {
            await AuditService.LogAsync(
                action,
                "POD",
                pod.Id.ToString(CultureInfo.InvariantCulture),
                details,
                isSuccess,
                errorMessage);
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Failed to write POD audit log for action {Action} and attachment {PodId}", action, pod.Id);
        }
    }

    private static string GetPodInvoiceLabel(PodAttachmentItemDto pod)
    {
        return pod.InvoiceDocNum > 0
            ? $"invoice #{pod.InvoiceDocNum}"
            : $"invoice doc entry {pod.InvoiceDocEntry}";
    }

    private void ConfirmDeletePod(PodAttachmentItemDto pod)
    {
        if (!canDeletePods) return;

        deletePod = pod;
        deleteMessage = null;
        showDeleteConfirm = true;
    }

    private void CancelDelete()
    {
        showDeleteConfirm = false;
        deletePod = null;
        deleteMessage = null;
    }

    private async Task DeletePod()
    {
        if (!canDeletePods || deletePod == null || isDeleting) return;

        isDeleting = true;
        deleteMessage = null;

        try
        {
            var success = await PodService.DeletePodAsync(deletePod.Id);
            if (success)
            {
                showDeleteConfirm = false;
                deletePod = null;
                await ReloadPodsTableAsync();
            }
            else
            {
                deleteSuccess = false;
                deleteMessage = "Failed to delete the attachment. Please try again.";
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error deleting POD {PodId}", deletePod?.Id);
            deleteSuccess = false;
            deleteMessage = "An unexpected error occurred.";
        }
        finally
        {
            isDeleting = false;
        }
    }

    private static string FormatDate(string? dateStr)
    {
        if (string.IsNullOrWhiteSpace(dateStr)) return "-";
        return DateTime.TryParse(dateStr, out var dt) ? dt.ToString("dd MMM yyyy") : dateStr;
    }

    private static string FormatFileSize(long bytes) => bytes switch
    {
        < 1024 => $"{bytes} B",
        < 1024 * 1024 => $"{bytes / 1024.0:N1} KB",
        _ => $"{bytes / (1024.0 * 1024.0):N1} MB"
    };

