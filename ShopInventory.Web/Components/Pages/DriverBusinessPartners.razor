@page "/driver-business-partners"
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize(Roles = "Admin")]
@rendermode InteractiveServer

<PageTitle>Driver Shop Access - Shop Inventory</PageTitle>

@* The imported Nocturne design is dark; wwwroot/css/driver-shop-access.css
   (linked from App.razor) carries it and its light counterpart, and follows
   the app's theme toggle like every other page.

   Icons are drawn inline rather than from the Phosphor font: the search glyph
   sits inside a field and the chip's × is its whole label, so a font that
   failed to load would leave both reading as nothing.

   The design draws a catalogue row as a button. It is a native checkbox in a
   label here — identical to look at, but it keeps the roving focus, the space
   key and the "checked" a screen reader announces, none of which a button
   gives for free. *@

<div class="dsa">

    <header class="dsa-head">
        <div class="dsa-head-inner">
            <nav class="dsa-crumbs" aria-label="Breadcrumb">
                <span>Field operations</span>
                <span class="dsa-crumb-sep" aria-hidden="true">/</span>
                <span class="dsa-crumb-now" aria-current="page">Driver shop access</span>
            </nav>
            <div class="dsa-head-actions">
                <button type="button" class="dsa-btn dsa-btn-ghost"
                        disabled="@(isLoading || isSaving || isRefreshing)" @onclick="RefreshCustomersAsync">
                    @if (isRefreshing)
                    {
                        <span class="dsa-spin" aria-hidden="true"></span>
                        <span>Refreshing&#8230;</span>
                    }
                    else
                    {
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                             stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <path d="M20 11a8 8 0 0 0-13.7-5.3L4 8"></path>
                            <path d="M4 4v4h4"></path>
                            <path d="M4 13a8 8 0 0 0 13.7 5.3L20 16"></path>
                            <path d="M20 20v-4h-4"></path>
                        </svg>
                        <span>Refresh from SAP</span>
                    }
                </button>
                <button type="button" class="dsa-btn dsa-btn-primary"
                        disabled="@(isLoading || isSaving || isRefreshing)" @onclick="SaveAsync">
                    @if (isSaving)
                    {
                        <span class="dsa-spin" aria-hidden="true"></span>
                        <span>Saving&#8230;</span>
                    }
                    else
                    {
                        <span>Save access</span>
                    }
                </button>
            </div>
        </div>
    </header>

    <div class="dsa-body">

        <section class="dsa-hero">
            <div>
                <div class="dsa-kicker">Blanket scope</div>
                <h1>Driver shop access</h1>
                <p>
                    One business-partner allowlist for every driver account — not a per-driver assignment.
                    The list loads from the local cache; refresh when new partners are created in SAP.
                </p>
            </div>
            <div class="dsa-stat">
                <div class="dsa-stat-line">
                    <span class="dsa-stat-num">@selectedCustomerCodes.Count</span>
                    <span class="dsa-stat-of">of @customers.Count partners in scope</span>
                </div>
                <div class="dsa-bar" role="progressbar" aria-label="Partners in scope"
                     aria-valuenow="@CoveragePercent" aria-valuemin="0" aria-valuemax="100">
                    <div class="dsa-bar-fill" style="width:@(CoveragePercent)%"></div>
                </div>
                <div class="dsa-stat-foot">@CoveragePercent% coverage · drivers inherit at next login</div>
            </div>
        </section>

        @if (isLoading)
        {
            <div class="dsa-loading">
                <span class="dsa-spin" aria-hidden="true"></span>
                <span>Loading driver shop access&#8230;</span>
            </div>
        }
        else
        {
            var filtered = FilteredCustomers;
            var allShownSelected = filtered.Count > 0 &&
                filtered.All(c => selectedCustomerCodes.Contains(c.CardCode ?? string.Empty));
            var shownSelected = FilteredSelectedCodes;

            <section class="dsa-grid">

                <!-- ── The catalogue ──────────────────────────────────────── -->
                <div class="dsa-panel dsa-panel-catalogue">
                    <div class="dsa-panel-head">
                        <div class="dsa-panel-title">
                            <h2>Business partners</h2>
                            <span class="dsa-count">@filtered.Count @(filtered.Count == 1 ? "result" : "results")</span>
                            <button type="button" class="dsa-pill" disabled="@(filtered.Count == 0)"
                                    @onclick="() => ToggleAllFiltered(!allShownSelected)">
                                @(allShownSelected ? "Remove all shown" : "Add all shown")
                            </button>
                        </div>

                        <label class="dsa-search">
                            <span class="visually-hidden">Search business partners</span>
                            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                 stroke-width="1.7" stroke-linecap="round" aria-hidden="true">
                                <circle cx="11" cy="11" r="7"></circle>
                                <path d="M20 20l-3.5-3.5"></path>
                            </svg>
                            <input class="dsa-input dsa-input-search" type="search" autocomplete="off"
                                   placeholder="Search by code or name…"
                                   @bind="customerSearchTerm" @bind:event="oninput" />
                        </label>

                        <div class="dsa-filters">
                            <div class="dsa-select">
                                <label class="visually-hidden" for="dsa-status">Status</label>
                                <select id="dsa-status" class="dsa-input" @bind="customerStatusFilter">
                                    <option value="@StatusFilterAll">All</option>
                                    <option value="@StatusFilterActive">Active</option>
                                    <option value="@StatusFilterInactive">Inactive</option>
                                </select>
                                <span class="dsa-caret" aria-hidden="true"></span>
                            </div>
                            <div class="dsa-select">
                                <label class="visually-hidden" for="dsa-channel">Channel</label>
                                <select id="dsa-channel" class="dsa-input" @bind="customerChannelFilter">
                                    <option value="@ChannelFilterAll">All channels</option>
                                    @if (HasCustomersWithoutChannel)
                                    {
                                        <option value="@ChannelFilterNone">No channel</option>
                                    }
                                    @foreach (var channel in AvailableChannels)
                                    {
                                        <option value="@channel">@channel</option>
                                    }
                                </select>
                                <span class="dsa-caret" aria-hidden="true"></span>
                            </div>
                        </div>
                    </div>

                    @if (filtered.Count > 0)
                    {
                        <div class="dsa-list">
                            @foreach (var customer in filtered)
                            {
                                var cardCode = customer.CardCode ?? string.Empty;
                                var isSelected = selectedCustomerCodes.Contains(cardCode);
                                <label class="dsa-row @(isSelected ? "dsa-row-on" : "")">
                                    <input type="checkbox" class="dsa-row-check" checked="@isSelected"
                                           @onchange="args => ToggleCustomer(cardCode, args.Value as bool? == true)" />
                                    <span class="dsa-box @(isSelected ? "dsa-box-on" : "")" aria-hidden="true">
                                        <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                             stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
                                            <path d="M5 12.5l4.5 4.5L19 7"></path>
                                        </svg>
                                    </span>
                                    <span class="dsa-code">@cardCode</span>
                                    <span class="dsa-name">@GetBusinessPartnerDisplayName(customer)</span>
                                    <span class="dsa-row-meta">
                                        <span class="dsa-channel">@customer.Channel?.Trim()</span>
                                        <span class="dsa-ccy">@customer.Currency?.Trim()</span>
                                        <span class="dsa-dot @(customer.IsActive ? "dsa-dot-on" : "")"
                                              title="@(customer.IsActive ? "Active" : "Inactive")"></span>
                                    </span>
                                </label>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="dsa-empty">
                            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                 stroke-width="1.5" stroke-linecap="round" aria-hidden="true">
                                <circle cx="11" cy="11" r="7"></circle>
                                <path d="M20 20l-3.5-3.5"></path>
                            </svg>
                            <span>No business partners match the current filters.</span>
                        </div>
                    }
                </div>

                <!-- ── What the drivers will see ──────────────────────────── -->
                <div class="dsa-panel dsa-panel-scope">
                    <div class="dsa-panel-head">
                        <div class="dsa-panel-title">
                            <h2>In scope</h2>
                            <span class="dsa-tally">@selectedCustomerCodes.Count</span>
                            @if (selectedCustomerCodes.Count > 0)
                            {
                                <button type="button" class="dsa-link" @onclick="ClearAll">Clear all</button>
                            }
                        </div>

                        <label class="dsa-search">
                            <span class="visually-hidden">Filter partners in scope</span>
                            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                 stroke-width="1.7" stroke-linecap="round" aria-hidden="true">
                                <circle cx="11" cy="11" r="7"></circle>
                                <path d="M20 20l-3.5-3.5"></path>
                            </svg>
                            <input class="dsa-input dsa-input-search" type="search" autocomplete="off"
                                   placeholder="Filter selected…"
                                   @bind="selectedSearchTerm" @bind:event="oninput" />
                        </label>
                    </div>

                    <div class="dsa-chips">
                        @if (selectedCustomerCodes.Count == 0)
                        {
                            <p class="dsa-note">
                                No partners in scope — drivers will see nothing until you add at least one.
                            </p>
                        }
                        else if (shownSelected.Count == 0)
                        {
                            <p class="dsa-note">Nothing in scope matches &ldquo;@selectedSearchTerm&rdquo;.</p>
                        }
                        else
                        {
                            @foreach (var code in shownSelected)
                            {
                                <span class="dsa-chip">
                                    <span class="dsa-chip-code">@(code)</span>
                                    <span class="dsa-chip-name">@GetCustomerDisplayName(code)</span>
                                    <button type="button" class="dsa-chip-x" title="Remove @(code)"
                                            aria-label="Remove @(code)" @onclick="() => ToggleCustomer(code, false)">
                                        <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                             stroke-width="2.2" stroke-linecap="round" aria-hidden="true">
                                            <path d="M6 6l12 12M18 6L6 18"></path>
                                        </svg>
                                    </button>
                                </span>
                            }
                        }
                    </div>

                    <div class="dsa-panel-foot">
                        <span class="dsa-count">@shownSelected.Count shown</span>
                        <button type="button" class="dsa-btn dsa-btn-primary dsa-btn-lg"
                                disabled="@(isSaving || isRefreshing)" @onclick="SaveAsync">
                            @if (isSaving)
                            {
                                <span class="dsa-spin" aria-hidden="true"></span>
                                <span>Saving&#8230;</span>
                            }
                            else
                            {
                                <span>Save driver shop access</span>
                            }
                        </button>
                    </div>
                </div>

            </section>
        }
    </div>
</div>
