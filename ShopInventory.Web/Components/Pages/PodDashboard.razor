@page "/pod-dashboard"
@using Microsoft.AspNetCore.Authorization
@using ShopInventory.Web.Common
@using ShopInventory.Web.Data
@using ShopInventory.Web.Models
@attribute [Authorize(Roles = UserRoles.PodRoles)]
@rendermode InteractiveServer

<PageTitle>@(isOperator ? "Section POD Dashboard" : "POD Dashboard") - Kefalos Cheese</PageTitle>

@* The POD operator's workspace, on the Nocturne system the sales-rep dashboard
   uses — wwwroot/css/pod-dashboard.css carries the light and dark palettes and
   follows the app's theme toggle like every other page.

   Two figures come from different places and are counted on different clocks,
   which is why they are labelled the way they are: the upload counts and the
   activity chart are the API's, whose days are UTC, while the compliance window
   is the invoice report read over local dates. They are never added together.

   Everything on this page is read once per window. The header states when, so
   an operator watching uploads land knows how old the figures are. *@

<div class="pdo">

    <header>
        <div class="pdo-shell">
            <div class="pdo-titles">
                <div class="pdo-kicker">@Kicker</div>
                <h1 class="pdo-title">@Greeting, @Greeted</h1>
                <p class="pdo-sub">@Standfirst</p>
            </div>
            <div class="pdo-head-actions">
                <div class="pdo-seg" role="group" aria-label="Reporting window">
                    @foreach (var option in RangeOptions)
                    {
                        <button type="button"
                                class="pdo-seg-opt @(option == rangeDays ? "is-on" : null)"
                                aria-pressed="@(option == rangeDays)"
                                disabled="@isLoading"
                                @onclick="() => SelectRange(option)">
                            @($"{option}d")
                        </button>
                    }
                </div>
                <button type="button" class="pdo-btn pdo-btn-quiet" disabled="@isLoading" @onclick="LoadAsync">
                    <i class="ph ph-arrows-clockwise @(isLoading ? "is-spinning" : null)" aria-hidden="true"></i>
                    @if (readAt is { } stamp && !isLoading)
                    {
                        @($"Read {stamp:HH:mm}")
                    }
                    else
                    {
                        @("Reading…")
                    }
                </button>
                <a class="pdo-btn pdo-btn-primary" href="/pods">
                    <i class="ph ph-upload-simple" aria-hidden="true"></i>Upload a POD
                </a>
            </div>
        </div>
        <div class="pdo-rule"></div>
    </header>

    <div class="pdo-body">

        @if (uploadsFailed || complianceFailed)
        {
            <div class="pdo-alert" role="alert">
                <i class="ph ph-warning-octagon" aria-hidden="true"></i>
                <div>
                    @if (uploadsFailed && complianceFailed)
                    {
                        <text>Neither the upload figures nor the compliance window could be read. Nothing on this page is current.</text>
                    }
                    else if (uploadsFailed)
                    {
                        <text>The upload figures and the activity chart could not be read. The compliance panels are current.</text>
                    }
                    else
                    {
                        <text>The compliance window could not be read, so coverage and the outstanding list are unavailable. The upload figures are current.</text>
                    }
                </div>
            </div>
        }

        @* Figures read "—" until their numbers are in, rather than showing a
           zero that is about to jump. *@
        <section class="pdo-kpis" aria-label="Key figures">
            <div class="pdo-kpi">
                <div class="pdo-kpi-top">
                    <span class="pdo-kpi-label">@TodayLabel</span>
                    <i class="ph ph-cloud-arrow-up" aria-hidden="true"></i>
                </div>
                <div class="pdo-kpi-fig">
                    <span class="pdo-kpi-value">@Figure(uploads?.UploadsToday)</span>
                    <span class="pdo-kpi-unit">files</span>
                </div>
                <div class="pdo-kpi-foot">
                    @if (uploads is { } today)
                    {
                        <span>@today.UploadsThisWeek.ToString("N0") this week</span>
                    }
                </div>
            </div>

            <div class="pdo-kpi">
                <div class="pdo-kpi-top">
                    <span class="pdo-kpi-label">@($"Coverage {rangeDays}d")</span>
                    <i class="ph ph-seal-check" aria-hidden="true"></i>
                </div>
                <div class="pdo-kpi-fig">
                    <span class="pdo-kpi-value">@(coverage is { Total: > 0 } done ? $"{done.Percent:0}%" : "—")</span>
                </div>
                <div class="pdo-kpi-foot">
                    <span>@CoverageNote</span>
                </div>
            </div>

            <div class="pdo-kpi @(coverage is { Outstanding: > 0 } ? "is-risk" : null)">
                <div class="pdo-kpi-top">
                    <span class="pdo-kpi-label">Missing proof</span>
                    <i class="ph ph-clipboard-text" aria-hidden="true"></i>
                </div>
                <div class="pdo-kpi-fig">
                    <span class="pdo-kpi-value">@Figure(coverage?.Outstanding)</span>
                    <span class="pdo-kpi-unit">deliveries</span>
                </div>
                <div class="pdo-kpi-foot">
                    <span>@OutstandingNote</span>
                </div>
            </div>

            <div class="pdo-kpi">
                <div class="pdo-kpi-top">
                    <span class="pdo-kpi-label">@(isOperator ? "Uploading" : "Invoices covered")</span>
                    <i class="ph @(isOperator ? "ph-users-three" : "ph-receipt")" aria-hidden="true"></i>
                </div>
                <div class="pdo-kpi-fig">
                    <span class="pdo-kpi-value">@(isOperator ? Figure(UploaderFigure) : Figure(uploads?.UniqueInvoicesCovered))</span>
                    <span class="pdo-kpi-unit">@(isOperator ? "people" : "all time")</span>
                </div>
                <div class="pdo-kpi-foot">
                    <span>@(isOperator ? UploaderNote : CoveredNote)</span>
                </div>
            </div>
        </section>

        <div class="pdo-split">

            <div class="pdo-col">

                <section class="pdo-card" aria-label="Upload activity">
                    <div class="pdo-chart-head">
                        <div>
                            <span class="pdo-card-title">Upload activity</span>
                            <span class="pdo-card-sub">
                                Files a day, last @rangeDays days · @(isOperator ? "the whole section" : "your uploads")
                            </span>
                        </div>
                        <div class="pdo-chart-total">
                            <span class="pdo-chart-total-value">@Figure(uploads?.UploadsThisMonth)</span>
                            <span class="pdo-card-note">this month</span>
                        </div>
                    </div>

                    @if (bars.Count == 0)
                    {
                        <div class="pdo-empty">@(isLoading ? "Loading activity…" : "No upload activity to chart.")</div>
                    }
                    else
                    {
                        <div class="pdo-plot">
                            <div class="pdo-gridline is-top"></div>
                            <div class="pdo-gridline is-mid"></div>
                            <div class="pdo-gridline is-low"></div>
                            <div class="pdo-baseline"></div>
                            @if (axisMax > 0)
                            {
                                <span class="pdo-ytick is-top">@axisMax</span>
                                <span class="pdo-ytick is-mid">@(axisMax * 2 / 3)</span>
                                <span class="pdo-ytick is-low">@(axisMax / 3)</span>
                            }
                            @foreach (var bar in bars)
                            {
                                <div class="pdo-bar @bar.BandClass" style="height:@bar.Height" title="@bar.Label"></div>
                            }
                        </div>

                        <div class="pdo-xaxis">
                            <span>@chartStart</span>
                            <span>@chartMid</span>
                            <span>Today</span>
                        </div>
                    }
                </section>

                @* The operator's actual queue. Oldest first, because the age of
                   a delivery without proof is the whole problem — each row
                   opens the POD page on that invoice, ready to upload. *@
                <section class="pdo-card" aria-label="Deliveries missing proof">
                    <div class="pdo-card-head">
                        <span class="pdo-card-title">Missing proof</span>
                        <a class="pdo-link pdo-card-note" href="/pod-report">
                            @(coverage is { Outstanding: > OutstandingShown } more
                                ? $"View all {more.Outstanding:N0}"
                                : "Open the report")
                        </a>
                    </div>

                    @* The column strip only appears once there are rows under
                       it — an empty list here is good news, not a table with
                       nothing in it. *@
                    @if (outstanding.Count > 0)
                    {
                        <div class="pdo-rows-head" aria-hidden="true">
                            <span>Invoice</span>
                            <span>Customer</span>
                            <span class="pdo-row-value">Value</span>
                            <span>Raised</span>
                            <span class="pdo-row-age">Waiting</span>
                        </div>
                    }

                    @if (outstanding.Count == 0)
                    {
                        <div class="pdo-empty">
                            @if (isLoading)
                            {
                                <text>Loading the outstanding list…</text>
                            }
                            else if (complianceFailed)
                            {
                                <text>The compliance window could not be read.</text>
                            }
                            else if (coverage is { Total: 0 })
                            {
                                <text>No invoices were raised in the last @rangeDays days.</text>
                            }
                            else
                            {
                                <text>Every delivery in the last @rangeDays days has its proof.</text>
                            }
                        </div>
                    }
                    else
                    {
                        @foreach (var item in outstanding)
                        {
                            <a class="pdo-row" href="@ChaseHref(item)">
                                <span class="pdo-row-id">@InvoiceLabel(item)</span>
                                <span class="pdo-row-name">@CustomerLabel(item)</span>
                                <span class="pdo-row-value">@Money(item.DocTotal, item.DocCurrency)</span>
                                <span class="pdo-row-raised">@RaisedOn(item.DocDate)</span>
                                <span class="pdo-row-age">
                                    <span class="pdo-tag @WaitingTone(item.DocDate)">@WaitingFor(item.DocDate)</span>
                                </span>
                            </a>
                        }
                    }
                </section>

                <section class="pdo-card" aria-label="Recent uploads">
                    <div class="pdo-card-head">
                        <span class="pdo-card-title">@(isOperator ? "Recent section uploads" : "Your recent uploads")</span>
                        <a class="pdo-link pdo-card-note" href="/pods">View all</a>
                    </div>

                    @if (uploads is null || uploads.RecentUploads.Count == 0)
                    {
                        <div class="pdo-empty">
                            @(isLoading ? "Loading uploads…"
                                : uploadsFailed ? "The upload figures could not be read."
                                : "Nothing has been uploaded yet.")
                        </div>
                    }
                    else
                    {
                        <div class="pdo-uploads">
                            @foreach (var upload in uploads.RecentUploads)
                            {
                                <div class="pdo-upload">
                                    <span class="pdo-upload-icon @FileTone(upload.FileName)">
                                        <i class="ph @FileIcon(upload.FileName)" aria-hidden="true"></i>
                                    </span>
                                    <span class="pdo-upload-body">
                                        <span class="pdo-upload-name" title="@upload.FileName">@upload.FileName</span>
                                        <span class="pdo-upload-note">
                                            @(upload.InvoiceDocNum > 0 ? $"Invoice {upload.InvoiceDocNum}" : $"Doc #{upload.InvoiceDocEntry}")
                                            @if (!string.IsNullOrWhiteSpace(upload.CardName))
                                            {
                                                <text> · @upload.CardName</text>
                                            }
                                        </span>
                                    </span>
                                    <span class="pdo-upload-size">@upload.FileSizeFormatted</span>
                                    <span class="pdo-upload-age">@AgeFromUtc(upload.UploadedAt)</span>
                                </div>
                            }
                        </div>
                    }
                </section>
            </div>

            <div class="pdo-col">

                <section class="pdo-card" aria-label="Delivery proof">
                    <div class="pdo-card-head">
                        <span class="pdo-card-title">Delivery proof</span>
                        <span class="pdo-card-note">Last @rangeDays days</span>
                    </div>

                    @if (coverage is { Total: > 0 } proof)
                    {
                        <div class="pdo-proof">
                            <div class="pdo-proof-fig">
                                <span class="pdo-proof-value">@($"{proof.Percent:0}")<small>%</small></span>
                                <span class="pdo-proof-cap">uploaded, @($"{proof.OnTimePercent:0}")% within 24h</span>
                            </div>

                            <div class="pdo-meter" role="img"
                                 aria-label="@($"{proof.OnTime} on time, {proof.Late} late, {proof.Outstanding} outstanding")">
                                <div class="pdo-meter-on" style="width:@Percent(proof.OnTime, proof.Total)"></div>
                                <div class="pdo-meter-late" style="width:@Percent(proof.Late, proof.Total)"></div>
                                <div class="pdo-meter-out" style="width:@Percent(proof.Outstanding, proof.Total)"></div>
                            </div>

                            <div class="pdo-legend">
                                <div class="pdo-legend-row">
                                    <span>Uploaded within 24h</span><span>@proof.OnTime.ToString("N0")</span>
                                </div>
                                <div class="pdo-legend-row">
                                    <span>Late upload</span><span>@proof.Late.ToString("N0")</span>
                                </div>
                                <div class="pdo-legend-row @(proof.Outstanding > 0 ? "is-risk" : null)">
                                    <span>Still outstanding</span><span>@proof.Outstanding.ToString("N0")</span>
                                </div>
                            </div>

                            @* What these figures cover, said plainly. The
                               generated location is only known for invoices
                               raised by a mapped SAP user, so a section reading
                               states what it had to leave out. *@
                            <div class="pdo-scope">
                                <i class="ph ph-funnel" aria-hidden="true"></i>
                                <span>
                                    @ScopeNote@(unattributed > 0
                                        ? $" · {unattributed:N0} invoices carry no section and are not counted"
                                        : null)
                                </span>
                            </div>

                            <a class="pdo-btn pdo-btn-primary pdo-btn-block" href="/pod-report">
                                Open the POD report
                            </a>
                        </div>
                    }
                    else
                    {
                        <div class="pdo-empty">
                            @(isLoading ? "Loading delivery proof…"
                                : complianceFailed ? "Delivery proof is unavailable."
                                : $"No invoices were raised in the last {rangeDays} days.")
                        </div>
                    }
                </section>

                @if (isOperator)
                {
                    <section class="pdo-card" aria-label="Who is uploading">
                        <div class="pdo-card-head">
                            <span class="pdo-card-title">Who is uploading</span>
                            <span class="pdo-card-note">@(uploaderCount > UploaderRanking ? $"Top {UploaderRanking} of {uploaderCount:N0}" : $"Last {rangeDays} days")</span>
                        </div>

                        @if (uploaders.Count == 0)
                        {
                            <div class="pdo-empty">
                                @(isLoading ? "Loading uploaders…"
                                    : complianceFailed ? "Unavailable."
                                    : SectionScoped
                                        ? $"Nobody at {SectionLabel} uploaded in the last {rangeDays} days."
                                        : $"Nothing was uploaded in the last {rangeDays} days.")
                            </div>
                        }
                        else
                        {
                            <div class="pdo-people">
                                @foreach (var person in uploaders)
                                {
                                    <div class="pdo-person">
                                        <div class="pdo-person-row">
                                            <span class="pdo-person-name" title="@person.Name">@person.Name</span>
                                            <span class="pdo-person-count">@person.Files.ToString("N0")</span>
                                        </div>
                                        <div class="pdo-person-track">
                                            <div class="pdo-person-fill" style="width:@person.Width"></div>
                                        </div>
                                        <div class="pdo-person-note">
                                            @person.Invoices.ToString("N0") @(person.Invoices == 1 ? "invoice" : "invoices")
                                            @if (person.Latest is { } latest)
                                            {
                                                <text> · last @AgeFromUtc(latest)</text>
                                            }
                                            @if (!string.IsNullOrWhiteSpace(person.Role) &&
                                                 !string.Equals(person.Role, UserRoles.Driver, StringComparison.OrdinalIgnoreCase))
                                            {
                                                <text> · @person.Role</text>
                                            }
                                        </div>
                                    </div>
                                }
                            </div>
                        }
                    </section>
                }

                <section class="pdo-card" aria-label="Totals">
                    <div class="pdo-card-head">
                        <span class="pdo-card-title">@(isOperator ? "Section totals" : "Your totals")</span>
                        <span class="pdo-card-note">All time</span>
                    </div>

                    @if (uploads is { } totals)
                    {
                        <div class="pdo-totals">
                            <div class="pdo-total">
                                <span>This week</span><span>@totals.UploadsThisWeek.ToString("N0")</span>
                            </div>
                            <div class="pdo-total">
                                <span>This month</span><span>@totals.UploadsThisMonth.ToString("N0")</span>
                            </div>
                            <div class="pdo-total">
                                <span>Files uploaded</span><span>@totals.TotalUploads.ToString("N0")</span>
                            </div>
                            <div class="pdo-total">
                                <span>Invoices covered</span><span>@totals.UniqueInvoicesCovered.ToString("N0")</span>
                            </div>
                            <div class="pdo-total">
                                <span>Stored</span><span>@totals.TotalFileSizeFormatted</span>
                            </div>
                        </div>
                    }
                    else
                    {
                        <div class="pdo-empty">
                            @(isLoading ? "Loading totals…" : "Totals are unavailable.")
                        </div>
                    }
                </section>
            </div>
        </div>

        <section class="pdo-steps" aria-label="Recommended workflow">
            @foreach (var step in Steps)
            {
                <div class="pdo-step">
                    <span class="pdo-step-n">Step @step.Number</span>
                    <span class="pdo-step-title">@step.Title</span>
                    <span class="pdo-step-body">@step.Body</span>
                    <a class="pdo-link" href="@step.Href">@step.Cta →</a>
                </div>
            }
        </section>
    </div>
</div>
