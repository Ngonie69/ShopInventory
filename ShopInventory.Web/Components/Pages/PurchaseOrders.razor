@page "/purchase-orders"
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize(Roles = "Admin,Manager")]
@inject IPurchaseOrderService PurchaseOrderService
@inject NavigationManager NavigationManager
@inject IAppSettingsProvider AppSettings
@inject IAuditService AuditService
@rendermode InteractiveServer

<PageTitle>Purchase Orders</PageTitle>

@* Nocturne. wwwroot/css/purchase-documents.css (linked from App.razor) carries
   the design and its light counterpart, and follows the app's theme toggle like
   every other page. This is the fifth register on that sheet, `.is-order`; see
   its header for what the five share and its last section for what only this
   page needs.

   No MudBlazor. MudTable rendered the register, MudPagination its foot and
   MudButton every action, all in MudBlazor's own palette — which loads after
   every sheet here and cannot be reached from one. The register is now the same
   CSS grid the other four use, which is also what lets a row re-lay as a
   labelled card below 1040px; a table element cannot.

   Paging is done here rather than by the query, unlike the four SAP-paged
   registers: this page asks for the whole result (`pageSize` 10,000) so that the
   status filter and the five figures describe everything that matched, not the
   twenty rows on screen. `viewPage` and `_pageSize` slice it for display. *@

<div class="pdx is-order">

    <header class="pdx-head">
        <div class="pdx-head-inner">
            <div class="pdx-head-doc">
                <span class="pdx-head-kind">Purchase orders</span>
                <span class="pdx-range">@DateRangeLabel</span>
            </div>
            <div class="pdx-head-meta">
                <button type="button" class="pdx-btn pdx-btn-ghost" disabled="@isLoading" @onclick="LoadOrders">
                    @if (isLoading)
                    {
                        <span class="pdx-spin" aria-hidden="true"></span>
                        <span>Loading&#8230;</span>
                    }
                    else
                    {
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                             stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <path d="M20 11a8 8 0 0 0-13.7-5.3L4 8"></path>
                            <path d="M4 4v4h4"></path>
                            <path d="M4 13a8 8 0 0 0 13.7 5.3L20 16"></path>
                            <path d="M20 20v-4h-4"></path>
                        </svg>
                        <span>Refresh</span>
                    }
                </button>
                <a class="pdx-btn pdx-btn-primary" href="/purchase-orders/create">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                         stroke-width="1.8" stroke-linecap="round" aria-hidden="true">
                        <path d="M12 5v14M5 12h14"></path>
                    </svg>
                    <span>New order</span>
                </a>
            </div>
        </div>
    </header>

    <div class="pdx-body">

        <section class="pdx-hero">
            <div>
                <div class="pdx-kicker">Purchasing</div>
                <h1>Purchase orders</h1>
                <p>
                    What has been ordered from suppliers and where each order has got to &#8212;
                    raised, approved, and received against.
                </p>
            </div>
        </section>

        @if (!string.IsNullOrEmpty(errorMessage))
        {
            <div class="pdx-msg" role="alert">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"
                     stroke-linecap="round" aria-hidden="true">
                    <circle cx="12" cy="12" r="9"></circle>
                    <path d="M12 7.5v5.5M12 16.2v.1"></path>
                </svg>
                <span>@errorMessage</span>
                <button type="button" class="pdx-msg-x" aria-label="Dismiss" @onclick="() => errorMessage = null">
                    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"
                         stroke-linecap="round" aria-hidden="true">
                        <path d="M6 6l12 12M18 6L6 18"></path>
                    </svg>
                </button>
            </div>
        }

        @if (!string.IsNullOrEmpty(successMessage))
        {
            <div class="pdx-hint-note" role="status">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"
                     stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M5 12.5l4.5 4.5L19 7"></path>
                </svg>
                <span>@successMessage</span>
            </div>
        }

        <section class="pdx-stats">
            <div class="pdx-stat pdx-stat-lead">
                <div class="pdx-stat-head"><span class="pdx-stat-rule" aria-hidden="true"></span>Total orders</div>
                <div class="pdx-stat-num">@totalCount.ToString("N0")</div>
                <div class="pdx-stat-sub">Matching the filters</div>
            </div>
            <div class="pdx-stat">
                <div class="pdx-stat-head"><span class="pdx-stat-rule" aria-hidden="true"></span>Drafts</div>
                <div class="pdx-stat-num">@CountOf(PurchaseOrderStatus.Draft).ToString("N0")</div>
                <div class="pdx-stat-sub">Not yet submitted</div>
            </div>
            <div class="pdx-stat">
                <div class="pdx-stat-head"><span class="pdx-stat-rule" aria-hidden="true"></span>Pending</div>
                <div class="pdx-stat-num">@CountOf(PurchaseOrderStatus.Pending).ToString("N0")</div>
                <div class="pdx-stat-sub">Waiting on approval</div>
            </div>
            <div class="pdx-stat">
                <div class="pdx-stat-head"><span class="pdx-stat-rule" aria-hidden="true"></span>Approved</div>
                <div class="pdx-stat-num">@ApprovedCount.ToString("N0")</div>
                <div class="pdx-stat-sub">Approved or part received</div>
            </div>
            <div class="pdx-stat">
                <div class="pdx-stat-head"><span class="pdx-stat-rule" aria-hidden="true"></span>Received</div>
                <div class="pdx-stat-num">@CountOf(PurchaseOrderStatus.Received).ToString("N0")</div>
                <div class="pdx-stat-sub">Fully booked in</div>
            </div>
        </section>

        <section class="pdx-panel">
            <div class="pdx-panel-head">
                <h2>Order register</h2>
                <span class="pdx-count">@RegisterCountText</span>
            </div>

            <div class="pdx-filters">
                <div class="pdx-field">
                    <span class="pdx-label" id="po-f-source-label">Data source</span>
                    @* Which store the register is reading. It changes what every
                       figure above means, so it is stated rather than closed in a
                       select. *@
                    <div class="pdx-seg" role="group" aria-labelledby="po-f-source-label">
                        <button type="button" class="pdx-seg-opt @(dataSource == "sap" ? "is-on" : "")"
                                aria-pressed="@(dataSource == "sap")" disabled="@isLoading"
                                @onclick='() => SwitchDataSource("sap")'>
                            SAP
                        </button>
                        <button type="button" class="pdx-seg-opt @(dataSource == "local" ? "is-on" : "")"
                                aria-pressed="@(dataSource == "local")" disabled="@isLoading"
                                @onclick='() => SwitchDataSource("local")'>
                            Local
                        </button>
                    </div>
                </div>

                <label class="pdx-field">
                    <span class="pdx-label">Supplier code</span>
                    <input class="pdx-input" type="text" placeholder="V001" @bind="supplierFilter" />
                </label>

                <label class="pdx-field">
                    <span class="pdx-label">Status</span>
                    <span class="pdx-select">
                        <select class="pdx-input" @bind="statusFilter">
                            <option value="">All statuses</option>
                            @foreach (PurchaseOrderStatus status in Enum.GetValues<PurchaseOrderStatus>())
                            {
                                <option value="@(((int)status).ToString())">@status</option>
                            }
                        </select>
                        <span class="pdx-caret" aria-hidden="true"></span>
                    </span>
                </label>

                <div class="pdx-field">
                    <span class="pdx-label">Ordered from</span>
                    <NocturneDateField Id="po-f-from" @bind-Date="fromDate" AriaLabel="Ordered from" />
                </div>

                <div class="pdx-field">
                    <span class="pdx-label">Ordered to</span>
                    <NocturneDateField Id="po-f-to" @bind-Date="toDate" AriaLabel="Ordered to" />
                </div>

                <div class="pdx-filter-actions">
                    <button type="button" class="pdx-btn pdx-btn-primary" disabled="@isLoading" @onclick="ApplyFilter">
                        Apply
                    </button>
                    <button type="button" class="pdx-btn pdx-btn-quiet" disabled="@isLoading" @onclick="ClearFilter">
                        Clear
                    </button>
                </div>
            </div>

            @if (isLoading)
            {
                <div class="pdx-loading">
                    <span class="pdx-spin" aria-hidden="true"></span>
                    <span>Loading purchase orders&#8230;</span>
                </div>
            }
            else if (orders is null || orders.Count == 0)
            {
                <div class="pdx-empty">
                    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                         stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <path d="M6 8h12l-1 12H7z"></path>
                        <path d="M9 8V6a3 3 0 0 1 6 0v2"></path>
                    </svg>
                    <span>No purchase order matched these filters.</span>
                    <div class="pdx-empty-actions">
                        <button type="button" class="pdx-btn pdx-btn-quiet" @onclick="ClearFilter">Clear the filters</button>
                        <a class="pdx-btn pdx-btn-primary" href="/purchase-orders/create">New order</a>
                    </div>
                </div>
            }
            else
            {
                <div class="pdx-scroll">
                    <div class="pdx-grid" role="table" aria-label="Purchase orders">
                        <div class="pdx-thead" role="row">
                            <span role="columnheader">Order</span>
                            <span role="columnheader">Supplier</span>
                            <span role="columnheader">Ordered</span>
                            <span role="columnheader">Delivery</span>
                            <span role="columnheader">Status</span>
                            <span role="columnheader" class="pdx-thead-end">Total</span>
                            <span role="columnheader">Actions</span>
                        </div>

                        @foreach (var order in PagedOrders)
                        {
                            <div class="pdx-row @(selectedOrder?.Id == order.Id ? "pdx-row-on" : "")" role="row"
                                 @key="order.Id" @onclick="() => ViewOrder(order)">
                                <span class="pdx-doc" role="cell">
                                    <span class="pdx-docnum">@order.OrderNumber</span>
                                    @if (!string.IsNullOrWhiteSpace(order.SupplierRefNo))
                                    {
                                        <span class="pdx-docsub">Ref @order.SupplierRefNo</span>
                                    }
                                </span>
                                <span class="pdx-party" role="cell">
                                    <span class="pdx-party-name">@(order.CardName ?? order.CardCode)</span>
                                    <span class="pdx-party-code">@order.CardCode</span>
                                </span>
                                <span class="pdx-date pdx-cell-date" role="cell">
                                    <span class="pdx-date-main">
                                        <span class="pdx-rl">Ordered</span>@order.OrderDate.ToString("dd MMM yyyy")
                                    </span>
                                </span>
                                <span class="pdx-date pdx-cell-date2" role="cell">
                                    <span class="pdx-date-main">
                                        <span class="pdx-rl">Delivery</span>
                                        @if (order.DeliveryDate.HasValue)
                                        {
                                            @order.DeliveryDate.Value.ToString("dd MMM yyyy")
                                        }
                                        else
                                        {
                                            <span class="pdx-none">Not set</span>
                                        }
                                    </span>
                                </span>
                                <span class="pdx-cell-status" role="cell">
                                    <span class="pdx-badge @GetStatusCssClass(order.Status)">@order.StatusName</span>
                                </span>
                                <span class="pdx-money pdx-cell-total" role="cell">
                                    <span class="pdx-money-cur">@order.Currency</span>
                                    <span class="pdx-money-num">@order.DocTotal.ToString("N2")</span>
                                </span>

                                @* The row opens the drawer, so every control in this cell has to
                                   stop the click reaching it — otherwise approving an order also
                                   opens it. *@
                                <span class="pdx-rowacts" role="cell" @onclick:stopPropagation>
                                    <button type="button" class="pdx-act" title="View details"
                                            aria-label="View details" @onclick="() => ViewOrder(order)">
                                        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                             stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"
                                             aria-hidden="true">
                                            <path d="M2 12s3.6-6 10-6 10 6 10 6-3.6 6-10 6-10-6-10-6z"></path>
                                            <circle cx="12" cy="12" r="2.6"></circle>
                                        </svg>
                                    </button>

                                    @if (order.Status == PurchaseOrderStatus.Draft)
                                    {
                                        <button type="button" class="pdx-act" title="Edit" aria-label="Edit"
                                                @onclick="() => EditOrder(order)">
                                            <svg width="15" height="15" viewBox="0 0 24 24" fill="none"
                                                 stroke="currentColor" stroke-width="1.7" stroke-linecap="round"
                                                 stroke-linejoin="round" aria-hidden="true">
                                                <path d="M4 20h4L20 8l-4-4L4 16z"></path>
                                            </svg>
                                        </button>
                                        <button type="button" class="pdx-act pdx-act-go" title="Submit for approval"
                                                aria-label="Submit for approval"
                                                @onclick="() => SubmitForApproval(order.Id)">
                                            <svg width="15" height="15" viewBox="0 0 24 24" fill="none"
                                                 stroke="currentColor" stroke-width="1.7" stroke-linecap="round"
                                                 stroke-linejoin="round" aria-hidden="true">
                                                <path d="M21 3L10.5 13.5"></path>
                                                <path d="M21 3l-6.5 18-4-8-8-4z"></path>
                                            </svg>
                                        </button>
                                    }

                                    @if (order.Status == PurchaseOrderStatus.Pending)
                                    {
                                        <button type="button" class="pdx-act pdx-act-ok" title="Approve"
                                                aria-label="Approve" @onclick="() => ApproveOrder(order.Id)">
                                            <svg width="15" height="15" viewBox="0 0 24 24" fill="none"
                                                 stroke="currentColor" stroke-width="2.2" stroke-linecap="round"
                                                 stroke-linejoin="round" aria-hidden="true">
                                                <path d="M5 12.5l4.5 4.5L19 7"></path>
                                            </svg>
                                        </button>
                                    }

                                    @if (order.Status == PurchaseOrderStatus.Approved
                                        || order.Status == PurchaseOrderStatus.PartiallyReceived)
                                    {
                                        @* An order SAP owns is received by raising a GRPO against it;
                                           a local one is received here. *@
                                        @if (string.Equals(order.Source, "SAP", StringComparison.OrdinalIgnoreCase))
                                        {
                                            <button type="button" class="pdx-act pdx-act-go" title="Create a goods receipt"
                                                    aria-label="Create a goods receipt"
                                                    @onclick="() => CreateGoodsReceiptFromSAPOrder(order)">
                                                <svg width="15" height="15" viewBox="0 0 24 24" fill="none"
                                                     stroke="currentColor" stroke-width="1.7" stroke-linecap="round"
                                                     stroke-linejoin="round" aria-hidden="true">
                                                    <path d="M12 3v11"></path>
                                                    <path d="M7.5 9.5L12 14l4.5-4.5"></path>
                                                    <path d="M4 19h16"></path>
                                                </svg>
                                            </button>
                                        }
                                        else
                                        {
                                            <button type="button" class="pdx-act pdx-act-go" title="Receive goods"
                                                    aria-label="Receive goods" @onclick="() => ShowReceiveModal(order)">
                                                <svg width="15" height="15" viewBox="0 0 24 24" fill="none"
                                                     stroke="currentColor" stroke-width="1.7" stroke-linecap="round"
                                                     stroke-linejoin="round" aria-hidden="true">
                                                    <path d="M3 8l9-5 9 5v8l-9 5-9-5z"></path>
                                                    <path d="M3 8l9 5 9-5M12 13v8"></path>
                                                </svg>
                                            </button>
                                        }
                                    }

                                    @if (order.Status == PurchaseOrderStatus.Draft
                                        || order.Status == PurchaseOrderStatus.Cancelled)
                                    {
                                        <button type="button" class="pdx-act pdx-act-bad" title="Delete"
                                                aria-label="Delete" @onclick="() => DeleteOrder(order.Id)">
                                            <svg width="15" height="15" viewBox="0 0 24 24" fill="none"
                                                 stroke="currentColor" stroke-width="1.7" stroke-linecap="round"
                                                 stroke-linejoin="round" aria-hidden="true">
                                                <path d="M5 7h14M10 7V5h4v2M6.5 7l1 13h9l1-13"></path>
                                            </svg>
                                        </button>
                                    }
                                </span>
                            </div>
                        }
                    </div>
                </div>

                <div class="pdx-foot">
                    <span class="pdx-foot-info">@PageRangeText</span>
                    <label class="pdx-foot-size">
                        <span>Rows</span>
                        <span class="pdx-select">
                            <select class="pdx-input" @bind="_pageSize" @bind:after="OnPageSizeChanged">
                                <option value="10">10</option>
                                <option value="25">25</option>
                                <option value="50">50</option>
                                <option value="100">100</option>
                                <option value="200">200</option>
                            </select>
                            <span class="pdx-caret" aria-hidden="true"></span>
                        </span>
                    </label>
                    <div class="pdx-pages">
                        <button type="button" class="pdx-step" disabled="@(ClampedViewPage <= 1)"
                                @onclick="() => GoToViewPage(ClampedViewPage - 1)">
                            Previous
                        </button>
                        <span class="pdx-page-now">Page @ClampedViewPage of @ViewPageCount</span>
                        <button type="button" class="pdx-step" disabled="@(ClampedViewPage >= ViewPageCount)"
                                @onclick="() => GoToViewPage(ClampedViewPage + 1)">
                            Next
                        </button>
                    </div>
                </div>
            }
        </section>
    </div>
</div>

@* The scrim and the drawer carry `.pdx` themselves: they sit outside the page
   element so it cannot clip them, and the class is what puts the tokens in
   reach. *@
@if (selectedOrder is not null)
{
    var detail = selectedOrder;

    <div class="pdx pdx-scrim" @onclick="() => selectedOrder = null"></div>
    <aside class="pdx pdx-drawer" role="dialog" aria-modal="true" aria-label="Purchase order details">
        <div class="pdx-drawer-head">
            <div>
                <h2>@detail.OrderNumber</h2>
                <div class="pdx-drawer-sub">
                    <span class="pdx-badge @GetStatusCssClass(detail.Status)">@detail.StatusName</span>
                    <span>@(detail.CardName ?? detail.CardCode)</span>
                    <span>@detail.Currency @detail.DocTotal.ToString("N2")</span>
                </div>
            </div>
            <button type="button" class="pdx-icon-btn pdx-drawer-x" aria-label="Close"
                    @onclick="() => selectedOrder = null">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                     stroke-linecap="round" aria-hidden="true">
                    <path d="M6 6l12 12M18 6L6 18"></path>
                </svg>
            </button>
        </div>

        <div class="pdx-drawer-body">
            <section class="pdx-section">
                <h3>Order</h3>
                <div class="pdx-dl">
                    <div>
                        <div class="pdx-dt">Supplier</div>
                        <div class="pdx-dd">@detail.CardCode &#183; @(detail.CardName ?? "Not named")</div>
                    </div>
                    <div>
                        <div class="pdx-dt">Supplier reference</div>
                        <div class="pdx-dd">@(string.IsNullOrWhiteSpace(detail.SupplierRefNo) ? "None" : detail.SupplierRefNo)</div>
                    </div>
                    <div>
                        <div class="pdx-dt">Ordered</div>
                        <div class="pdx-dd pdx-dd-num">@detail.OrderDate.ToString("dd MMM yyyy")</div>
                    </div>
                    <div>
                        <div class="pdx-dt">Delivery</div>
                        <div class="pdx-dd pdx-dd-num">@(detail.DeliveryDate?.ToString("dd MMM yyyy") ?? "Not set")</div>
                    </div>
                    <div>
                        <div class="pdx-dt">Warehouse</div>
                        <div class="pdx-dd">@(string.IsNullOrWhiteSpace(detail.WarehouseCode) ? "Not set" : detail.WarehouseCode)</div>
                    </div>
                    <div>
                        <div class="pdx-dt">Raised by</div>
                        <div class="pdx-dd">@(detail.CreatedByUserName ?? "System")</div>
                    </div>
                    @if (detail.ApprovedByUserName is not null)
                    {
                        <div>
                            <div class="pdx-dt">Approved by</div>
                            <div class="pdx-dd">
                                @detail.ApprovedByUserName
                                @if (detail.ApprovedDate.HasValue)
                                {
                                    <span class="pdx-docsub">@detail.ApprovedDate.Value.ToString("dd MMM yyyy")</span>
                                }
                            </div>
                        </div>
                    }
                </div>
            </section>

            @if (detail.Lines?.Any() == true)
            {
                <section class="pdx-section">
                    <h3>Order lines</h3>
                    <div class="pdx-scroll">
                        <table class="pdx-ltable">
                            <thead>
                                <tr>
                                    <th>Item</th>
                                    <th>Description</th>
                                    <th class="pdx-r">Ordered</th>
                                    <th class="pdx-r">Received</th>
                                    <th class="pdx-r">Outstanding</th>
                                    <th class="pdx-r">Unit price</th>
                                    <th class="pdx-r">Total</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var line in detail.Lines)
                                {
                                    <tr>
                                        <td class="pdx-ltable-code">@line.ItemCode</td>
                                        <td>@line.ItemDescription</td>
                                        <td class="pdx-r">@QuantityDisplay.Format(line.Quantity, line.UoMCode)</td>
                                        <td class="pdx-r">@QuantityDisplay.Format(line.QuantityReceived, line.UoMCode)</td>
                                        <td class="pdx-r">
                                            @if (line.QuantityRemaining > 0)
                                            {
                                                <span class="pdx-out">
                                                    @QuantityDisplay.Format(line.QuantityRemaining, line.UoMCode)
                                                </span>
                                            }
                                            else
                                            {
                                                <span>0</span>
                                            }
                                        </td>
                                        <td class="pdx-r">@line.UnitPrice.ToString("N2")</td>
                                        <td class="pdx-r">@line.LineTotal.ToString("N2")</td>
                                    </tr>
                                }
                            </tbody>
                            <tfoot>
                                <tr>
                                    <td colspan="6" class="pdx-r">Subtotal</td>
                                    <td class="pdx-r">@detail.SubTotal.ToString("N2")</td>
                                </tr>
                                <tr>
                                    <td colspan="6" class="pdx-r">Tax</td>
                                    <td class="pdx-r">@detail.TaxAmount.ToString("N2")</td>
                                </tr>
                                @if (detail.DiscountAmount > 0)
                                {
                                    <tr>
                                        <td colspan="6" class="pdx-r">Discount</td>
                                        <td class="pdx-r">&#8722;@detail.DiscountAmount.ToString("N2")</td>
                                    </tr>
                                }
                            </tfoot>
                        </table>
                    </div>

                    <div class="pdx-total-strip">
                        <span class="pdx-total-k">Total</span>
                        <span class="pdx-total-v">@detail.Currency @detail.DocTotal.ToString("N2")</span>
                    </div>
                </section>
            }

            @if (!string.IsNullOrEmpty(detail.Comments))
            {
                <section class="pdx-section">
                    <h3>Comments</h3>
                    <p class="pdx-pre">@detail.Comments</p>
                </section>
            }
        </div>
    </aside>
}

@if (showReceiveModal && receiveOrder is not null)
{
    <div class="pdx pdx-modal" role="dialog" aria-modal="true" aria-label="Receive goods">
        <div class="pdx-dialog">
            <div class="pdx-dialog-head">
                <div>
                    <h2>Receive goods</h2>
                    <div class="pdx-drawer-sub">
                        <span>@receiveOrder.OrderNumber</span>
                        <span>@(receiveOrder.CardName ?? receiveOrder.CardCode)</span>
                    </div>
                </div>
                <button type="button" class="pdx-icon-btn pdx-drawer-x" aria-label="Close"
                        @onclick="CloseReceiveModal">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                         stroke-linecap="round" aria-hidden="true">
                        <path d="M6 6l12 12M18 6L6 18"></path>
                    </svg>
                </button>
            </div>

            <div class="pdx-dialog-body">
                <div class="pdx-hint-note">
                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"
                         stroke-linecap="round" aria-hidden="true">
                        <circle cx="12" cy="12" r="9"></circle>
                        <path d="M12 11v5M12 7.8v.1"></path>
                    </svg>
                    <span>
                        Enter what actually arrived on each line. A line left at zero is not
                        received, and one that is short stays open for the rest.
                    </span>
                </div>

                @if (!string.IsNullOrEmpty(receiveError))
                {
                    <div class="pdx-msg" role="alert">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                             stroke-width="1.7" stroke-linecap="round" aria-hidden="true">
                            <circle cx="12" cy="12" r="9"></circle>
                            <path d="M12 7.5v5.5M12 16.2v.1"></path>
                        </svg>
                        <span>@receiveError</span>
                    </div>
                }

                <div class="pdx-scroll">
                    <table class="pdx-ltable">
                        <thead>
                            <tr>
                                <th>Item</th>
                                <th>Description</th>
                                <th class="pdx-r">Ordered</th>
                                <th class="pdx-r">Received</th>
                                <th class="pdx-r">Outstanding</th>
                                <th class="pdx-r">Receiving</th>
                            </tr>
                        </thead>
                        <tbody>
                            @for (var i = 0; i < receiveOrder.Lines.Count; i++)
                            {
                                var line = receiveOrder.Lines[i];
                                var remaining = line.Quantity - line.QuantityReceived;
                                var idx = i;

                                <tr>
                                    <td class="pdx-ltable-code">@line.ItemCode</td>
                                    <td>@line.ItemDescription</td>
                                    <td class="pdx-r">@QuantityDisplay.Format(line.Quantity, line.UoMCode)</td>
                                    <td class="pdx-r">@line.QuantityReceived</td>
                                    <td class="pdx-r">
                                        @if (remaining > 0)
                                        {
                                            <span class="pdx-out">@remaining</span>
                                        }
                                        else
                                        {
                                            <span>0</span>
                                        }
                                    </td>
                                    <td class="pdx-r">
                                        @if (remaining > 0)
                                        {
                                            <input class="pdx-input pdx-qty" type="number" min="0" max="@remaining"
                                                   step="any" aria-label="@($"Quantity received for {line.ItemCode}")"
                                                   @bind="receiveQuantities[idx]" />
                                        }
                                        else
                                        {
                                            <span class="pdx-done">Complete</span>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <label class="pdx-field">
                    <span class="pdx-label">Comments</span>
                    <textarea class="pdx-area" rows="2" placeholder="Optional receiving notes"
                              @bind="receiveComments"></textarea>
                </label>
            </div>

            <div class="pdx-dialog-foot">
                <button type="button" class="pdx-btn pdx-btn-quiet" @onclick="CloseReceiveModal">Cancel</button>
                <button type="button" class="pdx-btn pdx-btn-primary" disabled="@isReceiving" @onclick="ReceiveGoods">
                    @if (isReceiving)
                    {
                        <span class="pdx-spin" aria-hidden="true"></span>
                        <span>Receiving&#8230;</span>
                    }
                    else
                    {
                        <span>Confirm receipt</span>
                    }
                </button>
            </div>
        </div>
    </div>
}

@code {
    private int _pageSize = 10;
    private List<PurchaseOrderDto>? orders;
    private PurchaseOrderDto? selectedOrder;
    private bool isLoading = true;
    private string? errorMessage;
    private string? successMessage;

    // Data source toggle: "sap" or "local"
    private string dataSource = "sap";

    // Filters
    private string? supplierFilter;
    private string? statusFilter;
    private DateTime? fromDate;
    private DateTime? toDate;

    // Pagination
    private int currentPage = 1;
    private int pageSize = 10000;
    private int totalPages = 1;
    private int totalCount = 0;

    // Receive goods
    private bool showReceiveModal = false;
    private PurchaseOrderDto? receiveOrder;
    private List<decimal> receiveQuantities = new();
    private string? receiveComments;
    private string? receiveError;
    private bool isReceiving = false;

    // Which slice of the loaded result is on screen. The query fetches the whole
    // set (see `pageSize` above) so that the figures and the status filter
    // describe everything that matched; this pages what is drawn.
    private int viewPage = 1;

    private List<PurchaseOrderDto> AllOrders => orders ?? new List<PurchaseOrderDto>();

    private int ViewPageCount =>
        Math.Max(1, (AllOrders.Count + _pageSize - 1) / _pageSize);

    private IEnumerable<PurchaseOrderDto> PagedOrders =>
        AllOrders.Skip((ClampedViewPage - 1) * _pageSize).Take(_pageSize);

    // Clamped rather than reset: a filter that shortens the result while the
    // operator is on page 6 should show the last page, not an empty one.
    private int ClampedViewPage => Math.Clamp(viewPage, 1, ViewPageCount);

    private void GoToViewPage(int page) => viewPage = Math.Clamp(page, 1, ViewPageCount);

    private void OnPageSizeChanged() => viewPage = 1;

    private int CountOf(PurchaseOrderStatus status) => AllOrders.Count(o => o.Status == status);

    // Approved and partially received are one figure: both mean the order is
    // through approval and stock is expected against it.
    private int ApprovedCount => AllOrders.Count(o =>
        o.Status == PurchaseOrderStatus.Approved || o.Status == PurchaseOrderStatus.PartiallyReceived);

    // The window the page is showing, stated in the sticky bar; unset until the
    // operator picks one, because this register opens on everything.
    private string DateRangeLabel =>
        fromDate is null && toDate is null
            ? "All dates"
            : $"{fromDate?.ToString("dd MMM yyyy") ?? "Any"} – {toDate?.ToString("dd MMM yyyy") ?? "Any"}";

    private string RegisterCountText =>
        $"{AllOrders.Count:N0} of {totalCount:N0} · {(dataSource == "sap" ? "SAP" : "Local")}";

    private string PageRangeText
    {
        get
        {
            if (AllOrders.Count == 0)
                return "No orders";

            var start = ((ClampedViewPage - 1) * _pageSize) + 1;
            var end = Math.Min(start + _pageSize - 1, AllOrders.Count);
            return $"Showing {start:N0}–{end:N0} of {AllOrders.Count:N0}";
        }
    }

    protected override async Task OnInitializedAsync()
    {
        _pageSize = AppSettings.PageSize;
        await LoadOrders();
        await AuditService.LogAsync(AuditActions.ViewPurchaseOrders, "PurchaseOrder", null);
    }

    private async Task SwitchDataSource(string source)
    {
        dataSource = source;
        currentPage = 1;
        await LoadOrders();
    }

    private async Task LoadOrders()
    {
        isLoading = true;
        errorMessage = null;
        // A fresh result starts at its first page: after a filter or a source
        // switch, whatever page the operator was on is about to mean something
        // else.
        viewPage = 1;

        try
        {
            if (dataSource == "sap")
            {
                var response = await PurchaseOrderService.GetPurchaseOrdersFromSAPAsync(currentPage, pageSize, supplierFilter, fromDate,
                toDate);
                if (response != null)
                {
                    orders = response.Orders;
                    totalCount = response.TotalCount;
                    totalPages = response.TotalPages;

                    // Apply client-side status filter for SAP orders
                    if (!string.IsNullOrEmpty(statusFilter) && int.TryParse(statusFilter, out var statusInt))
                    {
                        var status = (PurchaseOrderStatus)statusInt;
                        orders = orders?.Where(o => o.Status == status).ToList();
                    }
                }
                else
                {
                    orders = new();
                    errorMessage = "Failed to load purchase orders from SAP. The API may be unavailable.";
                }
            }
            else
            {
                PurchaseOrderStatus? status = null;
                if (!string.IsNullOrEmpty(statusFilter) && int.TryParse(statusFilter, out var statusInt))
                {
                    status = (PurchaseOrderStatus)statusInt;
                }

                var response = await PurchaseOrderService.GetPurchaseOrdersAsync(currentPage, pageSize, status, supplierFilter,
                fromDate, toDate);
                if (response != null)
                {
                    orders = response.Orders;
                    totalCount = response.TotalCount;
                    totalPages = response.TotalPages;
                }
                else
                {
                    orders = new();
                    errorMessage = "Failed to load purchase orders. The API may be unavailable.";
                }
            }
        }
        catch (Exception ex)
        {
            orders = new();
            errorMessage = $"Error loading purchase orders: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task ApplyFilter()
    {
        currentPage = 1;
        await LoadOrders();
    }

    private async Task ClearFilter()
    {
        supplierFilter = null;
        statusFilter = null;
        fromDate = null;
        toDate = null;
        currentPage = 1;
        await LoadOrders();
    }

    private void ViewOrder(PurchaseOrderDto order)
    {
        selectedOrder = order;
    }

    private void EditOrder(PurchaseOrderDto order)
    {
        NavigationManager.NavigateTo($"/purchase-orders/create?editId={order.Id}");
    }

    private void CreateGoodsReceiptFromSAPOrder(PurchaseOrderDto order)
    {
        var docEntry = order.SAPDocEntry ?? order.Id;
        if (docEntry <= 0)
        {
            errorMessage = "Unable to open GRPO draft because the SAP purchase order identifier is missing.";
            return;
        }

        NavigationManager.NavigateTo($"/goods-receipt-pos/create?purchaseOrderDocEntry={docEntry}");
    }

    private async Task SubmitForApproval(int id)
    {
        try
        {
            var result = await PurchaseOrderService.UpdateStatusAsync(id, PurchaseOrderStatus.Pending, "Submitted for approval");
            if (result != null)
            {
                successMessage = "Purchase order submitted for approval.";
                await LoadOrders();
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Failed to submit for approval: {ex.Message}";
        }
    }

    private async Task ApproveOrder(int id)
    {
        try
        {
            var result = await PurchaseOrderService.ApproveAsync(id);
            if (result != null)
            {
                successMessage = "Purchase order approved successfully.";
                await AuditService.LogAsync(AuditActions.ApprovePurchaseOrder, "PurchaseOrder", id.ToString());
                await LoadOrders();
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Failed to approve: {ex.Message}";
        }
    }

    private void ShowReceiveModal(PurchaseOrderDto order)
    {
        receiveOrder = order;
        receiveQuantities = order.Lines.Select(_ => 0m).ToList();
        receiveComments = null;
        receiveError = null;
        showReceiveModal = true;
    }

    private void CloseReceiveModal()
    {
        showReceiveModal = false;
        receiveOrder = null;
    }

    private async Task ReceiveGoods()
    {
        if (receiveOrder == null) return;

        receiveError = null;
        var linesToReceive = new List<ReceivePurchaseOrderLineRequest>();

        for (int i = 0; i < receiveOrder.Lines.Count; i++)
        {
            if (receiveQuantities[i] > 0)
            {
                linesToReceive.Add(new ReceivePurchaseOrderLineRequest
                {
                    LineNum = receiveOrder.Lines[i].LineNum,
                    ItemCode = receiveOrder.Lines[i].ItemCode,
                    QuantityReceived = receiveQuantities[i]
                });
            }
        }

        if (!linesToReceive.Any())
        {
            receiveError = "Please enter quantity for at least one line item.";
            return;
        }

        isReceiving = true;
        try
        {
            var request = new ReceivePurchaseOrderRequest
            {
                Lines = linesToReceive,
                Comments = receiveComments
            };

            var result = await PurchaseOrderService.ReceiveItemsAsync(receiveOrder.Id, request);
            if (result != null)
            {
                showReceiveModal = false;
                receiveOrder = null;
                successMessage = "Goods received successfully!";
                await AuditService.LogAsync(AuditActions.ReceiveGoods, "PurchaseOrder", receiveOrder?.Id.ToString(), $"Received {linesToReceive.Count} line(s)", true);
                await LoadOrders();
            }
            else
            {
                receiveError = "Failed to receive items. Please try again.";
            }
        }
        catch (Exception ex)
        {
            receiveError = $"Error: {ex.Message}";
        }
        finally
        {
            isReceiving = false;
        }
    }

    private async Task DeleteOrder(int id)
    {
        try
        {
            var success = await PurchaseOrderService.DeletePurchaseOrderAsync(id);
            if (success)
            {
                successMessage = "Purchase order deleted.";
                await AuditService.LogAsync(AuditActions.DeletePurchaseOrder, "PurchaseOrder", id.ToString());
                await LoadOrders();
            }
            else
            {
                errorMessage = "Failed to delete purchase order.";
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Error deleting: {ex.Message}";
        }
    }

    // The badge takes its hue from a family token in purchase-documents.css, so
    // what this returns is the family class rather than a status name. Pending
    // and on-hold share the warning family deliberately: both mean the order has
    // stopped somewhere, and the badge carries its own word to tell them apart.
    private string GetStatusCssClass(PurchaseOrderStatus status) => status switch
    {
        PurchaseOrderStatus.Draft => "pdx-fam-neutral",
        PurchaseOrderStatus.Pending => "pdx-fam-warn",
        PurchaseOrderStatus.Approved => "pdx-fam-info",
        PurchaseOrderStatus.PartiallyReceived => "pdx-fam-accent",
        PurchaseOrderStatus.Received => "pdx-fam-good",
        PurchaseOrderStatus.Cancelled => "pdx-fam-bad",
        PurchaseOrderStatus.OnHold => "pdx-fam-warn",
        _ => "pdx-fam-neutral"
    };
}