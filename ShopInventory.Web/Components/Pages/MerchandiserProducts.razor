@page "/merchandiser-products"
@attribute [Authorize(Roles = "Admin")]

<PageTitle>Merchandiser Products</PageTitle>

@* Styles live in wwwroot/css/merchandiser.css (linked from App.razor), shared
   with /merchandiser-account — see that file's header. The `mp-` names are the
   ones this page already used; what changed is what they resolve to. *@

<div class="mp-page">

    <div class="mp-header">
        <div class="mp-header-text">
            <h1 class="mp-title">Merchandiser Products</h1>
            <p class="mp-subtitle">
                The product set every merchandiser sells from. Assigning adds an item for all of
                them at once; deactivating leaves it assigned but off the order screen.
            </p>
        </div>
        <div class="mp-header-actions">
            <button type="button" class="mch-btn mch-btn-ghost" disabled="@isBackfilling"
                    @onclick="BackfillProductDetails">
                @if (isBackfilling)
                {
                    <span class="mch-spinner"></span>
                    <span>Syncing&hellip;</span>
                }
                else
                {
                    <i class="ph ph-arrows-clockwise" aria-hidden="true"></i>
                    <span>Sync product details</span>
                }
            </button>
        </div>
    </div>

    @if (isLoading)
    {
        <div class="mp-state">
            <span class="mch-spinner mch-spinner-lg"></span>
            <span>Loading merchandiser products&hellip;</span>
        </div>
    }
    else
    {
        <div class="mp-figures">
            <div class="mp-figure mch-fam-info">
                <div class="mp-figure-value">@(productResponse?.TotalCount ?? 0)</div>
                <div class="mp-figure-label">Assigned products</div>
            </div>
            <div class="mp-figure mch-fam-good">
                <div class="mp-figure-value">@(productResponse?.ActiveCount ?? 0)</div>
                <div class="mp-figure-label">Active on the order screen</div>
            </div>
        </div>

        <section class="mp-panel">
            <div class="mp-panel-header">
                <h2><i class="ph ph-package" aria-hidden="true"></i>Products for all merchandisers</h2>
                <button type="button" class="mch-btn mch-btn-primary" @onclick="ShowAssignModal"
                        disabled="@isLoadingProducts">
                    <i class="ph ph-plus" aria-hidden="true"></i>Assign products
                </button>
            </div>

            <div class="mp-toolbar">
                <div class="mch-search">
                    <i class="ph ph-magnifying-glass" aria-hidden="true"></i>
                    <input type="search" class="mch-input" placeholder="Search products"
                           aria-label="Search products"
                           @bind="productSearchTerm" @bind:event="oninput" />
                </div>

                <NocturneSelect Class="nsel-auto" Options="CategoryFilterOptions"
                                @bind-Value="categoryFilter" Caption="Filter by category"
                                AriaLabel="Filter by category" Placeholder="All categories" />

                @* One choice, so one control: the three states are segments of a
                   single filter rather than three independent buttons. *@
                <div class="mp-segment" role="group" aria-label="Filter by status">
                    <button type="button" class="mp-segment-btn @(statusFilter == "" ? "active" : "")"
                            @onclick='() => statusFilter = ""'>All</button>
                    <button type="button" class="mp-segment-btn @(statusFilter == "active" ? "active" : "")"
                            @onclick='() => statusFilter = "active"'>Active</button>
                    <button type="button" class="mp-segment-btn @(statusFilter == "inactive" ? "active" : "")"
                            @onclick='() => statusFilter = "inactive"'>Inactive</button>
                </div>

                @if (selectedProductCodes.Count > 0)
                {
                    <div class="mp-bulk">
                        <span class="mp-bulk-count">@selectedProductCodes.Count selected</span>
                        <button type="button" class="mch-btn mch-btn-sm mch-btn-good" @onclick="ActivateSelected"
                                disabled="@isSaving">
                            <i class="ph ph-check" aria-hidden="true"></i>Activate
                        </button>
                        <button type="button" class="mch-btn mch-btn-sm mch-btn-ghost" @onclick="DeactivateSelected"
                                disabled="@isSaving">
                            <i class="ph ph-prohibit" aria-hidden="true"></i>Deactivate
                        </button>
                        <button type="button" class="mch-btn mch-btn-sm mch-btn-danger" @onclick="RemoveSelected"
                                disabled="@isSaving">
                            <i class="ph ph-trash" aria-hidden="true"></i>Remove
                        </button>
                    </div>
                }
            </div>

            @if (isLoadingProducts)
            {
                <div class="mp-state">
                    <span class="mch-spinner mch-spinner-lg"></span>
                    <span>Loading products&hellip;</span>
                </div>
            }
            else if (productResponse == null || productResponse.Products.Count == 0)
            {
                <div class="mp-empty">
                    <i class="ph ph-package" aria-hidden="true"></i>
                    <h5>No products assigned</h5>
                    <p>Assign products to put them on every merchandiser's order screen.</p>
                </div>
            }
            else
            {
                <div class="mp-list">
                    @foreach (var product in FilteredProducts)
                    {
                        var isSelected = selectedProductCodes.Contains(product.ItemCode);
                        <div class="mp-row @(product.IsActive ? "" : "is-inactive")">
                            <input type="checkbox" checked="@isSelected"
                                   aria-label="@($"Select {product.ItemCode}")"
                                   @onchange="(e) => ToggleProductSelection(product.ItemCode, (bool)(e.Value ?? false))" />
                            <span class="mp-code">@product.ItemCode</span>
                            <span class="mp-name">@product.ItemName</span>

                            <div class="mp-row-meta">
                                @if (!string.IsNullOrEmpty(product.Category))
                                {
                                    <span class="mch-badge mch-fam-accent">@product.Category</span>
                                }
                                <span class="mch-badge @(product.IsActive ? "mch-fam-good" : "mch-fam-neutral")">
                                    @(product.IsActive ? "Active" : "Inactive")
                                </span>
                            </div>

                            <div class="mp-row-actions">
                                @if (product.IsActive)
                                {
                                    <button type="button" class="mch-btn mch-btn-sm mch-btn-ghost"
                                            @onclick="() => ToggleSingleProduct(product.ItemCode, false)">
                                        Deactivate
                                    </button>
                                }
                                else
                                {
                                    <button type="button" class="mch-btn mch-btn-sm mch-btn-good"
                                            @onclick="() => ToggleSingleProduct(product.ItemCode, true)">
                                        Activate
                                    </button>
                                }
                                <button type="button" class="mch-icon-btn mch-icon-btn-danger"
                                        title="Remove from all merchandisers"
                                        aria-label="@($"Remove {product.ItemCode}")"
                                        @onclick="() => RemoveSingleProduct(product.ItemCode)">
                                    <i class="ph ph-trash" aria-hidden="true"></i>
                                </button>
                            </div>
                        </div>
                    }
                </div>
            }
        </section>
    }
</div>

@* The dialog is a sibling of `.mp-page`, not a child — see merchandiser.css's
   header for why it carries the token block itself. *@
@if (showAssignModal)
{
    <div class="mp-overlay" @onclick="CloseAssignModal">
        <div class="mp-modal" role="dialog" aria-modal="true" aria-label="Assign products"
             @onclick:stopPropagation="true">
            <div class="mp-modal-header">
                <h2>Assign products</h2>
                <button type="button" class="mp-modal-close" aria-label="Close" @onclick="CloseAssignModal">
                    <i class="ph ph-x" aria-hidden="true"></i>
                </button>
            </div>

            <div class="mp-modal-body">
                @if (isLoadingAssignProducts)
                {
                    <div class="mp-state">
                        <span class="mch-spinner mch-spinner-lg"></span>
                        <span>Loading sales items from SAP&hellip;</span>
                    </div>
                }
                else
                {
                    @if (!string.IsNullOrEmpty(assignLoadError))
                    {
                        <div class="mp-modal-note" role="alert">
                            <i class="ph ph-warning-octagon" aria-hidden="true"></i>
                            <span>@assignLoadError</span>
                        </div>
                    }

                    <input type="search" class="mch-input" placeholder="Search by item code or name"
                           aria-label="Search sales items"
                           @bind="assignSearchTerm" @bind:event="oninput" />

                    <label class="mp-select-all">
                        <input type="checkbox"
                               checked="@(assignSelectedCodes.Count == FilteredAssignableProducts.Count() && FilteredAssignableProducts.Any())"
                               @onchange="ToggleSelectAllAssign" />
                        Select all (@FilteredAssignableProducts.Count())
                    </label>

                    <div class="mp-assign-list">
                        @foreach (var product in FilteredAssignableProducts)
                        {
                            var isChecked = assignSelectedCodes.Contains(product.ItemCode);
                            <label class="mp-assign-item">
                                <input type="checkbox" checked="@isChecked"
                                       @onchange="(e) => ToggleAssignProduct(product.ItemCode, (bool)(e.Value ?? false))" />
                                <span class="mp-assign-text">
                                    <strong>@product.ItemCode</strong>
                                    <span>@product.ItemName</span>
                                </span>
                            </label>
                        }
                        @if (!FilteredAssignableProducts.Any() && string.IsNullOrEmpty(assignLoadError))
                        {
                            <div class="mp-empty">
                                <p>No products available to assign.</p>
                            </div>
                        }
                    </div>
                }
            </div>

            <div class="mp-modal-footer">
                <button type="button" class="mch-btn mch-btn-ghost" @onclick="CloseAssignModal">Cancel</button>
                <button type="button" class="mch-btn mch-btn-primary" @onclick="AssignSelectedProducts"
                        disabled="@(assignSelectedCodes.Count == 0 || isSaving)">
                    @if (isSaving)
                    {
                        <span class="mch-spinner"></span>
                    }
                    Assign @assignSelectedCodes.Count products
                </button>
            </div>
        </div>
    </div>
}
