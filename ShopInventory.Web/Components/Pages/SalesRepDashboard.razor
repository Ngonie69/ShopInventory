@using Microsoft.AspNetCore.Components

@* The dashboard a sales rep lands on at /, rendered by Home in place of the
   staff one.

   Styles live in wwwroot/css/dashboard.css (linked from App.razor), shared
   with the staff dashboard, rather than in the inline <style> block this page
   used to carry: that block was written as a single light scheme with its
   colours spelled out literally, so the page stayed on white paper while the
   rest of the app went dark. On the shared sheet it follows the theme toggle
   like every other page.

   A rep has no takings to report — no invoices, no payments, no transfer
   queue — so where the staff dashboard leads with three figures, this one
   leads with the five modules a rep can actually open. The tiles are the
   quick-action object one size up, so the two dashboards stay one design. *@

<div class="dsh">

    <header class="dsh-head">
        <div class="dsh-head-inner">
            <nav class="dsh-crumbs" aria-label="Breadcrumb">
                <span>Sales</span>
                <span class="dsh-crumb-sep" aria-hidden="true">/</span>
                <span class="dsh-crumb-now" aria-current="page">Dashboard</span>
            </nav>

            <div class="dsh-head-meta">
                <a class="dsh-btn dsh-btn-quiet" href="/mobile-drafts">
                    <DashIcon Name="phone" Size="14" />
                    <span>Mobile orders</span>
                </a>
                <a class="dsh-btn dsh-btn-primary dsh-btn-lg" href="/sales-orders">
                    <DashIcon Name="cart" Size="15" />
                    Open sales orders
                </a>
            </div>
        </div>
    </header>

    <div class="dsh-body">

        <section class="dsh-hero">
            <div>
                <div class="dsh-kicker">Sales workspace</div>
                <h1>Welcome back, @DisplayName</h1>
                <p>
                    Your sales-order and delivery follow-up tools in one place. Cashier,
                    invoicing, payment and transfer workflows are deliberately not here.
                </p>
            </div>
        </section>

        <section class="dsh-modules" aria-label="Your modules">
            @foreach (var module in Modules)
            {
                <a class="dsh-module" href="@module.Href">
                    <div class="dsh-module-head">
                        <span class="dsh-module-icon">
                            <DashIcon Name="@module.Icon" Size="17" />
                        </span>
                        <span class="dsh-module-tag">@module.Tag</span>
                    </div>
                    <h3>@module.Title</h3>
                    <p>@module.Description</p>
                    <span class="dsh-module-open">
                        Open module
                        <DashIcon Name="arrow-right" Size="13" />
                    </span>
                </a>
            }
        </section>

        <section class="dsh-panel" aria-labelledby="workflow-heading">
            <header class="dsh-panel-head">
                <span class="dsh-panel-icon">
                    <DashIcon Name="list-check" Size="15" />
                </span>
                <h2 id="workflow-heading">Recommended workflow</h2>
            </header>

            <div class="dsh-steps">
                <div class="dsh-step">
                    <span class="dsh-step-n" aria-hidden="true">1</span>
                    <div>
                        <h3>Review incoming customer orders</h3>
                        <p>
                            Sales Orders tracks status, opens order details and keeps customer
                            demand moving.
                        </p>
                    </div>
                </div>
                <div class="dsh-step">
                    <span class="dsh-step-n" aria-hidden="true">2</span>
                    <div>
                        <h3>Process mobile-submitted orders</h3>
                        <p>
                            Mobile Orders is where field submissions are validated and carried on
                            through the sales workflow, without stepping into cashier tasks.
                        </p>
                    </div>
                </div>
                <div class="dsh-step">
                    <span class="dsh-step-n" aria-hidden="true">3</span>
                    <div>
                        <h3>Close the delivery loop</h3>
                        <p>
                            The POD tools upload proof of delivery, show upload activity and chase
                            the documents still outstanding.
                        </p>
                    </div>
                </div>
            </div>
        </section>

    </div>
</div>

@code {
    /// <summary>
    /// The rep's first name, already derived by Home — this page never sees the
    /// raw username, which is an email address for most accounts.
    /// </summary>
    [Parameter] public string DisplayName { get; set; } = string.Empty;

    private static readonly IReadOnlyList<DashboardModule> Modules =
    [
        new DashboardModule(
            "Sales Orders",
            "Review order status, open customer orders and continue order updates without crossing into invoicing.",
            "/sales-orders",
            "cart",
            "Order flow"),
        new DashboardModule(
            "Mobile Orders",
            "Pick up orders captured in the field and move them forward from a controlled sales workflow.",
            "/mobile-drafts",
            "phone",
            "Field sales"),
        new DashboardModule(
            "POD Dashboard",
            "See your proof-of-delivery activity at a glance and monitor upload momentum.",
            "/pod-dashboard",
            "gauge",
            "Upload activity"),
        new DashboardModule(
            "Proof of Delivery",
            "Upload and manage POD attachments for completed deliveries.",
            "/pods",
            "clipboard-check",
            "Delivery proof"),
        new DashboardModule(
            "POD Upload Report",
            "Track uploaded versus pending delivery evidence so follow-up stays visible.",
            "/pod-report",
            "clipboard-data",
            "Status view")
    ];

    private sealed record DashboardModule(
        string Title,
        string Description,
        string Href,
        string Icon,
        string Tag);
}
