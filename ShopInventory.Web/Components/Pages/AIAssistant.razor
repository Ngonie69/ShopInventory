@page "/ai-assistant"
@using Microsoft.AspNetCore.Authorization
@using ShopInventory.Web.Data
@attribute [Authorize(Roles = UserRoles.SystemRoles)]
@inject IAIService AIService
@inject ILocalizationService L
@inject IJSRuntime JS

<PageTitle>AI Assistant - Shop Inventory</PageTitle>

@* The Nocturne sheet is wwwroot/css/ai-assistant.css (linked from App.razor).
   Chrome from audit-trail.css, tab strip from approval-process.css.

   The old rules for this page were not in a <style> block — they were in
   app.css keyed on `.ai-assistant-container` and about thirty descendants. They
   are left there rather than removed: that file is 321 KB and a bad edit
   deletes whole rules with no error. On this new prefix they simply stop
   matching.

   The MudButtons and MudProgressCirculars are gone. Re-skinning them would have
   meant out-specifying MudBlazor's own sheet, which loads after this one, for
   controls this module already has natively. *@

<div class="aia">

    <header class="aia-head">
        <div class="aia-head-inner">
            <nav class="aia-crumbs" aria-label="Breadcrumb">
                <span>Administration</span>
                <span class="aia-crumb-sep" aria-hidden="true">/</span>
                <span class="aia-crumb-now" aria-current="page">AI assistant</span>
            </nav>
        </div>
    </header>

    <div class="aia-body">

        <section class="aia-hero">
            <div>
                <div class="aia-kicker">Ask the data</div>
                <h1>AI assistant</h1>
                <p>
                    Questions about stock, sales and the shape of the last few weeks, answered from this
                    company's own figures. Everything here is generated, so treat it as a lead to check
                    rather than as a report.
                </p>
            </div>
        </section>

        @if (!AIService.IsConfigured)
        {
            <div class="aia-notice aia-fam-warn" role="status">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                     stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M12 4l9 16H3z"></path>
                    <path d="M12 10v4"></path>
                    <path d="M12 17.5v.01"></path>
                </svg>
                <span class="aia-notice-text">
                    No AI provider is configured, so nothing on this page can run.
                    <p>Set one in appsettings.json — OpenAI, Azure OpenAI or a local Ollama instance.</p>
                </span>
            </div>
        }
        else
        {
            <nav class="aia-tabs" aria-label="AI assistant sections">
                <button type="button" class="aia-tab @(activeTab == "chat" ? "aia-tab-on" : "")"
                        aria-current="@(activeTab == "chat" ? "page" : null)"
                        @onclick='() => activeTab = "chat"'>Chat</button>
                <button type="button" class="aia-tab @(activeTab == "insights" ? "aia-tab-on" : "")"
                        aria-current="@(activeTab == "insights" ? "page" : null)"
                        @onclick='() => activeTab = "insights"'>Insights</button>
                <button type="button" class="aia-tab @(activeTab == "forecast" ? "aia-tab-on" : "")"
                        aria-current="@(activeTab == "forecast" ? "page" : null)"
                        @onclick='() => activeTab = "forecast"'>Forecast</button>
                <button type="button" class="aia-tab @(activeTab == "anomalies" ? "aia-tab-on" : "")"
                        aria-current="@(activeTab == "anomalies" ? "page" : null)"
                        @onclick='() => activeTab = "anomalies"'>Anomalies</button>
            </nav>

            @if (activeTab == "chat")
            {
                <section class="aia-panel aia-chat">
                    <div class="aia-transcript" @ref="chatMessagesRef">
                        @if (!chatHistory.Any())
                        {
                            <div class="aia-welcome">
                                <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                     stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                    <rect x="4" y="7" width="16" height="12" rx="3"></rect>
                                    <path d="M12 3v4"></path>
                                    <path d="M9 12v1"></path>
                                    <path d="M15 12v1"></path>
                                    <path d="M2 12v3"></path>
                                    <path d="M22 12v3"></path>
                                </svg>
                                <h2>Ask about the business</h2>
                                <p>Stock levels, sales movement, what needs reordering, which lines are carrying the month.</p>
                                <div class="aia-prompts">
                                    <button type="button" class="aia-prompt"
                                            @onclick='() => SendQuickPrompt("What is my current inventory status?")'>Inventory status</button>
                                    <button type="button" class="aia-prompt"
                                            @onclick='() => SendQuickPrompt("Show me sales trends for this week")'>Sales this week</button>
                                    <button type="button" class="aia-prompt"
                                            @onclick='() => SendQuickPrompt("Which products need restocking?")'>Needs restocking</button>
                                    <button type="button" class="aia-prompt"
                                            @onclick='() => SendQuickPrompt("Analyze my top selling products")'>Top products</button>
                                </div>
                            </div>
                        }
                        else
                        {
                            @foreach (var message in chatHistory)
                            {
                                <div class="aia-turn @(message.Role == "user" ? "aia-turn-user" : "")">
                                    <span class="aia-avatar" aria-hidden="true">
                                        @if (message.Role == "user")
                                        {
                                            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                                 stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                                                <circle cx="12" cy="8.5" r="3.5"></circle>
                                                <path d="M5 20a7 7 0 0 1 14 0"></path>
                                            </svg>
                                        }
                                        else
                                        {
                                            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                                 stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                                                <rect x="4" y="7" width="16" height="12" rx="3"></rect>
                                                <path d="M12 3v4"></path>
                                                <path d="M9 12v1"></path>
                                                <path d="M15 12v1"></path>
                                            </svg>
                                        }
                                    </span>
                                    <div>
                                        <div class="aia-bubble">@((MarkupString)FormatMessage(message.Content))</div>
                                        <div class="aia-time">@message.Timestamp.ToString("HH:mm")</div>
                                    </div>
                                </div>
                            }
                            @if (isLoading)
                            {
                                <div class="aia-turn">
                                    <span class="aia-avatar" aria-hidden="true">
                                        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                             stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                                            <rect x="4" y="7" width="16" height="12" rx="3"></rect>
                                            <path d="M12 3v4"></path>
                                            <path d="M9 12v1"></path>
                                            <path d="M15 12v1"></path>
                                        </svg>
                                    </span>
                                    <div class="aia-bubble">
                                        <span class="aia-typing" role="status" aria-label="Thinking">
                                            <span></span><span></span><span></span>
                                        </span>
                                    </div>
                                </div>
                            }
                        }
                    </div>

                    <div class="aia-composer">
                        <label class="visually-hidden" for="aiaInput">Message</label>
                        <textarea id="aiaInput" class="aia-textarea" rows="1" disabled="@isLoading"
                                  placeholder="Ask about stock, sales or a customer…"
                                  @bind="userMessage" @bind:event="oninput" @onkeydown="HandleKeyDown"></textarea>
                        <button type="button" class="aia-send" aria-label="Send"
                                disabled="@(isLoading || string.IsNullOrWhiteSpace(userMessage))" @onclick="SendMessage">
                            @if (isLoading)
                            {
                                <span class="aia-spin" aria-hidden="true"></span>
                            }
                            else
                            {
                                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                     stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                    <path d="M4 12h15"></path>
                                    <path d="M13 6l6 6-6 6"></path>
                                </svg>
                            }
                        </button>
                    </div>
                </section>
            }
            else if (activeTab == "insights")
            {
                <section class="aia-panel">
                    <div class="aia-panel-head">
                        <h2>Business insights</h2>
                        @if (insights != null)
                        {
                            <span class="aia-stamp">Generated @insights.GeneratedAt.ToString("d MMM yyyy HH:mm")</span>
                        }
                        <div class="aia-panel-head-aside">
                            <button type="button" class="aia-btn aia-btn-primary" disabled="@isLoadingInsights"
                                    @onclick="GenerateInsights">
                                @if (isLoadingInsights)
                                {
                                    <span class="aia-spin" aria-hidden="true"></span>
                                    <span>Generating&#8230;</span>
                                }
                                else
                                {
                                    <span>@(insights == null ? "Generate insights" : "Regenerate")</span>
                                }
                            </button>
                        </div>
                    </div>

                    <div class="aia-panel-body">
                        @if (insights != null)
                        {
                            <p class="aia-summary">@insights.Summary</p>

                            <div class="aia-cards">
                                @foreach (var insight in insights.Insights)
                                {
                                    <article class="aia-card @SeverityFamily(insight.Severity)">
                                        <h3>@insight.Title</h3>
                                        <p>@insight.Description</p>
                                        <span class="aia-chip">@insight.Category</span>
                                    </article>
                                }
                            </div>

                            @if (insights.Recommendations.Any())
                            {
                                <div class="aia-recs">
                                    <h3>Recommendations</h3>
                                    <ul>
                                        @foreach (var rec in insights.Recommendations)
                                        {
                                            <li>@rec</li>
                                        }
                                    </ul>
                                </div>
                            }
                        }
                        else if (!isLoadingInsights)
                        {
                            <div class="aia-empty">
                                <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                     stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                    <path d="M9 18h6"></path>
                                    <path d="M10 21h4"></path>
                                    <path d="M12 3a6 6 0 0 1 3.6 10.8c-.6.5-.9 1.1-.9 1.7v.5H9.3v-.5c0-.6-.3-1.2-.9-1.7A6 6 0 0 1 12 3z"></path>
                                </svg>
                                <span>Nothing generated yet. This reads the last few weeks and says what stands out.</span>
                            </div>
                        }
                    </div>
                </section>
            }
            else if (activeTab == "forecast")
            {
                <section class="aia-panel">
                    <div class="aia-panel-head">
                        <h2>Sales forecast</h2>
                        <div class="aia-panel-head-aside">
                            <button type="button" class="aia-btn aia-btn-primary" disabled="@isLoadingForecast"
                                    @onclick="GenerateForecast">
                                @if (isLoadingForecast)
                                {
                                    <span class="aia-spin" aria-hidden="true"></span>
                                    <span>Generating&#8230;</span>
                                }
                                else
                                {
                                    <span>@(forecast == null ? "Generate forecast" : "Regenerate")</span>
                                }
                            </button>
                        </div>
                    </div>

                    <div class="aia-panel-body">
                        @if (forecast != null)
                        {
                            <div class="aia-figures">
                                <div class="aia-figure">
                                    <div class="aia-figure-label">Trend</div>
                                    <div class="aia-figure-value @TrendFamily(forecast.Trend)">
                                        <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                             stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                            @if (forecast.Trend == "increasing")
                                            {
                                                <path d="M4 17l6-6 4 4 6-7"></path>
                                                <path d="M20 8v4h-4"></path>
                                            }
                                            else if (forecast.Trend == "decreasing")
                                            {
                                                <path d="M4 7l6 6 4-4 6 7"></path>
                                                <path d="M20 16v-4h-4"></path>
                                            }
                                            else
                                            {
                                                <path d="M4 12h16"></path>
                                            }
                                        </svg>
                                        @forecast.Trend
                                    </div>
                                </div>
                                <div class="aia-figure">
                                    <div class="aia-figure-label">Confidence</div>
                                    <div class="aia-figure-value">@((forecast.Confidence * 100).ToString("0"))%</div>
                                </div>
                            </div>

                            <p class="aia-summary">@forecast.Analysis</p>

                            @if (forecast.Predictions.Any())
                            {
                                <div class="aia-scroll">
                                    <table class="aia-table">
                                        <thead>
                                            <tr>
                                                <th scope="col">Date</th>
                                                <th scope="col">Predicted</th>
                                                <th scope="col">Range</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var pred in forecast.Predictions)
                                            {
                                                <tr>
                                                    <td>@pred.Date.ToString("ddd d MMM")</td>
                                                    <td>@pred.PredictedQuantity.ToString("N0")</td>
                                                    <td>@pred.LowerBound.ToString("N0")&#8211;@pred.UpperBound.ToString("N0")</td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            }
                        }
                        else if (!isLoadingForecast)
                        {
                            <div class="aia-empty">
                                <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                     stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                    <path d="M4 19V5"></path>
                                    <path d="M4 19h16"></path>
                                    <path d="M7 15l4-4 3 3 5-6"></path>
                                </svg>
                                <span>Nothing generated yet. This projects the coming days from the recent run rate.</span>
                            </div>
                        }
                    </div>
                </section>
            }
            else if (activeTab == "anomalies")
            {
                <section class="aia-panel">
                    <div class="aia-panel-head">
                        <h2>Anomalies</h2>
                        @if (anomalyReport != null)
                        {
                            <span class="aia-stamp">Scanned @anomalyReport.GeneratedAt.ToString("d MMM yyyy HH:mm")</span>
                        }
                        <div class="aia-panel-head-aside">
                            <button type="button" class="aia-btn aia-btn-primary" disabled="@isLoadingAnomalies"
                                    @onclick="DetectAnomalies">
                                @if (isLoadingAnomalies)
                                {
                                    <span class="aia-spin" aria-hidden="true"></span>
                                    <span>Scanning&#8230;</span>
                                }
                                else
                                {
                                    <span>@(anomalyReport == null ? "Scan for anomalies" : "Scan again")</span>
                                }
                            </button>
                        </div>
                    </div>

                    <div class="aia-panel-body">
                        @if (anomalyReport != null)
                        {
                            <div class="aia-risk @SeverityFamily(anomalyReport.OverallRisk)">
                                <span class="aia-risk-level">@anomalyReport.OverallRisk risk</span>
                                <span class="aia-risk-count">
                                    @anomalyReport.TotalAnomalies @(anomalyReport.TotalAnomalies == 1 ? "anomaly" : "anomalies") found
                                </span>
                            </div>

                            @if (anomalyReport.Anomalies.Any())
                            {
                                <div class="aia-rows">
                                    @foreach (var anomaly in anomalyReport.Anomalies)
                                    {
                                        <div class="aia-row @SeverityFamily(anomaly.Severity)">
                                            <span class="aia-row-mark" aria-hidden="true"></span>
                                            <div class="aia-row-text">
                                                <div class="aia-row-kind">@anomaly.Type.Replace("_", " ")</div>
                                                <div class="aia-row-title">@anomaly.AffectedItem</div>
                                                <div class="aia-row-desc">@anomaly.Description</div>
                                            </div>
                                            <span class="aia-row-badge">@anomaly.Severity</span>
                                        </div>
                                    }
                                </div>
                            }
                            else
                            {
                                <div class="aia-empty aia-empty-good">
                                    <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                         stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                        <circle cx="12" cy="12" r="9"></circle>
                                        <path d="M8 12.5l2.5 2.5L16 9.5"></path>
                                    </svg>
                                    <span>Nothing unusual in the data scanned.</span>
                                </div>
                            }
                        }
                        else if (!isLoadingAnomalies)
                        {
                            <div class="aia-empty">
                                <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                     stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                    <path d="M12 3l8 3v6c0 4.4-3.2 7.9-8 9-4.8-1.1-8-4.6-8-9V6z"></path>
                                    <path d="M12 9v4"></path>
                                    <path d="M12 16.5v.01"></path>
                                </svg>
                                <span>Nothing scanned yet. This looks for movements that do not fit the usual pattern.</span>
                            </div>
                        }
                    </div>
                </section>
            }
        }
    </div>
</div>

@code {
    private string activeTab = "chat";
    private string userMessage = "";
    private List<ChatMessage> chatHistory = new();
    private bool isLoading;
    private bool isLoadingInsights;
    private bool isLoadingForecast;
    private bool isLoadingAnomalies;
    private ElementReference chatMessagesRef;
    private AIInsight? insights;
    private SalesForecast? forecast;
    private AnomalyReport? anomalyReport;

    private async Task SendMessage()
    {
        if (string.IsNullOrWhiteSpace(userMessage) || isLoading) return;

        var message = userMessage.Trim();
        userMessage = "";

        chatHistory.Add(new ChatMessage { Role = "user", Content = message });
        isLoading = true;
        StateHasChanged();
        await ScrollToBottom();

        try
        {
            var response = await AIService.ChatAsync(message, chatHistory);
            chatHistory.Add(new ChatMessage { Role = "assistant", Content = response });
        }
        catch (Exception ex)
        {
            chatHistory.Add(new ChatMessage { Role = "assistant", Content = $"Sorry, I encountered an error: {ex.Message}" });
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
            await ScrollToBottom();
        }
    }

    private async Task SendQuickPrompt(string prompt)
    {
        userMessage = prompt;
        await SendMessage();
    }

    private async Task HandleKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !e.ShiftKey)
        {
            await SendMessage();
        }
    }

    private async Task ScrollToBottom()
    {
        await Task.Delay(50);
        try
        {
            await JS.InvokeVoidAsync("eval", "document.querySelector('.chat-messages')?.scrollTo(0, document.querySelector('.chat-messages')?.scrollHeight)");
        }
        catch { }
    }

    private async Task GenerateInsights()
    {
        isLoadingInsights = true;
        StateHasChanged();

        try
        {
            insights = await AIService.GetInventoryInsightsAsync();
        }
        finally
        {
            isLoadingInsights = false;
            StateHasChanged();
        }
    }

    private async Task GenerateForecast()
    {
        isLoadingForecast = true;
        StateHasChanged();

        try
        {
            forecast = await AIService.GetSalesForecastAsync();
        }
        finally
        {
            isLoadingForecast = false;
            StateHasChanged();
        }
    }

    private async Task DetectAnomalies()
    {
        isLoadingAnomalies = true;
        StateHasChanged();

        try
        {
            anomalyReport = await AIService.DetectAnomaliesAsync();
        }
        finally
        {
            isLoadingAnomalies = false;
            StateHasChanged();
        }
    }

    private string FormatMessage(string content)
    {
        // Simple markdown-like formatting
        content = System.Web.HttpUtility.HtmlEncode(content);
        content = System.Text.RegularExpressions.Regex.Replace(content, @"\*\*(.*?)\*\*", "<strong>$1</strong>");
        content = System.Text.RegularExpressions.Regex.Replace(content, @"\*(.*?)\*", "<em>$1</em>");
        content = content.Replace("\n", "<br/>");
        return content;
    }

    // The model returns severity as free text and is not consistent about which
    // vocabulary it uses, so both sets are mapped here onto one family token
    // from nocturne-tokens.css. Matching is case-insensitive because the same
    // report has been seen with "High" and "high" in one response.
    private static string SeverityFamily(string? severity) => (severity ?? "").ToLowerInvariant() switch
    {
        "critical" or "high" => "aia-fam-bad",
        "warning" or "medium" => "aia-fam-warn",
        "info" or "low" => "aia-fam-info",
        "none" or "ok" => "aia-fam-good",
        _ => "aia-fam-neutral"
    };

    // Rising sales are good and falling ones are not, so the trend figure is the
    // one number on the page that takes a hue from what it says rather than from
    // a severity the model chose.
    private static string TrendFamily(string? trend) => (trend ?? "").ToLowerInvariant() switch
    {
        "increasing" => "aia-fam-good",
        "decreasing" => "aia-fam-bad",
        _ => "aia-fam-neutral"
    };
}
