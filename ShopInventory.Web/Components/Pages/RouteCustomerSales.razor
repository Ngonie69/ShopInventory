@page "/route-customers/{RouteCustomerId:int}/sales"
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize(Roles = "Admin,Manager,Cashier")]
@rendermode InteractiveServer

@* One route customer's trading — a shop a van sells to on its round.

   The page is only the crumb. Everything under it is RouteCustomerSalesView, which /vending also
   wears for a vendor. The two are kept apart here rather than switched inside one page because
   they are not the same thing: a shop is on a route, a vendor is at a depot and on no route at
   all, and this page's every word says "route". *@

<RouteCustomerSalesView RouteCustomerId="RouteCustomerId">
    <Kicker Context="route">
        <a class="ops-link" href="/route-customers">Route customers</a>
        <span class="ops-rcs-crumb-sep">/</span>
        @route
    </Kicker>
</RouteCustomerSalesView>

@code {
    [Parameter] public int RouteCustomerId { get; set; }
}
