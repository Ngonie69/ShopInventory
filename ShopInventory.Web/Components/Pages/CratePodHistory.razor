@page "/crates/pods/history"
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize(Roles = "Admin,Manager,Merchandiser,PodOperator,Operator,Driver,SalesRep")]
@inherits CratePodsPageBase
@rendermode InteractiveServer

<PageTitle>Crate POD History - Shop Inventory</PageTitle>

@{
    var filteredRows = FilteredPodAttachmentRows.ToList();
    var attachmentCount = pods.Sum(pod => pod.Attachments.Count);
    var totalPages = Math.Max(1, (int)Math.Ceiling(filteredRows.Count / (double)PodHistoryPageSize));
    var currentPage = ResolvePodHistoryPage(totalPages);
    var firstRowNumber = filteredRows.Count == 0 ? 0 : ((currentPage - 1) * PodHistoryPageSize) + 1;
    var lastRowNumber = Math.Min(currentPage * PodHistoryPageSize, filteredRows.Count);
    var pagedRows = filteredRows
        .Skip((currentPage - 1) * PodHistoryPageSize)
        .Take(PodHistoryPageSize)
        .ToList();
}

<div class="container-fluid fade-in staff-dashboard staff-shell crpod-page">
    <div class="crpod-hero">
        <div class="crpod-hero-top">
            <div class="crpod-hero-heading">
                <span class="crpod-hero-icon">
                    <i class="bi bi-clock-history"></i>
                </span>
                <div>
                    <h2 class="crpod-hero-title">Crate POD History</h2>
                    <p class="crpod-hero-subtitle">Review submitted crate PODs and manage their supporting files.</p>
                </div>
            </div>
            <button type="button" class="crpod-refresh-btn" @onclick="RefreshAllAsync" disabled="@isLoading">
                <i class="bi bi-arrow-clockwise"></i>
                <span>@(isLoading ? "Refreshing..." : "Refresh")</span>
            </button>
        </div>

        <div class="crpod-hero-stats">
            <div class="crpod-stat">
                <span class="crpod-stat-value">@pods.Count</span>
                <span class="crpod-stat-label">Submissions</span>
            </div>
            <div class="crpod-stat">
                <span class="crpod-stat-value">@attachmentCount</span>
                <span class="crpod-stat-label">Attachments</span>
            </div>
            <div class="crpod-stat">
                <span class="crpod-stat-value">@PodEligibleTransactions.Count()</span>
                <span class="crpod-stat-label">Invoice transactions</span>
            </div>
        </div>
    </div>

    <PodNavTabs Active="PodNavTabs.PodNavTab.CrateHistory" />

    @if (!string.IsNullOrWhiteSpace(statusMessage))
    {
        <div class="crpod-status-banner @(statusIsSuccess ? "crpod-status-success" : "crpod-status-error")">
            <i class="bi @(statusIsSuccess ? "bi-check-circle-fill" : "bi-exclamation-triangle-fill")"></i>
            <span>@statusMessage</span>
        </div>
    }

    @if (!canSubmitPods)
    {
        <div class="crpod-card mb-4">
            <div class="crpod-readonly-state">
                <div class="crpod-readonly-icon">
                    <i class="bi bi-eye"></i>
                </div>
                <div>
                    <h3 class="crpod-card-title mb-1">Read-only access</h3>
                    <p class="crpod-card-note mb-0">You can preview and download crate POD documents. Upload and delete are limited to the crate field roles.</p>
                </div>
            </div>
        </div>
    }

    <div class="crpod-card">
        <div class="crpod-list-header">
            <div class="crpod-list-heading">
                <i class="bi bi-list-task"></i>
                <span>Crate POD Uploads</span>
            </div>
            <span class="crpod-record-count">@filteredRows.Count records</span>
        </div>

        <div class="crpod-filter-grid">
            <div class="crpod-filter-field">
                <label class="crpod-label">Search</label>
                <input type="text" class="form-control crpod-input" @bind="PodHistorySearch" @bind:event="oninput"
                       placeholder="Invoice #, shop, file, or uploader" />
            </div>
            <div class="crpod-filter-field">
                <label class="crpod-label">Shop Code</label>
                <input type="text" class="form-control crpod-input" @bind="PodHistoryShopCode" @bind:event="oninput"
                       placeholder="e.g. SPA055" />
            </div>
            <div class="crpod-filter-field">
                <label class="crpod-label">Uploaded By</label>
                <input type="text" class="form-control crpod-input" @bind="PodHistoryUploadedBy" @bind:event="oninput"
                       placeholder="username" />
            </div>
            <div class="crpod-filter-field">
                <label class="crpod-label">Role</label>
                <select class="form-select crpod-input" @bind="PodHistoryRoleFilter">
                    <option value="all">All roles</option>
                    <option value="Driver">Driver</option>
                    <option value="Merchandiser">Merchandiser</option>
                </select>
            </div>
            <div class="crpod-filter-field">
                <label class="crpod-label">From Date</label>
                <input type="date" class="form-control crpod-input" @bind="PodHistoryFromDate" />
            </div>
            <div class="crpod-filter-field">
                <label class="crpod-label">To Date</label>
                <input type="date" class="form-control crpod-input" @bind="PodHistoryToDate" />
            </div>
            @if (HasPodHistoryFilters)
            {
                <div class="crpod-filter-field crpod-filter-field-action">
                    <button type="button" class="crpod-filter-clear" @onclick="ClearPodHistoryFilters">
                        <i class="bi bi-x-circle"></i>
                        <span>Clear</span>
                    </button>
                </div>
            }
        </div>

        @if (!filteredRows.Any())
        {
            <div class="crpod-empty-state">
                <i class="bi bi-inbox"></i>
                <span>No crate POD submissions match the current filters.</span>
            </div>
        }
        else
        {
            <div class="crpod-table-wrap">
                <table class="table mb-0 align-middle crpod-table crpod-history-table mobile-card-table">
                    <thead>
                        <tr>
                            <th>Invoice #</th>
                            <th>Shop</th>
                            <th>File</th>
                            <th>Notes</th>
                            <th class="text-end">Quantity</th>
                            <th>Size</th>
                            <th>Uploaded</th>
                            <th>By</th>
                            <th class="text-end">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var row in pagedRows)
                        {
                            var pod = row.Pod;
                            var attachment = row.Attachment;

                            <tr>
                                <td data-label="Invoice #">
                                    <span class="crpod-doc-badge">@(pod.InvoiceDocNum?.ToString() ?? $"TX {pod.CrateTransactionId}")</span>
                                </td>
                                <td data-label="Shop">
                                    <div class="crpod-table-primary">@(string.IsNullOrWhiteSpace(pod.ShopName) ? pod.ShopCardCode : pod.ShopName)</div>
                                    <div class="crpod-table-sub">@pod.ShopCardCode</div>
                                </td>
                                <td data-label="File">
                                    @if (attachment is null)
                                    {
                                        <div class="crpod-table-sub">No documents</div>
                                    }
                                    else
                                    {
                                        <div class="crpod-file-name">@attachment.FileName</div>
                                        <div class="crpod-table-sub">@(attachment.MimeType ?? "unknown type")</div>
                                    }
                                </td>
                                <td data-label="Notes" class="crpod-table-note-cell">@(string.IsNullOrWhiteSpace(pod.Notes) ? "-" : pod.Notes)</td>
                                <td data-label="Quantity" class="text-end fw-semibold">@pod.Quantity.ToString("N2")</td>
                                <td data-label="Size" class="crpod-size-cell">@(attachment?.FileSizeFormatted ?? "-")</td>
                                <td data-label="Uploaded">
                                    <div class="crpod-table-primary">@((attachment?.UploadedAt ?? pod.SubmittedAt).ToString("MMM dd, yyyy"))</div>
                                    <div class="crpod-table-sub">@((attachment?.UploadedAt ?? pod.SubmittedAt).ToString("HH:mm"))</div>
                                </td>
                                <td data-label="By">
                                    <div class="crpod-table-primary">@(pod.SubmittedByUserName ?? "Unknown user")</div>
                                    <div class="crpod-table-sub">
                                        <span class="crpod-role-badge @GetSubmissionRoleTone(pod.SubmissionRole)">@pod.SubmissionRole</span>
                                    </div>
                                </td>
                                <td data-label="Actions" class="text-end">
                                    <div class="crpod-actions">
                                        @if (attachment is not null && CanPreviewAttachment(attachment.MimeType))
                                        {
                                            <button type="button" class="crpod-action-btn crpod-action-view" title="View"
                                                    @onclick="() => ViewAttachmentAsync(attachment)">
                                                <i class="bi bi-eye"></i>
                                            </button>
                                        }
                                        @if (attachment is not null)
                                        {
                                            <button type="button" class="crpod-action-btn crpod-action-download" title="Download"
                                                    @onclick="() => DownloadAttachmentAsync(attachment)">
                                                <i class="bi bi-download"></i>
                                            </button>
                                        }
                                        @if (canDeleteCratePods)
                                        {
                                            <button type="button" class="crpod-action-btn crpod-action-delete" title="Delete"
                                                    @onclick="() => BeginDeleteAttachment(pod, attachment)">
                                                <i class="bi bi-trash"></i>
                                            </button>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <div class="crpod-pagination">
                <div class="crpod-pagination-info">
                    Showing @firstRowNumber-@lastRowNumber of @filteredRows.Count
                </div>
                <div class="crpod-pagination-controls">
                    <label class="crpod-pagination-size">
                        <span>Rows</span>
                        <select class="form-select crpod-input" @bind="PodHistoryPageSize">
                            @foreach (var size in CratePageSizeOptions)
                            {
                                <option value="@size">@size</option>
                            }
                        </select>
                    </label>
                    <div class="crpod-pagination-btns">
                        <button type="button" class="crpod-page-btn" title="First page"
                                disabled="@(currentPage <= 1)" @onclick="() => GoToPodHistoryPage(1)">
                            <i class="bi bi-chevron-double-left"></i>
                        </button>
                        <button type="button" class="crpod-page-btn" title="Previous page"
                                disabled="@(currentPage <= 1)" @onclick="() => GoToPodHistoryPage(currentPage - 1)">
                            <i class="bi bi-chevron-left"></i>
                        </button>
                        <span class="crpod-page-indicator">Page @currentPage of @totalPages</span>
                        <button type="button" class="crpod-page-btn" title="Next page"
                                disabled="@(currentPage >= totalPages)" @onclick="() => GoToPodHistoryPage(currentPage + 1)">
                            <i class="bi bi-chevron-right"></i>
                        </button>
                        <button type="button" class="crpod-page-btn" title="Last page"
                                disabled="@(currentPage >= totalPages)" @onclick="() => GoToPodHistoryPage(totalPages)">
                            <i class="bi bi-chevron-double-right"></i>
                        </button>
                    </div>
                </div>
            </div>
        }
    </div>
</div>

@if (showAttachmentViewer)
{
    <div class="crpod-modal-backdrop" @onclick="CloseAttachmentViewerAsync">
        <div class="crpod-modal crpod-modal-large" @onclick:stopPropagation="true">
            <div class="crpod-modal-header">
                <div>
                    <h4 class="crpod-modal-title">View Attachment</h4>
                    <p class="crpod-card-note mb-0">@attachmentViewerFileName</p>
                </div>
                <button type="button" class="crpod-modal-close" @onclick="CloseAttachmentViewerAsync">
                    <i class="bi bi-x-lg"></i>
                </button>
            </div>
            <div class="crpod-modal-body">
                @if (isLoadingAttachmentViewer)
                {
                    <div class="crpod-modal-state">Loading attachment...</div>
                }
                else if (!string.IsNullOrWhiteSpace(attachmentViewerUrl) && string.Equals(attachmentViewerMimeType, "application/pdf", StringComparison.OrdinalIgnoreCase))
                {
                    <iframe class="crpod-viewer-frame" src="@attachmentViewerUrl" title="@attachmentViewerFileName"></iframe>
                }
                else if (!string.IsNullOrWhiteSpace(attachmentViewerUrl) && attachmentViewerMimeType?.StartsWith("image/", StringComparison.OrdinalIgnoreCase) == true)
                {
                    <img class="crpod-viewer-image" src="@attachmentViewerUrl" alt="@attachmentViewerFileName" />
                }
                else
                {
                    <div class="crpod-modal-state">This attachment cannot be previewed inline. Use download instead.</div>
                }
            </div>
            <div class="crpod-modal-actions">
                <button type="button" class="crpod-secondary-btn" @onclick="CloseAttachmentViewerAsync">Close</button>
                @if (attachmentViewer is not null)
                {
                    <button type="button" class="crpod-primary-btn" @onclick='() => DownloadAttachmentAsync(attachmentViewer!)'>
                        <i class="bi bi-download"></i>
                        <span>Download</span>
                    </button>
                }
            </div>
        </div>
    </div>
}

@if (showDeleteAttachmentConfirm)
{
    <div class="crpod-modal-backdrop" @onclick="CancelDeleteAttachment">
        <div class="crpod-modal" @onclick:stopPropagation="true">
            <div class="crpod-modal-header">
                <div>
                    <h4 class="crpod-modal-title">Delete Crate POD</h4>
                    <p class="crpod-card-note mb-0">This permanently removes the selected crate POD submission and its supporting documents.</p>
                </div>
                <button type="button" class="crpod-modal-close" @onclick="CancelDeleteAttachment">
                    <i class="bi bi-x-lg"></i>
                </button>
            </div>
            <div class="crpod-modal-body">
                <p class="crpod-delete-copy">
                    Remove the @attachmentDeleteContext record@if (attachmentToDelete is not null)
                    {
                        <span> and delete <strong>@(attachmentToDelete?.FileName)</strong></span>
                    }?
                </p>
            </div>
            <div class="crpod-modal-actions">
                <button type="button" class="crpod-secondary-btn" @onclick="CancelDeleteAttachment" disabled="@isDeletingAttachment">Cancel</button>
                <button type="button" class="crpod-danger-btn" @onclick="DeletePodAsync" disabled="@isDeletingAttachment">
                    @(isDeletingAttachment ? "Deleting..." : "Delete record")
                </button>
            </div>
        </div>
    </div>
}

<CratePodStyles />