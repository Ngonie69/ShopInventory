@page "/invoices"
@page "/van-sales-invoices"
@using System.Text.Encodings.Web
@using System.Text
@using System.Text.Json
@using Microsoft.AspNetCore.Authorization
@using Microsoft.JSInterop
@using QRCoder
@using ShopInventory.Web.Models
@using ShopInventory.Web.Services
@attribute [Authorize(Roles = "Admin,Cashier")]
@inject IInvoiceService InvoiceService
@inject ICreditNoteService CreditNoteService
@inject NavigationManager NavigationManager
@inject IJSRuntime JS
@inject IAppSettingsProvider AppSettings
@inject IAuditService AuditService
@rendermode InteractiveServer

<PageTitle>@(IsVanSalesView ? "Van Sales Invoices" : "Invoices") - Shop Inventory</PageTitle>

@* Nocturne, carried by wwwroot/css/invoices.css (linked from App.razor) in both
   schemes, following the app's theme toggle like every other page. The palette
   and density scale are credit-notes.css's, unchanged, so this page and the
   credit notes it raises read as one system.

   Icon-only buttons draw their glyph inline rather than from the Phosphor font:
   the glyph is their whole label, so a font that fails to load would leave them
   reading as dead controls. *@

<div class="ivx">

    <header class="ivx-head">
        <div class="ivx-shell">
            <div class="ivx-titles">
                <div class="ivx-titles-row">
                    <i class="ph ph-receipt" aria-hidden="true"></i>
                    <h1 class="ivx-title">@(IsVanSalesView ? "Van Sales Invoices" : "Invoices")</h1>
                </div>
                <p class="ivx-sub">
                    @(IsVanSalesView
                        ? "Invoices generated by the sales-person van-sales flow"
                        : "View and manage web-created sales invoices")
                </p>
            </div>
            <div class="ivx-head-actions">
                <span class="ivx-count">@LoadedCount.ToString("N0") invoices</span>
                @if (!IsVanSalesView)
                {
                    <a class="ivx-btn ivx-btn-primary" href="/invoices/create">
                        <i class="ph ph-plus" aria-hidden="true"></i>Create invoice
                    </a>
                }
            </div>
        </div>
        <div class="ivx-rule"></div>
    </header>

    <div class="ivx-body">

        @if (!string.IsNullOrEmpty(errorMessage))
        {
            <div class="ivx-alert" role="alert">
                <i class="ph ph-warning-octagon" aria-hidden="true"></i>
                <div class="ivx-alert-body">@errorMessage</div>
                <button type="button" class="ivx-btn ivx-btn-ghost ivx-btn-icon-sm" title="Dismiss"
                        aria-label="Dismiss error" @onclick="() => errorMessage = null">
                    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"></path></svg>
                </button>
            </div>
        }
        @if (!string.IsNullOrEmpty(successMessage))
        {
            <div class="ivx-alert is-ok" role="status">
                <i class="ph ph-check-circle" aria-hidden="true"></i>
                <div class="ivx-alert-body">@successMessage</div>
                <button type="button" class="ivx-btn ivx-btn-ghost ivx-btn-icon-sm" title="Dismiss"
                        aria-label="Dismiss message" @onclick="() => successMessage = null">
                    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"></path></svg>
                </button>
            </div>
        }

        @if (HasLatestFiscalizationPayload)
        {
            <section class="ivx-payload">
                <div class="ivx-payload-head">
                    <div class="ivx-payload-titles">
                        <div class="ivx-payload-eyebrow">Most recent TransactM payload</div>
                        <h2 class="ivx-payload-title">Invoice #@(latestFiscalizationInvoiceNumber ?? "Unknown")</h2>
                        <p class="ivx-payload-sub">Captured from the last fiscalisation request sent from this page.</p>
                    </div>
                    <button type="button" class="ivx-btn ivx-btn-ghost ivx-btn-icon" title="Dismiss"
                            aria-label="Dismiss payload" @onclick="ClearLatestFiscalizationPayload">
                        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"></path></svg>
                    </button>
                </div>
                <div class="ivx-payload-grid">
                    <div>
                        <div class="ivx-payload-caption">Request JSON</div>
                        <pre class="ivx-code">@(latestFiscalizationRequestJson ?? "No raw request returned.")</pre>
                    </div>
                    <div>
                        <div class="ivx-payload-caption">Response JSON</div>
                        <pre class="ivx-code">@(latestFiscalizationResponseJson ?? "No raw response returned.")</pre>
                    </div>
                </div>
            </section>
        }

        @* Counted over what is loaded, not over the whole ledger — the labels say so. *@
        <section class="ivx-stats" aria-label="Invoice totals">
            <div class="ivx-stat">
                <span class="ivx-stat-mark" aria-hidden="true"><i class="ph ph-receipt"></i></span>
                <div>
                    <div class="ivx-stat-value">@LoadedCount.ToString("N0")</div>
                    <div class="ivx-stat-label">Invoices loaded</div>
                </div>
            </div>
            <div class="ivx-stat">
                <span class="ivx-stat-mark" aria-hidden="true"><i class="ph ph-coins"></i></span>
                <div>
                    <div class="ivx-stat-value">@((invoices?.Sum(i => i.DocTotal) ?? 0).ToString("N0"))</div>
                    <div class="ivx-stat-label">Total value</div>
                </div>
            </div>
            <div class="ivx-stat">
                <span class="ivx-stat-mark is-quiet" aria-hidden="true"><i class="ph ph-users-three"></i></span>
                <div>
                    <div class="ivx-stat-value">@(invoices?.Select(i => i.CardCode).Distinct().Count() ?? 0)</div>
                    <div class="ivx-stat-label">Unique customers</div>
                </div>
            </div>
            <div class="ivx-stat">
                <span class="ivx-stat-mark is-quiet" aria-hidden="true"><i class="ph ph-percent"></i></span>
                <div>
                    <div class="ivx-stat-value">@((invoices?.Sum(i => i.VatSum) ?? 0).ToString("N0"))</div>
                    <div class="ivx-stat-label">Total VAT</div>
                </div>
            </div>
        </section>

        <section class="ivx-filters">
            <div class="ivx-field" style="width:140px">
                <label for="ivx-f-doc">Doc number</label>
                <input id="ivx-f-doc" class="ivx-input ivx-input-num" type="number" placeholder="e.g. 123"
                       @bind="docNumSearch" @bind:event="oninput" @bind:after="OnDocNumChanged" />
            </div>
            <div class="ivx-field" style="width:180px">
                <label for="ivx-f-customer">Customer code</label>
                <input id="ivx-f-customer" class="ivx-input" type="text" placeholder="e.g. C001"
                       @bind="customerCode" @bind:event="oninput" @bind:after="OnCustomerCodeChanged" />
            </div>
            <div class="ivx-field" style="width:170px">
                <label for="ivx-f-fiscal">Fiscal status</label>
                <div class="ivx-select">
                    @* Refetches rather than filtering in place: the fiscal status is part of what
                       LoadInvoices counts as "filtered", and that widens the fetch from 100 rows to
                       5000. Narrowing the loaded 100 instead would quietly hide the rest. *@
                    <select id="ivx-f-fiscal" class="ivx-input" @bind="fiscalStatusFilter" @bind:after="ApplyFilter">
                        <option value="">All fiscal states</option>
                        <option value="Fiscalised">Fiscalised</option>
                        <option value="Not Fiscalised">Not Fiscalised</option>
                        <option value="Unknown">Unknown</option>
                    </select>
                    <span class="ivx-caret" aria-hidden="true"></span>
                </div>
            </div>
            <div class="ivx-field" style="width:140px">
                <label for="ivx-f-from">From date</label>
                <NocturneDateField Id="ivx-f-from" @bind-Date="fromDate" />
            </div>
            <div class="ivx-field" style="width:140px">
                <label for="ivx-f-to">To date</label>
                <NocturneDateField Id="ivx-f-to" @bind-Date="toDate" />
            </div>
            <div class="ivx-filter-actions">
                <button type="button" class="ivx-btn ivx-btn-ghost" @onclick="ClearFilter" disabled="@isLoading">
                    Clear
                </button>
                <button type="button" class="ivx-btn ivx-btn-secondary" @onclick="ApplyFilter" disabled="@isLoading">
                    <i class="ph ph-magnifying-glass" aria-hidden="true"></i>@(isLoading ? "Searching…" : "Search")
                </button>
            </div>
        </section>

        <section class="ivx-card">

            <div class="ivx-toolbar">
                <span class="ivx-range">@RangeLabel</span>
                <div class="ivx-quick">
                    <i class="ph ph-magnifying-glass" aria-hidden="true"></i>
                    <input class="ivx-input" type="search" placeholder="Quick filter…" aria-label="Quick filter"
                           @bind="_searchString" @bind:event="oninput" @bind:after="ResetToFirstPage" />
                </div>
            </div>

            <div class="ivx-tablewrap">
                <table class="ivx-table">
                    <thead>
                        <tr>
                            <th>Doc #</th>
                            <th>Customer</th>
                            <th>Date</th>
                            <th>Due date</th>
                            <th>Fiscal</th>
                            <th>Currency</th>
                            <th class="ivx-num">VAT</th>
                            <th class="ivx-num">Total</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (isLoading)
                        {
                            @for (var skeletonRow = 0; skeletonRow < 8; skeletonRow++)
                            {
                                <tr>
                                    @for (var skeletonCell = 0; skeletonCell < 9; skeletonCell++)
                                    {
                                        <td><div class="ivx-skel"></div></td>
                                    }
                                </tr>
                            }
                        }
                        else
                        {
                            @foreach (var invoice in PageRows)
                            {
                                <tr @key="invoice.DocEntry">
                                    <td>
                                        <button type="button" class="ivx-link" @onclick="() => ViewInvoice(invoice.DocEntry)">
                                            #@invoice.DocNum
                                        </button>
                                    </td>
                                    <td>
                                        <span class="ivx-cust">
                                            <span class="ivx-cust-name">@invoice.CardName</span>
                                            <span class="ivx-cust-code">@invoice.CardCode</span>
                                        </span>
                                    </td>
                                    <td class="ivx-date">@FormatDate(invoice.DocDate)</td>
                                    <td class="ivx-date">@FormatDate(invoice.DocDueDate)</td>
                                    <td>
                                        <span class="ivx-fiscal">
                                            <span class="ivx-dot @GetFiscalDotClass(invoice.FiscalizationStatus)" aria-hidden="true"></span>
                                            <span class="ivx-fiscal-text @GetFiscalTextClass(invoice.FiscalizationStatus)">
                                                @invoice.FiscalizationStatus
                                            </span>
                                        </span>
                                    </td>
                                    <td class="ivx-curr">@invoice.DocCurrency</td>
                                    <td class="ivx-num">@invoice.VatSum.ToString("N2")</td>
                                    <td class="ivx-num">@invoice.DocTotal.ToString("N2")</td>
                                    <td>
                                        <span class="ivx-rowactions">
                                            @if (CanFiscalize(invoice) || IsInvoiceFiscalizeBusy(invoice.DocEntry))
                                            {
                                                <button type="button" class="ivx-btn ivx-btn-secondary ivx-btn-sm"
                                                        disabled="@isFiscalizingInvoice"
                                                        @onclick="() => FiscalizeInvoiceAsync(invoice)">
                                                    @if (IsInvoiceFiscalizeBusy(invoice.DocEntry))
                                                    {
                                                        <span class="ivx-spin" aria-hidden="true"></span>
                                                        <span>Fiscalising…</span>
                                                    }
                                                    else
                                                    {
                                                        <span>Fiscalise</span>
                                                    }
                                                </button>
                                            }
                                            <button type="button" class="ivx-btn ivx-btn-ghost ivx-btn-icon-sm"
                                                    title="View invoice" aria-label="View invoice @invoice.DocNum"
                                                    @onclick="() => ViewInvoice(invoice.DocEntry)">
                                                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M2 12s3.6-6 10-6 10 6 10 6-3.6 6-10 6-10-6-10-6z"></path><circle cx="12" cy="12" r="2.6"></circle></svg>
                                            </button>
                                        </span>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>

            @if (!isLoading && FilteredCount == 0)
            {
                <div class="ivx-empty">
                    <i class="ph ph-funnel-simple" aria-hidden="true"></i>
                    <span>No invoices found</span>
                    <span class="ivx-empty-sub">No invoices match your filters. Try widening the dates or clearing the search.</span>
                    @if (!IsVanSalesView)
                    {
                        <a class="ivx-btn ivx-btn-primary" href="/invoices/create">
                            <i class="ph ph-plus" aria-hidden="true"></i>Create invoice
                        </a>
                    }
                </div>
            }

            <div class="ivx-foot">
                <span class="ivx-foot-range">@RangeLabel</span>
                <span class="ivx-pagesize">
                    <span>Rows</span>
                    <span class="ivx-select">
                        <select class="ivx-input" aria-label="Rows per page" @bind="_pageSize" @bind:after="ResetToFirstPage">
                            @foreach (var size in PageSizeOptions)
                            {
                                <option value="@size">@size</option>
                            }
                        </select>
                        <span class="ivx-caret" aria-hidden="true"></span>
                    </span>
                </span>
                <div class="ivx-pager">
                    <button type="button" class="ivx-btn ivx-btn-secondary ivx-btn-icon" title="Previous page"
                            aria-label="Previous page" disabled="@(displayPage <= 1)"
                            @onclick="() => GoToDisplayPage(displayPage - 1)">
                        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M15 6l-6 6 6 6"></path></svg>
                    </button>
                    <span class="ivx-page-label">Page @displayPage / @DisplayPageCount</span>
                    <button type="button" class="ivx-btn ivx-btn-secondary ivx-btn-icon" title="Next page"
                            aria-label="Next page" disabled="@(displayPage >= DisplayPageCount)"
                            @onclick="() => GoToDisplayPage(displayPage + 1)">
                        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 6l6 6-6 6"></path></svg>
                    </button>
                </div>
            </div>
        </section>
    </div>
</div>

@if (selectedInvoice != null && !showCreateCreditNoteModal && !showExistingCreditNotesModal)
{
    var fiscalQrCodeImageSrc = BuildFiscalQrCodeImageSrc(selectedInvoice.FiscalQrCode);
    <div class="ivx-overlay">
        <div class="ivx-scrim" @onclick="CloseModal"></div>
        <aside class="ivx-drawer" aria-label="Invoice detail">
            <div class="ivx-drawer-head">
                <h2 class="ivx-drawer-title">
                    <i class="ph ph-receipt" aria-hidden="true"></i>Invoice #@selectedInvoice.DocNum
                </h2>
                <button type="button" class="ivx-btn ivx-btn-ghost ivx-btn-icon" title="Close"
                        aria-label="Close details" @onclick="CloseModal">
                    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"></path></svg>
                </button>
            </div>
            <div class="ivx-drawer-body">

                @if (existingCreditNotes?.HasExistingCreditNotes == true)
                {
                    <div class="ivx-credited">
                        <i class="ph ph-warning" aria-hidden="true"></i>
                        <div>
                            <strong>@GetActiveCreditNoteCount() credit note(s)</strong> totalling
                            <strong>@GetActiveCreditedAmount().ToString("N2") @selectedInvoice.DocCurrency</strong>
                            already exist for this invoice.
                            @if (IsSelectedInvoiceFullyCredited())
                            {
                                <span>It has been fully credited, so new credit notes are disabled.</span>
                            }
                            <button type="button" class="ivx-btn ivx-btn-ghost ivx-btn-sm" @onclick="ShowExistingCreditNotes">
                                View details
                            </button>
                        </div>
                    </div>
                }

                <div class="ivx-grid">
                    <div>
                        <div class="ivx-dt">Customer</div>
                        <div class="ivx-dd">@selectedInvoice.CardName</div>
                    </div>
                    <div>
                        <div class="ivx-dt">Customer code</div>
                        <div class="ivx-dd">@selectedInvoice.CardCode</div>
                    </div>
                    <div>
                        <div class="ivx-dt">Document date</div>
                        <div class="ivx-dd">@FormatDate(selectedInvoice.DocDate)</div>
                    </div>
                    <div>
                        <div class="ivx-dt">Due date</div>
                        <div class="ivx-dd">@FormatDate(selectedInvoice.DocDueDate)</div>
                    </div>
                    <div>
                        <div class="ivx-dt">Doc entry</div>
                        <div class="ivx-dd">@selectedInvoice.DocEntry</div>
                    </div>
                    <div>
                        <div class="ivx-dt">Currency</div>
                        <div class="ivx-dd">@selectedInvoice.DocCurrency</div>
                    </div>
                    <div>
                        <div class="ivx-dt">Fiscal status</div>
                        <div class="ivx-dd">
                            <span class="ivx-fiscal">
                                <span class="ivx-dot @GetFiscalDotClass(selectedInvoice.FiscalizationStatus)" aria-hidden="true"></span>
                                <span class="ivx-fiscal-text @GetFiscalTextClass(selectedInvoice.FiscalizationStatus)">
                                    @selectedInvoice.FiscalizationStatus
                                </span>
                            </span>
                        </div>
                    </div>
                    @if (selectedInvoice.FiscalReceiptGlobalNo.HasValue)
                    {
                        <div>
                            <div class="ivx-dt">Fiscal receipt #</div>
                            <div class="ivx-dd">@selectedInvoice.FiscalReceiptGlobalNo</div>
                        </div>
                    }
                    @if (!string.IsNullOrEmpty(selectedInvoice.NumAtCard))
                    {
                        <div>
                            <div class="ivx-dt">Reference</div>
                            <div class="ivx-dd">@selectedInvoice.NumAtCard</div>
                        </div>
                    }
                </div>

                @if (!string.IsNullOrEmpty(selectedInvoice.Comments))
                {
                    <div>
                        <div class="ivx-sect"><i class="ph ph-chat-text" aria-hidden="true"></i>Comments</div>
                        <div class="ivx-note is-prose">@selectedInvoice.Comments</div>
                    </div>
                }

                @if (!string.IsNullOrWhiteSpace(fiscalQrCodeImageSrc))
                {
                    <div class="ivx-qr">
                        <div class="ivx-qr-plate">
                            <img src="@fiscalQrCodeImageSrc" alt="REVMax fiscal QR code" />
                        </div>
                        <div class="ivx-qr-copy">
                            <div class="ivx-dt">REVMax QR code</div>
                            <div class="ivx-qr-title">Scan to verify this fiscal receipt</div>
                            <p>
                                The same code is used for this preview, the downloaded PDF and the print
                                output for invoice #@selectedInvoice.DocNum.
                            </p>
                        </div>
                    </div>
                }

                @if (selectedInvoice.Lines?.Any() == true)
                {
                    <div>
                        <div class="ivx-sect"><i class="ph ph-list-bullets" aria-hidden="true"></i>Invoice lines</div>
                        <div class="ivx-linescroll">
                            <table class="ivx-lines">
                                <thead>
                                    <tr>
                                        <th>#</th>
                                        <th>Item</th>
                                        <th>Description</th>
                                        <th>Warehouse</th>
                                        <th class="ivx-num">Qty</th>
                                        <th class="ivx-num">Price</th>
                                        <th class="ivx-num">Disc %</th>
                                        <th class="ivx-num">Total</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var line in selectedInvoice.Lines)
                                    {
                                        <tr>
                                            <td>@line.LineNum</td>
                                            <td><span class="ivx-cust-name">@line.ItemCode</span></td>
                                            <td>@line.ItemDescription</td>
                                            <td>@line.WarehouseCode</td>
                                            <td class="ivx-num">@QuantityDisplay.Format(line.Quantity, line.UoMCode)</td>
                                            <td class="ivx-num">@line.UnitPrice.ToString("N2")</td>
                                            @* Up to six decimals so a special-price discount reads the same here as in
                                               SAP (5.714286%), without the trailing zeros a six-scale decimal prints raw *@
                                            <td class="ivx-num">@line.DiscountPercent.ToString("0.0####")%</td>
                                            <td class="ivx-num">@line.LineTotal.ToString("N2")</td>
                                        </tr>
                                    }
                                </tbody>
                                <tfoot>
                                    <tr>
                                        <td colspan="7" class="ivx-num">VAT</td>
                                        <td class="ivx-num">@selectedInvoice.VatSum.ToString("N2")</td>
                                    </tr>
                                </tfoot>
                            </table>
                        </div>
                    </div>
                }

                <div class="ivx-total">
                    <span class="ivx-total-label">Invoice total</span>
                    <span class="ivx-total-value">@selectedInvoice.DocCurrency @selectedInvoice.DocTotal.ToString("N2")</span>
                </div>
            </div>
            <div class="ivx-drawer-foot">
                <button type="button" class="ivx-btn ivx-btn-secondary" disabled="@isPdfLoading" @onclick="DownloadInvoicePdf">
                    @if (isPdfLoading)
                    {
                        <span class="ivx-spin" aria-hidden="true"></span>
                        <span>Preparing…</span>
                    }
                    else
                    {
                        <span>Download PDF</span>
                    }
                </button>
                <button type="button" class="ivx-btn ivx-btn-secondary" disabled="@isPdfLoading" @onclick="PrintInvoicePdf">
                    Print
                </button>
                <button type="button" class="ivx-btn ivx-btn-primary" @onclick="OpenCreateCreditNoteModal"
                        disabled="@IsSelectedInvoiceFullyCredited()">
                    @(IsSelectedInvoiceFullyCredited() ? "Fully credited" : "Create credit note")
                </button>
                <button type="button" class="ivx-btn ivx-btn-secondary" @onclick="CloseModal">Close</button>
            </div>
        </aside>
    </div>
}

@if (showExistingCreditNotesModal && existingCreditNotes != null)
{
    <div class="ivx-overlay">
        <div class="ivx-dialog-wrap" @onclick="() => showExistingCreditNotesModal = false">
            <div class="ivx-dialog is-wide" role="dialog" aria-modal="true" aria-labelledby="ivx-cnlist-title"
                 @onclick:stopPropagation="true">
                <div class="ivx-dialog-head">
                    <h2 class="ivx-dialog-title" id="ivx-cnlist-title">
                        <i class="ph ph-file-minus" aria-hidden="true"></i>
                        Credit notes — invoice #@selectedInvoice?.DocNum
                    </h2>
                    <button type="button" class="ivx-btn ivx-btn-ghost ivx-btn-icon" title="Close" aria-label="Close"
                            @onclick="() => showExistingCreditNotesModal = false">
                        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"></path></svg>
                    </button>
                </div>
                <div class="ivx-dialog-body">
                    <div class="ivx-note">
                        <span class="ivx-dt">Active total credited</span>
                        @GetActiveCreditedAmount().ToString("N2") @selectedInvoice?.DocCurrency
                    </div>
                    <div class="ivx-linescroll">
                        <table class="ivx-lines">
                            <thead>
                                <tr>
                                    <th>Credit note #</th>
                                    <th>Date</th>
                                    <th>Type</th>
                                    <th>Status</th>
                                    <th>Reason</th>
                                    <th class="ivx-num">Amount</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var creditNote in existingCreditNotes.CreditNotes)
                                {
                                    <tr>
                                        <td><span class="ivx-cust-name">@creditNote.CreditNoteNumber</span></td>
                                        <td class="ivx-date">@creditNote.CreditNoteDate.ToString("dd MMM yyyy")</td>
                                        <td><span class="ivx-tag">@creditNote.TypeName</span></td>
                                        <td>
                                            <span class="ivx-fiscal">
                                                <span class="ivx-dot @GetCreditNoteDotClass(creditNote.Status)" aria-hidden="true"></span>
                                                <span class="ivx-fiscal-text">@creditNote.StatusName</span>
                                            </span>
                                        </td>
                                        <td>@TruncateText(creditNote.Reason, 30)</td>
                                        <td class="ivx-num">@creditNote.DocTotal.ToString("N2")</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
                <div class="ivx-dialog-actions">
                    <button type="button" class="ivx-btn ivx-btn-secondary"
                            @onclick="() => showExistingCreditNotesModal = false">Close</button>
                </div>
            </div>
        </div>
    </div>
}

@if (showCreateCreditNoteModal && selectedInvoice != null)
{
    <div class="ivx-overlay">
        <div class="ivx-dialog-wrap">
            <div class="ivx-dialog is-wide" role="dialog" aria-modal="true" aria-labelledby="ivx-cnnew-title"
                 @onclick:stopPropagation="true">

                @if (isCreatingCreditNote)
                {
                    @* The percentage is paced by SimulateSapProgressAsync, not reported by SAP —
                       it is a "something is happening" signal for a call that can take a while. *@
                    <div class="ivx-posting" aria-live="polite">
                        <div class="ivx-ring">
                            <svg viewBox="0 0 100 100" aria-hidden="true">
                                <circle class="ivx-ring-track" cx="50" cy="50" r="42" />
                                <circle class="ivx-ring-fill" cx="50" cy="50" r="42"
                                        stroke-dasharray="@($"{264 * creditNoteProgress / 100} 264")" />
                            </svg>
                            <span class="ivx-ring-label">@creditNoteProgress%</span>
                        </div>
                        <h3>Posting to SAP</h3>
                        <p>@creditNoteProgressMessage</p>
                        <small>Please keep this window open while the credit note is created.</small>
                    </div>
                }

                <div class="ivx-dialog-head">
                    <h2 class="ivx-dialog-title" id="ivx-cnnew-title">
                        <i class="ph ph-file-minus" aria-hidden="true"></i>
                        Create credit note — invoice #@selectedInvoice.DocNum
                    </h2>
                    <button type="button" class="ivx-btn ivx-btn-ghost ivx-btn-icon" title="Close" aria-label="Close"
                            disabled="@isCreatingCreditNote" @onclick="() => showCreateCreditNoteModal = false">
                        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"></path></svg>
                    </button>
                </div>
                <div class="ivx-dialog-body">
                    @if (existingCreditNotes?.HasExistingCreditNotes == true)
                    {
                        <div class="ivx-note is-warn">
                            This invoice already has @GetActiveCreditNoteCount() active credit note(s) totalling
                            @GetActiveCreditedAmount().ToString("N2") @selectedInvoice.DocCurrency. Remaining creditable
                            amount: @GetRemainingCreditableAmount().ToString("N2") @selectedInvoice.DocCurrency.
                        </div>
                    }

                    <div class="ivx-field">
                        <label for="ivx-cn-reason">Reason for credit note *</label>
                        <textarea id="ivx-cn-reason" class="ivx-input ivx-textarea" @bind="creditNoteReason"
                                  placeholder="Enter the reason for creating this credit note…"
                                  disabled="@isCreatingCreditNote"></textarea>
                    </div>

                    <div>
                        <div class="ivx-sect"><i class="ph ph-list-checks" aria-hidden="true"></i>Select items to credit</div>
                        <div class="ivx-linescroll">
                            <table class="ivx-cnlines">
                                <thead>
                                    <tr>
                                        <th style="width:34px">
                                            <input class="ivx-check" type="checkbox" title="Select all lines"
                                                   aria-label="Select all lines" @bind="selectAllLines"
                                                   @bind:after="ToggleAllLines" disabled="@isCreatingCreditNote" />
                                        </th>
                                        <th>Item</th>
                                        <th>Description</th>
                                        <th class="ivx-num">Qty</th>
                                        <th class="ivx-num">Credit qty</th>
                                        <th class="ivx-num">Price</th>
                                        <th class="ivx-num">Total</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @if (creditNoteLines != null)
                                    {
                                        @foreach (var line in creditNoteLines)
                                        {
                                            <tr class="@(line.IsSelected ? null : "is-off")">
                                                <td>
                                                    <input class="ivx-check" type="checkbox"
                                                           aria-label="Credit @line.ItemCode" @bind="line.IsSelected"
                                                           disabled="@isCreatingCreditNote" />
                                                </td>
                                                <td><span class="ivx-cust-name">@line.ItemCode</span></td>
                                                <td>@line.ItemDescription</td>
                                                <td class="ivx-num">@line.OriginalQuantity</td>
                                                <td class="ivx-num">
                                                    <input class="ivx-input ivx-qty" type="number" min="0"
                                                           max="@line.OriginalQuantity" step="0.01"
                                                           aria-label="Credit quantity for @line.ItemCode"
                                                           @bind="line.CreditQuantity"
                                                           disabled="@(!line.IsSelected || isCreatingCreditNote)" />
                                                </td>
                                                <td class="ivx-num">@line.UnitPrice.ToString("N2")</td>
                                                <td class="ivx-num">
                                                    @((line.IsSelected ? line.CreditQuantity * line.UnitPrice : 0).ToString("N2"))
                                                </td>
                                            </tr>
                                        }
                                    }
                                </tbody>
                                <tfoot>
                                    <tr>
                                        <td colspan="6" class="ivx-num">Credit note total</td>
                                        <td class="ivx-num">@CalculateCreditNoteTotal().ToString("N2")</td>
                                    </tr>
                                </tfoot>
                            </table>
                        </div>
                    </div>
                </div>
                <div class="ivx-dialog-actions">
                    <button type="button" class="ivx-btn ivx-btn-secondary" disabled="@isCreatingCreditNote"
                            @onclick="() => showCreateCreditNoteModal = false">Cancel</button>
                    <button type="button" class="ivx-btn ivx-btn-primary" @onclick="CreateCreditNote"
                            disabled="@(isCreatingCreditNote || string.IsNullOrWhiteSpace(creditNoteReason) || !HasSelectedLines())">
                        @if (isCreatingCreditNote)
                        {
                            <span class="ivx-spin" aria-hidden="true"></span>
                            <span>Posting…</span>
                        }
                        else
                        {
                            <span>Create credit note</span>
                        }
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@if (!string.IsNullOrEmpty(creditNoteMessage))
{
    <div class="ivx-overlay">
        <div class="ivx-toast @(creditNoteSuccess ? null : "is-bad")" role="status">
            <i class="ph @(creditNoteSuccess ? "ph-check-circle" : "ph-warning-octagon")" aria-hidden="true"></i>
            <div class="ivx-toast-body">@creditNoteMessage</div>
            <button type="button" class="ivx-btn ivx-btn-ghost ivx-btn-icon-sm" title="Dismiss"
                    aria-label="Dismiss message" @onclick="() => creditNoteMessage = null">
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"></path></svg>
            </button>
        </div>
    </div>
}

@code {
    private static readonly int[] PageSizeOptions = [10, 25, 50, 100, 200];

    private bool IsVanSalesView => NavigationManager.ToBaseRelativePath(NavigationManager.Uri)
        .StartsWith("van-sales-invoices", StringComparison.OrdinalIgnoreCase);

    private int _pageSize = 10;
    private List<InvoiceDto>? invoices;
    private List<InvoiceDto>? allInvoices;
    private InvoiceDto? selectedInvoice;
    private bool isLoading = true;
    private bool isFiscalizingInvoice;
    private int? fiscalizingInvoiceDocEntry;
    private string? errorMessage;
    private string? successMessage;
    private string? latestFiscalizationInvoiceNumber;
    private string? latestFiscalizationRequestJson;
    private string? latestFiscalizationResponseJson;

    // The fetch pulls one large page and the pager below works over it in the browser,
    // which is what the 100/5000 fetch sizes in LoadInvoices are sized for.
    private int currentPage = 1;
    private int displayPage = 1;
    private string _searchString = string.Empty;

    private int? docNumSearch;
    private string? customerCode;
    private string? fiscalStatusFilter;
    private DateTime? fromDate;
    private DateTime? toDate;

    private CancellationTokenSource? _debounceTokenSource;
    private const int DebounceDelayMs = 300;
    private static readonly JsonSerializerOptions FiscalJsonOptions = new()
    {
        Encoder = JavaScriptEncoder.UnsafeRelaxedJsonEscaping,
        WriteIndented = true
    };

    // PDF state
    private bool isPdfLoading = false;

    // Credit Note state
    private CreditNotesByInvoiceResponse? existingCreditNotes;
    private bool showExistingCreditNotesModal = false;
    private bool showCreateCreditNoteModal = false;
    private bool isCreatingCreditNote = false;
    private string? creditNoteReason;
    // Stable idempotency key for the open credit-note modal; minted when the modal opens and reused
    // across retries so a lost-response retry is deduplicated instead of posting a duplicate credit note.
    private string? creditNoteClientRequestId;
    private List<CreditNoteLineSelection>? creditNoteLines;
    private bool selectAllLines = false;
    private string? creditNoteMessage;
    private bool creditNoteSuccess = false;
    private int creditNoteProgress = 0;
    private string creditNoteProgressMessage = "Initializing...";
    private CancellationTokenSource? _progressCancellationTokenSource;

    private int LoadedCount => invoices?.Count ?? 0;

    /// <summary>
    /// The quick filter narrows what is already loaded — it never refetches, which is why it
    /// lives on the table's own toolbar rather than in the filter row.
    /// </summary>
    private IEnumerable<InvoiceDto> FilteredInvoices
    {
        get
        {
            if (invoices is null)
                return [];

            if (string.IsNullOrWhiteSpace(_searchString))
                return invoices;

            var search = _searchString.Trim();
            return invoices.Where(invoice =>
                invoice.DocNum.ToString().Contains(search, StringComparison.OrdinalIgnoreCase)
                || invoice.CardCode?.Contains(search, StringComparison.OrdinalIgnoreCase) == true
                || invoice.CardName?.Contains(search, StringComparison.OrdinalIgnoreCase) == true
                || invoice.DocCurrency?.Contains(search, StringComparison.OrdinalIgnoreCase) == true
                || invoice.FiscalizationStatus?.Contains(search, StringComparison.OrdinalIgnoreCase) == true
                || $"{invoice.DocEntry} {invoice.DocTotal}".Contains(search));
        }
    }

    private int FilteredCount => FilteredInvoices.Count();

    private int DisplayPageCount => Math.Max(1, (FilteredCount + _pageSize - 1) / _pageSize);

    private IEnumerable<InvoiceDto> PageRows
        => FilteredInvoices.Skip((displayPage - 1) * _pageSize).Take(_pageSize);

    private string RangeLabel
    {
        get
        {
            if (isLoading && invoices is null)
                return "Loading…";

            var count = FilteredCount;
            if (count == 0)
                return "No invoices";

            var first = ((displayPage - 1) * _pageSize) + 1;
            var last = Math.Min(displayPage * _pageSize, count);
            return $"{first:N0}–{last:N0} of {count:N0} invoices";
        }
    }

    protected override async Task OnInitializedAsync()
    {
        _pageSize = AppSettings.PageSize;
        await LoadInvoices();
        await AuditService.LogAsync(AuditActions.ViewInvoices, "Invoice", null);
    }

    private void ResetToFirstPage() => displayPage = 1;

    private void GoToDisplayPage(int page)
    {
        if (page >= 1 && page <= DisplayPageCount)
        {
            displayPage = page;
        }
    }

    private string FormatDate(string? dateStr)
    {
        if (string.IsNullOrEmpty(dateStr)) return "—";
        if (DateTime.TryParse(dateStr, out var date))
            return date.ToString("dd MMM yyyy");
        return dateStr;
    }

    private async Task LoadInvoices()
    {
        isLoading = true;
        errorMessage = null;

        try
        {
            var hasFilters = docNumSearch.HasValue
                || !string.IsNullOrWhiteSpace(customerCode)
                || !string.IsNullOrWhiteSpace(fiscalStatusFilter)
                || fromDate.HasValue
                || toDate.HasValue;
            var effectivePageSize = hasFilters ? 5000 : 100;

            var response = await InvoiceService.GetInvoicesAsync(
                currentPage,
                effectivePageSize,
                docNumSearch,
                customerCode,
                fromDate,
                toDate,
                IsVanSalesView);
            if (response != null)
            {
                var loadedInvoices = response.Invoices ?? new List<InvoiceDto>();
                allInvoices = loadedInvoices;
                invoices = ApplyFiscalStatusFilter(loadedInvoices);
            }
            else
            {
                errorMessage = "Failed to load invoices. Check if the API is running.";
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Error: {ex.Message}";
        }
        finally
        {
            isLoading = false;
            // The set changed underneath the display pager, so start it over.
            displayPage = 1;
        }
    }

    private async Task OnDocNumChanged()
    {
        _debounceTokenSource?.Cancel();
        _debounceTokenSource = new CancellationTokenSource();
        try
        {
            await Task.Delay(DebounceDelayMs, _debounceTokenSource.Token);
            await FilterByDocNum();
        }
        catch (TaskCanceledException) { }
    }

    private async Task OnCustomerCodeChanged()
    {
        _debounceTokenSource?.Cancel();
        _debounceTokenSource = new CancellationTokenSource();
        try
        {
            await Task.Delay(DebounceDelayMs, _debounceTokenSource.Token);
            await FilterByCustomerCode();
        }
        catch (TaskCanceledException) { }
    }

    private async Task FilterByDocNum()
    {
        if (!docNumSearch.HasValue || docNumSearch.Value == 0)
        {
            if (string.IsNullOrWhiteSpace(customerCode))
            {
                docNumSearch = null;
                await LoadInvoices();
                StateHasChanged();
            }
            return;
        }

        currentPage = 1;
        await LoadInvoices();
        StateHasChanged();
    }

    private async Task FilterByCustomerCode()
    {
        if (string.IsNullOrWhiteSpace(customerCode))
        {
            if (!docNumSearch.HasValue)
            {
                customerCode = null;
                await LoadInvoices();
                StateHasChanged();
            }
            return;
        }

        currentPage = 1;
        await LoadInvoices();
        StateHasChanged();
    }

    private async Task ApplyFilter()
    {
        currentPage = 1;
        await LoadInvoices();
    }

    private async Task ClearFilter()
    {
        docNumSearch = null;
        customerCode = null;
        fiscalStatusFilter = null;
        fromDate = null;
        toDate = null;
        _searchString = string.Empty;
        currentPage = 1;
        allInvoices = null;
        await LoadInvoices();
    }

    /// <summary>
    /// The API does not take the fiscal status as a parameter — it is applied to whatever the fetch
    /// returned. LoadInvoices still counts it as a filter, which is what widens the fetch from 100
    /// rows to 5000 so there is enough to filter over.
    /// </summary>
    private List<InvoiceDto> ApplyFiscalStatusFilter(IEnumerable<InvoiceDto> source)
    {
        if (string.IsNullOrWhiteSpace(fiscalStatusFilter))
        {
            return source.ToList();
        }

        return source
            .Where(invoice => MatchesFiscalStatus(invoice.FiscalizationStatus, fiscalStatusFilter))
            .ToList();
    }

    private static bool MatchesFiscalStatus(string? actualStatus, string? filterStatus)
        => NormalizeFiscalStatus(actualStatus) == NormalizeFiscalStatus(filterStatus);

    private static string NormalizeFiscalStatus(string? status)
        => status?.Trim().ToLowerInvariant() switch
        {
            "fiscalised" => "fiscalised",
            "not fiscalised" => "not fiscalised",
            _ => "unknown"
        };

    private static bool CanFiscalize(InvoiceDto? invoice)
        => invoice is { DocEntry: > 0 }
           && NormalizeFiscalStatus(invoice.FiscalizationStatus) != "fiscalised";

    private bool IsInvoiceFiscalizeBusy(int docEntry)
        => isFiscalizingInvoice && fiscalizingInvoiceDocEntry == docEntry;

    private async Task ViewInvoice(int docEntry)
    {
        selectedInvoice = await InvoiceService.GetInvoiceByDocEntryAsync(docEntry);
        if (selectedInvoice != null)
        {
            existingCreditNotes = await CreditNoteService.GetCreditNotesForInvoiceAsync(docEntry);
            await AuditService.LogAsync(AuditActions.ViewInvoice, "Invoice", docEntry.ToString());
        }
    }

    private async Task FiscalizeInvoiceAsync(InvoiceDto invoice)
    {
        if (invoice == null || isFiscalizingInvoice)
        {
            return;
        }

        var docEntry = invoice.DocEntry;
        var docNum = invoice.DocNum;

        isFiscalizingInvoice = true;
        fiscalizingInvoiceDocEntry = docEntry;
        errorMessage = null;
        successMessage = null;
        ClearLatestFiscalizationPayload();

        try
        {
            var result = await InvoiceService.FiscalizeInvoiceAsync(docEntry);
            CaptureFiscalizationPayload(docNum.ToString(), result);
            if (result.Success || result.Skipped)
            {
                var refreshedInvoice = await InvoiceService.GetInvoiceByDocEntryAsync(docEntry);
                if (refreshedInvoice != null)
                {
                    if (selectedInvoice?.DocEntry == docEntry)
                    {
                        selectedInvoice = refreshedInvoice;
                    }

                    UpsertInvoice(refreshedInvoice);
                }
                else
                {
                    await LoadInvoices();
                }

                successMessage = result.Message ?? $"Invoice #{docNum} fiscalised successfully.";
                await AuditService.LogAsync(
                    AuditActions.FiscalizeInvoice,
                    "Invoice",
                    docEntry.ToString(),
                    successMessage,
                    true);
            }
            else
            {
                errorMessage = result.Message ?? $"Failed to fiscalise invoice #{docNum}.";
                await AuditService.LogAsync(
                    AuditActions.FiscalizeInvoice,
                    "Invoice",
                    docEntry.ToString(),
                    errorMessage,
                    false,
                    errorMessage);
            }
        }
        catch (Exception ex)
        {
            errorMessage = ApiErrorResponse.GetFriendlyMessage(ex, $"Failed to fiscalise invoice #{docNum}.");
            await AuditService.LogAsync(
                AuditActions.FiscalizeInvoice,
                "Invoice",
                docEntry.ToString(),
                errorMessage,
                false,
                errorMessage);
        }
        finally
        {
            isFiscalizingInvoice = false;
            fiscalizingInvoiceDocEntry = null;
        }
    }

    private void UpsertInvoice(InvoiceDto updatedInvoice)
    {
        if (allInvoices != null)
        {
            var existingIndex = allInvoices.FindIndex(invoice => invoice.DocEntry == updatedInvoice.DocEntry);
            if (existingIndex >= 0)
            {
                allInvoices[existingIndex] = updatedInvoice;
            }
        }

        invoices = ApplyFiscalStatusFilter(allInvoices ?? new List<InvoiceDto>());
    }

    private bool HasLatestFiscalizationPayload
        => !string.IsNullOrWhiteSpace(latestFiscalizationRequestJson)
           || !string.IsNullOrWhiteSpace(latestFiscalizationResponseJson);

    private void CaptureFiscalizationPayload(string fallbackInvoiceNumber, FiscalizationResult? result)
    {
        if (result == null)
        {
            return;
        }

        latestFiscalizationInvoiceNumber = string.IsNullOrWhiteSpace(result.InvoiceNumber)
            ? fallbackInvoiceNumber
            : result.InvoiceNumber;
        latestFiscalizationRequestJson = PrettyPrintJson(result.RawRequestJson);
        latestFiscalizationResponseJson = PrettyPrintJson(result.RawResponseJson);
    }

    private void ClearLatestFiscalizationPayload()
    {
        latestFiscalizationInvoiceNumber = null;
        latestFiscalizationRequestJson = null;
        latestFiscalizationResponseJson = null;
    }

    private static string? PrettyPrintJson(string? value)
    {
        if (string.IsNullOrWhiteSpace(value))
        {
            return null;
        }

        try
        {
            using var document = JsonDocument.Parse(value);
            return JsonSerializer.Serialize(document.RootElement, FiscalJsonOptions);
        }
        catch (JsonException)
        {
            return value;
        }
    }

    private void CloseModal()
    {
        selectedInvoice = null;
        existingCreditNotes = null;
        showExistingCreditNotesModal = false;
        showCreateCreditNoteModal = false;
        creditNoteReason = null;
        creditNoteLines = null;
    }

    private async Task DownloadInvoicePdf()
    {
        if (selectedInvoice == null || isPdfLoading) return;
        isPdfLoading = true;
        try
        {
            var pdfBytes = await InvoiceService.GetInvoicePdfAsync(selectedInvoice.DocEntry, selectedInvoice.FiscalQrCode);
            if (pdfBytes == null || pdfBytes.Length == 0)
            {
                errorMessage = "Failed to retrieve invoice PDF.";
                return;
            }
            var base64 = Convert.ToBase64String(pdfBytes);
            var fileName = $"Invoice_{selectedInvoice.DocNum}.pdf";
            await JS.InvokeVoidAsync("downloadPdfFromBase64", base64, fileName);
            await AuditService.LogAsync(AuditActions.DownloadInvoicePdf, "Invoice", selectedInvoice.DocNum.ToString());
        }
        catch (Exception ex)
        {
            errorMessage = $"Download failed: {ex.Message}";
        }
        finally
        {
            isPdfLoading = false;
        }
    }

    private async Task PrintInvoicePdf()
    {
        if (selectedInvoice == null || isPdfLoading) return;
        isPdfLoading = true;
        try
        {
            var pdfBytes = await InvoiceService.GetInvoicePdfAsync(selectedInvoice.DocEntry, selectedInvoice.FiscalQrCode);
            if (pdfBytes == null || pdfBytes.Length == 0)
            {
                errorMessage = "Failed to retrieve invoice PDF for printing.";
                return;
            }
            var base64 = Convert.ToBase64String(pdfBytes);
            await JS.InvokeVoidAsync("printPdfFromBase64", base64);
            await AuditService.LogAsync(AuditActions.PrintInvoicePdf, "Invoice", selectedInvoice.DocNum.ToString());
        }
        catch (Exception ex)
        {
            errorMessage = $"Print failed: {ex.Message}";
        }
        finally
        {
            isPdfLoading = false;
        }
    }

    private static string? BuildFiscalQrCodeImageSrc(string? fiscalQrCode)
    {
        if (string.IsNullOrWhiteSpace(fiscalQrCode))
        {
            return null;
        }

        try
        {
            using var generator = new QRCodeGenerator();
            using var data = generator.CreateQrCode(fiscalQrCode.Trim(), QRCodeGenerator.ECCLevel.Q);
            var qrCode = new SvgQRCode(data);
            var svg = qrCode.GetGraphic(8);
            var bytes = Encoding.UTF8.GetBytes(svg);
            return $"data:image/svg+xml;base64,{Convert.ToBase64String(bytes)}";
        }
        catch
        {
            return null;
        }
    }

    private void ShowExistingCreditNotes()
    {
        showExistingCreditNotesModal = true;
    }

    private void OpenCreateCreditNoteModal()
    {
        if (selectedInvoice?.Lines == null)
        {
            return;
        }

        if (IsSelectedInvoiceFullyCredited())
        {
            creditNoteSuccess = false;
            creditNoteMessage = $"Invoice #{selectedInvoice.DocNum} has already been fully credited.";
            return;
        }

        creditNoteLines = selectedInvoice.Lines.Select(line => new CreditNoteLineSelection
        {
            ItemCode = line.ItemCode ?? "",
            ItemDescription = line.ItemDescription,
            OriginalQuantity = line.Quantity,
            CreditQuantity = line.Quantity,
            UnitPrice = line.UnitPrice,
            WarehouseCode = line.WarehouseCode,
            LineNum = line.LineNum,
            IsSelected = true
        }).ToList();

        selectAllLines = true;
        creditNoteReason = null;
        creditNoteClientRequestId = Guid.NewGuid().ToString("N");
        showCreateCreditNoteModal = true;
    }

    private void ToggleAllLines()
    {
        if (creditNoteLines != null)
        {
            foreach (var line in creditNoteLines)
                line.IsSelected = selectAllLines;
        }
    }

    private bool HasSelectedLines()
    {
        return creditNoteLines?.Any(l => l.IsSelected && l.CreditQuantity > 0) ?? false;
    }

    private decimal CalculateCreditNoteTotal()
    {
        if (creditNoteLines == null) return 0;
        return creditNoteLines.Where(l => l.IsSelected).Sum(l => l.CreditQuantity * l.UnitPrice);
    }

    private async Task CreateCreditNote()
    {
        if (selectedInvoice == null || creditNoteLines == null || string.IsNullOrWhiteSpace(creditNoteReason))
            return;

        if (IsSelectedInvoiceFullyCredited())
        {
            creditNoteSuccess = false;
            creditNoteMessage = $"Invoice #{selectedInvoice.DocNum} has already been fully credited.";
            return;
        }

        isCreatingCreditNote = true;
        creditNoteMessage = null;
        creditNoteProgress = 0;
        creditNoteProgressMessage = "Initializing...";

        _progressCancellationTokenSource = new CancellationTokenSource();
        _ = SimulateSapProgressAsync(_progressCancellationTokenSource.Token);

        try
        {
            var selectedLines = creditNoteLines
            .Where(l => l.IsSelected && l.CreditQuantity > 0)
            .Select(l => new CreateCreditNoteLineRequest
            {
                ItemCode = l.ItemCode,
                ItemDescription = l.ItemDescription,
                Quantity = l.CreditQuantity,
                UnitPrice = l.UnitPrice,
                WarehouseCode = l.WarehouseCode,
                OriginalInvoiceLineId = l.LineNum
            })
            .ToList();

            var result = await CreditNoteService.CreateFromInvoiceAsync(
            selectedInvoice.DocEntry,
            selectedLines,
            creditNoteReason,
            creditNoteClientRequestId
            );

            _progressCancellationTokenSource?.Cancel();

            if (result.Success && result.CreditNote != null)
            {
                creditNoteProgress = 100;
                creditNoteProgressMessage = "Credit note created successfully!";
                StateHasChanged();
                await Task.Delay(500);

                creditNoteSuccess = true;
                creditNoteMessage = $"Credit Note {result.CreditNote.CreditNoteNumber} created successfully!";
                showCreateCreditNoteModal = false;

                existingCreditNotes = await CreditNoteService.GetCreditNotesForInvoiceAsync(selectedInvoice.DocEntry);
            }
            else
            {
                creditNoteSuccess = false;
                creditNoteMessage = result.ErrorMessage ?? "Failed to create credit note. Please try again.";
            }
        }
        catch (Exception ex)
        {
            _progressCancellationTokenSource?.Cancel();
            creditNoteSuccess = false;
            creditNoteMessage = $"Error: {ex.Message}";
        }
        finally
        {
            isCreatingCreditNote = false;
            creditNoteProgress = 0;
        }
    }

    /// <summary>
    /// Paces the posting dialog's ring. SAP reports no progress for this call, so the percentage
    /// is a "something is still happening" signal, not a measurement.
    /// </summary>
    private async Task SimulateSapProgressAsync(CancellationToken cancellationToken)
    {
        var progressSteps = new[]
        {
(10, "Validating credit note data..."),
(25, "Connecting to SAP Business One..."),
(40, "Authenticating with SAP..."),
(55, "Preparing credit note document..."),
(70, "Posting credit note to SAP..."),
(85, "Processing inventory adjustments..."),
(95, "Finalizing transaction...")
};

        try
        {
            foreach (var (progress, message) in progressSteps)
            {
                if (cancellationToken.IsCancellationRequested) return;

                while (creditNoteProgress < progress && !cancellationToken.IsCancellationRequested)
                {
                    creditNoteProgress += 2;
                    if (creditNoteProgress > progress)
                        creditNoteProgress = progress;
                    await InvokeAsync(StateHasChanged);
                    await Task.Delay(100, cancellationToken);
                }

                creditNoteProgressMessage = message;
                await InvokeAsync(StateHasChanged);
                await Task.Delay(800, cancellationToken);
            }

            while (!cancellationToken.IsCancellationRequested)
            {
                if (creditNoteProgress >= 95)
                    creditNoteProgress = 85;
                creditNoteProgress += 1;
                await InvokeAsync(StateHasChanged);
                await Task.Delay(300, cancellationToken);
            }
        }
        catch (TaskCanceledException) { /* Expected */ }
    }

    private static string GetCreditNoteDotClass(CreditNoteStatus status) => status switch
    {
        CreditNoteStatus.Applied => "is-done",
        CreditNoteStatus.Approved or CreditNoteStatus.PartiallyApplied => "is-todo",
        CreditNoteStatus.Pending => "is-todo",
        CreditNoteStatus.Cancelled or CreditNoteStatus.Voided => "is-unknown",
        _ => "is-unknown"
    };

    private static string GetFiscalDotClass(string? status)
        => NormalizeFiscalStatus(status) switch
        {
            "fiscalised" => "is-done",
            "not fiscalised" => "is-todo",
            _ => "is-unknown"
        };

    private static string GetFiscalTextClass(string? status)
        => NormalizeFiscalStatus(status) == "not fiscalised" ? "is-todo" : string.Empty;

    private int GetActiveCreditNoteCount()
    {
        return existingCreditNotes?.CreditNotes?.Count(IsActiveCreditNote) ?? 0;
    }

    private decimal GetActiveCreditedAmount()
    {
        return existingCreditNotes?.CreditNotes?
            .Where(IsActiveCreditNote)
            .Sum(note => note.DocTotal) ?? 0m;
    }

    private decimal GetRemainingCreditableAmount()
    {
        if (selectedInvoice == null)
        {
            return 0m;
        }

        return Math.Max(0m, selectedInvoice.DocTotal - GetActiveCreditedAmount());
    }

    private bool IsSelectedInvoiceFullyCredited()
    {
        return selectedInvoice != null && GetRemainingCreditableAmount() <= 0.01m;
    }

    private static bool IsActiveCreditNote(CreditNoteDto creditNote)
    {
        return creditNote.Status != CreditNoteStatus.Cancelled && creditNote.Status != CreditNoteStatus.Voided;
    }

    private string TruncateText(string? text, int maxLength)
    {
        if (string.IsNullOrEmpty(text)) return "—";
        return text.Length <= maxLength ? text : text.Substring(0, maxLength) + "…";
    }

    private class CreditNoteLineSelection
    {
        public string ItemCode { get; set; } = "";
        public string? ItemDescription { get; set; }
        public decimal OriginalQuantity { get; set; }
        public decimal CreditQuantity { get; set; }
        public decimal UnitPrice { get; set; }
        public string? WarehouseCode { get; set; }
        public int LineNum { get; set; }
        public bool IsSelected { get; set; }
    }
