@page "/reports/customer-revenue"
@using ShopInventory.Web.Features.Reports.Queries.GetItemVolumeSalesReport
@attribute [Authorize(Roles = "Admin,SalesRep")]
@inherits ItemVolumeReportPageBase
@rendermode InteractiveServer

<PageTitle>Customer Revenue - Shop Inventory</PageTitle>

@* The money face of the same window the item volume report reads. Same request,
   same filters, same underlying invoice and credit-note lines — see
   ItemVolumeReportPageBase for why one call backs both pages.

   Revenue here is net: a credit note dated in the window is deducted from it.
   The invoiced and credited columns are kept beside the net figure rather than
   folded into it, because "we billed 40k and credited 9k" and "we billed 31k"
   are the same net number and very different months.

   The two currencies are never added together. There is no rate on the document
   that would make a combined figure honest, so every money cell is a pair. *@

<div class="ivx">

    <header class="ivx-head">
        <div class="ivx-shell">
            <div class="ivx-titles">
                <span class="ivx-kicker">Sales analysis</span>
                <div class="ivx-titles-row">
                    <i class="ph ph-currency-dollar" aria-hidden="true"></i>
                    <h1 class="ivx-title">Customer revenue</h1>
                </div>
                <p class="ivx-sub">
                    Revenue generated per business partner over a period, net of credit notes raised in the same
                    window, optionally narrowed to chosen items.
                </p>
            </div>
            <div class="ivx-head-actions">
                @if (report is not null)
                {
                    <span class="ivx-count">@FormatMoney(report.Summary.NetRevenueUsd, report.Summary.NetRevenueZig)</span>
                }
                <button type="button" class="ivx-btn ivx-btn-secondary" @onclick="ExportToExcelAsync"
                        disabled="@(!CanExport)">
                    <i class="ph ph-file-xls" aria-hidden="true"></i>@(isExporting ? "Exporting…" : "Export Excel")
                </button>
            </div>
        </div>
        <div class="ivx-rule"></div>
    </header>

    <div class="ivx-body">

        <nav class="ivx-tabs" aria-label="Report views">
            <a class="ivx-tab" href="/reports/item-volume">
                <i class="ph ph-drop" aria-hidden="true"></i>Item volume
            </a>
            <a class="ivx-tab is-current" href="/reports/customer-revenue">
                <i class="ph ph-currency-dollar" aria-hidden="true"></i>Customer revenue
            </a>
            <AuthorizeView Roles="Admin" Context="conversionsCtx">
                <Authorized>
                    <a class="ivx-tab" href="/reports/volume-conversions">
                        <i class="ph ph-sliders-horizontal" aria-hidden="true"></i>Conversion factors
                    </a>
                </Authorized>
            </AuthorizeView>
        </nav>

        @if (!string.IsNullOrWhiteSpace(errorMessage))
        {
            <div class="ivx-alert" role="alert">
                <i class="ph ph-warning-octagon" aria-hidden="true"></i>
                <div class="ivx-alert-body">@errorMessage</div>
            </div>
        }

        @if (!string.IsNullOrWhiteSpace(optionsWarning))
        {
            <div class="ivx-alert is-info">
                <i class="ph ph-info" aria-hidden="true"></i>
                <div class="ivx-alert-body">@optionsWarning</div>
            </div>
        }

        <section class="ivx-filters">
            <div class="ivx-field" style="width:150px">
                <label for="ivx-rev-from">From</label>
                <NocturneDateField Id="ivx-rev-from" @bind-Date="fromDate" AriaLabel="From date" Disabled="@isLoading" />
            </div>
            <div class="ivx-field" style="width:150px">
                <label for="ivx-rev-to">To</label>
                <NocturneDateField Id="ivx-rev-to" @bind-Date="toDate" AriaLabel="To date" Disabled="@isLoading" />
            </div>
            <div class="ivx-field" style="width:150px">
                <label for="ivx-rev-grouping">Group by</label>
                <div class="ivx-select">
                    <select id="ivx-rev-grouping" class="ivx-input" value="@grouping" @onchange="OnGroupingChanged"
                            disabled="@isLoading">
                        <option value="@ItemVolumeSalesGrouping.Daily">Daily</option>
                        <option value="@ItemVolumeSalesGrouping.Weekly">Weekly</option>
                        <option value="@ItemVolumeSalesGrouping.Monthly">Monthly</option>
                    </select>
                    <span class="ivx-caret" aria-hidden="true"></span>
                </div>
            </div>
            <div class="ivx-field" style="width:240px">
                <label>Business partners</label>
                <IvxMultiSelect Options="accountOptions" Selected="selectedAccounts"
                                SelectedChanged="OnAccountsChanged" Placeholder="Choose partners"
                                Icon="ph-users-three" AriaLabel="Business partners"
                                SearchPlaceholder="Search or type a code"
                                EmptyText="No cached partners" Disabled="@(isLoading || isLoadingOptions)" />
                <span class="ivx-field-hint">Ranges like VAN008-019 are expanded.</span>
            </div>
            <div class="ivx-field" style="width:240px">
                <label>Items</label>
                <IvxMultiSelect Options="itemOptions" Selected="selectedItems" SelectedChanged="OnItemsChanged"
                                Placeholder="All items" Icon="ph-cube" AriaLabel="Items"
                                SearchPlaceholder="Search or type an item code"
                                EmptyText="No cached products" Disabled="@(isLoading || isLoadingOptions)" />
                <span class="ivx-field-hint">Leave empty for total revenue.</span>
            </div>
            <div class="ivx-filter-actions">
                <button type="button" class="ivx-btn ivx-btn-ghost" @onclick="ResetFilters" disabled="@isLoading">
                    Reset
                </button>
                <button type="button" class="ivx-btn ivx-btn-primary" @onclick="RunReportAsync" disabled="@(!CanRun)">
                    <i class="ph ph-arrow-clockwise" aria-hidden="true"></i>@(isLoading ? "Loading…" : PrimaryActionLabel)
                </button>
            </div>
        </section>

        @if (selectedAccounts.Count > 0 || selectedItems.Count > 0)
        {
            <div class="ivx-chips">
                @foreach (var account in selectedAccounts)
                {
                    <span class="ivx-chip"><i class="ph ph-user-circle" aria-hidden="true"></i>@account</span>
                }
                @foreach (var item in selectedItems)
                {
                    <span class="ivx-chip"><i class="ph ph-cube" aria-hidden="true"></i>@item</span>
                }
            </div>
        }

        @if (isLoading)
        {
            <section class="ivx-card">
                <div class="ivx-empty">
                    <div class="ivx-spinner" aria-hidden="true"></div>
                    <strong>Reading invoices and credit notes</strong>
                    <span class="ivx-empty-sub">Both sides of the window come from SAP, so a wide range takes a
                        moment.</span>
                </div>
            </section>
        }
        else if (report is null)
        {
            <section class="ivx-card">
                <div class="ivx-empty">
                    <i class="ph ph-currency-dollar" aria-hidden="true"></i>
                    <strong>Ready to run</strong>
                    <span class="ivx-empty-sub">Choose a date range and at least one business partner. Leave the item
                        picker empty for total revenue rather than a per-item slice.</span>
                </div>
            </section>
        }
        else
        {
            <section class="ivx-figures">
                <article class="ivx-figure">
                    <span class="ivx-figure-mark"><i class="ph ph-currency-dollar" aria-hidden="true"></i></span>
                    <div class="ivx-figure-text">
                        <div class="ivx-figure-value is-money">@FormatMoney(report.Summary.NetRevenueUsd, report.Summary.NetRevenueZig)</div>
                        <div class="ivx-figure-label">Net revenue</div>
                        <div class="ivx-figure-note">@FormattedRange</div>
                    </div>
                </article>
                <article class="ivx-figure">
                    <span class="ivx-figure-mark is-quiet"><i class="ph ph-receipt" aria-hidden="true"></i></span>
                    <div class="ivx-figure-text">
                        <div class="ivx-figure-value is-money">@FormatMoney(report.Summary.InvoicedSalesUsd, report.Summary.InvoicedSalesZig)</div>
                        <div class="ivx-figure-label">Invoiced</div>
                        <div class="ivx-figure-note">@report.Summary.InvoiceCount.ToString("N0") invoices</div>
                    </div>
                </article>
                <article class="ivx-figure">
                    <span class="ivx-figure-mark is-warn"><i class="ph ph-arrow-u-down-left" aria-hidden="true"></i></span>
                    <div class="ivx-figure-text">
                        <div class="ivx-figure-value is-money">@FormatMoney(report.Summary.CreditedSalesUsd, report.Summary.CreditedSalesZig)</div>
                        <div class="ivx-figure-label">Credited</div>
                        <div class="ivx-figure-note">@report.Summary.CreditNoteCount.ToString("N0") credit notes</div>
                    </div>
                </article>
                <article class="ivx-figure">
                    <span class="ivx-figure-mark is-quiet"><i class="ph ph-users-three" aria-hidden="true"></i></span>
                    <div class="ivx-figure-text">
                        <div class="ivx-figure-value">@report.Summary.ActiveAccountCount.ToString("N0")</div>
                        <div class="ivx-figure-label">Partners with revenue</div>
                        <div class="ivx-figure-note">of @report.Summary.RequestedAccountCount requested ·
                            @report.Summary.ItemCount.ToString("N0") items</div>
                    </div>
                </article>
            </section>

            <section class="ivx-card">
                <div class="ivx-toolbar">
                    <div class="ivx-toolbar-titles">
                        <h2 class="ivx-toolbar-title">Revenue by business partner</h2>
                        <p class="ivx-toolbar-sub">Open a partner for the items behind its revenue.</p>
                    </div>
                    @if (report.GeneratedAtUtc != default)
                    {
                        <span class="ivx-count">Updated @FormatGeneratedAt()</span>
                    }
                </div>

                @if (ActiveAccounts.Count == 0)
                {
                    <div class="ivx-empty">
                        <i class="ph ph-file-dashed" aria-hidden="true"></i>
                        <strong>No revenue in this window</strong>
                        <span class="ivx-empty-sub">None of the selected partners was invoiced between
                            @FormattedRange.</span>
                    </div>
                }
                else
                {
                    <div class="ivx-groups">
                        @foreach (var account in ActiveAccounts.OrderByDescending(a => a.NetRevenueUsd + a.NetRevenueZig))
                        {
                            var code = account.CardCode;
                            var isOpen = openAccountCode == code;
                            <div class="ivx-group @(isOpen ? "is-open" : "")">
                                <button type="button" class="ivx-grouphead" @onclick="@(() => ToggleAccount(code))"
                                        aria-expanded="@isOpen">
                                    <span class="ivx-twist" aria-hidden="true">
                                        <svg width="10" height="10" viewBox="0 0 10 10">
                                            <path d="M3 1l4 4-4 4" fill="none" stroke="currentColor" stroke-width="1.5"
                                                  stroke-linecap="round" stroke-linejoin="round" />
                                        </svg>
                                    </span>
                                    <span class="ivx-group-id">
                                        <span class="ivx-group-name">@account.CardName</span>
                                        <span class="ivx-group-code">@account.CardCode</span>
                                    </span>
                                    <span class="ivx-group-figs">
                                        <span class="ivx-kv">
                                            <span class="ivx-kv-label">Net revenue</span>
                                            <span class="ivx-kv-value">@FormatMoney(account.NetRevenueUsd, account.NetRevenueZig)</span>
                                        </span>
                                        <span class="ivx-kv">
                                            <span class="ivx-kv-label">Invoiced</span>
                                            <span class="ivx-kv-value is-quiet">@FormatMoney(account.InvoicedSalesUsd, account.InvoicedSalesZig)</span>
                                        </span>
                                        <span class="ivx-kv">
                                            <span class="ivx-kv-label">Credited</span>
                                            <span class="ivx-kv-value @(account.CreditedSalesUsd + account.CreditedSalesZig != 0 ? "is-bad" : "is-quiet")">
                                                @FormatMoney(account.CreditedSalesUsd, account.CreditedSalesZig)
                                            </span>
                                        </span>
                                        <span class="ivx-kv">
                                            <span class="ivx-kv-label">Documents</span>
                                            <span class="ivx-kv-value is-quiet">@account.InvoiceCount inv ·
                                                @account.CreditNoteCount crn</span>
                                        </span>
                                    </span>
                                </button>

                                @if (isOpen)
                                {
                                    <div class="ivx-group-body">
                                        <div class="ivx-tablewrap">
                                            <table class="ivx-table">
                                                <thead>
                                                    <tr>
                                                        <th>Item</th>
                                                        <th class="ivx-num">Net qty</th>
                                                        <th class="ivx-num">Invoiced</th>
                                                        <th class="ivx-num">Credited</th>
                                                        <th class="ivx-num">Net revenue</th>
                                                    </tr>
                                                </thead>
                                                <tbody>
                                                    @foreach (var item in account.Items.OrderByDescending(i => i.NetRevenueUsd + i.NetRevenueZig))
                                                    {
                                                        <tr>
                                                            <td>
                                                                <div class="ivx-item">
                                                                    <span class="ivx-item-name">@item.ItemName</span>
                                                                    <span class="ivx-item-code">@item.ItemCode</span>
                                                                </div>
                                                            </td>
                                                            <td class="ivx-num">@FormatQuantity(item.NetQuantity)</td>
                                                            <td class="ivx-num ivx-money">@FormatMoney(item.InvoicedSalesUsd, item.InvoicedSalesZig)</td>
                                                            <td class="ivx-num ivx-money @(item.CreditedSalesUsd + item.CreditedSalesZig != 0 ? "is-credit" : "")">
                                                                @FormatMoney(item.CreditedSalesUsd, item.CreditedSalesZig)
                                                            </td>
                                                            <td class="ivx-num ivx-money is-strong">@FormatMoney(item.NetRevenueUsd, item.NetRevenueZig)</td>
                                                        </tr>
                                                    }
                                                </tbody>
                                            </table>
                                        </div>
                                    </div>
                                }
                            </div>
                        }
                    </div>
                }
            </section>

            <section class="ivx-card">
                <div class="ivx-toolbar">
                    <div class="ivx-toolbar-titles">
                        <h2 class="ivx-toolbar-title">Revenue by @GroupingPeriodNoun</h2>
                        <p class="ivx-toolbar-sub">Only @GroupingPeriodNoun with movement are listed.</p>
                    </div>
                </div>

                @if (VisiblePeriods.Count == 0)
                {
                    <div class="ivx-empty">
                        <i class="ph ph-calendar-blank" aria-hidden="true"></i>
                        <strong>No period activity</strong>
                    </div>
                }
                else
                {
                    <div class="ivx-tablewrap">
                        <table class="ivx-table is-padded">
                            <thead>
                                <tr>
                                    <th>Period</th>
                                    <th class="ivx-num">Invoices</th>
                                    <th class="ivx-num">Credit notes</th>
                                    <th class="ivx-num">Net qty</th>
                                    <th class="ivx-num">Net revenue</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var period in VisiblePeriods)
                                {
                                    <tr>
                                        <td>@period.Label</td>
                                        <td class="ivx-num">@period.InvoiceCount</td>
                                        <td class="ivx-num">@period.CreditNoteCount</td>
                                        <td class="ivx-num">@FormatQuantity(period.NetQuantity)</td>
                                        <td class="ivx-num ivx-money is-strong">@FormatMoney(period.NetRevenueUsd, period.NetRevenueZig)</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </section>

            <section class="ivx-card">
                <div class="ivx-toolbar">
                    <div class="ivx-toolbar-titles">
                        <h2 class="ivx-toolbar-title">Documents</h2>
                        <p class="ivx-toolbar-sub">Every line behind the totals. Credit-note quantities and amounts are
                            negative.</p>
                    </div>
                    <span class="ivx-count">@report.DocumentLines.Count.ToString("N0") lines</span>
                </div>

                @if (report.DocumentLines.Count == 0)
                {
                    <div class="ivx-empty">
                        <i class="ph ph-file-dashed" aria-hidden="true"></i>
                        <strong>No document lines</strong>
                    </div>
                }
                else
                {
                    <div class="ivx-tablewrap">
                        <table class="ivx-table is-wide is-padded">
                            <thead>
                                <tr>
                                    <th>Date</th>
                                    <th>Type</th>
                                    <th>Document</th>
                                    <th>Partner</th>
                                    <th>Item</th>
                                    <th class="ivx-num">Qty</th>
                                    <th class="ivx-num">Amount</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var line in report.DocumentLines.Take(MaxDocumentLines))
                                {
                                    var isCredit = line.DocumentType == "Credit Note";
                                    <tr>
                                        <td>@line.DocumentDateUtc.ToString("dd MMM yyyy")</td>
                                        <td>
                                            <span class="ivx-doctype">
                                                <span class="ivx-dot @(isCredit ? "is-credit" : "is-invoice")"
                                                      aria-hidden="true"></span>@line.DocumentType
                                            </span>
                                        </td>
                                        <td>@line.DocumentNumber</td>
                                        <td>
                                            <div class="ivx-item">
                                                <span class="ivx-item-name">@line.CardName</span>
                                                <span class="ivx-item-code">@line.CardCode</span>
                                            </div>
                                        </td>
                                        <td>
                                            <div class="ivx-item">
                                                <span class="ivx-item-name">@line.ItemName</span>
                                                <span class="ivx-item-code">@line.ItemCode</span>
                                            </div>
                                        </td>
                                        <td class="ivx-num">@FormatQuantity(line.Quantity)</td>
                                        <td class="ivx-num ivx-money @(isCredit ? "is-credit" : "")">
                                            @line.Currency @line.LineAmount.ToString("N2")
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>

                    @if (report.DocumentLines.Count > MaxDocumentLines)
                    {
                        <div class="ivx-toolbar">
                            <p class="ivx-toolbar-sub">
                                Showing the first @MaxDocumentLines.ToString("N0") of
                                @report.DocumentLines.Count.ToString("N0") lines. Export to Excel for the rest.
                            </p>
                        </div>
                    }
                }
            </section>
        }
    </div>
</div>

@code {
    /// <summary>
    /// A quarter over a dozen accounts runs to tens of thousands of lines, and a
    /// Blazor Server render of that is a long freeze on a page nobody scrolls to
    /// the bottom of. The export carries the whole set.
    /// </summary>
    private const int MaxDocumentLines = 500;

    private string? openAccountCode;

    private void ToggleAccount(string cardCode) =>
        openAccountCode = openAccountCode == cardCode ? null : cardCode;

    protected override string ReportName => "Customer Revenue";
}
