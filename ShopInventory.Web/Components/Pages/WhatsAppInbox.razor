@page "/whatsapp-inbox"
@implements IAsyncDisposable
@inject IWhatsAppAdminService WhatsAppService
@inject IJSRuntime JS
@inject ILogger<WhatsAppInbox> Logger
@attribute [Authorize(Roles = "Admin")]
@rendermode InteractiveServer

@* Concept 1B ("Control room") from the imported Nocturne design
   (WhatsApp Operator Console.dc.html): the gateway and its sessions are a
   permanent first column rather than a status line, so pairing, health and
   failures stay visible while a thread is being worked.

   wwwroot/css/whatsapp-console.css — linked from App.razor — carries the
   design and its light counterpart, and follows the app's theme toggle like
   every other page. The import draws the top bar and the sidebar as well;
   that chrome is the app's own and already built (nocturne-shell.css came
   from this same design), so only the content region is built here. The
   import also narrows the sidebar to a 56px icon rail — the sidebar is shared
   by every page, so it keeps its 232px and the three columns here are sized
   against what is left.

   Three controls in the import are not drawn, because nothing behind them
   exists: the composer's paperclip (the gateway client sends text and
   replies only, so there is no attachment call to make), the conversation's
   archive button, and the pairing card's "code refreshes in 0:42" countdown —
   OpenWA does not report a QR expiry, so that slot is a Refresh code button
   instead. The paperclip's place is taken by the new-chat toggle, which is
   what the composer actually needs, and the archive button's by a Details
   toggle that reveals the per-message capture metadata and raw webhook
   payloads this console carried before the redesign.

   The rail's third figure reads THREADS rather than the import's SENT TODAY:
   both would be scoped to the loaded page of events, and a number labelled
   "today" that silently undercounts past 100 events is worse than one that
   names exactly what the column beside it holds. *@

<PageTitle>WhatsApp Operator Console - Shop Inventory</PageTitle>

<div class="wac">

    @if (isLoading)
    {
        <div class="wac-empty">
            <span class="wac-spin" aria-hidden="true"></span>
            <p>Loading the WhatsApp workspace…</p>
        </div>
    }
    else if (!string.IsNullOrWhiteSpace(errorMessage))
    {
        <div class="wac-empty" role="alert">
            <i class="ph ph-warning-octagon" aria-hidden="true"></i>
            <h2>Unable to load the WhatsApp workspace</h2>
            <p>@errorMessage</p>
            <button class="wac-btn wac-btn-accent" type="button" @onclick="RefreshAsync" disabled="@isRefreshing">
                Retry
            </button>
        </div>
    }
    else
    {
        @* ── Column 1 · gateway and sessions ───────────────────────────── *@
        <aside class="wac-rail" aria-label="Gateway and sessions">
            <div class="wac-rail-body wac-scroll">

                <section class="wac-gw" aria-label="Gateway health">
                    <div class="wac-eyebrow">Gateway</div>
                    <div class="wac-gw-state">
                        <span class="wac-dot @GatewayStatusClass" aria-hidden="true"></span>
                        <span class="wac-gw-label">@GatewayLabel</span>
                        <span class="wac-gw-aside">@(GatewayUptimeLabel ?? string.Empty)</span>
                        <button class="wac-icon-btn" type="button" title="Refresh now"
                                aria-label="Refresh now" @onclick="RefreshAsync" disabled="@isRefreshing">
                            @if (isRefreshing)
                            {
                                <span class="wac-spin" aria-hidden="true"></span>
                            }
                            else
                            {
                                <i class="ph ph-arrows-clockwise" aria-hidden="true"></i>
                            }
                        </button>
                    </div>

                    <dl class="wac-facts">
                        <div class="wac-fact">
                            <dt>Host</dt>
                            <dd>@(health?.BaseUrl ?? "Not configured")</dd>
                        </div>
                        <div class="wac-fact">
                            <dt>Health path</dt>
                            <dd>@(health?.SourcePath ?? "n/a")</dd>
                        </div>
                        <div class="wac-fact">
                            <dt>Version</dt>
                            <dd>@(health?.Version ?? "Unknown")</dd>
                        </div>
                        <div class="wac-fact">
                            <dt>Connected</dt>
                            <dd>@ConnectedSessionsLabel</dd>
                        </div>
                        <div class="wac-fact">
                            <dt>Checked</dt>
                            <dd>@FormatCatTimestamp(health?.CheckedAtUtc)</dd>
                        </div>
                        <div class="wac-fact">
                            <dt>Reported</dt>
                            <dd>@FormatCatTimestamp(health?.ReportedAtUtc)</dd>
                        </div>
                    </dl>

                    <label class="wac-toggle">
                        <input type="checkbox" checked="@autoRefreshEnabled" @onchange="OnAutoRefreshChanged" />
                        <span class="wac-toggle-track" aria-hidden="true"></span>
                        <span>Auto-refresh every @AutoRefreshSeconds s</span>
                    </label>
                </section>

                <div class="wac-rule" aria-hidden="true"></div>

                <section class="wac-sessions" aria-label="Sessions">
                    <div class="wac-sec-head">
                        <span class="wac-eyebrow">Sessions</span>
                        <button class="wac-btn wac-btn-accent wac-btn-xs" type="button" @onclick="ToggleCreateForm"
                                disabled="@(isRefreshing || isCreatingSession)">
                            <i class="ph @(showCreateForm ? "ph-x" : "ph-plus")" aria-hidden="true"></i>
                            @(showCreateForm ? "Cancel" : "New")
                        </button>
                    </div>

                    @if (showCreateForm)
                    {
                        <form class="wac-create" @onsubmit="CreateSessionFromConsoleAsync"
                              @onsubmit:preventDefault="true">
                            <div>
                                <label class="wac-field-label" for="wac-create-session">New session name</label>
                                <input id="wac-create-session" class="wac-input" type="text" maxlength="50"
                                       placeholder="e.g. shopinventory-admin" @bind="createSessionName"
                                       @bind:event="oninput"
                                       disabled="@(isRefreshing || isSessionActionRunning || isCreatingSession)" />
                            </div>
                            <div class="wac-create-actions">
                                <button class="wac-btn wac-btn-xs wac-btn-block" type="submit"
                                        disabled="@(!CanCreateSession)">
                                    @if (isCreatingSession)
                                    {
                                        <span class="wac-spin" aria-hidden="true"></span>
                                    }
                                    Create
                                </button>
                                <button class="wac-btn wac-btn-accent wac-btn-xs wac-btn-block" type="button"
                                        @onclick="CreateAndStartSessionFromConsoleAsync"
                                        disabled="@(!CanCreateSession)">
                                    <i class="ph ph-play" aria-hidden="true"></i>Create + start
                                </button>
                            </div>
                            <div class="wac-help">3–50 characters: letters, numbers and hyphens only.</div>
                            @if (!string.IsNullOrWhiteSpace(createSessionValidationMessage))
                            {
                                <div class="wac-help is-error">@createSessionValidationMessage</div>
                            }
                        </form>
                    }

                    @if (!string.IsNullOrWhiteSpace(actionErrorMessage))
                    {
                        <div class="wac-alert" role="alert">
                            <div class="wac-alert-head">
                                <i class="ph ph-warning-circle" aria-hidden="true"></i>
                                <span>WhatsApp action failed</span>
                            </div>
                            <p>@actionErrorMessage</p>
                            <div class="wac-alert-actions">
                                <button class="wac-btn wac-btn-xs wac-btn-danger" type="button" @onclick="RefreshAsync"
                                        disabled="@isRefreshing">
                                    Retry
                                </button>
                                <button class="wac-btn wac-btn-xs wac-btn-quiet" type="button"
                                        @onclick="DismissActionMessages">
                                    Dismiss
                                </button>
                            </div>
                        </div>
                    }

                    @if (!string.IsNullOrWhiteSpace(actionInfoMessage))
                    {
                        <div class="wac-note is-info">@actionInfoMessage</div>
                    }

                    @if (sessions.Count == 0)
                    {
                        <div class="wac-note">
                            No OpenWA sessions exist yet. Use New to create one, then Create + start to jump
                            straight into QR pairing.
                        </div>
                    }
                    else
                    {
                        <div class="wac-session-list">
                            @foreach (var session in OrderedSessions)
                            {
                                var isSelected = session.Id == selectedSessionId;
                                var statusClass = GetStatusClass(session.Status);

                                <div class="wac-session @(isSelected ? "is-selected" : null)">
                                    <div class="wac-session-head">
                                        <button class="wac-session-name" type="button"
                                                @onclick="() => SelectSessionAsync(session.Id)"
                                                aria-current="@(isSelected ? "true" : null)">
                                            <span class="wac-dot wac-dot-sm @statusClass" aria-hidden="true"></span>
                                            <span>@session.Name</span>
                                        </button>
                                        <span class="wac-session-status @statusClass">
                                            @FormatStatusLabel(session.Status)
                                        </span>
                                    </div>

                                    <div class="wac-session-actions">
                                        <button class="wac-btn wac-btn-xs wac-btn-block" type="button"
                                                @onclick="() => StartAsync(session)"
                                                disabled="@(!IsStartableStatus(session.Status) || isRefreshing || isSessionActionRunning)">
                                            @if (isSessionActionRunning && actioningSessionId == session.Id)
                                            {
                                                <span class="wac-spin" aria-hidden="true"></span>
                                            }
                                            Start
                                        </button>
                                        <button class="wac-btn wac-btn-xs wac-btn-block wac-btn-danger" type="button"
                                                @onclick="() => StopAsync(session)"
                                                disabled="@(!IsStoppableStatus(session.Status) || isRefreshing || isSessionActionRunning)">
                                            Stop
                                        </button>
                                    </div>

                                    @if (isSelected)
                                    {
                                        @if (!string.IsNullOrWhiteSpace(selectedSessionQr?.QrCode))
                                        {
                                            <div class="wac-pair @(qrEnlarged ? "is-big" : null)">
                                                <div class="wac-qr">
                                                    <img src="@selectedSessionQr.QrCode"
                                                         alt="Pairing QR code for @session.Name" />
                                                </div>
                                                <div class="wac-pair-copy">
                                                    <p>Open WhatsApp → Linked devices → Link a device, then scan.</p>
                                                    <div class="wac-session-actions">
                                                        <button class="wac-btn wac-btn-xs" type="button"
                                                                @onclick="ToggleQrSize">
                                                            @(qrEnlarged ? "Shrink" : "Enlarge") code
                                                        </button>
                                                        <button class="wac-btn wac-btn-xs" type="button"
                                                                @onclick="RefreshSelectedSessionQrAsync"
                                                                disabled="@isQrLoading">
                                                            @if (isQrLoading)
                                                            {
                                                                <span class="wac-spin" aria-hidden="true"></span>
                                                            }
                                                            Refresh code
                                                        </button>
                                                    </div>
                                                </div>
                                            </div>
                                        }
                                        else
                                        {
                                            <div class="wac-note">
                                                @qrStatusMessage
                                                @if (IsPairableStatus(session.Status))
                                                {
                                                    <div class="wac-session-actions" style="margin-top:6px">
                                                        <button class="wac-btn wac-btn-xs" type="button"
                                                                @onclick="RefreshSelectedSessionQrAsync"
                                                                disabled="@isQrLoading">
                                                            @if (isQrLoading)
                                                            {
                                                                <span class="wac-spin" aria-hidden="true"></span>
                                                            }
                                                            Load QR code
                                                        </button>
                                                    </div>
                                                }
                                            </div>
                                        }

                                        <dl class="wac-facts wac-session-facts">
                                            <div class="wac-fact">
                                                <dt>Phone</dt>
                                                <dd>@(session.Phone ?? "Not linked")</dd>
                                            </div>
                                            <div class="wac-fact">
                                                <dt>Profile</dt>
                                                <dd>@(session.PushName ?? "Unknown")</dd>
                                            </div>
                                            <div class="wac-fact">
                                                <dt>Connected</dt>
                                                <dd>@FormatCatTimestamp(session.ConnectedAt)</dd>
                                            </div>
                                            <div class="wac-fact">
                                                <dt>Last active</dt>
                                                <dd>@FormatCatTimestamp(session.LastActive)</dd>
                                            </div>
                                            <div class="wac-fact">
                                                <dt>Updated</dt>
                                                <dd>@FormatCatTimestamp(session.UpdatedAt)</dd>
                                            </div>
                                        </dl>
                                    }
                                </div>
                            }
                        </div>
                    }
                </section>
            </div>

            <div class="wac-stats">
                <div class="wac-stat">
                    <span class="wac-stat-value">@inbox.TotalCount</span>
                    <span class="wac-stat-label">CAPTURED</span>
                </div>
                <div class="wac-stat @(UnreadThreadCount > 0 ? "is-accent" : null)">
                    <span class="wac-stat-value">@UnreadThreadCount</span>
                    <span class="wac-stat-label">UNREAD</span>
                </div>
                <div class="wac-stat">
                    <span class="wac-stat-value">@threadOrder.Count</span>
                    <span class="wac-stat-label">THREADS</span>
                </div>
            </div>
        </aside>

        @* ── Column 2 · threads ────────────────────────────────────────── *@
        <section class="wac-threads" aria-label="Threads">
            <header class="wac-threads-head">
                <span class="wac-threads-title">Threads</span>
                <span class="wac-threads-count">@UnreadThreadCount unread</span>
            </header>

            <div class="wac-threads-search">
                <form class="wac-search" @onsubmit="ApplySearchAsync" @onsubmit:preventDefault="true" role="search">
                    <i class="ph ph-magnifying-glass" aria-hidden="true"></i>
                    <input class="wac-input" type="search" aria-label="Search threads"
                           placeholder="Search threads" @bind="searchTerm"
                           @bind:event="oninput" />
                    @if (!string.IsNullOrWhiteSpace(searchTerm))
                    {
                        <button class="wac-icon-btn wac-search-clear" type="button" title="Clear search"
                                aria-label="Clear search" @onclick="ClearSearchAsync" disabled="@isRefreshing">
                            <i class="ph ph-x" aria-hidden="true"></i>
                        </button>
                    }
                </form>
            </div>

            <div class="wac-thread-list wac-scroll">
                @if (threadOrder.Count == 0)
                {
                    <div class="wac-empty wac-empty-sm">
                        <i class="ph ph-chats-circle" aria-hidden="true"></i>
                        <p>
                            @(string.IsNullOrWhiteSpace(searchTerm)
                                ? "No threads captured yet. Incoming and outbound messages appear here once the first webhook lands."
                                : "No threads match that search.")
                        </p>
                    </div>
                }
                else
                {
                    @foreach (var threadKey in threadOrder)
                    {
                        var unreadCount = GetThreadUnreadCount(threadKey);
                        var isSelected = threadKey == selectedThreadKey;

                        <button class="wac-thread @(isSelected ? "is-selected" : null)" type="button"
                                @onclick="() => SelectThreadAsync(threadKey)" aria-current="@(isSelected ? "true" : null)">
                            <span class="wac-avatar" aria-hidden="true">@GetThreadInitials(threadKey)</span>
                            <span class="wac-thread-copy">
                                <span class="wac-thread-top">
                                    <span class="wac-thread-name">@GetThreadDisplayName(threadKey)</span>
                                    <span class="wac-thread-time">@GetThreadTimeLabel(threadKey)</span>
                                </span>
                                <span class="wac-thread-bottom">
                                    <span class="wac-thread-snippet">@GetThreadPreview(threadKey)</span>
                                    @if (unreadCount > 0)
                                    {
                                        <span class="wac-thread-unread">@unreadCount</span>
                                    }
                                </span>
                            </span>
                        </button>
                    }
                }
            </div>

            @if (inbox.TotalCount > inbox.PageSize)
            {
                <div class="wac-pager">
                    <button class="wac-btn wac-btn-xs" type="button" @onclick="PreviousPageAsync"
                            disabled="@(currentPage <= 1 || isRefreshing)">
                        <i class="ph ph-arrow-left" aria-hidden="true"></i>Newer
                    </button>
                    <span class="wac-pager-label">@currentPage / @TotalPages</span>
                    <button class="wac-btn wac-btn-xs" type="button" @onclick="NextPageAsync"
                            disabled="@(currentPage >= TotalPages || isRefreshing)">
                        Older<i class="ph ph-arrow-right" aria-hidden="true"></i>
                    </button>
                </div>
            }
        </section>

        @* ── Column 3 · conversation ───────────────────────────────────── *@
        <section class="wac-conv" aria-label="Conversation">
            <header class="wac-conv-head">
                <div class="wac-conv-id">
                    <span class="wac-conv-name">@ConversationTitle</span>
                    <span class="wac-conv-sub">@ConversationSubtitle</span>
                </div>
                <span class="wac-pill @SelectedSessionStatusClass">@SelectedSessionStatusLabel</span>
                <button class="wac-icon-btn @(showDetails ? "is-on" : null)" type="button"
                        title="Capture details" aria-pressed="@showDetails" @onclick="ToggleDetails">
                    <i class="ph ph-info" aria-hidden="true"></i>
                </button>
            </header>

            @if (SelectedThreadMessages.Count == 0)
            {
                <div class="wac-empty">
                    <i class="ph ph-chat-circle-dots" aria-hidden="true"></i>
                    <h2>No conversation selected</h2>
                    <p>
                        Pick a captured thread on the left to continue it, or use the new-chat control below to
                        send the first message to a number.
                    </p>
                </div>
            }
            else
            {
                <div class="wac-msgs wac-scroll" id="@MessageListId">
                    @{
                        var previousDay = string.Empty;
                    }
                    @foreach (var message in SelectedThreadMessages)
                    {
                        var stamp = message.OccurredAtUtc ?? message.ReceivedAtUtc;
                        var day = FormatDayMark(stamp);
                        var isNewDay = !string.Equals(day, previousDay, StringComparison.Ordinal);
                        previousDay = day;

                        if (isNewDay)
                        {
                            <div class="wac-daymark">@day</div>
                        }

                        <article class="wac-msg @(message.IsFromMe ? "is-out" : "is-in")">
                            @if (string.IsNullOrWhiteSpace(message.TextBody))
                            {
                                <div class="wac-bubble is-empty">
                                    No text body was captured for this @message.EventType event.
                                </div>
                            }
                            else
                            {
                                <div class="wac-bubble">@message.TextBody</div>
                            }

                            <div class="wac-msg-foot">
                                <span>@FormatClock(stamp)</span>
                                @if (message.IsFromMe)
                                {
                                    <i class="ph ph-checks" title="@(message.Status ?? "sent")" aria-hidden="true"></i>
                                }
                                @if (CanReplyTo(message))
                                {
                                    <button class="wac-msg-reply" type="button" @onclick="() => BeginReply(message)">
                                        <i class="ph ph-arrow-bend-up-left" aria-hidden="true"></i>Reply
                                    </button>
                                }
                            </div>

                            @if (showDetails)
                            {
                                <div class="wac-msg-meta">
                                    <span><i class="ph ph-user" aria-hidden="true"></i>@GetSenderLabel(message)</span>
                                    <span><i class="ph ph-lightning" aria-hidden="true"></i>@message.EventType</span>
                                    <span><i class="ph ph-arrows-left-right" aria-hidden="true"></i>@message.Direction</span>
                                    <span><i class="ph ph-hash" aria-hidden="true"></i>@(message.MessageId ?? "No message id")</span>
                                    <span><i class="ph ph-broadcast" aria-hidden="true"></i>@(message.MessageType ?? "Unknown type")</span>
                                    <span><i class="ph ph-activity" aria-hidden="true"></i>@(message.Status ?? "No status")</span>
                                    <span><i class="ph ph-box-arrow-down" aria-hidden="true"></i>Captured @FormatCatTimestamp(message.ReceivedAtUtc)</span>
                                </div>
                                <details class="wac-raw">
                                    <summary>Raw payload</summary>
                                    <pre>@message.RawPayload</pre>
                                </details>
                            }
                        </article>
                    }
                </div>
            }

            <div class="wac-composer">
                @if (IsReplying)
                {
                    <div class="wac-reply-banner">
                        <div class="wac-reply-copy">
                            <div class="wac-reply-title">Replying to @replyToSenderLabel</div>
                            <div class="wac-reply-preview">@replyPreviewText</div>
                        </div>
                        <button class="wac-btn wac-btn-xs" type="button" @onclick="ClearReplyContext">Cancel</button>
                    </div>
                }

                @if (showNewChat && !IsReplying)
                {
                    <div>
                        <label class="wac-field-label" for="wac-recipient">Send to a new number or chat id</label>
                        <input id="wac-recipient" class="wac-input" type="text" inputmode="tel" autocomplete="off"
                               placeholder="263772123456, or 263772123456@@c.us" @bind="composeRecipient"
                               @bind:event="oninput" disabled="@isSending" />
                    </div>
                }

                @if (!IsReplying)
                {
                    <div class="wac-quick">
                        @foreach (var quickReply in QuickReplies)
                        {
                            <button class="wac-chip" type="button" @onclick="() => ApplyQuickReply(quickReply)"
                                    disabled="@isSending">
                                @quickReply
                            </button>
                        }
                    </div>
                }

                <div class="wac-compose-row">
                    <button class="wac-icon-btn @(showNewChat ? "is-on" : null)" type="button" title="New chat"
                            aria-label="New chat" aria-pressed="@showNewChat" @onclick="ToggleNewChat"
                            disabled="@(isSending || IsReplying)">
                        <i class="ph ph-user-plus" aria-hidden="true"></i>
                    </button>
                    <textarea id="@ComposeInputId" class="wac-textarea" rows="1" aria-label="Message"
                              placeholder="@ComposePlaceholder" @bind="composeText" @bind:event="oninput"
                              @onkeydown="OnComposeKeyDownAsync" disabled="@isSending"></textarea>
                    <button class="wac-btn wac-btn-accent" type="button" @onclick="SendComposeAsync"
                            disabled="@(!CanSendCompose || isSending)">
                        @if (isSending)
                        {
                            <span class="wac-spin" aria-hidden="true"></span>
                        }
                        @(IsReplying ? "Send reply" : "Send")
                        <i class="ph ph-paper-plane-tilt" aria-hidden="true"></i>
                    </button>
                </div>

                <span class="wac-compose-hint">@ComposeHintLabel</span>
            </div>
        </section>
    }
</div>

@code {
    private const int PageSize = 100;
    private const string ComposeInputId = "wac-compose";
    private const string MessageListId = "wac-messages";
    private static readonly TimeSpan AutoRefreshInterval = TimeSpan.FromSeconds(15);

    private static readonly string[] QuickReplies =
    [
        "Confirmed for tomorrow",
        "Let me check stock and come back to you",
        "Sending the invoice now"
    ];

    private readonly HashSet<int> trackedMessageIds = [];
    private readonly HashSet<int> unreadMessageIds = [];

    private bool isLoading = true;
    private bool isRefreshing;
    private bool isSending;
    private bool isQrLoading;
    private bool isSessionActionRunning;
    private bool isCreatingSession;
    private bool autoRefreshEnabled = true;

    private bool showCreateForm;
    private bool showNewChat;
    private bool showDetails;
    private bool qrEnlarged;
    private bool enterHandlerAttached;
    private string? renderedConversationKey;

    private string? errorMessage;
    private string? actionErrorMessage;
    private string? actionInfoMessage;
    private string? createSessionValidationMessage;
    private string? selectedSessionId;
    private string? actioningSessionId;
    private string? selectedThreadKey;
    private string? replyToMessageId;
    private string? replyToSenderLabel;
    private string? replyPreviewText;
    private string? qrStatusMessage = "Select a session to load the current authentication state.";
    private string searchTerm = string.Empty;
    private string createSessionName = string.Empty;
    private string composeRecipient = string.Empty;
    private string composeText = string.Empty;
    private int currentPage = 1;

    private PeriodicTimer? autoRefreshTimer;
    private CancellationTokenSource? autoRefreshCancellationTokenSource;
    private Task? autoRefreshTask;

    private WhatsAppHealthModel? health;
    private WhatsAppQrCodeModel? selectedSessionQr;
    private WhatsAppInboxResponseModel inbox = new() { Page = 1, PageSize = PageSize };
    private List<WhatsAppSessionModel> sessions = [];
    private Dictionary<string, List<WhatsAppInboxItemModel>> threadMap = new(StringComparer.Ordinal);
    private List<string> threadOrder = [];

    private static int AutoRefreshSeconds => (int)AutoRefreshInterval.TotalSeconds;

    private int TotalPages => Math.Max(1, (int)Math.Ceiling(inbox.TotalCount / (double)Math.Max(inbox.PageSize, 1)));

    private WhatsAppSessionModel? SelectedSession => sessions.FirstOrDefault(session => session.Id == selectedSessionId);

    private IEnumerable<WhatsAppSessionModel> OrderedSessions => sessions
        .OrderByDescending(session => string.Equals(session.Status, "ready", StringComparison.OrdinalIgnoreCase))
        .ThenBy(session => session.Name, StringComparer.OrdinalIgnoreCase);

    private IReadOnlyList<WhatsAppInboxItemModel> SelectedThreadMessages =>
        !string.IsNullOrWhiteSpace(selectedThreadKey) && threadMap.TryGetValue(selectedThreadKey, out var messages)
            ? messages
            : Array.Empty<WhatsAppInboxItemModel>();

    private int UnreadThreadCount => threadOrder.Count(threadKey => GetThreadUnreadCount(threadKey) > 0);

    private string GatewayLabel => (health?.Status ?? string.Empty).ToLowerInvariant() switch
    {
        "ok" or "healthy" => "Reachable",
        "warning" or "degraded" => "Degraded",
        "" => "Unknown",
        _ => "Unreachable"
    };

    private string GatewayStatusClass => GetStatusClass(health?.Status);

    private string? GatewayUptimeLabel => FormatUptime(health?.UptimeSeconds);

    private string ConnectedSessionsLabel => health?.TotalSessions is { } total
        ? $"{health.ConnectedSessions ?? 0} of {total}"
        : (health?.ConnectedSessions?.ToString() ?? "Unknown");

    private string SelectedSessionStatusLabel => FormatStatusLabel(SelectedSession?.Status);

    private string SelectedSessionStatusClass => GetStatusClass(SelectedSession?.Status);

    private bool IsReplying => !string.IsNullOrWhiteSpace(replyToMessageId);

    private bool CanCreateSession => !isRefreshing
        && !isSessionActionRunning
        && !isCreatingSession
        && ValidateSessionName(createSessionName) is null;

    private bool CanSendCompose => !isSending
        && SelectedSession is not null
        && string.Equals(SelectedSession.Status, "ready", StringComparison.OrdinalIgnoreCase)
        && !string.IsNullOrWhiteSpace(ResolveComposeChatId(out _))
        && !string.IsNullOrWhiteSpace(composeText);

    private string ConversationTitle => string.IsNullOrWhiteSpace(selectedThreadKey)
        ? "No thread selected"
        : GetThreadDisplayName(selectedThreadKey);

    private string ConversationSubtitle
    {
        get
        {
            if (string.IsNullOrWhiteSpace(selectedThreadKey))
            {
                return sessions.Count == 0
                    ? "No OpenWA session yet"
                    : "Choose a thread, or start a new chat below";
            }

            var chatLabel = FormatChatIdLabel(GetThreadChatId(selectedThreadKey)) ?? "No chat id";
            var sessionName = GetThreadSessionName(selectedThreadKey) ?? "default";
            return $"{chatLabel} · via {sessionName}";
        }
    }

    private string ComposePlaceholder => SelectedSession is null
        ? "Choose an OpenWA session before sending."
        : IsReplying
            ? "Write a reply — Enter to send"
            : showNewChat && !string.IsNullOrWhiteSpace(composeRecipient)
                ? "First message for this recipient — Enter to send"
                : SelectedThreadMessages.Count == 0
                    ? "Select a thread, or add a number above"
                    : "Write a reply — Enter to send";

    private string ComposeHintLabel
    {
        get
        {
            if (SelectedSession is null)
            {
                return "Choose an OpenWA session.";
            }

            if (!string.Equals(SelectedSession.Status, "ready", StringComparison.OrdinalIgnoreCase))
            {
                return $"Session {SelectedSession.Name} must be ready before sending.";
            }

            var chatId = ResolveComposeChatId(out var validationMessage);
            if (string.IsNullOrWhiteSpace(chatId))
            {
                return validationMessage ?? "Select a thread or enter a phone number.";
            }

            var target = IsReplying
                ? $"Reply goes to {chatId}"
                : showNewChat && !string.IsNullOrWhiteSpace(composeRecipient)
                    ? $"New chat goes to {chatId}"
                    : $"Goes to {chatId}";

            return $"{target} · sending as {SelectedSession.Name} · Shift+Enter for a new line";
        }
    }

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync(resetTracker: true);
        StartAutoRefreshLoop();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // The composer only exists once the workspace has loaded, and it is torn
        // down again whenever the page drops into its loading or error state, so
        // the flag has to fall back with it.
        if (isLoading || !string.IsNullOrWhiteSpace(errorMessage))
        {
            enterHandlerAttached = false;
            renderedConversationKey = null;
            return;
        }

        try
        {
            if (!enterHandlerAttached)
            {
                enterHandlerAttached = true;
                await JS.InvokeVoidAsync("shopInventory.suppressEnterNewline", ComposeInputId);
            }

            // Open a thread at its newest message rather than its oldest, and
            // follow it down as messages arrive.
            var conversationKey = $"{selectedThreadKey}:{SelectedThreadMessages.Count}";
            if (SelectedThreadMessages.Count > 0 && conversationKey != renderedConversationKey)
            {
                renderedConversationKey = conversationKey;
                await JS.InvokeVoidAsync("shopInventory.scrollToBottom", MessageListId);
            }
        }
        catch (JSDisconnectedException)
        {
            enterHandlerAttached = false;
        }
        catch (Exception ex)
        {
            // A failed interop call must not take the page down with it: both
            // calls are comfort, not function.
            Logger.LogDebug(ex, "WhatsApp console interop call failed");
        }
    }

    public async ValueTask DisposeAsync()
    {
        autoRefreshCancellationTokenSource?.Cancel();
        autoRefreshTimer?.Dispose();

        if (autoRefreshTask is not null)
        {
            try
            {
                await autoRefreshTask;
            }
            catch (OperationCanceledException)
            {
            }
        }

        autoRefreshCancellationTokenSource?.Dispose();
    }

