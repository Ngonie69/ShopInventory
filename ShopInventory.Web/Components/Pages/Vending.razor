@page "/vending"
@page "/vending/vendors/{VendorId:int}"
@attribute [Authorize(Roles = UserRoles.VendingRoles)]
@rendermode InteractiveServer
@inject IVendingService VendingService
@inject IRouteCustomerService RouteCustomerService
@inject IMasterDataCacheService MasterDataCache
@inject NavigationManager Navigation
@inject IMediator Mediator
@inject IJSRuntime JS
@using MediatR
@using ShopInventory.Web.Features.Vending
@using ShopInventory.Web.Features.Vending.Commands.ImportVendors
@using ShopInventory.Web.Features.Vending.Queries.GetVendorImportTemplate
@using ShopInventory.Web.Features.Vending.Queries.ReadVendorImportFile

<PageTitle>@(SelectedVendor is { } titled ? $"{VendorName(titled)} - Vending" : "Depots & Vendors - Shop Inventory")</PageTitle>

@* The vending operation: four depots, the cashier accounts that sell at each, and the
   vendors those cashiers invoice from the desktop till.

   Styled by shops.css, whose shell, table, chips, filters and modal this page wears
   under the same `shop-` names, plus vending.css for the depot cards alone.

   A depot is not a record of its own. It is the business partner its cashiers sell
   on, and each cashier carries that partner, the warehouse it draws stock from and
   the cost centre on their own account — set on the user management page. So this
   page reads depots, and the only thing it writes is vendors, through the route
   customer endpoints that have always held them. Removing a vendor is the API's soft
   delete: its sales stay on it, and the till refuses it from then on.

   Sales figures are the route-customer reports', read once per depot for the month so far
   (/api/route-customers/sales-summary). They load after the depots and vendors, so a slow or
   failed report leaves the page usable and says so, rather than holding the list back or
   showing a vendor who sold as one who did not. /vending/vendors/{id} is the same component
   showing VendingVendorDetail, so the dialogs below serve both views.

   Those reads ask for RouteCustomerScope.Vending. A vendor and a van route's shop share one table
   and the endpoint answers about routes by default, because a vendor is not a route customer: it
   has a depot, not a route. Every link out of here stays under /vending for the same reason. *@

<div class="shop vend">

    @if (error is not null && dialog is DialogMode.None)
    {
        <div class="shop-alert" role="alert">
            <i class="bi bi-exclamation-triangle-fill"></i>
            <span>@error</span>
        </div>
    }

    @if (notice is not null)
    {
        <div class="vend-notice" role="status">
            <i class="bi bi-check-circle-fill"></i>
            <span>@notice</span>
            <button type="button" class="shop-action-btn" aria-label="Dismiss" @onclick="() => notice = null">
                <i class="bi bi-x-lg"></i>
            </button>
        </div>
    }

    @if (VendorId is not null)
    {
        @* A reload after an edit keeps the vendor on screen: only the first load, with nothing to show
           yet, puts up the spinner — otherwise the detail would be torn down and read again. *@
        @if (isLoading && overview is null)
        {
            <div class="shop-loading">
                <MudProgressCircular Indeterminate="true" Size="Size.Small" />
                <span>Loading vendor…</span>
            </div>
        }
        else if (SelectedVendor is { } selected)
        {
            <VendingVendorDetail Vendor="selected"
                                 DepotName="@DepotName(selected.AssignedBusinessPartnerCode)"
                                 Depot="DepotFor(selected.AssignedBusinessPartnerCode)"
                                 Cashiers="CashiersFor(selected.AssignedBusinessPartnerCode)"
                                 ListRow="SalesRowFor(selected)"
                                 IsSaving="isSaving"
                                 OnEdit="StartEdit"
                                 OnToggle="StartToggle" />
        }
        else if (overview is not null)
        {
            <div class="shop-table-wrap">
                <div class="shop-empty">
                    <i class="bi bi-person-x"></i>
                    <h3>No vending vendor with that id</h3>
                    <p>They may be on a van route rather than at a depot. Every depot's vendors are on the list.</p>
                    <a class="shop-btn shop-btn-ghost" href="/vending">Back to depots &amp; vendors</a>
                </div>
            </div>
        }
    }
    else
    {
        <div class="shop-header">
            <div class="shop-header-left">
                <div>
                    <div class="shop-crumb">
                        <span>Vending</span>
                        <i class="bi bi-chevron-right"></i>
                        <span class="shop-crumb-here">Depots &amp; vendors</span>
                    </div>
                    <h2 class="shop-title">Depots &amp; vendors</h2>
                    <p class="shop-subtitle">
                        Cashiers, the warehouse each depot draws from, and the vendors they invoice.
                        A cashier is put on a depot from their user account.
                    </p>
                </div>
            </div>
            <div class="shop-header-actions">
                <AuthorizeView Roles="Admin">
                    <Authorized>
                        <a class="shop-btn shop-btn-ghost" href="/user-management">
                            <i class="bi bi-person-gear"></i>Cashier accounts
                        </a>
                    </Authorized>
                </AuthorizeView>
                <button type="button" class="shop-btn shop-btn-ghost" @onclick="DownloadTemplateAsync"
                        disabled="@(isDownloadingTemplate || overview is null || overview.Depots.Count == 0)">
                    <i class="bi bi-file-earmark-arrow-down"></i>@(isDownloadingTemplate ? "Preparing…" : "Download template")
                </button>
                <button type="button" class="shop-btn shop-btn-ghost" @onclick="StartImport"
                        disabled="@(isSaving || overview is null || overview.Depots.Count == 0)">
                    <i class="bi bi-file-earmark-arrow-up"></i>Upload vendors
                </button>
                <button type="button" class="shop-btn shop-btn-primary" @onclick="StartNew"
                        disabled="@(isSaving || overview is null || overview.Depots.Count == 0)">
                    <i class="bi bi-plus-lg"></i>Add vendor
                </button>
            </div>
        </div>

        @if (isLoading)
        {
            <div class="shop-loading">
                <MudProgressCircular Indeterminate="true" Size="Size.Small" />
                <span>Loading depots…</span>
            </div>
        }
        else if (overview is not null)
        {
            @if (overview.Depots.Count == 0)
            {
                <div class="shop-table-wrap">
                    <div class="shop-empty">
                        <i class="bi bi-shop"></i>
                        <h3>No vending depots yet</h3>
                        <p>
                            A depot appears here once a cashier account is created on the CartVendor role, with the
                            depot's business partner, warehouse and cost centre.
                        </p>
                    </div>
                </div>
            }
            else
            {
                @* The cards double as the depot filter: the question someone opening this page
                   most often has is "who is at this depot", and the card is where they are
                   already looking. *@
                <div class="vend-depots">
                    @foreach (var depot in overview.Depots)
                    {
                        var isOn = string.Equals(depotFilter, depot.BusinessPartnerCode, StringComparison.OrdinalIgnoreCase);
                        <button type="button" @key="depot.BusinessPartnerCode"
                                class="vend-depot @(isOn ? "is-on" : null) @(depot.SetupProblem is null ? null : "has-problem")"
                                aria-pressed="@isOn" @onclick="() => ToggleDepot(depot.BusinessPartnerCode)">
                            <span class="vend-depot-top">
                                <span class="vend-depot-id">
                                    <span class="vend-depot-name">@DepotName(depot.BusinessPartnerCode)</span>
                                    <span class="vend-depot-meta">@DepotMeta(depot)</span>
                                </span>
                                @if (depot.VendorCodePrefix is not null)
                                {
                                    <span class="vend-depot-tag" title="@PrefixTitle(depot)">@PrefixPattern(depot.VendorCodePrefix)</span>
                                }
                            </span>
                            <span class="vend-depot-figures">
                                <span class="vend-fig">
                                    <span class="vend-fig-value">@depot.ActiveVendorCount</span>
                                    <span class="vend-fig-label">@(depot.ActiveVendorCount == 1 ? "Vendor" : "Vendors")</span>
                                </span>
                                <span class="vend-fig">
                                    <span class="vend-fig-value">@depot.ActiveCashierCount</span>
                                    <span class="vend-fig-label">@(depot.ActiveCashierCount == 1 ? "Cashier" : "Cashiers")</span>
                                </span>
                                <span class="vend-fig vend-fig-end">
                                    @if (salesLoading)
                                    {
                                        <span class="vend-skel vend-skel-fig" aria-label="Loading sales"></span>
                                    }
                                    else
                                    {
                                        <span class="vend-fig-value is-accent">@DepotSalesLabel(depot.BusinessPartnerCode)</span>
                                    }
                                    <span class="vend-fig-label">Sales MTD</span>
                                </span>
                            </span>
                            @if (depot.SetupProblem is not null)
                            {
                                <span class="vend-depot-problem"><i class="bi bi-exclamation-triangle-fill"></i>@depot.SetupProblem</span>
                            }
                            else if (depot.VendorCodeProblem is not null)
                            {
                                <span class="vend-depot-problem"><i class="bi bi-exclamation-triangle-fill"></i>No vendor code prefix: @depot.VendorCodeProblem.</span>
                            }
                        </button>
                    }
                </div>

                @if (salesError is not null)
                {
                    <div class="vend-sales-warning" role="status">
                        <i class="bi bi-exclamation-circle"></i>
                        <span>@salesError The depots and vendors below are current; only the sales figures are missing.</span>
                        <button type="button" class="shop-btn shop-btn-ghost" @onclick="LoadSalesAsync">Try again</button>
                    </div>
                }

                <div class="shop-filter-bar">
                    <div class="shop-seg" role="group" aria-label="Show">
                        <button type="button" class="shop-seg-btn @(tab == Tab.Vendors ? "is-on" : null)"
                                aria-pressed="@(tab == Tab.Vendors)" @onclick="() => tab = Tab.Vendors">
                            Vendors<span class="shop-seg-count">@VendorsInDepot.Count(v => v.IsActive)</span>
                        </button>
                        <button type="button" class="shop-seg-btn @(tab == Tab.Cashiers ? "is-on" : null)"
                                aria-pressed="@(tab == Tab.Cashiers)" @onclick="() => tab = Tab.Cashiers">
                            Cashiers<span class="shop-seg-count">@AccountsInDepot.Count</span>
                        </button>
                    </div>

                    <label class="shop-search-box">
                        <i class="bi bi-search"></i>
                        <input type="search" placeholder="@(tab == Tab.Vendors ? "Filter by name, code, VAT…" : "Filter cashiers")"
                               aria-label="Filter" value="@query" @oninput="e => query = e.Value?.ToString() ?? string.Empty" />
                    </label>

                    <NocturneSelect Class="nsel-auto" TValue="string" Options="DepotFilterOptions"
                                    @bind-Value="depotFilter" Caption="Depot" AriaLabel="Filter by depot"
                                    Placeholder="All depots" />

                    @if (tab == Tab.Vendors)
                    {
                        <div class="shop-seg" role="group" aria-label="Filter by status">
                            @foreach (var option in StatusOptions)
                            {
                                <button type="button" class="shop-seg-btn @(status == option ? "is-on" : null)"
                                        aria-pressed="@(status == option)" @onclick="() => status = option">
                                    @option<span class="shop-seg-count">@CountFor(option)</span>
                                </button>
                            }
                        </div>
                    }

                    <span class="shop-result">@ResultLabel</span>
                </div>

                <div class="shop-table-wrap">
                    @if (tab == Tab.Vendors)
                    {
                        @if (VisibleVendors.Count == 0)
                        {
                            <div class="shop-empty">
                                <i class="bi bi-people"></i>
                                @if (VendorsInDepot.Count == 0)
                                {
                                    <h3>No vendors at @(string.IsNullOrEmpty(depotFilter) ? "any depot" : DepotName(depotFilter)) yet</h3>
                                    <p>Add one, and the depot's cashiers can invoice them once the till refreshes its list.</p>
                                    <button type="button" class="shop-btn shop-btn-primary" @onclick="StartNew">
                                        <i class="bi bi-plus-lg"></i>Add vendor
                                    </button>
                                }
                                else
                                {
                                    <h3>No vendors match</h3>
                                    <p>Clear the filter, or add a vendor to this depot.</p>
                                    <button type="button" class="shop-btn shop-btn-ghost" @onclick="ClearFilters">Clear filters</button>
                                }
                            </div>
                        }
                        else
                        {
                            @* The whole row opens the vendor, as the design has it; the name is also a real
                               link so the row can be reached from the keyboard and opened in a new tab. The
                               action cell stops the click, or each button would open the vendor as well. *@
                            <table class="shop-table vend-table">
                                <thead>
                                    <tr>
                                        <th>Vendor</th>
                                        <th>Depot</th>
                                        <th>Phone</th>
                                        <th class="vend-num">Sales MTD</th>
                                        <th class="vend-num">Invoices MTD</th>
                                        <th>Last sale</th>
                                        <th>Status</th>
                                        <th><span class="visually-hidden">Actions</span></th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var vendor in VisibleVendors)
                                    {
                                        var sales = SalesRowFor(vendor);
                                        <tr @key="vendor.Id" class="vend-row" @onclick="() => OpenVendor(vendor)">
                                            <td>
                                                <div class="vend-person">
                                                    <span class="vend-avatar" aria-hidden="true">@VendorSalesDigest.Initials(vendor.Name, vendor.Surname)</span>
                                                    <span class="vend-person-text">
                                                        <a class="vend-person-name" href="@VendorHref(vendor)" @onclick:stopPropagation="true">@VendorName(vendor)</a>
                                                        <span class="vend-person-sub">@vendor.Code</span>
                                                    </span>
                                                </div>
                                            </td>
                                            <td class="vend-cell-soft">@DepotName(vendor.AssignedBusinessPartnerCode)</td>
                                            <td class="vend-cell-mute vend-nowrap">@Dash(vendor.Phone)</td>
                                            <td class="vend-num">@SalesCell(sales, row => VendorSalesDigest.MoneyLabel(row.TotalsByCurrency))</td>
                                            <td class="vend-num vend-cell-soft">@SalesCell(sales, row => row.SaleCount == 0 ? "—" : row.SaleCount.ToString("N0"))</td>
                                            <td class="vend-cell-mute vend-nowrap">@SalesCell(sales, row => VendorSalesDigest.LastSaleLabel(row.LastSaleAt, today))</td>
                                            <td>
                                                <span class="shop-chip @(vendor.IsActive ? "shop-chip-good" : "shop-chip-neutral")">
                                                    @(vendor.IsActive ? "Active" : "Removed")
                                                </span>
                                            </td>
                                            <td @onclick:stopPropagation="true">
                                                <div class="shop-row-act">
                                                    <button type="button" class="shop-action-btn"
                                                            title="Sales for @VendorName(vendor)" aria-label="Sales for @VendorName(vendor)"
                                                            @onclick="@(() => Navigation.NavigateTo(VendorSalesHref(vendor)))">
                                                        <i class="bi bi-graph-up"></i>
                                                    </button>
                                                    <button type="button" class="shop-action-btn"
                                                            title="Edit @VendorName(vendor)" aria-label="Edit @VendorName(vendor)"
                                                            @onclick="() => StartEdit(vendor)" disabled="@isSaving">
                                                        <i class="bi bi-pencil"></i>
                                                    </button>
                                                    <button type="button" class="shop-action-btn"
                                                            title="@(vendor.IsActive ? "Remove" : "Restore") @VendorName(vendor)"
                                                            aria-label="@(vendor.IsActive ? "Remove" : "Restore") @VendorName(vendor)"
                                                            @onclick="() => StartToggle(vendor)" disabled="@isSaving">
                                                        <i class="bi @(vendor.IsActive ? "bi-person-dash" : "bi-arrow-counterclockwise")"></i>
                                                    </button>
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        }
                    }
                    else
                    {
                        @if (VisibleAccounts.Count == 0)
                        {
                            <div class="shop-empty">
                                <i class="bi bi-person-badge"></i>
                                <h3>No cashiers match that filter</h3>
                                <button type="button" class="shop-btn shop-btn-ghost" @onclick="ClearFilters">Clear filters</button>
                            </div>
                        }
                        else
                        {
                            <table class="shop-table vend-table">
                                <thead>
                                    <tr>
                                        <th>Cashier</th>
                                        <th>Depot</th>
                                        <th>Draws stock from</th>
                                        <th>Cost centre</th>
                                        <th class="vend-num">Vendors served</th>
                                        <th>Last sign-in</th>
                                        <th>Status</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var account in VisibleAccounts)
                                    {
                                        <tr @key="account.UserId">
                                            <td>
                                                <div class="vend-person">
                                                    <span class="vend-avatar" aria-hidden="true">@VendorSalesDigest.Initials(account.FullName ?? account.Username)</span>
                                                    <span class="vend-person-text">
                                                        <span class="vend-person-name">@(string.IsNullOrWhiteSpace(account.FullName) ? account.Username : account.FullName)</span>
                                                        <span class="vend-person-sub">@account.Username</span>
                                                    </span>
                                                </div>
                                            </td>
                                            <td class="vend-cell-soft">@(account.BusinessPartnerCode is null ? "Not set" : DepotName(account.BusinessPartnerCode))</td>
                                            <td class="vend-cell-mute">@(account.WarehouseCode ?? "Not set")</td>
                                            <td class="vend-cell-mute">@(account.CostCentreCode ?? "Not set")</td>
                                            <td class="vend-num">@account.ActiveVendorCount</td>
                                            <td class="vend-cell-mute vend-nowrap">@(account.LastLoginAt is { } seen ? IAuditService.ToCAT(seen).ToString("dd MMM yyyy HH:mm") : "Never")</td>
                                            <td>
                                                @if (!account.IsActive)
                                                {
                                                    <span class="shop-chip shop-chip-neutral">Inactive</span>
                                                }
                                                else if (account.SetupProblem is not null)
                                                {
                                                    <span class="shop-chip shop-chip-bad" title="@account.SetupProblem">Cannot sell</span>
                                                    <div class="shop-form-hint">@account.SetupProblem</div>
                                                }
                                                else
                                                {
                                                    <span class="shop-chip shop-chip-good">Ready</span>
                                                }
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        }
                    }
                </div>
            }
        }
    }
</div>

@if (dialog is DialogMode.Import)
{
    @* The upload: pick a file, see every row checked by the API, then import. Nothing is saved
       until the button in the footer, and the button stays off while any row has a problem —
       the API refuses a file with a bad row outright, so offering it would only be a refusal. *@
    <div class="shop-overlay" @onclick="CloseDialog">
        <div class="shop-modal vend-import-modal" role="dialog" aria-modal="true" aria-labelledby="vend-import-title"
             @onclick:stopPropagation="true">
            <div class="shop-modal-header">
                <h2 id="vend-import-title">Upload vendors</h2>
                <button type="button" class="shop-modal-close" @onclick="CloseDialog"
                        aria-label="Close dialog" disabled="@(isSaving || isReadingFile)">
                    <i class="bi bi-x-lg"></i>
                </button>
            </div>

            <div class="shop-modal-body">
                @if (error is not null)
                {
                    <div class="shop-alert" role="alert">
                        <i class="bi bi-exclamation-triangle-fill"></i>
                        <span>@error</span>
                    </div>
                }

                <div class="vend-import-steps">
                    <div class="vend-import-step">
                        <span class="vend-import-step-num">1</span>
                        <div>
                            <strong>Fill in the template</strong>
                            <p>
                                One vendor per row. Codes are the depot's prefix and three digits —
                                @PrefixSummary. Leave a code blank to take the depot's next number.
                            </p>
                            <button type="button" class="shop-btn shop-btn-ghost" @onclick="DownloadTemplateAsync" disabled="@isDownloadingTemplate">
                                <i class="bi bi-file-earmark-arrow-down"></i>@(isDownloadingTemplate ? "Preparing…" : "Download template")
                            </button>
                        </div>
                    </div>
                    <div class="vend-import-step">
                        <span class="vend-import-step-num">2</span>
                        <div>
                            <strong>Upload it to check</strong>
                            <p>Every row is checked first. Nothing is added until you import.</p>
                            <label class="vend-import-drop @(isReadingFile ? "is-busy" : null)">
                                <InputFile @key="importFileKey" OnChange="OnImportFileSelected" accept=".xlsx"
                                           disabled="@(isReadingFile || isSaving)" />
                                <i class="bi @(isReadingFile ? "bi-hourglass-split" : "bi-cloud-arrow-up")"></i>
                                <span>
                                    @if (isReadingFile)
                                    {
                                        <text>Checking @importFileName…</text>
                                    }
                                    else if (importFileName is not null)
                                    {
                                        <strong>@importFileName</strong><text> — choose another file</text>
                                    }
                                    else
                                    {
                                        <text>Choose the filled-in .xlsx, or drop it here</text>
                                    }
                                </span>
                            </label>
                        </div>
                    </div>
                </div>

                @if (importResult is not null)
                {
                    <div class="vend-import-summary">
                        <span class="vend-import-chip is-good">@importResult.CreateCount to add</span>
                        @if (importResult.RestoreCount > 0)
                        {
                            <span class="vend-import-chip is-info">@importResult.RestoreCount to restore</span>
                        }
                        @if (importResult.ErrorCount > 0)
                        {
                            <span class="vend-import-chip is-bad">@importResult.ErrorCount with problems</span>
                            <span class="shop-form-hint">Fix these rows in the file and upload it again.</span>
                        }
                    </div>

                    <div class="vend-import-table-wrap">
                        <table class="vend-import-table">
                            <thead>
                                <tr>
                                    <th class="vend-num">Row</th>
                                    <th>Code</th>
                                    <th>Depot</th>
                                    <th>Vendor</th>
                                    <th>Status</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var row in ImportRowsInView)
                                {
                                    <tr @key="row.RowNumber" class="@(row.Action == "Error" ? "has-error" : null)">
                                        <td class="vend-num">@row.RowNumber</td>
                                        <td>
                                            @if (row.Code is not null)
                                            {
                                                <span class="vend-import-code">@row.Code</span>
                                                @if (row.CodeIssued)
                                                {
                                                    <span class="vend-import-issued" title="Left blank in the file; this is the depot's next number">new</span>
                                                }
                                            }
                                            else
                                            {
                                                <span class="vend-import-mute">—</span>
                                            }
                                        </td>
                                        <td>@(row.Depot is null ? "—" : DepotName(row.Depot))</td>
                                        <td>@ImportRowName(row)</td>
                                        <td>
                                            @switch (row.Action)
                                            {
                                                case "Create":
                                                    <span class="vend-import-chip is-good">Add</span>
                                                    break;
                                                case "Restore":
                                                    <span class="vend-import-chip is-info">Restore</span>
                                                    break;
                                                default:
                                                    <span class="vend-import-chip is-bad">Problem</span>
                                                    <ul class="vend-import-errors">
                                                        @foreach (var problem in row.Errors)
                                                        {
                                                            <li>@problem</li>
                                                        }
                                                    </ul>
                                                    break;
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>

            <div class="shop-modal-footer">
                <button type="button" class="shop-btn shop-btn-ghost" @onclick="CloseDialog" disabled="@(isSaving || isReadingFile)">Cancel</button>
                <button type="button" class="shop-btn shop-btn-primary" @onclick="ConfirmImportAsync"
                        disabled="@(isSaving || isReadingFile || importResult is null || importResult.ErrorCount > 0 || importRows.Count == 0)">
                    @ImportAction
                </button>
            </div>
        </div>
    </div>
}
else if (dialog is not DialogMode.None)
{
    <div class="shop-overlay" @onclick="CloseDialog">
        <div class="shop-modal" role="dialog" aria-modal="true" aria-labelledby="vend-dialog-title"
             @onclick:stopPropagation="true">
            <div class="shop-modal-header @(dialog is DialogMode.Remove ? "shop-alert-head" : null)">
                <h2 id="vend-dialog-title">@DialogTitle</h2>
                <button type="button" class="shop-modal-close" @onclick="CloseDialog"
                        aria-label="Close dialog" disabled="@isSaving">
                    <i class="bi bi-x-lg"></i>
                </button>
            </div>

            <div class="shop-modal-body">
                @if (error is not null)
                {
                    <div class="shop-alert" role="alert">
                        <i class="bi bi-exclamation-triangle-fill"></i>
                        <span>@error</span>
                    </div>
                }

                @if (dialog is DialogMode.Remove && removing is not null)
                {
                    <p class="shop-form-hint">
                        @VendorName(removing) will no longer be offered at @DepotName(removing.AssignedBusinessPartnerCode),
                        and a till still holding the old list will be refused if it tries to invoice them. Their sales
                        history stays, and you can restore them here later.
                    </p>
                }
                else if (editing is not null)
                {
                    <div class="shop-form-grid">
                        <div class="shop-form-field shop-form-full">
                            <label for="vend-depot">Depot <span class="required">*</span></label>
                            <NocturneSelect Class="nsel-block" TValue="string" Id="vend-depot"
                                            Options="DepotChoiceOptions" @bind-Value="editing.AssignedBusinessPartnerCode"
                                            AriaLabel="Depot" Placeholder="Select depot" />
                            @if (editing.Id > 0 && !string.Equals(editing.AssignedBusinessPartnerCode, originalDepot, StringComparison.OrdinalIgnoreCase))
                            {
                                <small class="shop-form-hint">
                                    Moving this vendor takes them off @DepotName(originalDepot)'s tills. Their past sales stay
                                    where they were made.
                                </small>
                            }
                        </div>

                        <div class="shop-form-field">
                            <label for="vend-name">First name <span class="required">*</span></label>
                            <input id="vend-name" class="shop-input" @bind="editing.Name" placeholder="Tendai" />
                        </div>
                        <div class="shop-form-field">
                            <label for="vend-surname">Surname</label>
                            <input id="vend-surname" class="shop-input" @bind="editing.Surname" placeholder="Moyo" />
                        </div>

                        <div class="shop-form-field">
                            <label for="vend-code">
                                Vendor code
                                @if (editing.Id > 0)
                                {
                                    <i class="bi bi-lock-fill shop-label-lock" aria-hidden="true"
                                       title="A vendor's code cannot be changed once it is created"></i>
                                }
                            </label>
                            @* Locked once set: the till invoices a vendor by this code and keeps a
                               cached copy of the list, so renaming it would have those tills refused
                               until they next refresh. *@
                            <input id="vend-code" class="shop-input" @bind="editing.Code"
                                   placeholder="@CodePlaceholder" disabled="@(editing.Id > 0)" />
                            @if (editing.Id == 0 && EditingDepot is { } codeDepot)
                            {
                                <small class="shop-form-hint">
                                    @(codeDepot.VendorCodePrefix is null
                                        ? $"Vendors cannot be added here: {codeDepot.VendorCodeProblem}."
                                        : $"{codeDepot.VendorCodePrefix} and three digits, like {codeDepot.VendorCodePrefix}001.")
                                </small>
                            }
                        </div>
                        <div class="shop-form-field">
                            <label for="vend-phone">Phone</label>
                            <input id="vend-phone" class="shop-input" @bind="editing.Phone" placeholder="0771 234 567" />
                        </div>

                        <div class="shop-form-field">
                            <label for="vend-vat">VAT number</label>
                            <input id="vend-vat" class="shop-input" @bind="editing.VatNumber" />
                        </div>
                        <div class="shop-form-field">
                            <label for="vend-email">Email</label>
                            <input id="vend-email" class="shop-input" type="email" @bind="editing.Email" />
                        </div>

                        <div class="shop-form-field shop-form-full">
                            <label for="vend-address">Address</label>
                            <textarea id="vend-address" class="shop-input" rows="2" @bind="editing.Address"></textarea>
                        </div>
                    </div>
                }
            </div>

            <div class="shop-modal-footer">
                <button type="button" class="shop-btn shop-btn-ghost" @onclick="CloseDialog" disabled="@isSaving">Cancel</button>
                <button type="button"
                        class="shop-btn @(dialog is DialogMode.Remove ? "shop-btn-danger" : "shop-btn-primary")"
                        @onclick="ConfirmDialogAsync" disabled="@isSaving">
                    @DialogAction
                </button>
            </div>
        </div>
    </div>
}

@code {
    private enum Tab { Vendors, Cashiers }
    private enum DialogMode { None, Add, Edit, Remove, Import }

    private const long MaxImportFileBytes = 5 * 1024 * 1024;

    /// <summary>Set on /vending/vendors/{id}, where the page shows that one vendor instead of the list.</summary>
    [Parameter] public int? VendorId { get; set; }

    private VendingOverviewModel? overview;
    private Dictionary<string, string> partnerNames = new(StringComparer.OrdinalIgnoreCase);

    private Tab tab = Tab.Vendors;
    private DialogMode dialog = DialogMode.None;
    private RouteCustomerModel? editing;
    private RouteCustomerModel? removing;
    private string? originalDepot;

    private bool isLoading = true;
    private bool isSaving;
    private string? error;
    private string? notice;

    private bool isDownloadingTemplate;
    private bool isReadingFile;
    private Guid importFileKey = Guid.NewGuid();
    private string? importFileName;
    private List<ImportVendorRowModel> importRows = [];
    private ImportVendorsResultModel? importResult;

    private static readonly string[] StatusOptions = ["Active", "Removed", "All"];
    private string status = "Active";
    private string query = string.Empty;
    private string? depotFilter;

    // Month to date, from the route-customer sales summary: one read per depot, keyed back by vendor id.
    private readonly DateTime today = IAuditService.ToCAT(DateTime.UtcNow).Date;
    private Dictionary<int, RouteCustomerSalesRowModel> vendorSales = [];
    private Dictionary<string, List<RouteCustomerSalesTotalsModel>> depotSales = new(StringComparer.OrdinalIgnoreCase);
    private bool salesLoading;
    private string? salesError;

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();

        try
        {
            // Names only, for the depot labels. A failed lookup leaves the codes showing, which is
            // still correct, so it is not worth an error on the page.
            var codes = overview?.Depots.Select(depot => depot.BusinessPartnerCode).ToHashSet(StringComparer.OrdinalIgnoreCase) ?? [];
            partnerNames = (await MasterDataCache.GetBusinessPartnersAsync())
                .Where(partner => partner.CardCode is not null && codes.Contains(partner.CardCode) && !string.IsNullOrWhiteSpace(partner.CardName))
                .GroupBy(partner => partner.CardCode!, StringComparer.OrdinalIgnoreCase)
                .ToDictionary(group => group.Key, group => group.First().CardName!, StringComparer.OrdinalIgnoreCase);
        }
        catch (Exception)
        {
        }

        // The list is usable without the sales figures, so it goes on screen before they are asked for.
        StateHasChanged();
        await LoadSalesAsync();
    }

    private async Task LoadSalesAsync()
    {
        if (overview is null || overview.Depots.Count == 0)
        {
            return;
        }

        salesLoading = true;
        salesError = null;
        try
        {
            var rows = new Dictionary<int, RouteCustomerSalesRowModel>();
            var totals = new Dictionary<string, List<RouteCustomerSalesTotalsModel>>(StringComparer.OrdinalIgnoreCase);

            // One depot at a time rather than all at once: the reads share this circuit's HttpClient and
            // its token refresh, and there are only ever a handful of depots.
            foreach (var depot in overview.Depots)
            {
                var summary = await RouteCustomerService.GetSalesSummaryAsync(
                    depot.BusinessPartnerCode, VendorSalesDigest.MonthStart(today), today, includeInactive: true,
                    scope: RouteCustomerScope.Vending);

                foreach (var route in summary.Routes)
                {
                    totals[route.AssignedBusinessPartnerCode] = route.TotalsByCurrency;
                    foreach (var row in route.Customers)
                    {
                        if (row.RouteCustomerId is { } id)
                        {
                            rows[id] = row;
                        }
                    }
                }

                totals.TryAdd(depot.BusinessPartnerCode, []);
            }

            vendorSales = rows;
            depotSales = totals;
        }
        catch (InvalidOperationException ex)
        {
            salesError = $"Sales figures could not be loaded: {ex.Message}";
        }
        finally
        {
            salesLoading = false;
        }
    }

    private async Task LoadAsync()
    {
        isLoading = true;
        try
        {
            overview = await VendingService.GetOverviewAsync();
            error = null;
        }
        catch (InvalidOperationException ex)
        {
            error = ex.Message;
        }
        finally
        {
            isLoading = false;
        }
    }

    // ── Reading ────────────────────────────────────────────────────────────

    private string DepotName(string? code) =>
        code is null ? "—" : partnerNames.TryGetValue(code, out var name) ? name : code;

    private static string VendorName(RouteCustomerModel vendor) =>
        string.IsNullOrWhiteSpace(vendor.Surname) ? vendor.Name : $"{vendor.Name} {vendor.Surname}";

    private static string Dash(string? value) => string.IsNullOrWhiteSpace(value) ? "—" : value;

    private static string CodesOrDash(List<string> codes) => codes.Count == 0 ? "Not set" : string.Join(", ", codes);

    private static string PrefixPattern(string? prefix) => $"{prefix}###";

    private static string DepotMeta(VendingDepotModel depot) =>
        string.Join(" · ", new[] { depot.BusinessPartnerCode }
            .Concat(depot.WarehouseCodes.Count == 0 ? ["no warehouse"] : depot.WarehouseCodes)
            .Concat(depot.CostCentreCodes));

    private RouteCustomerModel? SelectedVendor =>
        VendorId is { } id ? overview?.Vendors.FirstOrDefault(vendor => vendor.Id == id) : null;

    private VendingDepotModel? DepotFor(string? code) =>
        overview?.Depots.FirstOrDefault(depot => string.Equals(depot.BusinessPartnerCode, code, StringComparison.OrdinalIgnoreCase));

    private IReadOnlyList<VendingAccountModel> CashiersFor(string? code) =>
        overview?.Accounts
            .Where(account => account.IsActive && string.Equals(account.BusinessPartnerCode, code, StringComparison.OrdinalIgnoreCase))
            .ToList() ?? [];

    private RouteCustomerSalesRowModel? SalesRowFor(RouteCustomerModel vendor) =>
        vendorSales.GetValueOrDefault(vendor.Id);

    /// <summary>
    /// A figure from the summary. Blank while it loads and a dash once it has failed — never a zero, which
    /// would say a vendor sold nothing. A vendor the summary has no row for sold nothing this month.
    /// </summary>
    private MarkupString SalesCell(RouteCustomerSalesRowModel? row, Func<RouteCustomerSalesRowModel, string> figure)
    {
        if (salesLoading)
        {
            return new MarkupString("<span class=\"vend-skel\" aria-label=\"Loading\"></span>");
        }

        if (salesError is not null)
        {
            return new MarkupString("—");
        }

        return new MarkupString(System.Net.WebUtility.HtmlEncode(figure(row ?? new RouteCustomerSalesRowModel())));
    }

    private string DepotSalesLabel(string code) =>
        salesError is not null
            ? "—"
            : VendorSalesDigest.MoneyLabel(depotSales.GetValueOrDefault(code), decimals: 0);

    private static string VendorHref(RouteCustomerModel vendor) => $"/vending/vendors/{vendor.Id}";

    /// <summary>
    /// A vendor's sales stay under /vending. They used to be shown on the route customer sales page,
    /// which framed the vendor's depot as the route it was booked against — a vendor has no route.
    /// </summary>
    private static string VendorSalesHref(RouteCustomerModel vendor) => $"/vending/vendors/{vendor.Id}/sales";

    private void OpenVendor(RouteCustomerModel vendor) => Navigation.NavigateTo(VendorHref(vendor));

    private static string PrefixTitle(VendingDepotModel depot) =>
        depot.NextVendorCode is null
            ? $"Vendor codes at this depot are {depot.VendorCodePrefix} and three digits"
            : $"Vendor codes at this depot are {depot.VendorCodePrefix} and three digits; the next is {depot.NextVendorCode}";

    private VendingDepotModel? EditingDepot =>
        editing is null || string.IsNullOrEmpty(editing.AssignedBusinessPartnerCode)
            ? null
            : overview?.Depots.FirstOrDefault(depot =>
                string.Equals(depot.BusinessPartnerCode, editing.AssignedBusinessPartnerCode, StringComparison.OrdinalIgnoreCase));

    private string CodePlaceholder => EditingDepot?.NextVendorCode is { } next
        ? $"{next} if left blank"
        : "Given the depot's next number if left blank";

    private bool InDepot(string? code) =>
        string.IsNullOrEmpty(depotFilter) || string.Equals(code, depotFilter, StringComparison.OrdinalIgnoreCase);

    private List<RouteCustomerModel> VendorsInDepot =>
        overview?.Vendors.Where(vendor => InDepot(vendor.AssignedBusinessPartnerCode)).ToList() ?? [];

    private List<VendingAccountModel> AccountsInDepot =>
        overview?.Accounts.Where(account => InDepot(account.BusinessPartnerCode)).ToList() ?? [];

    private List<RouteCustomerModel> VisibleVendors
    {
        get
        {
            var term = query.Trim();
            return VendorsInDepot
                .Where(vendor => status switch
                {
                    "Active" => vendor.IsActive,
                    "Removed" => !vendor.IsActive,
                    _ => true
                })
                .Where(vendor => term.Length == 0 ||
                    Has(vendor.Code, term) || Has(VendorName(vendor), term) ||
                    Has(vendor.Phone, term) || Has(vendor.VatNumber, term) ||
                    Has(DepotName(vendor.AssignedBusinessPartnerCode), term))
                .ToList();
        }
    }

    private List<VendingAccountModel> VisibleAccounts
    {
        get
        {
            var term = query.Trim();
            return AccountsInDepot
                .Where(account => term.Length == 0 ||
                    Has(account.Username, term) || Has(account.FullName, term) ||
                    Has(account.WarehouseCode, term) || Has(account.CostCentreCode, term))
                .ToList();
        }
    }

    private static bool Has(string? value, string term) =>
        value is not null && value.Contains(term, StringComparison.OrdinalIgnoreCase);

    private int CountFor(string option) => option switch
    {
        "Active" => VendorsInDepot.Count(vendor => vendor.IsActive),
        "Removed" => VendorsInDepot.Count(vendor => !vendor.IsActive),
        _ => VendorsInDepot.Count
    };

    private string ResultLabel => tab == Tab.Vendors
        ? $"{VisibleVendors.Count} of {VendorsInDepot.Count} vendors"
        : $"{VisibleAccounts.Count} of {AccountsInDepot.Count} cashiers";

    private List<NocturneSelectOption<string>> DepotFilterOptions =>
    [
        new(string.Empty, "All depots") { IsUnset = true, RuleAfter = true },
        .. (overview?.Depots ?? []).Select(depot =>
            new NocturneSelectOption<string>(depot.BusinessPartnerCode, DepotName(depot.BusinessPartnerCode))
            {
                Hint = depot.BusinessPartnerCode
            })
    ];

    private List<NocturneSelectOption<string>> DepotChoiceOptions =>
        (overview?.Depots ?? [])
            .Select(depot => new NocturneSelectOption<string>(depot.BusinessPartnerCode, DepotName(depot.BusinessPartnerCode))
            {
                Hint = string.Join(", ", depot.WarehouseCodes)
            })
            .ToList();

    private void ToggleDepot(string code) =>
        depotFilter = string.Equals(depotFilter, code, StringComparison.OrdinalIgnoreCase) ? null : code;

    private void ClearFilters()
    {
        query = string.Empty;
        status = "Active";
        depotFilter = null;
    }

    // ── Dialog ─────────────────────────────────────────────────────────────

    private string DialogTitle => dialog switch
    {
        DialogMode.Add => "Add vendor",
        DialogMode.Edit => editing is null ? "Edit vendor" : $"Edit {VendorName(editing)}",
        DialogMode.Remove => "Remove this vendor?",
        _ => string.Empty
    };

    private string DialogAction => dialog switch
    {
        DialogMode.Add => isSaving ? "Adding…" : "Add vendor",
        DialogMode.Edit => isSaving ? "Saving…" : "Save changes",
        DialogMode.Remove => isSaving ? "Removing…" : "Remove vendor",
        _ => string.Empty
    };

    private void StartNew()
    {
        error = null;
        removing = null;
        originalDepot = null;
        // Opened on the depot being looked at, which is almost always the one being added to.
        editing = new RouteCustomerModel
        {
            IsActive = true,
            AssignedBusinessPartnerCode = !string.IsNullOrEmpty(depotFilter)
                ? depotFilter
                : overview?.Depots.Count == 1 ? overview.Depots[0].BusinessPartnerCode : string.Empty
        };
        dialog = DialogMode.Add;
    }

    private void StartEdit(RouteCustomerModel vendor)
    {
        error = null;
        removing = null;
        editing = ShopInventory.Web.Services.VendingService.Copy(vendor);
        originalDepot = vendor.AssignedBusinessPartnerCode;
        dialog = DialogMode.Edit;
    }

    /// <summary>Removing asks first; restoring does not, because it is the undo.</summary>
    private async Task StartToggle(RouteCustomerModel vendor)
    {
        error = null;
        if (!vendor.IsActive)
        {
            await SetActiveAsync(vendor, active: true);
            return;
        }

        editing = null;
        removing = vendor;
        dialog = DialogMode.Remove;
    }

    private void CloseDialog()
    {
        if (isSaving || isReadingFile)
        {
            return;
        }

        dialog = DialogMode.None;
        editing = null;
        removing = null;
        error = null;
        ResetImport();
    }

    private async Task ConfirmDialogAsync()
    {
        if (dialog is DialogMode.Remove)
        {
            if (removing is not null)
            {
                await SetActiveAsync(removing, active: false);
            }

            return;
        }

        await SaveAsync();
    }

    private async Task SaveAsync()
    {
        if (editing is null)
        {
            return;
        }

        if (string.IsNullOrWhiteSpace(editing.AssignedBusinessPartnerCode))
        {
            error = "Choose the depot this vendor buys from.";
            return;
        }

        if (string.IsNullOrWhiteSpace(editing.Name))
        {
            error = "A vendor needs at least a first name.";
            return;
        }

        isSaving = true;
        error = null;
        try
        {
            var (saved, failure) = await VendingService.SaveVendorAsync(editing);
            if (saved is null)
            {
                error = failure ?? "The vendor could not be saved.";
                return;
            }

            dialog = DialogMode.None;
            editing = null;
            await LoadAsync();
        }
        finally
        {
            isSaving = false;
        }
    }

    // ── Upload ─────────────────────────────────────────────────────────────

    private string PrefixSummary
    {
        get
        {
            var prefixes = (overview?.Depots ?? [])
                .Where(depot => depot.VendorCodePrefix is not null)
                .Select(depot => $"{depot.VendorCodePrefix} for {string.Join(", ", depot.WarehouseCodes)}")
                .Distinct()
                .ToList();

            return prefixes.Count == 0 ? "no depot has a prefix yet" : string.Join(", ", prefixes);
        }
    }

    /// <summary>Problems first: in a long file they are the rows someone has to go and find.</summary>
    private IEnumerable<ImportVendorRowResultModel> ImportRowsInView =>
        (importResult?.Rows ?? [])
            .OrderBy(row => row.Action == "Error" ? 0 : 1)
            .ThenBy(row => row.RowNumber);

    private static string ImportRowName(ImportVendorRowResultModel row)
    {
        var name = $"{row.Name} {row.Surname}".Trim();
        return name.Length == 0 ? "—" : name;
    }

    private string ImportAction
    {
        get
        {
            if (isSaving)
            {
                return "Importing…";
            }

            var count = (importResult?.CreateCount ?? 0) + (importResult?.RestoreCount ?? 0);
            return count == 0 ? "Import vendors" : count == 1 ? "Import 1 vendor" : $"Import {count} vendors";
        }
    }

    private void StartImport()
    {
        error = null;
        notice = null;
        editing = null;
        removing = null;
        ResetImport();
        dialog = DialogMode.Import;
    }

    private void ResetImport()
    {
        importFileName = null;
        importRows = [];
        importResult = null;
        importFileKey = Guid.NewGuid();
    }

    private async Task DownloadTemplateAsync()
    {
        isDownloadingTemplate = true;
        error = null;
        try
        {
            var template = await Mediator.Send(new GetVendorImportTemplateQuery());
            if (template.IsError)
            {
                error = template.FirstError.Description;
                return;
            }

            await JS.InvokeVoidAsync("downloadFile", template.Value.FileName,
                "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet",
                Convert.ToBase64String(template.Value.Content));
        }
        finally
        {
            isDownloadingTemplate = false;
        }
    }

    /// <summary>Reads the file, then has the API check every row without saving anything.</summary>
    private async Task OnImportFileSelected(InputFileChangeEventArgs e)
    {
        var file = e.File;
        error = null;
        importResult = null;
        importRows = [];
        importFileName = file.Name;

        if (!file.Name.EndsWith(".xlsx", StringComparison.OrdinalIgnoreCase))
        {
            error = "Upload the template as an .xlsx file.";
            importFileKey = Guid.NewGuid();
            return;
        }

        if (file.Size > MaxImportFileBytes)
        {
            error = "That file is larger than 5 MB. A vendor sheet should be a fraction of that — check it is the template.";
            importFileKey = Guid.NewGuid();
            return;
        }

        isReadingFile = true;
        try
        {
            using var buffer = new MemoryStream();
            await using (var stream = file.OpenReadStream(MaxImportFileBytes))
            {
                await stream.CopyToAsync(buffer);
            }

            var rows = await Mediator.Send(new ReadVendorImportFileQuery(buffer.ToArray()));
            if (rows.IsError)
            {
                error = rows.FirstError.Description;
                return;
            }

            var checkedRows = await Mediator.Send(new ImportVendorsCommand(rows.Value, ValidateOnly: true));
            if (checkedRows.IsError)
            {
                error = checkedRows.FirstError.Description;
                return;
            }

            importRows = rows.Value;
            importResult = checkedRows.Value;
        }
        catch (IOException ex)
        {
            error = $"The file could not be read: {ex.Message}";
        }
        finally
        {
            isReadingFile = false;
            // A fresh input, so choosing the same file again after fixing it still raises OnChange.
            importFileKey = Guid.NewGuid();
        }
    }

    private async Task ConfirmImportAsync()
    {
        if (importResult is null || importResult.ErrorCount > 0 || importRows.Count == 0)
        {
            return;
        }

        isSaving = true;
        error = null;
        try
        {
            var imported = await Mediator.Send(new ImportVendorsCommand(importRows, ValidateOnly: false));
            if (imported.IsError)
            {
                error = imported.FirstError.Description;
                return;
            }

            if (!imported.Value.Imported)
            {
                // Something changed between the check and the import — a code taken meanwhile. Show
                // the fresh verdict rather than a bare refusal.
                importResult = imported.Value;
                error = "Nothing was imported: the rows below changed since the file was checked.";
                return;
            }

            var added = imported.Value.CreateCount;
            var restored = imported.Value.RestoreCount;
            notice = restored == 0
                ? $"Imported {Plural(added, "vendor")}."
                : $"Imported {Plural(added, "new vendor")} and restored {Plural(restored, "removed one")}.";

            isSaving = false;
            dialog = DialogMode.None;
            ResetImport();
            await LoadAsync();
        }
        finally
        {
            isSaving = false;
        }
    }

    private static string Plural(int count, string noun) => count == 1 ? $"1 {noun}" : $"{count} {noun}s";

    private async Task SetActiveAsync(RouteCustomerModel vendor, bool active)
    {
        isSaving = true;
        error = null;
        try
        {
            var failure = await VendingService.SetVendorActiveAsync(vendor, active);
            if (failure is not null)
            {
                error = failure;
                return;
            }

            dialog = DialogMode.None;
            removing = null;
            await LoadAsync();
        }
        finally
        {
            isSaving = false;
        }
    }
}
