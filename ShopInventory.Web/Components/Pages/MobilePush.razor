@page "/mobile-push"
@using Microsoft.AspNetCore.Authorization
@using System.ComponentModel.DataAnnotations
@using ShopInventory.Web.Services
@attribute [Authorize(Roles = "Admin")]
@inject IPushNotificationClientService PushNotificationService
@rendermode InteractiveServer

<PageTitle>Mobile Push - Shop Inventory</PageTitle>

@* The Nocturne sheet is wwwroot/css/mobile-push.css (linked from App.razor),
   derived from driver-shop-access.css — same two-panel shape, and the same
   reason for living in a file rather than in the <style> block this page used
   to carry: app.css's global `.dark-theme input/select/textarea` rules have to
   be out-specified, which a scoped block cannot do.

   Icons are drawn inline rather than from the Phosphor font: the notice's mark
   is the only thing distinguishing a send that worked from one that did not,
   so a font that failed to load would leave it reading as nothing. *@

<div class="mpu">

    <header class="mpu-head">
        <div class="mpu-head-inner">
            <nav class="mpu-crumbs" aria-label="Breadcrumb">
                <span>Administration</span>
                <span class="mpu-crumb-sep" aria-hidden="true">/</span>
                <span class="mpu-crumb-now" aria-current="page">Mobile push</span>
            </nav>
            <div class="mpu-head-actions">
                <button type="button" class="mpu-btn mpu-btn-ghost"
                        disabled="@(isSending || isSendingTest)" @onclick="SendTestPush">
                    @if (isSendingTest)
                    {
                        <span class="mpu-spin" aria-hidden="true"></span>
                        <span>Sending&#8230;</span>
                    }
                    else
                    {
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                             stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <rect x="7" y="2" width="10" height="20" rx="2"></rect>
                            <path d="M11 18h2"></path>
                        </svg>
                        <span>Test my device</span>
                    }
                </button>
            </div>
        </div>
    </header>

    <div class="mpu-body">

        <section class="mpu-hero">
            <div>
                <div class="mpu-kicker">Direct to device</div>
                <h1>Mobile push</h1>
                <p>
                    High-priority alerts for registered Android devices. A push arrives whether or not the
                    app is open, so it is for things that cannot wait for the next sync — not for anything
                    the operator would see on their own.
                </p>
            </div>
            <div class="mpu-stat">
                <div class="mpu-stat-line">
                    <span class="mpu-stat-num">@lastSentCount</span>
                    <span class="mpu-stat-of">device@(lastSentCount == 1 ? "" : "s") reached last send</span>
                </div>
                <div class="mpu-stat-foot">
                    @(statusMessage is null ? "Nothing sent this session" : $"Targeted {CurrentTargetLabel}")
                </div>
            </div>
        </section>

        <section class="mpu-grid">

            <!-- â”€â”€ The composer â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€ -->
            <EditForm Model="@form" OnValidSubmit="SendImportantPush" class="mpu-panel mpu-panel-compose">
                <DataAnnotationsValidator />

                <div class="mpu-panel-head">
                    <div class="mpu-panel-title">
                        <h2>Compose</h2>
                        <span class="mpu-count">Important priority</span>
                    </div>
                </div>

                <div class="mpu-panel-body">
                    <div class="mpu-form">

                        <div class="mpu-row">
                            <div class="mpu-field">
                                <label class="mpu-label" for="targetMode">Target</label>
                                <div class="mpu-select">
                                    <select id="targetMode" class="mpu-input" @bind="form.TargetMode">
                                        <option value="Role">Role</option>
                                        <option value="Username">User</option>
                                        <option value="All">All devices</option>
                                    </select>
                                    <span class="mpu-caret" aria-hidden="true"></span>
                                </div>
                            </div>

                            @if (form.TargetMode == "Role")
                            {
                                <div class="mpu-field">
                                    <label class="mpu-label" for="targetRole">Role</label>
                                    <div class="mpu-select">
                                        <select id="targetRole" class="mpu-input" @bind="form.TargetRole">
                                            @foreach (var role in roleOptions)
                                            {
                                                <option value="@role">@role</option>
                                            }
                                        </select>
                                        <span class="mpu-caret" aria-hidden="true"></span>
                                    </div>
                                </div>
                            }
                            else if (form.TargetMode == "Username")
                            {
                                <div class="mpu-field">
                                    <label class="mpu-label" for="targetUsername">Username</label>
                                    <InputText id="targetUsername" class="mpu-input" @bind-Value="form.TargetUsername" />
                                </div>
                            }
                        </div>

                        <div class="mpu-field">
                            <label class="mpu-label" for="pushTitle">Title</label>
                            <InputText id="pushTitle" class="mpu-input" maxlength="80" @bind-Value="form.Title" />
                            <ValidationMessage For="() => form.Title" class="mpu-validation" />
                        </div>

                        <div class="mpu-field">
                            <label class="mpu-label" for="pushBody">Message</label>
                            <InputTextArea id="pushBody" class="mpu-textarea" maxlength="240" @bind-Value="form.Body" />
                            <ValidationMessage For="() => form.Body" class="mpu-validation" />
                        </div>

                    </div>

                    @if (!string.IsNullOrWhiteSpace(statusMessage))
                    {
                        <div class="mpu-notice @(lastResultSucceeded ? "mpu-notice-good" : "mpu-notice-bad")"
                             role="status">
                            @if (lastResultSucceeded)
                            {
                                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                     stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                    <path d="M20 6L9 17l-5-5"></path>
                                </svg>
                            }
                            else
                            {
                                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                     stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                    <circle cx="12" cy="12" r="9"></circle>
                                    <path d="M12 7v6"></path>
                                    <path d="M12 16.5v.01"></path>
                                </svg>
                            }
                            <span>@statusMessage</span>
                        </div>
                    }
                </div>

                <div class="mpu-panel-foot">
                    <span class="mpu-foot-note">Delivered immediately; there is no recall.</span>
                    <button type="submit" class="mpu-btn mpu-btn-primary mpu-btn-lg"
                            disabled="@(isSending || isSendingTest)">
                        @if (isSending)
                        {
                            <span class="mpu-spin" aria-hidden="true"></span>
                            <span>Sending&#8230;</span>
                        }
                        else
                        {
                            <span>Send push</span>
                        }
                    </button>
                </div>
            </EditForm>

            <!-- â”€â”€ The receipt â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€ -->
            <aside class="mpu-panel mpu-panel-receipt">
                <div class="mpu-panel-head">
                    <div class="mpu-panel-title">
                        <h2>Last send</h2>
                    </div>
                </div>
                <div class="mpu-panel-body">
                    <div class="mpu-meta">
                        <div class="mpu-meta-row">
                            <span class="mpu-meta-label">Devices reached</span>
                            <span class="mpu-meta-value mpu-meta-value-lead">@lastSentCount</span>
                        </div>
                        <div class="mpu-meta-row">
                            <span class="mpu-meta-label">Target</span>
                            <span class="mpu-meta-value" title="@CurrentTargetLabel">@CurrentTargetLabel</span>
                        </div>
                        <div class="mpu-meta-row">
                            <span class="mpu-meta-label">Priority</span>
                            <span class="mpu-meta-value">Important</span>
                        </div>
                        <div class="mpu-meta-row">
                            <span class="mpu-meta-label">Result</span>
                            <span class="mpu-meta-value">
                                @(statusMessage is null ? "—" : lastResultSucceeded ? "Sent" : "Failed")
                            </span>
                        </div>
                    </div>
                </div>
            </aside>

        </section>
    </div>
</div>

@code {
    private readonly MobilePushForm form = new();
    private readonly string[] roleOptions = ["Driver", "PodOperator", "Merchandiser", "SalesRep", "Manager", "Cashier", "StockController", "DepotController", "Admin", "User"];
    private bool isSending;
    private bool isSendingTest;
    private string? statusMessage;
    private bool lastResultSucceeded;
    private int lastSentCount;

    private string CurrentTargetLabel => form.TargetMode switch
    {
        "All" => "All devices",
        "Username" => string.IsNullOrWhiteSpace(form.TargetUsername) ? "User" : form.TargetUsername.Trim(),
        _ => form.TargetRole
    };

    private async Task SendImportantPush()
    {
        if (form.TargetMode == "Username" && string.IsNullOrWhiteSpace(form.TargetUsername))
        {
            SetStatus(false, 0, "Username is required for user-targeted pushes.");
            return;
        }

        isSending = true;
        statusMessage = null;

        try
        {
            var targetUsername = form.TargetMode == "Username" ? form.TargetUsername.Trim() : null;
            var targetRole = form.TargetMode == "Role" ? form.TargetRole : null;
            var result = await PushNotificationService.SendImportantPushAsync(new ImportantPushRequest(
                targetUsername,
                targetRole,
                form.Title.Trim(),
                form.Body.Trim()));

            SetStatus(result.IsSuccess, result.Sent, result.IsSuccess
                ? $"Push sent to {result.Sent} device(s)."
                : result.Message);
        }
        finally
        {
            isSending = false;
        }
    }

    private async Task SendTestPush()
    {
        isSendingTest = true;
        statusMessage = null;

        try
        {
            var result = await PushNotificationService.SendTestPushAsync();
            SetStatus(result.IsSuccess, result.Sent, result.IsSuccess
                ? $"Test push sent to {result.Sent} device(s)."
                : result.Message);
        }
        finally
        {
            isSendingTest = false;
        }
    }

    private void SetStatus(bool succeeded, int sent, string message)
    {
        lastResultSucceeded = succeeded;
        lastSentCount = sent;
        statusMessage = message;
    }

    private sealed class MobilePushForm
    {
        public string TargetMode { get; set; } = "Role";
        public string TargetRole { get; set; } = "Driver";
        public string TargetUsername { get; set; } = string.Empty;

        [Required]
        [StringLength(80, MinimumLength = 3)]
        public string Title { get; set; } = "Important POD alert";

        [Required]
        [StringLength(240, MinimumLength = 5)]
        public string Body { get; set; } = string.Empty;
    }
}
