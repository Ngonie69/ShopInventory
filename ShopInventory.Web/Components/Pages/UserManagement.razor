@page "/user-management"
@using ShopInventory.Web.Data
@using ShopInventory.Web.Common
@using ShopInventory.Web.Models
@using ShopInventory.Web.Services
@using Microsoft.AspNetCore.Components.Authorization
@attribute [Authorize(Roles = UserRoles.UserManagementRoles)]
@inject IUserManagementService UserService
@inject IAuditService AuditService
@inject AuthenticationStateProvider AuthStateProvider
@inject IMasterDataCacheService MasterDataCache
@inject IJSRuntime JS
@inject IAppSettingsProvider AppSettings
@inject NavigationManager NavigationManager
@inject ISnackbar Snackbar
@rendermode InteractiveServer

<PageTitle>User Management - Shop Inventory</PageTitle>

<div class="um-page">
    <!-- Page Header -->
    <div class="um-header">
        <div class="um-header-left">
            <div class="um-header-icon">
                <i class="bi bi-people-fill"></i>
            </div>
            <div>
                <h1 class="um-title">@(isPodOperatorView ? "Driver Management" : "User Management")</h1>
                <p class="um-subtitle">@(isPodOperatorView ? "Create and manage driver accounts for POD operations" :
                                                                          "Manage accounts, permissions, and security")</p>
                </div>
            </div>
            <div class="um-header-actions">
                @if (isPodOperatorView)
                {
                    <button class="um-btn um-btn-primary" @onclick="ShowCreateModal"
                            title="Create a driver account for POD operations">
                        <i class="bi bi-truck"></i>
                        <span>Add Driver</span>
                    </button>
                }
                else
                {
                    <button class="um-btn um-btn-primary" @onclick="ShowCreateMobileUserModal"
                            title="Create a PodOperator user for mobile POD uploads">
                        <i class="bi bi-phone"></i>
                        <span>Add Mobile User</span>
                    </button>
                    <button class="um-btn um-btn-primary" @onclick="ShowCreateModal">
                        <i class="bi bi-plus-lg"></i>
                        <span>Add User</span>
                    </button>
                }
            </div>
        </div>

        <!-- Tabs -->
        <div class="um-tabs">
            <button class="um-tab @(activeTab == "users" ? "active" : "")" @onclick="@(() => SetTab("users"))">
                <i class="bi bi-people"></i> Users
                <span class="um-tab-count">@users.Count</span>
            </button>
            @if (!isPodOperatorView)
            {
                <button class="um-tab @(activeTab == "permissions" ? "active" : "")" @onclick="@(() => SetTab("permissions"))">
                    <i class="bi bi-shield-lock"></i> Permissions
                </button>
                <button class="um-tab @(activeTab == "security" ? "active" : "")" @onclick="@(() => SetTab("security"))">
                    <i class="bi bi-fingerprint"></i> Security
                </button>
            }
        </div>

        @if (activeTab == "users")
        {
            <!-- Filter Bar -->
            <div class="um-filter-bar">
                <div class="um-search-box">
                    <i class="bi bi-search"></i>
                    <input type="search" placeholder="Search by name or email..." @bind="searchTerm" @bind:event="oninput"
                           @bind:after="OnSearchChanged" enterkeyhint="search" />
                </div>
                @if (!isPodOperatorView)
                {
                    <select class="um-select" @bind="roleFilter" @bind:after="LoadUsers">
                        <option value="">All Roles</option>
                        @foreach (var role in availableRoles)
                        {
                            <option value="@role">@role</option>
                        }
                    </select>
                }
                <select class="um-select" @bind="statusFilter" @bind:after="LoadUsers">
                    <option value="">All Status</option>
                    <option value="active">Active</option>
                    <option value="inactive">Inactive</option>
                    <option value="locked">Locked</option>
                </select>
                @if (HasActiveFilters)
                {
                    <button class="um-btn um-btn-ghost" @onclick="ResetFilters">
                        <i class="bi bi-x-lg"></i> Clear
                    </button>
                }
            </div>

            <!-- Users List -->
            @if (isLoading)
            {
                <div class="um-loading">
                    <div class="um-spinner"></div>
                    <p>Loading users...</p>
                </div>
            }
            else if (users.Any())
            {
                <div class="um-user-list">
                    @foreach (var user in users)
                    {
                        <div class="um-user-card @(!user.IsActive ? "inactive" : "") @(user.IsLocked ? "locked" : "")">
                            <div class="um-user-main">
                                <div class="um-avatar @GetAvatarClass(user)">
                                    @user.Username[0].ToString().ToUpper()
                                </div>
                                <div class="um-user-info">
                                    <div class="um-user-name">@user.Username</div>
                                    <div class="um-user-email">@(user.Email ?? "No email")</div>
                                </div>
                                <div class="um-user-meta">
                                    <span class="um-badge @GetRoleBadgeClass(user.Role)">@user.Role</span>
                                    @if (user.IsLocked)
                                    {
                                        <span class="um-badge um-badge-locked"><i class="bi bi-lock-fill"></i> Locked</span>
                                    }
                                    else if (user.IsActive)
                                    {
                                        <span class="um-badge um-badge-active">Active</span>
                                    }
                                    else
                                    {
                                        <span class="um-badge um-badge-inactive">Inactive</span>
                                    }
                                    @if (user.TwoFactorEnabled)
                                    {
                                        <span class="um-badge um-badge-2fa"><i class="bi bi-shield-fill-check"></i> 2FA</span>
                                    }
                                </div>
                                <div class="um-user-login">
                                    <span class="um-login-label">Last login</span>
                                    <span class="um-login-time @(user.LastLoginAt.HasValue ? string.Empty : "um-login-never")"
                                          title="@GetLastLoginTitle(user.LastLoginAt)">
                                        @GetLastLoginDisplay(user.LastLoginAt)
                                    </span>
                                </div>
                            </div>
                            <div class="um-user-actions">
                                <button class="um-action-btn" @onclick="@(() => ShowEditModal(user))" title="Edit user">
                                    <i class="bi bi-pencil-square"></i>
                                </button>
                                @if (!isPodOperatorView)
                                {
                                    <button class="um-action-btn" @onclick="@(() => ShowPermissionsModal(user))" title="Manage permissions">
                                        <i class="bi bi-shield-lock"></i>
                                    </button>
                                    <div class="um-action-more">
                                        <button class="um-action-btn" @onclick="() => ToggleActionMenu(user.Id)" title="More actions">
                                            <i class="bi bi-three-dots-vertical"></i>
                                        </button>
                                        @if (openMenuUserId == user.Id)
                                        {
                                            <div class="um-dropdown-menu" @onclick:stopPropagation="true">
                                                @if (user.IsLocked)
                                                {
                                                    <button class="um-dropdown-item"
                                                            @onclick="@(async () => { CloseActionMenu(); await UnlockUser(user); })">
                                                        <i class="bi bi-unlock-fill text-warning"></i> Unlock Account
                                                    </button>
                                                }
                                                @if (user.TwoFactorEnabled)
                                                {
                                                    <button class="um-dropdown-item"
                                                            @onclick="@(async () => { CloseActionMenu(); await ResetTwoFactor(user); })">
                                                        <i class="bi bi-shield-x text-secondary"></i> Reset 2FA
                                                    </button>
                                                }
                                                <button class="um-dropdown-item"
                                                        @onclick="@(() => { CloseActionMenu(); ShowResetPasswordModal(user); })">
                                                    <i class="bi bi-key-fill text-warning"></i> Reset Password
                                                </button>
                                                @if (user.IsActive)
                                                {
                                                    <button class="um-dropdown-item um-dropdown-danger"
                                                            @onclick="@(async () => { CloseActionMenu(); await ConfirmDeactivate(user); })">
                                                        <i class="bi bi-person-dash-fill"></i> Deactivate User
                                                    </button>
                                                }
                                                else
                                                {
                                                    <button class="um-dropdown-item um-dropdown-success"
                                                            @onclick="@(async () => { CloseActionMenu(); await ActivateUser(user); })">
                                                        <i class="bi bi-person-check-fill"></i> Activate User
                                                    </button>
                                                }
                                                <div class="um-dropdown-divider"></div>
                                                <button class="um-dropdown-item um-dropdown-danger"
                                                        @onclick="@(() => { CloseActionMenu(); ConfirmDeleteUser(user); })">
                                                    <i class="bi bi-trash-fill"></i> Delete User
                                                </button>
                                            </div>
                                        }
                                    </div>
                                }
                            </div>
                        </div>
                    }
                </div>

                <!-- Pagination -->
                @if (totalPages > 1)
                {
                    <div class="um-pagination">
                        <span class="um-page-info">Showing @((currentPage - 1) * pageSize + 1)–@Math.Min(currentPage * pageSize,
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                users.Count + (currentPage - 1) * pageSize) of page @currentPage</span>
                            <div class="um-page-buttons">
                                <button class="um-page-btn" disabled="@(currentPage <= 1)" @onclick="() => GoToPage(currentPage - 1)">
                                    <i class="bi bi-chevron-left"></i>
                                </button>
                                @for (int i = 1; i <= totalPages; i++)
                                {
                                    var pg = i;
                                    <button class="um-page-btn @(pg == currentPage ? "active" : "")" @onclick="() => GoToPage(pg)">@pg</button>
                                }
                                <button class="um-page-btn" disabled="@(currentPage >= totalPages)"
                                        @onclick="() => GoToPage(currentPage + 1)">
                                    <i class="bi bi-chevron-right"></i>
                                </button>
                            </div>
                            <select class="um-select um-select-sm" @bind="pageSize" @bind:after="OnPageSizeChanged">
                                <option value="10">10 / page</option>
                                <option value="20">20 / page</option>
                                <option value="50">50 / page</option>
                            </select>
                        </div>
                    }
                }
                else
                {
                    <div class="um-empty">
                        <i class="bi bi-people"></i>
                        <h3>No users found</h3>
                        <p>Try adjusting your search or filters</p>
                    </div>
                }
            }
            else if (activeTab == "permissions")
            {
                <div class="um-section-card">
                    <div class="um-section-header">
                        <h3><i class="bi bi-list-check me-2"></i>Available Permissions</h3>
                    </div>
                    @if (permissionCategories != null)
                    {
                        @foreach (var category in permissionCategories)
                        {
                            <details class="um-perm-group">
                                <summary class="um-perm-summary">
                                    <span>@category.Key</span>
                                    <span class="um-perm-count">@category.Value.Count</span>
                                </summary>
                                <div class="um-perm-list">
                                    @foreach (var perm in category.Value)
                                    {
                                        <div class="um-perm-item">
                                            <code class="um-perm-code">@perm.Code</code>
                                            <span class="um-perm-name">@perm.Name</span>
                                            <span class="um-perm-desc">@perm.Description</span>
                                        </div>
                                    }
                                </div>
                            </details>
                        }
                    }
                </div>

                <div class="um-section-card" style="margin-top: 1.5rem;">
                    <div class="um-section-header">
                        <h3><i class="bi bi-diagram-3 me-2"></i>Default Role Permissions</h3>
                    </div>
                    <div class="um-role-grid">
                        @foreach (var role in new[] { "Admin", "Cashier", "StockController", "DepotController", "PodOperator" })
                        {
                            <div class="um-role-card">
                                <div class="um-role-name">
                                    <span class="um-badge @GetRoleBadgeClass(role)">@role</span>
                                </div>
                                <p class="um-role-desc">
                                    @if (role == "Admin")
                                    {
                                        <text>Full system access including user management and all permissions</text>
                                    }
                                    else if (role == "Cashier")
                                    {
                                        <text>Access to payments, invoicing, sales orders, and credit notes</text>
                                    }
                                    else if (role == "StockController")
                                    {
                                        <text>Access to inventory transfers only</text>
                                    }
                                    else if (role == "DepotController")
                                    {
                                        <text>Access to inventory transfers and local stock only</text>
                                    }
                                    else if (role == "PodOperator")
                                    {
                                        <text>Access to Proof of Delivery (POD) flows scoped to an assigned section</text>
                                    }
                                </p>
                            </div>
                        }
                    </div>
                </div>
            }
            else if (activeTab == "security")
            {
                <!-- Security Stats -->
                <div class="um-stats-grid">
                    <div class="um-stat-card um-stat-success">
                        <div class="um-stat-icon"><i class="bi bi-shield-fill-check"></i></div>
                        <div class="um-stat-value">@usersWithTwoFactor</div>
                        <div class="um-stat-label">2FA Enabled</div>
                    </div>
                    <div class="um-stat-card um-stat-warning">
                        <div class="um-stat-icon"><i class="bi bi-shield-fill-exclamation"></i></div>
                        <div class="um-stat-value">@usersWithoutTwoFactor</div>
                        <div class="um-stat-label">2FA Disabled</div>
                    </div>
                    <div class="um-stat-card um-stat-danger">
                        <div class="um-stat-icon"><i class="bi bi-lock-fill"></i></div>
                        <div class="um-stat-value">@lockedUsers</div>
                        <div class="um-stat-label">Locked Accounts</div>
                    </div>
                </div>

                <div class="um-section-card">
                    <div class="um-section-header">
                        <h3><i class="bi bi-clock-history me-2"></i>Recent Security Events</h3>
                    </div>
                    @if (securityEvents.Any())
                    {
                        <div class="um-event-list">
                            @foreach (var evt in securityEvents)
                            {
                                <div class="um-event-item">
                                    <div class="um-event-icon">
                                        <i class="bi @GetSecurityEventIcon(evt.EventType)"></i>
                                    </div>
                                    <div class="um-event-info">
                                        <span class="um-event-user">@evt.Username</span>
                                        <span class="um-event-desc">@evt.Description</span>
                                    </div>
                                    <span class="um-event-time">@evt.Timestamp.ToString("dd MMM yyyy HH:mm")</span>
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="um-empty" style="padding: 2rem;">
                            <i class="bi bi-shield-check" style="font-size: 2.5rem;"></i>
                            <p>No recent security events</p>
                        </div>
                    }
                </div>
            }
        </div>

        <!-- Create/Edit User Modal -->
        @if (showUserModal)
        {
            <div class="um-overlay" @onclick="CloseModal">
                <div class="um-modal" @onclick:stopPropagation="true">
                    <div class="um-modal-header">
                        <h2>@(editingUser == null ? "Create New User" : $"Edit {editingUser.Username}")</h2>
                        <button class="um-modal-close" @onclick="CloseModal"><i class="bi bi-x-lg"></i></button>
                    </div>
                    <EditForm Model="userModel" OnValidSubmit="SaveUser">
                        <DataAnnotationsValidator />
                        <div class="um-modal-body">
                            <ValidationSummary class="text-danger" style="font-size: .82rem; margin-bottom: .75rem;" />
                            <div class="um-form-grid">
                                <div class="um-form-field">
                                    <label>Username <span class="required">*</span></label>
                                    <InputText class="um-input" @bind-Value="userModel.Username" placeholder="e.g. john.doe" />
                                    <ValidationMessage For="@(() => userModel.Username)" />
                                </div>
                                <div class="um-form-field">
                                    <label>Email</label>
                                    <InputText class="um-input" @bind-Value="userModel.Email" placeholder="user@company.com" />
                                    <ValidationMessage For="@(() => userModel.Email)" />
                                </div>
                                @if (editingUser == null)
                                {
                                    <div class="um-form-field">
                                        <label>Password <span class="required">*</span></label>
                                        <InputText type="password" class="um-input" @bind-Value="userModel.Password"
                                                   placeholder="Min. 6 characters" />
                                        <ValidationMessage For="@(() => userModel.Password)" />
                                    </div>
                                    <div class="um-form-field">
                                        <label>Confirm Password <span class="required">*</span></label>
                                        <InputText type="password" class="um-input" @bind-Value="userModel.ConfirmPassword"
                                                   placeholder="Re-enter password" />
                                        <ValidationMessage For="@(() => userModel.ConfirmPassword)" />
                                    </div>
                                }
                                <div class="um-form-field">
                                    <label>First Name</label>
                                    <InputText class="um-input" @bind-Value="userModel.FirstName" />
                                </div>
                                <div class="um-form-field">
                                    <label>Last Name</label>
                                    <InputText class="um-input" @bind-Value="userModel.LastName" />
                                </div>
                                <div class="um-form-field">
                                    <label>Role <span class="required">*</span></label>
                                    <InputSelect class="um-input" @bind-Value="userModel.Role">
                                        @foreach (var role in availableRoles)
                                        {
                                            <option value="@role">@role</option>
                                        }
                                    </InputSelect>
                                </div>
                                <div class="um-form-field">
                                    <label>Status</label>
                                    <label class="um-toggle">
                                        <InputCheckbox @bind-Value="userModel.IsActive" />
                                        <span class="um-toggle-slider"></span>
                                        <span class="um-toggle-label">@(userModel.IsActive ? "Active" : "Inactive")</span>
                                    </label>
                                </div>
                                @if (userModel.Role == "StockController" || userModel.Role == "DepotController")
                                {
                                    <div class="um-form-field um-form-full">
                                        <label>Assigned Warehouses <span class="required">*</span></label>
                                        @if (isLoadingWarehouses)
                                        {
                                            <div class="um-spinner-sm"></div>
                                        }
                                        else
                                        {
                                            <div class="um-checklist-wrap">
                                                @foreach (var wh in availableWarehouses)
                                                {
                                                    var whCode = wh.WarehouseCode ?? "";
                                                    var isChecked = userModel.AssignedWarehouseCodes.Contains(whCode);
                                                    <label class="um-checklist-item @(isChecked ? "checked" : "")" @onmouseover:stopPropagation>
                                                        <input type="checkbox" checked="@isChecked"
                                                               @onchange="(e) => ToggleWarehouse(whCode, (bool)(e.Value ?? false))" />
                                                        <span class="um-checklist-label">@wh.WarehouseCode</span>
                                                        <span class="um-checklist-hint">- @wh.WarehouseName</span>
                                                    </label>
                                                }
                                            </div>
                                            @if (userModel.AssignedWarehouseCodes.Count > 0)
                                            {
                                                <div class="um-chip-wrap">
                                                    @foreach (var whCode in userModel.AssignedWarehouseCodes)
                                                    {
                                                        <span class="um-chip um-chip-blue">
                                                            @whCode
                                                            <button type="button" class="um-chip-remove"
                                                                    @onclick="() => ToggleWarehouse(whCode, false)">x</button>
                                                        </span>
                                                    }
                                                </div>
                                            }
                                        }
                                        <small class="um-form-hint">User will have access to all selected warehouses
                                            (@userModel.AssignedWarehouseCodes.Count selected)</small>
                                        </div>
                                    }
                                    @if (userModel.Role == "Merchandiser" || userModel.Role == "ADR" || userModel.Role == "Sales")
                                    {
                                        <div class="um-form-field">
                                            <label>@(userModel.Role == "Merchandiser" ? "Default Warehouse" : "Assigned Warehouse") <span
                                                class="required">*</span></label>
                                                @if (isLoadingWarehouses)
                                                {
                                                    <div class="um-spinner-sm"></div>
                                                }
                                                else
                                                {
                                                    <select class="um-input" @bind="MerchandiserDefaultWarehouse">
                                                        <option value="">-- Select Warehouse --</option>
                                                        @foreach (var wh in MerchandiserWarehouseOptions)
                                                        {
                                                            <option value="@wh.WarehouseCode">@wh.WarehouseCode - @wh.WarehouseName</option>
                                                        }
                                                    </select>
                                                }
                                                <small class="um-form-hint">
                                                    @(userModel.Role == "Merchandiser"
                                                        ? "The warehouse used when this merchandiser submits sales orders from the mobile app"
                                                        : "The warehouse this van sales user will use when posting orders and invoices")
                                                </small>
                                            </div>
                                        }

                                        @if (userModel.Role == "Driver" || userModel.Role == "PodOperator")
                                        {
                                            <div class="um-form-field">
                                                <label>Assigned Section <span class="required">*</span></label>
                                                <InputSelect class="um-input" @bind-Value="userModel.AssignedSection">
                                                    <option value="">-- Select Section --</option>
                                                    @foreach (var sec in availableSections)
                                                    {
                                                        <option value="@sec">@AssignedSectionOptions.GetLabel(sec)</option>
                                                    }
                                                </InputSelect>
                                            </div>
                                        }

                                        @if (userModel.Role == "Merchandiser")
                                        {
                                            <div class="um-form-field um-form-full">
                                                <label>Assigned Customers <span class="required">*</span></label>
                                                @if (isLoadingCustomers)
                                                {
                                                    <div class="um-spinner-sm"></div>
                                                }
                                                else
                                                {
                                                    <div style="margin-bottom:.4rem;">
                                                        <input type="text" class="um-input" placeholder="Search customers..."
                                                               @bind="customerSearchTerm" @bind:event="oninput" />
                                                    </div>
                                                    <div class="um-customer-list">
                                                        @foreach (var bp in FilteredCustomers)
                                                        {
                                                            var code = bp.CardCode!;
                                                            var isChecked = userModel.AssignedCustomerCodes.Contains(code);
                                                            <label class="um-customer-item @(isChecked ? "checked" : "")" @onmouseover:stopPropagation>
                                                                <input type="checkbox" checked="@isChecked"
                                                                       @onchange="(e) => ToggleCustomer(code, (bool)(e.Value ?? false))"
                                                                       style="accent-color:#16a34a;" />
                                                                <span class="um-customer-code">@bp.CardCode</span>
                                                                <span class="um-customer-name">– @GetBusinessPartnerDisplayName(bp)</span>
                                                            </label>
                                                        }
                                                        @if (!FilteredCustomers.Any())
                                                        {
                                                            <div class="um-empty" style="padding: .5rem;">
                                                                <p>No customers found</p>
                                                            </div>
                                                        }
                                                    </div>
                                                    @if (userModel.AssignedCustomerCodes.Count > 0)
                                                    {
                                                        <div style="margin-top:.4rem; display:flex; flex-wrap:wrap; gap:.3rem;">
                                                            @foreach (var custCode in userModel.AssignedCustomerCodes)
                                                            {
                                                                var customer = availableCustomers.FirstOrDefault(c => string.Equals(c.CardCode, custCode,
                                    StringComparison.OrdinalIgnoreCase));
                                                                var custName = customer is null ? custCode : GetBusinessPartnerDisplayName(customer);
                                                                <span class="um-customer-tag">
                                                                    @custCode – @custName
                                                                    <button type="button" class="um-customer-tag-remove"
                                                                            @onclick="() => ToggleCustomer(custCode, false)">×</button>
                                                                </span>
                                                            }
                                                        </div>
                                                    }
                                                }
                                                <small class="um-form-hint">
                                                    Assign business partners this merchandiser will attend to
                                                    (@userModel.AssignedCustomerCodes.Count selected)
                                                </small>
                                            </div>
                                        }

                                        @if (userModel.Role == "ADR" || userModel.Role == "Sales")
                                        {
                                            <div class="um-form-field um-form-full">
                                                <label>Route Customers</label>
                                                <div class="um-form-hint">Route customers are captured locally under the assigned business
                                                    partner and are not assigned from SAP on this form.</div>
                                                    <small class="um-form-hint">Use the Route Customers page to view customers linked to the
                                                        selected route business partner.</small>
                                                    </div>
                                                }

                                                @if (userModel.Role == "ADR" || userModel.Role == "Sales")
                                                {
                                                    <div class="um-form-field">
                                                        <label>Assigned Business Partner <span class="required">*</span></label>
                                                        @if (isLoadingCustomers)
                                                        {
                                                            <div class="um-spinner-sm"></div>
                                                        }
                                                        else
                                                        {
                                                            <InputSelect class="um-input" @bind-Value="userModel.AssignedBusinessPartnerCode">
                                                                <option value="">-- Select Business Partner --</option>
                                                                @foreach (var bp in availableCustomers.OrderBy(bp => bp.CardCode))
                                                                {
                                                                    <option value="@bp.CardCode">@bp.CardCode - @GetBusinessPartnerDisplayName(bp)</option>
                                                                }
                                                            </InputSelect>
                                                        }
                                                        <ValidationMessage For="@(() => userModel.AssignedBusinessPartnerCode)" />
                                                        <small class="um-form-hint">The business partner identity this van sales user operates
                                                            under</small>
                                                        </div>

                                                        <div class="um-form-field">
                                                            <label>Assigned Cost Centre <span class="required">*</span></label>
                                                            @if (isLoadingCostCentres)
                                                            {
                                                                <div class="um-spinner-sm"></div>
                                                            }
                                                            else
                                                            {
                                                                <InputSelect class="um-input" @bind-Value="userModel.AssignedCostCentreCode">
                                                                    <option value="">-- Select Cost Centre --</option>
                                                                    @foreach (var costCentre in availableCostCentres.OrderBy(costCentre =>
                                            costCentre.CenterCode))
                                                                    {
                                                                        <option value="@costCentre.CenterCode">@costCentre.CenterCode - @costCentre.CenterName
                                                                        </option>
                                                                    }
                                                                </InputSelect>
                                                            }
                                                            <ValidationMessage For="@(() => userModel.AssignedCostCentreCode)" />
                                                            <small class="um-form-hint">The cost centre applied to this van sales user’s orders and
                                                                invoices</small>
                                                            </div>
                                                        }

                                                    </div>
                                                </div>
                                                <div class="um-modal-footer">
                                                    <button type="button" class="um-btn um-btn-ghost" @onclick="CloseModal">Cancel</button>
                                                    <button type="submit" class="um-btn um-btn-primary" disabled="@isSaving">
                                                        @if (isSaving)
                                                        {
                                                            <span class="um-spinner-sm"></span>
                                                        }
                                                        @(editingUser == null ? "Create User" : "Save Changes")
                                                    </button>
                                                </div>
                                            </EditForm>
                                        </div>
                                    </div>
                                }

                                <!-- Permissions Modal -->
                                @if (showPermissionsModal && selectedUserForPermissions != null)
                                {
                                    <div class="um-overlay" @onclick="ClosePermissionsModal">
                                        <div class="um-modal um-modal-wide" @onclick:stopPropagation="true">
                                            <div class="um-modal-header">
                                                <h2>Permissions for @selectedUserForPermissions.Username</h2>
                                                <button class="um-modal-close" @onclick="ClosePermissionsModal"><i class="bi bi-x-lg"></i></button>
                                            </div>
                                            <div class="um-modal-body" style="max-height: 65vh; overflow-y: auto;">
                                                <label class="um-toggle" style="margin-bottom: 1.25rem;">
                                                    <input type="checkbox" @bind="useRoleDefaults" />
                                                    <span class="um-toggle-slider"></span>
                                                    <span class="um-toggle-label">Use default permissions for
                                                        <strong>@selectedUserForPermissions.Role</strong></span>
                                                    </label>

                                                    @if (!useRoleDefaults && permissionCategories != null)
                                                    {
                                                        @foreach (var category in permissionCategories)
                                                        {
                                                            <div class="um-perm-modal-group">
                                                                <div class="um-perm-modal-header">
                                                                    <strong>@category.Key</strong>
                                                                    <div class="um-perm-modal-actions">
                                                                        <button type="button" class="um-btn-link"
                                                                                @onclick="() => SelectAllInCategory(category.Key)">Select All</button>
                                                                        <button type="button" class="um-btn-link um-btn-link-muted"
                                                                                @onclick="() => DeselectAllInCategory(category.Key)">Clear</button>
                                                                    </div>
                                                                </div>
                                                                <div class="um-perm-modal-body">
                                                                    @foreach (var perm in category.Value)
                                                                    {
                                                                        <label class="um-perm-check @(selectedPermissions.Contains(perm.Code) ? "checked" : "")">
                                                                            <input type="checkbox" checked="@selectedPermissions.Contains(perm.Code)"
                                                                                   @onchange="(e) => TogglePermission(perm.Code, (bool)e.Value!)" />
                                                                            <div>
                                                                                <span class="um-perm-check-name">@perm.Name</span>
                                                                                <span class="um-perm-check-desc">@perm.Description</span>
                                                                            </div>
                                                                        </label>
                                                                    }
                                                                </div>
                                                            </div>
                                                        }
                                                    }
                                                </div>
                                                <div class="um-modal-footer">
                                                    <button type="button" class="um-btn um-btn-ghost" @onclick="ClosePermissionsModal">Cancel</button>
                                                    <button type="button" class="um-btn um-btn-primary" @onclick="SavePermissions" disabled="@isSaving">
                                                        @if (isSaving)
                                                        {
                                                            <span class="um-spinner-sm"></span>
                                                        }
                                                        Save Permissions
                                                    </button>
                                                </div>
                                            </div>
                                        </div>
                                    }

                                    <!-- Reset Password Modal -->
                                    @if (showResetPasswordModal && resetPasswordUser != null)
                                    {
                                        <div class="um-overlay" @onclick="CloseResetPasswordModal">
                                            <div class="um-modal" style="max-width: 480px;" @onclick:stopPropagation="true">
                                                <div class="um-modal-header">
                                                    <h2>Reset Password for @resetPasswordUser.Username</h2>
                                                    <button class="um-modal-close" @onclick="CloseResetPasswordModal"><i class="bi bi-x-lg"></i></button>
                                                </div>
                                                <EditForm Model="resetPasswordModel" OnValidSubmit="ResetPassword">
                                                    <DataAnnotationsValidator />
                                                    <div class="um-modal-body">
                                                        <div class="um-form-field">
                                                            <label>New Password <span class="required">*</span></label>
                                                            <InputText type="password" class="um-input" @bind-Value="resetPasswordModel.NewPassword"
                                                                       placeholder="Min. 8 characters" />
                                                            <ValidationMessage For="@(() => resetPasswordModel.NewPassword)" />
                                                        </div>
                                                        <div class="um-form-field" style="margin-top: 1rem;">
                                                            <label>Confirm Password <span class="required">*</span></label>
                                                            <InputText type="password" class="um-input" @bind-Value="resetPasswordModel.ConfirmPassword"
                                                                       placeholder="Re-enter password" />
                                                            <ValidationMessage For="@(() => resetPasswordModel.ConfirmPassword)" />
                                                        </div>
                                                    </div>
                                                    <div class="um-modal-footer">
                                                        <button type="button" class="um-btn um-btn-ghost" @onclick="CloseResetPasswordModal">Cancel</button>
                                                        <button type="submit" class="um-btn um-btn-primary" disabled="@isSaving">
                                                            @if (isSaving)
                                                            {
                                                                <span class="um-spinner-sm"></span>
                                                            }
                                                            Reset Password
                                                        </button>
                                                    </div>
                                                </EditForm>
                                            </div>
                                        </div>
                                    }

                                    <!-- Delete User Confirmation Modal -->
                                    @if (showDeleteConfirmModal && deleteTargetUser != null)
                                    {
                                        <div class="um-overlay" @onclick="CloseDeleteConfirmModal">
                                            <div class="um-modal" style="max-width: 480px;" @onclick:stopPropagation="true">
                                                <div class="um-modal-header um-delete-header">
                                                    <h2><i class="bi bi-exclamation-triangle-fill"></i> Delete User</h2>
                                                    <button class="um-modal-close" @onclick="CloseDeleteConfirmModal"><i class="bi bi-x-lg"></i></button>
                                                </div>
                                                <div class="um-modal-body">
                                                    <p style="margin-bottom: 1rem;">Are you sure you want to <strong>permanently delete</strong> the user
                                                        <strong>@deleteTargetUser.Username</strong>?
                                                    </p>
                                                    <div class="um-delete-warning">
                                                        <i class="bi bi-exclamation-triangle-fill"></i> This action cannot be undone. All user data will be
                                                        permanently removed.
                                                    </div>
                                                </div>
                                                <div class="um-modal-footer">
                                                    <button type="button" class="um-btn um-btn-ghost" @onclick="CloseDeleteConfirmModal">Cancel</button>
                                                    <button type="button" class="um-btn um-btn-danger" @onclick="DeleteUser" disabled="@isSaving">
                                                        @if (isSaving)
                                                        {
                                                            <span class="um-spinner-sm"></span>
                                                        }
                                                        <i class="bi bi-trash-fill"></i> Delete Permanently
                                                    </button>
                                                </div>
                                            </div>
                                        </div>
                                    }


@* The Nocturne sheet is wwwroot/css/user-management.css (linked from
   App.razor). This page is a stylesheet replacement rather than a markup
   rewrite: its class names already say what each thing is, so they are kept
   and only what they resolve to changed. The 2,338-line <style> block that
   used to sit here is what the sheet replaces.

   The modals are siblings of .um-page rather than children, so the sheet
   declares its token block on .um-overlay too, or the dialogs would inherit
   neither the palette nor the font context. *@

@code {
    private List<UserDisplayModel> users = new();
    private string searchTerm = string.Empty;
    private string roleFilter = string.Empty;
    private string statusFilter = string.Empty;
    private bool isLoading = true;
    private bool isSaving = false;
    private int currentPage = 1;
    private int pageSize = 10;
    private int totalPages = 1;
    private string activeTab = "users";
    private string currentUserRole = string.Empty;

    private static readonly List<string> AdminAvailableRoles = new() { "Admin", "Cashier", "StockController",
"DepotController", "PodOperator", "Driver", "Merchandiser", "SalesRep", "MerchandiserPurchaseOrderViewer", "Lab", "ADR",
"Sales" };
    private static readonly List<string> PodOperatorAvailableRoles = new() { "Driver" };
    private List<string> availableRoles = new(AdminAvailableRoles);
    private List<string> availableSections = AssignedSectionOptions.All.ToList();
    private List<WarehouseDto> availableWarehouses = new();
    private bool isLoadingWarehouses = false;
    private List<BusinessPartnerDto> availableCustomers = new();
    private bool isLoadingCustomers = false;
    private string customerSearchTerm = string.Empty;
    private List<CostCentreDto> availableCostCentres = new();
    private bool isLoadingCostCentres = false;
    private Dictionary<string, List<PermissionModel>>? permissionCategories;

    private bool showUserModal = false;
    private UserFormModel userModel = new();
    private UserDisplayModel? editingUser;

    private bool showPermissionsModal = false;
    private UserDisplayModel? selectedUserForPermissions;
    private HashSet<string> selectedPermissions = new(StringComparer.OrdinalIgnoreCase);
    private bool useRoleDefaults = false;

    // Security stats
    private int usersWithTwoFactor = 0;
    private int usersWithoutTwoFactor = 0;
    private int lockedUsers = 0;
    private List<SecurityEvent> securityEvents = new();



    // Action menu state
    private Guid? openMenuUserId = null;

    // Reset password modal
    private bool showResetPasswordModal = false;
    private UserDisplayModel? resetPasswordUser;
    private ResetPasswordFormModel resetPasswordModel = new();

    // Delete confirmation modal
    private bool showDeleteConfirmModal = false;
    private UserDisplayModel? deleteTargetUser;

    private bool isPodOperatorView => string.Equals(currentUserRole, UserRoles.PodOperator,
StringComparison.OrdinalIgnoreCase);
    private bool isSalesRepView => string.Equals(currentUserRole, UserRoles.SalesRep, StringComparison.OrdinalIgnoreCase);
    private bool HasActiveFilters => !string.IsNullOrEmpty(searchTerm) || !string.IsNullOrEmpty(statusFilter) ||
(!isPodOperatorView && !string.IsNullOrEmpty(roleFilter));

    private void SetTab(string tab) => activeTab = tab;

    private void ToggleActionMenu(Guid userId)
    {
        openMenuUserId = openMenuUserId == userId ? null : userId;
    }

    private void CloseActionMenu() => openMenuUserId = null;

    private string GetAvatarClass(UserDisplayModel user) => user.Role switch
    {
        "Admin" => "um-avatar-admin",
        "Cashier" => "um-avatar-cashier",
        "StockController" => "um-avatar-stock",
        "DepotController" => "um-avatar-depot",
        _ => "um-avatar-default"
    };

    private bool _hasLoadedData = false;

    protected override void OnInitialized()
    {
        pageSize = AppSettings.PageSize;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && !_hasLoadedData)
        {
            _hasLoadedData = true;
            // Ensure auth token is set on HttpClient before calling API
            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            currentUserRole = authState.User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value ?? string.Empty;

            // Sales reps manage merchandiser accounts on the dedicated page rather than the admin-style user grid.
            if (isSalesRepView)
            {
                NavigationManager.NavigateTo("/merchandiser-account", replace: true);
                return;
            }

            availableRoles = isPodOperatorView ? new List<string>(PodOperatorAvailableRoles) : new
List<string>(AdminAvailableRoles);
            roleFilter = isPodOperatorView ? "Driver" : string.Empty;
            activeTab = "users";
            await LoadUsers();

            // Paint the user list as soon as it's loaded. The supporting lookups
            // below (permissions, security stats and SAP-backed master data) only
            // feed the other tabs and the create/edit modal, and some hit SAP
            // Service Layer endpoints that can be slow or unavailable. Awaiting
            // them here previously kept the whole component from re-rendering, so
            // an unhealthy SAP backend left the page stuck on "Loading users..."
            // even though the users had already loaded successfully.
            StateHasChanged();

            if (!isPodOperatorView)
            {
                _ = InvokeAsync(async () =>
                {
                    await LoadPermissions();
                    await LoadSecurityStats();
                    await LoadWarehouses();
                    await LoadCustomers();
                    await LoadCostCentres();
                    StateHasChanged();
                });
            }
        }
    }

    private async Task LoadWarehouses()
    {
        isLoadingWarehouses = true;
        try
        {
            var warehouseList = await MasterDataCache.GetWarehousesAsync();
            availableWarehouses = warehouseList?.Where(w => w.IsActive).ToList() ?? new();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Failed to load warehouses: {ex.Message}");
        }
        finally
        {
            isLoadingWarehouses = false;
        }
    }

    private void ToggleWarehouse(string warehouseCode, bool isChecked)
    {
        if (isChecked)
        {
            if (!userModel.AssignedWarehouseCodes.Contains(warehouseCode))
                userModel.AssignedWarehouseCodes.Add(warehouseCode);
        }
        else
        {
            userModel.AssignedWarehouseCodes.Remove(warehouseCode);
        }
    }

    private string MerchandiserDefaultWarehouse
    {
        get => userModel.AssignedWarehouseCodes.FirstOrDefault() ?? "";
        set
        {
            userModel.AssignedWarehouseCodes.Clear();
            if (!string.IsNullOrEmpty(value))
                userModel.AssignedWarehouseCodes.Add(value);
        }
    }

    private IEnumerable<WarehouseDto> MerchandiserWarehouseOptions
    {
        get
        {
            var selectedWarehouseCode = MerchandiserDefaultWarehouse;

            if (string.IsNullOrWhiteSpace(selectedWarehouseCode) ||
                availableWarehouses.Any(wh => string.Equals(wh.WarehouseCode, selectedWarehouseCode,
StringComparison.OrdinalIgnoreCase)))
            {
                return availableWarehouses;
            }

            return new[]
            {
                new WarehouseDto
                {
                    WarehouseCode = selectedWarehouseCode,
                    WarehouseName = "Currently assigned"
                }
            }.Concat(availableWarehouses);
        }
    }

    private async Task LoadCustomers()
    {
        isLoadingCustomers = true;
        try
        {
            var customers = await MasterDataCache.GetBusinessPartnersAsync(includeInactive: true);
            availableCustomers = customers?.Where(IsCustomerBusinessPartner).ToList() ?? new();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Failed to load customers: {ex.Message}");
        }
        finally
        {
            isLoadingCustomers = false;
        }
    }

    private async Task LoadCostCentres()
    {
        isLoadingCostCentres = true;
        try
        {
            var costCentres = await MasterDataCache.GetCostCentresAsync();
            availableCostCentres = costCentres?.Where(costCentre => costCentre.IsActive).ToList() ?? new();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Failed to load cost centres: {ex.Message}");
        }
        finally
        {
            isLoadingCostCentres = false;
        }
    }

    private static bool IsCustomerBusinessPartner(BusinessPartnerDto businessPartner)
    {
        return string.Equals(businessPartner.CardType, "cCustomer", StringComparison.OrdinalIgnoreCase) ||
               string.Equals(businessPartner.CardType, "C", StringComparison.OrdinalIgnoreCase);
    }

    private static string GetBusinessPartnerDisplayName(BusinessPartnerDto businessPartner)
    {
        var displayName = string.IsNullOrWhiteSpace(businessPartner.CardName)
            ? businessPartner.CardCode ?? string.Empty
            : businessPartner.CardName;

        return businessPartner.IsActive ? displayName : $"{displayName} (Inactive)";
    }

    private IEnumerable<BusinessPartnerDto> FilteredCustomers
    {
        get
        {
            var source = string.IsNullOrWhiteSpace(customerSearchTerm)
                ? availableCustomers
                : availableCustomers.Where(c =>
                    (c.CardCode?.Contains(customerSearchTerm, StringComparison.OrdinalIgnoreCase) ?? false) ||
                    (c.CardName?.Contains(customerSearchTerm, StringComparison.OrdinalIgnoreCase) ?? false));

            // Sort assigned customers to the top
            return source.OrderByDescending(c => userModel.AssignedCustomerCodes.Contains(c.CardCode!))
                         .ThenBy(c => c.CardCode);
        }
    }

    private void ToggleCustomer(string cardCode, bool isChecked)
    {
        if (isChecked)
        {
            if (!userModel.AssignedCustomerCodes.Contains(cardCode))
                userModel.AssignedCustomerCodes.Add(cardCode);
        }
        else
        {
            userModel.AssignedCustomerCodes.Remove(cardCode);
        }
    }

    private async Task LoadUsers()
    {
        isLoading = true;
        try
        {
            var result = await UserService.GetUsersAsync(currentPage, pageSize, searchTerm, roleFilter, statusFilter);
            users = result.Items?.Select(u => new UserDisplayModel
            {
                Id = u.Id,
                Username = u.Username,
                Email = u.Email,
                FirstName = u.FirstName,
                LastName = u.LastName,
                Role = u.Role,
                IsActive = u.IsActive,
                IsLocked = u.IsLocked,
                TwoFactorEnabled = u.TwoFactorEnabled,
                LastLoginAt = u.LastLoginAt,
                Permissions = u.Permissions,
                AssignedWarehouseCodes = u.AssignedWarehouseCodes,
                AssignedSection = u.AssignedSection,
                AssignedCustomerCodes = u.AssignedCustomerCodes ?? new(),
                AssignedBusinessPartnerCode = u.AssignedBusinessPartnerCode,
                AssignedCostCentreCode = u.AssignedCostCentreCode
            }).ToList() ?? new List<UserDisplayModel>();
            totalPages = result.TotalPages;
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error loading users: {ex.Message}", Severity.Error);
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task LoadPermissions()
    {
        try
        {
            permissionCategories = await UserService.GetAvailablePermissionsAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error loading permissions: {ex.Message}", Severity.Error);
        }
    }

    private async Task LoadSecurityStats()
    {
        try
        {
            var stats = await UserService.GetSecurityStatsAsync();
            usersWithTwoFactor = stats.UsersWithTwoFactor;
            usersWithoutTwoFactor = stats.UsersWithoutTwoFactor;
            lockedUsers = stats.LockedUsers;
            securityEvents = stats.RecentEvents;
        }
        catch
        {
            // Ignore errors loading stats
        }
    }

    private async Task OnSearchChanged()
    {
        currentPage = 1;
        await LoadUsers();
    }

    private async Task ResetFilters()
    {
        searchTerm = string.Empty;
        roleFilter = isPodOperatorView ? "Driver" : string.Empty;
        statusFilter = string.Empty;
        currentPage = 1;
        await LoadUsers();
    }

    private async Task OnPageChanged(int page)
    {
        await GoToPage(page);
    }

    private async Task GoToPage(int page)
    {
        if (page >= 1 && page <= totalPages)
        {
            currentPage = page;
            await LoadUsers();
        }
    }

    private async Task OnPageSizeChanged()
    {
        currentPage = 1;
        await LoadUsers();
    }

    private void ShowCreateModal()
    {
        editingUser = null;
        userModel = new UserFormModel { Role = isPodOperatorView ? "Driver" : "Cashier", IsActive = true, IsNew = true };
        showUserModal = true;
    }

    private void ShowCreateMobileUserModal()
    {
        editingUser = null;
        userModel = new UserFormModel { Role = "PodOperator", IsActive = true, IsNew = true };
        showUserModal = true;
    }

    private void ShowEditModal(UserDisplayModel user)
    {
        editingUser = user;
        userModel = new UserFormModel
        {
            Username = user.Username,
            Email = user.Email ?? "",
            FirstName = user.FirstName,
            LastName = user.LastName,
            Role = user.Role,
            IsActive = user.IsActive,
            AssignedWarehouseCodes = new List<string>(user.AssignedWarehouseCodes),
            AssignedSection = user.AssignedSection,
            AssignedCustomerCodes = new List<string>(user.AssignedCustomerCodes),
            AssignedBusinessPartnerCode = user.AssignedBusinessPartnerCode,
            AssignedCostCentreCode = user.AssignedCostCentreCode
        };
        showUserModal = true;
    }

    private void CloseModal()
    {
        showUserModal = false;
        editingUser = null;
    }

    private async Task SaveUser()
    {
        isSaving = true;
        var isEditing = editingUser != null;
        var originalUsername = editingUser?.Username;
        var originalEmail = editingUser?.Email;
        try
        {
            NormalizeRoleSpecificAssignments(userModel);

            if (!isEditing)
            {
                await UserService.CreateUserAsync(userModel);
                Snackbar.Add("User created successfully", Severity.Success);
            }
            else
            {
                var userToEdit = editingUser;
                if (userToEdit is null)
                {
                    Snackbar.Add("No user selected for editing.", Severity.Error);
                    return;
                }

                await UserService.UpdateUserAsync(userToEdit.Id, userModel);
                Snackbar.Add("User updated successfully", Severity.Success);

                var usernameChanged = !string.Equals(originalUsername, userModel.Username, StringComparison.OrdinalIgnoreCase);
                var emailChanged = !string.Equals(originalEmail, userModel.Email, StringComparison.OrdinalIgnoreCase);
                if ((usernameChanged || emailChanged) && AuthStateProvider is CustomAuthStateProvider customAuthStateProvider)
                {
                    var authState = await AuthStateProvider.GetAuthenticationStateAsync();
                    var currentUsername = authState.User.Identity?.Name;
                    if (!string.IsNullOrWhiteSpace(currentUsername) &&
                        string.Equals(currentUsername, originalUsername, StringComparison.OrdinalIgnoreCase))
                    {
                        await customAuthStateProvider.UpdateUserProfileAsync(userModel.Username, userModel.Email);
                    }
                }
            }

            await AuditService.LogAsync(isEditing ? "UpdateUser" : "CreateUser", "User", userModel.Username);
            CloseModal();
            await LoadUsers();
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        finally
        {
            isSaving = false;
        }
    }

    private async Task ShowPermissionsModal(UserDisplayModel user)
    {
        CloseActionMenu();

        try
        {
            var permissions = await UserService.GetUserPermissionsAsync(user.Id);
            selectedUserForPermissions = user;
            selectedPermissions = new HashSet<string>(permissions.EffectivePermissions, StringComparer.OrdinalIgnoreCase);
            useRoleDefaults = permissions.UsesRoleDefaults;
            showPermissionsModal = true;
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }

    private void ClosePermissionsModal()
    {
        showPermissionsModal = false;
        selectedUserForPermissions = null;
        selectedPermissions.Clear();
    }

    private void TogglePermission(string code, bool isChecked)
    {
        if (isChecked)
            selectedPermissions.Add(code);
        else
            selectedPermissions.Remove(code);
    }

    private void SelectAllInCategory(string category)
    {
        if (permissionCategories != null && permissionCategories.TryGetValue(category, out var perms))
        {
            foreach (var perm in perms)
            {
                selectedPermissions.Add(perm.Code);
            }
        }
        StateHasChanged();
    }

    private void DeselectAllInCategory(string category)
    {
        if (permissionCategories != null && permissionCategories.TryGetValue(category, out var perms))
        {
            foreach (var perm in perms)
            {
                selectedPermissions.Remove(perm.Code);
            }
        }
        StateHasChanged();
    }

    private async Task SavePermissions()
    {
        if (selectedUserForPermissions == null) return;

        isSaving = true;
        try
        {
            var userId = selectedUserForPermissions.Id;
            var username = selectedUserForPermissions.Username;
            var permissions = useRoleDefaults
                ? new List<string>()
                : selectedPermissions.OrderBy(permission => permission, StringComparer.OrdinalIgnoreCase).ToList();
            await UserService.UpdateUserPermissionsAsync(userId, permissions);
            Snackbar.Add("Permissions updated successfully", Severity.Success);
            ClosePermissionsModal();
            await LoadUsers();
            await AuditService.LogAsync("UpdatePermissions", "User", username);
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        finally
        {
            isSaving = false;
        }
    }

    private async Task UnlockUser(UserDisplayModel user)
    {
        try
        {
            await UserService.UnlockUserAsync(user.Id);
            Snackbar.Add($"User {user.Username} unlocked successfully", Severity.Success);
            await LoadUsers();
            await LoadSecurityStats();
            await AuditService.LogAsync("UnlockUser", "User", user.Username);
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }

    private async Task ResetTwoFactor(UserDisplayModel user)
    {
        if (!await JS.InvokeAsync<bool>("confirm", $"Are you sure you want to reset 2FA for {user.Username}? They will need to set it up again."))
            return;

        try
        {
            await UserService.ResetTwoFactorAsync(user.Id);
            Snackbar.Add($"Two-factor authentication reset for {user.Username}", Severity.Success);
            await LoadUsers();
            await LoadSecurityStats();
            await AuditService.LogAsync("ResetTwoFactor", "User", user.Username);
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }

    private async Task ConfirmDeactivate(UserDisplayModel user)
    {
        if (!await JS.InvokeAsync<bool>("confirm", $"Are you sure you want to deactivate {user.Username}?"))
            return;

        try
        {
            await UserService.DeactivateUserAsync(user.Id);
            Snackbar.Add($"User {user.Username} deactivated successfully", Severity.Success);
            await LoadUsers();
            await AuditService.LogAsync("DeactivateUser", "User", user.Username);
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }

    private void ShowResetPasswordModal(UserDisplayModel user)
    {
        resetPasswordUser = user;
        resetPasswordModel = new ResetPasswordFormModel();
        showResetPasswordModal = true;
    }

    private void CloseResetPasswordModal()
    {
        showResetPasswordModal = false;
        resetPasswordUser = null;
    }

    private async Task ResetPassword()
    {
        if (resetPasswordUser == null) return;

        isSaving = true;
        try
        {
            var username = resetPasswordUser.Username;
            await UserService.ChangePasswordAsync(resetPasswordUser.Id, resetPasswordModel.NewPassword!);
            Snackbar.Add($"Password reset for {username}", Severity.Success);
            CloseResetPasswordModal();
            await AuditService.LogAsync("ResetPassword", "User", username);
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        finally
        {
            isSaving = false;
        }
    }

    private void ConfirmDeleteUser(UserDisplayModel user)
    {
        deleteTargetUser = user;
        showDeleteConfirmModal = true;
    }

    private void CloseDeleteConfirmModal()
    {
        showDeleteConfirmModal = false;
        deleteTargetUser = null;
    }

    private async Task DeleteUser()
    {
        if (deleteTargetUser == null) return;

        isSaving = true;
        try
        {
            var targetUser = deleteTargetUser;

            await UserService.DeleteUserAsync(targetUser.Id);
            Snackbar.Add($"User {targetUser.Username} deleted permanently", Severity.Success);
            CloseDeleteConfirmModal();
            await LoadUsers();
            await LoadSecurityStats();
            await AuditService.LogAsync("DeleteUser", "User", targetUser.Username);
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        finally
        {
            isSaving = false;
        }
    }

    private async Task ActivateUser(UserDisplayModel user)
    {
        try
        {
            var form = new UserFormModel
            {
                Username = user.Username,
                Email = user.Email ?? "",
                Role = user.Role,
                IsActive = true,
                AssignedWarehouseCodes = new List<string>(user.AssignedWarehouseCodes),
                            AssignedSection = user.AssignedSection,
                AssignedCustomerCodes = new List<string>(user.AssignedCustomerCodes),
                AssignedBusinessPartnerCode = user.AssignedBusinessPartnerCode,
                AssignedCostCentreCode = user.AssignedCostCentreCode
            };
            NormalizeRoleSpecificAssignments(form);
            await UserService.UpdateUserAsync(user.Id, form);
            Snackbar.Add($"User {user.Username} activated successfully", Severity.Success);
            await LoadUsers();
            await AuditService.LogAsync("ActivateUser", "User", user.Username);
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }



    private string GetRoleBadgeClass(string role) => role switch
    {
        "Admin" => "um-badge-admin",
        "Cashier" => "um-badge-cashier",
        "StockController" => "um-badge-stockcontroller",
        "DepotController" => "um-badge-depotcontroller",
        "PodOperator" => "um-badge-podoperator",
        _ => "um-badge-user"
    };

    private static void NormalizeRoleSpecificAssignments(UserFormModel model)
    {
        if (model.Role == "Merchandiser" || model.Role == "ADR" || model.Role == "Sales")
        {
            model.AssignedWarehouseCodes = model.AssignedWarehouseCodes
                .Where(code => !string.IsNullOrWhiteSpace(code))
                .Select(code => code.Trim())
                .Distinct(StringComparer.OrdinalIgnoreCase)
                .Take(1)
                .ToList();
        }

        if (model.Role != "Driver" && model.Role != "PodOperator")
        {
            model.AssignedSection = null;
        }

        if (model.Role != "ADR" && model.Role != "Sales")
        {
            model.AssignedBusinessPartnerCode = null;
            model.AssignedCostCentreCode = null;
        }
        else
        {
            model.AssignedCustomerCodes = new();
        }
    }

