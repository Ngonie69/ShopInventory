@page "/inventory-transfers/sap-approvals"
@using Microsoft.AspNetCore.Authorization
@using ShopInventory.Web.Data
@using ShopInventory.Web.Models
@attribute [Authorize(Roles = UserRoles.SapTransferApprovalRoles)]
@rendermode InteractiveServer

<PageTitle>SAP-Held Transfers - Shop Inventory</PageTitle>

@* Nocturne. wwwroot/css/sap-transfer-approvals.css is generated by scripts/derive_sap_transfer_approvals_css.py:
   the credit memo queue's sheet renamed, plus this page's own rules in the script's footer. Both schemes
   follow the app's theme toggle. Icon-only buttons draw their glyph inline rather than from the Phosphor
   font, because the glyph is the whole label and a font that fails to load would leave them reading as
   dead controls. The layout follows the "SAP-Held Transfers Redesign" canvas: rows grouped by the day
   they were raised, the route as the headline, and a filter panel whose every choice SAP applies. *@

<div class="sta">

    <header class="sta-head">
        <div class="sta-shell">
            <div class="sta-q-mark" aria-hidden="true"><i class="ph ph-seal-check"></i></div>
            <div class="sta-titles">
                <h1 class="sta-title">SAP-Held Transfers</h1>
                <p class="sta-sub">Transfers keyed and approved in SAP Business One, waiting to be added. Approval is decided in SAP; adding posts the transfer there.</p>
            </div>
            <div class="sta-head-actions">
                <button type="button" class="sta-btn sta-btn-secondary sta-btn-lg" @onclick="RefreshAsync" disabled="@isLoading">
                    @if (isLoading)
                    {
                        <span class="sta-spin" aria-hidden="true"></span>
                    }
                    else
                    {
                        <i class="ph ph-arrows-clockwise" aria-hidden="true"></i>
                    }
                    <span>Refresh</span>
                </button>
            </div>
        </div>
        <div class="sta-rule"></div>
    </header>

    <div class="sta-body">

        @if (!string.IsNullOrEmpty(errorMessage))
        {
            <div class="sta-alert" role="alert">
                <i class="ph ph-warning-octagon" aria-hidden="true"></i>
                <div class="sta-alert-body">@errorMessage</div>
                <button type="button" class="sta-btn sta-btn-ghost sta-btn-icon-sm" title="Dismiss"
                        aria-label="Dismiss error" @onclick="() => errorMessage = null">
                    <svg viewBox="0 0 256 256" aria-hidden="true" focusable="false">
                        <path d="M205.66,194.34a8,8,0,0,1-11.32,11.32L128,139.31,61.66,205.66a8,8,0,0,1-11.32-11.32L116.69,128,50.34,61.66A8,8,0,0,1,61.66,50.34L128,116.69l66.34-66.35a8,8,0,0,1,11.32,11.32L139.31,128Z" />
                    </svg>
                </button>
            </div>
        }

        @* What the last add said. The drawer closes on a successful add, because the draft leaves the
           queue with it, so the transfer's number is kept here rather than only in a snackbar that
           fades. A request left open keeps the notice colour: it needs following up. *@
        @if (!string.IsNullOrEmpty(addedNotice))
        {
            <div class="@(addedNoticeNeedsAttention ? "sta-blocked sta-added" : "sta-done sta-added")" role="status">
                <i class="ph @(addedNoticeNeedsAttention ? "ph-warning" : "ph-check-circle")" aria-hidden="true"></i>
                <div class="sta-alert-body">
                    <div>@addedNotice</div>
                    @if (!string.IsNullOrEmpty(addedNoticeSource))
                    {
                        <div class="sta-added-source">@addedNoticeSource</div>
                    }
                </div>
                <button type="button" class="sta-btn sta-btn-ghost sta-btn-icon-sm" title="Dismiss"
                        aria-label="Dismiss notice" @onclick="DismissAddedNotice">
                    <svg viewBox="0 0 256 256" aria-hidden="true" focusable="false">
                        <path d="M205.66,194.34a8,8,0,0,1-11.32,11.32L128,139.31,61.66,205.66a8,8,0,0,1-11.32-11.32L116.69,128,50.34,61.66A8,8,0,0,1,61.66,50.34L128,116.69l66.34-66.35a8,8,0,0,1,11.32,11.32L139.31,128Z" />
                    </svg>
                </button>
            </div>
        }

        <section class="sta-card sta-q">

            <div class="sta-q-bar">
                <label class="sta-q-search">
                    <i class="ph ph-magnifying-glass" aria-hidden="true"></i>
                    <span class="sta-sr">Search transfers</span>
                    @* A number is a draft number; anything else is a warehouse the transfer leaves or enters.
                       Both are sent to SAP, which filters and counts — so the rows follow once the typing rests. *@
                    <input type="text" placeholder="Warehouse or draft no." maxlength="20"
                           value="@searchText" @oninput="OnSearchInputAsync" />
                    @if (!string.IsNullOrWhiteSpace(searchText))
                    {
                        <button type="button" class="sta-q-search-clear" aria-label="Clear search" @onclick="ClearSearchAsync">
                            <svg viewBox="0 0 256 256" aria-hidden="true" focusable="false">
                                <path d="M205.66,194.34a8,8,0,0,1-11.32,11.32L128,139.31,61.66,205.66a8,8,0,0,1-11.32-11.32L116.69,128,50.34,61.66A8,8,0,0,1,61.66,50.34L128,116.69l66.34-66.35a8,8,0,0,1,11.32,11.32L139.31,128Z" />
                            </svg>
                        </button>
                    }
                </label>

                <button type="button" class="sta-btn sta-btn-secondary sta-btn-lg sta-q-filterbtn @(filtersOpen ? "is-open" : "")"
                        aria-expanded="@(filtersOpen ? "true" : "false")" aria-controls="sta-filter-panel" @onclick="ToggleFilters">
                    <i class="ph ph-funnel-simple" aria-hidden="true"></i>
                    <span>Filters</span>
                    @if (ActiveFilters.Count > 0)
                    {
                        <span class="sta-q-badge">@ActiveFilters.Count</span>
                    }
                </button>

                <span class="sta-q-range" aria-live="polite">
                    @if (isLoading)
                    {
                        <span>Reading SAP…</span>
                    }
                    else if (totalCount == 0)
                    {
                        <span>No transfers</span>
                    }
                    else
                    {
                        <strong>@RangeText</strong><span> of @totalCount.ToString("N0") · page @currentPage of @TotalPages</span>
                    }
                </span>

                @if (scopedWarehouses is { Count: > 0 })
                {
                    <span class="sta-q-scope">
                        <i class="ph ph-warehouse" aria-hidden="true"></i>
                        <span>Leaving</span>
                        @foreach (var scopedCode in scopedWarehouses)
                        {
                            <span class="sta-q-code">@scopedCode</span>
                        }
                    </span>
                }
            </div>

            @if (filtersOpen)
            {
                <div id="sta-filter-panel" class="sta-f">
                    <div class="sta-f-grid">
                        <fieldset class="sta-f-group">
                            <legend>From warehouse</legend>
                            <NocturnePicker Class="npick-chips npick-block" Options="FromOptions" Value="@null"
                                            ValueChanged="@(code => AddWarehouseAsync(fromFilter, code))"
                                            Loading="isLoadingWarehouses" Placeholder="Add a warehouse…"
                                            SearchPlaceholder="Search code or name…" Caption="Leaving"
                                            AllowClear="false" AriaLabel="Add a source warehouse" />
                            @if (fromFilter.Count > 0)
                            {
                                <div class="sta-f-chips">
                                    @foreach (var warehouseCode in fromFilter)
                                    {
                                        <button type="button" class="sta-f-chip is-on is-code" aria-label="Remove source warehouse @warehouseCode"
                                                @onclick="() => RemoveWarehouseAsync(fromFilter, warehouseCode)">
                                            <span>@warehouseCode</span><i class="ph ph-x" aria-hidden="true"></i>
                                        </button>
                                    }
                                </div>
                            }
                        </fieldset>

                        <fieldset class="sta-f-group">
                            <legend>To warehouse</legend>
                            <NocturnePicker Class="npick-chips npick-block" Options="ToOptions" Value="@null"
                                            ValueChanged="@(code => AddWarehouseAsync(toFilter, code))"
                                            Loading="isLoadingWarehouses" Placeholder="Add a warehouse…"
                                            SearchPlaceholder="Search code or name…" Caption="Entering"
                                            AllowClear="false" AriaLabel="Add a destination warehouse" />
                            @if (toFilter.Count > 0)
                            {
                                <div class="sta-f-chips">
                                    @foreach (var warehouseCode in toFilter)
                                    {
                                        <button type="button" class="sta-f-chip is-on is-code" aria-label="Remove destination warehouse @warehouseCode"
                                                @onclick="() => RemoveWarehouseAsync(toFilter, warehouseCode)">
                                            <span>@warehouseCode</span><i class="ph ph-x" aria-hidden="true"></i>
                                        </button>
                                    }
                                </div>
                            }
                        </fieldset>

                        <fieldset class="sta-f-group">
                            <legend>Raised</legend>
                            <div class="sta-f-chips">
                                @foreach (var age in AgeChoices)
                                {
                                    <button type="button" class="sta-f-chip @(ageFilter == age.Key ? "is-on" : "")"
                                            aria-pressed="@(ageFilter == age.Key ? "true" : "false")"
                                            @onclick="() => SetAgeAsync(age.Key)">
                                        <i class="ph ph-check sta-f-tick" aria-hidden="true"></i><span>@age.Label</span>
                                    </button>
                                }
                            </div>
                        </fieldset>

                        <fieldset class="sta-f-group">
                            <legend>Only show</legend>
                            <div class="sta-f-chips">
                                <button type="button" class="sta-f-chip @(attachedOnly ? "is-on" : "")"
                                        aria-pressed="@(attachedOnly ? "true" : "false")" @onclick="ToggleAttachedAsync">
                                    <i class="ph ph-check sta-f-tick" aria-hidden="true"></i><span>Has attachment</span>
                                </button>
                            </div>
                        </fieldset>
                    </div>
                    <div class="sta-f-foot">
                        <span class="sta-f-count" aria-live="polite">@FilterSummary</span>
                        <div class="sta-f-actions">
                            <button type="button" class="sta-btn sta-btn-ghost sta-btn-lg" @onclick="ClearFiltersAsync"
                                    disabled="@(ActiveFilters.Count == 0)">Clear all</button>
                            <button type="button" class="sta-btn sta-btn-primary sta-btn-lg" @onclick="ToggleFilters">Done</button>
                        </div>
                    </div>
                </div>
            }
            else if (ActiveFilters.Count > 0)
            {
                <div class="sta-f-active">
                    <span class="sta-f-active-label">Filtered by</span>
                    @foreach (var active in ActiveFilters)
                    {
                        <button type="button" class="sta-f-chip is-on is-sm" aria-label="Remove filter @active.Label"
                                @onclick="active.Remove">
                            <span>@active.Label</span><i class="ph ph-x" aria-hidden="true"></i>
                        </button>
                    }
                    <button type="button" class="sta-f-clear" @onclick="ClearFiltersAsync">Clear all</button>
                </div>
            }

            <div class="sta-q-row sta-q-colhead" aria-hidden="true">
                <div>Route</div>
                <div>Comment</div>
                <div>Raised by</div>
                <div>Approval stage</div>
                <div class="sta-q-end">Status</div>
            </div>

            @if (isLoading)
            {
                @for (var skeletonRow = 0; skeletonRow < 6; skeletonRow++)
                {
                    <div class="sta-q-item">
                        <div class="sta-q-row">
                            @for (var skeletonCell = 0; skeletonCell < 5; skeletonCell++)
                            {
                                <div><div class="sta-skel"></div></div>
                            }
                        </div>
                    </div>
                }
            }
            else
            {
                @foreach (var group in DayGroups)
                {
                    <div class="sta-q-day">
                        <span class="sta-q-day-rel">@DayRelative(group.Key)</span>
                        <span class="sta-q-day-date">@DayLabel(group.Key)</span>
                        <span class="sta-q-day-count">@(group.Count() == 1 ? "1 transfer" : $"{group.Count()} transfers")</span>
                    </div>
                    @foreach (var draft in group)
                    {
                        <div @key="draft.DraftEntry" class="sta-q-item @(detailEntry == draft.DraftEntry ? "is-open" : "")">
                            <div class="sta-q-row">
                                <div class="sta-q-route-cell">
                                    <span class="sta-q-route">
                                        <span class="sta-q-code">@(draft.FromWarehouse ?? "—")</span>
                                        <i class="ph ph-arrow-right" role="img" aria-label="to"></i>
                                        <span class="sta-q-code">@(draft.ToWarehouse ?? "—")</span>
                                    </span>
                                    <span class="sta-q-refs">
                                        <span>Draft @draft.DraftNum</span>
                                        @if (draft.RequestCode is int requestCode)
                                        {
                                            <span aria-hidden="true">·</span><span>Req @requestCode</span>
                                        }
                                        @if (draft.HasAttachment)
                                        {
                                            <i class="ph ph-paperclip" role="img" aria-label="Has an attachment" title="Has an attachment"></i>
                                        }
                                    </span>
                                </div>
                                <div class="sta-q-comment">
                                    @if (string.IsNullOrWhiteSpace(RowComments(draft)))
                                    {
                                        <span class="sta-q-none">No comment</span>
                                    }
                                    else
                                    {
                                        <span class="sta-q-comment-text" title="@RowComments(draft)">@RowComments(draft)</span>
                                    }
                                </div>
                                <div class="sta-q-stack">
                                    <span class="sta-q-main">@(draft.OriginatorName ?? draft.OriginatorUserCode ?? "—")</span>
                                    @if (!string.IsNullOrWhiteSpace(draft.OriginatorName) && !string.IsNullOrWhiteSpace(draft.OriginatorUserCode))
                                    {
                                        <span class="sta-q-sub">@draft.OriginatorUserCode</span>
                                    }
                                </div>
                                <div class="sta-q-stack">
                                    <span class="sta-q-main">@(draft.StageName ?? (draft.StageCode is int stageCode ? $"Stage {stageCode}" : "—"))</span>
                                    @if (!string.IsNullOrWhiteSpace(draft.TemplateName))
                                    {
                                        <span class="sta-q-sub">@draft.TemplateName</span>
                                    }
                                </div>
                                <div class="sta-q-act">
                                    @if (draft.CanAdd)
                                    {
                                        <span class="sta-q-pill is-ready"><i class="ph ph-check" aria-hidden="true"></i>Ready to add</span>
                                    }
                                    else
                                    {
                                        <span class="sta-q-pill is-held"><i class="ph ph-warning" aria-hidden="true"></i>Held</span>
                                    }
                                    <button type="button" class="sta-btn sta-btn-secondary sta-btn-lg sta-q-review"
                                            aria-label="Review draft @draft.DraftNum" @onclick="() => OpenAsync(draft.DraftEntry)">
                                        <span>Review</span><i class="ph ph-caret-right" aria-hidden="true"></i>
                                    </button>
                                </div>
                            </div>
                            @if (!draft.CanAdd && !string.IsNullOrWhiteSpace(draft.StatusNote))
                            {
                                <div class="sta-q-note">
                                    <i class="ph ph-info" aria-hidden="true"></i><span>@draft.StatusNote</span>
                                </div>
                            }
                        </div>
                    }
                }

                @if (drafts.Count == 0)
                {
                    <div class="sta-empty">
                        <i class="ph ph-seal-check" aria-hidden="true"></i>
                        <span>@EmptyMessage</span>
                        @if (ActiveFilters.Count > 0 || !string.IsNullOrWhiteSpace(appliedSearch))
                        {
                            <button type="button" class="sta-btn sta-btn-secondary sta-btn-lg" @onclick="ClearEverythingAsync">Clear search and filters</button>
                        }
                    </div>
                }
            }

            <div class="sta-q-foot">
                <span class="sta-q-foot-range" aria-live="polite">
                    @if (totalCount > 0)
                    {
                        <span>Showing <strong>@RangeText</strong> of <strong>@totalCount.ToString("N0")</strong> @(IsNarrowed ? "matching" : "approved"), newest first</span>
                    }
                </span>
                <div class="sta-q-pager">
                    <nav class="sta-pager" aria-label="Pages">
                        <button type="button" class="sta-btn sta-btn-secondary sta-btn-icon-lg" title="Previous page"
                                aria-label="Previous page" disabled="@(currentPage <= 1 || isLoading)" @onclick="PreviousPageAsync">
                            <svg viewBox="0 0 256 256" aria-hidden="true" focusable="false">
                                <path d="M165.66,202.34a8,8,0,0,1-11.32,11.32l-80-80a8,8,0,0,1,0-11.32l80-80a8,8,0,0,1,11.32,11.32L91.31,128Z" />
                            </svg>
                        </button>
                        @foreach (var pageNumber in PageButtons)
                        {
                            @if (pageNumber is int number)
                            {
                                @if (number == currentPage)
                                {
                                    <button type="button" class="sta-q-pagenum is-current" aria-current="page" aria-label="Page @number">@number</button>
                                }
                                else
                                {
                                    <button type="button" class="sta-q-pagenum" aria-label="Page @number" disabled="@isLoading"
                                            @onclick="() => GoToPageAsync(number)">@number</button>
                                }
                            }
                            else
                            {
                                <span class="sta-q-gap" aria-hidden="true">…</span>
                            }
                        }
                        <button type="button" class="sta-btn sta-btn-secondary sta-btn-icon-lg" title="Next page"
                                aria-label="Next page" disabled="@(!CanGoNext || isLoading)" @onclick="NextPageAsync">
                            <svg viewBox="0 0 256 256" aria-hidden="true" focusable="false">
                                <path d="M181.66,133.66l-80,80a8,8,0,0,1-11.32-11.32L164.69,128,90.34,53.66a8,8,0,0,1,11.32-11.32l80,80A8,8,0,0,1,181.66,133.66Z" />
                            </svg>
                        </button>
                    </nav>
                    <span class="sta-q-pagepill">Page <strong>@currentPage</strong> of <strong>@TotalPages</strong></span>
                </div>
            </div>
        </section>
    </div>
</div>

@if (detailEntry is not null)
{
    <div class="sta-overlay">
        <div class="sta-scrim" @onclick="CloseDetail"></div>
        <aside class="sta-drawer" aria-label="Held transfer details">
            <div class="sta-d-head">
                <div class="sta-d-titlerow">
                    <h2 class="sta-drawer-title">Draft @(detail?.Draft.DraftNum.ToString() ?? detailEntry.ToString())</h2>
                    @if (detail is not null)
                    {
                        @if (detail.Draft.CanAdd)
                        {
                            <span class="sta-q-pill is-ready"><i class="ph ph-check" aria-hidden="true"></i>Ready to add</span>
                        }
                        else
                        {
                            <span class="sta-q-pill is-held"><i class="ph ph-warning" aria-hidden="true"></i>Held</span>
                        }
                    }
                    <button type="button" class="sta-btn sta-btn-ghost sta-btn-icon-lg sta-d-close" title="Close"
                            aria-label="Close details" @onclick="CloseDetail">
                        <svg viewBox="0 0 256 256" aria-hidden="true" focusable="false">
                            <path d="M205.66,194.34a8,8,0,0,1-11.32,11.32L128,139.31,61.66,205.66a8,8,0,0,1-11.32-11.32L116.69,128,50.34,61.66A8,8,0,0,1,61.66,50.34L128,116.69l66.34-66.35a8,8,0,0,1,11.32,11.32L139.31,128Z" />
                        </svg>
                    </button>
                </div>
                @if (detail is not null)
                {
                    <div class="sta-d-route">
                        <span class="sta-q-code">@(detail.Draft.FromWarehouse ?? "—")</span>
                        <i class="ph ph-arrow-right" role="img" aria-label="to"></i>
                        <span class="sta-q-code">@(detail.Draft.ToWarehouse ?? "—")</span>
                    </div>
                }
            </div>
            <div class="sta-drawer-body">
                @if (isLoadingDetail)
                {
                    <div class="sta-note">Reading the draft from SAP…</div>
                }
                else if (detail is null)
                {
                    <div class="sta-alert" role="alert">
                        <i class="ph ph-warning-octagon" aria-hidden="true"></i>
                        <div class="sta-alert-body">@(detailError ?? "This draft could not be read from SAP.")</div>
                    </div>
                }
                else
                {
                    @if (!string.IsNullOrEmpty(detailError))
                    {
                        <div class="sta-alert" role="alert">
                            <i class="ph ph-warning-octagon" aria-hidden="true"></i>
                            <div class="sta-alert-body">@detailError</div>
                        </div>
                    }

                    @if (!detail.Draft.CanAdd && !string.IsNullOrWhiteSpace(detail.Draft.StatusNote))
                    {
                        <div class="sta-blocked">
                            <i class="ph ph-warning" aria-hidden="true"></i>
                            <div class="sta-alert-body">@detail.Draft.StatusNote</div>
                        </div>
                    }

                    <dl class="sta-grid sta-d-facts">
                        <div>
                            <dt class="sta-dt">Raised by</dt>
                            <dd class="sta-dd">@(detail.Draft.OriginatorName ?? detail.Draft.OriginatorUserCode ?? "—")</dd>
                            @if (!string.IsNullOrWhiteSpace(detail.Draft.OriginatorName) && !string.IsNullOrWhiteSpace(detail.Draft.OriginatorUserCode))
                            {
                                <dd class="sta-d-sub">@detail.Draft.OriginatorUserCode</dd>
                            }
                        </div>
                        <div>
                            <dt class="sta-dt">Raised</dt>
                            <dd class="sta-dd">@FormatDate(RaisedDate(detail.Draft))</dd>
                            <dd class="sta-d-sub">@AgeText(RaisedDate(detail.Draft))</dd>
                        </div>
                        <div>
                            <dt class="sta-dt">Approval request</dt>
                            <dd class="sta-dd">@(detail.Draft.RequestCodes.Count == 0 ? "—" : string.Join(", ", detail.Draft.RequestCodes))</dd>
                        </div>
                        <div>
                            <dt class="sta-dt">Due</dt>
                            <dd class="sta-dd">@FormatDate(detail.Draft.DueDate)</dd>
                        </div>
                        <div>
                            <dt class="sta-dt">Stage</dt>
                            <dd class="sta-dd">@(detail.Draft.StageName ?? "—")</dd>
                            @if (!string.IsNullOrWhiteSpace(detail.Draft.TemplateName))
                            {
                                <dd class="sta-d-sub">@detail.Draft.TemplateName</dd>
                            }
                        </div>
                        <div>
                            <dt class="sta-dt">Attachment</dt>
                            <dd class="sta-dd">@(detail.Draft.HasAttachment ? "Yes, in SAP" : "None")</dd>
                        </div>
                    </dl>

                    @if (!string.IsNullOrWhiteSpace(detail.Draft.Comments) || !string.IsNullOrWhiteSpace(detail.Draft.RequestRemarks))
                    {
                        <div class="sta-note">
                            <div class="sta-dt">Comment</div>
                            @(detail.Draft.Comments ?? detail.Draft.RequestRemarks)
                        </div>
                    }

                    @if (detail.LinkedRequests.Count > 0)
                    {
                        <div>
                            <div class="sta-sect"><i class="ph ph-arrow-bend-down-right" aria-hidden="true"></i>Copied from</div>
                            <div class="sta-linked">
                                @foreach (var linked in detail.LinkedRequests)
                                {
                                    <div class="sta-linked-item">
                                        <span>Transfer request #@(linked.DocNum?.ToString() ?? linked.DocEntry.ToString())</span>
                                        @if (!string.IsNullOrWhiteSpace(linked.FromWarehouse))
                                        {
                                            <span class="sta-route">
                                                <span class="sta-wh">@linked.FromWarehouse</span>
                                                <span class="sta-route-arrow" aria-label="to">→</span>
                                                <span class="sta-wh">@linked.ToWarehouse</span>
                                            </span>
                                        }
                                        <span class="sta-tag">@(linked.Status ?? "Not read")</span>
                                    </div>
                                }
                            </div>
                            <div class="sta-note" style="margin-top:var(--sta-s2)">
                                Adding the draft closes a request that is still open, so it is not converted again.
                            </div>
                        </div>
                    }

                    <div>
                        <div class="sta-sect">
                            <i class="ph ph-list-bullets" aria-hidden="true"></i>Lines
                            <span class="sta-d-count">@(detail.Lines.Count == 1 ? "1 line" : $"{detail.Lines.Count} lines")</span>
                        </div>
                        @if (detail.SelectionUnchecked)
                        {
                            <div class="sta-note">SAP did not say which items it manages by batch, so the batch picks could not be checked here. SAP checks them when the transfer is added.</div>
                        }
                        <ul class="sta-d-lines">
                            @foreach (var line in detail.Lines)
                            {
                                <li class="sta-d-line @(line.SelectionMissing ? "is-missing" : "")">
                                    <div class="sta-d-line-top">
                                        <div class="sta-d-line-item">
                                            <span class="sta-d-line-code">@line.ItemCode</span>
                                            <span class="sta-d-line-desc">@line.ItemDescription</span>
                                            @if (LineRouteDiffers(line))
                                            {
                                                <span class="sta-d-line-desc">@line.FromWarehouse → @line.ToWarehouse</span>
                                            }
                                            @if (line.BaseRequestDocEntry is not null)
                                            {
                                                <span class="sta-copied">From the request</span>
                                            }
                                        </div>
                                        <span class="sta-d-line-qty">@QuantityDisplay.Format(line.Quantity) @line.UoMCode</span>
                                    </div>
                                    <div class="sta-d-batches">
                                        @foreach (var batch in line.Batches)
                                        {
                                            <span class="sta-d-batch">
                                                <span class="sta-batch-no">@batch.BatchNumber</span>
                                                <span class="sta-batch-qty">× @QuantityDisplay.Format(batch.Quantity)</span>
                                            </span>
                                        }
                                        @if (line.Batches.Count == 0 && line.SerialCount > 0)
                                        {
                                            <span class="sta-batch-qty">@line.SerialCount serial numbers</span>
                                        }
                                        @if (line.SelectionMissing)
                                        {
                                            <span class="sta-d-missing">
                                                <i class="ph ph-warning" aria-hidden="true"></i>
                                                @(line.Batches.Count == 0 && line.SerialCount == 0 ? "No batch picked" : "Pick incomplete")
                                            </span>
                                        }
                                        else if (line.Batches.Count == 0 && line.SerialCount == 0)
                                        {
                                            <span class="sta-batch-qty">@(line.ManagesBatches == false && line.ManagesSerials == false ? "Not batch-managed" : "No batch")</span>
                                        }
                                    </div>
                                </li>
                            }
                        </ul>
                    </div>

                    @if (detail.Approvals.Count > 0)
                    {
                        <div>
                            <div class="sta-sect"><i class="ph ph-users-three" aria-hidden="true"></i>Approved in SAP</div>
                            <ul class="sta-rail">
                                @foreach (var approval in detail.Approvals)
                                {
                                    @foreach (var decision in approval.Decisions)
                                    {
                                        <li class="sta-rail-item">
                                            <span class="sta-dot @StatusModifier(decision.Status)" aria-hidden="true"></span>
                                            <div class="sta-rail-body">
                                                <div class="sta-rail-who">@(decision.UserName ?? decision.UserCode ?? $"User {decision.UserId}")</div>
                                                <div class="sta-rail-meta">
                                                    Request @approval.Code · @(decision.StageName ?? approval.StageName ?? $"Stage {decision.StageCode}") · @decision.Status
                                                    @if (decision.DecidedDate is not null)
                                                    {
                                                        <span> · @FormatDate(decision.DecidedDate)</span>
                                                    }
                                                </div>
                                                @if (!string.IsNullOrWhiteSpace(decision.Remarks))
                                                {
                                                    <div class="sta-rail-remarks">@decision.Remarks</div>
                                                }
                                            </div>
                                        </li>
                                    }
                                }
                            </ul>
                        </div>
                    }
                }
            </div>

            @* The add is confirmed here, in the footer, rather than in a dialog stacked over the drawer:
               the draft being added stays in view while the question is asked. *@
            <div class="sta-drawer-foot @(showAddConfirm ? "is-confirming" : "")">
                @if (showAddConfirm && detail is not null)
                {
                    <div class="sta-d-confirm" role="alertdialog" aria-label="Confirm add">
                        <div class="sta-confirm-copy">
                            Post draft @detail.Draft.DraftNum as an inventory transfer of
                            @detail.Lines.Count @(detail.Lines.Count == 1 ? "line" : "lines") from
                            @detail.Draft.FromWarehouse to @detail.Draft.ToWarehouse?
                        </div>
                        <div class="sta-confirm-sub">
                            The stock leaves @detail.Draft.FromWarehouse in SAP.
                            @if (OpenLinkedRequests.Count > 0)
                            {
                                <span>Transfer request #@string.Join(", #", OpenLinkedRequests) is closed with it.</span>
                            }
                            This cannot be undone.
                        </div>
                        <div class="sta-d-confirm-actions">
                            <button type="button" class="sta-btn sta-btn-secondary sta-btn-lg" @onclick="CloseAddConfirm"
                                    disabled="@isSubmitting">Back</button>
                            <button type="button" class="sta-btn sta-btn-primary sta-btn-lg" @onclick="AddAsync" disabled="@isSubmitting">
                                @if (isSubmitting)
                                {
                                    <span class="sta-spin" aria-hidden="true"></span>
                                }
                                <span>Post to SAP</span>
                            </button>
                        </div>
                    </div>
                }
                else if (detail is not null && !detail.Draft.CanAdd)
                {
                    <span class="sta-d-foot-note">Fix the draft in SAP Business One, then refresh to add it.</span>
                    <button type="button" class="sta-btn sta-btn-secondary sta-btn-lg" @onclick="CloseDetail">Close</button>
                }
                else
                {
                    <button type="button" class="sta-btn sta-btn-secondary sta-btn-lg" @onclick="CloseDetail" disabled="@isSubmitting">Close</button>
                    @if (detail?.Draft.CanAdd == true)
                    {
                        <button type="button" class="sta-btn sta-btn-primary sta-btn-lg" @onclick="OpenAddConfirm" disabled="@isSubmitting">
                            <i class="ph ph-plus" aria-hidden="true"></i>
                            <span>Add transfer</span>
                        </button>
                    }
                }
            </div>
        </aside>
    </div>
}
