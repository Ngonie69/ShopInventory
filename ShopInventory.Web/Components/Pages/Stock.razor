@page "/stock"
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using ShopInventory.Web.Data
@using ShopInventory.Web.Services
@using ShopInventory.Web.Models
@attribute [Authorize(Roles = UserRoles.CatalogueRoles)]
@inject IMasterDataCacheService MasterDataCache
@inject HttpClient Http
@inject AuthenticationStateProvider AuthStateProvider
@inject IAppSettingsProvider AppSettings
@inject IAuditService AuditService
@rendermode InteractiveServer

<PageTitle>Stock Monitoring - Shop Inventory</PageTitle>
@* Styles live in wwwroot/css/operations.css (linked from App.razor), shared
   with the other four operational pages — see that file's header. `ops` is the
   scope; `ops-stk` is this page's own half of it.

   The 757-line inline <style> block is gone, and so are the *unnamespaced*
   class names it dressed. This page's markup used bare `stat-card`,
   `filter-bar`, `filter-field`, `empty-state`, `loading-state`,
   `detail-drawer`, `alert-banner` and `item-code` — all of which app.css also
   styles, and all of which three to six other pages still use. Those app.css
   rules are deliberately left alone: deleting them because this page stopped
   calling them would have silently restyled /local-stock and its siblings. *@

<div class="ops ops-stk">

    <div class="ops-hero">
        <div class="ops-hero-text">
            <div class="ops-kicker">Inventory</div>
            <h1>Stock Monitoring</h1>
            <p>
                On-hand, committed and available quantities for one warehouse, straight from SAP.
                Available already includes what is on order.
            </p>
        </div>
        <div class="ops-hero-actions">
            @if (lowStockCount > 0)
            {
                <button type="button" class="ops-btn ops-btn-warn" @onclick="ShowLowStockAlerts"
                        disabled="@(stockItems.Count == 0)">
                    <i class="ph ph-warning" aria-hidden="true"></i>
                    <span>Low stock (@lowStockCount)</span>
                </button>
            }
            <button type="button" class="ops-btn ops-btn-primary" @onclick="RefreshStock" disabled="@isLoading">
                @if (isLoading)
                {
                    <span class="ops-spin"></span>
                    <span>Loading&hellip;</span>
                }
                else
                {
                    <i class="ph ph-arrows-clockwise" aria-hidden="true"></i>
                    <span>Refresh</span>
                }
            </button>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(errorMessage))
    {
        <div class="ops-msg ops-fam-bad" role="alert">
            <i class="ph ph-warning-octagon" aria-hidden="true"></i>
            <div class="ops-msg-body">@errorMessage</div>
            <button type="button" class="ops-msg-x" aria-label="Dismiss" @onclick="() => errorMessage = null">
                <i class="ph ph-x" aria-hidden="true"></i>
            </button>
        </div>
    }

    @if (stockItems.Any())
    {
        @* Low and out-of-stock take their family only when the count is not
           zero — a permanently red figure would say something is wrong on a
           day when nothing is. *@
        <div class="ops-figures">
            <div class="ops-figure ops-fam-accent">
                <div class="ops-figure-head"><span class="ops-figure-rule"></span>Total SKUs</div>
                <div class="ops-figure-num">@totalItems</div>
            </div>
            <div class="ops-figure ops-fam-good">
                <div class="ops-figure-head"><span class="ops-figure-rule"></span>Healthy</div>
                <div class="ops-figure-num">@inStockCount</div>
            </div>
            <div class="ops-figure @(lowStockCount > 0 ? "ops-fam-warn" : "ops-fam-neutral")">
                <div class="ops-figure-head"><span class="ops-figure-rule"></span>Low stock</div>
                <div class="ops-figure-num">@lowStockCount</div>
                @if (lowStockCount > 0)
                {
                    <div class="ops-figure-sub">Needs reorder</div>
                }
            </div>
            <div class="ops-figure @(outOfStockCount > 0 ? "ops-fam-bad" : "ops-fam-neutral")">
                <div class="ops-figure-head"><span class="ops-figure-rule"></span>Out of stock</div>
                <div class="ops-figure-num">@outOfStockCount</div>
                @if (outOfStockCount > 0)
                {
                    <div class="ops-figure-sub">Nothing available</div>
                }
            </div>
        </div>
    }

    <section class="ops-panel">
        <div class="ops-panel-head">
            <h2><i class="ph ph-clipboard-text" aria-hidden="true"></i>Stock status</h2>
            @if (stockItems.Any())
            {
                <span class="ops-count">@filteredItems.Count() of @stockItems.Count items</span>
            }
        </div>

        <div class="ops-filters">
            <div class="ops-field ops-field-lead">
                <label class="ops-label" for="stk-warehouse">Warehouse</label>
                @if (isLoadingWarehouses)
                {
                    <div class="ops-loading">
                        <span class="ops-spin"></span>
                        <p>Loading warehouses&hellip;</p>
                    </div>
                }
                else
                {
                    <NocturneSelect Id="stk-warehouse" Class="nsel-block" Options="WarehouseSelectOptions"
                                    @bind-Value="selectedWarehouseCode" Disabled="isWarehouseLocked"
                                    Caption="Warehouse" AriaLabel="Warehouse"
                                    Placeholder="Select a warehouse" />
                    @if (isWarehouseLocked)
                    {
                        <small>Fixed to the warehouse on your account.</small>
                    }
                }
            </div>
            <div class="ops-field">
                <label class="ops-label" for="stk-status">Stock status</label>
                <NocturneSelect Id="stk-status" Class="nsel-block" Options="StockFilterOptions"
                                @bind-Value="stockFilter" Caption="Filter by stock status"
                                AriaLabel="Filter by stock status" />
            </div>
            <div class="ops-field">
                <label class="ops-label" for="stk-threshold">Low threshold</label>
                <input id="stk-threshold" type="number" class="ops-input" min="1" max="1000"
                       @bind="lowStockThreshold" />
            </div>
            <div class="ops-field">
                <label class="ops-label" for="stk-search">Search item</label>
                <div class="ops-search">
                    <i class="ph ph-magnifying-glass" aria-hidden="true"></i>
                    <input id="stk-search" type="search" class="ops-input" placeholder="Code, name or barcode"
                           @bind="searchTerm" @bind:event="oninput" @onkeypress="OnSearchKeyPress" />
                </div>
            </div>
            <div class="ops-filter-actions">
                <button type="button" class="ops-btn ops-btn-primary" @onclick="LoadStock"
                        disabled="@(string.IsNullOrEmpty(selectedWarehouseCode))">
                    <i class="ph ph-magnifying-glass" aria-hidden="true"></i>Load
                </button>
                <button type="button" class="ops-btn ops-btn-ghost" @onclick="ClearFilters">
                    <i class="ph ph-x-circle" aria-hidden="true"></i>Clear
                </button>
            </div>
        </div>

        @if (isLoading)
        {
            <div class="ops-loading">
                <span class="ops-spin ops-spin-lg"></span>
                <p>Loading stock data&hellip;</p>
            </div>
        }
        else if (string.IsNullOrEmpty(selectedWarehouseCode) && !stockItems.Any())
        {
            <div class="ops-empty">
                <i class="ph ph-warehouse" aria-hidden="true"></i>
                <h3>Select a warehouse</h3>
                <p>Stock is held per warehouse, so pick one above to see its levels.</p>
            </div>
        }
        else if (!stockItems.Any())
        {
            <div class="ops-empty">
                <i class="ph ph-package" aria-hidden="true"></i>
                <h3>No stock items found</h3>
                <p>Nothing in this warehouse matches the current filters.</p>
                <div class="ops-empty-actions">
                    <button type="button" class="ops-btn ops-btn-ghost" @onclick="RefreshStock">
                        <i class="ph ph-arrows-clockwise" aria-hidden="true"></i>Retry
                    </button>
                </div>
            </div>
        }
        else
        {
            <div class="ops-scroll ops-tall">
                <table class="ops-table mobile-card-table">
                    <thead>
                        <tr>
                            <th class="ops-mid">Status</th>
                            <th>Item code</th>
                            <th>Item name</th>
                            <th class="ops-num">On hand</th>
                            <th class="ops-num">Committed</th>
                            <th class="ops-num">On order</th>
                            <th class="ops-num">Available</th>
                            <th>UoM</th>
                            <th class="ops-mid">Health</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in filteredItems)
                        {
                            @* One family per row, read by the dot, the available
                               quantity and the meter alike — so the three cannot
                               disagree, which three separate colour ladders used
                               to allow. *@
                            var family = item.Available <= 0
                                ? "ops-fam-bad"
                                : item.Available < lowStockThreshold ? "ops-fam-warn" : "ops-fam-good";
                            var rowClass = item.Available <= 0
                                ? "ops-row-bad"
                                : item.Available < lowStockThreshold ? "ops-row-warn" : "";
                            var healthPercent = item.InStock > 0
                                ? Math.Min(100, (item.Available / lowStockThreshold) * 100)
                                : 0;

                            <tr class="@rowClass">
                                <td data-label="Status" class="ops-mid">
                                    <span class="ops-dot @family"
                                          title="@(item.Available <= 0 ? "Out of stock"
                                                : item.Available < lowStockThreshold ? "Low stock" : "Healthy")"></span>
                                </td>
                                <td data-label="Item code"><span class="ops-code">@item.ItemCode</span></td>
                                <td data-label="Item name" class="ops-name">@item.ItemName</td>
                                <td data-label="On hand" class="ops-num">
                                    <span class="ops-qty">@item.InStock.ToString("N0")</span>
                                </td>
                                <td data-label="Committed" class="ops-num">
                                    <span class="ops-qty">@item.Committed.ToString("N0")</span>
                                </td>
                                <td data-label="On order" class="ops-num">
                                    <span class="ops-qty">@item.Ordered.ToString("N0")</span>
                                </td>
                                <td data-label="Available" class="ops-num">
                                    <span class="ops-qty @family">@item.Available.ToString("N0")</span>
                                </td>
                                <td data-label="UoM"><span class="ops-unit">@item.UoM</span></td>
                                <td data-label="Health" class="ops-mid">
                                    <div class="ops-meter @family" title="@healthPercent.ToString("N0")% of threshold">
                                        <div class="ops-meter-fill" style="width:@healthPercent%"></div>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            @if (hasMore || currentPage > 1)
            {
                <div class="ops-foot">
                    <span class="ops-foot-info">Page @currentPage</span>
                    <div class="ops-pages">
                        <button type="button" class="ops-step" disabled="@(currentPage == 1)" @onclick="PreviousPage">
                            <i class="ph ph-caret-left" aria-hidden="true"></i>Previous
                        </button>
                        <span class="ops-page-now">@currentPage</span>
                        <button type="button" class="ops-step" disabled="@(!hasMore)" @onclick="NextPage">
                            Next<i class="ph ph-caret-right" aria-hidden="true"></i>
                        </button>
                    </div>
                </div>
            }
        }
    </section>
</div>

@* The drawer is a sibling of `.ops`, not a child — see operations.css's header
   for why it carries `.ops-overlay` itself. *@
@if (showWarehouseDetails && selectedWarehouse != null)
{
    <div class="ops-overlay ops-overlay-right" @onclick="() => showWarehouseDetails = false">
        <aside class="ops-drawer" role="dialog" aria-modal="true" aria-label="Warehouse details"
               @onclick:stopPropagation="true">
            <div class="ops-drawer-head">
                <h2>Warehouse details</h2>
                <button type="button" class="ops-x" aria-label="Close"
                        @onclick="() => showWarehouseDetails = false">
                    <i class="ph ph-x" aria-hidden="true"></i>
                </button>
            </div>

            <div class="ops-drawer-body">
                <div class="ops-defs">
                    <div>
                        <div class="ops-def-k">Code</div>
                        <div class="ops-def-v">@selectedWarehouse.WarehouseCode</div>
                    </div>
                    <div>
                        <div class="ops-def-k">Name</div>
                        <div class="ops-def-v">@selectedWarehouse.WarehouseName</div>
                    </div>
                    <div>
                        <div class="ops-def-k">Location</div>
                        <div class="ops-def-v">@(selectedWarehouse.Location ?? "—")</div>
                    </div>
                    <div>
                        <div class="ops-def-k">City</div>
                        <div class="ops-def-v">@(selectedWarehouse.City ?? "—")</div>
                    </div>
                    <div>
                        <div class="ops-def-k">Country</div>
                        <div class="ops-def-v">@(selectedWarehouse.Country ?? "—")</div>
                    </div>
                    <div>
                        <div class="ops-def-k">Status</div>
                        <div class="ops-def-v">
                            <span class="ops-badge @(selectedWarehouse.IsActive ? "ops-fam-good" : "ops-fam-neutral")">
                                @(selectedWarehouse.IsActive ? "Active" : "Inactive")
                            </span>
                        </div>
                    </div>
                </div>
            </div>

            <div class="ops-drawer-foot">
                <button type="button" class="ops-btn ops-btn-ghost"
                        @onclick="() => showWarehouseDetails = false">Close</button>
            </div>
        </aside>
    </div>
}

@code {
    // "all" rather than an empty string is this page's no-filter sentinel, so
    // that row carries IsUnset and the trigger stays in its resting state.
    private static readonly NocturneSelectOption<string>[] StockFilterOptions =
    [
        new("all", "All items", "neutral") { IsUnset = true, RuleAfter = true },
        new("instock", "Healthy", "good"),
        new("lowstock", "Low stock", "warn"),
        new("outofstock", "Out of stock", "bad")
    ];

    private IEnumerable<NocturneSelectOption<string>> WarehouseSelectOptions =>
        warehouses
            .Where(w => !string.IsNullOrWhiteSpace(w.WarehouseCode))
            .Select(w => new NocturneSelectOption<string>(
                w.WarehouseCode!, w.WarehouseName ?? w.WarehouseCode!) { Hint = w.WarehouseCode });

    private List<WarehouseDto> warehouses = new();
    private List<StockQuantityDto> stockItems = new();
    private WarehouseDto? selectedWarehouse;
    private string selectedWarehouseCode = "";
    private string searchTerm = "";
    private string stockFilter = "all";
    private bool isLoading = false;
    private bool isLoadingWarehouses = true;
    private bool showWarehouseDetails = false;
    private string? errorMessage;
    private int currentPage = 1;
    private int pageSize = 50;
    private bool hasMore = false;
    private int lowStockThreshold = 10;

    private int totalItems => stockItems.Count;
    private int inStockCount => stockItems.Count(i => i.Available > lowStockThreshold);
    private int lowStockCount => stockItems.Count(i => i.Available > 0 && i.Available <= lowStockThreshold);
    private int outOfStockCount => stockItems.Count(i => i.Available <= 0);

    private IEnumerable<StockQuantityDto> filteredItems
    {
        get
        {
            var items = stockItems.AsEnumerable();

            if (!string.IsNullOrWhiteSpace(searchTerm))
            {
                var term = searchTerm.ToLowerInvariant();
                items = items.Where(i =>
                (i.ItemCode?.ToLowerInvariant().Contains(term) ?? false) ||
                (i.ItemName?.ToLowerInvariant().Contains(term) ?? false) ||
                (i.BarCode?.ToLowerInvariant().Contains(term) ?? false));
            }

            return stockFilter switch
            {
                "instock" => items.Where(i => i.Available > lowStockThreshold),
                "lowstock" => items.Where(i => i.Available > 0 && i.Available <= lowStockThreshold),
                "outofstock" => items.Where(i => i.Available <= 0),
                _ => items
            };
        }
    }

    private string? userAssignedWarehouse;
    private bool isWarehouseLocked = false;

    protected override async Task OnInitializedAsync()
    {
        pageSize = AppSettings.PageSize;
        // Check if user has an assigned warehouse (StockController/DepotController)
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;
        userAssignedWarehouse = user.FindFirst("warehouse")?.Value;
        var role = user.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value;

        await LoadWarehouses();

        // Auto-select and lock warehouse for StockController/DepotController
        if (!string.IsNullOrEmpty(userAssignedWarehouse) && (role == "StockController" || role == "DepotController"))
        {
            selectedWarehouseCode = userAssignedWarehouse;
            isWarehouseLocked = true;
            await LoadStock();
        }
        await AuditService.LogAsync(AuditActions.ViewStock, "Stock", null);
    }

    private async Task LoadWarehouses()
    {
        isLoadingWarehouses = true;
        try
        {
            var warehouseList = await MasterDataCache.GetWarehousesAsync();
            warehouses = warehouseList?.Where(w => w.IsActive).ToList() ?? new();
        }
        catch (Exception ex)
        {
            errorMessage = $"Failed to load warehouses: {ex.Message}";
        }
        finally
        {
            isLoadingWarehouses = false;
        }
    }

    private async Task LoadStock()
    {
        if (string.IsNullOrEmpty(selectedWarehouseCode)) return;

        isLoading = true;
        errorMessage = null;
        StateHasChanged();

        try
        {
            var response = await Http.GetFromJsonAsync<WarehouseStockPagedResponseDto>(
            $"/api/stock/warehouse/{selectedWarehouseCode}/paged?page={currentPage}&pageSize={pageSize}");

            if (response != null)
            {
                stockItems = response.Items ?? new();
                hasMore = response.HasMore;
            }

            selectedWarehouse = warehouses.FirstOrDefault(w => w.WarehouseCode == selectedWarehouseCode);
        }
        catch (Exception ex)
        {
            errorMessage = $"Failed to load stock: {ex.Message}";
            stockItems = new();
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task RefreshStock()
    {
        currentPage = 1;
        await LoadStock();
    }

    private async Task NextPage()
    {
        if (hasMore)
        {
            currentPage++;
            await LoadStock();
        }
    }

    private async Task PreviousPage()
    {
        if (currentPage > 1)
        {
            currentPage--;
            await LoadStock();
        }
    }

    private async Task OnSearchKeyPress(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !string.IsNullOrEmpty(selectedWarehouseCode))
        {
            await LoadStock();
        }
    }

    private void ClearFilters()
    {
        searchTerm = "";
        stockFilter = "all";
        selectedWarehouseCode = "";
        stockItems = new();
        currentPage = 1;
    }

    private void ShowLowStockAlerts()
    {
        stockFilter = "lowstock";
        StateHasChanged();
    }

    private string GetStockStatusClass(StockQuantityDto item)
    {
        if (item.Available <= 0) return "danger";
        if (item.Available < lowStockThreshold) return "warning";
        return "success";
    }

    private string GetAvailableClass(decimal available) => available switch
    {
        <= 0 => "text-danger",
        < 10 => "text-warning",
        _ => "text-success"
    };

    // DTOs for API responses (Stock-specific models not in shared models)
    public class StockQuantityDto
    {
        public string? ItemCode { get; set; }
        public string? ItemName { get; set; }
        public string? BarCode { get; set; }
        public string? WarehouseCode { get; set; }
        public decimal InStock { get; set; }
        public decimal Committed { get; set; }
        public decimal Ordered { get; set; }
        public decimal Available { get; set; }
        public string? UoM { get; set; }
    }

    public class WarehouseStockPagedResponseDto
    {
        public string? WarehouseCode { get; set; }
        public int Page { get; set; }
        public int PageSize { get; set; }
        public int Count { get; set; }
        public bool HasMore { get; set; }
        public DateTime QueryDate { get; set; }
        public List<StockQuantityDto>? Items { get; set; }
    }
}
