@page "/purchase-orders/create"
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize(Roles = "Admin,Manager")]
@inject IPurchaseOrderService PurchaseOrderService
@inject IMasterDataCacheService CacheService
@inject NavigationManager NavigationManager
@using ShopInventory.Web.Data
@using ShopInventory.Web.Services
@inject ILogger<CreatePurchaseOrder> Logger
@inject IAppSettingsProvider AppSettings
@inject IAuditService AuditService
@rendermode InteractiveServer

<PageTitle>Create Purchase Order - Shop Inventory</PageTitle>

@* Nocturne. wwwroot/css/purchase-forms.css (linked from App.razor) carries the
   design and its light counterpart, and follows the app's theme toggle like
   every other page. See CreatePurchaseQuotation for the notes on the line grid
   and the inline icons, which this page repeats.

   This page previously carried a 620-line <style> block whose dark half lived
   in app.css under `.cpo-*`. Both are gone with this sheet.

   No MudBlazor. The four MudAutocompletes this form used render their own
   chrome in MudBlazor's palette, which loads after every sheet here and cannot
   be reached from one — so the supplier picker is now the same native combo the
   other purchase forms use, and the two warehouse pickers are selects. All
   three lookups were already in-memory lists (`allBusinessPartners`,
   `cachedProducts`, `cachedWarehouses`), so nothing became slower: the async
   SearchFunc signatures they needed were filtering a list in place. *@

<datalist id="purchase-order-products">
    @foreach (var product in cachedProducts)
    {
        <option value="@product.ItemCode">@product.ItemName</option>
    }
</datalist>

<div class="pfm is-order">
    <div class="pfm-shell">

        <nav class="pfm-crumbs" aria-label="Breadcrumb">
            <a href="/purchase-orders">Purchase orders</a>
            <span class="pfm-crumb-sep" aria-hidden="true">/</span>
            <span class="pfm-crumb-now">New</span>
        </nav>

        <header class="pfm-head">
            <div class="pfm-head-main">
                <div class="pfm-kicker">Purchasing</div>
                <h1>New purchase order</h1>
                <p>
                    Order stock from a supplier &#8212; what is being bought, where it is to be
                    delivered, and what the order commits the business to.
                </p>
            </div>
            <div class="pfm-stats">
                <div class="pfm-stat">
                    <div class="pfm-stat-k">Lines</div>
                    <div class="pfm-stat-v">@purchaseOrder.Lines.Count</div>
                </div>
                <div class="pfm-stat">
                    <div class="pfm-stat-k">Subtotal</div>
                    <div class="pfm-stat-v">@CalculateSubTotal().ToString("N2")</div>
                </div>
                <div class="pfm-stat">
                    <div class="pfm-stat-k">Grand total</div>
                    <div class="pfm-stat-v is-total">@CalculateGrandTotal().ToString("N2")</div>
                </div>
            </div>
        </header>

        @if (!string.IsNullOrEmpty(errorMessage))
        {
            <div class="pfm-alert is-err" role="alert">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"
                     stroke-linecap="round" aria-hidden="true">
                    <circle cx="12" cy="12" r="9"></circle>
                    <path d="M12 7.5v5.5M12 16.2v.1"></path>
                </svg>
                <div class="pfm-alert-bd">@errorMessage</div>
                <button type="button" class="pfm-alert-x" aria-label="Dismiss" @onclick="() => errorMessage = null">
                    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"
                         stroke-linecap="round" aria-hidden="true">
                        <path d="M6 6l12 12M18 6L6 18"></path>
                    </svg>
                </button>
            </div>
        }

        @if (!string.IsNullOrEmpty(successMessage))
        {
            <div class="pfm-alert is-ok" role="status">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"
                     stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M5 12.5l4.5 4.5L19 7"></path>
                </svg>
                <div class="pfm-alert-bd">@successMessage</div>
            </div>
        }

        <div class="pfm-grid">
            <div class="pfm-main">

                <section class="pfm-card">
                    <div class="pfm-card-hd">
                        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                             stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <path d="M4 21V6l7-3v18"></path>
                            <path d="M11 9h6a2 2 0 0 1 2 2v10"></path>
                            <path d="M2 21h20M7 8v.01M7 12v.01M7 16v.01"></path>
                        </svg>
                        <h2>Supplier</h2>
                    </div>
                    <div class="pfm-card-bd">
                        @if (isLoadingLookups)
                        {
                            <div class="pfm-loading">
                                <span class="pfm-spin" aria-hidden="true"></span>
                                <span>Loading suppliers, products and warehouses&#8230;</span>
                            </div>
                        }
                        else if (selectedBusinessPartner is not null)
                        {
                            <div class="pfm-party">
                                <div>
                                    <div class="pfm-party-code">
                                        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                             stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"
                                             aria-hidden="true">
                                            <path d="M5 12.5l4.5 4.5L19 7"></path>
                                        </svg>
                                        @selectedBusinessPartner.CardCode
                                    </div>
                                    <div class="pfm-party-name">@selectedBusinessPartner.CardName</div>
                                    <div class="pfm-party-meta">
                                        @if (!string.IsNullOrWhiteSpace(selectedBusinessPartner.Phone1))
                                        {
                                            <span>@selectedBusinessPartner.Phone1</span>
                                        }
                                        @if (!string.IsNullOrWhiteSpace(selectedBusinessPartner.Currency))
                                        {
                                            <span>@selectedBusinessPartner.Currency</span>
                                        }
                                    </div>
                                </div>
                                <button type="button" class="pfm-btn-x" aria-label="Clear the supplier"
                                        @onclick="ClearSelectedBP">
                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"
                                         stroke-linecap="round" aria-hidden="true">
                                        <path d="M6 6l12 12M18 6L6 18"></path>
                                    </svg>
                                </button>
                            </div>
                        }
                        else
                        {
                            @* Not a <label>: it wraps a popup whose clicks a label would
                               swallow by refocusing the input behind it. *@
                            <div class="pfm-lab">
                                <span class="pfm-lab-t" id="cpo-supplier-label">
                                    Supplier <span class="pfm-req">*</span>
                                </span>
                                <span class="pfm-combo">
                                    <input class="pfm-input @(HasError("CardCode") ? "is-bad" : "")" type="text"
                                           aria-labelledby="cpo-supplier-label" autocomplete="off"
                                           placeholder="Search a supplier code or name&#8230;"
                                           value="@supplierTerm" @oninput="OnSupplierTermInput"
                                           @onfocus="() => showSupplierDrop = true"
                                           @onblur="() => showSupplierDrop = false" />
                                    @if (showSupplierDrop && FilteredSuppliers.Any())
                                    {
                                        @* preventDefault on mousedown keeps the focus — and so the
                                           blur that would close this popup — from firing before the
                                           click lands. *@
                                        <span class="pfm-drop is-wide" @onmousedown:preventDefault>
                                            @foreach (var supplier in FilteredSuppliers)
                                            {
                                                <button type="button" class="pfm-drop-i"
                                                        @onmousedown="() => ChooseSupplier(supplier)">
                                                    <span>
                                                        <span class="pfm-drop-code">@supplier.CardCode</span>
                                                        <span class="pfm-drop-sub">@supplier.CardName</span>
                                                    </span>
                                                    @if (!string.IsNullOrWhiteSpace(supplier.Currency)
                                                        && !string.Equals(supplier.Currency, "##", StringComparison.OrdinalIgnoreCase))
                                                    {
                                                        <span class="pfm-drop-price">@supplier.Currency</span>
                                                    }
                                                </button>
                                            }
                                        </span>
                                    }
                                    else if (showSupplierDrop && !string.IsNullOrWhiteSpace(supplierTerm))
                                    {
                                        <span class="pfm-drop">
                                            <span class="pfm-drop-empty">No supplier matches that.</span>
                                        </span>
                                    }
                                </span>
                                @if (HasError("CardCode"))
                                {
                                    <span class="pfm-field-err">@GetError("CardCode")</span>
                                }
                            </div>
                        }
                    </div>
                </section>

                <section class="pfm-card">
                    <div class="pfm-card-hd">
                        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                             stroke-width="1.7" stroke-linecap="round" aria-hidden="true">
                            <circle cx="12" cy="12" r="9"></circle>
                            <path d="M12 11v5M12 7.8v.1"></path>
                        </svg>
                        <h2>Order details</h2>
                    </div>
                    <div class="pfm-card-bd">
                        <div class="pfm-fields">
                            <label class="pfm-lab">
                                <span class="pfm-lab-t">Supplier reference</span>
                                <input class="pfm-input" type="text" placeholder="Quote or reference number"
                                       @bind="purchaseOrder.SupplierRefNo" />
                            </label>
                            <div class="pfm-lab">
                                <span class="pfm-lab-t">Delivery date</span>
                                <NocturneDateField Id="cpo-delivery-date" @bind-Date="deliveryDate"
                                                   AriaLabel="Delivery date" />
                            </div>
                            <label class="pfm-lab">
                                <span class="pfm-lab-t">Currency</span>
                                <select class="pfm-select" @bind="purchaseOrder.Currency">
                                    <option value="USD">USD</option>
                                    <option value="ZIG">ZIG</option>
                                </select>
                            </label>
                            <label class="pfm-lab">
                                <span class="pfm-lab-t">Receiving warehouse</span>
                                @* Sets the default every new line is created with, which is why it
                                   is the header's field and not just the first line's. *@
                                <select class="pfm-select" value="@purchaseOrder.WarehouseCode"
                                        @onchange="e => ChooseHeaderWarehouse(e.Value?.ToString())">
                                    <option value="">Choose a warehouse</option>
                                    @foreach (var warehouse in cachedWarehouses)
                                    {
                                        <option value="@warehouse.WarehouseCode">@warehouse.DisplayName</option>
                                    }
                                </select>
                            </label>
                            <label class="pfm-lab">
                                <span class="pfm-lab-t">Header discount %</span>
                                <input class="pfm-input" type="number" min="0" max="100" step="0.5"
                                       @bind="purchaseOrder.DiscountPercent" />
                            </label>
                            <label class="pfm-lab pfm-span3">
                                <span class="pfm-lab-t">Comments</span>
                                <textarea class="pfm-area" rows="2" placeholder="Optional notes for this order"
                                          @bind="purchaseOrder.Comments"></textarea>
                            </label>
                        </div>
                        <p class="pfm-note" style="margin:14px 0 0">
                            The header discount is applied to the subtotal before tax is added.
                        </p>
                    </div>
                </section>

                <section class="pfm-card">
                    <div class="pfm-card-hd">
                        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                             stroke-width="1.7" stroke-linecap="round" aria-hidden="true">
                            <path d="M8 6h12M8 12h12M8 18h12M4 6v.01M4 12v.01M4 18v.01"></path>
                        </svg>
                        <h2>Order lines</h2>
                        <span class="pfm-count">@purchaseOrder.Lines.Count</span>
                        <span class="pfm-spacer"></span>
                        <button type="button" class="pfm-btn pfm-btn-accent" @onclick="AddLine">
                            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                 stroke-width="2" stroke-linecap="round" aria-hidden="true">
                                <path d="M12 5v14M5 12h14"></path>
                            </svg>
                            <span>Add line</span>
                        </button>
                    </div>

                    @if (validationErrors.ContainsKey("Lines"))
                    {
                        <div class="pfm-card-bd" style="padding-bottom:0">
                            <div class="pfm-err-panel">
                                <div class="pfm-err-panel-t">@validationErrors["Lines"]</div>
                            </div>
                        </div>
                    }

                    @if (purchaseOrder.Lines.Count == 0)
                    {
                        <div class="pfm-card-bd">
                            <button type="button" class="pfm-addline" @onclick="AddLine">
                                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                     stroke-width="2" stroke-linecap="round" aria-hidden="true">
                                    <path d="M12 5v14M5 12h14"></path>
                                </svg>
                                <span>Add the first line</span>
                            </button>
                        </div>
                    }
                    else
                    {
                        <div class="pfm-lines">
                            <div class="pfm-lines-inner">
                                <div class="pfm-row is-head">
                                    <span>#</span>
                                    <span>Item</span>
                                    <span>Description</span>
                                    <span class="pfm-r">Qty</span>
                                    <span class="pfm-r">Unit price</span>
                                    <span>Warehouse</span>
                                    <span class="pfm-r">Tax %</span>
                                    <span class="pfm-r">Disc %</span>
                                    <span class="pfm-r">Total</span>
                                    <span></span>
                                </div>

                                @for (var i = 0; i < purchaseOrder.Lines.Count; i++)
                                {
                                    var idx = i;
                                    var line = purchaseOrder.Lines[idx];

                                    <div class="pfm-row">
                                        <span class="pfm-n">@(idx + 1)</span>

                                        <input class="pfm-input pfm-cell @(HasError($"Line{idx}_ItemCode") ? "is-bad" : "")"
                                               list="purchase-order-products" placeholder="Item code"
                                               @bind="line.ItemCode" @onblur="() => SyncLineProduct(idx)" />

                                        <input class="pfm-input pfm-desc" placeholder="Description"
                                               @bind="line.ItemDescription" />

                                        <input class="pfm-input pfm-num @(HasError($"Line{idx}_Quantity") ? "is-bad" : "")"
                                               type="number" min="0.0001" step="any" @bind="line.Quantity" />

                                        <input class="pfm-input pfm-num" type="number" min="0" step="any"
                                               @bind="line.UnitPrice" />

                                        <select class="pfm-select pfm-cell" value="@line.WarehouseCode"
                                                @onchange="e => ChooseLineWarehouse(idx, e.Value?.ToString())">
                                            <option value="">Warehouse</option>
                                            @foreach (var warehouse in cachedWarehouses)
                                            {
                                                <option value="@warehouse.WarehouseCode">@warehouse.DisplayName</option>
                                            }
                                        </select>

                                        <input class="pfm-input pfm-num" type="number" min="0" max="100" step="0.5"
                                               @bind="line.TaxPercent" />

                                        <input class="pfm-input pfm-num" type="number" min="0" max="100" step="0.5"
                                               @bind="line.DiscountPercent" />

                                        <span class="pfm-amt-v pfm-r">@CalculateLineTotal(line).ToString("N2")</span>

                                        <button type="button" class="pfm-btn-x" aria-label="Remove this line"
                                                disabled="@(purchaseOrder.Lines.Count == 1)"
                                                @onclick="() => RemoveLine(idx)">
                                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"
                                                 stroke-linecap="round" aria-hidden="true">
                                                <path d="M6 6l12 12M18 6L6 18"></path>
                                            </svg>
                                        </button>

                                        @if (HasError($"Line{idx}_ItemCode") || HasError($"Line{idx}_Quantity"))
                                        {
                                            <span class="pfm-row-err">
                                                @(HasError($"Line{idx}_ItemCode")
                                                    ? GetError($"Line{idx}_ItemCode")
                                                    : GetError($"Line{idx}_Quantity"))
                                            </span>
                                        }
                                    </div>
                                }

                                <button type="button" class="pfm-addline" @onclick="AddLine">
                                    <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                         stroke-width="2" stroke-linecap="round" aria-hidden="true">
                                        <path d="M12 5v14M5 12h14"></path>
                                    </svg>
                                    <span>Add another line</span>
                                </button>
                            </div>
                        </div>
                    }
                </section>
            </div>

            <aside class="pfm-aside">
                <section class="pfm-card pfm-total-card">
                    <div class="pfm-total-hd">
                        <span class="pfm-total-k">Grand total</span>
                        <span class="pfm-total-cur">@purchaseOrder.Currency</span>
                    </div>
                    <div class="pfm-total-v">@CalculateGrandTotal().ToString("N2")</div>

                    <div class="pfm-gap-md">
                        <div class="pfm-sum">
                            <span>Subtotal</span>
                            <span class="pfm-sum-v">@CalculateSubTotal().ToString("N2")</span>
                        </div>
                        <div class="pfm-sum">
                            <span>Discount</span>
                            <span class="pfm-sum-v">@CalculateDiscount().ToString("N2")</span>
                        </div>
                        <div class="pfm-sum">
                            <span>Tax</span>
                            <span class="pfm-sum-v">@CalculateTax().ToString("N2")</span>
                        </div>
                        <div class="pfm-sum-rule" aria-hidden="true"></div>
                        <div class="pfm-sum">
                            <span>Lines</span>
                            <span class="pfm-sum-v">@purchaseOrder.Lines.Count</span>
                        </div>
                    </div>

                    <div class="pfm-gap-md">
                        @* Submitting for approval is the committing action of the two, so it
                           is the filled one; saving a draft leaves the order changeable. *@
                        <button type="button" class="pfm-btn-solid" @onclick="SaveAndSubmit" disabled="@isSubmitting">
                            @if (isSubmitting && submitForApproval)
                            {
                                <span class="pfm-spin on-solid" aria-hidden="true"></span>
                                <span>Submitting&#8230;</span>
                            }
                            else
                            {
                                <span>Save &amp; submit for approval</span>
                            }
                        </button>
                        <button type="button" class="pfm-btn pfm-btn-wide" style="margin-top:8px"
                                @onclick="SaveAsDraft" disabled="@isSubmitting">
                            @if (isSubmitting && !submitForApproval)
                            {
                                <span class="pfm-spin" aria-hidden="true"></span>
                                <span>Saving&#8230;</span>
                            }
                            else
                            {
                                <span>Save as draft</span>
                            }
                        </button>
                        <button type="button" class="pfm-btn pfm-btn-wide" style="margin-top:8px"
                                @onclick="GoBack" disabled="@isSubmitting">
                            Cancel
                        </button>
                    </div>
                </section>

                <section class="pfm-card pfm-panel">
                    <div class="pfm-panel-hd">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                             stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <path d="M5 12.5l4.5 4.5L19 7"></path>
                        </svg>
                        <span>Before submitting</span>
                    </div>
                    <div class="pfm-checks">
                        <div class="pfm-checks-i @(selectedBusinessPartner is null ? "is-no" : "")">
                            <span class="pfm-checks-ic">
                                <svg width="9" height="9" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                     stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                    <path d="M5 12.5l4.5 4.5L19 7"></path>
                                </svg>
                            </span>
                            <span>A supplier is chosen</span>
                        </div>
                        <div class="pfm-checks-i @(purchaseOrder.Lines.Any(l => !string.IsNullOrWhiteSpace(l.ItemCode)) ? "" : "is-no")">
                            <span class="pfm-checks-ic">
                                <svg width="9" height="9" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                     stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                    <path d="M5 12.5l4.5 4.5L19 7"></path>
                                </svg>
                            </span>
                            <span>At least one line has an item</span>
                        </div>
                        <div class="pfm-checks-i @(string.IsNullOrWhiteSpace(purchaseOrder.WarehouseCode) ? "is-no" : "")">
                            <span class="pfm-checks-ic">
                                <svg width="9" height="9" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                     stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                    <path d="M5 12.5l4.5 4.5L19 7"></path>
                                </svg>
                            </span>
                            <span>A receiving warehouse is set</span>
                        </div>
                    </div>
                </section>
            </aside>
        </div>
    </div>
</div>

@code {
    private CreatePurchaseOrderRequest purchaseOrder = new()
    {
        Currency = "USD",
        Lines = new List<CreatePurchaseOrderLineRequest>
{
new CreatePurchaseOrderLineRequest()
}
    };

    private DateTime? deliveryDate;
    private bool isSubmitting = false;
    private string? successMessage;
    private string? errorMessage;
    private Dictionary<string, string> validationErrors = new();
    private bool submitForApproval = false;

    // Business Partner fields
    private List<BusinessPartnerDto> allBusinessPartners = new();
    private List<ProductDto> cachedProducts = new();
    private List<WarehouseDto> cachedWarehouses = new();
    private BusinessPartnerDto? selectedBusinessPartner;
    private bool isLoadingLookups = true;
    private bool _hasInitialized = false;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && !_hasInitialized)
        {
            _hasInitialized = true;
            await LoadLookupsAsync();
            StateHasChanged();
        }
    }

    private async Task LoadLookupsAsync()
    {
        isLoadingLookups = true;
        StateHasChanged();

        try
        {
            var businessPartnerTask = CacheService.GetBusinessPartnersAsync();
            var productTask = CacheService.GetProductsAsync();
            var warehouseTask = CacheService.GetWarehousesAsync();

            await Task.WhenAll(businessPartnerTask, productTask, warehouseTask);

            allBusinessPartners = await businessPartnerTask;
            cachedProducts = await productTask;
            cachedWarehouses = await warehouseTask;

            Logger.LogInformation(
                "Loaded PO creation lookups: {BPCount} suppliers, {ProductCount} products, {WarehouseCount} warehouses",
                allBusinessPartners.Count,
                cachedProducts.Count,
                cachedWarehouses.Count);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error loading purchase order lookups");
            errorMessage = "Failed to load suppliers, products, or warehouses. Refresh and try again.";
        }
        finally
        {
            isLoadingLookups = false;
        }
    }

    // The supplier combo. Native rather than MudAutocomplete, so the filtering
    // that used to be a SearchFunc is a property — the list is already in memory
    // and this is the same predicate the Mud version ran.
    private string supplierTerm = string.Empty;
    private bool showSupplierDrop;

    private IEnumerable<BusinessPartnerDto> FilteredSuppliers => allBusinessPartners
        .Where(bp => !string.IsNullOrWhiteSpace(bp.CardCode))
        .Where(bp => string.IsNullOrWhiteSpace(supplierTerm)
            || (bp.CardCode?.Contains(supplierTerm, StringComparison.OrdinalIgnoreCase) ?? false)
            || (bp.CardName?.Contains(supplierTerm, StringComparison.OrdinalIgnoreCase) ?? false))
        .Take(20);

    private void OnSupplierTermInput(ChangeEventArgs e)
    {
        supplierTerm = e.Value?.ToString() ?? string.Empty;
        showSupplierDrop = true;
    }

    private void ChooseSupplier(BusinessPartnerDto supplier)
    {
        OnSelectedBusinessPartnerChanged(supplier);
        supplierTerm = string.Empty;
        showSupplierDrop = false;
    }

    // The two warehouse pickers are selects, so what arrives is a code rather
    // than the object the old handlers took.
    private void ChooseHeaderWarehouse(string? warehouseCode) =>
        OnHeaderWarehouseChanged(cachedWarehouses.FirstOrDefault(w =>
            string.Equals(w.WarehouseCode, warehouseCode, StringComparison.OrdinalIgnoreCase)));

    private void ChooseLineWarehouse(int index, string? warehouseCode) =>
        OnLineWarehouseChanged(index, cachedWarehouses.FirstOrDefault(w =>
            string.Equals(w.WarehouseCode, warehouseCode, StringComparison.OrdinalIgnoreCase)));

    // The item cell is a datalist input, so the product is resolved from what
    // was typed once the cell is left — the description and price then come from
    // the same handler the picker used.
    private void SyncLineProduct(int index)
    {
        if (index < 0 || index >= purchaseOrder.Lines.Count)
            return;

        var itemCode = purchaseOrder.Lines[index].ItemCode;
        if (string.IsNullOrWhiteSpace(itemCode))
            return;

        var product = cachedProducts.FirstOrDefault(p =>
            string.Equals(p.ItemCode, itemCode, StringComparison.OrdinalIgnoreCase));

        if (product is not null)
        {
            OnLineProductChanged(index, product);
        }
    }

    private void OnSelectedBusinessPartnerChanged(BusinessPartnerDto? bp)
    {
        if (bp is null)
        {
            ClearSelectedBP();
            return;
        }

        selectedBusinessPartner = bp;
        purchaseOrder.CardCode = bp.CardCode ?? string.Empty;
        purchaseOrder.CardName = bp.CardName;

        if (!string.IsNullOrWhiteSpace(bp.Currency) && !string.Equals(bp.Currency, "##", StringComparison.OrdinalIgnoreCase))
        {
            purchaseOrder.Currency = bp.Currency.Trim().ToUpperInvariant();
        }

        validationErrors.Remove("CardCode");
    }

    private void ClearSelectedBP()
    {
        selectedBusinessPartner = null;
        purchaseOrder.CardCode = string.Empty;
        purchaseOrder.CardName = null;
        validationErrors.Remove("CardCode");
    }

    private bool HasError(string key) => validationErrors.ContainsKey(key);
    private string? GetError(string key) => validationErrors.GetValueOrDefault(key);

    private void AddLine()
    {
        purchaseOrder.Lines.Add(new CreatePurchaseOrderLineRequest
        {
            WarehouseCode = purchaseOrder.WarehouseCode
        });
    }

    private void RemoveLine(int index)
    {
        if (purchaseOrder.Lines.Count > 1)
        {
            purchaseOrder.Lines.RemoveAt(index);
        }
    }

    private decimal CalculateLineTotal(CreatePurchaseOrderLineRequest line)
    {
        return line.Quantity * line.UnitPrice * (1 - line.DiscountPercent / 100);
    }

    private decimal CalculateSubTotal()
    {
        return purchaseOrder.Lines.Sum(l => CalculateLineTotal(l));
    }

    private decimal CalculateDiscount()
    {
        return CalculateSubTotal() * purchaseOrder.DiscountPercent / 100;
    }

    private decimal CalculateTax()
    {
        return purchaseOrder.Lines.Sum(l =>
        {
            var lineTotal = CalculateLineTotal(l);
            return lineTotal * l.TaxPercent / 100;
        });
    }

    private decimal CalculateGrandTotal()
    {
        return CalculateSubTotal() - CalculateDiscount() + CalculateTax();
    }



    private void OnHeaderWarehouseChanged(WarehouseDto? warehouse)
    {
        var previousWarehouseCode = purchaseOrder.WarehouseCode;
        purchaseOrder.WarehouseCode = warehouse?.WarehouseCode;

        foreach (var line in purchaseOrder.Lines)
        {
            if (string.IsNullOrWhiteSpace(line.WarehouseCode) ||
                string.Equals(line.WarehouseCode, previousWarehouseCode, StringComparison.OrdinalIgnoreCase))
            {
                line.WarehouseCode = purchaseOrder.WarehouseCode;
            }
        }
    }

    private void OnLineWarehouseChanged(int index, WarehouseDto? warehouse)
    {
        if (index < 0 || index >= purchaseOrder.Lines.Count)
            return;

        purchaseOrder.Lines[index].WarehouseCode = warehouse?.WarehouseCode;
    }

    private void OnLineProductChanged(int index, ProductDto? product)
    {
        if (index < 0 || index >= purchaseOrder.Lines.Count)
            return;

        var line = purchaseOrder.Lines[index];

        if (product is null)
        {
            line.ItemCode = string.Empty;
            line.ItemDescription = null;
            line.UoMCode = null;
            return;
        }

        line.ItemCode = product.ItemCode ?? string.Empty;
        line.ItemDescription = product.ItemName;

        if (line.UnitPrice <= 0 && product.Price > 0)
        {
            line.UnitPrice = product.Price;
        }

        if (string.IsNullOrWhiteSpace(line.WarehouseCode))
        {
            line.WarehouseCode = purchaseOrder.WarehouseCode ?? product.DefaultWarehouse;
        }

        if (string.IsNullOrWhiteSpace(line.UoMCode))
        {
            line.UoMCode = product.UoM;
        }

        validationErrors.Remove($"Line{index}_ItemCode");
    }

    private bool ValidateForm()
    {
        validationErrors.Clear();

        if (string.IsNullOrWhiteSpace(purchaseOrder.CardCode))
            validationErrors["CardCode"] = "Supplier code is required";

        if (purchaseOrder.Lines.Count == 0)
            validationErrors["Lines"] = "At least one line item is required";

        for (int i = 0; i < purchaseOrder.Lines.Count; i++)
        {
            var line = purchaseOrder.Lines[i];
            if (string.IsNullOrWhiteSpace(line.ItemCode))
                validationErrors[$"Line{i}_ItemCode"] = "Required";
            if (line.Quantity <= 0)
                validationErrors[$"Line{i}_Quantity"] = "Must be > 0";
        }

        return validationErrors.Count == 0;
    }

    private async Task SaveAsDraft()
    {
        submitForApproval = false;
        await SubmitOrder();
    }

    private async Task SaveAndSubmit()
    {
        submitForApproval = true;
        await SubmitOrder();
    }

    private async Task SubmitOrder()
    {
        if (!ValidateForm()) return;

        isSubmitting = true;
        errorMessage = null;
        successMessage = null;

        try
        {
            purchaseOrder.DeliveryDate = deliveryDate;

            Logger.LogInformation("Submitting PO for supplier {CardCode} with {Lines} lines",
            purchaseOrder.CardCode, purchaseOrder.Lines.Count);

            var result = await PurchaseOrderService.CreatePurchaseOrderAsync(purchaseOrder);
            if (result != null)
            {
                if (submitForApproval)
                {
                    try
                    {
                        await PurchaseOrderService.UpdateStatusAsync(result.Id, PurchaseOrderStatus.Pending, "Submitted for approval");
                    }
                    catch (Exception ex)
                    {
                        Logger.LogWarning(ex, "PO created but failed to submit for approval. It remains as Draft.");
                    }
                }

                successMessage = $"Purchase order {result.OrderNumber} created successfully!";
                Logger.LogInformation("Created purchase order {OrderNumber}", result.OrderNumber);
                await AuditService.LogAsync(AuditActions.CreatePurchaseOrder, "PurchaseOrder", result.OrderNumber);

                // Reset form
                purchaseOrder = new CreatePurchaseOrderRequest
                {
                    Currency = "USD",
                    Lines = new List<CreatePurchaseOrderLineRequest> { new() }
                };
                deliveryDate = null;
                validationErrors.Clear();
                selectedBusinessPartner = null;

                // Navigate to list after brief delay
                await Task.Delay(1500);
                NavigationManager.NavigateTo("/purchase-orders");
            }
            else
            {
                errorMessage = "Failed to create purchase order. The API returned no result — check server logs for details.";
                await AuditService.LogAsync(AuditActions.CreatePurchaseOrder, "PurchaseOrder", null, null, false, errorMessage);
            }
        }
        catch (HttpRequestException ex)
        {
            Logger.LogError(ex, "HTTP error creating purchase order");
            errorMessage = ShopInventory.Web.Services.ApiErrorResponse.GetFriendlyMessage(
                ex,
                "We couldn't create this purchase order right now. Please try again.");
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error creating purchase order");
            errorMessage = ShopInventory.Web.Services.ApiErrorResponse.GetFriendlyMessage(
                ex,
                "We couldn't create this purchase order right now. Please try again.");
        }
        finally
        {
            isSubmitting = false;
        }
    }

    private void GoBack()
    {
        NavigationManager.NavigateTo("/purchase-orders");
    }
}