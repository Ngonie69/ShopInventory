@page "/payments"
@using Microsoft.AspNetCore.Authorization
@using ShopInventory.Web.Services
@attribute [Authorize(Roles = "Admin,Cashier")]
@inject IPaymentService PaymentService
@inject ILogger<Payments> Logger
@inject IAppSettingsProvider AppSettings
@inject IAuditService AuditService
@rendermode InteractiveServer

<PageTitle>Incoming Payments - Shop Inventory</PageTitle>

@* Nocturne, carried by wwwroot/css/payments.css (linked from App.razor) in both
   schemes, following the app's theme toggle like every other page. The palette
   and density scale are credit-notes.css's, unchanged, so this page and the
   invoices it settles read as one system.

   Icon-only buttons draw their glyph inline rather than from the Phosphor font:
   the glyph is their whole label, so a font that fails to load would leave them
   reading as dead controls. *@

<div class="pyx">

    <header class="pyx-head">
        <div class="pyx-shell">
            <div class="pyx-titles">
                <div class="pyx-titles-row">
                    <i class="ph ph-hand-coins" aria-hidden="true"></i>
                    <h1 class="pyx-title">Incoming Payments</h1>
                </div>
                <p class="pyx-sub">Review incoming receipts and the invoices they settle</p>
            </div>
            <div class="pyx-head-actions">
                <span class="pyx-count">@LoadedCount.ToString("N0") payments</span>
                <a class="pyx-btn pyx-btn-primary" href="/payments/create">
                    <i class="ph ph-plus" aria-hidden="true"></i>New payment
                </a>
            </div>
        </div>
        <div class="pyx-rule"></div>
    </header>

    <div class="pyx-body">

        @if (!string.IsNullOrEmpty(errorMessage))
        {
            <div class="pyx-alert @(isTimeoutError ? "is-warn" : null)" role="alert">
                <i class="ph @(isTimeoutError ? "ph-clock-countdown" : "ph-warning-octagon")" aria-hidden="true"></i>
                <div class="pyx-alert-body">
                    <span>@errorMessage</span>
                    @if (isTimeoutError)
                    {
                        <button type="button" class="pyx-btn pyx-btn-secondary pyx-btn-sm" @onclick="RetryLoad"
                                disabled="@isLoading">
                            @if (isLoading)
                            {
                                <span class="pyx-spin" aria-hidden="true"></span>
                            }
                            <span>Retry</span>
                        </button>
                    }
                </div>
                <button type="button" class="pyx-btn pyx-btn-ghost pyx-btn-icon-sm" title="Dismiss"
                        aria-label="Dismiss error" @onclick="() => errorMessage = null">
                    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"></path></svg>
                </button>
            </div>
        }

        @* Counted over what is loaded, not over the whole ledger — the labels say so. *@
        <section class="pyx-stats" aria-label="Payment totals">
            <div class="pyx-stat">
                <span class="pyx-stat-mark" aria-hidden="true"><i class="ph ph-receipt"></i></span>
                <div>
                    <div class="pyx-stat-value">@LoadedCount.ToString("N0")</div>
                    <div class="pyx-stat-label">Payments loaded</div>
                </div>
            </div>
            <div class="pyx-stat">
                <span class="pyx-stat-mark" aria-hidden="true"><i class="ph ph-coins"></i></span>
                <div>
                    <div class="pyx-stat-value">@((payments?.Sum(p => p.DocTotal) ?? 0).ToString("N0"))</div>
                    <div class="pyx-stat-label">Total amount</div>
                </div>
            </div>
            <div class="pyx-stat">
                <span class="pyx-stat-mark is-quiet" aria-hidden="true"><i class="ph ph-users-three"></i></span>
                <div>
                    <div class="pyx-stat-value">@(payments?.Select(p => p.CardCode).Distinct().Count() ?? 0)</div>
                    <div class="pyx-stat-label">Unique customers</div>
                </div>
            </div>
            <div class="pyx-stat">
                <span class="pyx-stat-mark is-quiet" aria-hidden="true"><i class="ph ph-calendar-blank"></i></span>
                <div>
                    <div class="pyx-stat-value">@(fromDate.HasValue ? fromDate.Value.ToString("dd MMM") : "All")</div>
                    <div class="pyx-stat-label">Date filter</div>
                </div>
            </div>
        </section>

        <section class="pyx-filters">
            <div class="pyx-field" style="width:140px">
                <label for="pyx-f-doc">Doc number</label>
                <input id="pyx-f-doc" class="pyx-input pyx-input-num" type="number" placeholder="e.g. 123"
                       @bind="docNum" @onkeydown="HandleFilterKeyDown" />
            </div>
            <div class="pyx-field" style="width:180px">
                <label for="pyx-f-customer">Customer code</label>
                <input id="pyx-f-customer" class="pyx-input" type="text" placeholder="e.g. C001"
                       @bind="customerCode" @onkeydown="HandleFilterKeyDown" />
            </div>
            <div class="pyx-field" style="width:150px">
                <label for="pyx-f-from">From date</label>
                <NocturneDateField Id="pyx-f-from" @bind-Date="fromDate" />
            </div>
            <div class="pyx-field" style="width:150px">
                <label for="pyx-f-to">To date</label>
                <NocturneDateField Id="pyx-f-to" @bind-Date="toDate" />
            </div>
            <div class="pyx-filter-actions">
                <button type="button" class="pyx-btn pyx-btn-ghost" @onclick="ClearFilter" disabled="@isLoading">
                    Clear
                </button>
                <button type="button" class="pyx-btn pyx-btn-secondary" @onclick="ApplyFilter" disabled="@isLoading">
                    <i class="ph ph-magnifying-glass" aria-hidden="true"></i>@(isLoading ? "Searching…" : "Search")
                </button>
            </div>
        </section>

        <section class="pyx-card">

            <div class="pyx-toolbar">
                <span class="pyx-range">@RangeLabel</span>
                <div class="pyx-quick">
                    <i class="ph ph-magnifying-glass" aria-hidden="true"></i>
                    <input class="pyx-input" type="search" placeholder="Quick filter…" aria-label="Quick filter"
                           @bind="_searchString" @bind:event="oninput" @bind:after="ResetToFirstPage" />
                </div>
            </div>

            <div class="pyx-tablewrap">
                <table class="pyx-table">
                    <thead>
                        <tr>
                            <th>Doc #</th>
                            <th>Customer</th>
                            <th>Date</th>
                            <th>Tender</th>
                            <th class="pyx-num">Total</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (isLoading)
                        {
                            @for (var skeletonRow = 0; skeletonRow < 8; skeletonRow++)
                            {
                                <tr>
                                    @for (var skeletonCell = 0; skeletonCell < 6; skeletonCell++)
                                    {
                                        <td><div class="pyx-skel"></div></td>
                                    }
                                </tr>
                            }
                        }
                        else
                        {
                            @foreach (var payment in PageRows)
                            {
                                <tr @key="payment.DocEntry">
                                    <td>
                                        <button type="button" class="pyx-link" @onclick="() => ViewPayment(payment)">
                                            #@payment.DocNum
                                        </button>
                                    </td>
                                    <td>
                                        <span class="pyx-cust">
                                            <span class="pyx-cust-name">@payment.CardName</span>
                                            <span class="pyx-cust-code">@payment.CardCode</span>
                                        </span>
                                    </td>
                                    <td class="pyx-date">@FormatDate(payment.DocDate)</td>
                                    <td>
                                        <span class="pyx-tenders">
                                            @if (payment.CashSum > 0)
                                            {
                                                <span class="pyx-tender" title="Cash">
                                                    <i class="ph ph-money" aria-hidden="true"></i>@payment.CashSum.ToString("N0")
                                                </span>
                                            }
                                            @if (payment.TransferSum > 0)
                                            {
                                                <span class="pyx-tender" title="Bank transfer">
                                                    <i class="ph ph-bank" aria-hidden="true"></i>@payment.TransferSum.ToString("N0")
                                                </span>
                                            }
                                            @if (payment.CheckSum > 0)
                                            {
                                                <span class="pyx-tender" title="Cheque">
                                                    <i class="ph ph-note" aria-hidden="true"></i>@payment.CheckSum.ToString("N0")
                                                </span>
                                            }
                                            @if (payment.CreditSum > 0)
                                            {
                                                <span class="pyx-tender" title="Credit card">
                                                    <i class="ph ph-credit-card" aria-hidden="true"></i>@payment.CreditSum.ToString("N0")
                                                </span>
                                            }
                                        </span>
                                    </td>
                                    <td class="pyx-num">
                                        <span class="pyx-curr">@payment.DocCurrency</span> @payment.DocTotal.ToString("N2")
                                    </td>
                                    <td>
                                        <span class="pyx-rowactions">
                                            <button type="button" class="pyx-btn pyx-btn-ghost pyx-btn-icon-sm"
                                                    title="View payment" aria-label="View payment @payment.DocNum"
                                                    @onclick="() => ViewPayment(payment)">
                                                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M2 12s3.6-6 10-6 10 6 10 6-3.6 6-10 6-10-6-10-6z"></path><circle cx="12" cy="12" r="2.6"></circle></svg>
                                            </button>
                                        </span>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>

            @if (!isLoading && FilteredCount == 0)
            {
                <div class="pyx-empty">
                    <i class="ph ph-funnel-simple" aria-hidden="true"></i>
                    <span>No payments found</span>
                    <span class="pyx-empty-sub">No incoming payments match your filters. Try adjusting the search criteria.</span>
                    <a class="pyx-btn pyx-btn-primary" href="/payments/create">
                        <i class="ph ph-plus" aria-hidden="true"></i>New payment
                    </a>
                </div>
            }

            <div class="pyx-foot">
                <span class="pyx-foot-range">@RangeLabel</span>
                <span class="pyx-pagesize">
                    <span>Rows</span>
                    <NocturneSelect Class="nsel-sm nsel-end nsel-up" Options="PageSizeSelectOptions"
                                    @bind-Value="_pageSize" OnChanged="ResetToFirstPage"
                                    AriaLabel="Rows per page" />
                </span>
                <div class="pyx-pager">
                    <button type="button" class="pyx-btn pyx-btn-secondary pyx-btn-icon" title="Previous page"
                            aria-label="Previous page" disabled="@(displayPage <= 1)"
                            @onclick="() => GoToDisplayPage(displayPage - 1)">
                        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M15 6l-6 6 6 6"></path></svg>
                    </button>
                    <span class="pyx-page-label">Page @displayPage / @DisplayPageCount</span>
                    <button type="button" class="pyx-btn pyx-btn-secondary pyx-btn-icon" title="Next page"
                            aria-label="Next page" disabled="@(displayPage >= DisplayPageCount)"
                            @onclick="() => GoToDisplayPage(displayPage + 1)">
                        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 6l6 6-6 6"></path></svg>
                    </button>
                </div>
            </div>
        </section>
    </div>
</div>

@if (selectedPayment != null)
{
    <div class="pyx-overlay">
        <div class="pyx-scrim" @onclick="CloseModal"></div>
        <aside class="pyx-drawer" aria-label="Payment detail">
            <div class="pyx-drawer-head">
                <h2 class="pyx-drawer-title">
                    <i class="ph ph-hand-coins" aria-hidden="true"></i>Payment #@selectedPayment.DocNum
                </h2>
                <button type="button" class="pyx-btn pyx-btn-ghost pyx-btn-icon" title="Close"
                        aria-label="Close details" @onclick="CloseModal">
                    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"></path></svg>
                </button>
            </div>
            <div class="pyx-drawer-body">
                <div class="pyx-grid">
                    <div>
                        <div class="pyx-dt">Customer</div>
                        <div class="pyx-dd">@selectedPayment.CardName</div>
                    </div>
                    <div>
                        <div class="pyx-dt">Customer code</div>
                        <div class="pyx-dd">@selectedPayment.CardCode</div>
                    </div>
                    <div>
                        <div class="pyx-dt">Document date</div>
                        <div class="pyx-dd">@FormatDate(selectedPayment.DocDate)</div>
                    </div>
                    <div>
                        <div class="pyx-dt">Due date</div>
                        <div class="pyx-dd">@FormatDate(selectedPayment.DocDueDate)</div>
                    </div>
                    <div>
                        <div class="pyx-dt">Doc entry</div>
                        <div class="pyx-dd">@selectedPayment.DocEntry</div>
                    </div>
                    <div>
                        <div class="pyx-dt">Currency</div>
                        <div class="pyx-dd">@selectedPayment.DocCurrency</div>
                    </div>
                </div>

                <div>
                    <div class="pyx-sect"><i class="ph ph-chart-pie-slice" aria-hidden="true"></i>Tender breakdown</div>
                    <div class="pyx-split">
                        <div class="pyx-split-cell @(selectedPayment.CashSum > 0 ? null : "is-zero")">
                            <div class="pyx-split-label"><i class="ph ph-money" aria-hidden="true"></i>Cash</div>
                            <div class="pyx-split-value">@selectedPayment.CashSum.ToString("N2")</div>
                        </div>
                        <div class="pyx-split-cell @(selectedPayment.TransferSum > 0 ? null : "is-zero")">
                            <div class="pyx-split-label"><i class="ph ph-bank" aria-hidden="true"></i>Transfer</div>
                            <div class="pyx-split-value">@selectedPayment.TransferSum.ToString("N2")</div>
                        </div>
                        <div class="pyx-split-cell @(selectedPayment.CheckSum > 0 ? null : "is-zero")">
                            <div class="pyx-split-label"><i class="ph ph-note" aria-hidden="true"></i>Cheque</div>
                            <div class="pyx-split-value">@selectedPayment.CheckSum.ToString("N2")</div>
                        </div>
                        <div class="pyx-split-cell @(selectedPayment.CreditSum > 0 ? null : "is-zero")">
                            <div class="pyx-split-label"><i class="ph ph-credit-card" aria-hidden="true"></i>Credit</div>
                            <div class="pyx-split-value">@selectedPayment.CreditSum.ToString("N2")</div>
                        </div>
                    </div>
                </div>

                @if (!string.IsNullOrEmpty(selectedPayment.TransferReference))
                {
                    <div>
                        <div class="pyx-sect"><i class="ph ph-bank" aria-hidden="true"></i>Transfer details</div>
                        <div class="pyx-grid">
                            <div>
                                <div class="pyx-dt">Reference</div>
                                <div class="pyx-dd">@selectedPayment.TransferReference</div>
                            </div>
                            <div>
                                <div class="pyx-dt">Account</div>
                                <div class="pyx-dd">@(selectedPayment.TransferAccount ?? "—")</div>
                            </div>
                            <div>
                                <div class="pyx-dt">Transfer date</div>
                                <div class="pyx-dd">@FormatDate(selectedPayment.TransferDate)</div>
                            </div>
                        </div>
                    </div>
                }

                @if (selectedPayment.PaymentInvoices?.Any() == true)
                {
                    <div>
                        <div class="pyx-sect"><i class="ph ph-receipt" aria-hidden="true"></i>Applied invoices</div>
                        <div class="pyx-linescroll">
                            <table class="pyx-lines">
                                <thead>
                                    <tr>
                                        <th>#</th>
                                        <th>Doc entry</th>
                                        <th>Type</th>
                                        <th class="pyx-num">Applied</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var invoice in selectedPayment.PaymentInvoices)
                                    {
                                        <tr>
                                            <td>@invoice.LineNum</td>
                                            <td><span class="pyx-cust-name">@invoice.DocEntry</span></td>
                                            <td>@invoice.InvoiceType</td>
                                            <td class="pyx-num">@FormatAppliedAmount(invoice)</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                }

                @if (!string.IsNullOrEmpty(selectedPayment.Remarks))
                {
                    <div>
                        <div class="pyx-sect"><i class="ph ph-chat-text" aria-hidden="true"></i>Remarks</div>
                        <div class="pyx-note is-prose">@selectedPayment.Remarks</div>
                    </div>
                }

                <div class="pyx-total">
                    <span class="pyx-total-label">Total payment</span>
                    <span class="pyx-total-value">@selectedPayment.DocCurrency @selectedPayment.DocTotal.ToString("N2")</span>
                </div>
            </div>
            <div class="pyx-drawer-foot">
                <button type="button" class="pyx-btn pyx-btn-secondary" @onclick="CloseModal">Close</button>
            </div>
        </aside>
    </div>
}

@code {
    private static readonly int[] PageSizeOptions = [10, 25, 50, 100, 200];

    private static readonly NocturneSelectOption<int>[] PageSizeSelectOptions =
        PageSizeOptions.Select(s => new NocturneSelectOption<int>(s, s.ToString())).ToArray();

    private List<IncomingPaymentDto>? payments;
    private int _pageSize = 10;
    private IncomingPaymentDto? selectedPayment;
    private bool isLoading = true;
    private string? errorMessage;
    private bool isTimeoutError;

    // The fetch pulls one server page; the pager below works over it in the browser.
    // NOTE: PreviousPage/NextPage below walk the server's pages and are not wired to
    // any control, so only the first fetched page is reachable — as before this page
    // was rebuilt. Wiring them is a behaviour change, not a design one.
    private int currentPage = 1;
    private int pageSize = 20;
    private bool hasMore = false;

    private int displayPage = 1;
    private string _searchString = string.Empty;

    private int? docNum;
    private string? customerCode;
    private DateTime? fromDate;
    private DateTime? toDate;

    private int LoadedCount => payments?.Count ?? 0;

    /// <summary>
    /// The quick filter narrows what is already loaded — it never refetches, which is why it
    /// lives on the table's own toolbar rather than in the filter row.
    /// </summary>
    private IEnumerable<IncomingPaymentDto> FilteredPayments
    {
        get
        {
            if (payments is null)
                return [];

            if (string.IsNullOrWhiteSpace(_searchString))
                return payments;

            var search = _searchString.Trim();
            return payments.Where(payment =>
                payment.DocNum.ToString().Contains(search, StringComparison.OrdinalIgnoreCase)
                || payment.CardCode?.Contains(search, StringComparison.OrdinalIgnoreCase) == true
                || payment.CardName?.Contains(search, StringComparison.OrdinalIgnoreCase) == true
                || payment.DocTotal.ToString("N2").Contains(search));
        }
    }

    private int FilteredCount => FilteredPayments.Count();

    private int DisplayPageCount => Math.Max(1, (FilteredCount + _pageSize - 1) / _pageSize);

    private IEnumerable<IncomingPaymentDto> PageRows
        => FilteredPayments.Skip((displayPage - 1) * _pageSize).Take(_pageSize);

    private string RangeLabel
    {
        get
        {
            if (isLoading && payments is null)
                return "Loading…";

            var count = FilteredCount;
            if (count == 0)
                return "No payments";

            var first = ((displayPage - 1) * _pageSize) + 1;
            var last = Math.Min(displayPage * _pageSize, count);
            return $"{first:N0}–{last:N0} of {count:N0} payments";
        }
    }

    protected override async Task OnInitializedAsync()
    {
        _pageSize = AppSettings.PageSize;
        pageSize = AppSettings.PageSize;
        Logger.LogInformation("Payments page: OnInitializedAsync started");
        await LoadPayments();
        await AuditService.LogAsync(AuditActions.ViewPayments, "Payment", null);
    }

    private void ResetToFirstPage() => displayPage = 1;

    private void GoToDisplayPage(int page)
    {
        if (page >= 1 && page <= DisplayPageCount)
        {
            displayPage = page;
        }
    }

    private async Task HandleFilterKeyDown(KeyboardEventArgs args)
    {
        if (args.Key == "Enter")
        {
            await ApplyFilter();
        }
    }

    private async Task LoadPayments()
    {
        Logger.LogInformation("Payments page: LoadPayments started, page={Page}, pageSize={PageSize}", currentPage, pageSize);
        isLoading = true;
        errorMessage = null;
        isTimeoutError = false;

        try
        {
            var response = await PaymentService.GetPaymentsAsync(currentPage, pageSize);
            if (response != null)
            {
                payments = response.Payments;
                hasMore = response.HasMore;
                Logger.LogInformation("Payments page: Loaded {Count} payments, hasMore={HasMore}", payments?.Count ?? 0, hasMore);
            }
            else
            {
                Logger.LogWarning("Payments page: GetPaymentsAsync returned null");
                errorMessage = "Failed to load payments. Check if the API is running.";
            }
        }
        catch (TimeoutException ex)
        {
            Logger.LogWarning(ex, "Payments page: Timeout loading payments");
            errorMessage = "The request timed out while loading payments. SAP may be responding slowly.";
            isTimeoutError = true;
        }
        catch (HttpRequestException ex)
        {
            Logger.LogError(ex, "Payments page: HTTP error loading payments. Status: {StatusCode}", ex.StatusCode);
            errorMessage = ShopInventory.Web.Services.ApiErrorResponse.GetFriendlyMessage(
                ex,
                "We couldn't load payments right now. Please try again.");
            isTimeoutError = errorMessage.Contains("timed out", StringComparison.OrdinalIgnoreCase);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Payments page: Error loading payments");
            errorMessage = ShopInventory.Web.Services.ApiErrorResponse.GetFriendlyMessage(
                ex,
                "We couldn't load payments right now. Please try again.");
            isTimeoutError = errorMessage.Contains("timed out", StringComparison.OrdinalIgnoreCase);
        }
        finally
        {
            isLoading = false;
            // The set changed underneath the display pager, so start it over.
            displayPage = 1;
            Logger.LogDebug("Payments page: LoadPayments completed");
        }
    }

    private async Task ApplyFilter()
    {
        isLoading = true;
        errorMessage = null;
        isTimeoutError = false;

        try
        {
            if (docNum.HasValue)
            {
                var payment = await PaymentService.GetPaymentByDocNumAsync(docNum.Value);
                if (payment != null)
                {
                    payments = new List<IncomingPaymentDto> { payment };
                }
                else
                {
                    payments = new List<IncomingPaymentDto>();
                    errorMessage = $"No payment found with Doc # {docNum}";
                }
            }
            else if (!string.IsNullOrWhiteSpace(customerCode))
            {
                var response = await PaymentService.GetPaymentsByCustomerAsync(customerCode);
                payments = response?.Payments;
            }
            else if (fromDate.HasValue && toDate.HasValue)
            {
                var response = await PaymentService.GetPaymentsByDateRangeAsync(fromDate.Value, toDate.Value);
                payments = response?.Payments;
            }
            else if (fromDate.HasValue)
            {
                var response = await PaymentService.GetPaymentsByDateAsync(fromDate.Value);
                payments = response?.Payments;
            }
            else
            {
                await LoadPayments();
            }
        }
        catch (TimeoutException ex)
        {
            Logger.LogWarning(ex, "Payments page: Timeout during filter");
            errorMessage = "The request timed out. SAP may be responding slowly.";
            isTimeoutError = true;
        }
        catch (HttpRequestException ex)
        {
            Logger.LogError(ex, "Payments page: HTTP error filtering payments. Status: {StatusCode}", ex.StatusCode);
            errorMessage = ShopInventory.Web.Services.ApiErrorResponse.GetFriendlyMessage(
                ex,
                "We couldn't load payments right now. Please try again.");
            isTimeoutError = errorMessage.Contains("timed out", StringComparison.OrdinalIgnoreCase);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Payments page: Error filtering payments");
            errorMessage = ShopInventory.Web.Services.ApiErrorResponse.GetFriendlyMessage(
                ex,
                "We couldn't load payments right now. Please try again.");
            isTimeoutError = errorMessage.Contains("timed out", StringComparison.OrdinalIgnoreCase);
        }
        finally
        {
            isLoading = false;
            displayPage = 1;
        }
    }

    private async Task ClearFilter()
    {
        docNum = null;
        customerCode = null;
        fromDate = null;
        toDate = null;
        _searchString = string.Empty;
        currentPage = 1;
        await LoadPayments();
    }

    private void ViewPayment(IncomingPaymentDto payment)
    {
        selectedPayment = payment;
    }

    private void CloseModal()
    {
        selectedPayment = null;
    }

    private string FormatAppliedAmount(PaymentInvoiceDto invoice)
    {
        var appliedAmount = invoice.SumApplied != 0 ? invoice.SumApplied : invoice.SumAppliedFC;
        return appliedAmount.ToString("N2");
    }

    private string FormatDate(string? dateStr)
    {
        if (string.IsNullOrEmpty(dateStr))
            return "—";

        if (DateTime.TryParse(dateStr, out var date))
            return date.ToString("dd MMM yyyy");

        return dateStr;
    }

    private async Task RetryLoad()
    {
        if (docNum.HasValue
            || !string.IsNullOrWhiteSpace(customerCode)
            || fromDate.HasValue
            || toDate.HasValue)
        {
            await ApplyFilter();
            return;
        }

        await LoadPayments();
    }

    private async Task PreviousPage()
    {
        if (currentPage > 1)
        {
            currentPage--;
            await LoadPayments();
        }
    }

    private async Task NextPage()
    {
        if (hasMore)
        {
            currentPage++;
            await LoadPayments();
        }
    }
}
