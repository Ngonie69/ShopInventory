@page "/user-activity"
@using ShopInventory.Web.Services
@using Microsoft.AspNetCore.Components.Authorization
@attribute [Authorize(Roles = "Admin,Manager")]
@inject IAuditService AuditService
@inject IJSRuntime JS
@inject IAppSettingsProvider AppSettings
@rendermode InteractiveServer

<PageTitle>User Activity Dashboard - Shop Inventory</PageTitle>

@* The Nocturne sheet is wwwroot/css/user-activity.css (linked from App.razor),
   derived from audit-trail.css — the closest match in the whole admin group,
   since the two pages show the same table from the same store.

   MudDataGrid is gone and that is a functional change, not only a visual one:
   multi-column sort, per-column filtering and column hiding go with it. The
   quick search, the row click and the pagination stay, three columns are
   sortable, and below 1040px a row becomes a labelled card — which the data
   grid could not do. The grid also carried eight hard-coded hexes in inline
   `style=` attributes, none of which changed in dark mode. *@

<div class="uac">

    <header class="uac-head">
        <div class="uac-head-inner">
            <nav class="uac-crumbs" aria-label="Breadcrumb">
                <span>Administration</span>
                <span class="uac-crumb-sep" aria-hidden="true">/</span>
                <span class="uac-crumb-now" aria-current="page">User activity</span>
            </nav>
            <div class="uac-head-actions">
                <div class="uac-seg" role="group" aria-label="Time range">
                    <button type="button" class="uac-seg-btn @(timeRange == "today" ? "uac-seg-on" : "")"
                            aria-pressed="@(timeRange == "today")" @onclick='() => SetTimeRange("today")'>Today</button>
                    <button type="button" class="uac-seg-btn @(timeRange == "week" ? "uac-seg-on" : "")"
                            aria-pressed="@(timeRange == "week")" @onclick='() => SetTimeRange("week")'>Week</button>
                    <button type="button" class="uac-seg-btn @(timeRange == "month" ? "uac-seg-on" : "")"
                            aria-pressed="@(timeRange == "month")" @onclick='() => SetTimeRange("month")'>Month</button>
                </div>
            </div>
        </div>
    </header>

    <div class="uac-body">

        <section class="uac-hero">
            <div>
                <div class="uac-kicker">Who did what</div>
                <h1>User activity</h1>
                <p>
                    Every action recorded against a user account in the selected window — what was done,
                    to which record, and whether it worked. Click a row for the whole entry.
                </p>
            </div>
        </section>

        <section class="uac-stats">
            <div class="uac-stat uac-stat-lead">
                <div class="uac-stat-head"><span class="uac-stat-rule"></span>Active users</div>
                <div class="uac-stat-num">@activeUsersCount</div>
                <div class="uac-stat-sub">did something in this window</div>
            </div>
            <div class="uac-stat">
                <div class="uac-stat-head"><span class="uac-stat-rule"></span>Actions</div>
                <div class="uac-stat-num">@totalActionsCount</div>
                <div class="uac-stat-sub">recorded in total</div>
            </div>
            <div class="uac-stat">
                <div class="uac-stat-head"><span class="uac-stat-rule"></span>Logins</div>
                <div class="uac-stat-num">@loginCount</div>
                <div class="uac-stat-sub">sign-ins in this window</div>
            </div>
            <div class="uac-stat @(failedActionsCount > 0 ? "uac-stat-alert" : "")">
                <div class="uac-stat-head"><span class="uac-stat-rule"></span>Failed</div>
                <div class="uac-stat-num">@failedActionsCount</div>
                <div class="uac-stat-sub">actions that did not complete</div>
            </div>
        </section>

        <section class="uac-summaries">

            <div class="uac-card">
                <div class="uac-card-head"><h2>Most active</h2></div>
                <div class="uac-card-body">
                    @if (isLoading)
                    {
                        <div class="uac-loading">
                            <span class="uac-spin" aria-hidden="true"></span>
                        </div>
                    }
                    else if (mostActiveUsers.Any())
                    {
                        var rank = 0;
                        @foreach (var user in mostActiveUsers.Take(10))
                        {
                            rank++;
                            <div class="uac-rank-row">
                                <span class="uac-rank @(rank <= 3 ? "uac-rank-top" : "")">@rank</span>
                                <span class="uac-avatar" aria-hidden="true">@user.Username[0].ToString().ToUpper()</span>
                                <span class="uac-rank-text">
                                    <span class="uac-rank-name">@user.Username</span>
                                    @if (user.LastActivityAt.HasValue)
                                    {
                                        <span class="uac-rank-when">@GetRelativeTime(user.LastActivityAt.Value)</span>
                                    }
                                </span>
                                <span class="uac-rank-count">@user.ActionCount</span>
                            </div>
                        }
                    }
                    else
                    {
                        <div class="uac-empty">Nothing recorded in this window.</div>
                    }
                </div>
            </div>

            <div class="uac-card">
                <div class="uac-card-head"><h2>By action</h2></div>
                <div class="uac-card-body">
                    @if (isLoading)
                    {
                        <div class="uac-loading">
                            <span class="uac-spin" aria-hidden="true"></span>
                        </div>
                    }
                    else if (actionBreakdown.Any())
                    {
                        @foreach (var action in actionBreakdown.Take(10))
                        {
                            var percentage = totalActionsCount > 0 ? (action.Count * 100.0 / totalActionsCount) : 0;
                            <div class="uac-break @ActionFamily(action.Action)">
                                <div class="uac-break-row">
                                    <span class="uac-break-name">
                                        <span class="uac-break-dot" aria-hidden="true"></span>@FormatAction(action.Action)
                                    </span>
                                    <span class="uac-break-num">@action.Count &middot; @percentage.ToString("F1")%</span>
                                </div>
                                <div class="uac-break-track">
                                    <div class="uac-break-fill" style="width:@(percentage.ToString("F1"))%"></div>
                                </div>
                            </div>
                        }
                    }
                    else
                    {
                        <div class="uac-empty">Nothing recorded in this window.</div>
                    }
                </div>
            </div>

            <div class="uac-card">
                <div class="uac-card-head"><h2>By hour</h2></div>
                <div class="uac-card-body">
                    @if (isLoading)
                    {
                        <div class="uac-loading">
                            <span class="uac-spin" aria-hidden="true"></span>
                        </div>
                    }
                    else if (hourlyActivity.Any())
                    {
                        var maxCount = hourlyActivity.Max(h => h.Count);
                        <div class="uac-hours">
                            @foreach (var hour in hourlyActivity)
                            {
                                var height = maxCount > 0 ? (hour.Count * 100.0 / maxCount) : 0;
                                var level = maxCount == 0 ? "low"
                                    : hour.Count >= maxCount * .75 ? "peak"
                                    : hour.Count >= maxCount * .5 ? "high"
                                    : hour.Count >= maxCount * .25 ? "mid" : "low";
                                <div class="uac-hour">
                                    <span class="uac-hour-tip">@hour.Hour.ToString("D2"):00 &middot; @hour.Count</span>
                                    <div class="uac-hour-bar uac-hour-@level" style="height:@(height.ToString("F1"))%"></div>
                                    @if (hour.Hour % 6 == 0)
                                    {
                                        <span class="uac-hour-lbl">@hour.Hour.ToString("D2")</span>
                                    }
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="uac-empty">Nothing recorded in this window.</div>
                    }
                </div>
            </div>
        </section>

        <section class="uac-panel">
            <div class="uac-panel-head">
                <h2>Activity log</h2>
                <span class="uac-count">@totalActionsCount total</span>
                <div class="uac-panel-tools">
                    <label class="uac-search">
                        <span class="visually-hidden">Search activity</span>
                        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                             stroke-width="1.7" stroke-linecap="round" aria-hidden="true">
                            <circle cx="11" cy="11" r="6.5"></circle>
                            <path d="M16 16l4 4"></path>
                        </svg>
                        <input type="search" class="uac-input uac-input-search" placeholder="Search this page&#8230;"
                               @bind="_searchString" @bind:event="oninput" />
                    </label>
                </div>
            </div>

            <div class="uac-filters">
                <div class="uac-field">
                    <label class="uac-label" for="uacUser">User</label>
                    <div class="uac-select">
                        <select id="uacUser" class="uac-input" @bind="userFilter">
                            <option value="">All users</option>
                            @foreach (var user in uniqueUsers)
                            {
                                <option value="@user">@user</option>
                            }
                        </select>
                        <span class="uac-caret" aria-hidden="true"></span>
                    </div>
                </div>
                <div class="uac-field">
                    <label class="uac-label" for="uacAction">Action</label>
                    <div class="uac-select">
                        <select id="uacAction" class="uac-input" @bind="actionFilter">
                            <option value="">All actions</option>
                            @foreach (var action in uniqueActions)
                            {
                                <option value="@action">@action</option>
                            }
                        </select>
                        <span class="uac-caret" aria-hidden="true"></span>
                    </div>
                </div>
                <div class="uac-field">
                    <label class="uac-label" for="uacPageSize">Per page</label>
                    <div class="uac-select">
                        <select id="uacPageSize" class="uac-input" @bind="pageSize">
                            <option value="10">10</option>
                            <option value="25">25</option>
                            <option value="50">50</option>
                            <option value="100">100</option>
                            <option value="200">200</option>
                        </select>
                        <span class="uac-caret" aria-hidden="true"></span>
                    </div>
                </div>
                <div class="uac-filter-actions">
                    <button type="button" class="uac-btn uac-btn-primary" @onclick="ApplyFilters">Search</button>
                    <button type="button" class="uac-btn uac-btn-quiet" @onclick="ClearFilters">Clear</button>
                </div>
            </div>

            @if (isLoading)
            {
                <div class="uac-loading">
                    <span class="uac-spin" aria-hidden="true"></span>
                    <span>Loading activity&#8230;</span>
                </div>
            }
            else
            {
                var rows = VisibleActivities;

                if (rows.Count == 0)
                {
                    <div class="uac-empty">
                        <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                             stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <path d="M3 7h18"></path>
                            <path d="M3 12h18"></path>
                            <path d="M3 17h10"></path>
                        </svg>
                        <span>Nothing matches this window and these filters.</span>
                    </div>
                }
                else
                {
                    <div class="uac-scroll">
                        <div class="uac-grid" role="table" aria-label="Activity log">
                            <div class="uac-thead" role="row">
                                <span role="columnheader">
                                    <button type="button" class="uac-th @(sortBy == "time" ? "uac-th-on" : "")"
                                            @onclick='() => SortByColumn("time")'>
                                        Time<span class="uac-th-mark">@SortMark("time")</span>
                                    </button>
                                </span>
                                <span role="columnheader">
                                    <button type="button" class="uac-th @(sortBy == "user" ? "uac-th-on" : "")"
                                            @onclick='() => SortByColumn("user")'>
                                        User<span class="uac-th-mark">@SortMark("user")</span>
                                    </button>
                                </span>
                                <span role="columnheader">
                                    <button type="button" class="uac-th @(sortBy == "action" ? "uac-th-on" : "")"
                                            @onclick='() => SortByColumn("action")'>
                                        Action<span class="uac-th-mark">@SortMark("action")</span>
                                    </button>
                                </span>
                                <span role="columnheader">Entity</span>
                                <span role="columnheader">Details</span>
                                <span role="columnheader">Outcome</span>
                            </div>

                            @foreach (var activity in rows)
                            {
                                var log = activity;
                                <div class="uac-row @(log.IsSuccess ? "" : "uac-row-failed")" role="row"
                                     tabindex="0" @onclick="() => ShowDetail(log)">
                                    <span class="uac-when" role="cell" title="@log.Timestamp.ToString("d MMM yyyy HH:mm:ss")">
                                        <span class="uac-rl">Time</span>@GetRelativeTime(log.Timestamp)
                                    </span>
                                    <span class="uac-user" role="cell">
                                        <span class="uac-rl">User</span>
                                        <span class="uac-avatar" aria-hidden="true">@log.Username[0].ToString().ToUpper()</span>
                                        <span class="uac-user-name">@log.Username</span>
                                    </span>
                                    <span role="cell">
                                        <span class="uac-rl">Action</span>
                                        <span class="uac-badge @ActionFamily(log.Action)">@FormatAction(log.Action)</span>
                                    </span>
                                    <span class="uac-entity" role="cell">
                                        <span class="uac-rl">Entity</span>
                                        @if (!string.IsNullOrEmpty(log.EntityType))
                                        {
                                            <span>@log.EntityType</span>
                                            @if (!string.IsNullOrEmpty(log.EntityId))
                                            {
                                                <span class="uac-entity-id">@log.EntityId</span>
                                            }
                                        }
                                        else
                                        {
                                            <span class="uac-none">&#8212;</span>
                                        }
                                    </span>
                                    <span class="uac-details" role="cell" title="@log.Details">
                                        <span class="uac-rl">Details</span>
                                        @if (!string.IsNullOrEmpty(log.Details))
                                        {
                                            @log.Details
                                        }
                                        else
                                        {
                                            <span class="uac-none">&#8212;</span>
                                        }
                                    </span>
                                    <span role="cell">
                                        <span class="uac-rl">Outcome</span>
                                        <span class="uac-badge @(log.IsSuccess ? "uac-fam-good" : "uac-fam-bad")">
                                            @(log.IsSuccess ? "Success" : "Failed")
                                        </span>
                                    </span>
                                </div>
                            }
                        </div>
                    </div>

                    @if (totalPages > 1)
                    {
                        <div class="uac-foot">
                            <span class="uac-foot-info">Page @currentPage of @totalPages &middot; @totalActionsCount records</span>
                            <div class="uac-pages">
                                <button type="button" class="uac-step" disabled="@(currentPage == 1)"
                                        @onclick="() => OnPageChanged(currentPage - 1)">Previous</button>
                                @foreach (var pg in GetPageNumbers())
                                {
                                    var p = pg;
                                    <button type="button" class="uac-page @(currentPage == p ? "uac-page-on" : "")"
                                            @onclick="() => OnPageChanged(p)">@p</button>
                                }
                                <button type="button" class="uac-step" disabled="@(currentPage == totalPages)"
                                        @onclick="() => OnPageChanged(currentPage + 1)">Next</button>
                            </div>
                        </div>
                    }
                }
            }
        </section>
    </div>
</div>

@* ── Detail drawer ─────────────────────────────────────────────────────── *@
@if (selectedActivity != null)
{
    <div class="uac uac-scrim" @onclick="CloseDetail"></div>
    <aside class="uac uac-drawer" role="dialog" aria-modal="true" aria-label="Activity detail">
        <div class="uac-drawer-head">
            <div>
                <h2>@FormatAction(selectedActivity.Action)</h2>
                <div class="uac-drawer-sub">
                    @selectedActivity.Username &middot; @selectedActivity.Timestamp.ToString("d MMM yyyy HH:mm:ss")
                </div>
            </div>
            <button type="button" class="uac-icon-btn uac-drawer-x" aria-label="Close" @onclick="CloseDetail">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                     stroke-width="1.8" stroke-linecap="round" aria-hidden="true">
                    <path d="M5 5l14 14M19 5L5 19"></path>
                </svg>
            </button>
        </div>
        <div class="uac-drawer-body">
            <div class="uac-dl">
                <div>
                    <div class="uac-dt">User</div>
                    <div class="uac-dd">@selectedActivity.Username</div>
                </div>
                <div>
                    <div class="uac-dt">Outcome</div>
                    <div class="uac-dd">
                        <span class="uac-badge @(selectedActivity.IsSuccess ? "uac-fam-good" : "uac-fam-bad")">
                            @(selectedActivity.IsSuccess ? "Success" : "Failed")
                        </span>
                    </div>
                </div>
                <div>
                    <div class="uac-dt">Action</div>
                    <div class="uac-dd">
                        <span class="uac-badge @ActionFamily(selectedActivity.Action)">@FormatAction(selectedActivity.Action)</span>
                    </div>
                </div>
                <div>
                    <div class="uac-dt">Timestamp</div>
                    <div class="uac-dd uac-dd-num">@selectedActivity.Timestamp.ToString("d MMM yyyy HH:mm:ss")</div>
                </div>
                @if (!string.IsNullOrEmpty(selectedActivity.EntityType))
                {
                    <div>
                        <div class="uac-dt">Entity type</div>
                        <div class="uac-dd">@selectedActivity.EntityType</div>
                    </div>
                }
                @if (!string.IsNullOrEmpty(selectedActivity.EntityId))
                {
                    <div>
                        <div class="uac-dt">Entity id</div>
                        <div class="uac-dd uac-dd-num">@selectedActivity.EntityId</div>
                    </div>
                }
                @if (!string.IsNullOrEmpty(selectedActivity.Details))
                {
                    <div class="uac-dl-full">
                        <div class="uac-dt">Details</div>
                        <div class="uac-dd">@selectedActivity.Details</div>
                    </div>
                }
            </div>
        </div>
    </aside>
}

@code {
    private bool isLoading = true;
    private string timeRange = "today";
    private DateTime startDate;
    private DateTime endDate;
    private string _searchString = string.Empty;
    private ActivityLog? selectedActivity;

    // Stats
    private int activeUsersCount = 0;
    private int totalActionsCount = 0;
    private int loginCount = 0;
    private int failedActionsCount = 0;

    // Data
    private List<UserActivitySummary> mostActiveUsers = new();
    private List<ActionCount> actionBreakdown = new();
    private List<HourlyCount> hourlyActivity = new();
    private List<ActivityLog> recentActivities = new();

    // Filters
    private string userFilter = string.Empty;
    private string actionFilter = string.Empty;
    private List<string> uniqueUsers = new();
    private List<string> uniqueActions = new();

    // Pagination
    private int currentPage = 1;
    private int pageSize = 25;
    private int totalPages = 1;

    // Quick filter - filter globally across multiple columns with the same input
    // What the page shows: the loaded page of rows, narrowed by the quick search
    // and put in the chosen order. The search is the same four fields
    // MudDataGrid's QuickFilter covered; it runs over the loaded page only,
    // which is what it did before too.
    private List<ActivityLog> VisibleActivities
    {
        get
        {
            IEnumerable<ActivityLog> rows = recentActivities;

            if (!string.IsNullOrWhiteSpace(_searchString))
            {
                rows = rows.Where(x =>
                    x.Username?.Contains(_searchString, StringComparison.OrdinalIgnoreCase) == true
                    || x.Action?.Contains(_searchString, StringComparison.OrdinalIgnoreCase) == true
                    || x.EntityType?.Contains(_searchString, StringComparison.OrdinalIgnoreCase) == true
                    || x.Details?.Contains(_searchString, StringComparison.OrdinalIgnoreCase) == true);
            }

            rows = sortBy switch
            {
                "user" => sortDesc
                    ? rows.OrderByDescending(x => x.Username)
                    : rows.OrderBy(x => x.Username),
                "action" => sortDesc
                    ? rows.OrderByDescending(x => x.Action)
                    : rows.OrderBy(x => x.Action),
                _ => sortDesc
                    ? rows.OrderByDescending(x => x.Timestamp)
                    : rows.OrderBy(x => x.Timestamp)
            };

            return rows.ToList();
        }
    }

    // Newest first is the only useful default for a log, so time descending is
    // where it starts. Clicking the column already sorted flips it.
    private string sortBy = "time";
    private bool sortDesc = true;

    private void SortByColumn(string column)
    {
        if (sortBy == column)
        {
            sortDesc = !sortDesc;
        }
        else
        {
            sortBy = column;
            sortDesc = column == "time";
        }
    }

    private string SortMark(string column) => sortBy != column ? "" : sortDesc ? " ▼" : " ▲";

    private List<int> GetPageNumbers()
    {
        var pages = new List<int>();
        var start = Math.Max(1, currentPage - 2);
        var end = Math.Min(totalPages, currentPage + 2);
        for (var i = start; i <= end; i++)
            pages.Add(i);
        return pages;
    }

    // One family token per kind of action, from the six in nocturne-tokens.css,
    // so the badge in the log and the bar in the breakdown panel take the same
    // hue for the same action and the ink is mixed from the same value as the
    // wash. The old page had three separate mappings for this — a MudBlazor
    // Color, a CSS gradient and a dot hex — and they did not agree: a login was
    // Success green as a chip and #667eea blurple as a bar.
    private static string ActionFamily(string? action)
    {
        var a = action ?? string.Empty;

        if (a.Contains("Failed", StringComparison.OrdinalIgnoreCase)
            || a.StartsWith("Delete", StringComparison.OrdinalIgnoreCase)
            || a.Contains("Remove", StringComparison.OrdinalIgnoreCase))
            return "uac-fam-bad";

        if (a.StartsWith("Create", StringComparison.OrdinalIgnoreCase)
            || a.Contains("Add", StringComparison.OrdinalIgnoreCase))
            return "uac-fam-good";

        if (a.StartsWith("Update", StringComparison.OrdinalIgnoreCase)
            || a.Contains("Edit", StringComparison.OrdinalIgnoreCase))
            return "uac-fam-warn";

        if (a.Contains("Login", StringComparison.OrdinalIgnoreCase)
            || a.Contains("Logout", StringComparison.OrdinalIgnoreCase)
            || a.Contains("Auth", StringComparison.OrdinalIgnoreCase)
            || a == "RefreshToken")
            return "uac-fam-accent";

        if (a.Contains("Sync", StringComparison.OrdinalIgnoreCase))
            return "uac-fam-info";

        return "uac-fam-neutral";
    }

    private static string FormatAction(string? action)
    {
        if (string.IsNullOrEmpty(action)) return string.Empty;
        if (action == "RefreshToken") return "Session Renewed";

        return System.Text.RegularExpressions.Regex.Replace(action, "(?<=[a-z])(?=[A-Z])", " ");
    }

    protected override async Task OnInitializedAsync()
    {
        pageSize = AppSettings.PageSize;
        await SetTimeRange("today");
    }

    private async Task SetTimeRange(string range)
    {
        timeRange = range;
        endDate = DateTime.UtcNow;

        startDate = range switch
        {
            "today" => DateTime.UtcNow.Date,
            "week" => DateTime.UtcNow.Date.AddDays(-7),
            "month" => DateTime.UtcNow.Date.AddDays(-30),
            _ => DateTime.UtcNow.Date
        };

        currentPage = 1;
        await LoadDashboardData();
    }

    private async Task LoadDashboardData()
    {
        isLoading = true;
        StateHasChanged();
        try
        {
            var dashboard = await AuditService.GetActivityDashboardAsync(
                startDate,
                endDate,
                userFilter,
                actionFilter,
                currentPage,
                pageSize);

            activeUsersCount = dashboard.Stats.ActiveUsers;
            totalActionsCount = dashboard.Stats.TotalActions;
            loginCount = dashboard.Stats.LoginCount;
            failedActionsCount = dashboard.Stats.FailedActions;
            mostActiveUsers = dashboard.MostActiveUsers;
            actionBreakdown = dashboard.ActionBreakdown;
            hourlyActivity = dashboard.HourlyActivity;
            recentActivities = dashboard.Activities.Items;
            totalPages = dashboard.Activities.TotalPages > 0 ? dashboard.Activities.TotalPages : 1;
            uniqueUsers = dashboard.Users;
            uniqueActions = dashboard.Actions;
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading dashboard: {ex.Message}");
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    private async Task LoadStats()
    {
        try
        {
            var stats = await AuditService.GetActivityStatsAsync(startDate, endDate);
            activeUsersCount = stats.ActiveUsers;
            totalActionsCount = stats.TotalActions;
            loginCount = stats.LoginCount;
            failedActionsCount = stats.FailedActions;
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading stats: {ex.Message}");
        }
    }

