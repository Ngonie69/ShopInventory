@page "/merchandiser-account"
@using ShopInventory.Web.Data
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Forms
@attribute [Authorize(Roles = UserRoles.MerchandiserAccountManagementRoles)]
@rendermode InteractiveServer

<PageTitle>Manage Merchandiser Accounts - Shop Inventory</PageTitle>

@* Styles live in wwwroot/css/merchandiser.css (linked from App.razor), shared
   with /merchandiser-products — see that file's header. The `macc-` names are
   the ones this page already used; what changed is what they resolve to. *@

<div class="macc-page">

    <div class="macc-header">
        <div class="macc-header-text">
            <h1 class="macc-title">Merchandiser Accounts</h1>
            <p class="macc-subtitle">
                Create merchandiser logins, and set which business partners and warehouse each
                one works from.
            </p>
        </div>
    </div>

    @if (isLoading)
    {
        <div class="macc-state">
            <span class="mch-spinner mch-spinner-lg"></span>
            <span>Loading accounts, customers and warehouses&hellip;</span>
        </div>
    }
    else
    {
        <EditForm EditContext="@createEditContext" OnValidSubmit="CreateAccountAsync">
            <DataAnnotationsValidator />

            <div class="macc-grid">
                <section class="macc-card">
                    <div class="macc-card-header">
                        <h2><i class="ph ph-user-plus" aria-hidden="true"></i>Create account</h2>
                        <span class="macc-card-note">Role is fixed to Merchandiser</span>
                    </div>

                    <div class="macc-card-body">
                        <div class="macc-field-grid">
                            <div class="macc-field">
                                <label for="username"><i class="ph ph-user" aria-hidden="true"></i>Username</label>
                                <InputText id="username" class="mch-input" @bind-Value="createForm.Username" />
                                <ValidationMessage For="() => createForm.Username" />
                            </div>

                            <div class="macc-field">
                                <label for="email"><i class="ph ph-envelope-simple" aria-hidden="true"></i>Email</label>
                                <InputText id="email" class="mch-input" @bind-Value="createForm.Email" />
                                <ValidationMessage For="() => createForm.Email" />
                            </div>

                            <div class="macc-field">
                                <label for="firstName"><i class="ph ph-user-circle" aria-hidden="true"></i>First name</label>
                                <InputText id="firstName" class="mch-input" @bind-Value="createForm.FirstName" />
                                <ValidationMessage For="() => createForm.FirstName" />
                            </div>

                            <div class="macc-field">
                                <label for="lastName"><i class="ph ph-user-circle" aria-hidden="true"></i>Last name</label>
                                <InputText id="lastName" class="mch-input" @bind-Value="createForm.LastName" />
                                <ValidationMessage For="() => createForm.LastName" />
                            </div>

                            <div class="macc-field">
                                <label for="password"><i class="ph ph-lock-key" aria-hidden="true"></i>Password</label>
                                <InputText id="password" type="password" class="mch-input"
                                           @bind-Value="createForm.Password" />
                                <ValidationMessage For="() => createForm.Password" />
                            </div>

                            <div class="macc-field">
                                <label for="confirmPassword"><i class="ph ph-check-square" aria-hidden="true"></i>Confirm password</label>
                                <InputText id="confirmPassword" type="password" class="mch-input"
                                           @bind-Value="createForm.ConfirmPassword" />
                                <ValidationMessage For="() => createForm.ConfirmPassword" />
                            </div>

                            <div class="macc-field macc-field-full">
                                <label for="warehouse"><i class="ph ph-warehouse" aria-hidden="true"></i>Default warehouse</label>
                                <select id="warehouse" class="mch-select" @bind="selectedWarehouseCode">
                                    <option value="">Select a warehouse</option>
                                    @foreach (var warehouse in warehouses)
                                    {
                                        <option value="@warehouse.WarehouseCode">
                                            @warehouse.WarehouseCode — @warehouse.WarehouseName
                                        </option>
                                    }
                                </select>
                                <small>Attached to the merchandiser profile when one is selected.</small>
                            </div>
                        </div>
                    </div>
                </section>

                <section class="macc-card">
                    <div class="macc-card-header">
                        <h2><i class="ph ph-buildings" aria-hidden="true"></i>Assigned business partners</h2>
                        <span class="macc-card-note">@createForm.AssignedCustomerCodes.Count selected</span>
                    </div>

                    <div class="macc-card-body">
                        <div class="macc-field">
                            <label for="customerSearch"><i class="ph ph-magnifying-glass" aria-hidden="true"></i>Search customers</label>
                            <div class="mch-search mch-search-block">
                                <i class="ph ph-magnifying-glass" aria-hidden="true"></i>
                                <input id="customerSearch" type="search" class="mch-input"
                                       placeholder="Search by code or name"
                                       @bind="createCustomerSearchTerm" @bind:event="oninput" />
                            </div>
                            <ValidationMessage For="() => createForm.AssignedCustomerCodes" />
                        </div>

                        @if (filteredCreateCustomers.Any())
                        {
                            <div class="macc-customer-list">
                                @foreach (var customer in filteredCreateCustomers)
                                {
                                    var cardCode = customer.CardCode ?? string.Empty;
                                    var isSelected = createForm.AssignedCustomerCodes.Contains(
                                        cardCode, StringComparer.OrdinalIgnoreCase);
                                    <label class="macc-customer-item">
                                        <input type="checkbox" checked="@isSelected"
                                               @onchange="args => ToggleCreateCustomer(cardCode, args.Value as bool? == true)" />
                                        <span class="macc-customer-text">
                                            <strong>@cardCode</strong>
                                            <span>@(customer.IsActive ? customer.CardName : $"{customer.CardName} (Inactive)")</span>
                                        </span>
                                    </label>
                                }
                            </div>
                        }
                        else
                        {
                            <div class="macc-empty">
                                <i class="ph ph-magnifying-glass" aria-hidden="true"></i>
                                <p>No customers match the current search.</p>
                            </div>
                        }
                    </div>
                </section>
            </div>

            <div class="macc-actions">
                <button type="submit" class="mch-btn mch-btn-primary" disabled="@isCreating">
                    @if (isCreating)
                    {
                        <span class="mch-spinner"></span>
                        <span>Creating&hellip;</span>
                    }
                    else
                    {
                        <i class="ph ph-user-plus" aria-hidden="true"></i>
                        <span>Create merchandiser account</span>
                    }
                </button>
            </div>
        </EditForm>

        <section class="macc-section">
            <div class="macc-section-head">
                <h2>
                    <i class="ph ph-users" aria-hidden="true"></i>Existing accounts
                    <span class="macc-section-count">@filteredMerchandisers.Count() shown</span>
                </h2>
                <div class="mch-search">
                    <i class="ph ph-magnifying-glass" aria-hidden="true"></i>
                    <input id="accountSearch" type="search" class="mch-input"
                           placeholder="Search by username, name or email"
                           aria-label="Search accounts"
                           @bind="accountSearchTerm" @bind:event="oninput" />
                </div>
            </div>

            @if (filteredMerchandisers.Any())
            {
                <div class="macc-account-list">
                    @foreach (var merchandiser in filteredMerchandisers)
                    {
                        var isEditing = editingMerchandiserId == merchandiser.Id;
                        var selectedCount = isEditing
                            ? editingAssignedCustomerCodes.Count
                            : merchandiser.AssignedCustomerCodes.Count;

                        <article class="macc-account-item @(isEditing ? "is-editing" : "") @(merchandiser.IsActive ? "" : "is-inactive")">
                            <div class="macc-account-summary">
                                <div class="macc-account-main">
                                    <div class="macc-account-name">
                                        <h3>@merchandiser.Username</h3>
                                        <span class="mch-badge @(merchandiser.IsActive ? "mch-fam-good" : "mch-fam-neutral")">
                                            @(merchandiser.IsActive ? "Active" : "Inactive")
                                        </span>
                                    </div>
                                    <div class="macc-account-sub">@GetMerchandiserSubtitle(merchandiser)</div>
                                </div>

                                @* The warehouse, the count and the first few codes are facts about
                                   the row, so they read as one quiet line rather than as chips. *@
                                <div class="macc-account-facts">
                                    <span class="macc-fact">
                                        <i class="ph ph-warehouse" aria-hidden="true"></i>
                                        @if (string.IsNullOrWhiteSpace(merchandiser.AssignedWarehouseCode))
                                        {
                                            <span class="macc-fact-none">No warehouse</span>
                                        }
                                        else
                                        {
                                            <span>@merchandiser.AssignedWarehouseCode</span>
                                        }
                                    </span>
                                    <span class="macc-fact">
                                        <i class="ph ph-buildings" aria-hidden="true"></i>
                                        <span>@selectedCount assigned</span>
                                    </span>

                                    <span class="macc-bp-tags">
                                        @foreach (var code in GetPreviewCustomerCodes(merchandiser))
                                        {
                                            <span class="macc-bp-tag">@GetCustomerDisplayName(code)</span>
                                        }
                                        @if (merchandiser.AssignedCustomerCodes.Count > previewCustomerCodeLimit)
                                        {
                                            <span class="macc-bp-tag macc-bp-tag-muted">
                                                +@(merchandiser.AssignedCustomerCodes.Count - previewCustomerCodeLimit) more
                                            </span>
                                        }
                                    </span>
                                </div>

                                <button type="button" class="mch-btn mch-btn-sm mch-btn-ghost"
                                        @onclick="() => BeginEditAssignedCustomers(merchandiser)">
                                    <i class="ph ph-pencil-simple" aria-hidden="true"></i>
                                    @(isEditing ? "Editing" : "Edit assignments")
                                </button>
                            </div>

                            @if (isEditing)
                            {
                                <div class="macc-editor">
                                    <div class="macc-editor-head">
                                        <h3><i class="ph ph-pencil-simple" aria-hidden="true"></i>Update assignments</h3>
                                        <span class="macc-card-note">@editingAssignedCustomerCodes.Count selected</span>
                                    </div>

                                    <div class="macc-field">
                                        <label for="editWarehouse"><i class="ph ph-warehouse" aria-hidden="true"></i>Assigned warehouse</label>
                                        <select id="editWarehouse" class="mch-select" @bind="editingWarehouseCode">
                                            <option value="">No warehouse assigned</option>
                                            @foreach (var warehouse in warehouses)
                                            {
                                                <option value="@warehouse.WarehouseCode">
                                                    @warehouse.WarehouseCode — @warehouse.WarehouseName
                                                </option>
                                            }
                                        </select>
                                    </div>

                                    @* Chosen on the left, searchable on the right, so what is already
                                       assigned stays visible while more is added. *@
                                    <div class="macc-editor-grid">
                                        <section class="macc-editor-col">
                                            <div class="macc-editor-col-head">
                                                <h4>Selected</h4>
                                                <span class="macc-card-note">Remove from here</span>
                                            </div>

                                            @if (editingAssignedCustomerCodes.Any())
                                            {
                                                <div class="macc-selected-list">
                                                    @foreach (var selectedCode in GetEditingSelectedCustomerCodes())
                                                    {
                                                        <div class="macc-selected-item">
                                                            <span class="macc-selected-text">
                                                                <strong>@selectedCode</strong>
                                                                <span>@GetCustomerDisplayName(selectedCode)</span>
                                                            </span>
                                                            <button type="button" class="macc-selected-remove"
                                                                    title="Remove"
                                                                    aria-label="@($"Remove {selectedCode}")"
                                                                    @onclick="() => ToggleEditCustomer(selectedCode, false)">
                                                                <i class="ph ph-x" aria-hidden="true"></i>
                                                            </button>
                                                        </div>
                                                    }
                                                </div>
                                            }
                                            else
                                            {
                                                <div class="macc-empty-inline">No business partners selected yet.</div>
                                            }
                                        </section>

                                        <section class="macc-editor-col">
                                            <div class="macc-editor-col-head">
                                                <h4>Add</h4>
                                            </div>

                                            <div class="mch-search mch-search-block">
                                                <i class="ph ph-magnifying-glass" aria-hidden="true"></i>
                                                <input id="editCustomerSearch" type="search" class="mch-input"
                                                       placeholder="Search by code or name"
                                                       aria-label="Search business partners"
                                                       @bind="editCustomerSearchTerm" @bind:event="oninput" />
                                            </div>

                                            @if (filteredEditCustomers.Any())
                                            {
                                                <div class="macc-customer-list">
                                                    @foreach (var customer in filteredEditCustomers)
                                                    {
                                                        var cardCode = customer.CardCode ?? string.Empty;
                                                        var isSelected = editingAssignedCustomerCodes.Contains(cardCode);
                                                        <label class="macc-customer-item">
                                                            <input type="checkbox" checked="@isSelected"
                                                                   @onchange="args => ToggleEditCustomer(cardCode, args.Value as bool? == true)" />
                                                            <span class="macc-customer-text">
                                                                <strong>@cardCode</strong>
                                                                <span>@(customer.IsActive ? customer.CardName : $"{customer.CardName} (Inactive)")</span>
                                                            </span>
                                                        </label>
                                                    }
                                                </div>
                                            }
                                            else
                                            {
                                                <div class="macc-empty-inline">No business partners match the current search.</div>
                                            }
                                        </section>
                                    </div>

                                    <div class="macc-actions">
                                        <button type="button" class="mch-btn mch-btn-ghost" disabled="@isUpdating"
                                                @onclick="CancelEditAssignedCustomers">
                                            Cancel
                                        </button>
                                        <button type="button" class="mch-btn mch-btn-primary" disabled="@isUpdating"
                                                @onclick="() => SaveAssignedCustomersAsync(merchandiser)">
                                            @if (isUpdating)
                                            {
                                                <span class="mch-spinner"></span>
                                                <span>Saving&hellip;</span>
                                            }
                                            else
                                            {
                                                <i class="ph ph-floppy-disk" aria-hidden="true"></i>
                                                <span>Save assignments</span>
                                            }
                                        </button>
                                    </div>
                                </div>
                            }
                        </article>
                    }
                </div>
            }
            else
            {
                <div class="macc-empty">
                    <i class="ph ph-users-three" aria-hidden="true"></i>
                    <h3>No merchandiser accounts found</h3>
                    <p>Try a different search, or create the first account above.</p>
                </div>
            }
        </section>
    }
</div>
