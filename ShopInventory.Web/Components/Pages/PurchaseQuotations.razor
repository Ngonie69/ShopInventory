@page "/purchase-quotations"
@attribute [Authorize(Roles = "Admin,Manager")]
@rendermode InteractiveServer

<PageTitle>Purchase Quotations</PageTitle>

@* Nocturne. wwwroot/css/purchase-documents.css (linked from App.razor) carries
   the design and its light counterpart, and follows the app's theme toggle like
   every other page. The sheet is shared with the other three purchase registers
   — see its header for why one sheet rather than four.

   The rules live in that sheet rather than in a <style> block here for the
   reason its header gives: app.css's global `.dark-theme input` rule would
   otherwise repaint every field in this page's filters.

   The register is a CSS grid rather than a <table>: below 1040px the same
   markup re-lays as a labelled card, which a table element cannot do.

   The selected document opens in a drawer rather than a panel beside the list,
   which is the pattern the other Nocturne registers use — it gives the list the
   full width and the document the room its lines need. *@

<div class="pdx is-quotation">

    <header class="pdx-head">
        <div class="pdx-head-inner">
            <div class="pdx-head-doc">
                <span class="pdx-head-kind">Purchase quotations</span>
                <span class="pdx-range">@DateRangeLabel</span>
            </div>
            <div class="pdx-head-meta">
                <button type="button" class="pdx-btn pdx-btn-ghost" disabled="@isLoading" @onclick="ReloadAsync">
                    @if (isLoading)
                    {
                        <span class="pdx-spin" aria-hidden="true"></span>
                        <span>Loading&#8230;</span>
                    }
                    else
                    {
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                             stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <path d="M20 11a8 8 0 0 0-13.7-5.3L4 8"></path>
                            <path d="M4 4v4h4"></path>
                            <path d="M4 13a8 8 0 0 0 13.7 5.3L20 16"></path>
                            <path d="M20 20v-4h-4"></path>
                        </svg>
                        <span>Refresh</span>
                    }
                </button>
                <button type="button" class="pdx-btn pdx-btn-primary" @onclick="NavigateToCreate">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                         stroke-width="1.8" stroke-linecap="round" aria-hidden="true">
                        <path d="M12 5v14M5 12h14"></path>
                    </svg>
                    <span>New quotation</span>
                </button>
            </div>
        </div>
    </header>

    <div class="pdx-body">

        <section class="pdx-hero">
            <div>
                <div class="pdx-kicker">Purchasing</div>
                <h1>Purchase quotations</h1>
                <p>
                    Supplier quotations pulled from SAP &#8212; what was quoted, by whom, and on what
                    terms, with the quoted lines behind each row.
                </p>
            </div>
        </section>

        @if (!string.IsNullOrWhiteSpace(errorMessage))
        {
            <div class="pdx-msg" role="alert">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"
                     stroke-linecap="round" aria-hidden="true">
                    <circle cx="12" cy="12" r="9"></circle>
                    <path d="M12 7.5v5.5M12 16.2v.1"></path>
                </svg>
                <span>@errorMessage</span>
                <button type="button" class="pdx-msg-x" aria-label="Dismiss" @onclick="() => errorMessage = null">
                    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"
                         stroke-linecap="round" aria-hidden="true">
                        <path d="M6 6l12 12M18 6L6 18"></path>
                    </svg>
                </button>
            </div>
        }

        <section class="pdx-stats">
            <div class="pdx-stat pdx-stat-lead">
                <div class="pdx-stat-head"><span class="pdx-stat-rule" aria-hidden="true"></span>Total documents</div>
                <div class="pdx-stat-num">
                    @if (quotationResponse is null)
                    {
                        <text>&#8212;</text>
                    }
                    else
                    {
                        @quotationResponse.TotalCount.ToString("N0")
                    }
                </div>
                <div class="pdx-stat-sub">Matching the filters</div>
            </div>
            <div class="pdx-stat">
                <div class="pdx-stat-head"><span class="pdx-stat-rule" aria-hidden="true"></span>This page</div>
                <div class="pdx-stat-num">@CurrentPageCount.ToString("N0")</div>
                <div class="pdx-stat-sub">Rows below</div>
            </div>
            <div class="pdx-stat">
                <div class="pdx-stat-head"><span class="pdx-stat-rule" aria-hidden="true"></span>Open quotations</div>
                <div class="pdx-stat-num">@OpenQuotationCount.ToString("N0")</div>
                <div class="pdx-stat-sub">On this page</div>
            </div>
            @* The total is of the rows on screen, not of the filter — the query
               is paged, so say which it is rather than let it read as a total. *@
            <div class="pdx-stat">
                <div class="pdx-stat-head"><span class="pdx-stat-rule" aria-hidden="true"></span>Page total</div>
                <div class="pdx-stat-num pdx-stat-num-money">@CurrentPageTotal.ToString("N2")</div>
                <div class="pdx-stat-sub">Quoted value on this page</div>
            </div>
        </section>

        <section class="pdx-panel">
            <div class="pdx-panel-head">
                <h2>Quotation register</h2>
                <span class="pdx-count">@RegisterCountText</span>
            </div>

            <div class="pdx-filters">
                @* Not a <label>: the field carries a popup and a chip, which a
                   label would swallow the clicks of. *@
                <div class="pdx-field pdx-field-wide">
                    <span class="pdx-label" id="pqt-f-supplier-label">Supplier</span>
                    <div class="pdx-typeahead">
                        <input class="pdx-input" type="text" autocomplete="off"
                               aria-labelledby="pqt-f-supplier-label"
                               placeholder="Code or name&#8230;"
                               @bind="supplierSearchTerm" @bind:event="oninput"
                               @onfocus="ShowSupplierResults" @onblur="HandleSupplierBlur" />
                        @if (showSupplierResults && FilteredSuppliers.Any())
                        {
                            <div class="pdx-suggest" role="listbox" aria-label="Matching suppliers">
                                @foreach (var supplier in FilteredSuppliers)
                                {
                                    @* @onmousedown rather than @onclick: the blur that
                                       closes the popup fires first and would take the
                                       click with it. *@
                                    <button type="button" class="pdx-suggest-opt" role="option"
                                            @onmousedown="() => SelectSupplier(supplier)">
                                        <span class="pdx-suggest-name">@supplier.CardCode &#183; @supplier.CardName</span>
                                        <span class="pdx-suggest-meta">@supplier.Currency</span>
                                    </button>
                                }
                            </div>
                        }
                        @if (selectedSupplier is not null)
                        {
                            <span class="pdx-chip">
                                <span class="pdx-chip-name">@selectedSupplier.DisplayName</span>
                                <button type="button" class="pdx-chip-x" aria-label="Clear the supplier filter"
                                        @onclick="ClearSupplier">
                                    <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                         stroke-width="2.4" stroke-linecap="round" aria-hidden="true">
                                        <path d="M6 6l12 12M18 6L6 18"></path>
                                    </svg>
                                </button>
                            </span>
                        }
                        else
                        {
                            <span class="pdx-hint">Pick a suggestion to filter by supplier.</span>
                        }
                    </div>
                </div>

                <div class="pdx-field">
                    <span class="pdx-label" id="pqt-f-from-label">Quoted from</span>
                    <NocturneDateField Id="pqt-f-from" @bind-Date="fromDate" AriaLabel="Quoted from" />
                </div>

                <div class="pdx-field">
                    <span class="pdx-label" id="pqt-f-to-label">Quoted to</span>
                    <NocturneDateField Id="pqt-f-to" @bind-Date="toDate" AriaLabel="Quoted to" />
                </div>

                @* These go back to SAP, so they are applied on the button rather
                   than on change. *@
                <div class="pdx-filter-actions">
                    <button type="button" class="pdx-btn pdx-btn-primary" disabled="@isLoading" @onclick="SearchAsync">
                        Apply
                    </button>
                    <button type="button" class="pdx-btn pdx-btn-quiet" disabled="@isLoading" @onclick="ClearFiltersAsync">
                        Clear
                    </button>
                </div>
            </div>

            @if (isLoading)
            {
                <div class="pdx-loading">
                    <span class="pdx-spin" aria-hidden="true"></span>
                    <span>Loading purchase quotations from SAP&#8230;</span>
                </div>
            }
            else if (Quotations.Count == 0)
            {
                <div class="pdx-empty">
                    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                         stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <path d="M6 3h9l3 3v15H6z"></path>
                        <path d="M9 10h6M9 14h4"></path>
                    </svg>
                    <span>No purchase quotation matched these filters.</span>
                    <div class="pdx-empty-actions">
                        <button type="button" class="pdx-btn pdx-btn-quiet" @onclick="ClearFiltersAsync">
                            Reset to the last thirty days
                        </button>
                    </div>
                </div>
            }
            else
            {
                <div class="pdx-scroll">
                    <div class="pdx-grid" role="table" aria-label="Purchase quotations">
                        <div class="pdx-thead" role="row">
                            <span role="columnheader">Document</span>
                            <span role="columnheader">Supplier</span>
                            <span role="columnheader">Quoted</span>
                            <span role="columnheader">Status</span>
                            <span role="columnheader" class="pdx-thead-end">Total</span>
                        </div>

                        @foreach (var quotation in Quotations)
                        {
                            <div class="pdx-row @(selectedQuotation?.DocEntry == quotation.DocEntry ? "pdx-row-on" : "")"
                                 role="row" @key="quotation.DocEntry" @onclick="() => SelectQuotation(quotation)">
                                <span class="pdx-doc" role="cell">
                                    <span class="pdx-docnum">#@quotation.DocNum</span>
                                    <span class="pdx-docsub">
                                        @if (!string.IsNullOrWhiteSpace(quotation.NumAtCard))
                                        {
                                            @($"Ref {quotation.NumAtCard}")
                                        }
                                        else
                                        {
                                            @($"Entry {quotation.DocEntry}")
                                        }
                                    </span>
                                </span>
                                <span class="pdx-party" role="cell">
                                    <span class="pdx-party-name">@quotation.CardName</span>
                                    <span class="pdx-party-code">@quotation.CardCode</span>
                                </span>
                                <span class="pdx-date pdx-cell-date" role="cell">
                                    <span class="pdx-date-main">
                                        <span class="pdx-rl">Quoted</span>@(quotation.DocDate?.ToString("dd MMM yyyy") ?? "Not set")
                                    </span>
                                    @if (quotation.DocDueDate.HasValue)
                                    {
                                        <span class="pdx-date-sub">Due @quotation.DocDueDate.Value.ToString("dd MMM yyyy")</span>
                                    }
                                </span>
                                <span class="pdx-cell-status" role="cell">
                                    <span class="pdx-badge @GetStatusCssClass(quotation.DocStatus)">@quotation.DocStatus</span>
                                </span>
                                <span class="pdx-money pdx-cell-total" role="cell">
                                    <span class="pdx-money-cur">@quotation.DocCurrency</span>
                                    <span class="pdx-money-num">@quotation.DocTotal.ToString("N2")</span>
                                </span>
                            </div>
                        }
                    </div>
                </div>

                <div class="pdx-foot">
                    <span class="pdx-foot-info">@PageRangeText</span>
                    <div class="pdx-pages">
                        <button type="button" class="pdx-step" disabled="@(isLoading || currentPage <= 1)"
                                @onclick="PreviousPageAsync">
                            Previous
                        </button>
                        <span class="pdx-page-now">Page @currentPage</span>
                        <button type="button" class="pdx-step"
                                disabled="@(isLoading || !(quotationResponse?.HasMore ?? false))"
                                @onclick="NextPageAsync">
                            Next
                        </button>
                    </div>
                </div>
            }
        </section>
    </div>
</div>

@* The scrim and the drawer carry `.pdx` themselves: they sit outside the page
   element so it cannot clip them, and the class is what puts the tokens in
   reach. *@
@if (selectedQuotation is not null)
{
    var detail = selectedQuotation;

    <div class="pdx pdx-scrim" @onclick="CloseDetail"></div>
    <aside class="pdx pdx-drawer" role="dialog" aria-modal="true" aria-label="Quotation details">
        <div class="pdx-drawer-head">
            <div>
                <h2>Quotation #@detail.DocNum</h2>
                <div class="pdx-drawer-sub">
                    <span class="pdx-badge @GetStatusCssClass(detail.DocStatus)">@detail.DocStatus</span>
                    <span>@detail.CardName</span>
                    <span>@detail.DocCurrency @detail.DocTotal.ToString("N2")</span>
                </div>
            </div>
            <button type="button" class="pdx-icon-btn pdx-drawer-x" aria-label="Close" @onclick="CloseDetail">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                     stroke-linecap="round" aria-hidden="true">
                    <path d="M6 6l12 12M18 6L6 18"></path>
                </svg>
            </button>
        </div>

        <div class="pdx-drawer-body">
            <section class="pdx-section">
                <h3>Document</h3>
                <div class="pdx-dl">
                    <div>
                        <div class="pdx-dt">Supplier</div>
                        <div class="pdx-dd">@detail.CardCode &#183; @detail.CardName</div>
                    </div>
                    <div>
                        <div class="pdx-dt">Supplier reference</div>
                        <div class="pdx-dd">@(string.IsNullOrWhiteSpace(detail.NumAtCard) ? "None" : detail.NumAtCard)</div>
                    </div>
                    <div>
                        <div class="pdx-dt">Quoted</div>
                        <div class="pdx-dd pdx-dd-num">@(detail.DocDate?.ToString("dd MMM yyyy") ?? "Not set")</div>
                    </div>
                    <div>
                        <div class="pdx-dt">Valid until</div>
                        <div class="pdx-dd pdx-dd-num">@(detail.DocDueDate?.ToString("dd MMM yyyy") ?? "Not set")</div>
                    </div>
                    <div>
                        <div class="pdx-dt">Discount</div>
                        <div class="pdx-dd pdx-dd-num">@detail.DiscountPercent.ToString("N2")%</div>
                    </div>
                    <div>
                        <div class="pdx-dt">Document total</div>
                        <div class="pdx-dd pdx-dd-num">@detail.DocCurrency @detail.DocTotal.ToString("N2")</div>
                    </div>
                </div>
            </section>

            @if (!string.IsNullOrWhiteSpace(detail.Comments))
            {
                <section class="pdx-section">
                    <h3>Comments</h3>
                    <p class="pdx-pre">@detail.Comments</p>
                </section>
            }

            <section class="pdx-section">
                <h3>Quoted lines</h3>
                @if (detail.Lines.Count == 0)
                {
                    <div class="pdx-lines-empty">This quotation has no lines.</div>
                }
                else
                {
                    <div class="pdx-lines">
                        @foreach (var line in detail.Lines)
                        {
                            <div class="pdx-line">
                                <div class="pdx-line-top">
                                    <div class="pdx-line-item">
                                        <div class="pdx-line-code">@line.ItemCode</div>
                                        <div class="pdx-line-desc">@line.ItemDescription</div>
                                    </div>
                                    <div class="pdx-money">
                                        <span class="pdx-money-cur">@detail.DocCurrency</span>
                                        <span class="pdx-money-num">@line.LineTotal.ToString("N2")</span>
                                    </div>
                                </div>
                                <div class="pdx-line-meta">
                                    <span>@line.Quantity.ToString("N2") &#215; @line.UnitPrice.ToString("N2")</span>
                                    @if (!string.IsNullOrWhiteSpace(line.WarehouseCode))
                                    {
                                        <span class="pdx-tag">@line.WarehouseCode</span>
                                    }
                                </div>
                            </div>
                        }
                    </div>
                }
            </section>
        </div>
    </aside>
}
