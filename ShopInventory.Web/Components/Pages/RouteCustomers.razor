@page "/route-customers"
@using Microsoft.AspNetCore.Authorization
@using ShopInventory.Web.Data
@using ShopInventory.Web.Models
@using ShopInventory.Web.Services
@attribute [Authorize(Roles = "Admin,Manager,Cashier")]
@inject IRouteCustomerService RouteCustomerService
@inject IMasterDataCacheService MasterDataCache
@inject IAuditService AuditService
@rendermode InteractiveServer

<PageTitle>Route Customers - Shop Inventory</PageTitle>
@* Styles live in wwwroot/css/operations.css (linked from App.razor), shared
   with the other four operational pages — see that file's header. `ops` is the
   scope; `ops-rc` is this page's own half of it. The 455-line inline <style>
   block these `rc-*` names used to resolve against is gone; the names that
   survived are the ones that said what a thing *was*. *@

<div class="ops ops-rc">

    <div class="ops-hero">
        <div class="ops-hero-text">
            <div class="ops-kicker">Field capture</div>
            <h1>Route Customers</h1>
            <p>
                Customers captured on the road, grouped by the business partner route they were
                booked against. These live here only — they are not SAP business partners.
            </p>
        </div>
        <div class="ops-hero-actions">
            <span class="ops-count">@FilteredCustomerCount customer(s)</span>
        </div>
    </div>

    @if (!string.IsNullOrWhiteSpace(feedbackMessage))
    {
        <div class="ops-msg @(feedbackIsError ? "ops-fam-bad" : "ops-fam-good")" role="status">
            <i class="ph @(feedbackIsError ? "ph-warning-octagon" : "ph-check-circle")" aria-hidden="true"></i>
            <div class="ops-msg-body">@feedbackMessage</div>
        </div>
    }

    <section class="ops-panel">
        <div class="ops-panel-head">
            <h2><i class="ph ph-signpost" aria-hidden="true"></i>Filter</h2>
        </div>
        <div class="ops-filters">
            <div class="ops-field">
                <label class="ops-label" for="rc-route">Route</label>
                <select id="rc-route" class="ops-input" @bind="selectedRouteCode">
                    <option value="">All routes</option>
                    @foreach (var routeCode in AvailableRouteCodes)
                    {
                        <option value="@routeCode">@GetRouteDisplayName(routeCode)</option>
                    }
                </select>
            </div>
            <div class="ops-field">
                <label class="ops-label" for="rc-search">Search</label>
                <div class="ops-search">
                    <i class="ph ph-magnifying-glass" aria-hidden="true"></i>
                    <input id="rc-search" type="search" class="ops-input"
                           placeholder="Customer, phone, email or code"
                           @bind="searchTerm" @bind:event="oninput" />
                </div>
            </div>
        </div>
    </section>

    @if (isLoading)
    {
        <div class="ops-loading">
            <span class="ops-spin ops-spin-lg"></span>
            <p>Loading route customers&hellip;</p>
        </div>
    }
    else if (!string.IsNullOrWhiteSpace(errorMessage))
    {
        <div class="ops-empty">
            <i class="ph ph-warning-octagon" aria-hidden="true"></i>
            <h3>Could not load route customers</h3>
            <p>@errorMessage</p>
        </div>
    }
    else if (!GetFilteredGroups().Any())
    {
        <div class="ops-empty">
            <i class="ph ph-signpost" aria-hidden="true"></i>
            <h3>No route customers</h3>
            <p>Captured customers appear here once they are booked against an assigned route.</p>
        </div>
    }
    else
    {
        @* One panel per route rather than one table with a route column: the
           route is the thing being read, and repeating it down a column would
           say otherwise. *@
        <div class="ops-rc-groups">
            @foreach (var group in GetFilteredGroups())
            {
                <section class="ops-panel">
                    <div class="ops-rc-head">
                        <div>
                            <h2 class="ops-rc-title">@group.RouteLabel</h2>
                            <div class="ops-rc-key">Route key @group.RouteCode</div>
                        </div>
                        <span class="ops-count">@group.Customers.Count customer(s)</span>
                    </div>

                    <div class="ops-scroll">
                        <table class="ops-table">
                            <thead>
                                <tr>
                                    <th>Customer</th>
                                    <th>Code</th>
                                    <th>Contact</th>
                                    <th>Address</th>
                                    <th>Captured</th>
                                    <th class="ops-mid">Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var customer in group.Customers)
                                {
                                    <tr>
                                        <td>
                                            <div class="ops-name">@customer.Name</div>
                                            @if (!string.IsNullOrWhiteSpace(customer.VatNumber))
                                            {
                                                <div class="ops-sub">VAT @customer.VatNumber</div>
                                            }
                                        </td>
                                        <td><span class="ops-code">@customer.Code</span></td>
                                        <td>
                                            <div>@(string.IsNullOrWhiteSpace(customer.Phone) ? "—" : customer.Phone)</div>
                                            <div class="ops-sub">
                                                @(string.IsNullOrWhiteSpace(customer.Email) ? "—" : customer.Email)
                                            </div>
                                        </td>
                                        <td>@(string.IsNullOrWhiteSpace(customer.Address) ? "—" : customer.Address)</td>
                                        <td>
                                            <div>@customer.CreatedAt.ToString("dd MMM yyyy HH:mm")</div>
                                            <div class="ops-sub">
                                                @(string.IsNullOrWhiteSpace(customer.CreatedByUserName)
                                                    ? "System" : customer.CreatedByUserName)
                                            </div>
                                        </td>
                                        <td class="ops-mid">
                                            <div class="ops-rc-actions">
                                                <button type="button" class="ops-icon-btn" title="Edit"
                                                        aria-label="@($"Edit {customer.Name}")"
                                                        @onclick="() => BeginEdit(customer)">
                                                    <i class="ph ph-pencil-simple" aria-hidden="true"></i>
                                                </button>
                                                <button type="button" class="ops-icon-btn ops-icon-btn-danger" title="Delete"
                                                        aria-label="@($"Delete {customer.Name}")"
                                                        @onclick="() => PromptDelete(customer)">
                                                    <i class="ph ph-trash" aria-hidden="true"></i>
                                                </button>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </section>
            }
        </div>
    }
</div>

@* The dialogs are siblings of `.ops`, not children — see operations.css's
   header for why they carry `.ops-overlay` themselves. *@
@if (editModel is not null)
{
    <div class="ops-overlay ops-overlay-center" @onclick="CloseEditModal">
        <div class="ops-dialog ops-dialog-wide" role="dialog" aria-modal="true" aria-label="Edit route customer"
             @onclick:stopPropagation="true">
            <div class="ops-dialog-head">
                <h2>Edit route customer</h2>
                <button type="button" class="ops-x" aria-label="Close" @onclick="CloseEditModal" disabled="@isSaving">
                    <i class="ph ph-x" aria-hidden="true"></i>
                </button>
            </div>

            <form @onsubmit="SaveRouteCustomerAsync" @onsubmit:preventDefault="true">
                <div class="ops-dialog-body">
                    @if (!string.IsNullOrWhiteSpace(editErrorMessage))
                    {
                        <div class="ops-msg ops-fam-bad" role="alert">
                            <i class="ph ph-warning-octagon" aria-hidden="true"></i>
                            <div class="ops-msg-body">@editErrorMessage</div>
                        </div>
                    }

                    <div class="ops-form-grid">
                        <div class="ops-field">
                            <label class="ops-label" for="rc-edit-route">Route</label>
                            <select id="rc-edit-route" class="ops-input"
                                    @bind="editModel.AssignedBusinessPartnerCode" required>
                                <option value="">Select a route</option>
                                @foreach (var routeCode in AvailableEditRouteCodes)
                                {
                                    <option value="@routeCode">@GetRouteDisplayName(routeCode)</option>
                                }
                            </select>
                        </div>
                        <div class="ops-field">
                            <label class="ops-label" for="rc-edit-code">Code</label>
                            <input id="rc-edit-code" class="ops-input" type="text" maxlength="50" required
                                   @bind="editModel.Code" @bind:event="oninput" />
                        </div>
                        <div class="ops-field ops-form-full">
                            <label class="ops-label" for="rc-edit-name">Name</label>
                            <input id="rc-edit-name" class="ops-input" type="text" maxlength="200" required
                                   @bind="editModel.Name" @bind:event="oninput" />
                        </div>
                        <div class="ops-field">
                            <label class="ops-label" for="rc-edit-phone">Phone</label>
                            <input id="rc-edit-phone" class="ops-input" type="text" maxlength="50"
                                   @bind="editModel.Phone" @bind:event="oninput" />
                        </div>
                        <div class="ops-field">
                            <label class="ops-label" for="rc-edit-email">Email</label>
                            <input id="rc-edit-email" class="ops-input" type="email" maxlength="255"
                                   @bind="editModel.Email" @bind:event="oninput" />
                        </div>
                        <div class="ops-field">
                            <label class="ops-label" for="rc-edit-vat">VAT number</label>
                            <input id="rc-edit-vat" class="ops-input" type="text" maxlength="100"
                                   @bind="editModel.VatNumber" @bind:event="oninput" />
                        </div>
                        <div class="ops-field">
                            <label class="ops-label">Status</label>
                            <label class="ops-rc-check">
                                <input type="checkbox" @bind="editModel.IsActive" />
                                <span>Customer is active</span>
                            </label>
                        </div>
                        <div class="ops-field ops-form-full">
                            <label class="ops-label" for="rc-edit-address">Address</label>
                            <textarea id="rc-edit-address" class="ops-input" rows="3" maxlength="500"
                                      @bind="editModel.Address" @bind:event="oninput"></textarea>
                        </div>
                    </div>
                </div>

                <div class="ops-dialog-foot">
                    <button type="button" class="ops-btn ops-btn-ghost" @onclick="CloseEditModal"
                            disabled="@isSaving">Cancel</button>
                    <button type="submit" class="ops-btn ops-btn-primary" disabled="@isSaving">
                        @if (isSaving)
                        {
                            <span class="ops-spin"></span>
                            <span>Saving&hellip;</span>
                        }
                        else
                        {
                            <i class="ph ph-floppy-disk" aria-hidden="true"></i>
                            <span>Save changes</span>
                        }
                    </button>
                </div>
            </form>
        </div>
    </div>
}

@if (customerPendingDelete is not null)
{
    <div class="ops-overlay ops-overlay-center" @onclick="CancelDelete">
        <div class="ops-dialog" role="dialog" aria-modal="true" aria-label="Delete route customer"
             @onclick:stopPropagation="true">
            <div class="ops-dialog-head">
                <h2>Delete route customer</h2>
                <button type="button" class="ops-x" aria-label="Close" @onclick="CancelDelete" disabled="@isDeleting">
                    <i class="ph ph-x" aria-hidden="true"></i>
                </button>
            </div>

            <div class="ops-dialog-body">
                @if (!string.IsNullOrWhiteSpace(deleteErrorMessage))
                {
                    <div class="ops-msg ops-fam-bad" role="alert">
                        <i class="ph ph-warning-octagon" aria-hidden="true"></i>
                        <div class="ops-msg-body">@deleteErrorMessage</div>
                    </div>
                }

                <div class="ops-msg ops-fam-warn">
                    <i class="ph ph-warning" aria-hidden="true"></i>
                    <div class="ops-msg-body">
                        Delete <strong>@customerPendingDelete.Name</strong>
                        (<span class="ops-code">@customerPendingDelete.Code</span>) from route
                        <strong>@GetRouteDisplayName(customerPendingDelete.AssignedBusinessPartnerCode)</strong>?
                        This removes the locally captured customer only.
                    </div>
                </div>
            </div>

            <div class="ops-dialog-foot">
                <button type="button" class="ops-btn ops-btn-ghost" @onclick="CancelDelete"
                        disabled="@isDeleting">Cancel</button>
                <button type="button" class="ops-btn ops-btn-danger" @onclick="DeleteRouteCustomerAsync"
                        disabled="@isDeleting">
                    @if (isDeleting)
                    {
                        <span class="ops-spin"></span>
                        <span>Deleting&hellip;</span>
                    }
                    else
                    {
                        <i class="ph ph-trash" aria-hidden="true"></i>
                        <span>Delete customer</span>
                    }
                </button>
            </div>
        </div>
    </div>
}

@code {
    private List<RouteCustomerModel> routeCustomers = [];
    private Dictionary<string, string> routeDisplayNames = new(StringComparer.OrdinalIgnoreCase);
    private bool isLoading = true;
    private string? errorMessage;
    private string? selectedRouteCode;
    private string? searchTerm;
    private string? feedbackMessage;
    private bool feedbackIsError;
    private int? editingCustomerId;
    private UpdateRouteCustomerRequest? editModel;
    private string? editErrorMessage;
    private bool isSaving;
    private RouteCustomerModel? customerPendingDelete;
    private string? deleteErrorMessage;
    private bool isDeleting;

    private IEnumerable<string> AvailableEditRouteCodes => routeDisplayNames.Keys
        .Concat(routeCustomers.Select(customer => customer.AssignedBusinessPartnerCode))
        .Where(code => !string.IsNullOrWhiteSpace(code))
        .Distinct(StringComparer.OrdinalIgnoreCase)
        .OrderBy(code => GetRouteDisplayName(code), StringComparer.OrdinalIgnoreCase);

    private IEnumerable<string> AvailableRouteCodes => routeCustomers
        .Select(customer => customer.AssignedBusinessPartnerCode)
        .Where(code => !string.IsNullOrWhiteSpace(code))
        .Distinct(StringComparer.OrdinalIgnoreCase)
        .OrderBy(code => code, StringComparer.OrdinalIgnoreCase);

    private int FilteredCustomerCount => GetFilteredGroups().Sum(group => group.Customers.Count);

    protected override async Task OnInitializedAsync()
    {
        await LoadRouteNamesAsync();
        await LoadCustomersAsync();
        await AuditService.LogAsync(AuditActions.ViewCustomers, "RouteCustomer", null);
    }

    private async Task LoadRouteNamesAsync()
    {
        try
        {
            var businessPartners = await MasterDataCache.GetBusinessPartnersAsync(includeInactive: true);
            routeDisplayNames = businessPartners?
                .Where(bp => !string.IsNullOrWhiteSpace(bp.CardCode))
                .ToDictionary(
                    bp => bp.CardCode!,
                    bp => string.IsNullOrWhiteSpace(bp.CardName) ? bp.CardCode! : $"{bp.CardCode} - {bp.CardName}",
                    StringComparer.OrdinalIgnoreCase)
                ?? new Dictionary<string, string>(StringComparer.OrdinalIgnoreCase);
        }
        catch
        {
            routeDisplayNames = new Dictionary<string, string>(StringComparer.OrdinalIgnoreCase);
        }
    }

    private async Task LoadCustomersAsync()
    {
        isLoading = true;
        errorMessage = null;

        try
        {
            routeCustomers = await RouteCustomerService.GetRouteCustomersAsync();
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
            routeCustomers = [];
        }
        finally
        {
            isLoading = false;
        }
    }

    private IEnumerable<(string RouteCode, string RouteLabel, List<RouteCustomerModel> Customers)> GetFilteredGroups()
    {
        var filteredCustomers = routeCustomers
            .Where(customer => string.IsNullOrWhiteSpace(selectedRouteCode)
                || string.Equals(customer.AssignedBusinessPartnerCode, selectedRouteCode, StringComparison.OrdinalIgnoreCase))
            .Where(MatchesSearch)
            .OrderBy(customer => customer.AssignedBusinessPartnerCode, StringComparer.OrdinalIgnoreCase)
            .ThenBy(customer => customer.Name, StringComparer.OrdinalIgnoreCase)
            .ThenBy(customer => customer.Code, StringComparer.OrdinalIgnoreCase);

        return filteredCustomers
            .GroupBy(customer => customer.AssignedBusinessPartnerCode, StringComparer.OrdinalIgnoreCase)
            .Select(group => (
                RouteCode: group.Key,
                RouteLabel: GetRouteDisplayName(group.Key),
                Customers: group.ToList()));
    }

    private bool MatchesSearch(RouteCustomerModel customer)
    {
        if (string.IsNullOrWhiteSpace(searchTerm))
        {
            return true;
        }

        var value = searchTerm.Trim();
        return customer.Name.Contains(value, StringComparison.OrdinalIgnoreCase)
            || customer.Code.Contains(value, StringComparison.OrdinalIgnoreCase)
            || (customer.Phone?.Contains(value, StringComparison.OrdinalIgnoreCase) ?? false)
            || (customer.Email?.Contains(value, StringComparison.OrdinalIgnoreCase) ?? false)
            || (customer.Address?.Contains(value, StringComparison.OrdinalIgnoreCase) ?? false)
            || customer.AssignedBusinessPartnerCode.Contains(value, StringComparison.OrdinalIgnoreCase);
    }

    private string GetRouteDisplayName(string routeCode)
        => routeDisplayNames.TryGetValue(routeCode, out var displayName) ? displayName : routeCode;

    private void BeginEdit(RouteCustomerModel customer)
    {
        ClearFeedback();
        editErrorMessage = null;
        editingCustomerId = customer.Id;
        editModel = new UpdateRouteCustomerRequest
        {
            AssignedBusinessPartnerCode = customer.AssignedBusinessPartnerCode,
            Code = customer.Code,
            Name = customer.Name,
            Phone = customer.Phone,
            Email = customer.Email,
            Address = customer.Address,
            VatNumber = customer.VatNumber,
            IsActive = customer.IsActive
        };
    }

    private void CloseEditModal()
    {
        if (isSaving)
        {
            return;
        }

        ResetEditState();
    }

    private async Task SaveRouteCustomerAsync()
    {
        if (editModel is null || editingCustomerId is null)
        {
            return;
        }

        isSaving = true;
        editErrorMessage = null;

        try
        {
            var updatedCustomer = await RouteCustomerService.UpdateRouteCustomerAsync(editingCustomerId.Value, editModel);
            UpsertRouteCustomer(updatedCustomer);
            ResetEditState();
            SetFeedback($"Saved changes for {updatedCustomer.Name}.", false);

            try
            {
                await AuditService.LogAsync(
                    AuditActions.UpdateRouteCustomer,
                    "RouteCustomer",
                    updatedCustomer.Id.ToString(),
                    $"Updated route customer {updatedCustomer.Code}",
                    true);
            }
            catch
            {
            }
        }
        catch (Exception ex)
        {
            editErrorMessage = ex.Message;
        }
        finally
        {
            isSaving = false;
        }
    }

    private void PromptDelete(RouteCustomerModel customer)
    {
        ClearFeedback();
        deleteErrorMessage = null;
        customerPendingDelete = customer;
    }

    private void CancelDelete()
    {
        if (isDeleting)
        {
            return;
        }

        ResetDeleteState();
    }

    private async Task DeleteRouteCustomerAsync()
    {
        if (customerPendingDelete is null)
        {
            return;
        }

        isDeleting = true;
        deleteErrorMessage = null;
        var customerToDelete = customerPendingDelete;

        try
        {
            await RouteCustomerService.DeleteRouteCustomerAsync(customerToDelete.Id);
            routeCustomers.RemoveAll(customer => customer.Id == customerToDelete.Id);
            NormalizeSelectedRoute();
            ResetDeleteState();
            SetFeedback($"Deleted {customerToDelete.Name}.", false);

            try
            {
                await AuditService.LogAsync(
                    AuditActions.DeleteRouteCustomer,
                    "RouteCustomer",
                    customerToDelete.Id.ToString(),
                    $"Deleted route customer {customerToDelete.Code}",
                    true);
            }
            catch
            {
            }
        }
        catch (Exception ex)
        {
            deleteErrorMessage = ex.Message;
        }
        finally
        {
            isDeleting = false;
        }
    }

    private void UpsertRouteCustomer(RouteCustomerModel customer)
    {
        var existingIndex = routeCustomers.FindIndex(existing => existing.Id == customer.Id);
        if (existingIndex >= 0)
        {
            routeCustomers[existingIndex] = customer;
        }
        else
        {
            routeCustomers.Add(customer);
        }

        NormalizeSelectedRoute();
    }

    private void NormalizeSelectedRoute()
    {
        if (string.IsNullOrWhiteSpace(selectedRouteCode))
        {
            return;
        }

        var hasMatchingRoute = routeCustomers.Any(customer =>
            string.Equals(customer.AssignedBusinessPartnerCode, selectedRouteCode, StringComparison.OrdinalIgnoreCase));

        if (!hasMatchingRoute)
        {
            selectedRouteCode = null;
        }
    }

    private void SetFeedback(string message, bool isError)
    {
        feedbackMessage = message;
        feedbackIsError = isError;
    }

    private void ClearFeedback()
    {
        feedbackMessage = null;
        feedbackIsError = false;
    }

    private void ResetEditState()
    {
        editingCustomerId = null;
        editModel = null;
        editErrorMessage = null;
    }

    private void ResetDeleteState()
    {
        customerPendingDelete = null;
        deleteErrorMessage = null;
    }
}