@using ShopInventory.Web.Services
@using MudBlazor
@inject IThemeService ThemeService
@inject IJSRuntime JS
@implements IDisposable

<button class="kf-icon-button kf-theme-toggle" type="button" @onclick="ToggleTheme"
        aria-label="@AccessibleLabel" title="@AccessibleLabel" aria-pressed="@isDarkMode">
    <span class="kf-theme-toggle__icon" aria-hidden="true">
        <MudIcon Icon="@(isDarkMode ? Icons.Material.Outlined.LightMode : Icons.Material.Outlined.DarkMode)" />
    </span>
</button>

@code {
    private bool isDarkMode;

    private string AccessibleLabel => isDarkMode ? "Switch to light theme" : "Switch to dark theme";

    protected override async Task OnInitializedAsync()
    {
        var theme = await ThemeService.GetThemeAsync();
        isDarkMode = theme == "dark";
        ThemeService.OnThemeChanged += OnThemeChanged;

        try { await JS.InvokeVoidAsync("themeManager.initTheme", theme); }
        catch { }
    }

    private async void OnThemeChanged()
    {
        isDarkMode = ThemeService.IsDarkMode;
        await InvokeAsync(StateHasChanged);
    }

    private async Task ToggleTheme()
    {
        var theme = isDarkMode ? "light" : "dark";
        try { await JS.InvokeVoidAsync("themeManager.setTheme", theme, false); }
        catch { }
        await ThemeService.SetThemeAsync(theme);
    }

    public void Dispose() => ThemeService.OnThemeChanged -= OnThemeChanged;
}
