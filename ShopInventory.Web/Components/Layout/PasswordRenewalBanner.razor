@using ShopInventory.Web.Models
@using ShopInventory.Web.Services
@implements IDisposable
@inject CustomAuthStateProvider AuthState
@inject NavigationManager Navigation

@* Nothing at all for an account whose password is in date and not close to renewal. *@
@if (_standing is { ChangeRequired: true } due)
{
    <div class="pwr-banner pwr-banner-due" role="alert">
        <i class="ph ph-lock-key" aria-hidden="true"></i>
        <div class="pwr-banner-text">
            <strong>@PasswordRenewalText.Headline(due)</strong>
            <span>@PasswordRenewalText.Detail(due)</span>
        </div>
    </div>
}
else if (_standing is { ExpiringSoon: true } soon)
{
    <div class="pwr-banner pwr-banner-soon" role="status">
        <i class="ph ph-clock-countdown" aria-hidden="true"></i>
        <div class="pwr-banner-text">
            <strong>@PasswordRenewalText.Headline(soon)</strong>
            <span>@PasswordRenewalText.Detail(soon)</span>
        </div>
        @if (!OnSecurityPage)
        {
            <a class="pwr-banner-link" href="@PasswordRenewalText.ChangePage">Change it now</a>
        }
    </div>
}

@code {
    private PasswordStandingInfo? _standing;
    private bool _interactive;

    private bool OnSecurityPage => PasswordRenewalText.IsChangePage(Navigation.ToBaseRelativePath(Navigation.Uri));

    protected override void OnInitialized() => Navigation.LocationChanged += OnLocationChanged;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // The standing is kept in the browser, which a prerender cannot read.
        if (firstRender)
        {
            _interactive = true;
            await RefreshAsync();
        }
    }

    private void OnLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e)
    {
        if (_interactive)
        {
            _ = InvokeAsync(RefreshAsync);
        }
    }

    /// <summary>
    /// Re-read on every navigation, not once: a token refresh in the background is how a session
    /// that has been open since last week learns that its renewal came due overnight.
    /// </summary>
    private async Task RefreshAsync()
    {
        try
        {
            // Only a signed-in account has a password to renew. What the browser remembers about
            // the last session says nothing about whoever is looking at the page now.
            var user = (await AuthState.GetAuthenticationStateAsync()).User;
            _standing = user.Identity?.IsAuthenticated == true
                ? await AuthState.GetPasswordStandingAsync()
                : null;
        }
        catch (Exception)
        {
            // The circuit is going away, or the browser would not answer. Nothing to hold anyone to.
            return;
        }

        // Every page but the one that fixes it leads back to the one that fixes it.
        if (_standing is { ChangeRequired: true }
            && !PasswordRenewalText.MayStayOn(Navigation.ToBaseRelativePath(Navigation.Uri)))
        {
            Navigation.NavigateTo(PasswordRenewalText.ChangePage);
            return;
        }

        StateHasChanged();
    }

    public void Dispose() => Navigation.LocationChanged -= OnLocationChanged;
}
