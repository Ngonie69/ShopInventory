@using ShopInventory.Web.Common
@inject NavSectionState SectionState

@* Navigation for the staff shell. Presentation lives in
   wwwroot/css/nocturne-shell.css — an inline <style> block here would render
   after the head stylesheets and win the cascade over them, which is what
   forced the previous shell rules to carry !important. Glyphs are Phosphor,
   the Nocturne design system's icon set, loaded in App.razor.

   Every row belongs to a <NavSection>, which draws the heading and collapses
   the rows under it. Each section is gated on the union of the roles its rows
   are gated on, so a heading is never drawn over an empty group; the inner
   AuthorizeViews still decide the rows themselves.

   Sections follow the work, not the role: one Sales group whoever sells, one
   Reports group whoever reads. A row's own gate is what keeps a role out of
   it. NavMenuRoleRenderTests renders this menu for every role and compares it
   with ShopInventory.Tests/NavMenu.roles.txt, so any change here that moves a
   link for some role shows up as a diff of that file. *@

<div class="nav-sidebar">
    <AuthorizeView>
        <Authorized>
            @* ── Overview ──
               One link, resolved per role: /dashboard for the three roles Home
               serves and /cashier-dashboard for a cashier. Hard-coding
               /dashboard here sent a cashier to a page they cannot open. *@
            <AuthorizeView Roles="@UserRoles.DashboardNavRoles"
                           Context="dashboardCtx">
                <Authorized>
                    <NavSection Title="Overview">
                        <NavLink class="snav-link" href="@RoleLandingRoutes.For(dashboardCtx.User)" Match="NavLinkMatch.All">
                            <span class="snav-icon">
                                <i class="ph ph-squares-four" aria-hidden="true"></i>
                            </span>
                            <span class="snav-text">Dashboard</span>
                        </NavLink>
                    </NavSection>
                </Authorized>
            </AuthorizeView>

            @* ── Sales ──
               Customer documents, for everyone who raises them. A sales rep used
               to have a separate "Sales" group repeating four of these links;
               the row gates below give a rep the same four and no more — sales
               orders, mobile orders and quotations, but not invoices or credit
               notes. Merchandiser is in the gate for Mobile Orders alone; Manager
               and WashBay for Credit Note Approvals alone. *@
            <AuthorizeView Roles="Admin,Cashier,Merchandiser,SalesRep,Manager,WashBay" Context="salesCtx">
                <Authorized>
                    <NavSection Title="Sales">
                        <AuthorizeView Roles="Admin,Cashier" Context="invoiceCtx">
                            <Authorized>
                                <NavLink class="snav-link" href="/invoices" Match="NavLinkMatch.Prefix">
                                    <span class="snav-icon">
                                        <i class="ph ph-receipt" aria-hidden="true"></i>
                                    </span>
                                    <span class="snav-text">Invoices</span>
                                </NavLink>
                                <NavLink class="snav-link sub-link" href="/invoices/create" Match="NavLinkMatch.All">
                                    <span class="snav-icon">
                                        <i class="ph ph-plus-circle" aria-hidden="true"></i>
                                    </span>
                                    <span class="snav-text">Create Invoice</span>
                                </NavLink>
                            </Authorized>
                        </AuthorizeView>

                        <AuthorizeView Roles="Admin,Cashier,SalesRep" Context="salesOrderCtx">
                            <Authorized>
                                <NavLink class="snav-link" href="/sales-orders" Match="NavLinkMatch.Prefix">
                                    <span class="snav-icon">
                                        <i class="ph ph-shopping-cart" aria-hidden="true"></i>
                                    </span>
                                    <span class="snav-text">Sales Orders</span>
                                </NavLink>
                                <NavLink class="snav-link sub-link" href="/sales-orders/create" Match="NavLinkMatch.All">
                                    <span class="snav-icon">
                                        <i class="ph ph-plus-circle" aria-hidden="true"></i>
                                    </span>
                                    <span class="snav-text">Create Sale Order</span>
                                </NavLink>
                            </Authorized>
                        </AuthorizeView>

                        <AuthorizeView Roles="Admin,Cashier,Merchandiser,SalesRep" Context="mobileDraftsCtx">
                            <Authorized>
                                <NavLink class="snav-link" href="/mobile-drafts" Match="NavLinkMatch.Prefix">
                                    <span class="snav-icon">
                                        <i class="ph ph-device-mobile" aria-hidden="true"></i>
                                    </span>
                                    <span class="snav-text">Mobile Orders</span>
                                </NavLink>
                            </Authorized>
                        </AuthorizeView>

                        @* A rep quotes a customer and converts the quote to a sales order;
                           the credit notes beside them stay with the invoicing roles. *@
                        <AuthorizeView Roles="@UserRoles.QuotationRoles" Context="quotationCtx">
                            <Authorized>
                                <NavLink class="snav-link" href="/quotations" Match="NavLinkMatch.Prefix">
                                    <span class="snav-icon">
                                        <i class="ph ph-file-text" aria-hidden="true"></i>
                                    </span>
                                    <span class="snav-text">Quotations</span>
                                </NavLink>
                                <NavLink class="snav-link sub-link" href="/quotations/create" Match="NavLinkMatch.All">
                                    <span class="snav-icon">
                                        <i class="ph ph-plus-circle" aria-hidden="true"></i>
                                    </span>
                                    <span class="snav-text">Create Quotation</span>
                                </NavLink>
                            </Authorized>
                        </AuthorizeView>

                        <AuthorizeView Roles="Admin,Cashier" Context="creditNoteCtx">
                            <Authorized>
                                <NavLink class="snav-link" href="/credit-notes" Match="NavLinkMatch.Prefix">
                                    <span class="snav-icon">
                                        <i class="ph ph-file-minus" aria-hidden="true"></i>
                                    </span>
                                    <span class="snav-text">Credit Notes</span>
                                </NavLink>
                                <NavLink class="snav-link sub-link" href="/credit-notes/create" Match="NavLinkMatch.All">
                                    <span class="snav-icon">
                                        <i class="ph ph-plus-circle" aria-hidden="true"></i>
                                    </span>
                                    <span class="snav-text">Create Credit Note</span>
                                </NavLink>
                            </Authorized>
                        </AuthorizeView>

                        <AuthorizeView Roles="@UserRoles.CreditNoteApprovalRoles" Context="creditNoteApprovalCtx">
                            <Authorized>
                                <NavLink class="snav-link sub-link" href="/credit-notes/approvals" Match="NavLinkMatch.All">
                                    <span class="snav-icon">
                                        <i class="ph ph-seal-check" aria-hidden="true"></i>
                                    </span>
                                    <span class="snav-text">Credit Note Approvals</span>
                                </NavLink>
                            </Authorized>
                        </AuthorizeView>
                    </NavSection>
                </Authorized>
            </AuthorizeView>

            @* ── Customers & Products ──
               What was "Catalogue". Stock Monitoring went to Inventory and G/L
               Accounts to Finance; what is left is the master data a sale is
               written against. *@
            <AuthorizeView Roles="@UserRoles.CatalogueRoles" Context="catalogueCtx">
                <Authorized>
                    <NavSection Title="Customers & Products">
                        <NavLink class="snav-link" href="/customers" Match="NavLinkMatch.Prefix">
                            <span class="snav-icon">
                                <i class="ph ph-users-three" aria-hidden="true"></i>
                            </span>
                            <span class="snav-text">Customers</span>
                        </NavLink>
                        <NavLink class="snav-link" href="/products" Match="NavLinkMatch.Prefix">
                            <span class="snav-icon">
                                <i class="ph ph-package" aria-hidden="true"></i>
                            </span>
                            <span class="snav-text">Products</span>
                        </NavLink>
                        <NavLink class="snav-link" href="/prices" Match="NavLinkMatch.Prefix">
                            <span class="snav-icon">
                                <i class="ph ph-tag" aria-hidden="true"></i>
                            </span>
                            <span class="snav-text">Price List</span>
                        </NavLink>
                    </NavSection>
                </Authorized>
            </AuthorizeView>

            @* ── Inventory ──
               Cashier is in the gate for Stock Monitoring alone, which used to sit
               under Catalogue. *@
            <AuthorizeView Roles="Admin,Manager,StockController,WashBay,DepotController,Cashier" Context="inventoryCtx">
                <Authorized>
                    <NavSection Title="Inventory">
                        <AuthorizeView Roles="@UserRoles.CatalogueRoles" Context="stockCtx">
                            <Authorized>
                                <NavLink class="snav-link" href="/stock" Match="NavLinkMatch.Prefix">
                                    <span class="snav-icon">
                                        <i class="ph ph-chart-bar" aria-hidden="true"></i>
                                    </span>
                                    <span class="snav-text">Stock Monitoring</span>
                                </NavLink>
                            </Authorized>
                        </AuthorizeView>
                        <AuthorizeView Roles="@UserRoles.InventoryTransferRoles" Context="transferCtx">
                            <Authorized>
                                <NavLink class="snav-link" href="/inventory-transfers" Match="NavLinkMatch.Prefix">
                                    <span class="snav-icon">
                                        <i class="ph ph-arrows-left-right" aria-hidden="true"></i>
                                    </span>
                                    <span class="snav-text">Transfers</span>
                                </NavLink>
                            </Authorized>
                        </AuthorizeView>
                        <AuthorizeView Roles="Admin,StockController,DepotController" Context="localStockCtx">
                            <Authorized>
                                <NavLink class="snav-link" href="/local-stock" Match="NavLinkMatch.Prefix">
                                    <span class="snav-icon">
                                        <i class="ph ph-package" aria-hidden="true"></i>
                                    </span>
                                    <span class="snav-text">Local Stock</span>
                                </NavLink>
                            </Authorized>
                        </AuthorizeView>
                    </NavSection>
                </Authorized>
            </AuthorizeView>

            @* ── Purchasing ── *@
            <AuthorizeView Roles="Admin,Manager" Context="purchasingCtx">
                <Authorized>
                    <NavSection Title="Purchasing">
                        <NavLink class="snav-link" href="/purchase-requests" Match="NavLinkMatch.Prefix">
                            <span class="snav-icon">
                                <i class="ph ph-clipboard-text" aria-hidden="true"></i>
                            </span>
                            <span class="snav-text">Purchase Requests</span>
                        </NavLink>
                        <NavLink class="snav-link sub-link" href="/purchase-requests/create" Match="NavLinkMatch.All">
                            <span class="snav-icon">
                                <i class="ph ph-file-plus" aria-hidden="true"></i>
                            </span>
                            <span class="snav-text">Create Request</span>
                        </NavLink>
                        <NavLink class="snav-link" href="/purchase-quotations" Match="NavLinkMatch.Prefix">
                            <span class="snav-icon">
                                <i class="ph ph-file-text" aria-hidden="true"></i>
                            </span>
                            <span class="snav-text">Purchase Quotations</span>
                        </NavLink>
                        <NavLink class="snav-link sub-link" href="/purchase-quotations/create" Match="NavLinkMatch.All">
                            <span class="snav-icon">
                                <i class="ph ph-file-plus" aria-hidden="true"></i>
                            </span>
                            <span class="snav-text">Create PQ</span>
                        </NavLink>
                        <NavLink class="snav-link" href="/purchase-orders" Match="NavLinkMatch.Prefix">
                            <span class="snav-icon">
                                <i class="ph ph-shopping-bag" aria-hidden="true"></i>
                            </span>
                            <span class="snav-text">Purchase Orders</span>
                        </NavLink>
                        <NavLink class="snav-link sub-link" href="/purchase-orders/create" Match="NavLinkMatch.All">
                            <span class="snav-icon">
                                <i class="ph ph-plus-circle" aria-hidden="true"></i>
                            </span>
                            <span class="snav-text">Create PO</span>
                        </NavLink>
                        <NavLink class="snav-link" href="/goods-receipt-pos" Match="NavLinkMatch.Prefix">
                            <span class="snav-icon">
                                <i class="ph ph-truck" aria-hidden="true"></i>
                            </span>
                            <span class="snav-text">Goods Receipt POs</span>
                        </NavLink>
                        <NavLink class="snav-link sub-link" href="/goods-receipt-pos/create" Match="NavLinkMatch.All">
                            <span class="snav-icon">
                                <i class="ph ph-tray" aria-hidden="true"></i>
                            </span>
                            <span class="snav-text">Create GRPO</span>
                        </NavLink>
                        <NavLink class="snav-link" href="/purchase-invoices" Match="NavLinkMatch.Prefix">
                            <span class="snav-icon">
                                <i class="ph ph-receipt" aria-hidden="true"></i>
                            </span>
                            <span class="snav-text">A/P Invoices</span>
                        </NavLink>
                        <NavLink class="snav-link sub-link" href="/purchase-invoices/create" Match="NavLinkMatch.All">
                            <span class="snav-icon">
                                <i class="ph ph-file-plus" aria-hidden="true"></i>
                            </span>
                            <span class="snav-text">Create A/P Invoice</span>
                        </NavLink>
                    </NavSection>
                </Authorized>
            </AuthorizeView>

            @* ── Finance ──
               Money in and the ledger it lands on. Was "Payments" with one pair of
               links; Daily Incoming Payments came from Insights (it is where the
               day's payment per till account is kept, not a report), and G/L
               Accounts from Catalogue. StockController is in the gate for G/L
               Accounts alone, which the catalogue roles always gave it. *@
            <AuthorizeView Roles="Admin,Cashier,Manager,StockController" Context="financeCtx">
                <Authorized>
                    <NavSection Title="Finance">
                        <AuthorizeView Roles="@UserRoles.PaymentRoles" Context="paymentCtx">
                            <Authorized>
                                <NavLink class="snav-link" href="/payments" Match="NavLinkMatch.Prefix">
                                    <span class="snav-icon">
                                        <i class="ph ph-credit-card" aria-hidden="true"></i>
                                    </span>
                                    <span class="snav-text">Incoming Payments</span>
                                </NavLink>
                                <NavLink class="snav-link sub-link" href="/payments/create" Match="NavLinkMatch.All">
                                    <span class="snav-icon">
                                        <i class="ph ph-plus-circle" aria-hidden="true"></i>
                                    </span>
                                    <span class="snav-text">Create Payment</span>
                                </NavLink>
                            </Authorized>
                        </AuthorizeView>
                        <AuthorizeView Roles="@UserRoles.CatalogueRoles" Context="glCtx">
                            <Authorized>
                                <NavLink class="snav-link" href="/gl-accounts" Match="NavLinkMatch.Prefix">
                                    <span class="snav-icon">
                                        <i class="ph ph-bank" aria-hidden="true"></i>
                                    </span>
                                    <span class="snav-text">G/L Accounts</span>
                                </NavLink>
                            </Authorized>
                        </AuthorizeView>
                    </NavSection>
                </Authorized>
            </AuthorizeView>

            @* ── Tills & Vending ──
               Sales that come in from the desktop tills. The till records were
               under Administration; Vending was a group of its own. A vendor
               shares the route customer table with a van's shops, but nobody
               running a depot counter goes looking for them under vans. *@
            <AuthorizeView Roles="@UserRoles.VendingRoles" Context="tillsCtx">
                <Authorized>
                    <NavSection Title="Tills & Vending">
                        @* The page and the API behind it admit Cashier as well; the link is
                           kept to the roles that review the tills rather than run one. *@
                        <AuthorizeView Roles="Admin,Manager" Context="tillSalesCtx">
                            <Authorized>
                                <NavLink class="snav-link" href="/desktop-sales" Match="NavLinkMatch.Prefix">
                                    <span class="snav-icon">
                                        <i class="ph ph-desktop" aria-hidden="true"></i>
                                    </span>
                                    <span class="snav-text">Desktop Sales</span>
                                </NavLink>
                            </Authorized>
                        </AuthorizeView>
                        @* The day's incoming payment per partner, the invoices it settles and the
                           G/L accounts each partner posts to. Kept beside Desktop Sales because the
                           payments settle those sales; the API reads it for these three roles. A
                           Cashier has no Desktop Sales link, so it is only indented beneath one. *@
                        <AuthorizeView Roles="Admin,Manager,Cashier" Context="dailyPaymentsCtx">
                            <Authorized>
                                <NavLink class="@(dailyPaymentsCtx.User.IsInRole("Admin") || dailyPaymentsCtx.User.IsInRole("Manager") ? "snav-link sub-link" : "snav-link")" href="/reports/desktop-sales/payments" Match="NavLinkMatch.All">
                                    <span class="snav-icon">
                                        <i class="ph ph-hand-coins" aria-hidden="true"></i>
                                    </span>
                                    <span class="snav-text">Daily Incoming Payments</span>
                                </NavLink>
                            </Authorized>
                        </AuthorizeView>
                        <AuthorizeView Roles="Admin" Context="tillRecordsCtx">
                            <Authorized>
                                <NavLink class="snav-link" href="/desktop-transactions" Match="NavLinkMatch.Prefix">
                                    <span class="snav-icon">
                                        <i class="ph ph-monitor" aria-hidden="true"></i>
                                    </span>
                                    <span class="snav-text">Desktop Transactions</span>
                                </NavLink>
                            </Authorized>
                        </AuthorizeView>
                        <VendingDepotsNavLink class="snav-link" href="/vending" Match="NavLinkMatch.Prefix">
                            <span class="snav-icon">
                                <i class="ph ph-storefront" aria-hidden="true"></i>
                            </span>
                            <span class="snav-text">Depots &amp; Vendors</span>
                        </VendingDepotsNavLink>
                        <NavLink class="snav-link" href="/vending/sales" Match="NavLinkMatch.Prefix">
                            <span class="snav-icon">
                                <i class="ph ph-receipt" aria-hidden="true"></i>
                            </span>
                            <span class="snav-text">Vending Sales</span>
                        </NavLink>
                    </NavSection>
                </Authorized>
            </AuthorizeView>

            @* ── Van Sales ──
               The day-to-day of the vans: routes, their customers, and the
               documents the handsets raise. Its reports are the next group.

               No SalesRep. A sales rep supervises merchandisers and has no part in
               the vans. StockController and DepotController are in the gate for
               the two depot rows, Customer Orders and Market Breakages. *@
            <AuthorizeView Roles="Admin,Manager,Cashier,StockController,DepotController" Context="vanSalesCtx">
                <Authorized>
                    <NavSection Title="Van Sales">
                        <AuthorizeView Roles="Admin,Manager" Context="vanRoutesCtx">
                            <Authorized>
                                <NavLink class="snav-link" href="/van-sales/routes" Match="NavLinkMatch.Prefix">
                                    <span class="snav-icon">
                                        <i class="ph ph-signpost" aria-hidden="true"></i>
                                    </span>
                                    <span class="snav-text">Routes</span>
                                </NavLink>
                            </Authorized>
                        </AuthorizeView>
                        <AuthorizeView Roles="Admin,Cashier" Context="routeCustomerCtx">
                            <Authorized>
                                @* Prefix, not All, so the link stays lit on a customer's own
                                   sales page at /route-customers/{id}/sales. *@
                                <NavLink class="snav-link" href="/route-customers" Match="NavLinkMatch.Prefix">
                                    <span class="snav-icon">
                                        <i class="ph ph-signpost" aria-hidden="true"></i>
                                    </span>
                                    <span class="snav-text">Route Customers</span>
                                </NavLink>
                                @* The page admits Admin and Cashier but not Manager, so a
                                   manager shown this link would open a refusal. *@
                                <NavLink class="snav-link" href="/van-sales-orders" Match="NavLinkMatch.All">
                                    <span class="snav-icon">
                                        <i class="ph ph-truck" aria-hidden="true"></i>
                                    </span>
                                    <span class="snav-text">Van Orders</span>
                                </NavLink>
                            </Authorized>
                        </AuthorizeView>
                        @* Orders shops placed for themselves in the app; the depot roles are
                           here because loading the van is what this screen is for. *@
                        <AuthorizeView Roles="Admin,Manager,Cashier,StockController,DepotController" Context="vanSalesOrderCtx">
                            <Authorized>
                                <NavLink class="snav-link" href="/van-sales-customer-orders" Match="NavLinkMatch.All">
                                    <span class="snav-icon">
                                        <i class="ph ph-shopping-cart" aria-hidden="true"></i>
                                    </span>
                                    <span class="snav-text">Customer Orders</span>
                                </NavLink>
                            </Authorized>
                        </AuthorizeView>
                        @* Broken stock the vans bring back from shops: counted at the depot and
                           confirmed into a transfer to returns. The API gates it on
                           vansales.breakages.confirm, which exactly these roles hold. *@
                        <AuthorizeView Roles="@UserRoles.MarketBreakageRoles" Context="marketBreakageCtx">
                            <Authorized>
                                <NavLink class="snav-link" href="/market-breakages" Match="NavLinkMatch.All">
                                    <span class="snav-icon">
                                        <i class="ph ph-package" aria-hidden="true"></i>
                                    </span>
                                    <span class="snav-text">Market Breakages</span>
                                </NavLink>
                            </Authorized>
                        </AuthorizeView>
                        @* What the app created, read from the API's own van sale records rather than from
                           SAP, so a sale fiscalised and not yet invoiced is on the list. The API gates both
                           on invoices.view, which these three roles hold. *@
                        <AuthorizeView Roles="Admin,Manager,Cashier" Context="vanSalesDocumentCtx">
                            <Authorized>
                                <NavLink class="snav-link" href="/van-sales/invoices" Match="NavLinkMatch.All">
                                    <span class="snav-icon">
                                        <i class="ph ph-receipt" aria-hidden="true"></i>
                                    </span>
                                    <span class="snav-text">Van Invoices</span>
                                </NavLink>
                                <NavLink class="snav-link" href="/van-sales/credit-notes" Match="NavLinkMatch.All">
                                    <span class="snav-icon">
                                        <i class="ph ph-file-minus" aria-hidden="true"></i>
                                    </span>
                                    <span class="snav-text">Van Credit Notes</span>
                                </NavLink>
                                @* Who may order in the app at all: the roles that own the customer
                                   relationship, not the depot ones above. *@
                                <NavLink class="snav-link" href="/van-sales-customer-accounts" Match="NavLinkMatch.All">
                                    <span class="snav-icon">
                                        <i class="ph ph-device-mobile" aria-hidden="true"></i>
                                    </span>
                                    <span class="snav-text">Customer App Access</span>
                                </NavLink>
                            </Authorized>
                        </AuthorizeView>
                    </NavSection>
                </Authorized>
            </AuthorizeView>

            @* ── Van Reports ──
               Split out of Van Sales, which had grown to sixteen rows with the
               reports and the daily work interleaved. *@
            <AuthorizeView Roles="Admin,Manager,Cashier" Context="vanReportsCtx">
                <Authorized>
                    <NavSection Title="Van Reports">
                        <AuthorizeView Roles="Admin,Manager" Context="vanRoundCtx">
                            <Authorized>
                                @* ph-truck rather than ph-van: an absent glyph renders as blank
                                   space rather than as a missing-icon box. *@
                                <NavLink class="snav-link" href="/van-sales/activity" Match="NavLinkMatch.Prefix">
                                    <span class="snav-icon">
                                        <i class="ph ph-truck" aria-hidden="true"></i>
                                    </span>
                                    <span class="snav-text">Van Activity</span>
                                </NavLink>
                                @* All, not Prefix: a prefix match on these would light them from
                                   any future /van-sales/reports/* page too. *@
                                <NavLink class="snav-link" href="/van-sales/reports/performance" Match="NavLinkMatch.All">
                                    <span class="snav-icon">
                                        <i class="ph ph-trend-up" aria-hidden="true"></i>
                                    </span>
                                    <span class="snav-text">Sales Performance</span>
                                </NavLink>
                                <NavLink class="snav-link" href="/van-sales/reports/coverage" Match="NavLinkMatch.All">
                                    <span class="snav-icon">
                                        <i class="ph ph-storefront" aria-hidden="true"></i>
                                    </span>
                                    <span class="snav-text">Coverage &amp; Outlets</span>
                                </NavLink>
                                <NavLink class="snav-link" href="/van-sales/reports/stock" Match="NavLinkMatch.All">
                                    <span class="snav-icon">
                                        <i class="ph ph-package" aria-hidden="true"></i>
                                    </span>
                                    <span class="snav-text">Van Stock</span>
                                </NavLink>
                                <NavLink class="snav-link" href="/van-sales/reports/replenishment" Match="NavLinkMatch.All">
                                    <span class="snav-icon">
                                        <i class="ph ph-arrows-clockwise" aria-hidden="true"></i>
                                    </span>
                                    <span class="snav-text">Replenishment</span>
                                </NavLink>
                                <NavLink class="snav-link" href="/van-sales/attendance-report" Match="NavLinkMatch.Prefix">
                                    <span class="snav-icon">
                                        <i class="ph ph-chart-bar" aria-hidden="true"></i>
                                    </span>
                                    <span class="snav-text">Attendance Report</span>
                                </NavLink>
                                <NavLink class="snav-link" href="/van-sales/compliance" Match="NavLinkMatch.Prefix">
                                    <span class="snav-icon">
                                        <i class="ph ph-clipboard-text" aria-hidden="true"></i>
                                    </span>
                                    <span class="snav-text">Departure Compliance</span>
                                </NavLink>
                            </Authorized>
                        </AuthorizeView>
                        <AuthorizeView Roles="Admin,Cashier" Context="routeSalesReportCtx">
                            <Authorized>
                                <NavLink class="snav-link" href="/route-sales-report" Match="NavLinkMatch.All">
                                    <span class="snav-icon">
                                        <i class="ph ph-chart-bar" aria-hidden="true"></i>
                                    </span>
                                    <span class="snav-text">Route Sales Report</span>
                                </NavLink>
                            </Authorized>
                        </AuthorizeView>
                    </NavSection>
                </Authorized>
            </AuthorizeView>

            @* ── Deliveries ──
               Proof of delivery and the crates that travel with the goods. PODs and
               Crates were two groups read by nearly the same roles; Manager and
               Merchandiser are in the gate for the crate rows alone. *@
            <AuthorizeView Roles="Admin,Cashier,PodOperator,Operator,Driver,SalesRep,Manager,Merchandiser" Context="deliveriesCtx">
                <Authorized>
                    <NavSection Title="Deliveries">
                        <AuthorizeView Roles="Admin,Cashier,PodOperator,Operator,Driver,SalesRep" Context="podCtx">
                            <Authorized>
                                @if (!podCtx.User.IsInRole("Operator"))
                                {
                                    <NavLink class="snav-link" href="/pod-dashboard" Match="NavLinkMatch.Prefix">
                                        <span class="snav-icon">
                                            <i class="ph ph-gauge" aria-hidden="true"></i>
                                        </span>
                                        <span class="snav-text">POD Dashboard</span>
                                    </NavLink>
                                }
                                <NavLink class="snav-link" href="/pods" Match="NavLinkMatch.Prefix">
                                    <span class="snav-icon">
                                        <i class="ph ph-list-checks" aria-hidden="true"></i>
                                    </span>
                                    <span class="snav-text">Product PODs</span>
                                </NavLink>
                                @if (!podCtx.User.IsInRole("Operator"))
                                {
                                    <NavLink class="snav-link" href="/pod-report" Match="NavLinkMatch.Prefix">
                                        <span class="snav-icon">
                                            <i class="ph ph-chart-bar" aria-hidden="true"></i>
                                        </span>
                                        <span class="snav-text">Product POD Report</span>
                                    </NavLink>
                                }
                                <AuthorizeView Roles="PodOperator" Context="driverAccountCtx">
                                    <Authorized>
                                        <NavLink class="snav-link" href="/user-management" Match="NavLinkMatch.Prefix">
                                            <span class="snav-icon">
                                                <i class="ph ph-truck" aria-hidden="true"></i>
                                            </span>
                                            <span class="snav-text">Driver Accounts</span>
                                        </NavLink>
                                    </Authorized>
                                </AuthorizeView>
                            </Authorized>
                        </AuthorizeView>
                        @* A sales rep owns the round: which shops a route calls at, and on
                           which days, edits included. Its own gate rather than inside the POD
                           one above, which has no Manager in it and so hid this from a manager
                           the page admits. *@
                        <AuthorizeView Roles="Admin,Manager,SalesRep" Context="routeCtx">
                            <Authorized>
                                <NavLink class="snav-link" href="/route-assignments" Match="NavLinkMatch.Prefix">
                                    <span class="snav-icon">
                                        <i class="ph ph-path" aria-hidden="true"></i>
                                    </span>
                                    <span class="snav-text">Delivery Routes</span>
                                </NavLink>
                            </Authorized>
                        </AuthorizeView>
                        <AuthorizeView Roles="Admin,Manager,Merchandiser,PodOperator,Operator,Driver,SalesRep" Context="crateCtx">
                            <Authorized>
                                <NavLink class="snav-link" href="/crates/pods" Match="NavLinkMatch.All">
                                    <span class="snav-icon">
                                        <i class="ph ph-list-checks" aria-hidden="true"></i>
                                    </span>
                                    <span class="snav-text">Crate PODs</span>
                                </NavLink>
                                @if (!crateCtx.User.IsInRole("PodOperator") && !crateCtx.User.IsInRole("Operator"))
                                {
                                    <NavLink class="snav-link" href="/crates/opening-balances" Match="NavLinkMatch.All">
                                        <span class="snav-icon">
                                            <i class="ph ph-package" aria-hidden="true"></i>
                                        </span>
                                        <span class="snav-text">Crate Opening Balances</span>
                                    </NavLink>
                                    <NavLink class="snav-link" href="/crates/grvs" Match="NavLinkMatch.All">
                                        <span class="snav-icon">
                                            <i class="ph ph-arrow-counter-clockwise" aria-hidden="true"></i>
                                        </span>
                                        <span class="snav-text">Crate GRVs</span>
                                    </NavLink>
                                }
                            </Authorized>
                        </AuthorizeView>
                    </NavSection>
                </Authorized>
            </AuthorizeView>

            @* ── Field Team ──
               Merchandisers: their check-in/out, the accounts a sales rep opens for
               them, and the purchase orders they bring back. Was "Timesheets", plus
               three rows a sales rep had under its own Sales group and the Merch PO
               report from Insights.

               Not Manager on the timesheets: merchandiser timesheets are the sales
               rep's to read. *@
            <AuthorizeView Roles="Admin,Merchandiser,SalesRep,Manager,MerchandiserPurchaseOrderViewer" Context="fieldTeamCtx">
                <Authorized>
                    <NavSection Title="Field Team">
                        <AuthorizeView Roles="Admin,Merchandiser,SalesRep" Context="timesheetsCtx">
                            <Authorized>
                                <NavLink class="snav-link" href="/timesheets" Match="NavLinkMatch.Prefix">
                                    <span class="snav-icon">
                                        <i class="ph ph-clock" aria-hidden="true"></i>
                                    </span>
                                    <span class="snav-text">Timesheets</span>
                                </NavLink>
                                <NavLink class="snav-link" href="/timesheet-report" Match="NavLinkMatch.Prefix">
                                    <span class="snav-icon">
                                        <i class="ph ph-chart-bar" aria-hidden="true"></i>
                                    </span>
                                    <span class="snav-text">Timesheet Report</span>
                                </NavLink>
                            </Authorized>
                        </AuthorizeView>
                        <AuthorizeView Roles="SalesRep" Context="merchAccountCtx">
                            <Authorized>
                                <NavLink class="snav-link" href="/merchandiser-account" Match="NavLinkMatch.Prefix">
                                    <span class="snav-icon">
                                        <i class="ph ph-user-plus" aria-hidden="true"></i>
                                    </span>
                                    <span class="snav-text">Manage Merchandisers</span>
                                </NavLink>
                            </Authorized>
                        </AuthorizeView>
                        <AuthorizeView Roles="Admin,Manager,MerchandiserPurchaseOrderViewer" Context="merchPoReportCtx">
                            <Authorized>
                                <NavLink class="snav-link" href="/reports/merchandiser-purchase-orders" Match="NavLinkMatch.Prefix">
                                    <span class="snav-icon">
                                        <i class="ph ph-check-square-offset" aria-hidden="true"></i>
                                    </span>
                                    <span class="snav-text">Merch PO Report</span>
                                </NavLink>
                            </Authorized>
                        </AuthorizeView>
                    </NavSection>
                </Authorized>
            </AuthorizeView>

            <AuthorizeView Roles="Admin,Lab" Context="labCtx">
                <Authorized>
                    <NavSection Title="Lab">
                        <NavLink class="snav-link" href="/lab/batch-status" Match="NavLinkMatch.Prefix">
                            <span class="snav-icon">
                                <i class="ph ph-flask" aria-hidden="true"></i>
                            </span>
                            <span class="snav-text">Batch Status</span>
                        </NavLink>
                        <NavLink class="snav-link" href="/lab/batch-status/history" Match="NavLinkMatch.All">
                            <span class="snav-icon">
                                <i class="ph ph-clock-counter-clockwise" aria-hidden="true"></i>
                            </span>
                            <span class="snav-text">Status History</span>
                        </NavLink>
                    </NavSection>
                </Authorized>
            </AuthorizeView>

            @* ── Reports ──
               Company-wide sales reading. Was "Insights"; the reports that belong to
               one area now sit with it — van reports under Van Reports, the Merch PO
               report under Field Team, daily and per-account payments under Finance —
               and Volume Factors, which is configuration, under Administration. *@
            <AuthorizeView Roles="Admin,Cashier,StockController,Manager,SalesRep" Context="reportsCtx">
                <Authorized>
                    <NavSection Title="Reports">
                        <AuthorizeView Roles="@UserRoles.InsightsRoles" Context="insightsCtx">
                            <Authorized>
                                <NavLink class="snav-link" href="/reports" Match="NavLinkMatch.All">
                                    <span class="snav-icon">
                                        <i class="ph ph-trend-up" aria-hidden="true"></i>
                                    </span>
                                    <span class="snav-text">Reports Hub</span>
                                </NavLink>
                            </Authorized>
                        </AuthorizeView>
                        @* The till takings. Admin, Manager and Cashier: the API reads till
                           sales for those three only, so a stock controller shown these would
                           open a refusal. *@
                        <AuthorizeView Roles="Admin,Manager,Cashier" Context="desktopSalesReportCtx">
                            <Authorized>
                                <NavLink class="snav-link" href="/reports/management-sales" Match="NavLinkMatch.All">
                                    <span class="snav-icon">
                                        <i class="ph ph-presentation-chart" aria-hidden="true"></i>
                                    </span>
                                    <span class="snav-text">Management Sales</span>
                                </NavLink>
                                @* All, not Prefix: the review and payments pages live under this path. *@
                                <NavLink class="snav-link" href="/reports/desktop-sales" Match="NavLinkMatch.All">
                                    <span class="snav-icon">
                                        <i class="ph ph-cash-register" aria-hidden="true"></i>
                                    </span>
                                    <span class="snav-text">Desktop Sales Analysis</span>
                                </NavLink>
                                <NavLink class="snav-link sub-link" href="/reports/desktop-sales/review" Match="NavLinkMatch.All">
                                    <span class="snav-icon">
                                        <i class="ph ph-lightbulb" aria-hidden="true"></i>
                                    </span>
                                    <span class="snav-text">Desktop Sales Review</span>
                                </NavLink>
                            </Authorized>
                        </AuthorizeView>
                        @* A rep's copy is scoped to one business partner they pick; the page
                           requires the choice before it will load. *@
                        <AuthorizeView Roles="@UserRoles.OrderFulfillmentReportRoles" Context="fulfillmentCtx">
                            <Authorized>
                                <NavLink class="snav-link" href="/reports/order-fulfillment" Match="NavLinkMatch.Prefix">
                                    <span class="snav-icon">
                                        <i class="ph ph-truck" aria-hidden="true"></i>
                                    </span>
                                    <span class="snav-text">Sales Order vs Invoice</span>
                                </NavLink>
                            </Authorized>
                        </AuthorizeView>
                        <AuthorizeView Roles="Admin,SalesRep" Context="itemVolumeCtx">
                            <Authorized>
                                <NavLink class="snav-link" href="/reports/customer-revenue" Match="NavLinkMatch.Prefix">
                                    <span class="snav-icon">
                                        <i class="ph ph-currency-dollar" aria-hidden="true"></i>
                                    </span>
                                    <span class="snav-text">Customer Revenue</span>
                                </NavLink>
                                <NavLink class="snav-link" href="/reports/item-volume" Match="NavLinkMatch.Prefix">
                                    <span class="snav-icon">
                                        <i class="ph ph-drop" aria-hidden="true"></i>
                                    </span>
                                    <span class="snav-text">Item Volume</span>
                                </NavLink>
                            </Authorized>
                        </AuthorizeView>
                    </NavSection>
                </Authorized>
            </AuthorizeView>

            @* ── System ──
               Is everything still flowing: exceptions, the SAP sync and the
               transfer listener, who did what, and what goes out to phones and on
               paper. Security and Notifications moved to Account. *@
            <AuthorizeView Roles="@UserRoles.SystemRoles" Context="systemCtx">
                <Authorized>
                    <NavSection Title="System">
                        <NavLink class="snav-link" href="/exception-center" Match="NavLinkMatch.Prefix">
                            <span class="snav-icon">
                                <i class="ph ph-warning" aria-hidden="true"></i>
                            </span>
                            <span class="snav-text">Exception Center</span>
                        </NavLink>
                        <NavLink class="snav-link" href="/sync-status" Match="NavLinkMatch.Prefix">
                            <span class="snav-icon">
                                <i class="ph ph-arrows-clockwise" aria-hidden="true"></i>
                            </span>
                            <span class="snav-text">Sync Status</span>
                        </NavLink>
                        @* Beside Sync Status because it answers the same question about a
                           different link: whether stock movements are still arriving from
                           SAP. Admin and Manager only, as the API routes behind it are. *@
                        <AuthorizeView Roles="Admin,Manager" Context="listenerCtx">
                            <Authorized>
                                <NavLink class="snav-link" href="/transfer-listener" Match="NavLinkMatch.Prefix">
                                    <span class="snav-icon">
                                        <i class="ph ph-broadcast" aria-hidden="true"></i>
                                    </span>
                                    <span class="snav-text">Transfer Listener</span>
                                </NavLink>
                                <NavLink class="snav-link" href="/user-activity" Match="NavLinkMatch.Prefix">
                                    <span class="snav-icon">
                                        <i class="ph ph-pulse" aria-hidden="true"></i>
                                    </span>
                                    <span class="snav-text">Activity Log</span>
                                </NavLink>
                            </Authorized>
                        </AuthorizeView>
                        <NavLink class="snav-link" href="/document-templates" Match="NavLinkMatch.Prefix">
                            <span class="snav-icon">
                                <i class="ph ph-file-text" aria-hidden="true"></i>
                            </span>
                            <span class="snav-text">Document Templates</span>
                        </NavLink>
                        @* AI Assistant (/ai-assistant) is hidden from the sidebar and the
                           topbar command palette. The route still resolves, so existing
                           links into it — including notification action URLs — keep working. *@
                        <AuthorizeView Roles="Admin" Context="mobilePushCtx">
                            <Authorized>
                                <NavLink class="snav-link" href="/mobile-push" Match="NavLinkMatch.Prefix">
                                    <span class="snav-icon">
                                        <i class="ph ph-megaphone" aria-hidden="true"></i>
                                    </span>
                                    <span class="snav-text">Mobile Push</span>
                                </NavLink>
                            </Authorized>
                        </AuthorizeView>
                    </NavSection>
                </Authorized>
            </AuthorizeView>

            @* ── Fiscalisation (Admin only) ──
               The in-app fiscal work queue, the van offline-signing leases, and the
               fiscalisation console. Were split between Administration and System. *@
            <AuthorizeView Roles="Admin" Context="fiscalCtx">
                <Authorized>
                    <NavSection Title="Fiscalisation" ExtraClass="admin-label">
                        @* Exact match, not prefix: /fiscalisation is a prefix of the offline
                           signing route below, so a prefix match would light both. *@
                        <NavLink class="snav-link" href="/fiscalisation" Match="NavLinkMatch.All">
                            <span class="snav-icon">
                                <i class="ph ph-seal-check" aria-hidden="true"></i>
                            </span>
                            <span class="snav-text">Fiscal Queue</span>
                        </NavLink>
                        <NavLink class="snav-link" href="/fiscalisation/offline-lease" Match="NavLinkMatch.Prefix">
                            <span class="snav-icon">
                                <i class="ph ph-signature" aria-hidden="true"></i>
                            </span>
                            <span class="snav-text">Offline Signing</span>
                        </NavLink>
                        @* Device status, licences, Z-reports and fiscal-day management live in
                           the fiscalisation console, behind its own login. A plain anchor rather
                           than a NavLink: NavLink is for in-app routes and would render a bogus
                           active state on an external URL. *@
                        <a class="snav-link" href="https://fiscal.kefaloscheese.com/"
                           target="_blank" rel="noopener noreferrer">
                            <span class="snav-icon">
                                <i class="ph ph-cpu" aria-hidden="true"></i>
                            </span>
                            <span class="snav-text">Fiscal Console</span>
                            <i class="ph ph-arrow-square-out snav-external" aria-hidden="true"></i>
                        </a>
                    </NavSection>
                </Authorized>
            </AuthorizeView>

            @* ── Administration (Admin only) ──
               People and access first, then business setup, then integrations and
               housekeeping. *@
            <AuthorizeView Roles="Admin" Context="adminContext">
                <Authorized>
                    <NavSection Title="Administration" ExtraClass="admin-label">
                        <NavLink class="snav-link" href="/user-management" Match="NavLinkMatch.Prefix">
                            <span class="snav-icon">
                                <i class="ph ph-users-three" aria-hidden="true"></i>
                            </span>
                            <span class="snav-text">User Management</span>
                        </NavLink>
                        @* Straight after user management, because the two are used together: a shop
                           is opened here and then assigned to a till operator there. Distinct from
                           "Driver Shops" below, which is a driver's business partner access. *@
                        <NavLink class="snav-link" href="/shops" Match="NavLinkMatch.Prefix">
                            <span class="snav-icon">
                                <i class="ph ph-storefront" aria-hidden="true"></i>
                            </span>
                            <span class="snav-text">Shops</span>
                        </NavLink>
                        <NavLink class="snav-link" href="/driver-business-partners" Match="NavLinkMatch.Prefix">
                            <span class="snav-icon">
                                <i class="ph ph-truck" aria-hidden="true"></i>
                            </span>
                            <span class="snav-text">Driver Shops</span>
                        </NavLink>
                        <NavLink class="snav-link" href="/customer-portal-management" Match="NavLinkMatch.Prefix">
                            <span class="snav-icon">
                                <i class="ph ph-browsers" aria-hidden="true"></i>
                            </span>
                            <span class="snav-text">Customer Portal</span>
                        </NavLink>
                        <NavLink class="snav-link" href="/approval-process/setup" Match="NavLinkMatch.Prefix">
                            <span class="snav-icon">
                                <i class="ph ph-check-square-offset" aria-hidden="true"></i>
                            </span>
                            <span class="snav-text">Approval Process</span>
                        </NavLink>
                        <NavLink class="snav-link" href="/merchandiser-products" Match="NavLinkMatch.Prefix">
                            <span class="snav-icon">
                                <i class="ph ph-package" aria-hidden="true"></i>
                            </span>
                            <span class="snav-text">Merch Products</span>
                        </NavLink>
                        <NavLink class="snav-link" href="/reports/volume-conversions" Match="NavLinkMatch.Prefix">
                            <span class="snav-icon">
                                <i class="ph ph-sliders-horizontal" aria-hidden="true"></i>
                            </span>
                            <span class="snav-text">Volume Factors</span>
                        </NavLink>
                        <NavLink class="snav-link" href="/webhooks" Match="NavLinkMatch.Prefix">
                            <span class="snav-icon">
                                <i class="ph ph-broadcast" aria-hidden="true"></i>
                            </span>
                            <span class="snav-text">Webhooks</span>
                        </NavLink>
                        <NavLink class="snav-link" href="/whatsapp-inbox" Match="NavLinkMatch.Prefix">
                            <span class="snav-icon">
                                <i class="ph ph-chat-circle-dots" aria-hidden="true"></i>
                            </span>
                            <span class="snav-text">WhatsApp Inbox</span>
                        </NavLink>
                        <NavLink class="snav-link" href="/swagger" Match="NavLinkMatch.Prefix">
                            <span class="snav-icon">
                                <i class="ph ph-code" aria-hidden="true"></i>
                            </span>
                            <span class="snav-text">API Docs</span>
                        </NavLink>
                        <NavLink class="snav-link" href="/audit-trail" Match="NavLinkMatch.Prefix">
                            <span class="snav-icon">
                                <i class="ph ph-clock-counter-clockwise" aria-hidden="true"></i>
                            </span>
                            <span class="snav-text">Audit Trail</span>
                        </NavLink>
                        <NavLink class="snav-link" href="/backups" Match="NavLinkMatch.Prefix">
                            <span class="snav-icon">
                                <i class="ph ph-cloud-arrow-up" aria-hidden="true"></i>
                            </span>
                            <span class="snav-text">Backups</span>
                        </NavLink>
                        <NavLink class="snav-link" href="/settings" Match="NavLinkMatch.Prefix">
                            <span class="snav-icon">
                                <i class="ph ph-gear-six" aria-hidden="true"></i>
                            </span>
                            <span class="snav-text">Settings</span>
                        </NavLink>
                    </NavSection>
                </Authorized>
            </AuthorizeView>

            @* ── Account ──
               Every signed-in user, last. /security is [Authorize] with no roles,
               and it used to be written four times — under System, under Lab, and
               in two separate Account groups for the depot and field roles — which
               left Merchandiser, WashBay and the Merch PO viewer with no link to it
               at all. *@
            <NavSection Title="Account">
                <AuthorizeView Roles="@UserRoles.SystemRoles" Context="notificationsCtx">
                    <Authorized>
                        <NavLink class="snav-link" href="/notifications" Match="NavLinkMatch.Prefix">
                            <span class="snav-icon">
                                <i class="ph ph-bell" aria-hidden="true"></i>
                            </span>
                            <span class="snav-text">Notifications</span>
                        </NavLink>
                    </Authorized>
                </AuthorizeView>
                <NavLink class="snav-link" href="/security" Match="NavLinkMatch.Prefix">
                    <span class="snav-icon">
                        <i class="ph ph-shield-check" aria-hidden="true"></i>
                    </span>
                    <span class="snav-text">Security</span>
                </NavLink>
            </NavSection>

            <div class="nav-bottom-spacer"></div>
        </Authorized>
        <NotAuthorized>
            <NavSection Title="Account">
                <NavLink class="snav-link" href="/login" Match="NavLinkMatch.All">
                    <span class="snav-icon">
                        <i class="ph ph-sign-in" aria-hidden="true"></i>
                    </span>
                    <span class="snav-text">Login</span>
                </NavLink>
            </NavSection>
        </NotAuthorized>
    </AuthorizeView>
</div>

@code {
    // Which groups are collapsed comes out of local storage, so it can only be
    // read once the circuit is up. Sections open by default, so the worst this
    // costs is one frame with everything expanded.
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await SectionState.LoadAsync();
        }
    }
}
