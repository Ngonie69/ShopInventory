@using System.Security.Claims
@using ShopInventory.Web.Common
@inject NavigationManager Navigation
@inject IJSRuntime JS
@inject IGlobalSearchService GlobalSearchService
@inject ILogger<Topbar> Logger
@implements IAsyncDisposable

<header class="kf-topbar">
    @* Lead cell spans the drawer width so its divider continues the drawer's right edge. *@
    <div class="kf-topbar__lead">
        <button class="kf-icon-button kf-menu-toggle" type="button" @onclick="OnMenuClick"
                aria-label="Toggle navigation menu">
            <i class="ph ph-list" aria-hidden="true"></i>
        </button>

        @* The logo goes home, and home is per-role: only an Admin and a sales
           rep have a dashboard, so anyone else would land on a page they
           cannot open. RoleLandingRoutes is the same chain the sign-in page
           uses. *@
        <a class="kf-topbar__brand" href="@HomeHref" aria-label="Kefalos home">
            <BrandLogo />
        </a>
    </div>

    <div class="kf-search-shell" @onfocusin="OpenSearch" @onfocusout="CloseSearch">
        <div class="kf-search" role="combobox" aria-haspopup="listbox"
             aria-expanded="@ShowSearchResults" aria-owns="dashboard-search-results">
            <i class="ph ph-magnifying-glass" aria-hidden="true"></i>
            <label class="visually-hidden" for="dashboard-search">Search modules and documents</label>
            <input id="dashboard-search" type="search" value="@_searchQuery"
                   placeholder="Search invoices, customers, docs…" autocomplete="off"
                   @oninput="OnSearchInput" @onkeydown="HandleSearchKeyDown"
                   aria-autocomplete="list" aria-controls="dashboard-search-results"
                   aria-activedescendant="@ActiveResultId" />
            <kbd>Ctrl K</kbd>
        </div>

        @if (ShowSearchResults)
        {
            <div id="dashboard-search-results" class="kf-search-results" role="listbox"
                 aria-label="Matching modules">
                @if (SearchChoices.Count > 0)
                {
                    <p class="kf-search-results__label">Search results</p>
                    @for (var index = 0; index < SearchChoices.Count; index++)
                    {
                        var resultIndex = index;
                        var choice = SearchChoices[index];
                        <button id="@ResultId(index)" type="button" role="option"
                                aria-selected="@(index == _selectedSearchIndex)"
                                class="@(index == _selectedSearchIndex ? "is-selected" : "")"
                                @onmousedown:preventDefault="true"
                                @onmouseenter="() => _selectedSearchIndex = resultIndex"
                                @onclick="() => NavigateTo(choice.Url)">
                            <span class="kf-search-result__icon">
                                <i class="ph @choice.Icon" aria-hidden="true"></i>
                            </span>
                            <span>
                                <strong>@choice.Label</strong>
                                <small><b>@choice.Category</b>@choice.Description</small>
                            </span>
                            <i class="ph ph-arrow-right kf-search-result__arrow" aria-hidden="true"></i>
                        </button>
                    }
                }
                else if (!_isSearching)
                {
                    <div class="kf-search-empty">
                        <i class="ph ph-magnifying-glass" aria-hidden="true"></i>
                        <span>No results found for “@_searchQuery”</span>
                    </div>
                }
                @if (_isSearching)
                {
                    <div class="kf-search-loading" role="status">
                        <span class="kf-spinner" aria-hidden="true"></span>
                        Searching records…
                    </div>
                }
            </div>
        }
    </div>

    <div class="kf-topbar__actions">
        <button class="kf-icon-button kf-notification-button" type="button" @onclick="OnNotificationsClick"
                @ref="_notificationButton"
                aria-label="@NotificationLabel" aria-expanded="@NotificationsOpen">
            <i class="ph ph-bell" aria-hidden="true"></i>
            @if (UnreadCount > 0)
            {
                <span class="kf-notification-count">@UnreadDisplay</span>
            }
        </button>

        <ThemeToggle />

        <details id="dashboard-profile-menu" class="kf-profile-menu">
            <summary aria-label="Open user menu">
                <span class="kf-avatar" aria-hidden="true">@_userInitials</span>
                <span class="kf-user__copy">
                    <strong>@_displayName</strong>
                    <small>@_displayRole</small>
                </span>
                <i class="ph ph-caret-down kf-profile-chevron" aria-hidden="true"></i>
            </summary>
            <div class="kf-profile-dropdown">
                <div class="kf-profile-dropdown__identity">
                    <span class="kf-avatar" aria-hidden="true">@_userInitials</span>
                    <span>
                        <strong>@_displayName</strong>
                        <small>@_displayRole</small>
                    </span>
                </div>
                <a href="/settings">
                    <i class="ph ph-gear-six" aria-hidden="true"></i>
                    <span>Settings</span>
                </a>
                <AuthorizeView Roles="Admin">
                    <Authorized>
                        <a href="/user-management">
                            <i class="ph ph-users-three" aria-hidden="true"></i>
                            <span>User management</span>
                        </a>
                    </Authorized>
                </AuthorizeView>
                <button type="button" @onclick="OnLogout">
                    <i class="ph ph-sign-out" aria-hidden="true"></i>
                    <span>Sign out</span>
                </button>
            </div>
        </details>

        @* Hidden by the shell stylesheet: the 54px band carries the profile
           chip only, and "Sign out" sits inside its dropdown. Kept in the
           markup so the control still exists for narrow viewports if the
           chip is ever dropped there. *@
        <button class="kf-logout-button" type="button" @onclick="OnLogout">
            <i class="ph ph-sign-out" aria-hidden="true"></i>
            <span>Logout</span>
        </button>
    </div>
</header>

@code {
    [Parameter] public int UnreadCount { get; set; }
    [Parameter] public bool NotificationsOpen { get; set; }
    [Parameter] public EventCallback OnMenuClick { get; set; }
    [Parameter] public EventCallback OnNotificationsClick { get; set; }
    [Parameter] public EventCallback OnLogout { get; set; }

    private ElementReference _notificationButton;
    private string _searchQuery = string.Empty;
    private bool _searchOpen;
    private int _selectedSearchIndex;
    private bool _isSearching;
    private CancellationTokenSource? _searchCts;
    private List<SearchChoice> _recordChoices = [];
    private string _displayName = "User";
    private string _displayRole = "Staff";
    private string _userInitials = "U";
    private ClaimsPrincipal? _user;

    [CascadingParameter]
    private Task<AuthenticationState>? AuthenticationStateTask { get; set; }

    /// <summary>
    /// Where the brand takes this user. Falls back to the dashboard until the
    /// authentication state has resolved, which is what it always was.
    /// </summary>
    private string HomeHref =>
        _user is null ? RoleLandingRoutes.Dashboard : RoleLandingRoutes.For(_user);

    private string NotificationLabel =>
        UnreadCount > 0 ? $"Notifications, {UnreadCount} unread" : "Notifications";

    private string UnreadDisplay => UnreadCount > 9 ? "9+" : UnreadCount.ToString();

    private bool ShowSearchResults => _searchOpen && _searchQuery.Trim().Length >= 2;

    private List<SearchDestination> FilteredDestinations => SearchDestinations
        .Where(destination => destination.IsVisibleTo(_user))
        .Where(destination => destination.Matches(_searchQuery))
        .Take(5)
        .ToList();

    private List<SearchChoice> SearchChoices
    {
        get
        {
            var choices = FilteredDestinations
                .Select(destination => new SearchChoice(
                    destination.Label,
                    destination.Description,
                    destination.Url,
                    destination.Icon,
                    "Module"))
                .ToList();

            choices.AddRange(_recordChoices);
            return choices.Take(8).ToList();
        }
    }

    private string? ActiveResultId =>
        ShowSearchResults && SearchChoices.Count > 0
            ? ResultId(Math.Clamp(_selectedSearchIndex, 0, SearchChoices.Count - 1))
            : null;

    protected override async Task OnInitializedAsync()
    {
        if (AuthenticationStateTask is null) return;

        var authenticationState = await AuthenticationStateTask;
        var user = authenticationState.User;
        _user = user;
        _displayName = FormatDisplayName(user.Identity?.Name);
        _displayRole = GetDisplayRole(user);
        _userInitials = GetInitials(_displayName);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        try
        {
            await JS.InvokeVoidAsync("dashboardSearch.init", "dashboard-search");
            await JS.InvokeVoidAsync("dashboardProfile.init", "dashboard-profile-menu");
        }
        catch (JSException ex)
        {
            // Search shortcuts and click-away handling are progressive enhancements. A stale
            // browser-cached app.js must not terminate the entire Blazor circuit.
            Logger.LogWarning(ex, "Could not initialize topbar JavaScript enhancements");
        }
    }

    /// Returns focus to the bell after the notification panel closes.
    public async ValueTask FocusNotificationButtonAsync()
    {
        try
        {
            await _notificationButton.FocusAsync();
        }
        catch (JSException)
        {
            // Focus restoration is cosmetic; a torn-down circuit must not throw here.
        }
    }

    private void OpenSearch()
    {
        _searchOpen = true;
    }

    private async Task CloseSearch()
    {
        await Task.Delay(100);
        _searchOpen = false;
    }

    private async Task OnSearchInput(ChangeEventArgs args)
    {
        _searchQuery = args.Value?.ToString() ?? string.Empty;
        _selectedSearchIndex = 0;
        _searchOpen = true;

        _searchCts?.Cancel();
        _searchCts?.Dispose();
        _recordChoices = [];

        if (_searchQuery.Trim().Length < 2)
        {
            _isSearching = false;
            return;
        }

        var query = _searchQuery.Trim();
        var cts = new CancellationTokenSource();
        _searchCts = cts;
        _isSearching = true;

        try
        {
            await Task.Delay(250, cts.Token);
            var results = await GlobalSearchService.SearchAsync(query, cts.Token);
            // The search service is not role-aware, so drop the categories this user
            // cannot open. Each role set mirrors the [Authorize] on the landing page.
            _recordChoices = VisibleRecords(results.Invoices, UserRoles.InvoicingRoles)
                .Concat(VisibleRecords(results.Products, UserRoles.CatalogueRoles))
                .Concat(VisibleRecords(results.Customers, UserRoles.CatalogueRoles))
                .Concat(VisibleRecords(results.Payments, UserRoles.PaymentRoles))
                .Take(5)
                .Select(ToSearchChoice)
                .ToList();
        }
        catch (OperationCanceledException)
        {
            return;
        }
        finally
        {
            if (ReferenceEquals(_searchCts, cts))
            {
                _isSearching = false;
            }
        }
    }

    private void HandleSearchKeyDown(KeyboardEventArgs args)
    {
        var results = SearchChoices;

        switch (args.Key)
        {
            case "ArrowDown" when results.Count > 0:
                _selectedSearchIndex = (_selectedSearchIndex + 1) % results.Count;
                break;
            case "ArrowUp" when results.Count > 0:
                _selectedSearchIndex = _selectedSearchIndex <= 0 ? results.Count - 1 : _selectedSearchIndex - 1;
                break;
            case "Enter" when results.Count > 0:
                NavigateTo(results[Math.Clamp(_selectedSearchIndex, 0, results.Count - 1)].Url);
                break;
            case "Escape":
                _searchOpen = false;
                _searchQuery = string.Empty;
                break;
        }
    }

    private void NavigateTo(string url)
    {
        _searchCts?.Cancel();
        _searchOpen = false;
        _searchQuery = string.Empty;
        _recordChoices = [];
        Navigation.NavigateTo(url);
    }

    private static string ResultId(int index) => $"dashboard-search-result-{index}";

    private static bool HasAnyRole(ClaimsPrincipal? user, string roles) =>
        user?.Identity?.IsAuthenticated == true
        && roles.Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
                .Any(user.IsInRole);

    private IEnumerable<SearchResultItem> VisibleRecords(IEnumerable<SearchResultItem> items, string roles) =>
        HasAnyRole(_user, roles) ? items : [];

    public async ValueTask DisposeAsync()
    {
        _searchCts?.Cancel();
        _searchCts?.Dispose();
        try
        {
            await JS.InvokeVoidAsync("dashboardSearch.dispose");
            await JS.InvokeVoidAsync("dashboardProfile.dispose");
        }
        catch { }
    }

    private static SearchChoice ToSearchChoice(SearchResultItem item) =>
        new(
            item.Title,
            item.Subtitle,
            NormalizeRecordUrl(item),
            GetRecordIcon(item.Category),
            item.Category);

    private static string NormalizeRecordUrl(SearchResultItem item)
    {
        if (item.Category.Equals("Invoice", StringComparison.OrdinalIgnoreCase)
            && item.Title.StartsWith("Invoice #", StringComparison.OrdinalIgnoreCase))
        {
            return $"/invoices?search={Uri.EscapeDataString(item.Title["Invoice #".Length..])}";
        }

        return item.Url;
    }

    private static string GetRecordIcon(string category) => category switch
    {
        "Invoice" => "ph-receipt",
        "Product" => "ph-package",
        "Customer" => "ph-user",
        "Payment" => "ph-credit-card",
        _ => "ph-magnifying-glass"
    };

    private static string FormatDisplayName(string? identityName)
    {
        if (string.IsNullOrWhiteSpace(identityName)) return "User";

        var localName = identityName.Split('@')[0];
        var parts = localName
            .Replace('.', ' ')
            .Replace('_', ' ')
            .Split(' ', StringSplitOptions.RemoveEmptyEntries);

        return string.Join(" ", parts.Select(part =>
            part.Length == 1
                ? part.ToUpperInvariant()
                : char.ToUpperInvariant(part[0]) + part[1..]));
    }

    private static string GetDisplayRole(ClaimsPrincipal user)
    {
        if (user.IsInRole("Admin")) return "Administrator";
        if (user.IsInRole("Manager")) return "Manager";
        if (user.IsInRole("Cashier")) return "Cashier";
        if (user.IsInRole("SalesRep")) return "Sales representative";
        if (user.IsInRole("StockController")) return "Stock controller";
        if (user.IsInRole("DepotController")) return "Depot controller";
        if (user.IsInRole("Driver")) return "Driver";
        return "Staff";
    }

    private static string GetInitials(string displayName)
    {
        var parts = displayName.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        return parts.Length switch
        {
            0 => "U",
            1 => parts[0][..1].ToUpperInvariant(),
            _ => string.Concat(parts[0][0], parts[^1][0]).ToUpperInvariant()
        };
    }

    @* Roles must mirror the [Authorize] attribute on the destination page. An empty
       string means the page only requires authentication, not a specific role. *@
    private sealed record SearchDestination(
        string Label,
        string Description,
        string Url,
        string Icon,
        string Roles,
        params string[] Keywords)
    {
        public bool Matches(string query)
        {
            var term = query.Trim();
            return Label.Contains(term, StringComparison.OrdinalIgnoreCase)
                || Description.Contains(term, StringComparison.OrdinalIgnoreCase)
                || Url.Contains(term, StringComparison.OrdinalIgnoreCase)
                || Keywords.Any(keyword => keyword.Contains(term, StringComparison.OrdinalIgnoreCase));
        }

        public bool IsVisibleTo(ClaimsPrincipal? user) =>
            string.IsNullOrWhiteSpace(Roles)
                ? user?.Identity?.IsAuthenticated == true
                : HasAnyRole(user, Roles);
    }

    private sealed record SearchChoice(
        string Label,
        string Description,
        string Url,
        string Icon,
        string Category);

    private static readonly IReadOnlyList<SearchDestination> SearchDestinations =
    [
        new("Dashboard", "Sales and operations overview", "/dashboard", "ph-squares-four", UserRoles.DashboardRoles, "home", "overview"),
        new("Till", "Today's invoices, payments and fiscalisation", RoleLandingRoutes.CashierDashboard, "ph-squares-four", "Admin,Cashier", "cashier", "dashboard", "overview", "home"),
        new("Invoices", "Find and manage customer invoices", "/invoices", "ph-receipt", UserRoles.InvoicingRoles, "billing", "documents"),
        new("Create invoice", "Create a new customer invoice", "/invoices/create", "ph-file-plus", UserRoles.InvoicingRoles, "new invoice"),
        new("Van sales invoices", "View van sales invoices", "/van-sales-invoices", "ph-truck", UserRoles.InvoicingRoles, "van"),
        new("Payments", "Find incoming customer payments", "/payments", "ph-credit-card", UserRoles.PaymentRoles, "receipts", "cash"),
        new("Create payment", "Record an incoming payment", "/payments/create", "ph-plus-circle", UserRoles.PaymentRoles, "new payment"),
        new("Sales orders", "Find and manage sales orders", "/sales-orders", "ph-shopping-cart", "Admin,Cashier,SalesRep", "orders"),
        new("Create sales order", "Create a new sales order", "/sales-orders/create", "ph-plus-circle", "Admin,Cashier,SalesRep", "new order"),
        new("Mobile orders", "Review mobile and van sales orders", "/mobile-drafts", "ph-device-mobile", UserRoles.SalesOrderRoles, "drafts", "van"),
        new("Route customers", "Manage customers assigned to routes", "/route-customers", "ph-signpost", "Admin,Manager,Cashier", "routes"),
        new("Quotations", "Find and manage quotations", "/quotations", "ph-file-text", UserRoles.InvoicingRoles, "quotes"),
        new("Create quotation", "Create a new customer quotation", "/quotations/create", "ph-file-plus", UserRoles.InvoicingRoles, "new quote"),
        new("Credit notes", "Find and manage credit notes", "/credit-notes", "ph-file-minus", UserRoles.InvoicingRoles, "credits"),
        new("Products", "Browse the product catalogue", "/products", "ph-package", UserRoles.CatalogueRoles, "items", "catalog"),
        new("Prices", "View customer and product pricing", "/prices", "ph-tag", UserRoles.CatalogueRoles, "pricing"),
        new("Customers", "Find business partners and customers", "/customers", "ph-users-three", UserRoles.CatalogueRoles, "business partners"),
        new("Stock", "View current warehouse stock", "/stock", "ph-warehouse", UserRoles.CatalogueRoles, "inventory"),
        new("Inventory transfers", "Manage stock movements between warehouses", "/inventory-transfers", "ph-arrows-left-right", UserRoles.InventoryTransferRoles, "transfers"),
        new("Purchase orders", "Find and manage purchase orders", "/purchase-orders", "ph-shopping-bag", UserRoles.PurchasingRoles, "purchasing"),
        new("POD dashboard", "Delivery proof, coverage and what is outstanding", "/pod-dashboard", "ph-gauge", UserRoles.PodRoles, "proof of delivery", "pods"),
        new("Product PODs", "Upload and find proof of delivery", "/pods", "ph-list-checks", UserRoles.PodRoles, "proof of delivery", "upload"),
        new("POD report", "Which deliveries are still missing proof", "/pod-report", "ph-clipboard-text", UserRoles.PodRoles, "proof of delivery", "outstanding"),
        new("Reports", "Open sales and operations reports", "/reports", "ph-chart-bar", UserRoles.InsightsRoles, "analytics"),
        new("Notifications", "View system notifications", "/notifications", "ph-bell", UserRoles.SystemRoles, "alerts"),
        new("Settings", "Configure application preferences", "/settings", "ph-gear-six", UserRoles.Admin, "configuration", "preferences"),
        new("User management", "Manage staff accounts and access", "/user-management", "ph-users-three", UserRoles.UserManagementRoles, "users", "roles"),
        new("Security", "Review security configuration", "/security", "ph-shield-check", "", "authentication"),
        new("Sync status", "Review synchronization health", "/sync-status", "ph-arrows-clockwise", UserRoles.SystemRoles, "integration"),
        new("Backups", "Manage application backups", "/backups", "ph-cloud-arrow-up", UserRoles.Admin, "restore"),
        // AI assistant (/ai-assistant) is deliberately absent: the page is hidden from
        // navigation, so it must not be reachable from search either. See NavMenu.razor.
        new("WhatsApp inbox", "Review WhatsApp conversations", "/whatsapp-inbox", "ph-chat-circle-dots", UserRoles.Admin, "messages")
    ];
}
