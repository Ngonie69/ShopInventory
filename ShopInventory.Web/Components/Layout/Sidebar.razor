@using MudBlazor

<nav class="kf-sidebar-nav" aria-label="Primary navigation">
    <div class="kf-nav-group">
        <p class="kf-nav-label">Overview</p>
        <NavLink class="kf-nav-link" href="/dashboard" Match="NavLinkMatch.All">
            <MudIcon Icon="@Icons.Material.Outlined.GridView" />
            <span>Dashboard</span>
        </NavLink>
    </div>

    <AuthorizeView Roles="Admin,Cashier">
        <Authorized>
            <div class="kf-nav-group">
                <p class="kf-nav-label">Sales &amp; Billing</p>
                <NavLink class="kf-nav-link" href="/invoices" Match="NavLinkMatch.Prefix">
                    <MudIcon Icon="@Icons.Material.Outlined.ReceiptLong" />
                    <span>Invoices</span>
                </NavLink>
                <NavLink class="kf-nav-link" href="/van-sales-invoices" Match="NavLinkMatch.All">
                    <MudIcon Icon="@Icons.Material.Outlined.LocalShipping" />
                    <span>Van Sales Invoices</span>
                </NavLink>
                <NavLink class="kf-nav-link kf-nav-link--sub" href="/invoices/create" Match="NavLinkMatch.All">
                    <MudIcon Icon="@Icons.Material.Outlined.AddCircleOutline" />
                    <span>Create Invoice</span>
                </NavLink>
                <NavLink class="kf-nav-link" href="/sales-orders" Match="NavLinkMatch.Prefix">
                    <MudIcon Icon="@Icons.Material.Outlined.ShoppingCart" />
                    <span>Sales Orders</span>
                </NavLink>
                <NavLink class="kf-nav-link" href="/van-sales-orders" Match="NavLinkMatch.All">
                    <MudIcon Icon="@Icons.Material.Outlined.FireTruck" />
                    <span>Van Sales Orders</span>
                </NavLink>
                <NavLink class="kf-nav-link kf-nav-link--sub" href="/sales-orders/create" Match="NavLinkMatch.All">
                    <MudIcon Icon="@Icons.Material.Outlined.AddCircleOutline" />
                    <span>Create Sale Order</span>
                </NavLink>
                <NavLink class="kf-nav-link" href="/route-customers" Match="NavLinkMatch.All">
                    <MudIcon Icon="@Icons.Material.Outlined.Route" />
                    <span>Route Customers</span>
                </NavLink>
                <NavLink class="kf-nav-link" href="/mobile-drafts" Match="NavLinkMatch.Prefix">
                    <MudIcon Icon="@Icons.Material.Outlined.PhoneAndroid" />
                    <span>Mobile Orders</span>
                </NavLink>
                <NavLink class="kf-nav-link" href="/quotations" Match="NavLinkMatch.Prefix">
                    <MudIcon Icon="@Icons.Material.Outlined.RequestQuote" />
                    <span>Quotations</span>
                </NavLink>
                <NavLink class="kf-nav-link kf-nav-link--sub" href="/quotations/create" Match="NavLinkMatch.All">
                    <MudIcon Icon="@Icons.Material.Outlined.AddCircleOutline" />
                    <span>Create Quotation</span>
                </NavLink>
                <NavLink class="kf-nav-link" href="/credit-notes" Match="NavLinkMatch.Prefix">
                    <MudIcon Icon="@Icons.Material.Outlined.NoteAlt" />
                    <span>Credit Notes</span>
                </NavLink>
                <NavLink class="kf-nav-link kf-nav-link--sub" href="/credit-notes/create" Match="NavLinkMatch.All">
                    <MudIcon Icon="@Icons.Material.Outlined.AddCircleOutline" />
                    <span>Create Credit Note</span>
                </NavLink>
            </div>
        </Authorized>
    </AuthorizeView>

    <AuthorizeView Roles="SalesRep">
        <Authorized>
            <div class="kf-nav-group">
                <p class="kf-nav-label">Sales &amp; Billing</p>
                <NavLink class="kf-nav-link" href="/sales-orders" Match="NavLinkMatch.Prefix">
                    <MudIcon Icon="@Icons.Material.Outlined.ShoppingCart" />
                    <span>Sales Orders</span>
                </NavLink>
                <NavLink class="kf-nav-link" href="/sales-orders/create" Match="NavLinkMatch.All">
                    <MudIcon Icon="@Icons.Material.Outlined.AddCircleOutline" />
                    <span>Create Sale Order</span>
                </NavLink>
                <NavLink class="kf-nav-link" href="/route-customers" Match="NavLinkMatch.All">
                    <MudIcon Icon="@Icons.Material.Outlined.Route" />
                    <span>Route Customers</span>
                </NavLink>
                <NavLink class="kf-nav-link" href="/mobile-drafts" Match="NavLinkMatch.Prefix">
                    <MudIcon Icon="@Icons.Material.Outlined.PhoneAndroid" />
                    <span>Mobile Orders</span>
                </NavLink>
            </div>
        </Authorized>
    </AuthorizeView>
</nav>
