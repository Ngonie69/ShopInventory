@inherits LayoutComponentBase
@inject NavigationManager NavigationManager
@inject IJSRuntime JSRuntime
@inject IThemeService ThemeService
@inject ICustomerPortalSessionService CustomerSession
@implements IDisposable
@using MudBlazor

<MudThemeProvider @bind-IsDarkMode="@_isDarkMode" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

@* `cpx` is the customer-portal.css scope. It sits on the shell so the whole
   portal — chrome, and every page rendered into @Body — resolves the Nocturne
   tokens, which is what lets that stylesheet restyle the shared class
   vocabulary (dashboard-panel, stat-card, dashboard-table …) for the portal
   without touching how the same classes render on the staff pages.

   The chrome itself is the sidebar and top bar drawn by
   `Customer Portal Dashboard.dc.html`, the same design the dashboard was built
   from: the brand sits at the head of a full-height sidebar, and the bar to its
   right opens with the current section's name. MudLayout still supplies the
   frame — the drawer's responsive collapse and the content offset are real
   behaviour — but everything inside it is hand-built markup on Phosphor glyphs,
   as the staff shell's Topbar/NavMenu are. MudNavMenu was the previous
   arrangement and could not be re-skinned: MudBlazor's
   `.mud-nav-link.active:not(.mud-nav-link-disabled)` is (0,3,0) and its
   stylesheet is the last one in <head>, so an equally specific portal rule tied
   and lost, and the active row rendered in MudBlazor's blurple rather than the
   portal's teal. Plain NavLinks carry classes this file owns outright. *@
<MudLayout Class="customer-shell cpx">
    <MudAppBar Elevation="0" Dense="true" Class="customer-appbar">
        <div class="cpx-topbar">
            @* Only shown below the drawer breakpoint, where the sidebar is an overlay. *@
            <button type="button" class="cpx-icon-btn cpx-menu-toggle" @onclick="ToggleDrawer"
                    aria-label="Toggle navigation">
                <i class="ph ph-list" aria-hidden="true"></i>
            </button>

            <div class="cpx-screen-title">@ScreenTitle</div>

            <div class="cpx-topbar-actions">
                @if (!string.IsNullOrEmpty(customerName))
                {
                    <div class="cpx-account" title="@customerName">
                        <span class="cpx-account-mark" aria-hidden="true">@AccountInitial</span>
                        <span class="cpx-account-name">@customerName</span>
                    </div>
                }

                <button type="button" class="cpx-icon-btn" @onclick="ToggleTheme"
                        aria-label="@(_isDarkMode ? "Switch to light mode" : "Switch to dark mode")">
                    <i class="ph @(_isDarkMode ? "ph-sun" : "ph-moon")" aria-hidden="true"></i>
                </button>

                @if (!string.IsNullOrEmpty(customerCode))
                {
                    <button type="button" class="cpx-btn" @onclick="Logout">
                        <i class="ph ph-sign-out" aria-hidden="true"></i>
                        <span class="cpx-btn-label">Logout</span>
                    </button>
                }
                else
                {
                    <a class="cpx-btn" href="/customer-portal/login">
                        <i class="ph ph-sign-in" aria-hidden="true"></i>
                        <span class="cpx-btn-label">Login</span>
                    </a>
                }
            </div>
        </div>
    </MudAppBar>

    @* ClipMode.Never, so the sidebar runs the full height with the brand at its
       head and the bar starts at the sidebar's edge — the design's arrangement.
       MudBlazor offsets the app bar by --mud-drawer-width-left for us. *@
    <MudDrawer @bind-Open="@_drawerOpen" Elevation="0" Variant="@DrawerVariant.Responsive"
               ClipMode="DrawerClipMode.Never" Breakpoint="Breakpoint.Md" Class="customer-drawer">
        <div class="cpx-sidebar">
            @* The close button is before the kicker so it shares the brand's row —
               the kicker is a full-width flex line, and anything after it wraps
               onto a third row of its own. *@
            <div class="cpx-sidebar-brand">
                <BrandLogo />
                @* The overlay drawer has no other way back; hidden once it docks. *@
                <button type="button" class="cpx-icon-btn cpx-sidebar-close" @onclick="ToggleDrawer"
                        aria-label="Close navigation">
                    <i class="ph ph-x" aria-hidden="true"></i>
                </button>
                <span class="cpx-sidebar-kicker">Customer portal</span>
            </div>

            <nav class="cpx-nav" aria-label="Account">
                <NavLink class="cpx-navlink" href="/customer-portal/dashboard" Match="NavLinkMatch.All">
                    <i class="ph ph-squares-four" aria-hidden="true"></i><span>Dashboard</span>
                </NavLink>
                <NavLink class="cpx-navlink" href="/customer-portal/statements" Match="NavLinkMatch.Prefix">
                    <i class="ph ph-file-text" aria-hidden="true"></i><span>Statements</span>
                </NavLink>
                <NavLink class="cpx-navlink" href="/customer-portal/invoices" Match="NavLinkMatch.Prefix">
                    <i class="ph ph-receipt" aria-hidden="true"></i><span>Invoices</span>
                </NavLink>
                <NavLink class="cpx-navlink" href="/customer-portal/payments" Match="NavLinkMatch.Prefix">
                    <i class="ph ph-credit-card" aria-hidden="true"></i><span>Payments</span>
                </NavLink>
                <NavLink class="cpx-navlink" href="/customer-portal/pods" Match="NavLinkMatch.Prefix">
                    <i class="ph ph-truck" aria-hidden="true"></i><span>Proof of delivery</span>
                </NavLink>
                <NavLink class="cpx-navlink" href="/customer-portal/item-summary" Match="NavLinkMatch.Prefix">
                    <i class="ph ph-package" aria-hidden="true"></i><span>Item summary</span>
                </NavLink>
            </nav>

            <div class="cpx-nav-rule" role="presentation"></div>

            <nav class="cpx-nav" aria-label="Account settings">
                <NavLink class="cpx-navlink" href="/customer-portal/activity-log" Match="NavLinkMatch.Prefix">
                    <i class="ph ph-clock-counter-clockwise" aria-hidden="true"></i><span>Activity log</span>
                </NavLink>
                <NavLink class="cpx-navlink" href="/customer-portal/support" Match="NavLinkMatch.Prefix">
                    <i class="ph ph-lifebuoy" aria-hidden="true"></i><span>Support</span>
                </NavLink>
                <NavLink class="cpx-navlink" href="/customer-portal/profile" Match="NavLinkMatch.Prefix">
                    <i class="ph ph-user-circle" aria-hidden="true"></i><span>Profile</span>
                </NavLink>
            </nav>

            @if (!string.IsNullOrEmpty(customerCode))
            {
                <div class="cpx-code">
                    <span class="cpx-code-label">Customer code</span>
                    <span class="cpx-code-value">@customerCode</span>
                </div>
            }
        </div>
    </MudDrawer>

    <MudMainContent Class="customer-main">
        <div class="customer-content">
            @Body
        </div>

        <footer class="customer-footer">
            <div class="customer-footer-content">
                <span>© 2026 Shop Inventory System</span>
                <a href="/customer-portal/support">Contact Support</a>
                <a href="/customer-portal/privacy">Privacy Policy</a>
                <a href="/customer-portal/terms">Terms of Service</a>
            </div>
        </footer>
    </MudMainContent>
</MudLayout>

@code {
    private string? customerName;
    private string? customerCode;
    private bool _drawerOpen = true;
    private bool _isDarkMode = false;

    private string AccountInitial =>
        string.IsNullOrWhiteSpace(customerName) ? "C" : customerName.Trim()[..1].ToUpperInvariant();

    /// <summary>
    /// The bar's lead cell. The design gives it the current section's name — the brand
    /// moved into the sidebar, so this is what tells you where you are. It is the nav
    /// label, not the page's own heading: pages open with their subject (the account
    /// name, the statement period), and repeating that here would say nothing.
    /// </summary>
    private string ScreenTitle => new Uri(NavigationManager.Uri).AbsolutePath.TrimEnd('/') switch
    {
        "/customer-portal/dashboard" => "Dashboard",
        "/customer-portal/statements" => "Statements",
        "/customer-portal/invoices" => "Invoices",
        "/customer-portal/payments" => "Payments",
        "/customer-portal/pods" => "Proof of delivery",
        "/customer-portal/item-summary" => "Item summary",
        "/customer-portal/activity-log" => "Activity log",
        "/customer-portal/support" => "Support",
        "/customer-portal/profile" => "Profile",
        "/customer-portal/privacy" => "Privacy policy",
        "/customer-portal/terms" => "Terms of service",
        _ => "Customer portal"
    };

    /// <remarks>
    /// The portal's whole first-load story lives here, because every page repeats the shape.
    ///
    /// The load used to sit in OnAfterRenderAsync(firstRender). Nothing about it needed a rendered
    /// DOM — it reads the session and then fetches — so all that bought was delay: the component
    /// had to complete a full render and ship that markup to the browser before any data work
    /// started. On a page the size of the dashboard that is a wasted render of the entire body,
    /// and it is pure latency in front of the first SAP call. OnInitializedAsync starts the same
    /// work before that render instead of after it, and needs no StateHasChanged, because
    /// OnInitializedAsync already re-renders when it completes.
    ///
    /// The IsInteractive guard is not load-bearing today: App.razor renders Routes with
    /// prerender:false, so portal components only ever initialise on a circuit and the guard never
    /// fires. It is here because that is the one setting that would break this — the session lives
    /// behind JS interop, prerendering runs without a circuit, and any pass that cannot call into
    /// the browser must not try to resolve a customer. Enabling prerendering should paint the
    /// chrome sooner, not start showing signed-in visitors the signed-out page.
    ///
    /// Loading data during prerender is a different problem again, and not a lifecycle one: the
    /// token is in local storage, so the server cannot see it on the initial request. That would
    /// need the token moved into a cookie.
    /// </remarks>
    protected override async Task OnInitializedAsync()
    {
        ThemeService.OnThemeChanged += OnThemeChanged;
        NavigationManager.LocationChanged += OnLocationChanged;

        var theme = await ThemeService.GetThemeAsync();
        _isDarkMode = ThemeService.IsDarkMode;

        if (!RendererInfo.IsInteractive)
        {
            return;
        }

        try { await JSRuntime.InvokeVoidAsync("themeManager.setTheme", theme, false); } catch { }

        await LoadCustomerInfo();

        if (string.IsNullOrEmpty(customerCode) && RequiresAuthenticatedSession())
        {
            NavigationManager.NavigateTo("/customer-portal/login", forceLoad: true, replace: true);
        }
    }

    private async Task LoadCustomerInfo()
    {
        try
        {
            var session = await CustomerSession.GetCurrentSessionAsync();
            customerName = session?.Customer.CardName;
            customerCode = session?.Customer.CardCode;
        }
        catch
        {
            // Ignore errors
        }
    }

    private async void OnThemeChanged()
    {
        _isDarkMode = ThemeService.IsDarkMode;
        await InvokeAsync(StateHasChanged);
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        StateHasChanged();
    }

    private void ToggleDrawer()
    {
        _drawerOpen = !_drawerOpen;
    }

    private async Task ToggleTheme()
    {
        _isDarkMode = !_isDarkMode;
        var theme = _isDarkMode ? "dark" : "light";
        try { await JSRuntime.InvokeVoidAsync("themeManager.setTheme", theme, true); } catch { }
        await ThemeService.SetThemeAsync(theme);
    }

    private async Task Logout()
    {
        await CustomerSession.LogoutAsync();

        NavigationManager.NavigateTo("/customer-portal/login", forceLoad: true);
    }

    private bool RequiresAuthenticatedSession()
    {
        var path = new Uri(NavigationManager.Uri).AbsolutePath.TrimEnd('/');
        return path is not "/customer-portal/support"
            and not "/customer-portal/privacy"
            and not "/customer-portal/terms";
    }

    public void Dispose()
    {
        ThemeService.OnThemeChanged -= OnThemeChanged;
        NavigationManager.LocationChanged -= OnLocationChanged;
    }
}
