@inherits LayoutComponentBase
@inject NavigationManager NavigationManager
@inject IJSRuntime JSRuntime
@inject IThemeService ThemeService
@inject ICustomerPortalSessionService CustomerSession
@implements IDisposable
@using MudBlazor

<MudThemeProvider @bind-IsDarkMode="@_isDarkMode" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

@* `cpx` is the customer-portal.css scope. It sits on the shell so the whole
   portal — chrome, and every page rendered into @Body — resolves the Nocturne
   tokens, which is what lets that stylesheet restyle the shared class
   vocabulary (dashboard-panel, stat-card, dashboard-table …) for the portal
   without touching how the same classes render on the staff pages. *@
<MudLayout Class="customer-shell cpx">
    <MudAppBar Elevation="0" Dense="true" Class="customer-appbar">
        <MudIconButton Icon="@Icons.Material.Filled.Menu" Color="Color.Inherit" Edge="Edge.Start"
                       OnClick="@ToggleDrawer" Class="customer-menu-button" aria-label="Toggle navigation" />
        <img src="images/kefalos-logo.jpg" alt="Kefalos" class="customer-brand-logo"
             style="height: 32px; margin-left: 12px;" onerror="this.style.display='none'" />
        <MudText Typo="Typo.h6" Class="ml-4 customer-brand-title">Customer Portal</MudText>
        <MudSpacer />

        @if (!string.IsNullOrEmpty(customerName))
        {
            <MudChip T="string" Color="Color.Default" Variant="Variant.Text" Class="customer-account-chip">
                <MudAvatar Color="Color.Secondary" Size="Size.Small" Class="mr-2">
                    @(customerName.Length > 0 ? customerName[0].ToString().ToUpper() : "C")
                </MudAvatar>
                @customerName
            </MudChip>
        }

            <MudIconButton Icon="@(_isDarkMode ? Icons.Material.Filled.LightMode : Icons.Material.Filled.DarkMode)"
                           Color="Color.Inherit" OnClick="@ToggleTheme" aria-label="@(_isDarkMode ? "Light Mode" : "Dark Mode")"
                           Class="customer-theme-button" />

            @if (!string.IsNullOrEmpty(customerCode))
            {
                <MudButton Variant="Variant.Outlined" Color="Color.Inherit" StartIcon="@Icons.Material.Filled.Logout"
                           OnClick="@Logout" Size="Size.Small" Class="customer-auth-button">
                    <span class="customer-auth-label">Logout</span>
                </MudButton>
            }
            else
            {
                <MudButton Variant="Variant.Outlined" Color="Color.Inherit" StartIcon="@Icons.Material.Filled.Login"
                           Href="/customer-portal/login" Size="Size.Small" Class="customer-auth-button">
                    <span class="customer-auth-label">Login</span>
                </MudButton>
            }
        </MudAppBar>

        <MudDrawer @bind-Open="@_drawerOpen" Elevation="2" Variant="@DrawerVariant.Responsive"
                   ClipMode="DrawerClipMode.Always" Breakpoint="Breakpoint.Md" Class="customer-drawer">
            <MudDrawerHeader Dense="true" Class="customer-drawer-header">
                <div class="d-flex align-center gap-2 customer-drawer-brand">
                    <MudIcon Icon="@Icons.Material.Filled.Person" />
                    @if (_drawerOpen)
                    {
                        <MudText Typo="Typo.subtitle2" Class="customer-drawer-title">
                            @(customerName ?? "Customer Portal")
                        </MudText>
                    }
                </div>
            </MudDrawerHeader>

            <MudNavMenu Dense="true" Bordered="true" Class="customer-nav">
                <MudNavLink Href="/customer-portal/dashboard" Match="NavLinkMatch.All"
                            Icon="@Icons.Material.Filled.Dashboard">Dashboard</MudNavLink>
                <MudNavLink Href="/customer-portal/statements" Match="NavLinkMatch.Prefix"
                            Icon="@Icons.Material.Filled.Description">Statements</MudNavLink>
                <MudNavLink Href="/customer-portal/invoices" Match="NavLinkMatch.Prefix"
                            Icon="@Icons.Material.Filled.Receipt">Invoices</MudNavLink>
                <MudNavLink Href="/customer-portal/payments" Match="NavLinkMatch.Prefix"
                            Icon="@Icons.Material.Filled.Payment">Payments</MudNavLink>
                <MudNavLink Href="/customer-portal/pods" Match="NavLinkMatch.Prefix"
                            Icon="@Icons.Material.Filled.FactCheck">Proof of Delivery</MudNavLink>
                <MudNavLink Href="/customer-portal/item-summary" Match="NavLinkMatch.Prefix"
                            Icon="@Icons.Material.Filled.Inventory">Item Summary</MudNavLink>

                <MudDivider Class="my-2" />

                <MudNavLink Href="/customer-portal/activity-log" Match="NavLinkMatch.Prefix"
                            Icon="@Icons.Material.Filled.History">Activity Log</MudNavLink>
                <MudNavLink Href="/customer-portal/support" Match="NavLinkMatch.Prefix"
                            Icon="@Icons.Material.Filled.Support">Support</MudNavLink>
                <MudNavLink Href="/customer-portal/profile" Match="NavLinkMatch.Prefix"
                            Icon="@Icons.Material.Filled.AccountCircle">Profile</MudNavLink>
            </MudNavMenu>

            @if (!string.IsNullOrEmpty(customerCode))
            {
                <MudSpacer />
                <div class="customer-drawer-footer">
                    <div class="customer-code-card">
                        <div class="customer-code-icon">
                            <MudIcon Icon="@Icons.Material.Filled.Badge" Size="Size.Small" />
                        </div>
                        <div class="customer-code-info">
                            <span class="customer-code-label">Customer Code</span>
                            <span class="customer-code-value">@customerCode</span>
                        </div>
                    </div>
                </div>
            }
        </MudDrawer>

        <MudMainContent Class="customer-main">
            <MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="py-4 customer-content">
                @Body
            </MudContainer>

            <footer class="customer-footer">
                <MudContainer MaxWidth="MaxWidth.ExtraLarge">
                    <div class="d-flex justify-center align-center flex-wrap gap-4 py-3 customer-footer-content">
                        <span>© 2026 Shop Inventory System</span>
                        <MudLink Href="/customer-portal/support" Color="Color.Primary">Contact Support</MudLink>
                        <MudLink Href="/customer-portal/privacy" Color="Color.Primary">Privacy Policy</MudLink>
                        <MudLink Href="/customer-portal/terms" Color="Color.Primary">Terms of Service</MudLink>
                    </div>
                </MudContainer>
            </footer>
        </MudMainContent>
    </MudLayout>

@code {
    private string? customerName;
    private string? customerCode;
    private bool _drawerOpen = true;
    private bool _isDarkMode = false;

    /// <remarks>
    /// The portal's whole first-load story lives here, because every page repeats the shape.
    ///
    /// The load used to sit in OnAfterRenderAsync(firstRender). Nothing about it needed a rendered
    /// DOM — it reads the session and then fetches — so all that bought was delay: the component
    /// had to complete a full render and ship that markup to the browser before any data work
    /// started. On a page the size of the dashboard that is a wasted render of the entire body,
    /// and it is pure latency in front of the first SAP call. OnInitializedAsync starts the same
    /// work before that render instead of after it, and needs no StateHasChanged, because
    /// OnInitializedAsync already re-renders when it completes.
    ///
    /// The IsInteractive guard is not load-bearing today: App.razor renders Routes with
    /// prerender:false, so portal components only ever initialise on a circuit and the guard never
    /// fires. It is here because that is the one setting that would break this — the session lives
    /// behind JS interop, prerendering runs without a circuit, and any pass that cannot call into
    /// the browser must not try to resolve a customer. Enabling prerendering should paint the
    /// chrome sooner, not start showing signed-in visitors the signed-out page.
    ///
    /// Loading data during prerender is a different problem again, and not a lifecycle one: the
    /// token is in local storage, so the server cannot see it on the initial request. That would
    /// need the token moved into a cookie.
    /// </remarks>
    protected override async Task OnInitializedAsync()
    {
        ThemeService.OnThemeChanged += OnThemeChanged;
        NavigationManager.LocationChanged += OnLocationChanged;

        var theme = await ThemeService.GetThemeAsync();
        _isDarkMode = ThemeService.IsDarkMode;

        if (!RendererInfo.IsInteractive)
        {
            return;
        }

        try { await JSRuntime.InvokeVoidAsync("themeManager.setTheme", theme, false); } catch { }

        await LoadCustomerInfo();

        if (string.IsNullOrEmpty(customerCode) && RequiresAuthenticatedSession())
        {
            NavigationManager.NavigateTo("/customer-portal/login", forceLoad: true, replace: true);
        }
    }

    private async Task LoadCustomerInfo()
    {
        try
        {
            var session = await CustomerSession.GetCurrentSessionAsync();
            customerName = session?.Customer.CardName;
            customerCode = session?.Customer.CardCode;
        }
        catch
        {
            // Ignore errors
        }
    }

    private async void OnThemeChanged()
    {
        _isDarkMode = ThemeService.IsDarkMode;
        await InvokeAsync(StateHasChanged);
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        StateHasChanged();
    }

    private void ToggleDrawer()
    {
        _drawerOpen = !_drawerOpen;
    }

    private async Task ToggleTheme()
    {
        _isDarkMode = !_isDarkMode;
        var theme = _isDarkMode ? "dark" : "light";
        try { await JSRuntime.InvokeVoidAsync("themeManager.setTheme", theme, true); } catch { }
        await ThemeService.SetThemeAsync(theme);
    }

    private async Task Logout()
    {
        await CustomerSession.LogoutAsync();

        NavigationManager.NavigateTo("/customer-portal/login", forceLoad: true);
    }

    private bool RequiresAuthenticatedSession()
    {
        var path = new Uri(NavigationManager.Uri).AbsolutePath.TrimEnd('/');
        return path is not "/customer-portal/support"
            and not "/customer-portal/privacy"
            and not "/customer-portal/terms";
    }

    public void Dispose()
    {
        ThemeService.OnThemeChanged -= OnThemeChanged;
        NavigationManager.LocationChanged -= OnLocationChanged;
    }
}
