@inherits LayoutComponentBase
@using ShopInventory.Web.Data
@inject IAuthService AuthService
@inject NavigationManager NavigationManager
@inject IThemeService ThemeService
@inject ILocalizationService L
@inject IJSRuntime JS
@inject INotificationClientService NotificationClient
@inject INotificationHubService NotificationHub
@inject ISnackbar Snackbar
@inject CustomAuthStateProvider AuthStateProvider
@inject IAppSettingsProvider AppSettings
@inject IAuditService AuditService
@inject IBrowserViewportService BrowserViewportService
@implements IAsyncDisposable

<MudThemeProvider @ref="_mudThemeProvider" @bind-IsDarkMode="@_isDarkMode" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<MudLayout Class="@ShellClass">
    <MudAppBar Elevation="0" Dense="true" Class="staff-appbar kf-appbar">
        <Topbar @ref="_topbar"
                UnreadCount="@_unreadCount"
                NotificationsOpen="@_notifPopoverOpen"
                OnMenuClick="@ToggleDrawer"
                OnNotificationsClick="@ToggleNotificationPopover"
                OnLogout="@Logout" />
    </MudAppBar>

    @if (_isMobileLayout)
    {
        <MudDrawer @bind-Open="@_mobileDrawerOpen" Elevation="0" Variant="@DrawerVariant.Temporary"
                   ClipMode="DrawerClipMode.Never" Class="staff-drawer staff-drawer-mobile kf-drawer">
            <div class="kf-sidebar-brand">
                <BrandLogo />
                <button class="kf-sidebar-close" type="button" @onclick="ToggleDrawer" aria-label="Close navigation">
                    <MudIcon Icon="@Icons.Material.Outlined.Close" />
                </button>
            </div>
            <Sidebar />
        </MudDrawer>
    }
    else
    {
        <MudDrawer @bind-Open="@_drawerOpen" Elevation="0" Variant="@DrawerVariant.Persistent"
                   ClipMode="DrawerClipMode.Always" Class="staff-drawer kf-drawer">
            @* The brand lives in the topbar on desktop, so navigation starts flush under the app bar. *@
            <Sidebar />
        </MudDrawer>
    }

    <MudMainContent Class="staff-main kf-main">
        <main class="staff-container kf-container">
            @Body
        </main>
    </MudMainContent>
</MudLayout>

@* Anchored to the topbar in CSS rather than by MudPopover: a popover declared at
   layout level has no meaningful anchor element, so it positioned itself against
   the end of the shell instead of against the bell. *@
@if (_notifPopoverOpen)
{
    <div class="kf-notification-backdrop" @onclick="CloseNotifications"></div>
    <div class="kf-notification-panel" @ref="_notifPanel" tabindex="-1"
         role="dialog" aria-label="Notifications" @onkeydown="OnNotificationsKeyDown">
        <div class="kf-notification-header">
            <strong>Notifications</strong>
            @if (_unreadCount > 0)
            {
                <button type="button" @onclick="MarkAllRead">Mark all read</button>
            }
        </div>
        <div class="kf-notification-list">
            @if (_recentNotifications.Count == 0)
            {
                <div class="kf-notification-empty">
                    <MudIcon Icon="@Icons.Material.Outlined.NotificationsNone" />
                    <span>No notifications</span>
                </div>
            }
            else
            {
                @foreach (var n in _recentNotifications)
                {
                    <button type="button" class="notification-item @(n.IsRead ? "" : "unread")"
                            @onclick="() => OnNotificationClick(n)">
                        <MudIcon Icon="@GetNotifIcon(n.Type)" Color="@GetNotifColor(n.Type)" />
                        <span>
                            <strong>@n.Title</strong>
                            <small>@n.Message</small>
                            <time>@n.TimeAgo</time>
                        </span>
                    </button>
                }
            }
        </div>
        <button class="kf-notification-view-all" type="button" @onclick="GoToNotifications">
            View all notifications
        </button>
    </div>
}

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    private bool _drawerOpen = true;
    private bool _mobileDrawerOpen;
    private bool _isDarkMode = false;
    private bool _isMobileLayout;
    private bool _viewportSubscribed;
    private readonly Guid _viewportObserverId = Guid.NewGuid();
    private MudThemeProvider? _mudThemeProvider;

    // The topbar's brand cell only lines up with the drawer while the persistent drawer is open,
    // so its divider is toggled from the same state that drives the drawer.
    private string ShellClass =>
        $"staff-shell kf-shell {(!_isMobileLayout && _drawerOpen ? "kf-nav-open" : "kf-nav-closed")}";

    // Notification state
    private int _unreadCount;
    private bool _notifPopoverOpen;
    private bool _notifPanelNeedsFocus;
    private ElementReference _notifPanel;
    private Topbar? _topbar;
    private List<NotificationModel> _recentNotifications = new();
    private System.Threading.Timer? _pollTimer;
    private bool _isAuthenticated;
    private int _pollFailures;
    private volatile bool _isPolling;

    protected override async Task OnInitializedAsync()
    {
        // Initialize theme
        var theme = await ThemeService.GetThemeAsync();
        _isDarkMode = theme == "dark";
        ThemeService.OnThemeChanged += OnThemeChanged;

        // Initialize localization
        await L.GetLanguageAsync();
        L.OnLanguageChanged += OnLanguageChanged;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_notifPanelNeedsFocus)
        {
            _notifPanelNeedsFocus = false;
            try
            {
                await _notifPanel.FocusAsync();
            }
            catch (JSException)
            {
                // The panel closed again before this render committed; nothing to focus.
            }
        }

        if (firstRender)
        {
            await BrowserViewportService.SubscribeAsync(_viewportObserverId, OnBrowserViewportChangedAsync, null, true);
            _viewportSubscribed = true;

            // Sync theme from storage and apply to DOM
            var theme = await ThemeService.GetThemeAsync();
            _isDarkMode = theme == "dark";
            try { await JS.InvokeVoidAsync("themeManager.initTheme", theme); } catch { }

            // Check auth and start polling if authenticated
            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            _isAuthenticated = authState.User.Identity?.IsAuthenticated == true;
            if (_isAuthenticated)
            {
                await LoadNotifications();

                // Connect to SignalR hub for real-time push notifications
                try
                {
                    // Via the auth state provider so the hub is handed a token that is still valid.
                    // Passed as a factory rather than a value: the hub reconnects automatically, and
                    // a captured token would be re-presented long after it expired.
                    var token = await AuthStateProvider.GetAccessTokenAsync();
                    if (!string.IsNullOrWhiteSpace(token))
                    {
                        NotificationHub.OnNotificationReceived += OnRealTimeNotification;
                        await NotificationHub.StartAsync(() => AuthStateProvider.GetAccessTokenAsync());
                    }
                }
                catch (Exception ex)
                {
                    // Fall back to polling if SignalR connection fails
                    System.Diagnostics.Debug.WriteLine($"SignalR connection failed: {ex.Message}");
                }

                // Polling as fallback (longer interval since SignalR handles real-time)
                _pollTimer = new System.Threading.Timer(PollNotifications, null, TimeSpan.FromSeconds(120), TimeSpan.FromSeconds(120));
            }

            StateHasChanged();
        }
    }

    private async Task OnBrowserViewportChangedAsync(BrowserViewportEventArgs _)
    {
        var isMobileLayout = await BrowserViewportService.IsBreakpointWithinWindowSizeAsync(Breakpoint.MdAndDown);
        if (isMobileLayout == _isMobileLayout)
        {
            return;
        }

        _isMobileLayout = isMobileLayout;
        if (_isMobileLayout)
        {
            _mobileDrawerOpen = false;
        }
        else
        {
            _drawerOpen = true;
        }

        await InvokeAsync(StateHasChanged);
    }

    private async void PollNotifications(object? state)
    {
        if (_isPolling || NotificationHub.IsConnected) return;
        _isPolling = true;

        try
        {
            var previousUnread = _unreadCount;
            var response = await NotificationClient.GetNotificationsAsync(1, 5, false);
            if (response != null)
            {
                // Only show toast if NOT connected to SignalR (to avoid duplicates)
                var newUnread = response.UnreadCount;
                if (!NotificationHub.IsConnected && newUnread > previousUnread)
                {
                    // Show toast for new notifications
                    var newNotifs = response.Notifications.Where(n => !n.IsRead).Take(newUnread - previousUnread).ToList();
                    foreach (var n in newNotifs)
                    {
                        await InvokeAsync(() => Snackbar.Add(
                            $"{n.Title}: {TruncateMessage(n.Message, 80)}",
                            MapSeverity(n.Type),
                            config =>
                            {
                                config.VisibleStateDuration = 5000;
                                config.ShowCloseIcon = true;
                                config.SnackbarVariant = Variant.Filled;
                            }));
                    }
                }

                await InvokeAsync(() =>
                {
                    _unreadCount = response.UnreadCount;
                    _recentNotifications = response.Notifications.Take(5).ToList();
                    StateHasChanged();
                });

                // Reset backoff on success
                if (_pollFailures > 0)
                {
                    _pollFailures = 0;
                    _pollTimer?.Change(TimeSpan.FromSeconds(60), TimeSpan.FromSeconds(60));
                }
            }
        }
        catch
        {
            // Exponential backoff: 60s -> 120s -> 240s -> max 480s
            _pollFailures = Math.Min(_pollFailures + 1, 3);
            var backoffSeconds = 60 * (1 << _pollFailures);
            _pollTimer?.Change(TimeSpan.FromSeconds(backoffSeconds), TimeSpan.FromSeconds(backoffSeconds));
        }
        finally
        {
            _isPolling = false;
        }
    }

    private async Task LoadNotifications()
    {
        try
        {
            var response = await NotificationClient.GetNotificationsAsync(1, 5, false);
            if (response != null)
            {
                _unreadCount = response.UnreadCount;
                _recentNotifications = response.Notifications.Take(5).ToList();
            }
        }
        catch
        {
            // Silently ignore load errors
        }
    }

    private void ToggleNotificationPopover()
    {
        _notifPopoverOpen = !_notifPopoverOpen;
        _notifPanelNeedsFocus = _notifPopoverOpen;
    }

    private async Task CloseNotifications()
    {
        if (!_notifPopoverOpen)
        {
            return;
        }

        _notifPopoverOpen = false;
        _notifPanelNeedsFocus = false;

        // Focus came from the bell, so send it back there rather than to the top
        // of the document.
        if (_topbar is not null)
        {
            await _topbar.FocusNotificationButtonAsync();
        }
    }

    private async Task OnNotificationsKeyDown(KeyboardEventArgs args)
    {
        if (args.Key == "Escape")
        {
            await CloseNotifications();
        }
    }

    private async void OnRealTimeNotification(NotificationModel notification)
    {
        try
        {
            var response = await NotificationClient.GetNotificationsAsync(1, 5, false);
            var visibleNotification = response?.Notifications.FirstOrDefault(n => n.Id == notification.Id && !n.IsRead);
            if (response == null || visibleNotification == null)
            {
                return;
            }

            await InvokeAsync(() =>
            {
                _unreadCount = response.UnreadCount;
                _recentNotifications = response.Notifications.Take(5).ToList();

                Snackbar.Add(
                    $"{visibleNotification.Title}: {TruncateMessage(visibleNotification.Message, 80)}",
                    MapSeverity(visibleNotification.Type),
                    config =>
                    {
                        config.VisibleStateDuration = 5000;
                        config.ShowCloseIcon = true;
                        config.SnackbarVariant = Variant.Filled;
                    });

                StateHasChanged();
            });
        }
        catch
        {
            // Silently ignore UI update errors
        }
    }

    private async Task OnNotificationClick(NotificationModel notification)
    {
        if (!notification.IsRead)
        {
            await NotificationClient.MarkAsReadAsync(new List<int> { notification.Id });
            notification.IsRead = true;
            _unreadCount = Math.Max(0, _unreadCount - 1);
        }

        _notifPopoverOpen = false;

        if (!string.IsNullOrEmpty(notification.EffectiveActionUrl))
        {
            NavigationManager.NavigateTo(notification.EffectiveActionUrl);
        }
    }

    private async Task MarkAllRead()
    {
        await NotificationClient.MarkAsReadAsync();
        _unreadCount = 0;
        foreach (var n in _recentNotifications)
            n.IsRead = true;
    }

    private void GoToNotifications()
    {
        _notifPopoverOpen = false;
        NavigationManager.NavigateTo("/notifications");
    }

    private static string GetNotifIcon(string type) => type switch
    {
        "Error" => Icons.Material.Filled.Error,
        "Warning" => Icons.Material.Filled.Warning,
        "Success" => Icons.Material.Filled.CheckCircle,
        _ => Icons.Material.Filled.Info
    };

    private static Color GetNotifColor(string type) => type switch
    {
        "Error" => Color.Error,
        "Warning" => Color.Warning,
        "Success" => Color.Success,
        _ => Color.Info
    };

    private static Severity MapSeverity(string type) => type switch
    {
        "Error" => Severity.Error,
        "Warning" => Severity.Warning,
        "Success" => Severity.Success,
        _ => Severity.Info
    };

    private static string TruncateMessage(string msg, int maxLen) =>
        msg.Length <= maxLen ? msg : msg[..maxLen] + "...";

    private async void OnThemeChanged()
    {
        _isDarkMode = ThemeService.IsDarkMode;
        await InvokeAsync(StateHasChanged);
    }

    private void ToggleDrawer()
    {
        if (_isMobileLayout)
        {
            _mobileDrawerOpen = !_mobileDrawerOpen;
            return;
        }

        _drawerOpen = !_drawerOpen;
    }

    private async Task ToggleTheme()
    {
        _isDarkMode = !_isDarkMode;
        var theme = _isDarkMode ? "dark" : "light";
        try { await JS.InvokeVoidAsync("themeManager.setTheme", theme, true); } catch { }
        await ThemeService.SetThemeAsync(theme);
    }

    private async Task Logout()
    {
        _pollTimer?.Dispose();
        _pollTimer = null;
        NotificationHub.OnNotificationReceived -= OnRealTimeNotification;
        await NotificationHub.StopAsync();
        // Audit log: logout (capture user before logout clears state)
        await AuditService.LogAsync(AuditActions.Logout, "Auth");
        await AuthService.LogoutAsync();
        NavigationManager.NavigateTo("/login");
    }

    private async void OnLanguageChanged()
    {
        await InvokeAsync(StateHasChanged);
    }

    public async ValueTask DisposeAsync()
    {
        ThemeService.OnThemeChanged -= OnThemeChanged;
        L.OnLanguageChanged -= OnLanguageChanged;
        NotificationHub.OnNotificationReceived -= OnRealTimeNotification;
        _pollTimer?.Dispose();

        if (_viewportSubscribed)
        {
            try
            {
                await BrowserViewportService.UnsubscribeAsync(_viewportObserverId);
            }
            catch
            {
                // Ignore viewport cleanup failures during component disposal.
            }
        }
    }
}
